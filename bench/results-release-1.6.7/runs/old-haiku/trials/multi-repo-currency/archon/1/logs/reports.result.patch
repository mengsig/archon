-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+Input is either `date,account,amount_cents,currency` or the older
+`date,account,amount_cents`, where every row counts as USD.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
+OLD_HEADER = ["date", "account", "amount_cents"]
+NEW_HEADER = ["date", "account", "amount_cents", "currency"]
+
+
+class MalformedCurrency(ValueError):
+    """An input row whose currency is not three uppercase ASCII letters."""
+
+
+class UnrecognisedHeader(ValueError):
+    """An input header that is neither the old nor the new ledger layout."""
+
+
+def has_currency_column(fieldnames):
+    """True for the four-column layout, False for the three-column one."""
+    columns = list(fieldnames or [])
+    if columns == NEW_HEADER:
+        return True
+    if columns == OLD_HEADER:
+        return False
+    raise UnrecognisedHeader(f"unrecognised CSV header {columns!r}")
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(rows, has_currency):
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for number, row in enumerate(rows, start=1):
+        currency = (row["currency"] or "") if has_currency else DEFAULT_CURRENCY
+        if not CURRENCY_PATTERN.fullmatch(currency):
+            raise MalformedCurrency(
+                f"malformed currency {currency!r} in data row {number}"
+            )
+        key = (row["account"], currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    assert all(isinstance(total, int) for total in result.values())
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[account, currency]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    reader = csv.DictReader(sys.stdin)
+    try:
+        has_currency = has_currency_column(reader.fieldnames)
+        result = totals(reader, has_currency)
+    except (MalformedCurrency, UnrecognisedHeader) as error:
+        sys.stderr.write(f"reports: {error}\n")
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
