+// Serves `pages`; cursor `pN` selects page N. Each requested cursor is pushed to `seenCursors`.
+function pagedTransport(pages, seenCursors) {
+  return async (request) => {
+    if (request.path !== '/items') return { status: 404, body: { error: 'not found' } };
+    seenCursors.push(request.query.cursor);
+    const index = request.query.cursor === undefined ? 0 : Number(request.query.cursor.slice(1));
+    return { status: 200, body: pages[index] };
+  };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages, in order, passing cursors back unchanged', async () => {
+  const pages = [
+    { items: [{ id: 1 }, { id: 2 }], next_cursor: 'p1' },
+    { items: [{ id: 3 }], next_cursor: 'p2' },
+    { items: [{ id: 4 }, { id: 5 }], next_cursor: null },
+  ];
+  const seen = [];
+  assert.deepEqual(
+    await listItems(pagedTransport(pages, seen)),
+    [{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }, { id: 5 }],
+  );
+  assert.deepEqual(seen, [undefined, 'p1', 'p2']);
+});
+
+test('stops when next_cursor is missing', async () => {
+  const seen = [];
+  const pages = [{ items: [{ id: 1 }], next_cursor: 'p1' }, { items: [{ id: 2 }] }];
+  assert.deepEqual(await listItems(pagedTransport(pages, seen)), [{ id: 1 }, { id: 2 }]);
+  assert.deepEqual(seen, [undefined, 'p1']);
+});
+
+test('returns a single page without a cursor', async () => {
+  const seen = [];
+  const pages = [{ items: ITEMS, next_cursor: null }];
+  assert.deepEqual(await listItems(pagedTransport(pages, seen)), ITEMS);
+  assert.deepEqual(seen, [undefined]);
+});
+
+test('rejects a response that repeats the cursor instead of looping forever', async () => {
+  const pages = [{ items: [{ id: 1 }], next_cursor: 'p1' }, { items: [{ id: 2 }], next_cursor: 'p1' }];
+  await assert.rejects(listItems(pagedTransport(pages, [])), /repeated cursor "p1"/);
+});
+
+test('rejects a page without an items array', async () => {
