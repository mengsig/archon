+++ b/tests/test_search.py
@@ -0,0 +1,74 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+
+
+def sample_tasks():
+    return [
+        Task(1, "Fix login bug", ["work", "urgent"], "open"),
+        Task(2, "buy milk", ["home"], "done"),
+        Task(3, "Write FIX notes", ["Work"], "open"),
+        Task(4, "plan trip", [], "done"),
+    ]
+
+
+def ids(tasks):
+    return [task.id for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        tasks = sample_tasks()
+        self.assertEqual(ids(search(tasks, "")), [1, 2, 3, 4])
+        self.assertEqual(ids(search(tasks, "   ")), [1, 2, 3, 4])
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(ids(search(sample_tasks(), "fix")), [1, 3])
+        self.assertEqual(ids(search(sample_tasks(), "MILK")), [2])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(ids(search(sample_tasks(), '"login bug"')), [1])
+        self.assertEqual(ids(search(sample_tasks(), '"fix login"')), [1])
+        self.assertEqual(ids(search(sample_tasks(), '"bug login"')), [])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(ids(search(sample_tasks(), "fix tag:work")), [1, 3])
+        self.assertEqual(ids(search(sample_tasks(), "fix milk")), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(ids(search(sample_tasks(), "tag:WORK")), [1, 3])
+        self.assertEqual(ids(search(sample_tasks(), "tag:wor")), [])
+
+    def test_tag_value_can_be_quoted(self):
+        tasks = [Task(1, "x", ["my tag"], "open")]
+        self.assertEqual(ids(search(tasks, 'tag:"my tag"')), [1])
+
+    def test_status_filters(self):
+        self.assertEqual(ids(search(sample_tasks(), "status:open")), [1, 3])
+        self.assertEqual(ids(search(sample_tasks(), "status:done")), [2, 4])
+        self.assertEqual(ids(search(sample_tasks(), "status:done fix")), [])
+
+    def test_quoted_text_with_colon_is_a_phrase(self):
+        tasks = [Task(1, "note: check", status="open")]
+        self.assertEqual(ids(search(tasks, '"note: check"')), [1])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), "status:pending")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), '"fix login')
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_store_undo.py b/tests/test_store_undo.py
new file mode 100644
index 0000000..f22d46f
--- /dev/null
+++ b/tests/test_store_undo.py
@@ -0,0 +1,88 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+def titles(store):
+    return [t.title for t in store.all()]
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        self.assertEqual(store.add("second").id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        task = store.add("report", tags=["work"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.title, "report")
+        self.assertEqual(restored.tags, ["work"])
+        self.assertEqual(restored.due, date(2026, 4, 1))
+        self.assertEqual(restored.status, "done")
+
+    def test_undo_is_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(titles(store), ["a", "b"])
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual(titles(store), ["a"])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_after_undo_walks_further_back(self):
+        store = TaskStore()
+        store.add("one")
+        store.add("two")
+        store.undo()
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
