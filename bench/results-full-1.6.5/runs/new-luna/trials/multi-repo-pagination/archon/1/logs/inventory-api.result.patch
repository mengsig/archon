@@ -21,8 +28,53 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", str(DEFAULT_LIMIT))
+    if not isinstance(raw_limit, str) or not raw_limit.isascii() or not raw_limit.isdecimal():
+        return _error(400, "limit must be an integer between 1 and 100")
+    normalized_limit = raw_limit.lstrip("0") or "0"
+    if len(normalized_limit) > 3:
+        return _error(400, "limit must be an integer between 1 and 100")
+    limit = int(normalized_limit)
+    if not 1 <= limit <= MAX_LIMIT:
+        return _error(400, "limit must be an integer between 1 and 100")
+
+    cursor = query.get("cursor")
+    after_id = None
+    if cursor is not None:
+        after_id = _decode_cursor(cursor)
+        if after_id is None:
+            return _error(400, "invalid cursor")
+
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    if after_id is not None:
+        ordered = [item for item in ordered if item["id"] > after_id]
+    page = ordered[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(ordered) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(item_id):
+    payload = json.dumps({"v": 1, "id": item_id}, separators=(",", ":")).encode()
+    return base64.urlsafe_b64encode(payload).decode().rstrip("=")
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not cursor:
+        return None
+    try:
+        encoded = cursor.encode("ascii")
+        payload = base64.b64decode(encoded + b"=" * (-len(encoded) % 4), altchars=b"-_", validate=True)
+        value = json.loads(payload)
+    except (UnicodeEncodeError, ValueError, binascii.Error):
+        return None
+    if (not isinstance(value, dict) or set(value) != {"v", "id"}
+            or type(value["v"]) is not int or value["v"] != 1
+            or type(value["id"]) is not int):
+        return None
+    ids = {item["id"] for item in ITEMS}
+    if value["id"] not in ids:
+        return None
+    return value["id"]
 
 
