+from .models import DONE, OPEN
+
+
+class QueryError(ValueError):
+    """A search query that cannot be parsed or uses an unknown field."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Return the tasks matching every term of the query, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_compile_term(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes, keeping the quotes."""
+    terms = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            current.append(char)
+        elif char.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    assert all(terms), "split must not produce empty terms"
+    return terms
+
+
+def _compile_term(raw):
+    """Turn one raw term into a predicate on a task."""
+    assert raw, "raw term must not be empty"
+    quote_at = raw.find('"')
+    colon_at = raw.find(":")
+    if colon_at != -1 and (quote_at == -1 or colon_at < quote_at):
+        return _compile_field(raw[:colon_at], raw[colon_at + 1:].replace('"', ""))
+    assert raw.count('"') % 2 == 0, "quotes must be balanced after splitting"
+    phrase = raw.replace('"', "").lower()
+    return lambda task: phrase in task.title.lower()
+
+
+def _compile_field(name, value):
+    """Build the predicate for a `field:value` term."""
+    name = name.lower()
+    if not value:
+        raise QueryError(f"empty value for field {name!r}")
+    if name == "tag":
+        wanted = value.lower()
+        return lambda task: any(tag.lower() == wanted for tag in task.tags)
+    if name == "status":
+        return _compile_status(value.lower())
+    raise QueryError(f"unknown field {name!r}")
+
+
+def _compile_status(status):
+    if status not in (OPEN, DONE):
+        raise QueryError(f"unknown status {status!r}")
+    return lambda task: task.status == status
