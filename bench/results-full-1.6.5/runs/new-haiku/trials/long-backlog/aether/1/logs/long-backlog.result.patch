diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..f935b49 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,48 @@
+import re
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+TERM = re.compile(r'(?:[^\s"]|"[^"]*")+')
+FIELD = re.compile(r"(\w+):(.*)", re.DOTALL)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_matcher(term) for term in _terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _terms(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    return TERM.findall(query)
+
+
+def _matcher(term):
+    field = FIELD.fullmatch(term)
+    if field is None:
+        text = _unquote(term).lower()
+        return lambda task: text in task.title.lower()
+    return _field_matcher(field.group(1).lower(), _unquote(field.group(2)).lower(), term)
+
+
+def _field_matcher(name, value, term):
+    if not value:
+        raise QueryError(f"missing value in term: {term}")
+    if name == "tag":
+        return lambda task: value in (tag.lower() for tag in task.tags)
+    if name == "status":
+        if value not in STATUSES:
+            raise QueryError(f"unknown status: {value}")
+        return lambda task: task.status == value
+    raise QueryError(f"unknown field: {name}")
+
+
+def _unquote(text):
+    return text.replace('"', "")
