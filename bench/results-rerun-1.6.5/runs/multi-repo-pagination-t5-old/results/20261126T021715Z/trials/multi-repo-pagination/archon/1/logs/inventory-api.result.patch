     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    remaining = [item for item in items if after_id is None or item["id"] > after_id]
+    page = remaining[:limit]
+    next_cursor = str(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _DIGITS.fullmatch(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise ValueError(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None
+    if not _DIGITS.fullmatch(raw):
+        raise ValueError("cursor is invalid")
+    return int(raw)
 
 
