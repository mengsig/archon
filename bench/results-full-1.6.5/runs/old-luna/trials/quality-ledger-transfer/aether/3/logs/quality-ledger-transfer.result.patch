+
+class LedgerValidation(unittest.TestCase):
+    def test_constructor_rejects_invalid_inputs(self):
+        for value in (None, [], (), {"": 0}, {1: 0}, {"a": True}, {"a": -1},
+                      {"a": MAX_BALANCE + 1}, {"a": 1.0}):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                Ledger(value)
+
+    def test_constructor_and_snapshot_are_isolated(self):
+        initial = {"a": 4}
+        ledger = Ledger(initial)
+        initial["a"] = 99
+        initial["b"] = 2
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 0
+        snapshot["b"] = 8
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_amount_validated_before_accounts(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "other", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+    def test_overflow_is_atomic(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE - 1})
+        self.assertFalse(ledger.transfer("a", "b", 2))
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": MAX_BALANCE - 1})
+
+    def test_self_transfer_boundaries(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+        empty = Ledger({"a": 0})
+        self.assertFalse(empty.transfer("a", "a", 1))
+        self.assertEqual(empty.snapshot(), {"a": 0})
+
+    def test_concurrent_transfers_preserve_total(self):
+        ledger = Ledger({"left": 1000, "right": 1000})
+        barrier = threading.Barrier(5)
+
+        def move(source, destination):
+            barrier.wait()
+            for _ in range(500):
+                ledger.transfer(source, destination, 1)
+
+        threads = [
+            threading.Thread(target=move, args=("left", "right")),
+            threading.Thread(target=move, args=("right", "left")),
+            threading.Thread(target=move, args=("left", "right")),
+            threading.Thread(target=move, args=("right", "left")),
+        ]
+        for thread in threads:
+            thread.start()
+        barrier.wait()
+        for _ in range(500):
+            snap = ledger.snapshot()
+            self.assertEqual(sum(snap.values()), 2000)
+            self.assertTrue(all(0 <= value <= MAX_BALANCE for value in snap.values()))
+        for thread in threads:
+            thread.join()
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
