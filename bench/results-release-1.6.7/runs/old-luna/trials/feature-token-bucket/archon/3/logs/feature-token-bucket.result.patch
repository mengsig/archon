+class EdgeCaseTest(unittest.TestCase):
+    def test_validation(self):
+        for capacity, refill in ((0, 1), (1, 0), (-1, 1), (1, -1)):
+            with self.subTest(capacity=capacity, refill=refill):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, refill)
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, refill)
+        bucket = TokenBucket(2, 1, clock=FakeClock())
+        for amount in (0, -1, 3):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(amount)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(amount)
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1, max_keys=0)
+
+    def test_fractional_refill_wait_does_not_consume_and_caps(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 0.5, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertEqual(bucket.wait_time(1), 2.0)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 1.5
+        self.assertEqual(bucket.available(), 0.75)
+        self.assertEqual(bucket.wait_time(1), 0.5)
+        self.assertEqual(bucket.available(), 0.75)
+        clock.now = 20
+        self.assertEqual(bucket.available(), 2)
+
+    def test_backwards_clock_freezes_until_previous_high_water_mark(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 2
+        self.assertEqual(bucket.available(), 2)
+        bucket.try_acquire(2)
+        clock.now = 1
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 2
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 3
+        self.assertEqual(bucket.available(), 1)
+
+    def test_lru_eviction_on_wait_and_acquire_resets_bucket(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1, max_keys=2, clock=clock)
+        self.assertEqual(limiter.wait_time("a"), 0)
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(limiter.wait_time("a"), 0)  # a becomes most recent
+        self.assertEqual(limiter.wait_time("c"), 0)  # evicts b
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # evicted key starts full
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
