diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..cc17b49 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,59 @@
+import re
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+FIELD_TERM = re.compile(r'([^"\s:]*):(.*)', re.DOTALL)
+
+
+class QueryError(ValueError):
+    """A search query that cannot be parsed or uses an unknown field."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_matcher(term) for term in _split_terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quote characters are kept."""
+    terms, current, in_term, in_quotes = [], [], False, False
+    for char in query:
+        if char.isspace() and not in_quotes:
+            if in_term:
+                terms.append("".join(current))
+                current, in_term = [], False
+            continue
+        if char == '"':
+            in_quotes = not in_quotes
+        current.append(char)
+        in_term = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if in_term:
+        terms.append("".join(current))
+    return terms
+
+
+def _unquote(text):
+    return text.replace('"', "")
+
+
+def _matcher(term):
+    field = FIELD_TERM.fullmatch(term)
+    if field is None:
+        phrase = _unquote(term).lower()
+        return lambda task: phrase in task.title.lower()
+    name = field.group(1).lower()
+    value = _unquote(field.group(2)).lower()
+    if not value:
+        raise QueryError(f"missing value for {name!r} in query term {term!r}")
+    if name == "tag":
+        return lambda task: any(tag.lower() == value for tag in task.tags)
+    if name == "status":
+        if value not in STATUSES:
+            raise QueryError(f"unknown status {value!r} in query term {term!r}")
+        return lambda task: task.status == value
+    raise QueryError(f"unknown field {name!r} in query term {term!r}")
