diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..c4dc157 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,35 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": (attempt, 1),
+        "elapsed_ms": (elapsed_ms, 0),
+        "max_attempts": (max_attempts, 1),
+        "budget_ms": (budget_ms, 0),
+        "base_ms": (base_ms, 0),
+        "cap_ms": (cap_ms, 0),
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = (retry_after_ms, 0)
+
+    for name, (value, minimum) in values.items():
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer greater than or equal to {minimum}")
+
+    if attempt >= max_attempts:
+        return None
+
+    exponent = attempt - 1
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    elif base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+        delay = cap_ms
+    else:
+        delay = min(cap_ms, base_ms << exponent)
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..d49ddd5 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,65 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_before_exhaustion(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, retry_after_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(100, -1)
+
+    def test_only_builtin_integers_are_accepted(self):
+        for value in (True, 1.0, "1"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(value, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.0)
+
+    def test_every_argument_rejects_invalid_types_and_values(self):
+        invalid = (
+            ((True, 0), {}),
+            ((1, False), {}),
+            ((1, 0), {"max_attempts": True}),
+            ((1, 0), {"budget_ms": 0.5}),
+            ((1, 0), {"base_ms": "1"}),
+            ((1, 0), {"cap_ms": False}),
+            ((1, 0), {"retry_after_ms": 0.5}),
+            ((0, 0), {}),
+            ((1, 0), {"max_attempts": 0}),
+            ((1, -1), {}),
+            ((1, 0), {"budget_ms": -1}),
+            ((1, 0), {"base_ms": -1}),
+            ((1, 0), {"cap_ms": -1}),
+            ((1, 0), {"retry_after_ms": -1}),
+        )
+        for args, kwargs in invalid:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_zero_backoff_and_zero_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(2, 0, base_ms=10, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=20, cap_ms=5), 5)
+
+    def test_large_attempt_saturates_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
+
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=500), 500)
+
+    def test_budget_requires_strictly_earlier_start(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100, retry_after_ms=100))
+        self.assertEqual(retry_delay(1, 0, budget_ms=101, retry_after_ms=100), 100)
+
+    def test_attempts_above_limit_are_exhausted_after_validation(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=4, base_ms=-1)
