@@ -0,0 +1,54 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, OPEN, Task
+
+HEADER = "id,title,tags,status,due"
+
+
+def parse(text):
+    return list(csv.reader(io.StringIO(text, newline="")))
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_exact_output_uses_crlf_including_header(self):
+        tasks = [
+            Task(1, "plain", ["a", "b"], OPEN, date(2026, 4, 1)),
+            Task(2, "no due", [], DONE, None),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n1,plain,a;b,open,2026-04-01\r\n2,no due,,done,\r\n",
+        )
+
+    def test_rows_keep_input_order(self):
+        tasks = [Task(2, "second"), Task(1, "first")]
+        self.assertEqual([row[0] for row in parse(to_csv(tasks))[1:]], ["2", "1"])
+
+    def test_empty_input_gives_header_only(self):
+        self.assertEqual(to_csv([]), "id,title,tags,status,due\r\n")
+
+    def test_comma_quote_and_newlines_are_quoted(self):
+        title = 'say "hi, there"\nline two\rend'
+        text = to_csv([Task(1, title)])
+        self.assertIn('1,"say ""hi, there""\nline two\rend",,open,\r\n', text)
+
+    def test_tags_are_joined_and_quoted_when_needed(self):
+        text = to_csv([Task(1, "t", ["a,b", "c"])])
+        self.assertIn('1,t,"a,b;c",open,\r\n', text)
+
+    def test_plain_fields_are_not_quoted(self):
+        text = to_csv([Task(1, "buy milk", ["home"])])
+        self.assertEqual(text.splitlines()[1], "1,buy milk,home,open,")
+
+    def test_output_round_trips_through_csv_reader(self):
+        title = 'a, "b"\nc'
+        rows = parse(to_csv([Task(7, title, ["x,y", "z"], DONE, date(2026, 1, 2))]))
+        self.assertEqual(rows, [HEADER.split(","), ["7", title, "x,y;z", "done", "2026-01-02"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
