@@ -24,6 +24,42 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size_and_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_cursor_walk_returns_every_item_in_order(self):
+        seen = []
+        query = {}
+        while True:
+            body = get("/items", limit="10", **query)["body"]
+            seen.extend(item["id"] for item in body["items"])
+            if body["next_cursor"] is None:
+                break
+            query = {"cursor": body["next_cursor"]}
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        first = get("/items", limit="57")["body"]
+        self.assertEqual(len(first["items"]), 57)
+        self.assertIsNone(first["next_cursor"])
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for bad in ["0", "101", "-1", "abc", "", "2.5", " 5"]:
+            with self.subTest(limit=bad):
+                res = get("/items", limit=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for bad in ["", "!!!", "bm90LWEtbnVtYmVy"]:
+            with self.subTest(cursor=bad):
+                res = get("/items", cursor=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
