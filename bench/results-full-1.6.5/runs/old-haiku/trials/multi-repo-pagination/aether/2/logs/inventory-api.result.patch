diff --git a/README.md b/README.md
index 1a55755..6920655 100644
--- a/README.md
+++ b/README.md
@@ -6,7 +6,18 @@ In-memory inventory service. `api.handle(request)` maps a request
 
 ## Endpoints
 
-- `GET /items` → `{"items": [...]}`: every item, ordered by `id`.
+- `GET /items` → `{"items": [...], "next_cursor": <string or null>}`: items
+  ordered by `id`, one page at a time.
+  - `limit` (optional): an integer from 1 to 100, default 20.
+  - `cursor` (optional): an opaque string taken from a previous response's
+    `next_cursor`. Omit it for the first page.
+  - `next_cursor` is `null` on the last page. Otherwise, pass it back unchanged
+    as `cursor` to get the next page.
+  - An invalid `limit` or `cursor` returns 400 with `{"error": "..."}`.
 - `GET /items/<id>` → the item, 404 when unknown, 400 when `id` is not a number.
 
+Example: `{"method": "GET", "path": "/items", "query": {"limit": "2"}}` returns
+the first two items and a `next_cursor`; repeat with `"cursor": <that value>`
+until `next_cursor` is `null`.
+
 Run the tests with `python3 -m unittest`.
diff --git a/api.py b/api.py
index aba1605..c68852e 100644
--- a/api.py
+++ b/api.py
@@ -5,8 +5,18 @@ response is `{"status": int, "body": object}`; the transport layer lives
 elsewhere.
 """
 
+import base64
+import bisect
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_DIGITS = re.compile(r"[0-9]+")
+_ITEMS_BY_ID = sorted(ITEMS, key=lambda item: item["id"])
+_IDS = [item["id"] for item in _ITEMS_BY_ID]
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +31,21 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    start = 0
+    if "cursor" in query:
+        after = _decode_cursor(query["cursor"])
+        if after is None:
+            return _error(400, "cursor is invalid")
+        start = bisect.bisect_right(_IDS, after)
+    assert 1 <= limit <= MAX_LIMIT
+    assert 0 <= start <= len(_ITEMS_BY_ID)
+    page = _ITEMS_BY_ID[start:start + limit]
+    has_more = start + limit < len(_ITEMS_BY_ID)
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
 def get_item(raw_id):
@@ -34,5 +57,32 @@ def get_item(raw_id):
     return _error(404, "no such item")
 
 
+def _parse_limit(raw):
+    """Return the page size, or None when `raw` is not an integer in range."""
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _DIGITS.fullmatch(raw):
+        return None
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(cursor):
+    """Return the id the cursor points after, or None when it is not a valid cursor."""
+    try:
+        raw = base64.urlsafe_b64decode(cursor.encode("ascii")).decode("ascii")
+    except ValueError:
+        return None
+    if not _DIGITS.fullmatch(raw) or _encode_cursor(int(raw)) != cursor:
+        return None
+    return int(raw)
+
+
 def _error(status, message):
     return {"status": status, "body": {"error": message}}
diff --git a/test_api.py b/test_api.py
index 55cd1fd..fe5e7a3 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,47 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_has_twenty_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsInstance(body["next_cursor"], str)
+
+    def test_following_cursors_yields_every_item_in_order(self):
+        for limit in (1, 7, 20, 100):
+            with self.subTest(limit=limit):
+                ids = []
+                cursor = None
+                while True:
+                    query = {"limit": str(limit)}
+                    if cursor is not None:
+                        query["cursor"] = cursor
+                    body = get("/items", **query)["body"]
+                    ids.extend(item["id"] for item in body["items"])
+                    cursor = body["next_cursor"]
+                    if cursor is None:
+                        break
+                self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        res = get("/items", limit="100")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_invalid_limit_is_rejected(self):
+        for limit in ("0", "101", "-1", "1.5", "abc", "", " 5", "+5"):
+            with self.subTest(limit=limit):
+                res = get("/items", limit=limit)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_rejected(self):
+        for cursor in ("", "!!!", "bogus", "bm90LWEtbnVtYmVy", "MDA3", "é"):
+            with self.subTest(cursor=cursor):
+                res = get("/items", cursor=cursor)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
