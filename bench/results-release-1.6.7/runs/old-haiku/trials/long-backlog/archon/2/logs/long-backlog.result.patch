--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,71 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    if not isinstance(query, str):
+        raise TypeError(f"query must be a str, not {type(query).__name__}")
+    matchers = [_compile_term(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quote characters are kept."""
+    terms = []
+    current = []
+    in_quotes = False
+    for ch in query:
+        if ch == '"':
+            in_quotes = not in_quotes
+        if ch.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(ch)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
+def _compile_term(raw):
+    head, sep, rest = raw.partition(":")
+    if sep and '"' not in head:
+        return _compile_field(head, rest.replace('"', ""))
+    return _compile_phrase(raw.replace('"', ""))
+
+
+def _compile_phrase(text):
+    if not text.strip():
+        raise QueryError("empty search term in query")
+    needle = text.casefold()
+    return lambda task: needle in task.title.casefold()
+
+
+def _compile_field(name, value):
+    if not value.strip():
+        raise QueryError(f"empty value for {name!r} in query")
+    if name == "tag":
+        return _compile_tag(value)
+    if name == "status":
+        return _compile_status(value)
+    raise QueryError(f"unknown field {name!r} in query")
+
+
+def _compile_tag(value):
+    needle = value.casefold()
+    return lambda task: any(tag.casefold() == needle for tag in task.tags)
+
+
+def _compile_status(value):
+    status = value.casefold()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status {value!r} in query")
+    return lambda task: task.status == status
