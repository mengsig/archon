+function paged(pages) {
+  const seenQueries = [];
+  const transport = async (request) => {
+    seenQueries.push(request.query);
+    const cursor = request.query.cursor;
+    const index = cursor === undefined ? 0 : Number(cursor);
+    return { status: 200, body: pages[index] };
+  };
+  return { transport, seenQueries };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const { transport, seenQueries } = paged([
+    { items: [ITEMS[0]], next_cursor: '1' },
+    { items: [ITEMS[1]], next_cursor: '2' },
+    { items: [], next_cursor: null },
+  ]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seenQueries, [{}, { cursor: '1' }, { cursor: '2' }]);
+});
+
+test('makes one request when next_cursor is null', async () => {
+  const { transport, seenQueries } = paged([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seenQueries, [{}]);
+});
+
+test('makes one request when next_cursor is absent', async () => {
+  const { transport, seenQueries } = paged([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seenQueries, [{}]);
+});
+
+test('rejects a page without an items array', async () => {
+  const { transport } = paged([{ next_cursor: null }]);
+  await assert.rejects(listItems(transport), /items array/);
+});
+
+test('rejects a null or non-object page body', async () => {
+  await assert.rejects(listItems(paged([null]).transport), /items array/);
+  await assert.rejects(listItems(paged(['text']).transport), /items array/);
+});
+
+test('rejects a repeated next_cursor instead of looping', async () => {
+  const transport = async () => ({ status: 200, body: { items: [ITEMS[0]], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /repeated next_cursor/);
+});
+
+test('rejects when a later page fails', async () => {
+  const transport = async (request) =>
+    request.query.cursor === undefined
+      ? { status: 200, body: { items: ITEMS, next_cursor: 'abc' } }
+      : { status: 400, body: { error: 'invalid cursor' } };
+  await assert.rejects(listItems(transport), /400/);
+});
+
