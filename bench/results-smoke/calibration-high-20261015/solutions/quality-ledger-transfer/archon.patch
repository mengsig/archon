 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_name(name):
+    if type(name) is not str or not name:
+        raise ValueError(f"invalid account name: {name!r}")
+
+
+def _check_balance(balance):
+    if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+        raise ValueError(f"invalid balance: {balance!r}")
+
+
+def _check_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"invalid amount: {amount!r}")
+
+
+def _check_account(account):
+    # Only built-in str names can exist, so no caller hash/eq code runs under the lock.
+    if type(account) is not str:
+        raise KeyError(account)
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+        # Copy first so validation covers exactly what is stored.
+        self._balances = dict(balances)
+        for name, balance in self._balances.items():
+            _check_name(name)
+            _check_balance(balance)
+        # Single lock: linearizable, and no lock ordering to deadlock on.
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        _check_account(source)
+        _check_account(destination)
+        with self._lock:
+            if source not in self._balances:
+                raise KeyError(source)
+            if destination not in self._balances:
+                raise KeyError(destination)
+            if self._balances[source] < amount:
+                return False
+            if source == destination:
+                return True
+            if self._balances[destination] + amount > MAX_BALANCE:
+                return False
+            self._balances[source] -= amount
+            self._balances[destination] += amount
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
