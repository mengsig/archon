diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..b5eeae0
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,58 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def test_iso_date(self):
+        self.assertEqual(parse_due("2026-03-12", TODAY), date(2026, 3, 12))
+        self.assertEqual(parse_due("2024-02-29", TODAY), date(2024, 2, 29))
+
+    def test_impossible_calendar_dates_raise(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as ctx:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(ctx.exception))
+
+    def test_invalid_date_is_value_error(self):
+        with self.assertRaises(ValueError):
+            parse_due("2026-02-30", TODAY)
+
+    def test_unsupported_text_raises_invalid_date(self):
+        for text in ["", "next week", "2026/03/10", "2026-03-10x", "+5", "+5days", "3d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as ctx:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(ctx.exception))
+
+    def test_relative_offsets(self):
+        self.assertEqual(parse_due("+5d", TODAY), date(2026, 3, 15))
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+366d", TODAY), date(2027, 3, 11))
+
+    def test_negative_and_unsigned_offsets_raise(self):
+        for text in ["-3d", "3d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_offset_out_of_range_raises_invalid_date(self):
+        with self.assertRaises(InvalidDate):
+            parse_due("+99999999999d", TODAY)
+
+    def test_today_and_tomorrow(self):
+        self.assertEqual(parse_due("today", TODAY), TODAY)
+        self.assertEqual(parse_due("tomorrow", TODAY), date(2026, 3, 11))
+
+    def test_keywords_are_case_insensitive_and_trimmed(self):
+        self.assertEqual(parse_due(" Tomorrow ", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("\tTODAY\n", TODAY), TODAY)
+        self.assertEqual(parse_due("  +2D ", TODAY), date(2026, 3, 12))
+
+
+if __name__ == "__main__":
+    unittest.main()
