@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,67 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_has_twenty_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_walking_next_cursor_yields_every_item_in_order(self):
+        seen = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            seen.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        second_page_cursor = get("/items", limit="40")["body"]["next_cursor"]
+        body = get("/items", limit="20", cursor=second_page_cursor)["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_last_full_page_has_null_cursor_and_no_empty_page(self):
+        second_page_cursor = get("/items", limit="19")["body"]["next_cursor"]
+        second_page = get("/items", limit="19", cursor=second_page_cursor)["body"]
+        third_page = get("/items", limit="19", cursor=second_page["next_cursor"])["body"]
+        self.assertEqual(len(third_page["items"]), 19)
+        self.assertIsNone(third_page["next_cursor"])
+
+    def test_single_page_when_limit_covers_everything(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_the_end_is_empty_with_null_cursor(self):
+        body = get("/items", limit="5", cursor=_encode_raw("57"))["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds_are_accepted(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_invalid_limit_is_400(self):
+        for raw in ["0", "101", "-1", "abc", "", "1.5", " 5", "٣", "1" * 5000]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["", "!!!", "not-base64", "MQ==!!", _encode_raw("abc"), _encode_raw("-3"), _encode_raw("9" * 5000)]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertEqual(res["body"]["error"], "cursor is invalid")
+
+
+def _encode_raw(text):
+    return base64.urlsafe_b64encode(text.encode("ascii")).decode("ascii")
+
 
 if __name__ == "__main__":
     unittest.main()
