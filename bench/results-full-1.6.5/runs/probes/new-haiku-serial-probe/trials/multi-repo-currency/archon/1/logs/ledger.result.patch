+use std::io::Write;
+use std::process::{Command, Stdio};
+
+use ledger::{parse_cents, parse_line, to_csv_row, ParseError};
 
 #[test]
 fn parses_amounts() {
@@ -18,3 +21,97 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tcafe\t3.50\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,cafe,350,EUR");
+}
+
+#[test]
+fn malformed_currency_codes_are_bad_currency_errors() {
+    for code in ["eur", "US", "USDX", "U5D", ""] {
+        let line = format!("2026-03-01\tcafe\t1\t{code}");
+        assert!(
+            matches!(parse_line(&line), Err(ParseError::BadCurrency(_))),
+            "code {code:?} should be rejected"
+        );
+    }
+}
+
+#[test]
+fn other_line_errors_are_invalid() {
+    assert!(matches!(
+        parse_line("2026-03-01\tcafe\t1.234\tEUR"),
+        Err(ParseError::Invalid(_))
+    ));
+    assert!(matches!(
+        parse_line("2026-03-01\tcafe\t1\tEUR\textra"),
+        Err(ParseError::Invalid(_))
+    ));
+}
+
+struct RunOutput {
+    code: i32,
+    stdout: String,
+    stderr: String,
+}
+
+fn run_ledger(input: &str) -> RunOutput {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    let mut stdin = child.stdin.take().expect("piped stdin");
+    stdin.write_all(input.as_bytes()).expect("write stdin");
+    drop(stdin);
+    let output = child.wait_with_output().expect("wait for ledger");
+    RunOutput {
+        code: output.status.code().expect("exit code"),
+        stdout: String::from_utf8(output.stdout).expect("utf-8 stdout"),
+        stderr: String::from_utf8(output.stderr).expect("utf-8 stderr"),
+    }
+}
+
+#[test]
+fn cli_defaults_missing_currency_to_usd() {
+    let run = run_ledger("2026-03-01\tgroceries\t-45.10\n2026-03-02\tcafe\t3.50\tEUR\n");
+    assert_eq!(run.code, 0);
+    assert_eq!(
+        run.stdout,
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,-4510,USD\n\
+         2026-03-02,cafe,350,EUR\n"
+    );
+}
+
+#[test]
+fn cli_malformed_currency_exits_2_with_line_number() {
+    for code in ["usd", "US", "U5D"] {
+        let input = format!("2026-03-01\tcafe\t1\tEUR\n2026-03-02\tcafe\t2\t{code}\n");
+        let run = run_ledger(&input);
+        assert_eq!(run.code, 2, "code {code:?}");
+        assert!(
+            run.stderr.starts_with("line 2: "),
+            "code {code:?}: {}",
+            run.stderr
+        );
+    }
+}
+
+#[test]
+fn cli_other_errors_still_exit_1() {
+    let run = run_ledger("2026-03-01\tcafe\t1\nnot a line\n");
+    assert_eq!(run.code, 1);
+    assert!(run.stderr.starts_with("line 2: "), "{}", run.stderr);
+}
