@@ -0,0 +1,93 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_exact_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work", "q3"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = store.get(task.id)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id), before)
+        self.assertEqual([t.id for t in store.all()], [task.id])
+
+    def test_undo_walks_back_across_kinds_lifo(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_repeated_add_undo_removes_in_reverse_order(self):
+        store = TaskStore()
+        first = store.add("first")
+        second = store.add("second")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [first.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_ids_are_never_reused_after_undo_add(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        self.assertEqual(store.add("second").id, 2)
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        store.add("only")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_of_completing_done_task_keeps_it_done(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+
+if __name__ == "__main__":
+    unittest.main()
