@@ -32,6 +32,50 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_wait_and_non_consuming_wait(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertEqual(bucket.wait_time(), 0.5)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(2), 0.75)
+
+    def test_clock_moving_backwards_does_not_undo_elapsed_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 1.0)
+        clock.now = 1.5
+        self.assertAlmostEqual(bucket.available(), 1.5)
+
+    def test_validation(self):
+        for args in ((0, 1.0), (1, 0.0), (-1, 1.0)):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                TokenBucket(*args, clock=FakeClock())
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.subTest(wait_n=n), self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+
+    def test_lru_eviction_and_wait_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.wait_time("a")
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # Refresh a, making b least recently used.
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # Evicted b starts full.
+
 
 if __name__ == "__main__":
     unittest.main()
