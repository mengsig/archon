@@ -1,6 +1,50 @@
+from datetime import date, datetime
+
+from tasktracker.models import Task
+
+HEADER = ["id", "title", "tags", "status", "due"]
+LINE_END = "\r\n"
+SPECIAL_CHARS = (",", '"', "\r", "\n")
+
+
 def to_csv(tasks):
-    lines = ["id,title,tags,status,due"]
-    for task in tasks:
-        due = task.due.isoformat() if task.due else ""
-        lines.append(f"{task.id},{task.title},{';'.join(task.tags)},{task.status},{due}")
-    return "\n".join(lines) + "\n"
+    rows = [HEADER] + [_task_fields(task) for task in tasks]
+    return "".join(_csv_line(row) for row in rows)
+
+
+def _task_fields(task):
+    _check_task(task)
+    due = task.due.isoformat() if task.due is not None else ""
+    return [str(task.id), task.title, ";".join(task.tags), task.status, due]
+
+
+def _check_task(task):
+    if not isinstance(task, Task):
+        raise TypeError(f"expected Task, got {type(task).__name__}")
+    if isinstance(task.id, bool):
+        raise TypeError("id must be int, got bool")
+    _require_type(task.id, int, "id")
+    _require_type(task.title, str, "title")
+    _require_type(task.status, str, "status")
+    _require_type(task.tags, (list, tuple), "tags")
+    for tag in task.tags:
+        _require_type(tag, str, "tag")
+    if task.due is not None and (not isinstance(task.due, date) or isinstance(task.due, datetime)):
+        raise TypeError(f"due must be a date or None, got {type(task.due).__name__}")
+
+
+def _require_type(value, expected, name):
+    if not isinstance(value, expected):
+        raise TypeError(f"{name} must be {expected}, got {type(value).__name__}")
+
+
+def _csv_line(fields):
+    assert len(fields) == len(HEADER), "each row has one value per column"
+    return ",".join(_quote(field) for field in fields) + LINE_END
+
+
+def _quote(value):
+    assert isinstance(value, str), "CSV fields are strings"
+    if not any(char in value for char in SPECIAL_CHARS):
+        return value
+    return '"' + value.replace('"', '""') + '"'
