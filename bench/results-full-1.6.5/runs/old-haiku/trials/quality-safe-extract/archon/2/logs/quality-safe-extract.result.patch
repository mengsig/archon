+class SuccessfulWrites(ExtractTestCase):
+    def test_missing_parents_are_created_and_bytes_are_exact(self):
+        payload = bytes(range(256))
+        names = ["a/b/c/data.bin", "a/b/empty", "other/x"]
+        entries = [("a/b/c/data.bin", payload), ("a/b/empty", b""), ("other/x", b"\n\x00")]
+        self.assertEqual(extract(entries, self.root), names)
+        self.assertEqual((self.root / "a/b/c/data.bin").read_bytes(), payload)
+        self.assertEqual((self.root / "a/b/empty").read_bytes(), b"")
+        self.assertEqual((self.root / "other/x").read_bytes(), b"\n\x00")
+
+    def test_returns_names_in_input_order(self):
+        names = ["z", "m/a", "b"]
+        self.assertEqual(extract([(n, b"") for n in names], self.root), names)
+
