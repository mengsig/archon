+test('follows cursors and preserves their values', async () => {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    if (request.query.cursor === undefined) {
+      return { status: 200, body: { items: [ITEMS[0]], next_cursor: 'opaque/a==' } };
+    }
+    assert.equal(request.query.cursor, 'opaque/a==');
+    return { status: 200, body: { items: [ITEMS[1]], next_cursor: null } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [
+    { method: 'GET', path: '/items', query: {} },
+    { method: 'GET', path: '/items', query: { cursor: 'opaque/a==' } },
+  ]);
+});
+
