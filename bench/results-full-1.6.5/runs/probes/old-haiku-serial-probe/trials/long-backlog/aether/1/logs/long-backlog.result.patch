@@ -26,13 +34,40 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append(("complete", task_id, task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append(("delete", replace(task, tags=list(task.tags))))
         del self._tasks[task_id]
         return task
 
+    def undo(self):
+        """Revert the most recent add, complete or delete and return its task."""
+        if not self._undo_log:
+            raise NothingToUndo("no add, complete or delete to undo")
+        change = self._undo_log.pop()
+        if change[0] == "add":
+            return self._undo_add(change[1])
+        if change[0] == "complete":
+            return self._undo_complete(change[1], change[2])
+        return self._undo_delete(change[1])
+
     def all(self):
         return sorted(self._tasks.values(), key=lambda t: t.id)
+
+    def _undo_add(self, task_id):
+        assert task_id in self._tasks, "an added task must exist until its add is undone"
+        return self._tasks.pop(task_id)
+
+    def _undo_complete(self, task_id, previous_status):
+        task = self.get(task_id)
+        task.status = previous_status
+        return task
+
+    def _undo_delete(self, snapshot):
+        assert snapshot.id not in self._tasks, "ids are never reused"
+        self._tasks[snapshot.id] = snapshot
+        return snapshot
