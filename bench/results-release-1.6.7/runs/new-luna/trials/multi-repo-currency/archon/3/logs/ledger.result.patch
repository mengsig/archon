+/// Parse one TSV line while preserving the error category for the CLI.
+pub fn parse_line_with_error(line: &str) -> Result<Entry, ParseError> {
     let fields: Vec<&str> = line.split('\t').collect();
-    if fields.len() != 3 {
-        return Err(format!("expected 3 tab-separated fields, got {}", fields.len()));
+    if !(3..=4).contains(&fields.len()) {
+        return Err(format!("expected 3 or 4 tab-separated fields, got {}", fields.len()).into());
     }
     let date = fields[0].trim();
     if !is_iso_date(date) {
-        return Err(format!("bad date {date:?}"));
+        return Err(format!("bad date {date:?}").into());
     }
     let account = fields[1].trim();
     if account.is_empty() || account.contains(',') {
-        return Err(format!("bad account {account:?}"));
+        return Err(format!("bad account {account:?}").into());
+    }
+    let currency = if fields.len() == 4 { fields[3] } else { "USD" };
+    if currency.len() != 3 || !currency.bytes().all(|b| b.is_ascii_uppercase()) {
+        return Err(ParseError {
+            message: format!("bad currency {currency:?}; expected three uppercase ASCII letters"),
+            invalid_currency: true,
+        });
     }
     Ok(Entry {
         date: date.to_string(),
         account: account.to_string(),
-        amount_cents: parse_cents(fields[2].trim())?,
+        amount_cents: parse_cents(fields[2].trim()).map_err(ParseError::from)?,
+        currency: currency.to_string(),
     })
 }
 
