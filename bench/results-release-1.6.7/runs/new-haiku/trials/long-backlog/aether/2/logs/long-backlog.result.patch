index 0000000..68ccf9b
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,50 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def test_impossible_calendar_dates_raise(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as ctx:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(ctx.exception))
+
+    def test_leap_day_accepted_in_leap_year(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+
+    def test_unsupported_forms_raise(self):
+        for text in ["", "   ", "soon", "2026-3-1", "2026-03-01x", "20260301"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_offsets(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+3d", TODAY), date(2026, 3, 13))
+        self.assertEqual(parse_due(" +5D ", TODAY), date(2026, 3, 15))
+
+    def test_negative_and_unsigned_offsets_raise(self):
+        for text in ["-3d", "3d", "+-3d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_offset_out_of_range_raises(self):
+        with self.assertRaises(InvalidDate):
+            parse_due("+99999999999d", TODAY)
+
+    def test_today_and_tomorrow_ignore_case_and_whitespace(self):
+        self.assertEqual(parse_due("  TODAY ", TODAY), TODAY)
+        self.assertEqual(parse_due(" Tomorrow ", TODAY), date(2026, 3, 11))
+
+    def test_invalid_date_is_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+
+if __name__ == "__main__":
+    unittest.main()
