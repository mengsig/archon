diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..81d8882
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,77 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def make_store():
+    store = TaskStore()
+    store.add("Fix login page", tags=["work"])
+    store.add("write report", tags=["Home", "work"])
+    store.add("fix signup")
+    store.complete(3)
+    return store
+
+
+def titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = make_store().all()
+
+    def test_blank_query_matches_everything_in_input_order(self):
+        self.assertEqual(titles(search(self.tasks, "")), titles(self.tasks))
+        self.assertEqual(titles(search(self.tasks, "   ")), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(titles(search(self.tasks, "REPORT")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, "fix")), ["Fix login page", "fix signup"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix login page"])
+        self.assertEqual(titles(search(self.tasks, '"login fix"')), [])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(titles(search(self.tasks, "fix login")), ["Fix login page"])
+        self.assertEqual(titles(search(self.tasks, "fix work")), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work")), ["Fix login page", "write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:HOME")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_tag_term_does_not_match_title_text(self):
+        self.assertEqual(titles(search(self.tasks, '"tag:work"')), [])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:open")), ["Fix login page", "write report"])
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["fix signup"])
+
+    def test_combined_terms(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work status:open fix")), ["Fix login page"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_empty_tag_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:pending")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_undo.py b/tests/test_undo.py
new file mode 100644
index 0000000..abbeae9
--- /dev/null
+++ b/tests/test_undo.py
@@ -0,0 +1,109 @@
+import unittest
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_empty_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_complete_restores_previous_status(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+
+    def test_undo_delete_restores_same_task(self):
+        store = TaskStore()
+        task = store.add("buy milk", tags=["home"])
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertIs(restored, task)
+        self.assertEqual(restored.title, "buy milk")
+        self.assertEqual(restored.tags, ["home"])
+        self.assertEqual(restored.status, "done")
+
+    def test_undo_delete_keeps_order_of_all(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.add("second")
+        store.delete(first.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [1, 2])
+
+    def test_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(store.get(b.id).title, "b")
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertEqual(second.id, 2)
+        self.assertEqual([t.id for t in store.all()], [2])
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("write report")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("write report")
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
