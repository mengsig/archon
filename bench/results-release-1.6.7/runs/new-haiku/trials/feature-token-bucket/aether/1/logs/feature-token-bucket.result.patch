+class BucketValidationTest(unittest.TestCase):
+    def test_invalid_capacity_or_rate_raises(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0),
+                               (float("nan"), 1.0), (1, float("nan")),
+                               (float("inf"), 1.0), (1, float("inf"))]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_n_raises_in_both_methods(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 2.5, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_failed_acquire_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(1)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+
+class RefillTest(unittest.TestCase):
+    def test_refill_is_fractional(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(1)
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 2.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 6.0
+        self.assertEqual(bucket.available(), 6.0)
+
+
+class WaitTimeTest(unittest.TestCase):
+    def test_zero_when_acquire_would_succeed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_does_not_consume(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(1), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(1), 1.0)
+        self.assertAlmostEqual(bucket.available(), 0.0)
+
+    def test_waiting_that_long_allows_acquire(self):
+        clock = FakeClock()
+        bucket = TokenBucket(5, 0.3, clock=clock)
+        bucket.try_acquire(5)
+        clock.now += bucket.wait_time(2)
+        self.assertTrue(bucket.try_acquire(2))
+
+
+class KeyedLimiterTest(unittest.TestCase):
+    def test_invalid_max_keys_raises(self):
+        for max_keys in [0, -1]:
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_capacity_raises(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        limiter.try_acquire("a", 2)
+        limiter.try_acquire("b")
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_invalid_n_does_not_evict(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        limiter.try_acquire("a", 2)
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", 0)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
     unittest.main()
