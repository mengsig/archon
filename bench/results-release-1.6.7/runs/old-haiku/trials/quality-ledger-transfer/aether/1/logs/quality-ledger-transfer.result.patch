+import threading
 import unittest
 
-from ledger import Ledger
+from ledger import MAX_BALANCE, Ledger
+
+BAD_INTEGERS = [True, False, 1.0, "1", None]
+JOIN_TIMEOUT_SECONDS = 60
+
+
+def run_threads(test, targets):
+    errors = []
+
+    def guarded(target):
+        try:
+            target()
+        except Exception as error:
+            errors.append(error)
+
+    threads = [threading.Thread(target=guarded, args=(target,)) for target in targets]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(JOIN_TIMEOUT_SECONDS)
+    test.assertFalse(any(thread.is_alive() for thread in threads), "threads deadlocked")
+    test.assertEqual(errors, [])
 
 
