diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..52796e9 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,41 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _require_int(name, value, *, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without big powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # base_ms * 2**exponent >= 2**(base bits - 1 + exponent), so once that
+    # reaches cap's bit length the product is certainly above cap.
+    if base_ms.bit_length() + exponent > cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << exponent)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..7dfe3b5 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,146 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_last_allowed_attempt_still_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_equal_to_max_is_exhausted(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_is_exhausted(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_exhausted_attempt_returns_none_even_with_zero_budget(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4, budget_ms=0))
+
+
+class Backoff(unittest.TestCase):
+    def test_cap_limits_growth(self):
+        self.assertEqual(retry_delay(5, 0, max_attempts=10, cap_ms=400,
+                                     budget_ms=10**9), 400)
+
+    def test_base_above_cap_yields_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_zero_base_yields_zero_delay(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero_delay(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_zero_delay_is_returned_when_budget_allows(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_huge_attempt_saturates_at_cap_quickly(self):
+        self.assertEqual(
+            retry_delay(10**100, 0, max_attempts=10**101,
+                        budget_ms=10**200, cap_ms=400),
+            400,
+        )
+
+    def test_huge_base_saturates_at_cap(self):
+        big = 10**50
+        self.assertEqual(retry_delay(2, 0, base_ms=big, cap_ms=400,
+                                     budget_ms=10**60), 400)
+
+    def test_no_upper_integer_limit_on_inputs(self):
+        self.assertEqual(
+            retry_delay(1, 10**30, base_ms=10**30, cap_ms=10**31,
+                        budget_ms=10**31),
+            10**30,
+        )
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=900,
+                        budget_ms=2000),
+            900,
+        )
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+    def test_retry_after_larger_than_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+
+class Budget(unittest.TestCase):
+    def test_delay_ending_exactly_at_budget_is_rejected(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_one_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_budget_is_not_met_by_shortening_wait(self):
+        self.assertIsNone(
+            retry_delay(2, 150, base_ms=100, budget_ms=350)
+        )
+
+    def test_zero_budget_rejects_everything(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_elapsed_already_past_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 5000, budget_ms=1000))
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_for_every_number(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, False)
+        self.assertInvalid(1, 0, max_attempts=True)
+        self.assertInvalid(1, 0, budget_ms=True)
+        self.assertInvalid(1, 0, base_ms=True)
+        self.assertInvalid(1, 0, cap_ms=True)
+        self.assertInvalid(1, 0, retry_after_ms=True)
+
+    def test_rejects_float_for_every_number(self):
+        self.assertInvalid(1.0, 0)
+        self.assertInvalid(1, 0.0)
+        self.assertInvalid(1, 0, max_attempts=4.0)
+        self.assertInvalid(1, 0, budget_ms=1000.0)
+        self.assertInvalid(1, 0, base_ms=100.0)
+        self.assertInvalid(1, 0, cap_ms=400.0)
+        self.assertInvalid(1, 0, retry_after_ms=1.5)
+
+    def test_rejects_non_numeric_types(self):
+        self.assertInvalid("1", 0)
+        self.assertInvalid(1, None)
+        self.assertInvalid(1, 0, retry_after_ms="5")
+
+    def test_rejects_attempt_below_one(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(-1, 0)
+
+    def test_rejects_max_attempts_below_one(self):
+        self.assertInvalid(1, 0, max_attempts=0)
+
+    def test_rejects_negative_elapsed_budget_base_cap_and_retry_after(self):
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_attempt_return(self):
+        self.assertInvalid(4, -1, max_attempts=4)
+        self.assertInvalid(10, 0, max_attempts=4, base_ms=-1)
+
+    def test_validates_before_exhausted_budget_return(self):
+        self.assertInvalid(1, 0, budget_ms=0, cap_ms=-5)
+        self.assertInvalid(1, 5000, budget_ms=1000, retry_after_ms=-1)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+if __name__ == "__main__":
+    unittest.main()
