@@ -1,5 +1,144 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import errno
+import os
+import stat
+from pathlib import Path
+
+NAME_MAX = 255
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _require_list(entries)
+    names = _validate_batch(entries)
+    root_path = _validate_root(root)
+    files, dirs = _plan_paths(names)
+    _check_targets(root_path, files, dirs)
+    _write_entries(root_path, entries)
+    return names
+
+
+def _require_list(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _validate_batch(entries):
+    return [_validate_entry(entry) for entry in entries]
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple: {entry!r}")
+    name, data = entry
+    _validate_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, not {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"name must be a nonempty relative path: {name!r}")
+    if "\\" in name or ":" in name or "\x00" in name:
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+    _check_component_sizes(name, parts)
+
+
+def _check_component_sizes(name, parts):
+    try:
+        sizes = [len(part.encode("utf-8")) for part in parts]
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name is not valid Unicode: {name!r}") from exc
+    if max(sizes) > NAME_MAX:
+        raise ValueError(f"name has a component over {NAME_MAX} bytes: {name!r}")
+
+
+def _parent_paths(name):
+    parts = name.split("/")
+    return ["/".join(parts[:i]) for i in range(1, len(parts))]
+
+
+def _plan_paths(names):
+    """Return the batch's file names and directory names; reject conflicts."""
+    files = set()
+    for name in names:
+        if name in files:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        files.add(name)
+    dirs = set()
+    for name in names:
+        dirs.update(_parent_paths(name))
+    clashes = files & dirs
+    if clashes:
+        raise ValueError(
+            f"name is both a file and a directory in the batch: {sorted(clashes)[0]!r}"
+        )
+    return files, dirs
+
+
+def _validate_root(root):
+    raw = _root_text(root)
+    if raw == "" or ".." in raw.split("/"):
+        raise ValueError(f"root must be a nonempty path without '..': {raw!r}")
+    root_path = Path(raw)
+    root_stat = _lstat_or_none(root_path)
+    if root_stat is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise ValueError(f"root must be a real directory, not a symlink or file: {root_path}")
+    return root_path
+
+
+def _root_text(root):
+    try:
+        raw = os.fspath(root)
+    except TypeError as exc:
+        raise ValueError(f"root must be a path or string, not {type(root).__name__}") from exc
+    if not isinstance(raw, str):
+        raise ValueError(f"root must be a text path, not {type(raw).__name__}")
+    return raw
+
+
+def _lstat_or_none(path):
+    """Return the lstat result for path, or None when it is absent."""
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+    except NotADirectoryError as exc:
+        raise ValueError(f"an existing ancestor is not a directory: {path}") from exc
+    except OSError as exc:
+        if exc.errno == errno.ENAMETOOLONG:
+            raise ValueError(f"path is too long: {path}") from exc
+        raise
+
+
+def _check_targets(root, files, dirs):
+    """Check every planned path below root against the filesystem, shallowest first."""
+    for relpath in sorted(files | dirs):
+        _check_target(root / relpath, relpath in files)
+
+
+def _check_target(path, is_file):
+    path_stat = _lstat_or_none(path)
+    if path_stat is None:
+        return
+    if is_file:
+        raise ValueError(f"target already exists: {path}")
+    if not stat.S_ISDIR(path_stat.st_mode):
+        raise ValueError(f"existing path must be a real directory: {path}")
+
+
+def _write_entries(root, entries):
+    for name, data in entries:
+        target = root / name
+        assert root in target.parents
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with open(target, "xb") as handle:
+            handle.write(data)
