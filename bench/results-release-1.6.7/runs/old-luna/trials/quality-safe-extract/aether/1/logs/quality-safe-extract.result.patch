diff --git a/safe_extract.py b/safe_extract.py
index 0007027..8f22f1a 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,96 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
 
-def extract(entries, root):
-    raise NotImplementedError
+
+def _validated_name(name):
+    if not isinstance(name, str):
+        raise ValueError("entry names must be strings")
+    if (
+        not name
+        or name.startswith("/")
+        or "\\" in name
+        or ":" in name
+        or "\0" in name
+    ):
+        raise ValueError(f"invalid entry name: {name!r}")
+
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"invalid entry name: {name!r}")
+    return parts
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a string or pathlib.Path")
+    try:
+        root_path = Path(root)
+        root_mode = os.lstat(root_path).st_mode
+    except (FileNotFoundError, NotADirectoryError, TypeError, ValueError) as exc:
+        raise ValueError("root must be an existing directory") from exc
+    if not stat.S_ISDIR(root_mode):
+        raise ValueError("root must be an existing real directory")
+    return root_path
+
+
+def _validate_filesystem(entries, root_path):
+    for name, _data, parts in entries:
+        current = root_path
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = os.lstat(current).st_mode
+            except FileNotFoundError:
+                # Once a parent is absent, no descendant can exist in this
+                # stable filesystem; the remaining components are safe to make.
+                break
+            except NotADirectoryError as exc:
+                raise ValueError(f"path component is not a directory: {current}") from exc
+
+            if stat.S_ISLNK(mode):
+                raise ValueError(f"path component is a symlink: {current}")
+            if index < len(parts) - 1:
+                if not stat.S_ISDIR(mode):
+                    raise ValueError(f"path component is not a directory: {current}")
+            else:
+                raise ValueError(f"target already exists: {current}")
+
+
+def extract(entries, root) -> list[str]:
+    """Create files named by *entries* beneath *root* after full validation."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    validated = []
+    names = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        parts = _validated_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in names:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        names.add(name)
+        validated.append((name, data, parts))
+
+    # A file cannot also be a directory needed by another batch entry.
+    for name, _data, parts in validated:
+        for end in range(1, len(parts)):
+            if "/".join(parts[:end]) in names:
+                raise ValueError(f"file/directory collision at {name!r}")
+
+    root_path = _validate_root(root)
+    _validate_filesystem(validated, root_path)
+
+    for _name, data, parts in validated:
+        target = root_path.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with target.open("xb") as stream:
+            stream.write(data)
+
+    return [name for name, _data, _parts in validated]
