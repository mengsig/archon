+from dataclasses import dataclass
+from typing import Optional
+
 from .models import DONE, Task
 
+ADD = "add"
+COMPLETE = "complete"
+DELETE = "delete"
+
 
 class UnknownTask(KeyError):
     pass
 
 
+class NothingToUndo(Exception):
+    pass
+
+
+@dataclass
+class _Change:
+    kind: str
+    task: Task
+    previous_status: Optional[str] = None
+
+
 class TaskStore:
     def __init__(self):
         self._tasks = {}
         self._next_id = 1
+        self._undo_log = []
 
     def add(self, title, tags=(), due=None):
         if not title.strip():
@@ -16,6 +35,7 @@ class TaskStore:
         task = Task(self._next_id, title.strip(), list(tags), due=due)
         self._tasks[task.id] = task
         self._next_id += 1
+        self._undo_log.append(_Change(ADD, task))
         return task
 
     def get(self, task_id):
@@ -26,13 +46,31 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append(_Change(COMPLETE, task, task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append(_Change(DELETE, task))
         del self._tasks[task_id]
         return task
 
+    def undo(self):
+        if not self._undo_log:
+            raise NothingToUndo("no add, complete or delete left to undo")
+        change = self._undo_log.pop()
+        task = change.task
+        if change.kind == ADD:
+            assert self._tasks.get(task.id) is task, "added task missing from store"
+            del self._tasks[task.id]
+        elif change.kind == COMPLETE:
+            assert task.id in self._tasks, "completed task missing from store"
+            task.status = change.previous_status
+        else:
+            assert task.id not in self._tasks, "deleted task id was reused"
+            self._tasks[task.id] = task
+        return task
+
     def all(self):
         return sorted(self._tasks.values(), key=lambda t: t.id)
