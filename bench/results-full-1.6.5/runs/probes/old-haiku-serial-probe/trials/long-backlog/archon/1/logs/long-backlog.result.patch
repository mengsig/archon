@@ -0,0 +1,138 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoAddTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(a.id)
+        self.assertEqual(store.all(), [])
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        a = store.add("first")
+        store.undo()
+        b = store.add("second")
+        self.assertEqual(b.id, a.id + 1)
+        self.assertEqual([t.id for t in store.all()], [b.id])
+
+
+class UndoCompleteTest(unittest.TestCase):
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+
+    def test_undo_complete_of_already_done_task_keeps_it_done(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, DONE)
+
+
+class UndoDeleteTest(unittest.TestCase):
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["work", "q3"], due=date(2026, 4, 1))
+        store.delete(a.id)
+        store.undo()
+        restored = store.get(a.id)
+        self.assertEqual(restored.id, a.id)
+        self.assertEqual(restored.title, "write report")
+        self.assertEqual(restored.tags, ["work", "q3"])
+        self.assertEqual(restored.due, date(2026, 4, 1))
+        self.assertEqual(restored.status, OPEN)
+
+    def test_undo_delete_restores_status_at_time_of_delete(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.delete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, DONE)
+
+
+class UndoOrderTest(unittest.TestCase):
+    def test_nothing_to_undo_on_empty_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_walks_back_lifo_across_mixed_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.add("c")
+
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_past_history_raises_nothing_to_undo(self):
+        store = TaskStore()
+        store.add("a")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undone_operation_is_not_undone_twice(self):
+        store = TaskStore()
+        store.add("a")
+        store.add("b")
+        store.undo()
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+class UndoFailedOperationTest(unittest.TestCase):
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        a = store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        self.assertNotIn(a.id, [t.id for t in store.all()])
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
