+test('follows cursors and preserves their values', async () => {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    if (request.query.cursor === undefined) {
+      return { status: 200, body: { items: [ITEMS[0]], next_cursor: 'opaque/cursor+1' } };
+    }
+    assert.equal(request.query.cursor, 'opaque/cursor+1');
+    return { status: 200, body: { items: [ITEMS[1]], next_cursor: null } };
+  };
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen.map((request) => request.query), [{}, { cursor: 'opaque/cursor+1' }]);
+});
