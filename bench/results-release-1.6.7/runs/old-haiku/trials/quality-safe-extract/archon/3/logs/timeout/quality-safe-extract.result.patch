+def snapshot(base):
+    """Map every path under base to its kind and contents, without following links."""
+    state = {}
+    for dirpath, dirnames, filenames in os.walk(base):
+        for name in dirnames + filenames:
+            full = os.path.join(dirpath, name)
+            key = os.path.relpath(full, base)
+            if os.path.islink(full):
+                state[key] = ("link", os.readlink(full))
+            elif os.path.isdir(full):
+                state[key] = ("dir", None)
+            else:
+                state[key] = ("file", Path(full).read_bytes())
+    return state
+
