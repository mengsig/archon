diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..27d02a9
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,45 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("starting ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("writing stdin");
+    child.wait_with_output().expect("waiting for ledger")
+}
+
+#[test]
+fn exports_csv_with_currency_column() {
+    let out = run("2026-03-01\tgroceries\t-45.10\n2026-03-02\trent\t1200\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8(out.stdout).unwrap(),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,-4510,USD\n\
+         2026-03-02,rent,120000,EUR\n"
+    );
+}
+
+#[test]
+fn bad_currency_exits_two_and_names_line() {
+    let out = run("2026-03-01\tgroceries\t1\n2026-03-02\trent\t1\teur\n");
+    assert_eq!(out.status.code(), Some(2));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 2: "), "stderr was {stderr:?}");
+}
+
+#[test]
+fn other_bad_input_exits_one() {
+    let out = run("March 1\tgroceries\t1\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(String::from_utf8(out.stderr).unwrap().starts_with("line 1: "));
+}
diff --git a/tests/ledger.rs b/tests/ledger.rs
index 6293987..618503b 100644
--- a/tests/ledger.rs
+++ b/tests/ledger.rs
@@ -18,3 +18,34 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn defaults_currency_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert!(to_csv_row(&entry).ends_with(",USD"));
+}
+
+#[test]
+fn parses_explicit_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    for code in ["eur", "EU", "EURO", "E1R", "€UR", ""] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert_eq!(err.exit_status(), 2, "code {code:?}");
+    }
+}
+
+#[test]
+fn other_errors_exit_with_status_one() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tEUR\textra").unwrap_err();
+    assert_eq!(err.exit_status(), 1);
+    let err = parse_line("March 1\tgroceries\t1").unwrap_err();
+    assert_eq!(err.exit_status(), 1);
+}
