@@ -7,6 +7,20 @@ def get(path, **query):
     return handle({"method": "GET", "path": path, "query": query})
 
 
+def walk_pages(**query):
+    """Follow next_cursor from the first page and return every item id, in order."""
+    ids = []
+    cursor = None
+    while True:
+        params = dict(query, **({"cursor": cursor} if cursor else {}))
+        res = get("/items", **params)
+        assert res["status"] == 200, res
+        ids.extend(item["id"] for item in res["body"]["items"])
+        cursor = res["body"]["next_cursor"]
+        if cursor is None:
+            return ids
+
