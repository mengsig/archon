diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..761c849 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,62 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    """A search query that is malformed or uses an unknown field or status."""
+
+
+def split_terms(query):
+    """Split on whitespace outside double quotes. Quotes stay in the term."""
+    terms = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+        if char.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+            current = []
+        else:
+            current.append(char)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
+def parse_term(term):
+    """Return a predicate that tells whether a task matches one query term."""
+    assert term, "query terms are never empty"
+    if term.startswith('"') or ":" not in term:
+        phrase = term.replace('"', "").casefold()
+        return lambda task: phrase in task.title.casefold()
+    field, _, value = term.partition(":")
+    value = value.replace('"', "").casefold()
+    if field.casefold() == "tag":
+        return _tag_predicate(value)
+    if field.casefold() == "status":
+        return _status_predicate(value)
+    raise QueryError(f"unknown field {field!r} in term {term!r}")
+
+
+def _tag_predicate(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    return lambda task: name in [tag.casefold() for tag in task.tags]
+
+
+def _status_predicate(status):
+    if status not in STATUSES:
+        raise QueryError(f"unknown status {status!r}; use open or done")
+    return lambda task: task.status == status
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Return the tasks matching every term of the query, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    predicates = [parse_term(term) for term in split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
