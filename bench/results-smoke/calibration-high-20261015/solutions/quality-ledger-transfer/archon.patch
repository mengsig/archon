+class LedgerConcurrency(unittest.TestCase):
+    ITERATIONS = 2000
+    # Failure bound only; a hung thread fails the test after this many seconds.
+    JOIN_TIMEOUT = 5
+
+    def setUp(self):
+        # Force frequent thread switches so lock-free races show up reliably.
+        interval = sys.getswitchinterval()
+        sys.setswitchinterval(1e-6)
+        self.addCleanup(sys.setswitchinterval, interval)
+
+    def _run_threads(self, targets):
+        errors = []
+
+        def guard(target):
+            try:
+                target()
+            except BaseException as exc:
+                errors.append(exc)
+
+        threads = [threading.Thread(target=guard, args=(t,), daemon=True) for t in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.JOIN_TIMEOUT)
+            self.assertFalse(thread.is_alive(), "deadlock or hang")
+        self.assertEqual(errors, [])
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        barrier = threading.Barrier(2, timeout=self.JOIN_TIMEOUT)
+
+        def worker(source, destination):
+            barrier.wait()
+            for _ in range(self.ITERATIONS):
+                ledger.transfer(source, destination, 1)
+
+        self._run_threads([lambda: worker("a", "b"), lambda: worker("b", "a")])
+        snap = ledger.snapshot()
+        self.assertEqual(sum(snap.values()), 2000)
+        self.assertTrue(all(balance >= 0 for balance in snap.values()))
+
+    def test_snapshots_never_see_half_transfer(self):
+        total = 100
+        ledger = Ledger({"a": total, "b": 0})
+        failures = []
+
+        def writer():
+            for _ in range(self.ITERATIONS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def reader():
+            for _ in range(self.ITERATIONS):
+                snap = ledger.snapshot()
+                if sum(snap.values()) != total:
+                    failures.append(snap)
+
+        self._run_threads([writer, reader])
+        self.assertEqual(failures, [])
+        self.assertEqual(sum(ledger.snapshot().values()), total)
