+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation(self):
+        for balances in (None, [], (("a", 1),)):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+        for balances in (
+            {"": 1},
+            {1: 1},
+            {"a": -1},
+            {"a": MAX_BALANCE + 1},
+            {"a": True},
+            {"a": 1.0},
+        ):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+    def test_input_and_snapshots_are_copied(self):
+        original = {"a": 4}
+        ledger = Ledger(original)
+        original["a"] = 99
+        original["b"] = 1
+        result = ledger.snapshot()
+        result["a"] = 0
+        result["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_empty_ledger_and_transfer_amount_validation(self):
+        ledger = Ledger({})
+        self.assertEqual(ledger.snapshot(), {})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0, "1"):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also-missing", amount)
+
+    def test_unknown_accounts_raise_key_error_after_amount_validation(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(ValueError):
+            ledger.transfer("missing", "a", 0)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer([], "a", 1)
+
+    def test_insufficient_funds_and_overflow_leave_state_unchanged(self):
+        ledger = Ledger({"poor": 2, "full": MAX_BALANCE})
+        before = ledger.snapshot()
+        self.assertFalse(ledger.transfer("poor", "full", 3))
+        self.assertFalse(ledger.transfer("poor", "full", 1))
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_same_account_checks_funds_without_mutating_even_at_limit(self):
+        ledger = Ledger({"full": MAX_BALANCE, "small": 2})
+        self.assertTrue(ledger.transfer("full", "full", MAX_BALANCE))
+        self.assertFalse(ledger.transfer("small", "small", 3))
+        self.assertEqual(ledger.snapshot(), {"full": MAX_BALANCE, "small": 2})
+
+    def test_concurrent_opposite_transfers_and_snapshots_are_atomic(self):
+        ledger = Ledger({"left": 100, "right": 100})
+        start = Barrier(3)
+        observed_totals = []
+        errors = []
+
+        def move(source, destination):
+            start.wait()
+            try:
+                completed = 0
+                while completed < 3000:
+                    if ledger.transfer(source, destination, 1):
+                        completed += 1
+            except Exception as error:
+                errors.append(error)
+
+        def observe():
+            start.wait()
+            for _ in range(3000):
+                state = ledger.snapshot()
+                observed_totals.append(state["left"] + state["right"])
+
+        threads = [
+            Thread(target=move, args=("left", "right")),
+            Thread(target=move, args=("right", "left")),
+            Thread(target=observe),
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(set(observed_totals), {200})
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 200)
