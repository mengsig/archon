@@ -0,0 +1,67 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ExportTest(unittest.TestCase):
+    def test_header_only_when_no_tasks(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_rows_keep_given_order(self):
+        tasks = [Task(2, "second"), Task(1, "first")]
+        self.assertEqual(to_csv(tasks), HEADER + "2,second,,open,\r\n1,first,,open,\r\n")
+
+    def test_tags_joined_with_semicolon(self):
+        tasks = [Task(1, "t", tags=["work", "urgent"])]
+        self.assertEqual(to_csv(tasks), HEADER + "1,t,work;urgent,open,\r\n")
+
+    def test_due_date_iso_or_empty(self):
+        tasks = [Task(1, "a", due=date(2026, 4, 1)), Task(2, "b", due=None)]
+        self.assertEqual(to_csv(tasks), HEADER + "1,a,,open,2026-04-01\r\n2,b,,open,\r\n")
+
+    def test_status_written(self):
+        tasks = [Task(1, "a", status=DONE)]
+        self.assertEqual(to_csv(tasks), HEADER + "1,a,,done,\r\n")
+
+    def test_plain_fields_not_quoted(self):
+        tasks = [Task(1, "buy milk; eggs 'n' bread", tags=["home"])]
+        self.assertEqual(to_csv(tasks), HEADER + "1,buy milk; eggs 'n' bread,home,open,\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        tasks = [Task(1, "fix login, then test")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"fix login, then test",,open,\r\n')
+
+    def test_title_with_double_quote_is_quoted_and_doubled(self):
+        tasks = [Task(1, 'read "Dune"')]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"read ""Dune""",,open,\r\n')
+
+    def test_title_with_cr_is_quoted(self):
+        tasks = [Task(1, "a\rb")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"a\rb",,open,\r\n')
+
+    def test_title_with_lf_is_quoted(self):
+        tasks = [Task(1, "line one\nline two")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"line one\nline two",,open,\r\n')
+
+    def test_title_with_comma_quote_and_newline(self):
+        tasks = [Task(1, 'a, "b"\r\nc')]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"a, ""b""\r\nc",,open,\r\n')
+
+    def test_tag_with_comma_is_quoted(self):
+        tasks = [Task(1, "t", tags=["a,b", "c"])]
+        self.assertEqual(to_csv(tasks), HEADER + '1,t,"a,b;c",open,\r\n')
+
+    def test_every_line_ends_with_crlf(self):
+        tasks = [Task(1, "x\ny"), Task(2, "plain")]
+        output = to_csv(tasks)
+        self.assertTrue(output.endswith("\r\n"))
+        self.assertEqual(output.count("\r\n"), 3)
+        self.assertEqual(output.count("\n") - output.count("\r\n"), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
