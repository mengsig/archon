 """Extract validated regular-file entries. See SPEC.md."""
 
+from pathlib import Path
+import stat
 
-def extract(entries, root):
-    raise NotImplementedError
+
+def _validate_name(name):
+    if not isinstance(name, str) or not name or name.startswith("/"):
+        raise ValueError("entry names must be nonempty relative POSIX paths")
+    if "\\" in name or ":" in name or "\0" in name:
+        raise ValueError("entry name contains a forbidden character")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError("entry name contains an invalid path component")
+    return parts
+
+
+def extract(entries, root) -> list[str]:
+    """Create regular files below an existing directory without overwriting."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    names = []
+    paths = {}
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        parts = _validate_name(name)
+        if name in paths:
+            raise ValueError("duplicate entry name")
+        paths[name] = parts
+        names.append(name)
+
+    # A path which is also a parent of another batch entry cannot be a file.
+    name_set = set(paths)
+    for name, parts in paths.items():
+        if any("/".join(parts[:i]) in name_set for i in range(1, len(parts))):
+            raise ValueError("file/directory collision in entries")
+
+    try:
+        base = Path(root)
+    except (TypeError, ValueError) as exc:
+        raise ValueError("root must be an existing real directory") from exc
+    try:
+        root_mode = base.lstat().st_mode
+    except FileNotFoundError as exc:
+        raise ValueError("root must be an existing real directory") from exc
+    if stat.S_ISLNK(root_mode) or not stat.S_ISDIR(root_mode):
+        raise ValueError("root must be an existing real directory")
+
+    # Inspect every component before making any filesystem changes.
+    for parts in paths.values():
+        current = base
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = current.lstat().st_mode
+            except FileNotFoundError:
+                break
+            if stat.S_ISLNK(mode):
+                raise ValueError("existing path component is a symlink")
+            if index < len(parts) - 1:
+                if not stat.S_ISDIR(mode):
+                    raise ValueError("existing ancestor is not a directory")
+            else:
+                raise ValueError("target already exists")
+
+    # Validation is complete. Create parents and exclusive files; the caller
+    # guarantees a stable filesystem, so no concurrent mutation is in scope.
+    for name, data in entries:
+        target = base.joinpath(*paths[name])
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with target.open("xb") as output:
+            output.write(data)
+    return names
