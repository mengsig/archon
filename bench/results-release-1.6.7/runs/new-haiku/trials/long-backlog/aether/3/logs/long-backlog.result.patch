diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..b3cec54 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,71 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order.
+
+    Terms: bare words or `"phrases"` (title substring, case-insensitive),
+    `tag:NAME` and `status:open|done`. A blank query matches everything.
+    """
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_matcher(raw) for raw in _tokenize(query)]
+    return [task for task in tasks if all(matches(task) for matches in matchers)]
+
+
+def _tokenize(query):
+    """Split on whitespace outside double quotes; quote characters are kept."""
+    tokens, current, in_quote = [], [], False
+    for char in query:
+        if char == '"':
+            in_quote = not in_quote
+        if char.isspace() and not in_quote:
+            if current:
+                tokens.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if in_quote:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if current:
+        tokens.append("".join(current))
+    assert all(tokens), "tokens must be non-empty"
+    return tokens
+
+
+def _matcher(raw):
+    head, colon, value = raw.partition(":")
+    if colon and '"' not in head:
+        return _field_matcher(head.lower(), value.replace('"', ""))
+    return _text_matcher(raw.replace('"', "").lower())
+
+
+def _text_matcher(needle):
+    return lambda task: needle in task.title.lower()
+
+
+def _field_matcher(name, value):
+    if name == "tag":
+        return _tag_matcher(value)
+    if name == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown field: {name}")
+
+
+def _tag_matcher(value):
+    if not value:
+        raise QueryError("tag: needs a tag name")
+    needle = value.lower()
+    return lambda task: any(tag.lower() == needle for tag in task.tags)
+
+
+def _status_matcher(value):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status: {value}")
+    return lambda task: task.status == status
