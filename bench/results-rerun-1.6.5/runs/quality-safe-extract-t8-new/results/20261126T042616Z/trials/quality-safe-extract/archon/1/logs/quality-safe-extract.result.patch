 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    names = _validate_entries(entries)
+    root_path = _validate_root(root)
+    for name in names:
+        _check_target(root_path, name)
+    _write_entries(root_path, entries)
+    return names
+
+
+def _validate_entries(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    names = [_validate_entry(entry) for entry in entries]
+    if len(set(names)) != len(names):
+        raise ValueError("batch contains duplicate names")
+    _check_name_collisions(names)
+    return names
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, not {type(entry).__name__}")
+    name, data = entry
+    _validate_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, not {type(name).__name__}")
+    if not name:
+        raise ValueError("name must not be empty")
+    for forbidden in ("\\", ":", "\x00"):
+        if forbidden in name:
+            raise ValueError(f"name {name!r} contains forbidden character {forbidden!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"name {name!r} has invalid component {part!r}")
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name {name!r} cannot be encoded for the filesystem") from exc
+
+
+def _check_name_collisions(names):
+    all_names = set(names)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in all_names:
+                raise ValueError(f"{ancestor!r} collides with {name!r} in batch")
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, not {type(root).__name__}")
+    if str(root) == "":
+        raise ValueError("root must not be empty")
+    root_path = Path(root)
+    try:
+        root_stat = _lstat_or_none(root_path)
+    except NotADirectoryError as exc:
+        raise ValueError(f"root {str(root)!r} has a non-directory ancestor") from exc
+    if root_stat is None:
+        raise ValueError(f"root {str(root)!r} does not exist")
+    if stat.S_ISLNK(root_stat.st_mode):
+        raise ValueError(f"root {str(root)!r} is a symlink")
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise ValueError(f"root {str(root)!r} is not a directory")
+    return root_path
+
+
+def _check_target(root, name):
+    parts = name.split("/")
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        ancestor_stat = _lstat_or_none(current)
+        if ancestor_stat is None:
+            return
+        if stat.S_ISLNK(ancestor_stat.st_mode):
+            raise ValueError(f"{str(current)!r} is a symlink")
+        if not stat.S_ISDIR(ancestor_stat.st_mode):
+            raise ValueError(f"{str(current)!r} is not a directory")
+    if _lstat_or_none(root.joinpath(*parts)) is not None:
+        raise ValueError(f"target {name!r} already exists")
+
+
+def _write_entries(root, entries):
+    for name, data in entries:
+        target = root.joinpath(*name.split("/"))
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with open(target, "xb") as handle:
+            handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
