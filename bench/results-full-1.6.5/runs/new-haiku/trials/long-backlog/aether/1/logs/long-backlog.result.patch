@@ -0,0 +1,73 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login page", tags=["Work", "urgent"])
+    store.add("write report", tags=["work"])
+    store.add("buy milk, eggs", tags=["home"])
+    store.add("fix login bug")
+    store.complete(2)
+    return store
+
+
+def _titles(query):
+    return [task.title for task in search(_store().all(), query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(_titles("LOGIN"), ["Fix login page", "fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_titles('"fix login"'), ["Fix login page", "fix login bug"])
+        self.assertEqual(_titles('"login page"'), ["Fix login page"])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(_titles("fix bug"), ["fix login bug"])
+        self.assertEqual(_titles("fix report"), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(_titles("tag:WORK"), ["Fix login page", "write report"])
+        self.assertEqual(_titles("tag:wor"), [])
+
+    def test_status_filter(self):
+        self.assertEqual(_titles("status:done"), ["write report"])
+        self.assertEqual(_titles("status:open login"), ["Fix login page", "fix login bug"])
+
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(_titles(""), _titles("   "))
+        self.assertEqual(len(_titles("  ")), 4)
+
+    def test_quoted_field_like_text_is_a_phrase(self):
+        self.assertEqual(_titles('"tag:work"'), [])
+
+    def test_comma_inside_title_is_plain_text(self):
+        self.assertEqual(_titles('"milk, eggs"'), ["buy milk, eggs"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "priority:high")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "status:archived")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), '"fix login')
+
+    def test_results_keep_input_order(self):
+        tasks = list(reversed(_store().all()))
+        self.assertEqual([t.id for t in search(tasks, "login")], [4, 1])
+
+
+if __name__ == "__main__":
+    unittest.main()
