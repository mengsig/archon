+class LedgerValidation(unittest.TestCase):
+    def test_construction_rejects_invalid_inputs(self):
+        for balances in (None, [], {"": 1}, {1: 1}, {"a": -1},
+                         {"a": MAX_BALANCE + 1}, {"a": True}, {"a": 1.0}):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+    def test_empty_ledger_and_input_snapshot_copying(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+        original = {"a": 4}
+        ledger = Ledger(original)
+        original["a"] = 9
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 12
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also-missing", amount)
+
+    def test_unknown_accounts_raise_key_error_after_amount_validation(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_destination_overflow_is_atomic(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 2})
+        self.assertIs(ledger.transfer("a", "b", 3), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE - 2})
+
+    def test_same_account_checks_funds_without_overflow(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+        poor = Ledger({"a": 0})
+        self.assertIs(poor.transfer("a", "a", 1), False)
+        self.assertEqual(poor.snapshot(), {"a": 0})
+
+    def test_success_preserves_total_at_balance_limit(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+
+class LedgerConcurrency(unittest.TestCase):
+    def test_opposite_transfers_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = Barrier(3)
+
+        def move(source, destination):
+            start.wait()
+            for _ in range(1000):
+                ledger.transfer(source, destination, 1)
+
+        threads = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for thread in threads:
+            thread.start()
+        start.wait()
+        for thread in threads:
+            thread.join()
+        snapshot = ledger.snapshot()
+        self.assertEqual(sum(snapshot.values()), 200)
+        self.assertGreaterEqual(snapshot["a"], 0)
+        self.assertGreaterEqual(snapshot["b"], 0)
