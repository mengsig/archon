 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _check_bucket_params(capacity, refill_per_sec):
+    if not capacity > 0:
+        raise ValueError(f"capacity must be > 0, got {capacity!r}")
+    if not refill_per_sec > 0:
+        raise ValueError(f"refill_per_sec must be > 0, got {refill_per_sec!r}")
+
+
+def _check_request(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must satisfy 0 < n <= capacity ({capacity}), got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        # Latest time seen; refill only accrues for time past this point.
+        self._last = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now > self._last:
+            elapsed = now - self._last
+            self._tokens = min(self._capacity, self._tokens + elapsed * self._refill_per_sec)
+            self._last = now
+        assert 0 <= self._tokens <= self._capacity, self._tokens
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        deficit = n - self._tokens
+        if deficit <= 0:
+            return 0.0
+        return deficit / self._refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        if not max_keys >= 1:
+            raise ValueError(f"max_keys must be >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        # Ordered from least to most recently used.
+        self._buckets = OrderedDict()
+
+    def _bucket_for(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys, len(self._buckets)
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket_for(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
