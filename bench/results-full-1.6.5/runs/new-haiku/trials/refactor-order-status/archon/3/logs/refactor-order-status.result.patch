+++ b/tests/status.rs
@@ -0,0 +1,48 @@
+use orders::{OrderStatus, ParseStatusError};
+use std::error::Error;
+
+#[test]
+fn only_the_four_listed_transitions_are_allowed() {
+    use OrderStatus::*;
+    let allowed = [
+        (Pending, Paid),
+        (Pending, Cancelled),
+        (Paid, Shipped),
+        (Paid, Cancelled),
+    ];
+    for from in OrderStatus::ALL {
+        for to in OrderStatus::ALL {
+            assert_eq!(
+                from.can_transition_to(to),
+                allowed.contains(&(from, to)),
+                "{from} -> {to}"
+            );
+        }
+    }
+}
+
+#[test]
+fn display_and_as_str_agree_with_the_wire_names() {
+    let names: Vec<String> = OrderStatus::ALL.iter().map(|s| s.to_string()).collect();
+    assert_eq!(names, ["pending", "paid", "shipped", "cancelled"]);
+    for status in OrderStatus::ALL {
+        assert_eq!(status.as_str(), status.to_string());
+    }
+}
+
+#[test]
+fn parse_accepts_exact_names_only() {
+    for status in OrderStatus::ALL {
+        assert_eq!(status.as_str().parse::<OrderStatus>().unwrap(), status);
+    }
+    let err = "Paid".parse::<OrderStatus>().unwrap_err();
+    assert_eq!(err.to_string(), "unknown status \"Paid\"");
+    assert!("".parse::<OrderStatus>().is_err());
+}
+
+#[test]
+fn parse_error_is_a_std_error() {
+    let err: ParseStatusError = "lost".parse::<OrderStatus>().unwrap_err();
+    let as_dyn: &dyn Error = &err;
+    assert_eq!(as_dyn.to_string(), "unknown status \"lost\"");
+}
