diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..119118e 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,36 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an int >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an int >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    else:
+        # Once the exponent reaches this threshold, the uncapped value is
+        # certainly at least cap_ms. Avoid constructing an enormous integer.
+        exponent = attempt - 1
+        if base_ms >= cap_ms or exponent >= (cap_ms - 1).bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+        delay = max(backoff, retry_after_ms or 0)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..8d8a1f2 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,51 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validation_precedes_exhausted_returns(self):
+        for kwargs in ({"attempt": True}, {"elapsed_ms": 1.0},
+                       {"max_attempts": False}, {"budget_ms": -1},
+                       {"base_ms": -1}, {"cap_ms": -1},
+                       {"retry_after_ms": True}):
+            args = {"attempt": 4, "elapsed_ms": 0}
+            args.update(kwargs)
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                retry_delay(**args)
+
+    def test_all_numeric_arguments_reject_non_builtin_ints(self):
+        class IntSubclass(int):
+            pass
+
+        for name, value in (("attempt", IntSubclass(1)),
+                            ("elapsed_ms", IntSubclass(0)),
+                            ("max_attempts", IntSubclass(1)),
+                            ("budget_ms", IntSubclass(1)),
+                            ("base_ms", IntSubclass(1)),
+                            ("cap_ms", IntSubclass(1)),
+                            ("retry_after_ms", IntSubclass(0))):
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                args = {"attempt": 1, "elapsed_ms": 0}
+                args[name] = value
+                retry_delay(**args)
+
+    def test_attempts_and_zero_values(self):
+        self.assertIsNone(retry_delay(99, 0, max_attempts=4))
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 5, budget_ms=5, base_ms=0))
+        self.assertEqual(retry_delay(1, 4, budget_ms=5, base_ms=0), 0)
+
+    def test_cap_and_large_attempt_saturate(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=10), 10)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1,
+                                     base_ms=1, cap_ms=7), 7)
+
+    def test_retry_after_is_uncapped_and_budget_is_strict(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=1000, cap_ms=10,
+                                     retry_after_ms=500), 500)
+        self.assertIsNone(retry_delay(1, 499, budget_ms=500,
+                                      base_ms=1, retry_after_ms=1))
+        self.assertEqual(retry_delay(1, 498, budget_ms=500,
+                                     base_ms=1, retry_after_ms=1), 1)
