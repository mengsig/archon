@@ -0,0 +1,75 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+def _csv_for(*tasks):
+    return to_csv(list(tasks))
+
+
+class ExportTest(unittest.TestCase):
+    def test_empty_input_gives_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_header_and_rows_end_with_crlf(self):
+        text = _csv_for(Task(1, "a"), Task(2, "b"))
+        self.assertEqual(text, HEADER + "1,a,,open,\r\n2,b,,open,\r\n")
+
+    def test_rows_keep_input_order(self):
+        text = _csv_for(Task(7, "second"), Task(3, "first"))
+        self.assertEqual(text, HEADER + "7,second,,open,\r\n3,first,,open,\r\n")
+
+    def test_tags_joined_with_semicolon_and_due_iso(self):
+        task = Task(1, "x", tags=["a", "b"], status="done", due=date(2026, 4, 1))
+        self.assertEqual(_csv_for(task), HEADER + "1,x,a;b,done,2026-04-01\r\n")
+
+    def test_plain_fields_are_not_quoted(self):
+        task = Task(1, "plain title with spaces", tags=["t"])
+        self.assertEqual(_csv_for(task), HEADER + "1,plain title with spaces,t,open,\r\n")
+
+    def test_comma_in_title_is_quoted(self):
+        task = Task(1, "milk, eggs")
+        self.assertEqual(_csv_for(task), HEADER + '1,"milk, eggs",,open,\r\n')
+
+    def test_double_quote_is_quoted_and_doubled(self):
+        task = Task(1, 'say "hi"')
+        self.assertEqual(_csv_for(task), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_lf_in_title_is_quoted(self):
+        task = Task(1, "line1\nline2")
+        self.assertEqual(_csv_for(task), HEADER + '1,"line1\nline2",,open,\r\n')
+
+    def test_cr_in_title_is_quoted(self):
+        task = Task(1, "a\rb")
+        self.assertEqual(_csv_for(task), HEADER + '1,"a\rb",,open,\r\n')
+
+    def test_crlf_in_title_is_quoted_once(self):
+        task = Task(1, "a\r\nb")
+        self.assertEqual(_csv_for(task), HEADER + '1,"a\r\nb",,open,\r\n')
+
+    def test_comma_in_tag_quotes_the_tags_field(self):
+        task = Task(1, "x", tags=["a,b", "c"])
+        self.assertEqual(_csv_for(task), HEADER + '1,x,"a,b;c",open,\r\n')
+
+    def test_quoted_title_round_trips_through_csv_reader(self):
+        title = 'He said "a, b"\nthen left\r\n'
+        text = _csv_for(Task(1, title, tags=["x"]))
+        rows = list(csv.reader(io.StringIO(text, newline="")))
+        self.assertEqual(rows, [HEADER.strip().split(","), ["1", title, "x", "open", ""]])
+
+    def test_store_tasks_export(self):
+        store = TaskStore()
+        store.add("buy, sell", tags=["work"])
+        lines = to_csv(store.all()).split("\r\n")
+        self.assertEqual(lines[1], '1,"buy, sell",work,open,')
+
+
+if __name__ == "__main__":
+    unittest.main()
