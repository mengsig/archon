@@ -27,12 +37,34 @@ class TaskStore:
     def complete(self, task_id):
         task = self.get(task_id)
         task.status = DONE
+        self._undo_log.append((COMPLETED, task_id))
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
         del self._tasks[task_id]
+        self._undo_log.append((DELETED, task))
         return task
 
+    def undo(self):
+        """Revert the most recent add, complete or delete that is not yet undone."""
+        if not self._undo_log:
+            raise NothingToUndo("no add, complete or delete left to undo")
+        kind, payload = self._undo_log.pop()
+        if kind == ADDED:
+            self._remove_added(payload)
+        elif kind == COMPLETED:
+            self.get(payload).status = OPEN
+        else:
+            self._restore_deleted(payload)
+
+    def _remove_added(self, task_id):
+        assert task_id in self._tasks, f"added task {task_id} vanished before undo"
+        del self._tasks[task_id]
+
+    def _restore_deleted(self, task):
+        assert task.id not in self._tasks, f"task {task.id} was re-added before undo"
+        self._tasks[task.id] = task
