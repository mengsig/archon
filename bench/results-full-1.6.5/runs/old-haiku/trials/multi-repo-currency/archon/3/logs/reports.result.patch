-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+A CSV without a currency column counts every row as USD.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_RE = re.compile(r"[A-Z]{3}")
+
+
+class MalformedCurrency(ValueError):
+    pass
+
+
+def parse_currency(code, line_no):
+    """Return the ISO 4217 code, or raise MalformedCurrency."""
+    if code is None or not CURRENCY_RE.fullmatch(code):
+        raise MalformedCurrency(
+            f"line {line_no}: malformed currency code {code!r}"
+        )
+    return code
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(reader):
+    """{(account, currency): total_cents} from a csv.DictReader."""
+    has_currency = "currency" in (reader.fieldnames or [])
     result = {}
-    for row in rows:
+    for row in reader:
+        line_no = reader.line_num
         account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+        currency = (
+            parse_currency(row["currency"], line_no)
+            if has_currency
+            else DEFAULT_CURRENCY
+        )
+        key = (account, currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        total = result[(account, currency)]
+        lines.append(f"{account},{currency},{total}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(csv.DictReader(sys.stdin))
+    except MalformedCurrency as err:
+        sys.stderr.write(f"error: {err}\n")
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
