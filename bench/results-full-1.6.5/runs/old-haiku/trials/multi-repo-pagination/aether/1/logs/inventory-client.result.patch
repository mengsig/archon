+function pagedTransport(items, pageSize, sentQueries) {
+  return async (request) => {
+    sentQueries.push(request.query);
+    const start = request.query.cursor === undefined ? 0 : Number(request.query.cursor);
+    const page = items.slice(start, start + pageSize);
+    const end = start + page.length;
+    const next_cursor = end < items.length ? String(end) : null;
+    return { status: 200, body: { items: page, next_cursor } };
+  };
+}
+
+test('follows next_cursor across pages, in order', async () => {
+  const all = Array.from({ length: 7 }, (_, i) => ({ id: i + 1, sku: `SKU-${i + 1}`, qty: 5 }));
+  const sent = [];
+  assert.deepEqual(await listItems(pagedTransport(all, 3, sent)), all);
+  assert.deepEqual(sent, [{}, { cursor: '3' }, { cursor: '6' }]);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const transport = async () => ({ status: 200, body: { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
+test('fails instead of looping when the cursor does not advance', async () => {
+  const stuck = async () => ({ status: 200, body: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(stuck), /same next_cursor twice/);
+});
+
