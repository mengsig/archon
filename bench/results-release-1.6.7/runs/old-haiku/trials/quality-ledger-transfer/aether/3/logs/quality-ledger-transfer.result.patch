+class LedgerTransferSemantics(unittest.TestCase):
+    def test_exact_balance_transfer_empties_source(self):
+        ledger = Ledger({"a": 4, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 4), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 4})
+
+    def test_insufficient_funds_leaves_balances_unchanged(self):
+        ledger = Ledger({"a": 4, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), False)
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 0})
+
+    def test_destination_overflow_returns_false_and_changes_nothing(self):
+        ledger = Ledger({"a": 10, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 10, "b": MAX_BALANCE})
+
+    def test_destination_reaching_max_exactly_succeeds(self):
+        ledger = Ledger({"a": 3, "b": MAX_BALANCE - 3})
+        self.assertIs(ledger.transfer("a", "b", 3), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+    def test_total_preserved_across_transfers(self):
+        ledger = Ledger({"a": 100, "b": 50, "c": 0})
+        ledger.transfer("a", "b", 30)
+        ledger.transfer("b", "c", 70)
+        ledger.transfer("c", "a", 10)
+        self.assertEqual(sum(ledger.snapshot().values()), 150)
+
+    def test_self_transfer_with_sufficient_funds_returns_true_unchanged(self):
+        ledger = Ledger({"a": 5})
+        self.assertIs(ledger.transfer("a", "a", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_self_transfer_with_insufficient_funds_returns_false(self):
+        ledger = Ledger({"a": 5})
+        self.assertIs(ledger.transfer("a", "a", 6), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_self_transfer_at_max_balance_never_changes_it(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+
