+    def test_fractional_refill_failure_is_atomic_and_wait_is_non_consuming(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 0.25
+        self.assertFalse(bucket.try_acquire(1))
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(1), 0.25)
+        self.assertEqual(bucket.available(), 0.5)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_backwards_clock_freezes_until_past_high_water(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 3.0
+        self.assertEqual(bucket.available(), 2.0)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 3.5
+        self.assertEqual(bucket.available(), 0.5)
+
+    def test_invalid_bucket_values_and_requests(self):
+        for args in ((0, 1), (1, 0), (-1, 1), (1, -1)):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                TokenBucket(*args)
+        bucket = TokenBucket(2, 1)
+        for n in (0, -1, 3):
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.subTest(wait_n=n), self.assertRaises(ValueError):
+                bucket.wait_time(n)
+
+    def test_keyed_lru_wait_use_and_fresh_bucket_after_eviction(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1, max_keys=2, clock=clock)
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(limiter.wait_time("a"), 1.0)  # Makes a most recent.
+        self.assertTrue(limiter.try_acquire("c"))  # Evicts b.
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # Evicted key starts full.
+        self.assertFalse(limiter.try_acquire("b"))
+
+    def test_keyed_validation_and_unhashable_keys(self):
+        for kwargs in ({"max_keys": 0}, {"capacity": 0}, {"refill_per_sec": 0}):
+            values = {"capacity": 1, "refill_per_sec": 1}
+            values.update(kwargs)
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                KeyedLimiter(**values)
+        limiter = KeyedLimiter(1, 1)
+        with self.assertRaises(TypeError):
+            limiter.try_acquire([])
+
 
