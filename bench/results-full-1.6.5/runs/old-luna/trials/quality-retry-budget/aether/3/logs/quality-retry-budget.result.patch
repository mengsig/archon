diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..4930676 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,37 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    # Avoid constructing 2**(attempt - 1) for arbitrarily large attempts.
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    elif base_ms >= cap_ms:
+        backoff = cap_ms
+    else:
+        exponent = attempt - 1
+        if exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..f93d313 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,45 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validation_rejects_bool_float_and_negative_values(self):
+        invalid_calls = (
+            lambda: retry_delay(True, 0),
+            lambda: retry_delay(1, 0.0),
+            lambda: retry_delay(1, 0, max_attempts=False),
+            lambda: retry_delay(1, 0, budget_ms=-1),
+            lambda: retry_delay(1, 0, base_ms=-1),
+            lambda: retry_delay(1, 0, cap_ms=-1),
+            lambda: retry_delay(1, 0, retry_after_ms=True),
+            lambda: retry_delay(1, 0, retry_after_ms=-1),
+        )
+        for call in invalid_calls:
+            with self.subTest(call=call), self.assertRaises(ValueError):
+                call()
+
+    def test_validation_precedes_exhausted_attempt_return(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, retry_after_ms=1.5)
+        with self.assertRaises(ValueError):
+            retry_delay(4, -1)
+
+    def test_budget_boundary_is_strict_and_zero_wait_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 9, budget_ms=10, base_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 10, budget_ms=10, base_ms=0))
+
+    def test_retry_after_floor_is_not_capped_or_shortened(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=10, retry_after_ms=500), 500)
+        self.assertIsNone(retry_delay(1, 500, budget_ms=1000,
+                                      retry_after_ms=500))
+
+    def test_zero_cap_and_huge_attempt(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=10, cap_ms=0), 0)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1,
+                                     base_ms=1, cap_ms=400), 400)
+
+    def test_attempt_greater_than_limit_is_legal(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
