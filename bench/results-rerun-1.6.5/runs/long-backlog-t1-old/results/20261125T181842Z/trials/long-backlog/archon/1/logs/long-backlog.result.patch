@@ -0,0 +1,95 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_exact_task(self):
+        store = TaskStore()
+        a = store.add("first")
+        b = store.add("second", tags=["work"], due=None)
+        store.complete(b.id)
+        before = store.get(b.id)
+        snapshot = (before.id, before.title, list(before.tags), before.status, before.due)
+        store.delete(b.id)
+        store.undo()
+        restored = store.get(b.id)
+        self.assertIs(restored, before)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status, restored.due), snapshot)
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        store.complete(a.id)
+        b = store.add("b")
+        store.delete(a.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [])
+
+    def test_undo_with_nothing_left_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        store.add("only")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_not_reused_after_undo_add(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertEqual(second.id, first.id + 1)
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("kept")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.delete(42)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
