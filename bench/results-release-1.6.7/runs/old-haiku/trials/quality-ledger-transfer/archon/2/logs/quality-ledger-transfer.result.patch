+class LedgerConcurrency(unittest.TestCase):
+    def _run_all(self, targets):
+        errors = []
+
+        def guarded(target):
+            try:
+                target()
+            except Exception as error:
+                errors.append(error)
+
+        threads = [threading.Thread(target=guarded, args=(target,)) for target in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(THREAD_JOIN_SECONDS)
+        self.assertFalse(any(thread.is_alive() for thread in threads))
+        self.assertEqual(errors, [])
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        iterations = 500
+
+        def a_to_b():
+            for _ in range(iterations):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(iterations):
+                ledger.transfer("b", "a", 1)
+
+        self._run_all([a_to_b, b_to_a])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 0, "c": 0})
+        seen_totals = set()
+
+        def mover():
+            for _ in range(300):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "c", 1)
+
+        def reader():
+            for _ in range(300):
+                seen_totals.add(sum(ledger.snapshot().values()))
+
+        self._run_all([mover, reader])
+        self.assertEqual(seen_totals, {1000})
+        self.assertEqual(sum(ledger.snapshot().values()), 1000)
+
+
+if __name__ == "__main__":
+    unittest.main()
