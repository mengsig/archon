 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _check_bucket_params(capacity, refill_per_sec):
+    if not math.isfinite(capacity):
+        raise ValueError(f"capacity must be finite, got {capacity!r}")
+    if not math.isfinite(refill_per_sec):
+        raise ValueError(f"refill_per_sec must be finite, got {refill_per_sec!r}")
+    if capacity <= 0:
+        raise ValueError(f"capacity must be > 0, got {capacity!r}")
+    if refill_per_sec <= 0:
+        raise ValueError(f"refill_per_sec must be > 0, got {refill_per_sec!r}")
+
+
+def _check_tokens(n, capacity):
+    if not math.isfinite(n):
+        raise ValueError(f"n must be finite, got {n!r}")
+    if n <= 0 or n > capacity:
+        raise ValueError(f"n must be in (0, {capacity}], got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_tokens(n, self.capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_tokens(n, self.capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
+
+    def _refill(self):
+        # A clock that goes backwards adds nothing and leaves _last unchanged.
+        now = self._clock()
+        if now <= self._last:
+            return
+        elapsed = now - self._last
+        self._tokens = min(self.capacity, self._tokens + elapsed * self.refill_per_sec)
+        self._last = now
+        assert 0 <= self._tokens <= self.capacity
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        if max_keys < 1:
+            raise ValueError(f"max_keys must be >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_tokens(n, self._capacity)
+        return self._bucket(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_tokens(n, self._capacity)
+        return self._bucket(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
+
+    def _bucket(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys
+        return bucket
