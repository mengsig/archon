+    def test_default_page_has_twenty_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_following_cursors_returns_every_item_once_in_order(self):
+        ids, cursor = [], None
+        while True:
+            query = {} if cursor is None else {"cursor": cursor}
+            body = get("/items", limit="10", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_ending_exactly_at_last_item_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_need_not_name_an_existing_item(self):
+        body = get("/items", limit="2", cursor="10")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], [11, 12])
+        self.assertEqual(body["next_cursor"], "12")
+
+    def test_cursor_past_the_end_gives_empty_last_page(self):
+        for cursor in ["57", "999"]:
+            body = get("/items", cursor=cursor)["body"]
+            self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_invalid_limit_is_rejected(self):
