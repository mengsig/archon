+function paged(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    const page = pages[request.query.cursor ?? 'first'];
+    if (!page) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages, in order', async () => {
+  const { transport, seen } = paged({
+    first: { items: [ITEMS[0]], next_cursor: 'c2' },
+    c2: { items: [ITEMS[1]], next_cursor: 'c3' },
+    c3: { items: [{ id: 3, sku: 'SKU-0003', qty: 1 }], next_cursor: null },
+  });
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seen, [{}, { cursor: 'c2' }, { cursor: 'c3' }]);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const { transport, seen } = paged({ first: { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('returns an empty list when the first page is empty', async () => {
+  const { transport } = paged({ first: { items: [], next_cursor: null } });
+  assert.deepEqual(await listItems(transport), []);
+});
+
+test('rejects when a later page fails', async () => {
+  const { transport } = paged({ first: { items: ITEMS, next_cursor: 'lost' } });
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('rejects a next_cursor that repeats instead of looping forever', async () => {
+  const { transport } = paged({ first: { items: ITEMS, next_cursor: 'same' }, same: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /same cursor twice/);
+});
+
