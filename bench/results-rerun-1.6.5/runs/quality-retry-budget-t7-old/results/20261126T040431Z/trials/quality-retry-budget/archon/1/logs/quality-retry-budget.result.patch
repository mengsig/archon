diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..8763d9b 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,48 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms):
+    _require_int("attempt", attempt, 1)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without huge powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # With base_ms >= 1, base_ms << shift >= 2**shift > cap_ms once shift
+    # reaches cap_ms.bit_length(), so the cap applies and no shift is needed.
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the wait in ms before the next attempt, or None to stop."""
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    assert delay >= 0, "delay must never be negative"
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..633f7ca 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,147 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_non_int_types(self):
+        bad_values = [1.0, True, False, "1", None, 2.5]
+        for bad in bad_values:
+            with self.subTest(value=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(bad, 0)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, budget_ms=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, base_ms=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, cap_ms=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, max_attempts=bad)
+
+    def test_retry_after_must_be_int_or_none(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, retry_after_ms=None))
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.5)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=True)
+
+    def test_attempt_and_max_attempts_at_least_one(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_nonnegative_fields_reject_negatives(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validation_runs_before_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=4, retry_after_ms=-3)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=10, base_ms=-1)
+
+    def test_zero_boundaries_are_valid(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(2, 0, max_attempts=2))
+
+    def test_attempt_below_max_allows_retry(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_above_max_returns_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+
+class Backoff(unittest.TestCase):
+    def test_doubles_each_attempt_until_cap(self):
+        delays = [retry_delay(n, 0, budget_ms=10**9, max_attempts=10**9)
+                  for n in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_base_above_cap_yields_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=500, cap_ms=300), 300)
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0, cap_ms=400), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=100, cap_ms=0), 0)
+
+    def test_huge_attempt_saturates_without_large_power(self):
+        delay = retry_delay(10**100, 0, max_attempts=10**101, base_ms=1,
+                            cap_ms=400)
+        self.assertEqual(delay, 400)
+
+    def test_cap_boundary_exact(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=100, cap_ms=400), 400)
+        self.assertEqual(retry_delay(3, 0, base_ms=100, cap_ms=401), 400)
+
+    def test_large_values_are_accepted(self):
+        big = 10**30
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=big, cap_ms=big + 7,
+                        budget_ms=big * 2), big)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=5000, budget_ms=10**6), 5000)
+
+    def test_backoff_used_when_larger_than_retry_after(self):
+        self.assertEqual(retry_delay(3, 0, retry_after_ms=50), 400)
+
+    def test_retry_after_equal_to_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=100), 100)
+
+    def test_retry_after_pushing_past_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+
+class Budget(unittest.TestCase):
+    def test_delay_ending_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_one_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_elapsed_already_past_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 1500, budget_ms=1000))
+
+    def test_zero_delay_allowed_when_elapsed_below_budget(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_refused_when_elapsed_reaches_budget(self):
+        self.assertIsNone(retry_delay(1, 1, base_ms=0, budget_ms=1))
+
+    def test_zero_budget_refuses_every_retry(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_budget_not_used_to_shorten_wait(self):
+        self.assertIsNone(retry_delay(2, 800, budget_ms=1000))
+
+
+if __name__ == "__main__":
+    unittest.main()
