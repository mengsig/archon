 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _is_valid_balance(value):
+    return type(value) is int and 0 <= value <= MAX_BALANCE
+
+
+def _is_valid_amount(value):
+    return type(value) is int and 1 <= value <= MAX_BALANCE
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+        # dict.items reads the real storage, so a subclass override cannot
+        # make validation see different entries than the ones copied.
+        entries = list(dict.items(balances))
+        for name, balance in entries:
+            if type(name) is not str or not name:
+                raise ValueError(f"invalid account name: {name!r}")
+            if not _is_valid_balance(balance):
+                raise ValueError(f"invalid balance for {name!r}: {balance!r}")
+        # One lock guards every read and write, so each call is atomic and
+        # opposite transfers can never wait on each other in a cycle.
+        self._lock = threading.Lock()
+        self._balances = dict(entries)
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        if not _is_valid_amount(amount):
+            raise ValueError(f"invalid amount: {amount!r}")
+        with self._lock:
+            self._require_account(source)
+            self._require_account(destination)
+            return self._transfer_locked(source, destination, amount)
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _require_account(self, name):
+        if not isinstance(name, str) or name not in self._balances:
+            raise KeyError(name)
+
+    def _transfer_locked(self, source, destination, amount):
+        if self._balances[source] < amount:
+            return False
+        if source == destination:
+            return True
+        if self._balances[destination] + amount > MAX_BALANCE:
+            return False
+        total_before = self._balances[source] + self._balances[destination]
+        self._balances[source] -= amount
+        self._balances[destination] += amount
+        assert self._balances[source] + self._balances[destination] == total_before
+        assert 0 <= self._balances[source] <= MAX_BALANCE
+        return True
