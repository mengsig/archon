 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +29,41 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after_id = _parse_cursor(query.get("cursor"))
+    except QueryError as exc:
+        return _error(400, str(exc))
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    has_more = len(remaining) > limit
+    next_cursor = str(page[-1]["id"]) if has_more else None
+    assert next_cursor is None or page
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_ascii_digits(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise QueryError(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None
+    if not _is_ascii_digits(raw):
+        raise QueryError("cursor is invalid")
+    return int(raw)
+
+
+def _is_ascii_digits(raw):
+    return raw.isascii() and raw.isdigit() and len(raw) <= MAX_DIGITS
 
 
