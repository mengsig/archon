@@ -24,6 +24,70 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_has_20_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsInstance(body["next_cursor"], str)
+
+    def test_walking_cursors_returns_every_item_in_order(self):
+        for limit in (1, 7, 19, 20, 57, 100):
+            with self.subTest(limit=limit):
+                ids = walk_all_ids(limit)
+                self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="19", cursor="Mzg=")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(39, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_exactly_filling_the_rest_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_the_end_is_an_empty_last_page(self):
+        body = get("/items", cursor="NTc=")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="0100")["body"]["items"]), 57)
+        self.assertEqual(len(get("/items", limit="0001")["body"]["items"]), 1)
+
+    def test_invalid_limit_is_400_with_error_body(self):
+        for limit in ("0", "000", "101", "999", "1000", "-1", "1.5", "abc", "", " 5", "+5", "١"):
+            with self.subTest(limit=limit):
+                res = get("/items", limit=limit)
+                self.assertEqual(res["status"], 400)
+                self.assertIsInstance(res["body"]["error"], str)
+
+    def test_non_string_query_values_are_400(self):
+        for query in ({"limit": 5}, {"cursor": None}, {"cursor": ["Mzg="]}):
+            with self.subTest(query=query):
+                res = handle({"method": "GET", "path": "/items", "query": query})
+                self.assertEqual(res["status"], 400)
+                self.assertIsInstance(res["body"]["error"], str)
+
+    def test_invalid_cursor_is_400_with_error_body(self):
+        for cursor in ("", "!!!", "abc", "not base64!", "eA==", "MTIz!", "MA==", "MDc=", "é", "Mzg=é"):
+            with self.subTest(cursor=cursor):
+                res = get("/items", cursor=cursor)
