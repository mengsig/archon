@@ -0,0 +1,103 @@
+"""Tests for the search query language."""
+import unittest
+
+from tasktracker.models import DONE, OPEN, Task
+from tasktracker.search import QueryError, search
+
+
+def _tasks():
+    return [
+        Task(1, "Fix login bug", ["work", "urgent"], OPEN),
+        Task(2, "write REPORT", ["Home"], DONE),
+        Task(3, "fix login page", [], DONE),
+        Task(4, "buy milk", ["home-errands"], OPEN),
+    ]
+
+
+def _ids(tasks):
+    return [task.id for task in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = _tasks()
+
+    def test_blank_query_matches_everything_in_input_order(self):
+        self.assertEqual(_ids(search(self.tasks, "")), [1, 2, 3, 4])
+        self.assertEqual(_ids(search(self.tasks, "   \t ")), [1, 2, 3, 4])
+
+    def test_empty_task_list_gives_no_results(self):
+        self.assertEqual(search([], "milk"), [])
+
+    def test_bare_word_matches_title_case_insensitively(self):
+        self.assertEqual(_ids(search(self.tasks, "report")), [2])
+        self.assertEqual(_ids(search(self.tasks, "LOGIN")), [1, 3])
+
+    def test_bare_word_does_not_match_tags(self):
+        self.assertEqual(search(self.tasks, "urgent"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_ids(search(self.tasks, '"fix login"')), [1, 3])
+        self.assertEqual(_ids(search(self.tasks, '"login bug"')), [1])
+        self.assertEqual(search(self.tasks, '"bug login"'), [])
+
+    def test_whitespace_inside_quotes_is_kept(self):
+        self.assertEqual(search(self.tasks, '"fix  login"'), [])
+
+    def test_terms_are_combined_with_and(self):
+        self.assertEqual(_ids(search(self.tasks, "fix login")), [1, 3])
+        self.assertEqual(_ids(search(self.tasks, "fix login bug")), [1])
+        self.assertEqual(search(self.tasks, "fix milk"), [])
+
+    def test_quoted_colon_text_is_a_phrase_not_a_field(self):
+        tasks = [Task(1, "re: fix:login", [])]
+        self.assertEqual(_ids(search(tasks, '"re: fix"')), [1])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(_ids(search(self.tasks, "tag:work")), [1])
+        self.assertEqual(_ids(search(self.tasks, "tag:HOME")), [2])
+        self.assertEqual(search(self.tasks, "tag:hom"), [])
+
+    def test_tag_does_not_match_title_text(self):
+        self.assertEqual(search(self.tasks, "tag:login"), [])
+
+    def test_status_matches_open_and_done(self):
+        self.assertEqual(_ids(search(self.tasks, "status:open")), [1, 4])
+        self.assertEqual(_ids(search(self.tasks, "status:done")), [2, 3])
+
+    def test_status_value_is_case_insensitive(self):
+        self.assertEqual(_ids(search(self.tasks, "status:DONE")), [2, 3])
+
+    def test_status_combines_with_other_terms(self):
+        self.assertEqual(_ids(search(self.tasks, "status:done login")), [3])
+        self.assertEqual(_ids(search(self.tasks, "tag:work status:done")), [])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+        with self.assertRaises(QueryError):
+            search(self.tasks, "login:bug")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:archived")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+        with self.assertRaises(QueryError):
+            search(self.tasks, 'fix "login')
+
+    def test_query_error_is_raised_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:archived")
+
+
+if __name__ == "__main__":
+    unittest.main()
