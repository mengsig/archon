+test('follows cursors across pages and preserves item order', async () => {
+  const calls = [];
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'cursor/with?opaque=1' },
+    { items: [ITEMS[1]], next_cursor: null },
+  ];
+  const transport = async (request) => {
+    calls.push(request);
+    return { status: 200, body: pages.shift() };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(calls.map((call) => call.query), [
+    {},
+    { cursor: 'cursor/with?opaque=1' },
+  ]);
+});
+
+test('stops when next_cursor is absent', async () => {
+  let calls = 0;
+  const transport = async () => {
+    calls += 1;
+    return { status: 200, body: { items: ITEMS } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(calls, 1);
+});
+
