 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = "\\:\x00"
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _validate_root(root)
+    names = _validate_batch(entries)
+    for name in names:
+        _check_target(root_path, name)
+    return _write_entries(root_path, entries)
+
+
+def _validate_root(root):
+    try:
+        raw = os.fspath(root)
+        root_path = Path(raw)
+    except TypeError as exc:
+        raise ValueError(f"root must be a path or string, not {type(root).__name__}") from exc
+    if raw == "":
+        raise ValueError("root must not be an empty string")
+    if root_path.is_symlink():
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not root_path.is_dir():
+        raise ValueError(f"root must be an existing directory: {root_path}")
+    return root_path
+
+
+def _validate_batch(entries):
+    names = [_validate_entry(entry) for entry in entries]
+    _check_names_disjoint(names)
+    return names
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, not {type(entry).__name__}")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be a string, not {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes, not {type(data).__name__}")
+    _check_name(name)
+    return name
+
+
+def _check_name(name):
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name has an invalid component: {name!r}")
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not encodable for the filesystem: {name!r}") from exc
+
+
+def _check_names_disjoint(names):
+    seen = set()
+    for name in names:
+        if name in seen:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        seen.add(name)
+    directories = set()
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            directories.add("/".join(parts[:depth]))
+    clashes = directories & seen
+    if clashes:
+        raise ValueError(f"entry is both a file and a directory: {min(clashes)!r}")
+
+
+def _check_target(root, name):
+    parts = name.split("/")
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        if not _exists_no_follow(current):
+            return
+        _check_existing_directory(current)
+    target = current / parts[-1]
+    if _exists_no_follow(target):
+        raise ValueError(f"target already exists: {target}")
+
+
+def _check_existing_directory(path):
+    if path.is_symlink():
+        raise ValueError(f"symlink below root is not allowed: {path}")
+    if not path.is_dir():
+        raise ValueError(f"path component is not a directory: {path}")
+
+
+def _exists_no_follow(path):
+    try:
+        os.lstat(path)
+    except FileNotFoundError:
+        return False
+    return True
+
+
+def _write_entries(root, entries):
+    written = []
+    for name, data in entries:
+        target = root.joinpath(*name.split("/"))
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with open(target, "xb") as handle:
+            handle.write(data)
+        written.append(name)
+    return written
