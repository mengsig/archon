 from data import ITEMS
 
 
@@ -22,7 +26,38 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", 20)
+    if isinstance(raw_limit, bool) or not re.fullmatch(r"[0-9]+", str(raw_limit)):
+        return _error(400, "limit must be an integer from 1 to 100")
+    limit = int(raw_limit)
+    if not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    after_id = None
+    if cursor is not None:
+        if not isinstance(cursor, str):
+            return _error(400, "invalid cursor")
+        try:
+            decoded = base64.b64decode(cursor, altchars=b"-_", validate=True).decode("ascii")
+        except (binascii.Error, UnicodeDecodeError, ValueError):
+            return _error(400, "invalid cursor")
+        match = re.fullmatch(r"item:([1-9][0-9]*)", decoded)
+        if not match:
+            return _error(400, "invalid cursor")
+        after_id = int(match.group(1))
+        if after_id not in {item["id"] for item in items}:
+            return _error(400, "invalid cursor")
+
+    start = 0
+    if after_id is not None:
+        start = next(i + 1 for i, item in enumerate(items) if item["id"] == after_id)
+    page = items[start:start + limit]
+    next_cursor = None
+    if start + len(page) < len(items):
+        token = f"item:{page[-1]['id']}".encode("ascii")
+        next_cursor = base64.urlsafe_b64encode(token).decode("ascii")
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
