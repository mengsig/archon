 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+
+def _valid_name(name):
+    if not isinstance(name, str) or not name or name.startswith("/"):
+        return False
+    if "\\" in name or ":" in name or "\x00" in name:
+        return False
+    return all(part not in ("", ".", "..") for part in name.split("/"))
+
+
+def _validate_root(root):
+    try:
+        path = Path(root)
+    except (TypeError, ValueError, OSError):
+        raise ValueError("root must name an existing directory") from None
+    # Reject the root itself as a symlink, even when it resolves to a directory.
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        raise ValueError("root must be an existing real directory") from None
+    if not stat.S_ISDIR(mode):
+        raise ValueError("root must be an existing real directory")
+    return path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Validate a whole batch, then write its files beneath *root*."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+    root = _validate_root(root)
+
+    names = []
+    seen = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        if not _valid_name(name) or not isinstance(data, bytes):
+            raise ValueError("invalid entry")
+        if name in seen:
+            raise ValueError("duplicate name")
+        # Check all ancestors as well as descendants already seen, so order
+        # does not affect file/directory collision detection.
+        pieces = name.split("/")
+        if any("/".join(pieces[:i]) in seen for i in range(1, len(pieces))):
+            raise ValueError("file/directory collision")
+        if any(other.startswith(name + "/") for other in seen):
+            raise ValueError("file/directory collision")
+        seen.add(name)
+        names.append((name, data))
+
+    # Inspect the complete filesystem plan before making any changes.
+    for name, _ in names:
+        current = root
+        parts = name.split("/")
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = current.lstat().st_mode
+            except FileNotFoundError:
+                continue
+            if stat.S_ISLNK(mode):
+                raise ValueError("symlink in destination path")
+            if index == len(parts) - 1:
+                raise ValueError("target already exists")
+            if not stat.S_ISDIR(mode):
+                raise ValueError("ancestor is not a directory")
+
+    for name, data in names:
+        target = root.joinpath(*name.split("/"))
+        target.parent.mkdir(parents=True, exist_ok=True)
+        # Exclusive creation protects the no-overwrite contract against an
+        # unexpected race; any resulting I/O error remains visible.
+        with target.open("xb") as stream:
+            stream.write(data)
+    return [name for name, _ in names]
