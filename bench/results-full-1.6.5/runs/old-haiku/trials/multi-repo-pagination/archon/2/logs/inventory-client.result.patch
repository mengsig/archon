+// Serves `pages` keyed by cursor; the first request has no cursor (key `first`).
+function pagedTransport(pages, requests = []) {
+  return async (request) => {
+    requests.push(request);
+    const key = 'cursor' in request.query ? request.query.cursor : 'first';
+    if (!(key in pages)) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: pages[key] };
+  };
+}
+
 test('lists items', async () => {
