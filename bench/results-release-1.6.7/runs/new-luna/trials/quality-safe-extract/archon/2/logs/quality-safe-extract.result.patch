 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a string or pathlib.Path")
+
+    path = Path(root)
+    try:
+        root_mode = path.lstat().st_mode
+    except (FileNotFoundError, NotADirectoryError) as error:
+        raise ValueError("root must be an existing directory") from error
+
+    if not stat.S_ISDIR(root_mode):
+        raise ValueError("root must be an existing real directory")
+    return path
+
+
+def _validate_entries(entries):
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    validated = []
+    seen = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a two-part tuple")
+        name, data = entry
+        if not isinstance(name, str) or not isinstance(data, bytes):
+            raise ValueError("entry names must be strings and data must be bytes")
+        if (
+            not name
+            or name.startswith("/")
+            or "\\" in name
+            or ":" in name
+            or "\x00" in name
+        ):
+            raise ValueError("entry name must be a relative POSIX path")
+
+        parts = name.split("/")
+        if any(part in ("", ".", "..") for part in parts):
+            raise ValueError("entry name contains an invalid path component")
+        if name in seen:
+            raise ValueError("duplicate entry path")
+        if any("/".join(parts[:index]) in seen for index in range(1, len(parts))):
+            raise ValueError("entry path conflicts with a file")
+        if any(existing.startswith(name + "/") for existing in seen):
+            raise ValueError("entry path conflicts with a directory")
+        seen.add(name)
+        validated.append((name, data))
+    return validated
+
+
+def _validate_targets(root, names):
+    for name in names:
+        current = root
+        parts = name.split("/")
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = current.lstat().st_mode
+            except FileNotFoundError:
+                # Once a component is absent, all remaining components are absent
+                # on the caller-guaranteed stable filesystem.
+                break
+
+            if stat.S_ISLNK(mode):
+                raise ValueError("entry path contains a symlink")
+            if index < len(parts) - 1:
+                if not stat.S_ISDIR(mode):
+                    raise ValueError("entry path has a non-directory ancestor")
+            else:
+                raise ValueError("entry target already exists")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Create the listed files beneath an existing directory."""
+    # Validate both arguments and every target before the first filesystem write.
+    validated = _validate_entries(entries)
+    root_path = _validate_root(root)
+    _validate_targets(root_path, [name for name, _ in validated])
+
+    for name, data in validated:
+        target = root_path.joinpath(*name.split("/"))
+        target.parent.mkdir(parents=True, exist_ok=True)
+        # Exclusive creation ensures an existing target is never overwritten.
+        with target.open("xb") as output:
+            output.write(data)
+    return [name for name, _ in validated]
