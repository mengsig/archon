+class KeyedLimiterValidationTest(unittest.TestCase):
+    def test_rejects_invalid_capacity_or_refill(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, -1.0, clock=FakeClock())
+
+    def test_rejects_max_keys_below_one(self):
+        for max_keys in [0, -3]:
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_rejects_non_integer_max_keys(self):
+        with self.assertRaises(TypeError):
+            KeyedLimiter(1, 1.0, max_keys=2.5, clock=FakeClock())
+
+    def test_invalid_request_leaves_key_set_unchanged(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=0)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
+class KeyedLimiterEdgeCaseTest(unittest.TestCase):
+    def test_wait_time_is_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        self.assertEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=10, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        self.assertEqual(len(limiter), 2)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("c"))
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_wait_time_counts_as_a_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertEqual(limiter.wait_time("a"), 1.0)
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        self.assertTrue(limiter.try_acquire("a", 2))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_size_never_exceeds_max_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=3, clock=FakeClock())
+        for key in range(10):
+            limiter.try_acquire(key)
+            self.assertLessEqual(len(limiter), 3)
+        self.assertEqual(len(limiter), 3)
+
+
 if __name__ == "__main__":
