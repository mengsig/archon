@@ -22,7 +26,59 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query)
+    if limit is None:
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    after_id = None
+    if "cursor" in query:
+        after_id = _parse_cursor(cursor, items)
+        if after_id is None:
+            return _error(400, "invalid cursor")
+
+    start = 0
+    if after_id is not None:
+        start = next(index + 1 for index, item in enumerate(items) if item["id"] == after_id)
+    page = items[start : start + limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if start + limit < len(items) else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(query):
+    if "limit" not in query:
+        return 20
+    value = query["limit"]
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        limit = value
+    elif isinstance(value, str) and re.fullmatch(r"[0-9]+", value):
+        limit = int(value)
+    else:
+        return None
+    return limit if 1 <= limit <= 100 else None
+
+
+def _encode_cursor(item_id):
+    raw = f"v1:{item_id}".encode("ascii")
+    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")
+
+
+def _parse_cursor(cursor, items):
+    if not isinstance(cursor, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", cursor):
+        return None
+    try:
+        raw = base64.b64decode(cursor + "=" * (-len(cursor) % 4), altchars=b"-_", validate=True)
+        version, raw_id = raw.decode("ascii").split(":", 1)
+        item_id = int(raw_id)
+    except (ValueError, UnicodeDecodeError, binascii.Error):
+        return None
+    if version != "v1" or _encode_cursor(item_id) != cursor:
+        return None
+    if item_id not in {item["id"] for item in items[:-1]}:
+        return None
+    return item_id
 
 
