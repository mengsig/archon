+class LedgerValidation(unittest.TestCase):
+    def test_constructor_accepts_empty_and_copies_input(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+        balances = {"a": 4}
+        ledger = Ledger(balances)
+        balances["a"] = 9
+        balances["b"] = 2
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_constructor_rejects_invalid_inputs(self):
+        invalid = (
+            [],
+            None,
+            {"": 0},
+            {1: 0},
+            {"a": True},
+            {"a": IntSubclass(1)},
+            {"a": -1},
+            {"a": MAX_BALANCE + 1},
+        )
+        for balances in invalid:
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+    def test_amount_must_be_builtin_integer_in_range(self):
+        ledger = Ledger({"a": 3, "b": 0})
+        for amount in (True, False, IntSubclass(1), 0, -1, MAX_BALANCE + 1, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("a", "b", amount)
+        self.assertEqual(ledger.snapshot(), {"a": 3, "b": 0})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({})
+        with self.assertRaises(ValueError):
+            ledger.transfer("missing", "also missing", 0)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "also missing", 1)
+
+    def test_unknown_source_and_destination_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
