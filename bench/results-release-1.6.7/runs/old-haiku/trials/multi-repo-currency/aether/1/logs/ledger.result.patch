+/// Accepts an ISO 4217 code such as `EUR`, surrounding whitespace is ignored.
+fn parse_currency(field: &str) -> Result<String, ParseError> {
+    let code = field.trim();
+    let valid = code.len() == 3 && code.bytes().all(|c| c.is_ascii_uppercase());
+    if !valid {
+        return Err(ParseError::BadCurrency(format!("bad currency {code:?}")));
+    }
+    Ok(code.to_string())
+}
