+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_missing_root_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], self.base / "missing")
+        self.assertEqual(tree(self.base), ["root"])
+
+    def test_missing_root_rejected_even_for_empty_batch(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+    def test_file_root_is_rejected(self):
+        (self.base / "file").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], self.base / "file")
+
+    def test_invalid_root_types_are_rejected(self):
+        for root in [None, 5, b"bytes", "", ["list"]]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([("a", b"x")], root)
+
+    def test_symlink_root_is_rejected_without_following(self):
