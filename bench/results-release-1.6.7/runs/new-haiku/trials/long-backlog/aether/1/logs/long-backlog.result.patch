@@ -1,2 +1,77 @@
+from typing import NamedTuple, Optional
+
+from .models import DONE, OPEN
+
+FIELDS = ("tag", "status")
+
+
+class QueryError(ValueError):
+    pass
+
+
+class Term(NamedTuple):
+    field: Optional[str]  # None for a bare word or phrase
+    value: str  # casefolded
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order.
+
+    Terms are whitespace-separated; double quotes group a phrase. Supported
+    terms: `word`, `"a phrase"`, `tag:NAME`, `status:open` and `status:done`.
+    """
+    assert isinstance(query, str), "query must be a string"
+    terms = [_make_term(field, text) for field, text in _split(query)]
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
+
+
+def _split(query):
+    """(field, text) pairs for each term; field is None for bare terms."""
+    pairs = []
+    field = None
+    chars = []
+    started = False
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            started = True
+        elif in_quotes:
+            chars.append(char)
+        elif char.isspace():
+            if started:
+                pairs.append((field, "".join(chars)))
+            field, chars, started = None, [], False
+        elif char == ":" and field is None:
+            field, chars, started = "".join(chars), [], True
+        else:
+            chars.append(char)
+            started = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query {query!r}")
+    if started:
+        pairs.append((field, "".join(chars)))
+    return pairs
+
+
+def _make_term(field, text):
+    if field is None:
+        return Term(None, text.casefold())
+    name = field.casefold()
+    value = text.casefold()
+    if name not in FIELDS:
+        raise QueryError(f"unknown field {field!r} in query")
+    if not value:
+        raise QueryError(f"field {name!r} needs a value")
+    if name == "status" and value not in (OPEN, DONE):
+        raise QueryError(f"unknown status {text!r} in query")
+    return Term(name, value)
+
+
+def _matches(task, term):
+    if term.field is None:
+        return term.value in task.title.casefold()
+    if term.field == "tag":
+        return any(tag.casefold() == term.value for tag in task.tags)
+    assert term.field == "status", f"unexpected field {term.field!r}"
+    return task.status == term.value
