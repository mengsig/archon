+class ExtractSuccess(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_string_root_is_accepted(self):
+        self.assertEqual(extract([("a.txt", b"x")], str(self.root)), ["a.txt"])
+        self.assertEqual((self.root / "a.txt").read_bytes(), b"x")
+
+    def test_returns_names_in_input_order(self):
+        entries = [("z", b"1"), ("a/b", b"2"), ("m/n/o", b"3")]
+        self.assertEqual(extract(entries, self.root), ["z", "a/b", "m/n/o"])
+
+    def test_exact_bytes_are_written(self):
+        data = bytes(range(256))
+        extract([("blob", data)], self.root)
+        self.assertEqual((self.root / "blob").read_bytes(), data)
+
+    def test_empty_file_is_created(self):
+        extract([("deep/empty", b"")], self.root)
+        self.assertEqual((self.root / "deep" / "empty").stat().st_size, 0)
+
+    def test_percent_signs_are_literal(self):
+        names = ["100%.txt", "%2e%2e", "%2F"]
+        self.assertEqual(extract([(n, b"p") for n in names], self.root), names)
+        self.assertEqual(tree(self.root), sorted(names))
+
+    def test_missing_parents_are_created(self):
+        extract([("x/y/z/file", b"q")], self.root)
+        self.assertTrue(stat.S_ISDIR((self.root / "x/y/z").lstat().st_mode))
+
+    def test_existing_parent_directory_is_reused(self):
+        (self.root / "dir").mkdir()
+        (self.root / "dir" / "old").write_bytes(b"keep")
+        self.assertEqual(extract([("dir/new", b"z")], self.root), ["dir/new"])
+        self.assertEqual((self.root / "dir" / "new").read_bytes(), b"z")
+        self.assertEqual((self.root / "dir" / "old").read_bytes(), b"keep")
+
+    def test_names_are_not_normalized(self):
+        names = [" lead", "trail\n", "é/ü"]
+        extract([(n, b"v") for n in names], self.root)
+        self.assertEqual(
+            tree(self.root), sorted([" lead", "trail\n", "é", "é/ü"])
+        )
+        self.assertEqual((self.root / "é" / "ü").read_bytes(), b"v")
+
+    def test_empty_batch_with_string_root(self):
+        self.assertEqual(extract([], str(self.root)), [])
+        self.assertEqual(tree(self.root), [])
+
