+function fakePaged(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    if (request.path !== '/items') return { status: 404, body: { error: 'not found' } };
+    const index = request.query.cursor === undefined ? 0 : Number(request.query.cursor);
+    return { status: 200, body: pages[index] };
+  };
+  return { transport, seen };
+}
+
+test('lists a single page without a cursor', async () => {
+  const { transport, seen } = fakePaged([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+  assert.deepEqual(seen[0].query, {});
+});
+
+test('follows next_cursor across pages in order', async () => {
+  const { transport, seen } = fakePaged([
+    { items: [ITEMS[0]], next_cursor: '1' },
+    { items: [ITEMS[1]], next_cursor: null },
+  ]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen.map((request) => request.query), [{}, { cursor: '1' }]);
+});
+
+test('stops when next_cursor is missing', async () => {
+  const { transport, seen } = fakePaged([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('passes an opaque cursor back unchanged', async () => {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    if (request.query.cursor === undefined) {
+      return { status: 200, body: { items: [ITEMS[0]], next_cursor: 'a+/=b' } };
+    }
+    return { status: 200, body: { items: [ITEMS[1]], next_cursor: null } };
+  };
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen[1].query.cursor, 'a+/=b');
+});
+
