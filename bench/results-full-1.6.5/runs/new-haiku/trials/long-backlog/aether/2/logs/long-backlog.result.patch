--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,67 @@
+"""Search query language: bare words, quoted phrases, `tag:` and `status:`.
+
+Quotes only group words; they are removed from the term they appear in.
+"""
+import re
+
+from .models import DONE, OPEN
+
+FIELD_NAME = re.compile(r"[A-Za-z_]+")
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    """A search query that cannot be parsed or uses an unknown field."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in their input order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_matcher(token) for token in _tokenize(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _tokenize(query):
+    tokens = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            current.append(char)
+        elif char.isspace() and not in_quotes:
+            if current:
+                tokens.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if current:
+        tokens.append("".join(current))
+    return tokens
+
+
+def _matcher(token):
+    name, separator, value = token.partition(":")
+    if separator and FIELD_NAME.fullmatch(name):
+        return _field_matcher(name.lower(), value.replace('"', ""))
+    phrase = token.replace('"', "").lower()
+    return lambda task: phrase in task.title.lower()
+
+
+def _field_matcher(name, value):
+    if not value:
+        raise QueryError(f"missing value for {name}:")
+    if name == "tag":
+        wanted = value.lower()
+        return lambda task: any(tag.lower() == wanted for tag in task.tags)
+    if name == "status":
+        return _status_matcher(value.lower())
+    raise QueryError(f"unknown field: {name}")
+
+
+def _status_matcher(status):
+    if status not in STATUSES:
+        raise QueryError(f"unknown status: {status}")
+    return lambda task: task.status == status
