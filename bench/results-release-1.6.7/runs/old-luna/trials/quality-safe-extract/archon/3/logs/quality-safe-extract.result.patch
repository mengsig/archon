 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a string or pathlib.Path")
+    try:
+        path = Path(root)
+        info = path.lstat()
+    except (TypeError, ValueError, OSError) as error:
+        # A missing or malformed root is an input conflict. Other filesystem
+        # errors such as permission failures remain visible to the caller.
+        if isinstance(error, OSError) and not isinstance(
+            error, (FileNotFoundError, NotADirectoryError)
+        ):
+            raise
+        raise ValueError("root must be an existing directory") from error
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
+        raise ValueError("root must be a real directory")
+    return path
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError("entry name must be a string")
+    if (not name or name.startswith("/") or "\\" in name or ":" in name
+            or "\0" in name):
+        raise ValueError("entry name must be a nonempty relative POSIX path")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError("entry name contains an invalid path component")
+    return parts
+
+
+def _validate_target(root, parts):
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        try:
+            info = current.lstat()
+        except FileNotFoundError:
+            # With the caller's stable-filesystem guarantee, no deeper path
+            # below a missing component can exist.
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError("entry path contains a symlink")
+        if index == len(parts) - 1:
+            raise ValueError("entry target already exists")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError("entry parent is not a directory")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write ``(name, bytes)`` entries beneath an existing directory.
+
+    The complete input batch and all destination paths are checked before any
+    directory or file is created.
+    """
+    root_path = _validate_root(root)
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    validated = []
+    names = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        parts = _validate_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in names:
+            raise ValueError("duplicate entry name")
+        names.add(name)
+        validated.append((name, data, parts))
+
+    # Check parent/child collisions independent of entry order.
+    for name, _data, parts in validated:
+        for length in range(1, len(parts)):
+            if "/".join(parts[:length]) in names:
+                raise ValueError("file/directory collision in entries")
+
+    # Inspect every destination before the first write, so any validation
+    # failure leaves the tree unchanged.
+    for _name, _data, parts in validated:
+        _validate_target(root_path, parts)
+
+    for _name, data, parts in validated:
+        target = root_path.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with target.open("xb") as output:
+            output.write(data)
+    return [name for name, _data, _parts in validated]
diff --git a/test_safe_extract.py b/test_safe_extract.py
