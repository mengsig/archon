+class LedgerValidation(unittest.TestCase):
+    def test_construction_validation(self):
+        for invalid in (None, [], (), "accounts", 1):
+            with self.subTest(invalid=invalid), self.assertRaises(ValueError):
+                Ledger(invalid)
+        for name in ("", 1, None):
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                Ledger({name: 0})
+        for balance in (-1, MAX_BALANCE + 1, True, False, 1.0, "1", None):
+            with self.subTest(balance=balance), self.assertRaises(ValueError):
+                Ledger({"a": balance})
+
+    def test_construction_boundaries_and_copy(self):
+        balances = {"zero": 0, "max": MAX_BALANCE}
+        ledger = Ledger(balances)
+        balances["zero"] = MAX_BALANCE
+        balances["added"] = 1
+        self.assertEqual(ledger.snapshot(), {"zero": 0, "max": MAX_BALANCE})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, False, 1.0, "1", None):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer([], "a", 1)
+
+    def test_overflow_and_insufficient_funds_are_atomic(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), before)
+        self.assertIs(ledger.transfer("a", "b", 6), False)
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_same_account_transfer(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 2})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("b", "b", 3), False)
+        self.assertEqual(ledger.snapshot(), before)
+        with self.assertRaises(ValueError):
+            ledger.transfer("a", "a", 0)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "missing", 1)
+
+    def test_snapshot_is_defensive(self):
+        ledger = Ledger({"a": 4, "b": 6})
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 0
+        snapshot["new"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 6})
+
