 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +24,44 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, "limit must be an integer from 1 to 100")
+    after = None
+    if "cursor" in query:
+        after = _parse_cursor(query["cursor"])
+        if after is None:
+            return _error(400, "cursor is invalid")
+    return _items_page(after, limit)
+
+
+def _items_page(after, limit):
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    remaining = [item for item in ordered if after is None or item["id"] > after]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:]))
+    next_cursor = str(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_digits(raw):
+        return None
+    limit = int(raw)
+    return limit if 1 <= limit <= MAX_LIMIT else None
+
+
+def _parse_cursor(raw):
+    if not _is_digits(raw):
+        return None
+    return int(raw)
+
+
+def _is_digits(raw):
+    return raw.isascii() and raw.isdigit()
 
 
