@@ -0,0 +1,35 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+
+class CsvExportTest(unittest.TestCase):
+    def test_header_order_and_task_values_end_with_crlf(self):
+        tasks = [
+            Task(7, "plain", ["work", "urgent"], "done", date(2026, 4, 1)),
+            Task(3, "no due"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n"
+            "7,plain,work;urgent,done,2026-04-01\r\n"
+            "3,no due,,open,\r\n",
+        )
+
+    def test_quotes_only_fields_with_csv_special_characters(self):
+        tasks = [
+            Task(1, 'comma, quote " and\nnewline', ['plain', 'tag,with,comma'], "open"),
+            Task(2, "carriage\rreturn", ["quote\"tag"], "done"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n"
+            '1,"comma, quote "" and\nnewline","plain;tag,with,comma",open,\r\n'
+            '2,"carriage\rreturn","quote""tag",done,\r\n',
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
