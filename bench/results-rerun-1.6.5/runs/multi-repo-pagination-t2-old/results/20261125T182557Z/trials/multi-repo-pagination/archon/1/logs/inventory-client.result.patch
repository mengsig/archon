+    { items: [ITEMS[1]], next_cursor: 'c2' },
+    { items: [{ id: 3, sku: 'SKU-0003', qty: 7 }], next_cursor: null },
+  ]);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(calls.map((call) => call.query), [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('single page with null next_cursor makes one request', async () => {
+  const { transport, calls } = paginated([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(calls.length, 1);
