 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    try:
+        if isinstance(raw_limit, bool):
+            raise ValueError
+        limit = int(raw_limit)
+        if str(raw_limit) != str(limit) or not 1 <= limit <= 100:
+            raise ValueError
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    start_after = None
+    cursor = query.get("cursor")
+    if cursor is not None:
+        if not isinstance(cursor, str) or not cursor:
+            return _error(400, "invalid cursor")
+        try:
+            decoded = base64.b64decode(cursor + "=" * (-len(cursor) % 4), altchars=b"-_", validate=True)
+            last_id = int(decoded.decode("ascii"))
+            if str(last_id).encode("ascii") != decoded or not any(item["id"] == last_id for item in items):
+                raise ValueError
+            start_after = last_id
+        except (ValueError, UnicodeDecodeError, binascii.Error):
+            return _error(400, "invalid cursor")
+
+    remaining = [item for item in items if start_after is None or item["id"] > start_after]
+    page = remaining[:limit]
+    next_cursor = None
+    if len(remaining) > limit:
+        encoded = str(page[-1]["id"]).encode("ascii")
+        next_cursor = base64.urlsafe_b64encode(encoded).decode("ascii").rstrip("=")
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
