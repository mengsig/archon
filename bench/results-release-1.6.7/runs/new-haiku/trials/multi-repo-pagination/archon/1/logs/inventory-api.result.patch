diff --git a/test_api.py b/test_api.py
index 55cd1fd..a83b083 100644
--- a/test_api.py
+++ b/test_api.py
@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,57 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size_is_20(self):
+        res = get("/items")
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(1, 21)))
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_cursor_is_base64url_of_last_id(self):
+        res = get("/items")
+        expected = base64.urlsafe_b64encode(b"20").decode()
+        self.assertEqual(res["body"]["next_cursor"], expected)
+        self.assertEqual(expected, "MjA=")
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for raw in ["0", "101", "1000", "-1", "1.5", "abc", "", " 5", "+5"]:
+            res = get("/items", limit=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("error", res["body"], raw)
+
+    def test_walking_all_pages_with_cursors(self):
+        ids, cursor, pages = [], None, 0
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            page = [item["id"] for item in res["body"]["items"]]
+            self.assertLessEqual(len(page), 10)
+            ids.extend(page)
+            pages += 1
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+        self.assertEqual(pages, 6)
+
+    def test_last_page_has_null_cursor(self):
+        res = get("/items", limit="57")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+        res = get("/items", limit="20", cursor=get("/items", limit="40")["body"]["next_cursor"])
+        self.assertEqual(len(res["body"]["items"]), 17)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["", "!!!", "abc", "MTI", base64.urlsafe_b64encode(b"x1").decode()]:
+            res = get("/items", cursor=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("error", res["body"], raw)
+
 
 if __name__ == "__main__":
     unittest.main()
