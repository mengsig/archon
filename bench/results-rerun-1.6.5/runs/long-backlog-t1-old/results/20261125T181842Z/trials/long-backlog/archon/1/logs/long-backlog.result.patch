diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..e646cf5
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,48 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def test_impossible_calendar_dates_raise(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                with self.assertRaisesRegex(InvalidDate, text):
+                    parse_due(text, TODAY)
+
+    def test_leap_day_accepted_in_leap_year(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+
+    def test_malformed_input_raises_invalid_date(self):
+        for text in ["", "next week", "2026/03/12", "-3d", "3d", "+2w", "+d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_invalid_date_is_a_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+    def test_offsets(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+1d", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("+365d", TODAY), date(2027, 3, 10))
+
+    def test_offset_out_of_range_raises_invalid_date(self):
+        with self.assertRaisesRegex(InvalidDate, r"\+99999999999d"):
+            parse_due("+99999999999d", TODAY)
+
+    def test_keywords_case_and_whitespace(self):
+        self.assertEqual(parse_due("TODAY", TODAY), TODAY)
+        self.assertEqual(parse_due("  Tomorrow\t", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due(" 2026-03-12 ", TODAY), date(2026, 3, 12))
+
+    def test_message_keeps_original_text(self):
+        with self.assertRaisesRegex(InvalidDate, "  2026-02-30  "):
+            parse_due("  2026-02-30  ", TODAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..f7371d3
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,61 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+def _store_with(*titles):
+    store = TaskStore()
+    for title in titles:
+        store.add(title)
+    return store
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_every_line_ends_with_crlf(self):
+        store = _store_with("one", "two")
+        text = to_csv(store.all())
+        self.assertEqual(text, HEADER + "1,one,,open,\r\n2,two,,open,\r\n")
+
+    def test_rows_keep_input_order(self):
+        store = _store_with("first", "second", "third")
+        reversed_tasks = list(reversed(store.all()))
+        rows = to_csv(reversed_tasks).split("\r\n")
+        self.assertEqual(rows[1].split(",")[1], "third")
+
+    def test_tags_joined_with_semicolon_and_due_iso(self):
+        store = TaskStore()
+        store.add("pay rent", tags=["home", "money"], due=date(2026, 4, 1))
+        self.assertEqual(to_csv(store.all()), HEADER + "1,pay rent,home;money,open,2026-04-01\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        store = _store_with("milk, eggs")
+        self.assertEqual(to_csv(store.all()), HEADER + '1,"milk, eggs",,open,\r\n')
+
+    def test_title_with_quote_is_quoted_and_doubled(self):
+        store = _store_with('say "hi"')
+        self.assertEqual(to_csv(store.all()), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_title_with_newline_and_cr_is_quoted(self):
+        store = _store_with("line one\nline two", "a\rb")
+        text = to_csv(store.all())
+        self.assertEqual(text, HEADER + '1,"line one\nline two",,open,\r\n2,"a\rb",,open,\r\n')
+
+    def test_tag_with_comma_is_quoted(self):
+        store = TaskStore()
+        store.add("x", tags=["a,b", "c"])
+        self.assertEqual(to_csv(store.all()), HEADER + '1,x,"a,b;c",open,\r\n')
+
+    def test_plain_fields_are_not_quoted(self):
+        store = _store_with("plain title with spaces")
+        self.assertNotIn('"', to_csv(store.all()))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..5425788
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,89 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, parse_query, search
+from tasktracker.store import TaskStore
+
+
+def sample_store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("fix the login page", tags=["home"])
+    store.add("write report", tags=["work", "urgent"])
+    store.add("buy milk")
+    store.complete(2)
+    return store
+
+
+def titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        tasks = sample_store().all()
+        self.assertEqual(search(tasks, ""), tasks)
+        self.assertEqual(search(tasks, "   "), tasks)
+
+    def test_bare_word_is_case_insensitive_substring_of_title(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "LOGIN")),
+                         ["Fix login bug", "fix the login page"])
+
+    def test_quoted_phrase_is_one_term(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), '"fix login"')), ["Fix login bug"])
+
+    def test_terms_are_anded(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "fix login")),
+                         ["Fix login bug", "fix the login page"])
+        self.assertEqual(titles(search(store.all(), "fix report")), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "tag:WORK")),
+                         ["Fix login bug", "write report"])
+        self.assertEqual(titles(search(store.all(), "tag:wor")), [])
+
+    def test_status_filters(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "status:done")), ["fix the login page"])
+        self.assertEqual(len(search(store.all(), "status:open")), 3)
+
+    def test_combined_terms(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "tag:work status:open login")),
+                         ["Fix login bug"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_store().all(), "priority:high")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_store().all(), "status:pending")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_store().all(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_store().all(), '"fix login')
+
+    def test_errors_raised_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:bogus")
+
+    def test_quoted_field_look_alike_is_a_phrase(self):
+        tasks = [Task(1, "note tag:x here")]
+        self.assertEqual(search(tasks, '"tag:x"'), tasks)
+
+    def test_parse_query_shapes(self):
+        self.assertEqual(parse_query('tag:Home "two words" plain'),
+                         [("tag", "home"), (None, "two words"), (None, "plain")])
+
+
+if __name__ == "__main__":
+    unittest.main()
