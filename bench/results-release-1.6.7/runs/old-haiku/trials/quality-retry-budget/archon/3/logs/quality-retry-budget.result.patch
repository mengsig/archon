diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..07ec908 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,45 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff_ms(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+        assert delay >= retry_after_ms
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _require_int(name, value, *, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff_ms(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    assert exponent >= 0
+    # 2**exponent exceeds cap_ms once exponent >= cap_ms.bit_length(), so the
+    # shift is skipped: this keeps huge attempt values from building big ints.
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    backoff = min(cap_ms, base_ms << exponent)
+    assert 0 <= backoff <= cap_ms
+    return backoff
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..34556ea 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,131 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_above_max_returns_none(self):
+        self.assertIsNone(retry_delay(7, 0, max_attempts=4))
+
+    def test_last_allowed_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+
+class Backoff(unittest.TestCase):
+    def test_first_retry_uses_base(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=50), 50)
+
+    def test_exponential_growth(self):
+        delays = [retry_delay(a, 0, max_attempts=10, budget_ms=10**6,
+                              cap_ms=10**6) for a in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 800, 1600])
+
+    def test_cap_clamps_backoff(self):
+        self.assertEqual(
+            retry_delay(5, 0, max_attempts=10, budget_ms=10**6), 400)
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(2, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_gives_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=900, cap_ms=400), 400)
+
+    def test_huge_attempt_returns_cap(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1, cap_ms=400), 400)
+
+    def test_huge_attempt_with_zero_cap_is_zero(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1, cap_ms=0), 0)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_above_cap_is_used_as_is(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=900), 900)
+
+    def test_retry_after_below_backoff_does_not_lower_delay(self):
+        self.assertEqual(retry_delay(3, 0, retry_after_ms=10), 400)
+
+    def test_zero_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class BudgetBoundary(unittest.TestCase):
+    def test_exact_budget_hit_returns_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_less_than_budget_returns_delay(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_within_budget_returns_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_at_exhausted_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_retry_after_pushes_past_budget(self):
+        self.assertIsNone(retry_delay(1, 500, retry_after_ms=600))
+
+
+def call_with(**overrides):
+    kwargs = {"attempt": 1, "elapsed_ms": 0}
+    kwargs.update(overrides)
+    attempt = kwargs.pop("attempt")
+    elapsed_ms = kwargs.pop("elapsed_ms")
+    return retry_delay(attempt, elapsed_ms, **kwargs)
+
+
+class Validation(unittest.TestCase):
+    REQUIRED = ("attempt", "elapsed_ms", "max_attempts", "budget_ms",
+                "base_ms", "cap_ms")
+    LOWER_BOUNDS = (("attempt", 0), ("max_attempts", 0), ("elapsed_ms", -1),
+                    ("budget_ms", -1), ("base_ms", -1), ("cap_ms", -1),
+                    ("retry_after_ms", -1))
+
+    def test_bool_float_str_and_none_are_rejected(self):
+        for name in self.REQUIRED:
+            for value in (True, 1.0, "1", None):
+                with self.subTest(name=name, value=value):
+                    with self.assertRaises(ValueError):
+                        call_with(**{name: value})
+
+    def test_retry_after_rejects_bad_types(self):
+        for value in (True, 1.0, "1"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    call_with(retry_after_ms=value)
+
+    def test_lower_bounds_are_enforced(self):
+        for name, value in self.LOWER_BOUNDS:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    call_with(**{name: value})
+
+    def test_validation_runs_when_attempts_exhausted(self):
+        with self.assertRaises(ValueError):
+            call_with(attempt=5, max_attempts=4, base_ms=-1)
+
+    def test_validation_runs_when_budget_exhausted(self):
+        with self.assertRaises(ValueError):
+            call_with(elapsed_ms=2000, budget_ms=1000, base_ms=True)
+
+    def test_large_int_values_are_accepted(self):
+        self.assertEqual(
+            retry_delay(1, 10**30, budget_ms=10**31, base_ms=10**30,
+                        cap_ms=10**30), 10**30)
+
+
+class Immutability(unittest.TestCase):
+    def test_repeated_calls_are_stable_and_inputs_unchanged(self):
+        attempt, elapsed, retry_after = 2, 100, 150
+        first = retry_delay(attempt, elapsed, retry_after_ms=retry_after)
+        second = retry_delay(attempt, elapsed, retry_after_ms=retry_after)
+        self.assertEqual(first, second)
+        self.assertEqual((attempt, elapsed, retry_after), (2, 100, 150))
