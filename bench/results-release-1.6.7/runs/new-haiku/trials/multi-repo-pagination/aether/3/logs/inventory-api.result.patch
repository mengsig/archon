@@ -24,6 +24,51 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_has_20_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_following_cursors_returns_every_item_once_in_order(self):
+        seen = []
+        query = {"limit": "7"}
+        while True:
+            body = get("/items", **query)["body"]
+            self.assertLessEqual(len(body["items"]), 7)
+            seen.extend(item["id"] for item in body["items"])
+            if body["next_cursor"] is None:
+                break
+            query = {"limit": "7", "cursor": body["next_cursor"]}
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_multiple_of_limit_ends_without_empty_page(self):
+        first = get("/items", limit="19")["body"]
+        second = get("/items", limit="19", cursor=first["next_cursor"])["body"]
+        third = get("/items", limit="19", cursor=second["next_cursor"])["body"]
+        self.assertEqual(len(third["items"]), 19)
+        self.assertIsNone(third["next_cursor"])
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for bad in ["0", "101", "-1", "1.5", "", "abc", " 5", "+5", "٣"]:
+            with self.subTest(limit=bad):
+                res = get("/items", limit=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for bad in ["", "!!!", "abc", "bm9wZQ==", "%%%"]:
+            with self.subTest(cursor=bad):
+                res = get("/items", cursor=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertEqual(res["body"], {"error": "invalid cursor"})
+
 
 if __name__ == "__main__":
     unittest.main()
