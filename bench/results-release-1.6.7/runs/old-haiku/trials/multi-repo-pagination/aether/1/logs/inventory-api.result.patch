 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_DIGITS = re.compile(r"[0-9]{1,18}")
+
+
+class BadRequest(Exception):
+    """A client error that is reported as a 400 response."""
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +32,52 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after_id = _parse_cursor(query.get("cursor"))
+    except BadRequest as exc:
+        return _error(400, str(exc))
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    assert next_cursor is None or page
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_digits(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    """Return the id that the page starts after, or None for the first page."""
+    if raw is None:
+        return None
+    if not isinstance(raw, str):
+        raise BadRequest("cursor is invalid")
+    try:
+        decoded = base64.urlsafe_b64decode(raw + "=" * (-len(raw) % 4)).decode("ascii")
+    except ValueError:
+        raise BadRequest("cursor is invalid") from None
+    if not _is_digits(decoded):
+        raise BadRequest("cursor is invalid")
+    return int(decoded)
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii").rstrip("=")
+
+
+def _is_digits(text):
+    return isinstance(text, str) and _DIGITS.fullmatch(text) is not None
 
 
