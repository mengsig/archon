diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..a8d642f 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,47 @@
+class QueryError(ValueError):
+    """Raised when a search query contains unsupported syntax."""
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    started = False
+    for character in query:
+        if character == '"':
+            quoted = not quoted
+            started = True
+        elif character.isspace() and not quoted:
+            if started:
+                terms.append("".join(current))
+                current = []
+                started = False
+        else:
+            current.append(character)
+            started = True
+    if quoted:
+        raise QueryError("unterminated quote")
+    if started:
+        terms.append("".join(current))
+    return terms
+
+
+def _matches(task, term):
+    if ":" not in term:
+        return term.casefold() in task.title.casefold()
+
+    field, value = term.split(":", 1)
+    field = field.casefold()
+    value = value.casefold()
+    if field == "tag" and value:
+        return any(tag.casefold() == value for tag in task.tags)
+    if field == "status":
+        if value not in ("open", "done"):
+            raise QueryError(f"unknown status: {value}")
+        return task.status.casefold() == value
+    raise QueryError(f"unknown query field: {field}")
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
