@@ -24,6 +24,54 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size(self):
+        res = get("/items")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_limit_bounds(self):
+        for limit in ["1", "100"]:
+            with self.subTest(limit=limit):
+                self.assertEqual(get("/items", limit=limit)["status"], 200)
+        for limit in ["0", "101", "-1", "2.5", "abc", "", " 5"]:
+            with self.subTest(limit=limit):
+                res = get("/items", limit=limit)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_limit_sets_page_size(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_cursor_round_trip_has_no_gaps_or_duplicates(self):
+        all_ids = [item["id"] for item in get("/items", limit="100")["body"]["items"]]
+        seen = []
+        cursor = None
+        while True:
+            query = {"limit": "7"} if cursor is None else {"limit": "7", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            seen.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, all_ids)
+        self.assertEqual(len(seen), len(set(seen)))
+
+    def test_next_cursor_is_null_on_last_page(self):
+        body = get("/items", limit="100")["body"]
+        self.assertIsNone(body["next_cursor"])
+        body = get("/items", limit="57")["body"]
+        self.assertIsNone(body["next_cursor"])
+        self.assertEqual(len(body["items"]), 57)
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ["!!!", "abc", "", "bm90LWEtbnVtYmVy"]:
+            with self.subTest(cursor=cursor):
+                res = get("/items", cursor=cursor)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
