@@ -0,0 +1,244 @@
+//! Characterization of current behaviour, via the public API only, so the same file runs before and after the refactor.
+
+use orders::{billing, report, shipping, Order};
+
+#[derive(Clone, Copy)]
+enum Step {
+    Pay,
+    Ship,
+    Cancel,
+}
+
+fn status_of(order: &Order) -> String {
+    order.status.to_string()
+}
+
+/// Builds an order in the named status by performing the real steps.
+fn order_in(id: u32, total_cents: u64, status: &str) -> Order {
+    let mut order = Order::new(id, "ada", total_cents);
+    match status {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("unknown status {other}"),
+    }
+    order
+}
+
+fn attempt(order: &mut Order, step: Step) -> Result<String, String> {
+    let outcome = match step {
+        Step::Pay => billing::pay(order),
+        Step::Ship => shipping::ship(order),
+        Step::Cancel => order.cancel(),
+    };
+    outcome.map(|()| status_of(order))
+}
+
+#[test]
+fn new_orders_start_pending() {
+    let order = Order::new(1, "ada", 100);
+    assert_eq!(status_of(&order), "pending");
+    assert_eq!(order.customer, "ada");
+    assert_eq!(order.total_cents, 100);
+}
+
+#[test]
+fn each_step_succeeds_or_is_refused_depending_on_current_status() {
+    let cases: [(&str, [Result<&str, &str>; 3]); 4] = [
+        (
+            "pending",
+            [
+                Ok("paid"),
+                Err("order 7 cannot be shipped: it is pending"),
+                Ok("cancelled"),
+            ],
+        ),
+        (
+            "paid",
+            [
+                Err("order 7 cannot be paid: it is paid"),
+                Ok("shipped"),
+                Ok("cancelled"),
+            ],
+        ),
+        (
+            "shipped",
+            [
+                Err("order 7 cannot be paid: it is shipped"),
+                Err("order 7 cannot be shipped: it is shipped"),
+                Err("order 7 cannot be cancelled: it is shipped"),
+            ],
+        ),
+        (
+            "cancelled",
+            [
+                Err("order 7 cannot be paid: it is cancelled"),
+                Err("order 7 cannot be shipped: it is cancelled"),
+                Err("order 7 cannot be cancelled: it is cancelled"),
+            ],
+        ),
+    ];
+    for (status, expected) in cases {
+        for (step, want) in [Step::Pay, Step::Ship, Step::Cancel]
+            .into_iter()
+            .zip(expected)
+        {
+            let mut order = order_in(7, 900, status);
+            let got = attempt(&mut order, step);
+            let want = want.map(String::from).map_err(String::from);
+            assert_eq!(got, want, "from {status}");
+            let after = status_of(&order);
+            match got {
+                Ok(new_status) => assert_eq!(after, new_status),
+                Err(_) => assert_eq!(after, status, "refused step must not change status"),
+            }
+        }
+    }
+}
+
+#[test]
+fn only_pending_and_paid_orders_are_open() {
+    let open: Vec<bool> = ["pending", "paid", "shipped", "cancelled"]
+        .iter()
+        .map(|status| order_in(1, 100, status).is_open())
+        .collect();
+    assert_eq!(open, [true, true, false, false]);
+}
+
+/// Status counts as plain text, so the assertions do not depend on the status type.
+fn status_counts_text(orders: &[Order]) -> Vec<(String, usize)> {
+    report::status_counts(orders)
+        .into_iter()
+        .map(|(status, count)| (status.to_string(), count))
+        .collect()
+}
+
+#[test]
+fn status_counts_are_sorted_by_name_and_omit_absent_statuses() {
+    let orders = [
+        order_in(1, 100, "shipped"),
+        order_in(2, 100, "pending"),
+        order_in(3, 100, "cancelled"),
+        order_in(4, 100, "pending"),
+        order_in(5, 100, "paid"),
+    ];
+    assert_eq!(
+        status_counts_text(&orders),
+        [
+            ("cancelled", 1),
+            ("paid", 1),
+            ("pending", 2),
+            ("shipped", 1)
+        ]
+        .map(|(s, n)| (s.to_string(), n))
+    );
+}
+
+#[test]
+fn status_counts_of_no_orders_is_empty() {
+    assert!(status_counts_text(&[]).is_empty());
+}
+
+#[test]
+fn outstanding_cents_sums_only_pending_orders() {
+    let orders = [
+        order_in(1, 100, "pending"),
+        order_in(2, 200, "paid"),
+        order_in(3, 400, "shipped"),
+        order_in(4, 800, "cancelled"),
+        order_in(5, 1600, "pending"),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 1700);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_lists_paid_orders_in_input_order() {
+    let orders = [
+        order_in(5, 100, "paid"),
+        order_in(2, 100, "pending"),
+        order_in(9, 100, "paid"),
+        order_in(1, 100, "shipped"),
+        order_in(3, 100, "paid"),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [5, 9, 3]);
+}
+
+#[test]
+fn every_status_name_parses_and_prints_back_unchanged() {
+    for name in ["pending", "paid", "shipped", "cancelled"] {
+        let line = format!("3,cy,75,{name}");
+        let order = report::from_line(&line).unwrap();
+        assert_eq!(status_of(&order), name);
+        assert_eq!(report::to_line(&order), line);
+    }
+}
+
+#[test]
+fn from_line_trims_only_the_whole_line() {
+    let order = report::from_line("  1,ada,100,paid \r\n").unwrap();
+    assert_eq!(report::to_line(&order), "1,ada,100,paid");
+    let err = report::from_line("1,ada,100, paid").unwrap_err();
+    assert_eq!(err, r#"unknown status " paid""#);
+}
+
+#[test]
+fn from_line_status_is_case_sensitive() {
+    let err = report::from_line("1,ada,100,Paid").unwrap_err();
+    assert_eq!(err, r#"unknown status "Paid""#);
+}
+
+#[test]
+fn from_line_rejects_unknown_status_names_it() {
+    let err = report::from_line("4,dee,1,lost").unwrap_err();
+    assert_eq!(err, r#"unknown status "lost""#);
+}
+
+#[test]
+fn from_line_rejects_wrong_field_counts() {
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,paid,x").unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+    assert_eq!(
+        report::from_line("").unwrap_err(),
+        "expected 4 fields, got 1"
+    );
+}
+
+#[test]
+fn from_line_reports_bad_numbers_before_bad_status() {
+    let bad_id = r#"bad id "x": invalid digit found in string"#;
+    let bad_total = r#"bad total "x": invalid digit found in string"#;
+    assert_eq!(report::from_line("x,ada,100,paid").unwrap_err(), bad_id);
+    assert_eq!(report::from_line("x,ada,100,lost").unwrap_err(), bad_id);
+    assert_eq!(report::from_line("1,ada,x,lost").unwrap_err(), bad_total);
+    assert_eq!(
+        report::from_line("1,ada,-5,paid").unwrap_err(),
+        r#"bad total "-5": invalid digit found in string"#
+    );
+}
+
+#[test]
+fn from_line_reports_id_overflow() {
+    let err = report::from_line("4294967296,ada,1,paid").unwrap_err();
+    assert_eq!(
+        err,
+        r#"bad id "4294967296": number too large to fit in target type"#
+    );
+}
+
+#[test]
+fn from_line_accepts_empty_customer() {
+    let order = report::from_line("1,,100,shipped").unwrap();
+    assert_eq!(order.customer, "");
+    assert_eq!(status_of(&order), "shipped");
+}
