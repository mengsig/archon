+function paginated(allItems, pageSize) {
+  const calls = [];
+  async function transport(request) {
+    calls.push(request);
+    const start = request.query.cursor === undefined ? 0 : Number(request.query.cursor);
+    const page = allItems.slice(start, start + pageSize);
+    const end = start + page.length;
+    const next_cursor = end < allItems.length ? String(end) : null;
+    return { status: 200, body: { items: page, next_cursor } };
+  }
+  return { transport, calls };
+}
+
+test('follows next_cursor across pages until it is null', async () => {
+  const all = Array.from({ length: 7 }, (_, i) => ({ id: i + 1, sku: `SKU-${i + 1}`, qty: i }));
+  const { transport, calls } = paginated(all, 3);
+  assert.deepEqual(await listItems(transport), all);
+  assert.deepEqual(calls.map((c) => c.query), [{}, { cursor: '3' }, { cursor: '6' }]);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const transport = async () => ({ status: 200, body: { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
+test('rejects a server that repeats a cursor', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /repeated cursor/);
+});
+
