+class Concurrency(unittest.TestCase):
+    THREADS = 4
+    OPS_PER_THREAD = 300
+
+    def _run_threads(self, targets):
+        threads = [threading.Thread(target=t) for t in targets]
+        for thread in threads:
+            thread.start()
+        return threads
+
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        ledger = Ledger({"a": 500, "b": 500})
+
+        def forward():
+            for _ in range(self.OPS_PER_THREAD):
+                ledger.transfer("a", "b", 1)
+
+        def backward():
+            for _ in range(self.OPS_PER_THREAD):
+                ledger.transfer("b", "a", 1)
+
+        targets = [forward] * self.THREADS + [backward] * self.THREADS
+        threads = self._run_threads(targets)
+        for thread in threads:
+            thread.join(timeout=30)
+            self.assertFalse(thread.is_alive(), "transfer threads deadlocked")
+        self.assertEqual(sum(ledger.snapshot().values()), 1000)
+
+    def test_snapshots_never_observe_half_a_transfer(self):
+        total = 1000
+        ledger = Ledger({"a": 500, "b": 500})
+
+        def shuttle():
+            for _ in range(self.OPS_PER_THREAD):
+                ledger.transfer("a", "b", 3)
+                ledger.transfer("b", "a", 2)
+
+        threads = self._run_threads([shuttle] * self.THREADS)
+        sums = [sum(ledger.snapshot().values()) for _ in range(500)]
+        for thread in threads:
+            thread.join(timeout=30)
+            self.assertFalse(thread.is_alive(), "transfer threads deadlocked")
+        self.assertTrue(all(s == total for s in sums))
+        self.assertEqual(sum(ledger.snapshot().values()), total)
+
+    def test_concurrent_transfers_to_one_account_respect_max(self):
+        ledger = Ledger({"sink": MAX_BALANCE - 10, "s1": 100, "s2": 100})
+
+        def fill(source):
+            def run():
+                for _ in range(self.OPS_PER_THREAD):
+                    ledger.transfer(source, "sink", 1)
+            return run
+
+        threads = self._run_threads([fill("s1"), fill("s2")] * self.THREADS)
+        for thread in threads:
+            thread.join(timeout=30)
+            self.assertFalse(thread.is_alive(), "transfer threads deadlocked")
+        snap = ledger.snapshot()
+        self.assertEqual(snap["sink"], MAX_BALANCE)
+        self.assertEqual(sum(snap.values()), MAX_BALANCE - 10 + 200)
+
