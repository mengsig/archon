+++ b/tests/test_export.py
@@ -0,0 +1,52 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+def _csv_of(*tasks):
+    return to_csv(list(tasks))
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_header_only_when_no_tasks(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_every_line_ends_with_crlf(self):
+        out = _csv_of(Task(1, "a"), Task(2, "b"))
+        self.assertEqual(out, HEADER + "1,a,,open,\r\n2,b,,open,\r\n")
+
+    def test_plain_fields_are_not_quoted(self):
+        out = _csv_of(Task(7, "plain title", ["a", "b"], "done", date(2026, 4, 1)))
+        self.assertEqual(out, HEADER + "7,plain title,a;b,done,2026-04-01\r\n")
+
+    def test_comma_in_title_is_quoted(self):
+        out = _csv_of(Task(1, "fix login, then ship"))
+        self.assertEqual(out, HEADER + '1,"fix login, then ship",,open,\r\n')
+
+    def test_double_quote_is_quoted_and_doubled(self):
+        out = _csv_of(Task(1, 'say "hi"'))
+        self.assertEqual(out, HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_lf_and_cr_in_title_are_quoted(self):
+        out = _csv_of(Task(1, "line1\nline2"), Task(2, "a\rb"))
+        self.assertEqual(out, HEADER + '1,"line1\nline2",,open,\r\n2,"a\rb",,open,\r\n')
+
+    def test_rows_keep_input_order(self):
+        out = _csv_of(Task(3, "third"), Task(1, "first"))
+        self.assertEqual(out, HEADER + "3,third,,open,\r\n1,first,,open,\r\n")
+
+    def test_tag_containing_semicolon_is_rejected(self):
+        with self.assertRaises(ValueError):
+            _csv_of(Task(1, "x", ["a;b"]))
+
+    def test_unknown_status_is_rejected(self):
+        with self.assertRaises(AssertionError):
+            _csv_of(Task(1, "x", status="archived"))
+
+
+if __name__ == "__main__":
+    unittest.main()
