+++ b/tests/test_search.py
@@ -0,0 +1,102 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        store = TaskStore()
+        store.add("Fix login page", tags=["Work"])
+        store.add("write report", tags=["home", "work"])
+        store.add("buy milk")
+        store.add("fix login timeout", tags=["bugs"])
+        store.complete(2)
+        self.tasks = store.all()
+
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   ", "\t"]:
+            self.assertEqual(
+                titles(search(self.tasks, query)),
+                ["Fix login page", "write report", "buy milk", "fix login timeout"],
+            )
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(
+            titles(search(self.tasks, "LOGIN")),
+            ["Fix login page", "fix login timeout"],
+        )
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(
+            titles(search(self.tasks, '"fix login"')),
+            ["Fix login page", "fix login timeout"],
+        )
+        self.assertEqual(titles(search(self.tasks, '"login fix"')), [])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(titles(search(self.tasks, "fix timeout")), ["fix login timeout"])
+        self.assertEqual(titles(search(self.tasks, "fix milk")), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work")), ["Fix login page", "write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Fix login page", "write report"])
+
+    def test_tag_does_not_match_substring_of_tag(self):
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_tag_combines_with_words(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work report")), ["write report"])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["write report"])
+        self.assertEqual(
+            titles(search(self.tasks, "status:open")),
+            ["Fix login page", "buy milk", "fix login timeout"],
+        )
+
+    def test_quoted_phrase_containing_colon_is_plain_text(self):
+        store = TaskStore()
+        store.add("meet at 10:30")
+        store.add("meet at noon")
+        self.assertEqual(titles(search(store.all(), '"10:30"')), ["meet at 10:30"])
+
+    def test_quoted_tag_value_may_contain_spaces(self):
+        store = TaskStore()
+        store.add("a", tags=["needs review"])
+        store.add("b", tags=["review"])
+        self.assertEqual(titles(search(store.all(), 'tag:"needs review"')), ["a"])
+
+    def test_empty_quotes_add_no_term(self):
+        self.assertEqual(len(search(self.tasks, '""')), 4)
+
+    def test_unknown_field_raises(self):
+        for query in ["title:login", "due:today", ":x", "10:30"]:
+            with self.subTest(query=query), self.assertRaises(QueryError):
+                search(self.tasks, query)
+
+    def test_unknown_status_raises(self):
+        for query in ["status:closed", "status:", "status:OPEN"]:
+            with self.subTest(query=query), self.assertRaises(QueryError):
+                search(self.tasks, query)
+
+    def test_empty_tag_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        for query in ['"fix login', 'tag:"work', 'a "b" "c']:
+            with self.subTest(query=query), self.assertRaises(QueryError):
+                search(self.tasks, query)
+
+    def test_errors_raise_even_with_no_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "unknown:x")
+
+
+if __name__ == "__main__":
+    unittest.main()
