 def list_items(query):
+    limit, error = _parse_limit(query.get("limit"))
+    if error:
+        return _error(400, error)
+    after, error = _parse_cursor(query.get("cursor"))
+    if error:
+        return _error(400, error)
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    if after is not None:
+        items = [item for item in items if item["id"] > after]
+    page = items[:limit]
+    assert len(page) <= limit
+    next_cursor = str(page[-1]["id"]) if len(items) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT, None
+    if not _is_digits(raw):
+        return None, "limit must be an integer"
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None, f"limit must be between 1 and {MAX_LIMIT}"
+    return limit, None
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None, None
+    if not _is_digits(raw):
+        return None, "cursor is invalid"
+    return int(raw), None
+
+
+def _is_digits(raw):
+    return raw.isascii() and raw.isdigit()
 
 
