diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..e19a185
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,61 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ImpossibleDatesTest(unittest.TestCase):
+    def test_impossible_calendar_dates_raise(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                with self.assertRaisesRegex(InvalidDate, text):
+                    parse_due(text, TODAY)
+
+    def test_invalid_date_is_value_error(self):
+        with self.assertRaises(ValueError):
+            parse_due("2026-02-30", TODAY)
+
+    def test_leap_day_in_leap_year_is_valid(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+        self.assertEqual(parse_due("2026-02-28", TODAY), date(2026, 2, 28))
+
+
+class UnsupportedFormTest(unittest.TestCase):
+    def test_unsupported_text_raises_invalid_date(self):
+        for text in ["soon", "", "2026-3-1", "10/03/2026", "2026-03-10T00:00"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_negative_or_unsigned_offsets_raise(self):
+        for text in ["-3d", "3d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_offset_out_of_range_raises(self):
+        with self.assertRaisesRegex(InvalidDate, "\\+99999999999d"):
+            parse_due("+99999999999d", TODAY)
+
+
+class RelativeDatesTest(unittest.TestCase):
+    def test_offset_adds_days(self):
+        self.assertEqual(parse_due("+5d", TODAY), date(2026, 3, 15))
+
+    def test_zero_offset_is_today(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+
+    def test_today_and_tomorrow(self):
+        self.assertEqual(parse_due("today", TODAY), TODAY)
+        self.assertEqual(parse_due("tomorrow", TODAY), date(2026, 3, 11))
+
+    def test_keywords_ignore_case_and_whitespace(self):
+        self.assertEqual(parse_due("  TODAY ", TODAY), TODAY)
+        self.assertEqual(parse_due(" Tomorrow\t", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due(" +2D ", TODAY), date(2026, 3, 12))
+
+
+if __name__ == "__main__":
+    unittest.main()
