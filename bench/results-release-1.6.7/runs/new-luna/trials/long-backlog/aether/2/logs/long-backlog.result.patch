diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..12a6ef2 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,53 @@
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    was_quoted = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            was_quoted = True
+        elif char.isspace() and not quoted:
+            if current or was_quoted:
+                terms.append(("".join(current), was_quoted))
+                current = []
+                was_quoted = False
+        else:
+            current.append(char)
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current or was_quoted:
+        terms.append(("".join(current), was_quoted))
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    predicates = []
+    for term, quoted in terms:
+        if quoted:
+            needle = term.casefold()
+            predicates.append(lambda task, needle=needle: needle in task.title.casefold())
+            continue
+        if ":" not in term:
+            needle = term.casefold()
+            predicates.append(lambda task, needle=needle: needle in task.title.casefold())
+            continue
+        field, value = term.split(":", 1)
+        field = field.casefold()
+        value_folded = value.casefold()
+        if field == "tag" and value:
+            predicates.append(
+                lambda task, value_folded=value_folded: any(
+                    tag.casefold() == value_folded for tag in task.tags
+                )
+            )
+        elif field == "status" and value_folded in ("open", "done"):
+            predicates.append(lambda task, status=value_folded: task.status.casefold() == status)
+        else:
+            raise QueryError(f"invalid query term: {term}")
+    return [task for task in tasks if all(predicate(task) for predicate in predicates)]
