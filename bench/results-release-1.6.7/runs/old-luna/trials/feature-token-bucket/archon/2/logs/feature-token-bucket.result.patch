+        self._tokens = capacity
+        self._last_time = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now > self._last_time:
+            elapsed = now - self._last_time
+            self._tokens = min(self.capacity, self._tokens + elapsed * self.refill_per_sec)
+            self._last_time = now
+
+    def _validate_request(self, n):
+        self._validate_request_for_capacity(n, self.capacity)
+
+    @staticmethod
+    def _validate_request_for_capacity(n, capacity):
