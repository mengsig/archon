@@ -0,0 +1,138 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        self.assertIs(store.undo(), task)
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_undo_add_does_not_reuse_id(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertEqual(first.id, 1)
+        self.assertEqual(second.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        self.assertIs(store.undo(), task)
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_complete_of_done_task_makes_it_open(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_exact_task_under_same_id(self):
+        store = TaskStore()
+        store.add("plain")
+        task = store.add("with details", tags=["a", "b"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = (task.id, task.title, list(task.tags), task.status, task.due)
+        store.delete(task.id)
+        self.assertIs(store.undo(), task)
+        after = store.get(task.id)
+        self.assertEqual((after.id, after.title, after.tags, after.status, after.due), before)
+        self.assertEqual([t.id for t in store.all()], [1, 2])
+
+    def test_undo_delete_keeps_id_order(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        c = store.add("c")
+        store.delete(a.id)
+        store.delete(c.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [b.id, c.id])
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id, c.id])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        self.assertIs(store.undo(), b)
+        self.assertEqual(store.get(b.id).status, OPEN)
+        self.assertIs(store.undo(), a)
+        self.assertEqual(store.get(a.id).status, OPEN)
+        self.assertIs(store.undo(), b)
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        self.assertIs(store.undo(), a)
+        self.assertEqual([t.id for t in store.all()], [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_after_undo_walks_past_undone_operations(self):
+        store = TaskStore()
+        a = store.add("a")
+        store.complete(a.id)
+        store.undo()
+        store.delete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_interleaved_sequence_fully_unwinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(b.id)
+        c = store.add("c")
+        store.delete(a.id)
+        store.complete(c.id)
+        for _ in range(6):
+            store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
