+class RefillTest(unittest.TestCase):
+    def test_fractional_tokens_accrue_continuously(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_available_returns_float(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertIsInstance(bucket.available(), float)
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 10.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire())
+
+
+class WaitTimeTest(unittest.TestCase):
+    def test_wait_time_is_zero_when_acquire_would_succeed(self):
+        bucket = TokenBucket(4, 2.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(), 0.0)
+        self.assertEqual(bucket.wait_time(4), 0.0)
+
+    def test_wait_time_math(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertEqual(bucket.wait_time(1), 0.5)
+        self.assertEqual(bucket.wait_time(3), 1.5)
+
+    def test_wait_time_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        bucket.wait_time(2)
+        bucket.wait_time(2)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire(1))
+        self.assertFalse(bucket.try_acquire(1))
+
+    def test_acquire_succeeds_after_waiting_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 4.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now += bucket.wait_time(2)
+        self.assertTrue(bucket.try_acquire(2))
+
+
+class ClockRegressionTest(unittest.TestCase):
+    def test_backwards_clock_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+        self.assertEqual(bucket.wait_time(1), 1.0)
+
+    def test_refill_resumes_from_latest_seen_time(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        bucket.available()
+        clock.now = 10.5
+        self.assertEqual(bucket.available(), 0.5)
+        clock.now = 11.0
+        self.assertEqual(bucket.available(), 1.0)
+
+
+class KeyedLimiterTest(unittest.TestCase):
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+        limiter.try_acquire("a")
+        self.assertEqual(len(limiter), 2)
+
+    def test_lru_evicts_least_recently_used_key(self):
+        limiter = KeyedLimiter(1, 0.001, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("c"))
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_wait_time_counts_as_use_for_lru(self):
+        limiter = KeyedLimiter(1, 0.5, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(limiter.wait_time("a"), 2.0)
+        self.assertTrue(limiter.try_acquire("c"))
+        self.assertEqual(limiter.wait_time("a"), 2.0)
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_restarts_full(self):
+        limiter = KeyedLimiter(2, 0.001, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a", 2))
