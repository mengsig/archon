+    def test_limit_default_and_bounds(self):
+        default = get("/items")
+        self.assertEqual(len(default["body"]["items"]), 20)
+        self.assertIsNotNone(default["body"]["next_cursor"])
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for limit in ("0", "101", "-1", "1.5", "abc", " 2"):
+            with self.subTest(limit=limit):
+                response = get("/items", limit=limit)
+                self.assertEqual(response["status"], 400)
+                self.assertEqual(set(response["body"]), {"error"})
+
+    def test_cursor_pagination_and_last_page(self):
+        first = get("/items", limit="7")
+        self.assertEqual([x["id"] for x in first["body"]["items"]], list(range(1, 8)))
+        second = get("/items", limit="7", cursor=first["body"]["next_cursor"])
+        self.assertEqual([x["id"] for x in second["body"]["items"]], list(range(8, 15)))
+
+        all_items = []
+        cursor = None
+        while True:
+            query = {"limit": "9"}
+            if cursor is not None:
+                query["cursor"] = cursor
+            response = get("/items", **query)
+            all_items.extend(response["body"]["items"])
+            cursor = response["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual([x["id"] for x in all_items], list(range(1, 58)))
+        penultimate = get("/items", limit="56")
+        last = get("/items", limit="56", cursor=penultimate["body"]["next_cursor"])
+        self.assertEqual([x["id"] for x in last["body"]["items"]], [57])
+        self.assertEqual(last["body"]["next_cursor"], None)
+
+    def test_invalid_cursors(self):
+        for cursor in ("!", "MA", "OTk", "", 4):
+            with self.subTest(cursor=cursor):
+                response = get("/items", cursor=cursor)
+                self.assertEqual(response["status"], 400)
+                self.assertEqual(set(response["body"]), {"error"})
+
     def test_single_item(self):
