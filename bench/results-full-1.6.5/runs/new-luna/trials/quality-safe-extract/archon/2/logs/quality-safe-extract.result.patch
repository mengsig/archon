@@ -18,3 +18,83 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+    def assert_invalid_without_changes(self, entries, root):
+        before = sorted((p.relative_to(root).as_posix(), p.is_dir(),
+                         p.read_bytes() if p.is_file() else None)
+                        for p in root.rglob("*"))
+        with self.assertRaises(ValueError):
+            extract(entries, root)
+        after = sorted((p.relative_to(root).as_posix(), p.is_dir(),
+                        p.read_bytes() if p.is_file() else None)
+                       for p in root.rglob("*"))
+        self.assertEqual(after, before)
+
+    def test_batch_type_and_entry_validation(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            for invalid in ((), iter(()), (item for item in ())):
+                with self.subTest(invalid=type(invalid).__name__):
+                    with self.assertRaises(ValueError):
+                        extract(invalid, root)
+            for entries in (["x"], [("x", bytearray(b"x"))],
+                            [(None, b"x")], [("x", b"x", b"y")]):
+                with self.subTest(entries=entries):
+                    self.assert_invalid_without_changes(entries, root)
+
+    def test_rejects_unsafe_names_and_collisions(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            names = ("", "/abs", "a//b", "a/./b", "a/../b", "a\\b",
+                     "C:/file", "a:b", "a\0b")
+            for name in names:
+                with self.subTest(name=name):
+                    self.assert_invalid_without_changes([(name, b"x")], root)
+            for batch in ([ ("same", b"1"), ("same", b"2") ],
+                          [("a", b"1"), ("a/b", b"2")],
+                          [("a/b", b"1"), ("a", b"2")]):
+                with self.subTest(batch=batch):
+                    self.assert_invalid_without_changes(batch, root)
+            self.assertEqual(extract([("100%/file", b"ok")], root),
+                             ["100%/file"])
+
+    def test_existing_targets_files_and_symlinks_are_rejected(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            (root / "taken").write_bytes(b"original")
+            (root / "notdir").write_bytes(b"file")
+            self.assert_invalid_without_changes([("new/file", b"x"),
+                                                 ("taken", b"overwrite")], root)
+            self.assert_invalid_without_changes([("notdir/child", b"x")], root)
+            outside = root.parent / (root.name + "-outside")
+            outside.mkdir()
+            try:
+                for link_name, target in (("link", outside),
+                                          ("dangling", root / "missing")):
+                    try:
+                        (root / link_name).symlink_to(target)
+                    except (OSError, NotImplementedError):
+                        self.skipTest("symlinks are unavailable")
+                    self.assert_invalid_without_changes(
+                        [(link_name + "/child", b"x")], root)
+                    self.assert_invalid_without_changes([(link_name, b"x")], root)
+                self.assertEqual(list(outside.iterdir()), [])
+            finally:
+                for item in root.iterdir():
+                    if item.is_symlink():
+                        item.unlink()
+                outside.rmdir()
+
+    def test_root_must_be_existing_real_directory(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            with self.assertRaises(ValueError):
+                extract([], root / "missing")
+            file_path = root / "file"
+            file_path.write_text("x")
+            with self.assertRaises(ValueError):
+                extract([], file_path)
+            link = root / "link"
+            link.symlink_to(root, target_is_directory=True)
+            with self.assertRaises(ValueError):
+                extract([], link)
