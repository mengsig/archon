-    return {"status": 200, "body": {"items": items}}
+    if after_id is not None:
+        items = [item for item in items if item["id"] > after_id]
+    page = items[:limit]
+    has_more = len(items) > limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not (raw.isascii() and raw.isdigit()):
+        raise ValueError("limit must be an integer")
+    limit = int(raw)
+    if not MIN_LIMIT <= limit <= MAX_LIMIT:
+        raise ValueError(f"limit must be between {MIN_LIMIT} and {MAX_LIMIT}")
+    return limit
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None
+    try:
+        decoded = base64.b64decode(raw.encode("ascii"), altchars=b"-_", validate=True)
+    except ValueError as exc:
+        raise ValueError("invalid cursor") from exc
+    text = decoded.decode("ascii", errors="replace")
+    if not text.isdigit() or int(text) not in _ITEM_IDS:
+        raise ValueError("invalid cursor")
+    return int(text)
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
 
 
