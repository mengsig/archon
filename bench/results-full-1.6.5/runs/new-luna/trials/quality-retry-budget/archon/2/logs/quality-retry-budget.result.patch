diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..dc74b47 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,46 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": attempt,
+        "elapsed_ms": elapsed_ms,
+        "max_attempts": max_attempts,
+        "budget_ms": budget_ms,
+        "base_ms": base_ms,
+        "cap_ms": cap_ms,
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = retry_after_ms
+
+    for name, value in values.items():
+        if type(value) is not int:
+            raise ValueError(f"{name} must be an integer")
+
+    if attempt < 1 or max_attempts < 1:
+        raise ValueError("attempt and max_attempts must be at least 1")
+    if any(values[name] < 0 for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms")):
+        raise ValueError("times and backoff values must be non-negative")
+    if retry_after_ms is not None and retry_after_ms < 0:
+        raise ValueError("retry_after_ms must be non-negative")
+
+    if attempt >= max_attempts:
+        return None
+
+    exponent = attempt - 1
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    elif base_ms >= cap_ms:
+        delay = cap_ms
+    else:
+        # Once 2**exponent reaches this ratio, the capped value is certain.
+        saturation_exponent = ((cap_ms + base_ms - 1) // base_ms).bit_length()
+        delay = cap_ms if exponent >= saturation_exponent else min(
+            cap_ms, base_ms << exponent
+        )
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..d5ab07f 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,51 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_before_exhaustion(self):
+        invalid_options = (
+            {"attempt": True}, {"attempt": 1.0}, {"attempt": 0},
+            {"elapsed_ms": False}, {"elapsed_ms": -1},
+            {"max_attempts": True}, {"max_attempts": 0},
+            {"budget_ms": -1}, {"base_ms": -1}, {"cap_ms": -1},
+            {"retry_after_ms": -1}, {"retry_after_ms": 1.5},
+            {"retry_after_ms": True},
+        )
+        for options in invalid_options:
+            with self.subTest(options=options):
+                with self.assertRaises(ValueError):
+                    arguments = {"attempt": 5, "elapsed_ms": 0}
+                    arguments.update(options)
+                    retry_delay(**arguments)
+
+    def test_attempt_count_includes_initial_attempt(self):
+        self.assertEqual(retry_delay(1, 0, max_attempts=2), 100)
+        self.assertIsNone(retry_delay(2, 0, max_attempts=2))
+        self.assertIsNone(retry_delay(20, 0, max_attempts=2))
+
+    def test_budget_requires_strictly_earlier_start(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=101), 100)
+        self.assertIsNone(retry_delay(1, 1, budget_ms=101))
+        self.assertIsNone(retry_delay(1, 101, budget_ms=102,
+                                     retry_after_ms=1))
+        self.assertEqual(retry_delay(1, 0, budget_ms=101, base_ms=0), 0)
+
+    def test_zero_values_and_base_above_cap(self):
+        self.assertEqual(retry_delay(2, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(2, 0, base_ms=500, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=10), 10)
+
+    def test_retry_after_is_not_capped_or_shortened(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=10, retry_after_ms=20), 20)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=19, cap_ms=10,
+                                      retry_after_ms=20))
+
+    def test_huge_attempt_saturates_without_building_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1),
+                         400)
+
+    def test_arbitrarily_large_integer_times(self):
+        huge = 10**100
+        self.assertEqual(retry_delay(1, 0, budget_ms=huge), 100)
