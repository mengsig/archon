 from data import ITEMS
 
 
@@ -22,7 +25,55 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", 20)
+    if isinstance(raw_limit, bool):
+        return _error(400, "limit must be an integer from 1 to 100")
+    try:
+        limit = int(raw_limit)
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 to 100")
+    if (isinstance(raw_limit, float) or str(limit) != str(raw_limit)
+            or not 1 <= limit <= 100):
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    start_after = None
+    if cursor is not None:
+        start_after = _decode_cursor(cursor, items)
+        if start_after is None:
+            return _error(400, "invalid cursor")
+
+    remaining = items
+    if start_after is not None:
+        remaining = [item for item in items if item["id"] > start_after]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {
+        "status": 200,
+        "body": {"items": page, "next_cursor": next_cursor},
+    }
+
+
+def _encode_cursor(item_id):
+    raw = str(item_id).encode("ascii")
+    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")
+
+
+def _decode_cursor(cursor, items):
+    if not isinstance(cursor, str) or not cursor:
+        return None
+    try:
+        raw = base64.b64decode(
+            cursor + "=" * (-len(cursor) % 4), altchars=b"-_", validate=True
+        )
+        decoded = raw.decode("ascii")
+        item_id = int(decoded)
+    except (binascii.Error, UnicodeDecodeError, ValueError):
+        return None
+    if (str(item_id) != decoded or _encode_cursor(item_id) != cursor
+            or item_id not in {item["id"] for item in items}):
+        return None
+    return item_id
 
 
