+/// ISO 4217 code: exactly three ASCII uppercase letters.
+pub fn parse_currency(s: &str) -> Result<String, ParseError> {
+    let valid = s.len() == 3 && s.bytes().all(|c| c.is_ascii_uppercase());
+    if !valid {
+        return Err(ParseError::BadCurrency(s.to_string()));
+    }
+    Ok(s.to_string())
+}
