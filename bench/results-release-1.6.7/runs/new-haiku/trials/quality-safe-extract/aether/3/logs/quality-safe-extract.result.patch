 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write regular-file entries under root and return their names in input order.
+
+    The whole batch and every target path are validated before anything is created.
+    """
+    _require_list(entries)
+    root_path = _validate_root(root)
+    batch = _validate_batch(entries)
+    for name, parts, _ in batch:
+        _check_target_free(root_path, name, parts)
+    for _, parts, data in batch:
+        _write_file(root_path, parts, data)
+    return [name for name, _, _ in batch]
+
+
+def _require_list(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty str or Path, not {root!r}")
+    path = Path(root)
+    info = _lstat_or_none(path)
+    if info is None:
+        raise ValueError(f"root is not an existing directory: {root!r}")
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root must not be a symlink: {root!r}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root is not a directory: {root!r}")
+    return path
+
+
+def _validate_batch(entries):
+    batch = [_validate_entry(index, entry) for index, entry in enumerate(entries)]
+    _check_batch_conflicts(batch)
+    return batch
+
+
+def _validate_entry(index, entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name, _split_name(name), data
+
+
+def _split_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in "\\:\0"):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    parts = tuple(name.split("/"))
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"entry name has an empty, '.' or '..' component: {name!r}")
+    _check_encodable(name)
+    return parts
+
+
+def _check_encodable(name):
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name cannot be encoded for the filesystem: {name!r}") from exc
+
+
+def _check_batch_conflicts(batch):
+    names = set()
+    for name, _, _ in batch:
+        if name in names:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        names.add(name)
+    for name, parts, _ in batch:
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in names:
+                raise ValueError(f"{ancestor!r} is both a file and a directory (conflicts with {name!r})")
+
+
+def _check_target_free(root, name, parts):
+    assert parts, "validated names have at least one component"
+    for depth in range(1, len(parts) + 1):
+        prefix = "/".join(parts[:depth])
+        info = _lstat_or_none(root / prefix)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"symlink found in path of {name!r}: {prefix!r}")
+        if depth == len(parts):
+            raise ValueError(f"target already exists: {name!r}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor is not a directory for {name!r}: {prefix!r}")
+
+
+def _write_file(root, parts, data):
+    assert isinstance(data, bytes), "data was validated as bytes"
+    target = root.joinpath(*parts)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with open(target, "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
