diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..25b759e 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,59 @@
+import re
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+TERM = re.compile(r'(?:[^\s"]|"[^"]*")+')
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _parse_query(query)
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
+
+
+def _parse_query(query):
+    """Parse a query into `(field, value)` terms; field is None for text."""
+    assert isinstance(query, str), f"query must be a string, got {query!r}"
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    return [_parse_term(token) for token in TERM.findall(query)]
+
+
+def _parse_term(token):
+    if token.startswith('"'):
+        return None, _unquote(token).casefold()
+    text = _unquote(token)
+    field, sep, value = text.partition(":")
+    if not sep or not field:
+        return None, text.casefold()
+    return _parse_field(field.casefold(), value.casefold())
+
+
+def _parse_field(field, value):
+    if field == "tag":
+        if not value:
+            raise QueryError("tag: needs a tag name")
+        return "tag", value
+    if field == "status":
+        if value not in STATUSES:
+            raise QueryError(f"unknown status: {value}")
+        return "status", value
+    raise QueryError(f"unknown field: {field}")
+
+
+def _matches(task, term):
+    field, value = term
+    assert field in (None, "tag", "status"), f"unknown field {field!r}"
+    if field is None:
+        return value in task.title.casefold()
+    if field == "tag":
+        return any(tag.casefold() == value for tag in task.tags)
+    return task.status == value
+
+
+def _unquote(token):
+    return token.replace('"', "")
