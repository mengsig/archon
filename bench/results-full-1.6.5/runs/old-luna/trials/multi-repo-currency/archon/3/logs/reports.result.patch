@@ -4,28 +4,42 @@ Usage: python3 reports.py < ledger.csv
 """
 
 import csv
+import re
 import sys
 
 
 def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
+    has_currency_column = "currency" in (getattr(rows, "fieldnames", None) or [])
     for row in rows:
         account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+        currency = row.get("currency", "USD")
+        if currency is None and not has_currency_column:
+            currency = "USD"
+        if re.fullmatch(r"[A-Z]{3}", currency, flags=re.ASCII) is None:
+            line = getattr(rows, "line_num", "?")
+            raise ValueError(f"line {line}: invalid currency {currency!r}")
+        key = (account, currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
     rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        output = render(totals(rows))
+    except ValueError as error:
+        print(error, file=sys.stderr)
+        raise SystemExit(2)
+    sys.stdout.write(output)
 
 
 if __name__ == "__main__":
