 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_amount(value):
+    # type() check excludes bool, which subclasses int.
+    if type(value) is not int or not 1 <= value <= MAX_BALANCE:
+        raise ValueError(f"amount must be an int in [1, {MAX_BALANCE}]: {value!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError(f"balances must be a dict: {type(balances).__name__}")
+        copied = dict(balances)
+        for name, balance in copied.items():
+            if not isinstance(name, str) or not name:
+                raise ValueError(f"account name must be a nonempty string: {name!r}")
+            if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+                raise ValueError(f"balance must be an int in [0, {MAX_BALANCE}]: {balance!r}")
+        self._balances = copied
+        # One lock per ledger: a single lock cannot deadlock on opposite transfers.
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        with self._lock:
+            if source not in self._balances:
+                raise KeyError(source)
+            if destination not in self._balances:
+                raise KeyError(destination)
+            if source == destination:
+                return self._balances[source] >= amount
+            if self._balances[source] < amount:
+                return False
+            if self._balances[destination] + amount > MAX_BALANCE:
+                return False
+            self._balances[source] -= amount
+            self._balances[destination] += amount
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
