diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..532b9bf 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,38 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = ("attempt", attempt), ("elapsed_ms", elapsed_ms), (
+        "max_attempts", max_attempts), ("budget_ms", budget_ms), (
+        "base_ms", base_ms), ("cap_ms", cap_ms)
+    for name, value in values:
+        if type(value) is not int:
+            raise ValueError(f"{name} must be an integer")
+    if retry_after_ms is not None and type(retry_after_ms) is not int:
+        raise ValueError("retry_after_ms must be an integer or None")
+
+    if attempt < 1 or max_attempts < 1:
+        raise ValueError("attempt and max_attempts must be at least 1")
+    if any(value < 0 for _, value in values[1:2] + values[3:]):
+        raise ValueError("elapsed_ms, budget_ms, base_ms, and cap_ms must be nonnegative")
+    if retry_after_ms is not None and retry_after_ms < 0:
+        raise ValueError("retry_after_ms must be nonnegative")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    else:
+        exponent = attempt - 1
+        # If exponent is this large, the uncapped value is certainly >= cap.
+        # Otherwise exponent is bounded by cap's bit length, so pow stays small.
+        if base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms * (1 << exponent))
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..641754a 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,37 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_even_when_attempts_exhausted(self):
+        for kwargs in (
+            {"elapsed_ms": True}, {"attempt": 1.0}, {"max_attempts": False},
+            {"budget_ms": -1}, {"base_ms": -1}, {"cap_ms": -1},
+            {"retry_after_ms": -1}, {"retry_after_ms": 1.0},
+            {"attempt": 0}, {"max_attempts": 0},
+        ):
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                args = {"attempt": 4, "elapsed_ms": 0}
+                args.update(kwargs)
+                retry_delay(**args)
+
+    def test_attempt_past_maximum_is_legal_after_validation(self):
+        self.assertIsNone(retry_delay(100, 0))
+
+    def test_zero_backoff_and_zero_cap(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_can_exceed_cap_and_huge_attempt_saturates(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=900, cap_ms=2), 2)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
+
+    def test_retry_after_floor_is_not_capped(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=1500), None)
+        self.assertEqual(retry_delay(1, 0, budget_ms=2000, retry_after_ms=1500), 1500)
+
+    def test_strict_budget_boundary_and_zero_delay(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
