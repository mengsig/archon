@@ -0,0 +1,42 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTests(unittest.TestCase):
+    def test_undo_add_never_reuses_id(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_undo_mixed_operations_lifo(self):
+        store = TaskStore()
+        task = store.add("original", ["x"], date(2026, 4, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.title, restored.tags, restored.status, restored.due),
+                         ("original", ["x"], "done", date(2026, 4, 1)))
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_failed_operations_and_empty_history(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        store.add("kept")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
