diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..eb29a95 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,57 @@
+from .models import DONE, OPEN
+
+
+class QueryError(ValueError):
+    """Raised when a search query contains invalid syntax."""
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+
+    for character in query:
+        if character == '"':
+            quoted = not quoted
+        elif character.isspace() and not quoted:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(character)
+
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
+def _parse_term(term):
+    if ":" not in term:
+        return "title", term.casefold()
+
+    field, value = term.split(":", 1)
+    field = field.casefold()
+    if field == "tag":
+        return "tag", value.casefold()
+    if field == "status":
+        status = value.casefold()
+        if status not in (OPEN, DONE):
+            raise QueryError("unknown status: {}".format(value))
+        return "status", status
+    raise QueryError("unsupported field: {}".format(field))
+
+
+def _matches(task, term):
+    field, value = term
+    if field == "title":
+        return value in task.title.casefold()
+    if field == "tag":
+        return any(value == tag.casefold() for tag in task.tags)
+    return task.status.casefold() == value
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = [_parse_term(term) for term in _terms(query)]
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
