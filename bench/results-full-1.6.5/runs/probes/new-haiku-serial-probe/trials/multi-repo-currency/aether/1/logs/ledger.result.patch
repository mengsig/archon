+#[test]
+fn rejects_malformed_currency_with_exit_code_2() {
+    for code in ["eur", "EURO", "EU", "E1R", ""] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert!(matches!(err, LineError::Currency(_)), "{code:?}: {err:?}");
+        assert_eq!(err.exit_code(), 2, "{code:?}");
+    }
