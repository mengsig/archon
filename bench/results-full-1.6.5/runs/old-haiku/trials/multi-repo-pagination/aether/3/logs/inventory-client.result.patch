 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  let query = {};
+  while (true) {
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error(`GET /items returned no items array: ${JSON.stringify(body)}`);
+    }
+    items.push(...body.items);
+    if (body.next_cursor == null) return items;
+    if (body.next_cursor === query.cursor) {
+      throw new Error(`GET /items did not advance past cursor ${query.cursor}`);
+    }
+    query = { cursor: body.next_cursor };
+  }
 }
 
