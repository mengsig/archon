+    def test_default_clock_is_time_monotonic(self):
+        for cls in (TokenBucket, KeyedLimiter):
+            default = inspect.signature(cls).parameters["clock"].default
+            self.assertIs(default, time.monotonic)
+
+
+class ValidationTest(unittest.TestCase):
+    def test_invalid_bucket_parameters_raise(self):
+        nan = float("nan")
+        for capacity, refill in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5), (nan, 1.0), (1, nan)]:
+            with self.subTest(capacity=capacity, refill=refill):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, refill, clock=FakeClock())
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, refill, clock=FakeClock())
+
+    def test_invalid_n_raises_for_every_bucket_method(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3, float("nan")):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_n_equal_to_capacity_is_allowed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertEqual(bucket.wait_time(2), 2.0)
+
+    def test_invalid_max_keys_raises(self):
+        for max_keys in (0, -1, 1.5, float("nan")):
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_n_does_not_create_a_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=0)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
