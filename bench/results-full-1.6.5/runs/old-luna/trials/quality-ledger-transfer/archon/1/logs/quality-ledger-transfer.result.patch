+class LedgerConcurrency(unittest.TestCase):
+    def test_opposing_transfers_finish_without_deadlock(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = Barrier(3)
+        failures = []
+
+        def move(source, destination):
+            try:
+                start.wait(timeout=2)
+                for _ in range(500):
+                    ledger.transfer(source, destination, 1)
+            except BaseException as error:
+                failures.append(error)
+
+        threads = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for thread in threads:
+            thread.start()
+        start.wait(timeout=2)
+        for thread in threads:
+            thread.join(timeout=3)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "transfer deadlocked")
+        self.assertEqual(failures, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 200)
+
+    def test_snapshots_never_observe_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        start = Barrier(2)
+        finished = []
+
+        def transfer_repeatedly():
+            start.wait(timeout=2)
+            for _ in range(1000):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+            finished.append(True)
+
+        worker = Thread(target=transfer_repeatedly)
+        worker.start()
+        start.wait(timeout=2)
+        while not finished:
+            self.assertEqual(sum(ledger.snapshot().values()), 2000)
+        worker.join(timeout=3)
+        self.assertFalse(worker.is_alive(), "transfer worker did not finish")
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
