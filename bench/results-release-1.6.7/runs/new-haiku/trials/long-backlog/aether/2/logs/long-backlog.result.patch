@@ -1,2 +1,73 @@
+from typing import NamedTuple, Optional
+
+from .models import DONE, OPEN
+
+TAG = "tag"
+STATUS = "status"
+FIELDS = (TAG, STATUS)
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
+class Term(NamedTuple):
+    field: Optional[str]
+    value: str
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    terms = [_parse_term(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(_matches(term, task) for term in terms)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quote characters are kept."""
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    terms = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+        if char.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
+def _parse_term(raw):
+    if raw.startswith('"') or ":" not in raw:
+        return Term(None, _strip_quotes(raw).lower())
+    field, value = raw.split(":", 1)
+    field = field.lower()
+    if field not in FIELDS:
+        raise QueryError(f"unknown field {field!r} in term {raw!r}")
+    value = _strip_quotes(value).lower()
+    if not value:
+        raise QueryError(f"missing value in term {raw!r}")
+    if field == STATUS and value not in STATUSES:
+        raise QueryError(f"unknown status {value!r} in term {raw!r}")
+    return Term(field, value)
+
+
+def _strip_quotes(text):
+    return text.replace('"', "")
+
+
+def _matches(term, task):
+    assert term.field in (None, TAG, STATUS), f"bad term field {term.field!r}"
+    if term.field is None:
+        return term.value in task.title.lower()
+    if term.field == TAG:
+        return any(tag.lower() == term.value for tag in task.tags)
+    return task.status == term.value
