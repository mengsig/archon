+//! Contract of `OrderStatus`: names, parsing, display and the lifecycle table.
+
+use orders::{OrderStatus, ParseStatusError};
+
+const ALL: [OrderStatus; 4] = [
+    OrderStatus::Pending,
+    OrderStatus::Paid,
+    OrderStatus::Shipped,
+    OrderStatus::Cancelled,
+];
+
+#[test]
+fn names_are_the_lowercase_status_words() {
+    assert_eq!(OrderStatus::Pending.as_str(), "pending");
+    assert_eq!(OrderStatus::Paid.as_str(), "paid");
+    assert_eq!(OrderStatus::Shipped.as_str(), "shipped");
+    assert_eq!(OrderStatus::Cancelled.as_str(), "cancelled");
+}
+
+#[test]
+fn display_prints_the_name_and_honours_padding() {
+    assert_eq!(OrderStatus::Paid.to_string(), "paid");
+    assert_eq!(format!("[{:>9}]", OrderStatus::Paid), "[     paid]");
+}
+
+#[test]
+fn every_name_parses_back_to_its_status() {
+    for status in ALL {
+        assert_eq!(status.as_str().parse::<OrderStatus>(), Ok(status));
+    }
+}
+
+#[test]
+fn unknown_names_are_rejected_with_the_input_in_the_message() {
+    for input in ["lost", "Paid", " paid", ""] {
+        let err = input.parse::<OrderStatus>().unwrap_err();
+        assert_eq!(err.to_string(), format!("unknown status {input:?}"));
+    }
+}
+
+#[test]
+fn parse_error_is_a_std_error() {
+    fn assert_error<E: std::error::Error>() {}
+    assert_error::<ParseStatusError>();
+}
+
+#[test]
+fn only_pending_to_paid_pending_to_cancelled_paid_to_shipped_and_paid_to_cancelled_are_allowed() {
+    let allowed = [
+        (OrderStatus::Pending, OrderStatus::Paid),
+        (OrderStatus::Pending, OrderStatus::Cancelled),
+        (OrderStatus::Paid, OrderStatus::Shipped),
+        (OrderStatus::Paid, OrderStatus::Cancelled),
+    ];
+    for from in ALL {
+        for to in ALL {
+            assert_eq!(
+                from.can_transition_to(to),
+                allowed.contains(&(from, to)),
+                "{from} -> {to}"
+            );
+        }
+    }
+}
