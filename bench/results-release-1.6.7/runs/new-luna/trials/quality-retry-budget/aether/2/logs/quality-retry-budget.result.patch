diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..752c284 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,53 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the required wait before another attempt, or ``None``.
+
+    The attempt count includes the initial attempt. All durations are in
+    milliseconds, and every argument is validated even when no retry remains.
+    """
+    values = {
+        "attempt": attempt,
+        "elapsed_ms": elapsed_ms,
+        "max_attempts": max_attempts,
+        "budget_ms": budget_ms,
+        "base_ms": base_ms,
+        "cap_ms": cap_ms,
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = retry_after_ms
+
+    for name, value in values.items():
+        if type(value) is not int:
+            raise ValueError(f"{name} must be a built-in int")
+
+    for name in ("attempt", "max_attempts"):
+        if values[name] < 1:
+            raise ValueError(f"{name} must be at least 1")
+    for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms",
+                 "retry_after_ms"):
+        if name in values and values[name] < 0:
+            raise ValueError(f"{name} must be at least 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    elif base_ms >= cap_ms:
+        backoff = cap_ms
+    else:
+        exponent = attempt - 1
+        # Find the first exponent that would reach the cap. This keeps the
+        # shift below bounded by the size of cap_ms, even for huge attempts.
+        cap_ratio = (cap_ms + base_ms - 1) // base_ms
+        saturation_exponent = (cap_ratio - 1).bit_length()
+        if exponent >= saturation_exponent:
+            backoff = cap_ms
+        else:
+            backoff = base_ms << exponent
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..af44e3c 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,76 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_non_builtin_integers(self):
+        class IntSubclass(int):
+            pass
+
+        invalid_values = (True, False, 1.0, "1", IntSubclass(1))
+        arguments = {
+            "attempt": 1,
+            "elapsed_ms": 0,
+            "max_attempts": 4,
+            "budget_ms": 1000,
+            "base_ms": 100,
+            "cap_ms": 400,
+            "retry_after_ms": 1,
+        }
+        for name in arguments:
+            for value in invalid_values:
+                with self.subTest(argument=name, value=repr(value)):
+                    bad_arguments = dict(arguments)
+                    bad_arguments[name] = value
+                    with self.assertRaises(ValueError):
+                        retry_delay(**bad_arguments)
+
+    def test_rejects_negative_and_zero_counts(self):
+        arguments = {"attempt": 1, "elapsed_ms": 0}
+        for name in ("attempt", "max_attempts"):
+            for value in (0, -1):
+                with self.subTest(argument=name, value=value):
+                    with self.assertRaises(ValueError):
+                        retry_delay(**(arguments | {name: value}))
+
+        for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms",
+                     "retry_after_ms"):
+            with self.subTest(argument=name):
+                with self.assertRaises(ValueError):
+                    retry_delay(**(arguments | {name: -1}))
+
+    def test_validation_precedes_exhaustion(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=1, retry_after_ms=1.5)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_retry_must_start_strictly_before_budget(self):
+        self.assertEqual(retry_delay(1, 899), 100)
+        self.assertIsNone(retry_delay(1, 900))
+        self.assertIsNone(retry_delay(1, 901))
+
+    def test_zero_delay_and_zero_budget(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_retry_after_is_a_floor_beyond_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=10, cap_ms=5, retry_after_ms=50), 50
+        )
+        self.assertIsNone(
+            retry_delay(1, 950, budget_ms=1000, retry_after_ms=50)
+        )
+
+    def test_backoff_caps_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**101), 400)
+        self.assertEqual(
+            retry_delay(2, 0, max_attempts=3, base_ms=500, cap_ms=100), 100
+        )
+
+    def test_attempts_beyond_limit_are_exhausted(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
