 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
@@ -18,3 +19,291 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class SpecTestCase(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.base = Path(tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertRootUntouched(self, before):
+        self.assertEqual(sorted(p.relative_to(self.base) for p in self.base.rglob("*")), before)
+
+    def snapshot(self):
+        return sorted(p.relative_to(self.base) for p in self.base.rglob("*"))
+
+
+class BatchTypeTests(SpecTestCase):
+    def test_tuple_batch_rejected(self):
+        with self.assertRaises(ValueError):
+            extract((("a", b"x"),), self.root)
+
+    def test_empty_tuple_rejected(self):
+        with self.assertRaises(ValueError):
+            extract((), self.root)
+
+    def test_generator_not_consumed(self):
+        gen = ((n, b"x") for n in ["a", "b"])
+        with self.assertRaises(ValueError):
+            extract(gen, self.root)
+        self.assertEqual(next(gen), ("a", b"x"))
+
+    def test_iterator_rejected_and_untouched(self):
+        iterator = iter([("a", b"x")])
+        with self.assertRaises(ValueError):
+            extract(iterator, self.root)
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_empty_generator_rejected(self):
+        with self.assertRaises(ValueError):
+            extract((x for x in []), self.root)
+
+
+class EntryShapeTests(SpecTestCase):
+    def assertRejected(self, entries):
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertRootUntouched(before)
+
+    def test_list_entry_rejected(self):
+        self.assertRejected([["a", b"x"]])
+
+    def test_wrong_length_tuple_rejected(self):
+        self.assertRejected([("a", b"x", "extra")])
+        self.assertRejected([("a",)])
+
+    def test_non_string_name_rejected(self):
+        self.assertRejected([(b"a", b"x")])
+        self.assertRejected([(None, b"x")])
+
+    def test_non_bytes_data_rejected(self):
+        self.assertRejected([("a", "text")])
+        self.assertRejected([("a", bytearray(b"x"))])
+        self.assertRejected([("a", None)])
+
+
+class NameTests(SpecTestCase):
+    def assertNameRejected(self, name):
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            extract([(name, b"x")], self.root)
+        self.assertRootUntouched(before)
+
+    def test_empty_name_rejected(self):
+        self.assertNameRejected("")
+
+    def test_absolute_path_rejected(self):
+        self.assertNameRejected("/etc/passwd")
+        self.assertNameRejected("/tmp/x")
+
+    def test_backslash_rejected(self):
+        self.assertNameRejected("a\\b")
+        self.assertNameRejected("..\\evil")
+
+    def test_colon_and_drive_letter_rejected(self):
+        self.assertNameRejected("a:b")
+        self.assertNameRejected("C:/x")
+        self.assertNameRejected("C:evil")
+
+    def test_nul_rejected(self):
+        self.assertNameRejected("a\0b")
+
+    def test_unencodable_name_rejected_before_any_write(self):
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            extract([("ok.txt", b"1"), ("\ud800x", b"2")], self.root)
+        self.assertRootUntouched(before)
+
+    def test_empty_component_rejected(self):
+        self.assertNameRejected("a//b")
+        self.assertNameRejected("a/")
+        self.assertNameRejected("/")
+
+    def test_dot_components_rejected(self):
+        self.assertNameRejected(".")
+        self.assertNameRejected("..")
+        self.assertNameRejected("./a")
+        self.assertNameRejected("a/./b")
+        self.assertNameRejected("a/../b")
+        self.assertNameRejected("a/..")
+
+    def test_percent_and_dotted_names_are_legal_and_unchanged(self):
+        names = ["100%.txt", "...", ".hidden", "a b", "naïve/ü.txt", "a%2Fb"]
+        returned = extract([(n, b"x") for n in names], self.root)
+        self.assertEqual(returned, names)
+        self.assertEqual((self.root / "a%2Fb").read_bytes(), b"x")
+        self.assertEqual((self.root / "100%.txt").read_bytes(), b"x")
+
+
+class BatchConflictTests(SpecTestCase):
+    def assertConflict(self, names):
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            extract([(n, b"x") for n in names], self.root)
+        self.assertRootUntouched(before)
+
+    def test_duplicate_names_rejected(self):
+        self.assertConflict(["a", "a"])
+
+    def test_file_then_directory_rejected(self):
+        self.assertConflict(["a", "a/b"])
+
+    def test_directory_then_file_rejected(self):
+        self.assertConflict(["a/b", "a"])
+
+    def test_deep_collision_rejected(self):
+        self.assertConflict(["a/b/c", "a/b"])
+
+    def test_sibling_names_are_not_conflicts(self):
+        names = ["a/b", "a/c", "ab"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
+
+
+class RootTests(SpecTestCase):
+    def test_string_root_accepted(self):
+        self.assertEqual(extract([("a", b"x")], str(self.root)), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"x")
+
+    def test_missing_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], self.base / "missing")
+
+    def test_file_root_rejected(self):
+        target = self.base / "file"
+        target.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], target)
+
+    def test_symlink_root_rejected_even_for_empty_batch(self):
+        link = self.base / "link"
+        link.symlink_to(self.root, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([], link)
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], link)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_dangling_symlink_root_rejected(self):
+        link = self.base / "dangling"
+        link.symlink_to(self.base / "nowhere")
+        with self.assertRaises(ValueError):
+            extract([], link)
+
+    def test_empty_string_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], "")
+
+    def test_non_path_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], None)
+        with self.assertRaises(ValueError):
+            extract([], 3)
+
+    def test_empty_batch_validates_root(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+
+class OnDiskConflictTests(SpecTestCase):
+    def assertOnDiskConflict(self, name):
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            extract([("ok.txt", b"x"), (name, b"y")], self.root)
+        self.assertRootUntouched(before)
+
+    def test_existing_file_not_overwritten(self):
+        (self.root / "a").write_bytes(b"keep")
+        self.assertOnDiskConflict("a")
+        self.assertEqual((self.root / "a").read_bytes(), b"keep")
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "d").mkdir()
+        self.assertOnDiskConflict("d")
+
+    def test_ancestor_is_file_rejected(self):
+        (self.root / "a").write_bytes(b"keep")
+        self.assertOnDiskConflict("a/b")
+
+    def test_existing_symlink_target_not_followed(self):
+        outside = self.base / "outside.txt"
+        outside.write_bytes(b"outside")
+        (self.root / "link").symlink_to(outside)
+        self.assertOnDiskConflict("link")
+        self.assertEqual(outside.read_bytes(), b"outside")
+
+    def test_dangling_symlink_target_rejected(self):
+        (self.root / "link").symlink_to(self.base / "nowhere")
+        self.assertOnDiskConflict("link")
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_symlink_ancestor_inside_root_rejected(self):
+        real = self.root / "real"
+        real.mkdir()
+        (self.root / "via").symlink_to(real, target_is_directory=True)
+        self.assertOnDiskConflict("via/file")
+        self.assertEqual(list(real.iterdir()), [])
+
+    def test_symlink_ancestor_outside_root_rejected(self):
+        outside = self.base / "outside"
+        outside.mkdir()
+        (self.root / "via").symlink_to(outside, target_is_directory=True)
+        self.assertOnDiskConflict("via/file")
+        self.assertEqual(list(outside.iterdir()), [])
+
+    def test_dangling_symlink_ancestor_rejected(self):
+        (self.root / "via").symlink_to(self.base / "nowhere")
+        self.assertOnDiskConflict("via/file")
+        self.assertFalse((self.base / "nowhere").exists())
+
+
+class SuccessTests(SpecTestCase):
+    def test_existing_directories_are_reused(self):
+        (self.root / "docs").mkdir()
+        self.assertEqual(extract([("docs/a.txt", b"1")], self.root), ["docs/a.txt"])
+        self.assertEqual((self.root / "docs/a.txt").read_bytes(), b"1")
+
+    def test_missing_parents_created(self):
+        extract([("x/y/z/file", b"deep")], self.root)
+        self.assertEqual((self.root / "x/y/z/file").read_bytes(), b"deep")
+
+    def test_exact_binary_bytes_written(self):
+        data = bytes(range(256))
+        extract([("bin", data)], self.root)
+        self.assertEqual((self.root / "bin").read_bytes(), data)
+
+    def test_empty_file_created(self):
+        extract([("empty", b"")], self.root)
+        self.assertEqual((self.root / "empty").read_bytes(), b"")
+
+    def test_names_returned_in_input_order(self):
+        names = ["z", "m/a", "a"]
+        self.assertEqual(extract([(n, b"") for n in names], self.root), names)
+
+    def test_failed_batch_leaves_no_partial_files(self):
+        before = self.snapshot()
+        entries = [("ok/one", b"1"), ("ok/two", b"2"), ("bad\\three", b"3")]
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertRootUntouched(before)
+
+
+class IoErrorTests(SpecTestCase):
+    def test_validation_io_error_propagates_before_write(self):
+        (self.root / "ok").mkdir()
+        before = self.snapshot()
+        with mock.patch("safe_extract.os.lstat", side_effect=PermissionError("denied")):
+            with self.assertRaises(PermissionError):
+                extract([("ok/a", b"1")], self.root)
+        self.assertRootUntouched(before)
+
+    def test_unexpected_io_error_propagates(self):
+        with mock.patch("safe_extract.open", side_effect=OSError("disk full"), create=True):
+            with self.assertRaises(OSError):
+                extract([("a", b"x")], self.root)
