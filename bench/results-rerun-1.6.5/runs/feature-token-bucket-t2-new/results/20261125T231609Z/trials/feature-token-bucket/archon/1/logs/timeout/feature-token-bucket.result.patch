 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _check_rate_params(capacity, refill_per_sec):
+    if not 0 < capacity < math.inf:
+        raise ValueError(f"capacity must be a finite number > 0, got {capacity!r}")
+    if not 0 < refill_per_sec < math.inf:
+        raise ValueError(f"refill_per_sec must be a finite number > 0, got {refill_per_sec!r}")
+
+
+def _check_request(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must satisfy 0 < n <= capacity ({capacity!r}), got {n!r}")
+
+
+def _read_clock(clock):
+    now = clock()
+    if not math.isfinite(now):
+        raise ValueError(f"clock must return a finite float, got {now!r}")
+    return now
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate_params(capacity, refill_per_sec)
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = _read_clock(clock)
+
+    def _tokens_at(self, now):
+        # Every answer about the future goes through this one formula, so wait_time agrees with try_acquire exactly.
+        # A clock that goes backwards adds nothing: tokens are only accrued past self._last.
+        if now <= self._last:
+            return self._tokens
+        elapsed = now - self._last
+        return min(self._capacity, self._tokens + elapsed * self._refill_per_sec)
+
+    def _refill(self, now):
+        self._tokens = self._tokens_at(now)
+        if now > self._last:
+            self._last = now
+        assert 0 <= self._tokens <= self._capacity
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill(_read_clock(self._clock))
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        assert self._tokens >= 0
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill(_read_clock(self._clock))
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        now = _read_clock(self._clock)
+        self._refill(now)
+        if self._tokens >= n:
+            return 0.0
+        wait = max(0.0, self._last - now) + (n - self._tokens) / self._refill_per_sec
+        # Float rounding can leave the estimate a few ulps short: step until the same check passes.
+        while self._tokens_at(now + wait) < n:
+            wait = max(math.nextafter(wait, math.inf), wait + math.ulp(now))
+        assert self._tokens_at(now + wait) >= n
+        return wait
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate_params(capacity, refill_per_sec)
+        if not isinstance(max_keys, int) or max_keys < 1:
+            raise ValueError(f"max_keys must be an int >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
