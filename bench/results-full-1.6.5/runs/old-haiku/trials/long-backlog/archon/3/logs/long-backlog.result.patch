@@ -0,0 +1,106 @@
+"""Tests for TaskStore.undo (TT-104)."""
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        returned = store.undo()
+        self.assertEqual(returned.id, task.id)
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_complete_of_already_done_task_keeps_it_done(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work", "q3"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = (task.id, task.title, list(task.tags), task.status, task.due)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertIs(restored, task)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status, restored.due), before)
+
+    def test_undo_walks_back_lifo_across_mixed_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.add("c")
+        store.undo()  # removes c
+        self.assertEqual([t.title for t in store.all()], ["a"])
+        store.undo()  # restores b
+        self.assertEqual([t.title for t in store.all()], ["a", "b"])
+        store.undo()  # reopens a
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()  # removes b
+        self.assertEqual([t.title for t in store.all()], ["a"])
+        store.undo()  # removes a
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_with_nothing_recorded_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("write report")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("write report")
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
