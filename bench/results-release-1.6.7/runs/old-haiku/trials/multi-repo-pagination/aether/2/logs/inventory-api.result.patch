+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_DIGITS = re.compile(r"[0-9]+")
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +28,50 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = DEFAULT_LIMIT
+    if "limit" in query:
+        limit = _parse_limit(query["limit"])
+        if limit is None:
+            return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after = None
+    if "cursor" in query:
+        after = _decode_cursor(query["cursor"])
+        if after is None:
+            return _error(400, "invalid cursor")
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after is None or item["id"] > after
+    ]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    assert len(page) <= limit
+    assert next_cursor is None or page
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if not isinstance(raw, str) or not _DIGITS.fullmatch(raw):
+        return None
+    limit = int(raw)
+    return limit if 1 <= limit <= MAX_LIMIT else None
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    """Return the item id a cursor points after, or None if it is not ours."""
+    if not isinstance(raw, str):
+        return None
+    try:
+        text = base64.urlsafe_b64decode(raw.encode("ascii")).decode("ascii")
+    except ValueError:
+        return None
+    if not _DIGITS.fullmatch(text):
+        return None
+    return int(text)
 
 
