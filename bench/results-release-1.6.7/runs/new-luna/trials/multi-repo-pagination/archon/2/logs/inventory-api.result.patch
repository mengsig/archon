@@ -22,7 +27,59 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    if isinstance(raw_limit, int) and not isinstance(raw_limit, bool):
+        if not 1 <= raw_limit <= 100:
+            return _error(400, "limit must be an integer from 1 through 100")
+        limit = raw_limit
+    elif isinstance(raw_limit, str):
+        if not re.fullmatch(r"[0-9]+", raw_limit):
+            return _error(400, "limit must be an integer from 1 through 100")
+        significant_digits = raw_limit.lstrip("0") or "0"
+        if len(significant_digits) > 3:
+            return _error(400, "limit must be an integer from 1 through 100")
+        limit = int(significant_digits)
+    else:
+        return _error(400, "limit must be an integer from 1 through 100")
+    if not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer from 1 through 100")
+
+    cursor = query.get("cursor")
+    if cursor is None:
+        start = 0
+    else:
+        last_id = _decode_cursor(cursor)
+        if last_id is None:
+            return _error(400, "invalid cursor")
+        positions = [index for index, item in enumerate(items) if item["id"] == last_id]
+        if not positions:
+            return _error(400, "invalid cursor")
+        start = positions[0] + 1
+
+    page = items[start:start + limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if start + limit < len(items) and page else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(last_id):
+    payload = json.dumps({"v": 1, "id": last_id}, separators=(",", ":")).encode("ascii")
+    return base64.urlsafe_b64encode(payload).decode("ascii").rstrip("=")
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", cursor):
+        return None
+    try:
+        encoded = cursor.encode("ascii")
+        payload = base64.b64decode(encoded + b"=" * (-len(encoded) % 4), altchars=b"-_", validate=True)
+        data = json.loads(payload.decode("ascii"))
+    except (UnicodeError, ValueError, binascii.Error, RecursionError):
+        return None
+    if (not isinstance(data, dict) or set(data) != {"v", "id"}
+            or type(data["v"]) is not int or data["v"] != 1
+            or type(data["id"]) is not int or data["id"] < 1):
+        return None
+    return data["id"]
 
 
