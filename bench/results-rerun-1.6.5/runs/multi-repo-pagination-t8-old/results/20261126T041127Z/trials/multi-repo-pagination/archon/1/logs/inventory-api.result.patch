diff --git a/test_api.py b/test_api.py
index 55cd1fd..69a0ddf 100644
--- a/test_api.py
+++ b/test_api.py
@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,58 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size(self):
+        res = get("/items")
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_paging_through_all_items_with_cursors(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            ids += [item["id"] for item in body["items"]]
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        first = get("/items", limit="30")["body"]
+        res = get("/items", limit="30", cursor=first["next_cursor"])
+        self.assertEqual(len(res["body"]["items"]), 27)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_limit_one_returns_one_item(self):
+        body = get("/items", limit="1")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], [1])
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_limit_at_maximum_returns_everything_in_one_page(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_invalid_limit_is_bad_request(self):
+        for limit in ["0", "101", "-1", "+5", "abc", "", "2.5", "1_0", "9" * 5000]:
+            with self.subTest(limit=limit):
+                self.assert_bad_request(get("/items", limit=limit))
+
+    def test_invalid_cursor_is_bad_request(self):
+        oversized = base64.urlsafe_b64encode(b"9" * 5000).decode("ascii")
+        for cursor in ["!!!", "abc", "bm90IGEgbnVtYmVy", "", "LTU=", oversized]:
+            with self.subTest(cursor=cursor):
+                self.assert_bad_request(get("/items", cursor=cursor))
+
+    def test_non_string_query_values_are_bad_request(self):
+        self.assert_bad_request(handle({"method": "GET", "path": "/items", "query": {"limit": 5}}))
+        self.assert_bad_request(handle({"method": "GET", "path": "/items", "query": {"cursor": 5}}))
+
+    def assert_bad_request(self, res):
+        self.assertEqual(res["status"], 400)
+        self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
