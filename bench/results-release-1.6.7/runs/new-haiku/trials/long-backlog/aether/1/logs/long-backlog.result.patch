@@ -0,0 +1,69 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_lines_end_with_crlf(self):
+        store = TaskStore()
+        store.add("one")
+        store.add("two", tags=["x"], due=date(2026, 4, 1))
+        self.assertEqual(
+            to_csv(store.all()),
+            HEADER + "1,one,,open,\r\n" + "2,two,x,open,2026-04-01\r\n",
+        )
+
+    def test_title_with_comma_is_quoted(self):
+        store = TaskStore()
+        store.add("buy eggs, milk")
+        self.assertIn('1,"buy eggs, milk",,open,\r\n', to_csv(store.all()))
+
+    def test_embedded_quotes_are_doubled(self):
+        store = TaskStore()
+        store.add('say "hi"')
+        self.assertIn('1,"say ""hi""",,open,\r\n', to_csv(store.all()))
+
+    def test_cr_and_lf_are_quoted(self):
+        store = TaskStore()
+        store.add("line one\nline two")
+        store.add("carriage\rreturn")
+        output = to_csv(store.all())
+        self.assertIn('1,"line one\nline two",,open,\r\n', output)
+        self.assertIn('2,"carriage\rreturn",,open,\r\n', output)
+
+    def test_tags_containing_comma_are_quoted(self):
+        store = TaskStore()
+        store.add("t", tags=["a,b", "c"])
+        self.assertIn('1,t,"a,b;c",open,\r\n', to_csv(store.all()))
+
+    def test_plain_fields_are_not_quoted(self):
+        store = TaskStore()
+        store.add("semi;colon and spaces", tags=["a", "b"])
+        self.assertIn("1,semi;colon and spaces,a;b,open,\r\n", to_csv(store.all()))
+
+    def test_output_round_trips_through_csv_reader(self):
+        store = TaskStore()
+        store.add('tricky, "quoted"\nmultiline', tags=["x,y"], due=date(2026, 5, 2))
+        rows = list(csv.reader(io.StringIO(to_csv(store.all()), newline="")))
+        self.assertEqual(rows[0], ["id", "title", "tags", "status", "due"])
+        self.assertEqual(rows[1], ["1", 'tricky, "quoted"\nmultiline', "x,y", "open", "2026-05-02"])
+
+    def test_rows_keep_input_order(self):
+        store = TaskStore()
+        first = store.add("first")
+        second = store.add("second")
+        lines = to_csv([second, first]).splitlines()
+        self.assertEqual([line.split(",")[1] for line in lines[1:]], ["second", "first"])
+
+
+if __name__ == "__main__":
+    unittest.main()
