+import os
+import stat
 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
@@ -18,3 +21,265 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+def tree_state(base):
+    """Snapshot every entry under base as (relpath, file type, content or link target)."""
+    state = []
+    for dirpath, dirnames, filenames in os.walk(base):
+        for name in dirnames + filenames:
+            full = os.path.join(dirpath, name)
+            entry_stat = os.lstat(full)
+            if stat.S_ISLNK(entry_stat.st_mode):
+                content = os.readlink(full)
+            elif stat.S_ISREG(entry_stat.st_mode):
+                content = Path(full).read_bytes()
+            else:
+                content = None
+            state.append((os.path.relpath(full, base), stat.S_IFMT(entry_stat.st_mode), content))
+    return sorted(state)
+
+
+_DEFAULT_ROOT = object()
+
+
+class ExtractCase(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assert_rejected_without_change(self, batch, root=_DEFAULT_ROOT):
+        before = tree_state(self.base)
+        with self.assertRaises(ValueError):
+            extract(batch, self.root if root is _DEFAULT_ROOT else root)
+        self.assertEqual(tree_state(self.base), before)
+
+
+class NonListBatches(ExtractCase):
+    def test_rejects_non_list_batches_without_consuming_them(self):
+        entries = [("a", b"1")]
+        iterator = iter(entries)
+        generator = (entry for entry in entries)
+        for batch in (tuple(entries), iterator, generator, (), None, "a"):
+            with self.subTest(batch=type(batch).__name__):
+                self.assert_rejected_without_change(batch)
+        self.assertEqual(next(iterator), ("a", b"1"))
+        self.assertEqual(next(generator), ("a", b"1"))
+
+    def test_rejects_empty_iterator_and_tuple(self):
+        self.assert_rejected_without_change(iter([]))
+        self.assert_rejected_without_change(())
+
+
+class RootRules(ExtractCase):
+    def test_str_root_is_accepted(self):
+        self.assertEqual(extract([("f", b"1")], str(self.root)), ["f"])
+        self.assertEqual((self.root / "f").read_bytes(), b"1")
+
+    def test_missing_root_is_rejected_even_for_empty_batch(self):
+        self.assert_rejected_without_change([], self.base / "missing")
+        self.assert_rejected_without_change([("f", b"1")], self.base / "missing")
+
+    def test_root_that_is_a_file_is_rejected(self):
+        regular = self.base / "file"
+        regular.write_bytes(b"x")
+        self.assert_rejected_without_change([("f", b"1")], regular)
+
+    def test_root_below_a_file_is_rejected(self):
+        regular = self.base / "file"
+        regular.write_bytes(b"x")
+        self.assert_rejected_without_change([("f", b"1")], regular / "root")
+
+    def test_symlink_root_is_rejected_and_target_untouched(self):
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        self.assert_rejected_without_change([("f", b"1")], link)
+
+    def test_empty_root_is_rejected_without_using_cwd(self):
+        self.assert_rejected_without_change([("f", b"1")], "")
+
+    def test_root_spelled_through_symlink_with_dotdot_is_rejected(self):
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        self.assert_rejected_without_change([("f", b"1")], f"{link}/..")
+        self.assert_rejected_without_change([("f", b"1")], f"{link}/x/../..")
+
+    def test_invalid_root_types_are_rejected(self):
+        for root in (5, None, b"bytes-root"):
+            with self.subTest(root=root):
+                self.assert_rejected_without_change([("f", b"1")], root)
+
+
+class MalformedEntries(ExtractCase):
+    def test_non_tuple_or_wrong_length_entries_are_rejected(self):
+        bad_entries = [["a", b"x"], ("a",), ("a", b"x", 1), "ab", None]
+        for bad in bad_entries:
+            with self.subTest(entry=bad):
+                self.assert_rejected_without_change([("ok", b"1"), bad])
+
+    def test_non_string_names_are_rejected(self):
+        for bad_name in (b"a", None, 1):
+            with self.subTest(name=bad_name):
+                self.assert_rejected_without_change([("ok", b"1"), (bad_name, b"x")])
+
+    def test_non_bytes_data_is_rejected(self):
+        bad_data = ["text", None, bytearray(b"x"), memoryview(b"x")]
+        for data in bad_data:
+            with self.subTest(data=type(data).__name__):
+                self.assert_rejected_without_change([("ok", b"1"), ("bad", data)])
+
+
+class NameRules(ExtractCase):
+    def test_invalid_names_are_rejected_before_any_write(self):
+        bad_names = [
+            "", "/abs", "a\\b", "C:x", "a:b", "a\0b", "a//b", "a/", "./a",
+            "a/./b", "a/../b", "..", ".", "a/..", "/", "\udcff",
+        ]
+        for bad_name in bad_names:
+            with self.subTest(name=bad_name):
+                self.assert_rejected_without_change([("ok", b"1"), (bad_name, b"x")])
+
+    def test_legal_names_are_kept_literally(self):
+        names = [".hidden", "a..b", "a.b/c", "a%20b", "dir/..x", "100%", "ünï/f"]
+        self.assertEqual(extract([(name, b"v") for name in names], self.root), names)
+        self.assertTrue((self.root / "a%20b").is_file())
+        self.assertFalse((self.root / "a b").exists())
+
+
+class BatchCollisions(ExtractCase):
+    def test_duplicate_names_are_rejected(self):
+        self.assert_rejected_without_change([("a", b"1"), ("a", b"2")])
+
+    def test_file_directory_collisions_are_rejected_in_either_order(self):
+        cases = [
+            [("a", b""), ("a/b", b"")],
+            [("a/b", b""), ("a", b"")],
+            [("a/b/c", b""), ("a/b", b"")],
+            [("a/b", b""), ("a/b/c", b"")],
+        ]
+        for batch in cases:
+            with self.subTest(batch=[name for name, _ in batch]):
+                self.assert_rejected_without_change(batch)
+
+    def test_similar_names_do_not_collide(self):
+        batch = [("a/b", b"1"), ("a/c", b"2"), ("a.b", b"3"), ("ab", b"4")]
+        self.assertEqual(extract(batch, self.root), ["a/b", "a/c", "a.b", "ab"])
+
+
+class ExistingTargets(ExtractCase):
+    def test_existing_file_is_never_overwritten(self):
+        target = self.root / "f"
+        target.write_bytes(b"original")
+        self.assert_rejected_without_change([("f", b"new")])
+        self.assertEqual(target.read_bytes(), b"original")
+
+    def test_existing_directory_target_is_rejected(self):
+        (self.root / "docs").mkdir()
+        self.assert_rejected_without_change([("docs", b"x")])
+
+    def test_file_as_ancestor_is_rejected(self):
+        (self.root / "docs").write_bytes(b"file")
+        self.assert_rejected_without_change([("docs/a", b"x")])
+        self.assert_rejected_without_change([("docs/x/y", b"x")])
+
+    def test_existing_directory_ancestor_is_reused(self):
+        (self.root / "docs").mkdir()
+        (self.root / "docs" / "keep").write_bytes(b"k")
+        self.assertEqual(extract([("docs/new", b"n")], self.root), ["docs/new"])
+        self.assertEqual((self.root / "docs" / "keep").read_bytes(), b"k")
+        self.assertEqual((self.root / "docs" / "new").read_bytes(), b"n")
