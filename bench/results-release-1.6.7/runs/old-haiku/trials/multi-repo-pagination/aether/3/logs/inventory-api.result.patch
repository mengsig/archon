 elsewhere.
 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_LIMIT = re.compile(r"[0-9]{1,3}")
+_DIGITS = re.compile(r"[0-9]+")
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +29,56 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after_id = None
+    if "cursor" in query:
+        after_id = _decode_cursor(query["cursor"])
+        if after_id is None:
+            return _error(400, "cursor is invalid")
+    remaining = _items_after(after_id)
+    page = remaining[:limit]
+    next_cursor = None
+    if len(remaining) > limit:
+        next_cursor = _encode_cursor(page[-1]["id"])
+    assert next_cursor is None or len(page) == limit
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _items_after(after_id):
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    if after_id is None:
+        return ordered
+    return [item for item in ordered if item["id"] > after_id]
+
+
+def _parse_limit(raw):
+    """Return the page size, or None when `raw` is not an integer in range."""
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not isinstance(raw, str) or not _LIMIT.fullmatch(raw):
+        return None
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(item_id):
+    assert item_id >= 0
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    """Return the id the cursor points after, or None when it is malformed."""
+    if not isinstance(raw, str):
+        return None
+    try:
+        text = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+        return int(text) if _DIGITS.fullmatch(text) else None
+    except ValueError:
+        return None
 
 
