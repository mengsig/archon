@@ -0,0 +1,78 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login page", tags=["Work"])
+    store.add("fix the login", tags=["home"])
+    store.add("buy milk", tags=["work", "home"])
+    store.complete(2)
+    return store
+
+
+def _titles(query):
+    return [t.title for t in search(_store().all(), query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_all_in_input_order(self):
+        self.assertEqual(_titles(""), ["Fix login page", "fix the login", "buy milk"])
+        self.assertEqual(_titles("   \t "), ["Fix login page", "fix the login", "buy milk"])
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(_titles("LOGIN"), ["Fix login page", "fix the login"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_titles('"fix login"'), ["Fix login page"])
+        self.assertEqual(_titles('"login page"'), ["Fix login page"])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(_titles("fix login"), ["Fix login page", "fix the login"])
+        self.assertEqual(_titles("fix page"), ["Fix login page"])
+        self.assertEqual(_titles("fix milk"), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(_titles("tag:work"), ["Fix login page", "buy milk"])
+        self.assertEqual(_titles("tag:WORK"), ["Fix login page", "buy milk"])
+
+    def test_tag_does_not_match_substring(self):
+        self.assertEqual(_titles("tag:wor"), [])
+
+    def test_status_filters(self):
+        self.assertEqual(_titles("status:open"), ["Fix login page", "buy milk"])
+        self.assertEqual(_titles("status:done"), ["fix the login"])
+
+    def test_status_value_is_case_insensitive(self):
+        self.assertEqual(_titles("status:DONE"), ["fix the login"])
+
+    def test_field_terms_combine_with_words(self):
+        self.assertEqual(_titles("tag:home status:open"), ["buy milk"])
+
+    def test_quoted_field_like_text_is_a_title_phrase(self):
+        store = TaskStore()
+        store.add("status:done is a label")
+        self.assertEqual([t.title for t in search(store.all(), '"status:done"')],
+                         ["status:done is a label"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "status:archived")
+
+    def test_empty_tag_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), '"fix login')
+
+
+if __name__ == "__main__":
+    unittest.main()
