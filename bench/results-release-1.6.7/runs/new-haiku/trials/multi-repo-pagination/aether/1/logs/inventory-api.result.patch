+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,50 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit", str(DEFAULT_LIMIT)))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after = None
+    if "cursor" in query:
+        after = _decode_cursor(query["cursor"])
+        if after is None:
+            return _error(400, "cursor is invalid")
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after is None or item["id"] > after
+    ]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if not re.fullmatch(r"[0-9]+", raw):
+        return None
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(cursor):
+    """Return the id a cursor points after, or None if it is not a cursor we issued."""
+    try:
+        text = base64.urlsafe_b64decode(cursor.encode("ascii")).decode("ascii")
+        if not re.fullmatch(r"[0-9]+", text):
+            return None
+        item_id = int(text)
+    except ValueError:
+        return None
+    if _encode_cursor(item_id) != cursor:
+        return None
+    return item_id
 
 
