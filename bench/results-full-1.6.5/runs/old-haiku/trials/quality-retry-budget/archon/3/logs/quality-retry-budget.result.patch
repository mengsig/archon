diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..e65965e 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,41 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # Once 2**shift exceeds cap_ms, or base_ms alone reaches cap_ms, the result is cap_ms.
+    if shift >= cap_ms.bit_length() or base_ms >= cap_ms:
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..232fd9d 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,141 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        for bad in (True, False, 1.0, 2.5, "1", None):
+            with self.subTest(value=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(bad, 0)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, bad)
+        for bad in (True, False, 1.0, 2.5, "1"):
+            with self.subTest(retry_after=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, retry_after_ms=bad)
+
+    def test_rejects_bad_keyword_types(self):
+        bad_calls = [
+            {"max_attempts": True},
+            {"max_attempts": 4.0},
+            {"budget_ms": 1.0},
+            {"base_ms": True},
+            {"cap_ms": 400.0},
+        ]
+        for kwargs in bad_calls:
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, **kwargs)
+
+    def test_rejects_below_minimum(self):
+        bad_calls = [
+            (0, 0, {}),
+            (-1, 0, {}),
+            (1, -1, {}),
+            (1, 0, {"max_attempts": 0}),
+            (1, 0, {"budget_ms": -1}),
+            (1, 0, {"base_ms": -1}),
+            (1, 0, {"cap_ms": -1}),
+            (1, 0, {"retry_after_ms": -1}),
+        ]
+        for attempt, elapsed, kwargs in bad_calls:
+            with self.subTest(attempt=attempt, elapsed=elapsed, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(attempt, elapsed, **kwargs)
+
+    def test_validation_precedes_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(9, 0, max_attempts=4, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=1000, retry_after_ms=-3)
+
+    def test_zero_elapsed_and_zero_retry_after_are_valid(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class RetryAttemptLimit(unittest.TestCase):
+    def test_last_allowed_attempt_returns_delay(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_is_legal_and_returns_none(self):
+        self.assertIsNone(retry_delay(10**30, 0, max_attempts=4))
+
+    def test_single_attempt_budget_never_retries(self):
+        self.assertIsNone(retry_delay(1, 0, max_attempts=1, retry_after_ms=0))
+
+
+class RetryBackoff(unittest.TestCase):
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_backoff_capped(self):
+        self.assertEqual(retry_delay(10, 0, max_attempts=20, cap_ms=400), 400)
+
+    def test_base_above_cap_returns_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_doubling_reaches_cap_exactly(self):
+        delays = [retry_delay(n, 0, max_attempts=50, budget_ms=10**9,
+                              base_ms=1, cap_ms=1000)
+                  for n in range(1, 12)]
+        self.assertEqual(delays, [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1000])
+
+    def test_huge_attempt_does_not_allocate_power_of_two(self):
+        delay = retry_delay(10**18, 0, max_attempts=10**19, budget_ms=10**40,
+                            base_ms=1, cap_ms=400)
+        self.assertEqual(delay, 400)
+
+    def test_huge_base_saturates_to_cap(self):
+        delay = retry_delay(1, 0, base_ms=10**400, cap_ms=5)
+        self.assertEqual(delay, 5)
+
+    def test_huge_cap_is_not_clamped_early(self):
+        cap = 10**30
+        delay = retry_delay(100, 0, max_attempts=200, budget_ms=10**40,
+                            base_ms=1, cap_ms=cap)
+        self.assertEqual(delay, 2**99)
+
+
+class RetryAfterFloor(unittest.TestCase):
+    def test_retry_after_floor_ignores_cap(self):
+        delay = retry_delay(1, 0, budget_ms=10000, cap_ms=400,
+                            retry_after_ms=5000)
+        self.assertEqual(delay, 5000)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+    def test_retry_after_beyond_budget_is_not_shortened(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=1000, retry_after_ms=1000))
+
+
+class RetryBudget(unittest.TestCase):
+    def test_delay_ending_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_one_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_budget_refuses_every_retry(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_zero_delay_allowed_when_elapsed_below_budget(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=1, base_ms=0), 0)
+
+    def test_zero_delay_refused_when_elapsed_at_budget(self):
+        self.assertIsNone(retry_delay(1, 1, budget_ms=1, base_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
