+class LedgerConstruction(unittest.TestCase):
+    def test_empty_ledger_allowed(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_boundary_balances_allowed(self):
+        ledger = Ledger({"a": 0, "b": MAX_BALANCE})
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+    def test_non_dict_rejected(self):
+        for bad in [None, [("a", 1)], "a", 3]:
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    Ledger(bad)
+
+    def test_invalid_names_rejected(self):
+        for bad in ["", None, 1, b"a"]:
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    Ledger({bad: 1})
+
+    def test_invalid_balances_rejected(self):
+        for bad in [-1, MAX_BALANCE + 1, 1.0, "1", None, True, False]:
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    Ledger({"a": bad})
+
+    def test_input_dict_is_copied(self):
+        source = {"a": 5, "b": 0}
