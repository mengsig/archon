+class EdgeCaseTest(unittest.TestCase):
+    def test_constructor_and_request_validation(self):
+        for capacity, rate in ((0, 1), (-1, 1), (1, 0), (1, -1)):
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate)
+        bucket = TokenBucket(2, 1, clock=FakeClock())
+        for amount in (0, -1, 3):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(amount)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(amount)
+        self.assertEqual(bucket.available(), 2)
+
+    def test_fractional_refill_and_wait_do_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 0.25
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(1), 0.25)
+        self.assertEqual(bucket.available(), 0.5)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_refill_is_capped_and_clock_rollback_is_ignored(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1
+        self.assertEqual(bucket.available(), 1)
+        clock.now = 0.5
+        self.assertEqual(bucket.available(), 1)
+        clock.now = 2
+        self.assertEqual(bucket.available(), 2)
+        clock.now = 10
+        self.assertEqual(bucket.available(), 2)
+
+    def test_wait_time_for_key_counts_as_use_and_lru_evicts(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1, max_keys=2, clock=clock)
+        self.assertEqual(limiter.wait_time("a"), 0)
+        self.assertTrue(limiter.try_acquire("b"))
+        limiter.wait_time("a")  # Refresh a, making b least recently used.
+        self.assertEqual(limiter.wait_time("c"), 0)
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # Evicted b starts full.
+
+    def test_keyed_validation(self):
+        for args in ((1, 1, 0), (0, 1, 1), (1, 0, 1)):
+            with self.subTest(args=args):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(*args)
+        limiter = KeyedLimiter(1, 1, max_keys=1, clock=FakeClock())
+        for amount in (0, -1, 2):
+            with self.assertRaises(ValueError):
+                limiter.wait_time("a", amount)
+        self.assertEqual(len(limiter), 0)
+
+
 if __name__ == "__main__":
     unittest.main()
