+class SandboxCase(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertRootEmpty(self):
+        self.assertEqual(list(self.root.iterdir()), [])
+
+
+class RootValidation(SandboxCase):
+    def test_string_root_accepted(self):
+        self.assertEqual(extract([("a", b"x")], str(self.root)), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"x")
+
+    def test_missing_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+    def test_file_root_rejected(self):
+        regular = self.base / "file"
+        regular.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], regular)
+
+    def test_root_through_regular_file_rejected(self):
+        regular = self.base / "file"
+        regular.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], regular / "sub")
+
+    def test_dangling_symlink_root_rejected(self):
+        link = self.base / "dangling"
+        link.symlink_to(self.base / "nowhere")
+        with self.assertRaises(ValueError):
+            extract([], link)
+
+    def test_symlink_root_rejected(self):
+        link = self.base / "link"
+        link.symlink_to(self.root, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], link)
+        self.assertRootEmpty()
+
+    def test_empty_string_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], "")
+
+    def test_invalid_root_types_rejected(self):
+        for root in (None, 3, b"bytes-root", ["list"]):
+            with self.subTest(root=root), self.assertRaises(ValueError):
+                extract([], root)
+
+    def test_empty_batch_still_validates_root(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+
+class BatchShape(SandboxCase):
+    def test_non_list_batches_rejected_without_consuming(self):
+        generator = (entry for entry in [("a", b"x")])
+        iterator = iter([("a", b"x")])
+        for batch in ((("a", b"x"),), iterator, generator, None, {}):
+            with self.subTest(batch=type(batch).__name__), self.assertRaises(ValueError):
+                extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertRootEmpty()
+
+    def test_empty_non_list_rejected(self):
+        with self.assertRaises(ValueError):
+            extract((), self.root)
+
+    def test_malformed_entries_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", "extra"),
+            (b"a", b"x"),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", None),
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry), self.assertRaises(ValueError):
+                extract([entry], self.root)
+        self.assertRootEmpty()
+
+    def test_empty_name_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("", b"x")], self.root)
+
+
+class NameValidation(SandboxCase):
+    def test_invalid_names_rejected(self):
+        bad_names = [
+            "/abs",
+            "a\\b",
+            "C:x",
+            "a:b",
+            "a\x00b",
+            "a/",
+            "a//b",
+            "./a",
+            "a/./b",
+            "a/../b",
+            "..",
+            ".",
+            "a/.",
+            "\ud800",
+        ]
+        for name in bad_names:
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                extract([("ok", b"x"), (name, b"y")], self.root)
+        self.assertRootEmpty()
+
+    def test_literal_percent_is_kept(self):
+        self.assertEqual(extract([("100%25", b"x")], self.root), ["100%25"])
+        self.assertEqual((self.root / "100%25").read_bytes(), b"x")
+
+    def test_names_returned_in_input_order(self):
+        names = ["z", "m/n", "a"]
+        self.assertEqual(extract([(name, b"") for name in names], self.root), names)
+
+
+class BatchCollisions(SandboxCase):
+    def test_duplicate_names_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a", b"2")], self.root)
+        self.assertRootEmpty()
+
+    def test_file_then_nested_collision_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a/b", b"2")], self.root)
+        self.assertRootEmpty()
+
+    def test_nested_then_file_collision_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a/b", b"2"), ("a", b"1")], self.root)
+        self.assertRootEmpty()
+
+    def test_shared_directory_prefix_is_not_a_collision(self):
+        self.assertEqual(extract([("a/b", b"1"), ("a/c", b"2")], self.root), ["a/b", "a/c"])
+        self.assertEqual((self.root / "a/c").read_bytes(), b"2")
+
+    def test_similar_prefix_is_not_a_collision(self):
+        self.assertEqual(extract([("a", b"1"), ("ab", b"2")], self.root), ["a", "ab"])
+
+
+class FilesystemConflicts(SandboxCase):
+    def test_existing_file_target_rejected_and_unchanged(self):
+        target = self.root / "a"
+        target.write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([("b", b"new"), ("a", b"over")], self.root)
+        self.assertEqual(target.read_bytes(), b"keep")
+        self.assertFalse((self.root / "b").exists())
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"x")], self.root)
+
+    def test_existing_intermediate_file_rejected(self):
+        (self.root / "a").write_bytes(b"file")
+        with self.assertRaises(ValueError):
+            extract([("a/b", b"x")], self.root)
+        self.assertEqual((self.root / "a").read_bytes(), b"file")
+
+    def test_existing_intermediate_directory_reused(self):
+        (self.root / "a").mkdir()
+        self.assertEqual(extract([("a/b", b"x")], self.root), ["a/b"])
+        self.assertEqual((self.root / "a/b").read_bytes(), b"x")
+
+    def test_symlink_target_rejected_and_outside_untouched(self):
+        outside = self.base / "outside.txt"
+        outside.write_bytes(b"outside")
+        (self.root / "link").symlink_to(outside)
+        with self.assertRaises(ValueError):
+            extract([("link", b"over")], self.root)
+        self.assertEqual(outside.read_bytes(), b"outside")
+
+    def test_dangling_symlink_target_rejected(self):
+        (self.root / "dangling").symlink_to(self.base / "nowhere")
+        with self.assertRaises(ValueError):
+            extract([("dangling", b"x")], self.root)
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_symlink_inside_root_target_rejected(self):
+        (self.root / "real.txt").write_bytes(b"real")
+        (self.root / "link").symlink_to(self.root / "real.txt")
+        with self.assertRaises(ValueError):
+            extract([("link", b"over")], self.root)
+        self.assertEqual((self.root / "real.txt").read_bytes(), b"real")
+
+    def test_symlink_intermediate_rejected_and_outside_untouched(self):
+        outside = self.base / "outside"
+        outside.mkdir()
+        (self.root / "dir").symlink_to(outside, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("dir/x", b"x")], self.root)
+        self.assertEqual(list(outside.iterdir()), [])
+
+    def test_symlink_intermediate_inside_root_rejected(self):
+        (self.root / "real").mkdir()
+        (self.root / "dir").symlink_to(self.root / "real", target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("dir/x", b"x")], self.root)
+        self.assertEqual(list((self.root / "real").iterdir()), [])
+
+    def test_dangling_symlink_intermediate_rejected(self):
+        (self.root / "dir").symlink_to(self.base / "nowhere")
+        with self.assertRaises(ValueError):
+            extract([("dir/x", b"x")], self.root)
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_conflict_later_in_batch_writes_nothing(self):
+        (self.root / "taken").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("ok", b"x"), ("taken", b"y")], self.root)
+        self.assertEqual(sorted(p.name for p in self.root.iterdir()), ["taken"])
+
+
+class SuccessfulWrites(SandboxCase):
+    def test_exact_bytes_including_nul_and_empty(self):
+        payload = bytes(range(256))
+        extract([("bin", payload), ("empty", b"")], self.root)
+        self.assertEqual((self.root / "bin").read_bytes(), payload)
+        self.assertEqual((self.root / "empty").stat().st_size, 0)
+
+    def test_missing_parent_directories_created(self):
+        extract([("x/y/z/file", b"deep")], self.root)
+        self.assertEqual((self.root / "x/y/z/file").read_bytes(), b"deep")
+
+    def test_empty_batch_returns_empty_list(self):
+        self.assertEqual(extract([], self.root), [])
+        self.assertRootEmpty()
+
+
