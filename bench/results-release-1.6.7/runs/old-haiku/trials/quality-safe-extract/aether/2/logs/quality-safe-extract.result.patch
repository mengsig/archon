+import os
 import tempfile
 import unittest
 from pathlib import Path
@@ -18,3 +19,253 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.base = Path(tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def snapshot(self, path):
+        found = []
+        for dirpath, dirnames, filenames in os.walk(path):
+            for name in dirnames + filenames:
+                found.append(os.path.relpath(os.path.join(dirpath, name), path))
+        return sorted(found)
+
+
+class ExtractBatchShape(TempRootCase):
+    def test_non_list_batches_rejected_and_nothing_written(self):
+        batches = [(("a", b""),), (), iter([("a", b"")]), None, "ab"]
+        for batch in batches:
+            with self.subTest(batch=batch):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+                self.assertEqual(self.snapshot(self.root), [])
+
+    def test_generator_rejected_without_being_consumed(self):
+        generator = ((name, data) for name, data in [("a", b"x")])
+        with self.assertRaises(ValueError):
+            extract(generator, self.root)
+        self.assertEqual(list(generator), [("a", b"x")])
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_malformed_entries_rejected(self):
+        entries = [["a", b""], ("a",), ("a", b"", 1), "ab", None]
+        for entry in entries:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([entry], self.root)
+                self.assertEqual(self.snapshot(self.root), [])
+
+    def test_non_string_names_rejected(self):
+        for name in [b"a", None, 1]:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([(name, b"")], self.root)
+
+    def test_non_bytes_data_rejected(self):
+        for data in ["text", None, bytearray(b"x")]:
+            with self.subTest(data=data):
+                with self.assertRaises(ValueError):
+                    extract([("a", data)], self.root)
+                self.assertEqual(self.snapshot(self.root), [])
+
+
+class ExtractNameRules(TempRootCase):
+    def test_invalid_names_rejected(self):
+        names = [
+            "", "/abs", "a\\b", "C:x", "a:b", "a\0b", "a//b", "a/", "./a",
+            "a/./b", "../a", "a/..", ".", "..", "a/.",
+        ]
+        for name in names:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([(name, b"x")], self.root)
+                self.assertEqual(self.snapshot(self.root), [])
+
+    def test_valid_names_are_used_literally(self):
+        names = ["100%25.txt", "a b/c..d", "...", "-x", "ünï/çode.txt"]
+        entries = [(name, b"1") for name in names]
+        self.assertEqual(extract(entries, self.root), names)
+        self.assertEqual((self.root / "100%25.txt").read_bytes(), b"1")
+
+    def test_unencodable_name_rejected_before_writing(self):
+        entries = [("first", b"1"), ("bad\ud800name", b"2")]
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+
+class ExtractBatchConflicts(TempRootCase):
+    def test_duplicate_names_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a", b"2")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_file_directory_collision_rejected_in_either_order(self):
+        batches = [
+            [("a", b""), ("a/b", b"")],
+            [("a/b", b""), ("a", b"")],
+            [("a/b", b""), ("a/b/c", b"")],
+        ]
+        for batch in batches:
+            with self.subTest(batch=batch):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+                self.assertEqual(self.snapshot(self.root), [])
+
+    def test_conflict_later_in_batch_creates_nothing(self):
+        entries = [("new/dir/ok", b"1"), ("x", b""), ("x/y", b"")]
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+
+class ExtractRootRules(TempRootCase):
+    def test_missing_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+        with self.assertRaises(ValueError):
+            extract([("a", b"")], self.base / "missing")
+
+    def test_root_must_be_directory(self):
+        file_root = self.base / "plain"
+        file_root.write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("a", b"")], file_root)
+
+    def test_root_type_rejected(self):
+        for root in [123, b"bytes", None, ""]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([], root)
+
+    def test_symlink_root_rejected_even_with_trailing_slash(self):
+        link = self.base / "link"
+        link.symlink_to(self.root, target_is_directory=True)
+        for root in [link, str(link), str(link) + "/"]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([("a", b"x")], root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_empty_batch_still_validates_root(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+        self.assertEqual(extract([], self.root), [])
+        self.assertEqual(extract([], str(self.root)), [])
+
+    def test_string_root_accepted(self):
+        self.assertEqual(extract([("a", b"x")], str(self.root)), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"x")
+
+
+class ExtractTargetConflicts(TempRootCase):
+    def test_existing_file_not_overwritten(self):
+        (self.root / "a").write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([("b", b"1"), ("a", b"new")], self.root)
+        self.assertEqual((self.root / "a").read_bytes(), b"keep")
+        self.assertEqual(self.snapshot(self.root), ["a"])
+
+    def test_existing_empty_file_is_a_conflict(self):
+        (self.root / "empty").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("empty", b"x")], self.root)
+        self.assertEqual((self.root / "empty").read_bytes(), b"")
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"x")], self.root)
+        self.assertEqual(self.snapshot(self.root), ["d"])
+
+    def test_file_in_ancestor_position_rejected(self):
+        (self.root / "f").write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("f/g", b"y")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"x")
+
+    def test_symlink_ancestor_inside_root_not_followed(self):
+        real = self.root / "real"
+        real.mkdir()
+        (self.root / "link").symlink_to(real, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"1")], self.root)
+        self.assertEqual(self.snapshot(real), [])
+
+    def test_symlink_ancestor_outside_root_not_followed(self):
+        outside = self.base / "outside"
+        outside.mkdir()
+        (self.root / "link").symlink_to(outside, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("ok", b"1"), ("link/x", b"2")], self.root)
+        self.assertEqual(self.snapshot(outside), [])
+        self.assertEqual(self.snapshot(self.root), ["link"])
+
+    def test_dangling_symlink_target_not_overwritten_or_followed(self):
+        missing = self.base / "nowhere"
+        (self.root / "dangling").symlink_to(missing)
+        with self.assertRaises(ValueError):
+            extract([("dangling", b"x")], self.root)
+        self.assertFalse(missing.exists())
+        self.assertTrue(os.path.islink(self.root / "dangling"))
+
+    def test_dangling_symlink_ancestor_not_followed(self):
+        missing_dir = self.base / "nowhere_dir"
+        (self.root / "dangling_dir").symlink_to(missing_dir, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("dangling_dir/x", b"")], self.root)
+        self.assertFalse(missing_dir.exists())
+
+    def test_symlink_target_to_file_inside_root_not_followed(self):
+        (self.root / "real.txt").write_bytes(b"keep")
+        (self.root / "link.txt").symlink_to(self.root / "real.txt")
+        with self.assertRaises(ValueError):
+            extract([("link.txt", b"new")], self.root)
+        self.assertEqual((self.root / "real.txt").read_bytes(), b"keep")
+
+    def test_validation_failure_leaves_outside_unchanged(self):
+        outside = self.base / "outside"
+        outside.mkdir()
+        (self.root / "link").symlink_to(outside, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("new/ok", b""), ("link/x", b"")], self.root)
+        self.assertEqual(self.snapshot(outside), [])
+        self.assertEqual(self.snapshot(self.root), ["link"])
+
+
+class ExtractWrites(TempRootCase):
+    def test_returns_names_in_input_order(self):
+        names = ["z", "a/b", "m"]
+        entries = [(name, b"1") for name in names]
+        self.assertEqual(extract(entries, self.root), names)
+
+    def test_exact_binary_bytes_written(self):
+        data = bytes(range(256)) + b"\x00\r\n"
+        extract([("bin/blob", data)], self.root)
+        self.assertEqual((self.root / "bin" / "blob").read_bytes(), data)
+
+    def test_existing_directories_reused(self):
+        (self.root / "docs").mkdir()
+        (self.root / "docs" / "other").write_bytes(b"keep")
+        extract([("docs/new", b"x")], self.root)
+        self.assertEqual((self.root / "docs" / "other").read_bytes(), b"keep")
+        self.assertEqual((self.root / "docs" / "new").read_bytes(), b"x")
+
+    def test_deep_missing_parents_created(self):
+        extract([("a/b/c/d/e.txt", b"deep")], self.root)
+        self.assertEqual((self.root / "a/b/c/d/e.txt").read_bytes(), b"deep")
+
+    @unittest.skipIf(os.geteuid() == 0, "root ignores directory permissions")
+    def test_filesystem_error_during_write_is_visible(self):
+        locked = self.root / "locked"
+        locked.mkdir()
+        locked.chmod(0o500)
+        self.addCleanup(locked.chmod, 0o700)
