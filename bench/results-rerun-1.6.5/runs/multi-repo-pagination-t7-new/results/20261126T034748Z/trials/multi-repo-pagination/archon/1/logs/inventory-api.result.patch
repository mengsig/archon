diff --git a/test_api.py b/test_api.py
index 55cd1fd..f6a006b 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,58 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20(self):
+        res = get("/items")
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertEqual(res["body"]["items"][-1]["id"], 20)
+        self.assertEqual(res["body"]["next_cursor"], "20")
+
+    def test_paging_visits_every_item_once(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="20", cursor="40")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_ending_exactly_at_last_item_has_null_next_cursor(self):
+        body = get("/items", limit="19", cursor="38")["body"]
+        self.assertEqual(len(body["items"]), 19)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_the_end_is_empty(self):
+        body = get("/items", cursor="57")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for bad in ["0", "101", "-1", "1.5", "abc", "", " 5", "٣"]:
+            with self.subTest(limit=bad):
+                res = get("/items", limit=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for bad in ["abc", "", "-3", "1.0", "٣", "9" * 5000]:
+            with self.subTest(cursor=bad[:20]):
+                res = get("/items", cursor=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertEqual(res["body"], {"error": "cursor is invalid"})
+
+    def test_oversized_digit_strings_are_400_not_crashes(self):
+        self.assertEqual(get("/items", limit="5" * 5000)["status"], 400)
+        self.assertEqual(get("/items", limit="0" * 5000 + "5")["status"], 400)
+
 
 if __name__ == "__main__":
     unittest.main()
