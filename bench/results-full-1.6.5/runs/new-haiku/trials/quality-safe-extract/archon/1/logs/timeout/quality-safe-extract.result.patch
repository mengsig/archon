--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,154 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import errno
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\x00")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Create the regular files in entries under root and return their names."""
+    _check_batch_shape(entries)
+    root_path = _check_root(root)
+    plan = _plan_batch(entries, root_path)
+    names = []
+    for name, parts, data in plan:
+        _make_parent_dirs(root_path, parts)
+        _write_new_file(root_path.joinpath(*parts), data)
+        names.append(name)
+    return names
+
+
+def _check_batch_shape(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _check_root(root):
+    if not isinstance(root, (str, os.PathLike)):
+        raise ValueError(f"root must be a str or path, not {type(root).__name__}")
+    raw = _fspath(root)
+    if not isinstance(raw, str) or raw == "":
+        raise ValueError(f"root must be a non-empty str or path: {raw!r}")
+    root_path = Path(raw)
+    info = _lstat_or_root(root_path)
+    if info is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be a real directory, not a link or file: {root_path}")
+    return root_path
+
+
+def _plan_batch(entries, root):
+    """Validate every entry and its target before anything is created."""
+    plan = [_parse_entry(index, entry) for index, entry in enumerate(entries)]
+    _check_batch_conflicts([parts for _, parts, _ in plan])
+    for _, parts, _ in plan:
+        _check_target_absent(root, parts)
+    return plan
+
+
+def _parse_entry(index, entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry {index} name must be str, not {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry {index} data must be bytes, not {type(data).__name__}")
+    return name, _name_parts(name), data
+
+
+def _name_parts(name):
+    """Split a relative POSIX name into components, rejecting anything unsafe."""
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative: {name!r}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"entry name is not valid UTF-8: {name!r}") from error
+    parts = tuple(name.split("/"))
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"entry name has an empty, '.' or '..' component: {name!r}")
+    return parts
+
+
+def _check_batch_conflicts(parts_list):
+    """Reject duplicate names and file/directory collisions within the batch."""
+    names = set()
+    for parts in parts_list:
+        if parts in names:
+            raise ValueError(f"duplicate entry name: {_join(parts)!r}")
+        names.add(parts)
+    for parts in parts_list:
+        for depth in range(1, len(parts)):
+            if parts[:depth] in names:
+                raise ValueError(
+                    f"entry {_join(parts)!r} collides with file {_join(parts[:depth])!r}"
+                )
+
+
+def _check_target_absent(root, parts):
+    """Require every existing ancestor to be a real directory and the target to be absent."""
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists: {current}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor is not a real directory: {current}")
+
+
+def _make_parent_dirs(root, parts):
+    assert parts, "an entry name always has at least one component"
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        if _lstat_or_none(current) is None:
+            os.mkdir(current)
+
+
+def _write_new_file(path, data):
+    assert isinstance(data, bytes)
+    assert _lstat_or_none(path) is None, f"target appeared before write: {path}"
+    with open(path, "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _fspath(root):
+    try:
+        return os.fspath(root)
+    except TypeError as error:
+        raise ValueError(f"root's __fspath__ returned an invalid value: {error}") from error
+
+
+def _lstat_or_root(path):
+    """Like _lstat_or_none, but a root whose path cannot be walked is an invalid root."""
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+    except OSError as error:
+        if error.errno in (errno.ENOTDIR, errno.ELOOP):
+            raise ValueError(f"root path cannot be resolved as a directory: {path}") from error
+        raise
+
+
+def _join(parts):
+    return "/".join(parts)
diff --git a/test_safe_extract.py b/test_safe_extract.py
