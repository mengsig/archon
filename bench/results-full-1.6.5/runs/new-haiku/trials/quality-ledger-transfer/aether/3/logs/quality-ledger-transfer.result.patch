+class LedgerConcurrency(unittest.TestCase):
+    ROUNDS = 2000
+
+    def _run_threads(self, targets):
+        threads = [threading.Thread(target=t) for t in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=30)
+            self.assertFalse(thread.is_alive(), "thread did not finish (deadlock?)")
+
+    def test_opposite_transfers_do_not_deadlock_and_conserve_total(self):
+        ledger = Ledger({"a": self.ROUNDS, "b": self.ROUNDS})
+
+        def a_to_b():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        self._run_threads([a_to_b, b_to_a])
+        self.assertEqual(sum(ledger.snapshot().values()), 2 * self.ROUNDS)
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": self.ROUNDS, "b": 0})
+        seen_totals = set()
+
+        def mover():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def observer():
+            for _ in range(self.ROUNDS):
+                seen_totals.add(sum(ledger.snapshot().values()))
+
+        self._run_threads([mover, observer])
+        self.assertEqual(seen_totals, {self.ROUNDS})
+
+
+if __name__ == "__main__":
+    unittest.main()
