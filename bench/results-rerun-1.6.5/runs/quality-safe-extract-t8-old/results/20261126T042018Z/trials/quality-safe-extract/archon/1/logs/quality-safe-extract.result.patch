+class ExtractBatchConflicts(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def assert_rejected_without_changes(self, entries):
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(tree(self.root), [])
+
+    def test_duplicate_names_are_rejected(self):
+        self.assert_rejected_without_changes([("a", b"1"), ("a", b"2")])
+
+    def test_file_then_directory_collision_is_rejected(self):
+        self.assert_rejected_without_changes([("a", b"1"), ("a/b", b"2")])
