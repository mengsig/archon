+++ b/tests/test_search.py
@@ -0,0 +1,96 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.store = TaskStore()
+        self.store.add("Fix login page", tags=["Work", "urgent"])
+        self.store.add("write report", tags=["work"])
+        self.store.add("fix login bug in mobile app", tags=["home"])
+        self.store.add("buy milk", tags=["Home"])
+        self.store.complete(2)
+
+    def run_search(self, query):
+        return _titles(search(self.store.all(), query))
+
+    def test_bare_word_is_case_insensitive_substring_of_title(self):
+        self.assertEqual(
+            self.run_search("LOGIN"),
+            ["Fix login page", "fix login bug in mobile app"],
+        )
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(
+            self.run_search('"fix login"'),
+            ["Fix login page", "fix login bug in mobile app"],
+        )
+        self.assertEqual(self.run_search('"login fix"'), [])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(self.run_search("fix mobile"), ["fix login bug in mobile app"])
+        self.assertEqual(self.run_search("fix milk"), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(self.run_search("tag:WORK"), ["Fix login page", "write report"])
+        self.assertEqual(self.run_search("tag:wor"), [])
+
+    def test_tag_value_can_be_quoted(self):
+        self.assertEqual(self.run_search('tag:"urgent"'), ["Fix login page"])
+
+    def test_status_open_and_done(self):
+        self.assertEqual(self.run_search("status:done"), ["write report"])
+        self.assertEqual(
+            self.run_search("status:open"),
+            ["Fix login page", "fix login bug in mobile app", "buy milk"],
+        )
+
+    def test_status_value_is_case_insensitive(self):
+        self.assertEqual(self.run_search("Status:DONE"), ["write report"])
+
+    def test_field_and_text_terms_combine(self):
+        self.assertEqual(self.run_search("login tag:work status:open"), ["Fix login page"])
+
+    def test_blank_or_empty_query_matches_everything_in_input_order(self):
+        all_titles = ["Fix login page", "write report", "fix login bug in mobile app", "buy milk"]
+        self.assertEqual(self.run_search(""), all_titles)
+        self.assertEqual(self.run_search("   \t "), all_titles)
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(self.store.all()))
+        self.assertEqual(
+            _titles(search(reversed_tasks, "fix")),
+            ["fix login bug in mobile app", "Fix login page"],
+        )
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            self.run_search("owner:bob")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            self.run_search("status:closed")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            self.run_search("tag:")
+        with self.assertRaises(QueryError):
+            self.run_search("status:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            self.run_search('"fix login')
+
+    def test_colon_inside_quotes_is_plain_text(self):
+        self.store.add("note: call bob")
+        self.assertEqual(self.run_search('"note: call"'), ["note: call bob"])
+
+
+if __name__ == "__main__":
+    unittest.main()
