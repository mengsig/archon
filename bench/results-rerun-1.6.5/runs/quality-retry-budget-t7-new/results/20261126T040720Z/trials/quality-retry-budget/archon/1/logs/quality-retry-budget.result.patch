diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..58a71ec 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,42 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms):
+    _require_int("attempt", attempt, 1)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    # Once 2**exponent exceeds cap_ms the result is cap_ms, so the exponent
+    # never needs to grow past cap_ms.bit_length().
+    exponent = min(attempt - 1, cap_ms.bit_length())
+    return min(cap_ms, base_ms << exponent)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    assert delay >= 0, "delay must be non-negative"
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..4e8380f 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,94 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.5)
+
+    def test_rejects_below_minimum(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 1000, budget_ms=-5)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, retry_after_ms=-1)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=3))
+
+    def test_last_allowed_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_budget_is_strict(self):
+        self.assertEqual(retry_delay(1, 899), 100)
+        self.assertIsNone(retry_delay(1, 900))
+
+    def test_budget_is_strict_with_retry_after(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=250, retry_after_ms=250))
+        self.assertEqual(retry_delay(1, 0, budget_ms=251, retry_after_ms=250), 250)
+
+    def test_retry_after_not_shortened_to_fit_budget(self):
+        self.assertIsNone(retry_delay(1, 800, retry_after_ms=300))
+
+    def test_zero_delay_is_returned(self):
+        self.assertEqual(retry_delay(1, 999, base_ms=0), 0)
+
+    def test_zero_budget_allows_nothing(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=200), 200)
+
+    def test_cap_limits_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=150), 150)
+
+    def test_retry_after_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=50, retry_after_ms=300,
+                                     budget_ms=10**6), 300)
+
+    def test_huge_attempt_saturates_without_large_power(self):
+        self.assertEqual(retry_delay(10**18, 0, max_attempts=10**19,
+                                     budget_ms=10**30), 400)
+
+    def test_huge_base_and_cap_are_supported(self):
+        big = 10**100
+        self.assertEqual(retry_delay(1, 0, base_ms=1, cap_ms=big,
+                                     budget_ms=big + 1), 1)
+        self.assertEqual(retry_delay(400, 0, base_ms=1, cap_ms=big,
+                                     max_attempts=500, budget_ms=big + 1), big)
+
+
+if __name__ == "__main__":
+    unittest.main()
