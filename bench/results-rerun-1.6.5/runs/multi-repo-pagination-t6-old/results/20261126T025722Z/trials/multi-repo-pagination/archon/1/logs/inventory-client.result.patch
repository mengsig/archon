+function paged(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    assert.ok(seen.length <= pages.length + 1, 'too many requests: cursor loop');
+    const cursor = request.query.cursor;
+    const index = cursor === undefined ? 0 : Number(cursor.slice(1));
+    if (request.path !== '/items' || index >= pages.length) {
+      return { status: 404, body: { error: 'not found' } };
+    }
+    return { status: 200, body: pages[index] };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'c1' },
+    { items: [ITEMS[1]], next_cursor: 'c2' },
+    { items: [{ id: 3, sku: 'SKU-0003', qty: 0 }], next_cursor: null },
+  ];
+  const { transport, seen } = paged(pages);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seen, [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('single page with null next_cursor makes one request', async () => {
+  const { transport, seen } = paged([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('missing next_cursor stops after the first page', async () => {
+  const { transport, seen } = paged([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('rejects when a page has no items array', async () => {
+  const { transport } = paged([{ next_cursor: null }]);
+  await assert.rejects(listItems(transport), /items array/);
+});
+
+test('reports a failing page instead of returning partial items', async () => {
+  const { transport } = paged([{ items: ITEMS, next_cursor: 'c1' }]);
+  await assert.rejects(listItems(transport), /GET \/items failed with 404/);
+});
+
