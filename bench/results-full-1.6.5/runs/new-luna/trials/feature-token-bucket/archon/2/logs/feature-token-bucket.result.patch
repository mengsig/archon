@@ -32,6 +32,61 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_wait_and_non_consuming_wait(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertEqual(bucket.wait_time(), 0.5)
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 0.25
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(), 0.25)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_clock_going_backwards_does_not_change_bucket(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1
+        self.assertEqual(bucket.available(), 1)
+        clock.now = 0
+        self.assertEqual(bucket.available(), 1)
+        clock.now = 1.5
+        self.assertEqual(bucket.available(), 1.5)
+
+    def test_invalid_requests_and_constructor_values(self):
+        for args in ((0, 1), (1, 0), (-1, 1), (1, -1)):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                TokenBucket(*args)
+        bucket = TokenBucket(2, 1, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.subTest(wait_n=n), self.assertRaises(ValueError):
+                bucket.wait_time(n)
+
+    def test_keyed_lru_eviction_and_wait_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertEqual(limiter.wait_time("a"), 0)
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # Refresh a, making b least recently used.
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # Evicted keys restart full.
+
+    def test_keyed_validation_does_not_create_bucket(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 2)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", 0)
+        self.assertEqual(len(limiter), 0)
+
+    def test_invalid_max_keys(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1, max_keys=0)
+
 
 if __name__ == "__main__":
     unittest.main()
