+class EdgeCaseTest(unittest.TestCase):
+    def test_invalid_bucket_parameters_raise(self):
+        with self.assertRaises(ValueError):
+            TokenBucket(0, 1.0)
+        with self.assertRaises(ValueError):
+            TokenBucket(1, 0)
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, -1.0)
+
+    def test_invalid_n_raises_and_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        for bad in (0, -1, 3):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(bad)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(bad)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertEqual(bucket.available(), 0.0)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 10.0
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 10.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_keyed_lru_eviction(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # "a" is now most recently used
+        limiter.try_acquire("c")  # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))  # evicted key returns full
+
+    def test_keyed_max_keys_must_be_positive(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0)
+
+    def test_keyed_invalid_n_creates_no_key(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 2)
+        self.assertEqual(len(limiter), 0)
+
+
 if __name__ == "__main__":
     unittest.main()
