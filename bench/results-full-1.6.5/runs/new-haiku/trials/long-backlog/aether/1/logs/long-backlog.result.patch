@@ -0,0 +1,91 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task_and_ids_are_not_reused(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        second = store.add("second")
+        self.assertEqual(second.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_complete_of_already_done_task_keeps_it_done(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+
+    def test_undo_delete_restores_exact_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("buy milk", tags=["home"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = store.get(task.id)
+        snapshot = (before.id, before.title, list(before.tags), before.status, before.due)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status, restored.due), snapshot)
+
+    def test_undo_is_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_repeated_undo_past_history_raises(self):
+        store = TaskStore()
+        store.add("only")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_add_after_undone_delete_keeps_new_ids_fresh(self):
+        store = TaskStore()
+        a = store.add("a")
+        store.delete(a.id)
+        store.undo()
+        store.undo()
+        self.assertEqual(store.all(), [])
+        self.assertEqual(store.add("b").id, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
