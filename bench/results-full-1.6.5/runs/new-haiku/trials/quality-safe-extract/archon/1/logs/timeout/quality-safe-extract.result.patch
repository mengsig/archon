+import os
 import tempfile
 import unittest
 from pathlib import Path
@@ -18,3 +19,323 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class TreeCase(unittest.TestCase):
+    """Gives each test a base dir holding an empty root and a sibling outside dir."""
+
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.outside = self.base / "outside"
+        self.root.mkdir()
+        self.outside.mkdir()
+
+    def snapshot(self):
+        found = []
+        for dirpath, dirnames, filenames in os.walk(self.base):
+            for name in dirnames + filenames:
+                found.append(os.path.relpath(os.path.join(dirpath, name), self.base))
+        return sorted(found)
+
+
+class BatchShapeTests(TreeCase):
+    def test_non_list_batches_are_rejected_untouched(self):
+        values = [
+            (("a", b"x"),),
+            iter([("a", b"x")]),
+            None,
+            {},
+            "a",
+        ]
+        for value in values:
+            with self.subTest(value=type(value).__name__):
+                before = self.snapshot()
+                with self.assertRaises(ValueError):
+                    extract(value, self.root)
+                self.assertEqual(self.snapshot(), before)
+
+    def test_empty_non_list_batches_are_rejected(self):
+        for value in [(), (x for x in [])]:
+            with self.subTest(value=type(value).__name__):
+                with self.assertRaises(ValueError):
+                    extract(value, self.root)
+
+    def test_generator_is_not_consumed(self):
+        generator = (entry for entry in [("a", b"x")])
+        with self.assertRaises(ValueError):
+            extract(generator, self.root)
+        self.assertEqual(list(generator), [("a", b"x")])
+
+
+class EntryShapeTests(TreeCase):
+    def test_malformed_entries_are_rejected_untouched(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", "extra"),
+            (b"a", b"x"),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", None),
+            "a",
+        ]
+        for bad in bad_entries:
+            with self.subTest(entry=bad):
+                before = self.snapshot()
+                with self.assertRaises(ValueError):
+                    extract([bad], self.root)
+                self.assertEqual(self.snapshot(), before)
+
+    def test_bad_entry_late_in_batch_writes_nothing(self):
+        with self.assertRaises(ValueError):
+            extract([("ok", b"1"), ("bad", 3)], self.root)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+
+class NameTests(TreeCase):
+    def test_invalid_names_are_rejected_untouched(self):
+        bad_names = [
+            "",
+            "/abs",
+            "//abs",
+            "back\\slash",
+            "c:/drive",
+            "C:",
+            "a:b",
+            "nul\x00byte",
+            "a//b",
+            "trailing/",
+            ".",
+            "..",
+            "a/./b",
+            "a/../b",
+            "./a",
+            "../a",
+            "bad\ud800name",
+        ]
+        for name in bad_names:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b"1"), (name, b"2")], self.root)
+                self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_percent_and_dot_names_are_literal(self):
+        names = ["a%20b", "%2e%2e", "...", ".hidden", "a..b", "sp ace", "ünï"]
+        self.assertEqual(extract([(name, name.encode()) for name in names], self.root), names)
+        for name in names:
+            with self.subTest(name=name):
+                self.assertEqual((self.root / name).read_bytes(), name.encode())
+
+
+class BatchConflictTests(TreeCase):
+    def test_duplicate_names_are_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a", b"2")], self.root)
+        with self.assertRaises(ValueError):
+            extract([("d/a", b"1"), ("d/a", b"2")], self.root)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_file_directory_collisions_are_rejected_in_either_order(self):
+        for batch in ([("a", b"1"), ("a/b", b"2")], [("a/b", b"2"), ("a", b"1")]):
+            with self.subTest(batch=[name for name, _ in batch]):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+                self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_deep_collisions_are_rejected(self):
+        for batch in ([("a/b/c", b"1"), ("a/b", b"2")], [("a/b", b"2"), ("a/b/c", b"1")]):
+            with self.subTest(batch=[name for name, _ in batch]):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+
+    def test_siblings_under_shared_directory_are_allowed(self):
+        self.assertEqual(extract([("a/b", b"1"), ("a/c", b"2")], self.root), ["a/b", "a/c"])
+
+    def test_conflict_late_in_batch_writes_nothing(self):
+        with self.assertRaises(ValueError):
+            extract([("new", b"1"), ("x", b"2"), ("x/y", b"3")], self.root)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+
+class RootTests(TreeCase):
+    def test_missing_root_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], self.base / "missing")
+
+    def test_file_root_is_rejected(self):
+        (self.base / "file").write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], self.base / "file")
+
+    def test_symlink_root_is_rejected(self):
+        link = self.base / "link"
+        link.symlink_to(self.root, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], link)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_root_below_regular_file_is_rejected(self):
+        (self.base / "file").write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], self.base / "file" / "sub")
+
+    def test_empty_root_string_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], "")
+
+    def test_path_like_returning_bytes_is_rejected(self):
+        class BytesPath:
+            def __fspath__(self):
+                return b"bytes/root"
+
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], BytesPath())
+
+    def test_path_like_returning_non_path_type_is_rejected(self):
+        class IntPath:
+            def __fspath__(self):
+                return 42
+
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], IntPath())
+
+    def test_root_through_symlink_loop_is_rejected(self):
+        (self.base / "loop").symlink_to("loop")
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], self.base / "loop" / "r")
+
+    def test_invalid_root_types_are_rejected(self):
+        for root in [42, None, b"bytes/root"]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([("a", b"1")], root)
+
+    def test_empty_batch_validates_root(self):
+        self.assertEqual(extract([], str(self.root)), [])
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+
+class ExistingTargetTests(TreeCase):
+    def test_existing_file_is_never_overwritten(self):
+        (self.root / "f").write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([("new", b"1"), ("f", b"2")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"keep")
+        self.assertFalse((self.root / "new").exists())
+
+    def test_existing_directory_target_is_rejected(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"x")], self.root)
+
+    def test_file_as_ancestor_is_rejected(self):
+        (self.root / "f").write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([("f/g", b"x")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"keep")
+
+    def test_existing_ancestor_directory_is_reused(self):
+        (self.root / "pre").mkdir()
+        (self.root / "pre" / "keep").write_bytes(b"k")
+        self.assertEqual(extract([("pre/x", b"1")], self.root), ["pre/x"])
+        self.assertEqual((self.root / "pre" / "keep").read_bytes(), b"k")
+
