 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        if capacity <= 0:
+            raise ValueError("capacity must be greater than zero")
+        if refill_per_sec <= 0:
+            raise ValueError("refill_per_sec must be greater than zero")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = capacity
+        self._last_time = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now > self._last_time:
+            self._tokens = min(
+                self.capacity,
+                self._tokens + (now - self._last_time) * self.refill_per_sec,
+            )
+            self._last_time = now
+
+    def _validate_request(self, n):
+        if n <= 0 or n > self.capacity:
+            raise ValueError("n must be greater than zero and no more than capacity")
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        return max(0.0, (n - self._tokens) / self.refill_per_sec)
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        if max_keys < 1:
+            raise ValueError("max_keys must be at least one")
