@@ -18,3 +18,70 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractValidation(unittest.TestCase):
+    def assert_rejected_unchanged(self, root, entries):
+        before = sorted((p.relative_to(root).as_posix(), p.is_dir(), p.read_bytes() if p.is_file() else None)
+                        for p in root.rglob("*") if not p.is_symlink())
+        with self.assertRaises(ValueError):
+            extract(entries, root)
+        after = sorted((p.relative_to(root).as_posix(), p.is_dir(), p.read_bytes() if p.is_file() else None)
+                       for p in root.rglob("*") if not p.is_symlink())
+        self.assertEqual(after, before)
+
+    def test_non_list_batches_rejected_without_consuming(self):
+        import itertools
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            for batch in ((), iter(()), (x for x in ())):
+                with self.assertRaises(ValueError):
+                    extract(batch, root)
+            self.assertEqual(list(root.iterdir()), [])
+
+    def test_invalid_entries_and_names(self):
+        invalid = [
+            [()], [("x",)], [("x", b"ok", 3)], [["x", b"ok"]], [(3, b"x")], [("x", bytearray())],
+            [("", b"")], [("/x", b"")], [("a//b", b"")], [("a/./b", b"")],
+            [("a/../b", b"")], [("a\\b", b"")], [("C:x", b"")], [("a\x00b", b"")],
+        ]
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            for entries in invalid:
+                with self.subTest(entries=entries):
+                    self.assert_rejected_unchanged(root, entries)
+
+    def test_duplicate_and_file_directory_collisions_both_orders(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            cases = [[("x", b"1"), ("x", b"2")], [("a", b""), ("a/b", b"")],
+                     [("a/b", b""), ("a", b"")]]
+            for entries in cases:
+                with self.subTest(entries=entries):
+                    self.assert_rejected_unchanged(root, entries)
+
+    def test_root_and_existing_path_conflicts(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory, tempfile.TemporaryDirectory(dir=".") as outside:
+            root = Path(directory)
+            (root / "file").write_bytes(b"old")
+            (root / "folder").mkdir()
+            (root / "folder" / "child").write_bytes(b"old")
+            (root / "link").symlink_to(Path(outside), target_is_directory=True)
+            (root / "dangling").symlink_to(root / "missing")
+            for entries in ([('new/deep/file', b'x'), ('file', b'overwrite')],
+                            [('link/new', b'x')], [('dangling/child', b'x')],
+                            [('folder/child', b'x')], [('file/child', b'x')]):
+                with self.subTest(entries=entries):
+                    with self.assertRaises(ValueError):
+                        extract(entries, root)
+                    self.assertFalse((root / "new").exists())
+            self.assertEqual((root / "file").read_bytes(), b"old")
+            self.assertEqual(list(Path(outside).iterdir()), [])
+            with self.assertRaises(ValueError):
+                extract([], root / "link")
+
+    def test_percent_is_literal(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            self.assertEqual(extract([("100%25.txt", b"ok")], root), ["100%25.txt"])
+            self.assertEqual((root / "100%25.txt").read_bytes(), b"ok")
