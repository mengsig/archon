+class LedgerConstruction(unittest.TestCase):
+    def test_empty_ledger_is_allowed(self):
+        ledger = Ledger({})
+        self.assertEqual(ledger.snapshot(), {})
+
+    def test_boundary_balances_are_accepted(self):
+        ledger = Ledger({"low": 0, "high": MAX_BALANCE})
+        self.assertEqual(ledger.snapshot(), {"low": 0, "high": MAX_BALANCE})
+
+    def test_input_is_copied(self):
+        source = {"a": 5}
+        ledger = Ledger(source)
+        source["a"] = 999
+        source["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_snapshot_is_a_copy(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        snap = ledger.snapshot()
+        snap["a"] = 999
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": 0})
+
+    def test_non_dict_input_is_rejected(self):
+        for bad in (None, [("a", 1)], "a", 3):
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
+                    Ledger(bad)
+
+    def test_invalid_names_are_rejected(self):
+        for bad in ("", None, 1, b"a", ("a",)):
+            with self.subTest(bad=bad):
+                with self.assertRaises(ValueError):
