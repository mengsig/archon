 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_balance(name, balance):
+    if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+        raise ValueError(f"invalid balance for {name!r}: {balance!r}")
+
+
+def _check_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"invalid amount: {amount!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+        for name, balance in balances.items():
+            if not isinstance(name, str) or not name:
+                raise ValueError(f"invalid account name: {name!r}")
+            _check_balance(name, balance)
+        self._balances = dict(balances)
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        with self._lock:
+            self._require_account(source)
+            self._require_account(destination)
+            if source == destination:
+                return self._balances[source] >= amount
+            if self._balances[source] < amount:
+                return False
+            if self._balances[destination] + amount > MAX_BALANCE:
+                return False
+            self._balances[source] -= amount
+            self._balances[destination] += amount
+            assert 0 <= self._balances[source]
+            assert self._balances[destination] <= MAX_BALANCE
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _require_account(self, name):
+        if name not in self._balances:
+            raise KeyError(name)
