+class NothingToUndo(Exception):
+    """Raised when a store has no recorded operation left to undo."""
+
+
 class TaskStore:
     def __init__(self):
         self._tasks = {}
         self._next_id = 1
+        self._history = []
 
     def add(self, title, tags=(), due=None):
         if not title.strip():
@@ -16,6 +21,7 @@ class TaskStore:
         task = Task(self._next_id, title.strip(), list(tags), due=due)
         self._tasks[task.id] = task
         self._next_id += 1
+        self._history.append(("add", task))
         return task
 
     def get(self, task_id):
@@ -27,11 +33,29 @@ class TaskStore:
     def complete(self, task_id):
         task = self.get(task_id)
         task.status = DONE
+        self._history.append(("complete", task))
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        snapshot = (task.title, list(task.tags), task.status, task.due)
         del self._tasks[task_id]
+        self._history.append(("delete", task, snapshot))
+        return task
+
+    def undo(self):
+        if not self._history:
+            raise NothingToUndo()
+        operation = self._history.pop()
+        kind, task = operation[:2]
+        if kind == "add":
+            del self._tasks[task.id]
+        elif kind == "complete":
+            task.status = OPEN
+        else:  # delete
+            _, _, snapshot = operation
+            task.title, task.tags, task.status, task.due = snapshot
+            self._tasks[task.id] = task
         return task
 
