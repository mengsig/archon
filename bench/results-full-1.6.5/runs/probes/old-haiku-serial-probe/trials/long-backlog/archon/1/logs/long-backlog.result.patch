diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..899f4dc 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,73 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_predicate_for(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quotes stay in the raw term."""
+    terms = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+        if char.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    assert all(terms), "split must never yield an empty term"
+    return terms
+
+
+def _predicate_for(raw):
+    if _is_field_term(raw):
+        field, _, value = raw.partition(":")
+        return _field_predicate(field.lower(), _strip_quotes(value))
+    needle = _strip_quotes(raw).lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _is_field_term(raw):
+    return not raw.startswith('"') and ":" in raw
+
+
+def _field_predicate(field, value):
+    if field == "tag":
+        return _tag_predicate(value)
+    if field == "status":
+        return _status_predicate(value)
+    raise QueryError(f"unknown field: {field!r}")
+
+
+def _tag_predicate(value):
+    if not value:
+        raise QueryError("tag: needs a tag name")
+    wanted = value.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_predicate(value):
+    wanted = value.lower()
+    if wanted not in STATUSES:
+        raise QueryError(f"unknown status: {value!r}")
+    return lambda task: task.status == wanted
+
+
+def _strip_quotes(text):
+    return text.replace('"', "")
