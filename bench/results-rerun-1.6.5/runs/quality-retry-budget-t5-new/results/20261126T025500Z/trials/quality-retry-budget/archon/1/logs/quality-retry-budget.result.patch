diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..79da182 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,42 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _check_int("attempt", attempt, minimum=1)
+    _check_int("max_attempts", max_attempts, minimum=1)
+    _check_int("elapsed_ms", elapsed_ms, minimum=0)
+    _check_int("budget_ms", budget_ms, minimum=0)
+    _check_int("base_ms", base_ms, minimum=0)
+    _check_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without a huge power."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # 2**exponent >= 2**cap_ms.bit_length() > cap_ms, so the result is cap_ms.
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    delay = min(cap_ms, base_ms << exponent)
+    assert 0 <= delay <= cap_ms
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..39e9a1f 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,113 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=10.0)
+
+    def test_rejects_none_for_required_number(self):
+        with self.assertRaises(ValueError):
+            retry_delay(None, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, None)
+
+    def test_attempt_and_max_attempts_at_least_one(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_other_values_at_least_zero(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_invalid_input_raises_before_exhausted_return(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=1, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 1000, budget_ms=1000, retry_after_ms=-5)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_attempt_beyond_max_is_legal_and_returns_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_last_allowed_attempt_still_gets_retry(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+
+class Backoff(unittest.TestCase):
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(9, 0, base_ms=0, max_attempts=10), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_returns_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_cap_limits_growth(self):
+        self.assertEqual(retry_delay(5, 0, max_attempts=10, budget_ms=10**6), 400)
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(
+            retry_delay(10**100, 0, max_attempts=10**101, budget_ms=10**6), 400)
+
+    def test_no_upper_integer_limit_on_inputs(self):
+        big = 10**40
+        self.assertEqual(
+            retry_delay(1, big, budget_ms=big + 1000, cap_ms=big), 100)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_floor_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=900, cap_ms=400, budget_ms=2000), 900)
+
+    def test_retry_after_zero_does_not_lower_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+
+class BudgetBoundary(unittest.TestCase):
+    def test_delay_ending_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_just_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_allowed_when_elapsed_below_budget(self):
+        self.assertEqual(retry_delay(1, 999, budget_ms=1000, base_ms=0), 0)
+
+    def test_zero_delay_refused_when_elapsed_reaches_budget(self):
+        self.assertIsNone(retry_delay(1, 1000, budget_ms=1000, base_ms=0))
+
+    def test_retry_after_is_not_shortened_to_fit_budget(self):
+        self.assertIsNone(retry_delay(1, 500, budget_ms=1000, retry_after_ms=500))
+
+    def test_zero_budget_refuses_everything_with_zero_elapsed(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
