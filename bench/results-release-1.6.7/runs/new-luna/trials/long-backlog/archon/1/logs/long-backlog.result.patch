--- /dev/null
+++ b/tests/test_tt103_search.py
@@ -0,0 +1,51 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login flow", ["Auth", "urgent"]),
+            Task(2, "Fix account page", ["auth"], status="done"),
+            Task(3, "Review login logs", ["ops"]),
+            Task(4, "Investigate status:done migration", ["ops"]),
+        ]
+
+    def test_title_terms_are_case_insensitive_and_anded(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "FIX login")], [1]
+        )
+
+    def test_quoted_phrase_is_one_title_term(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, '"login flow"')], [1]
+        )
+        self.assertEqual(search(self.tasks, '"account page" status:done')[0].id, 2)
+        self.assertEqual(
+            [task.id for task in search(self.tasks, '"status:done"')], [4]
+        )
+
+    def test_tag_and_status_fields(self):
+        self.assertEqual([task.id for task in search(self.tasks, "tag:AUTH")], [1, 2])
+        self.assertEqual([task.id for task in search(self.tasks, "status:DONE")], [2])
+        self.assertEqual([task.id for task in search(self.tasks, "fix tag:urgent status:open")], [1])
+
+    def test_empty_query_returns_all_in_input_order(self):
+        tasks = list(reversed(self.tasks))
+        self.assertEqual(search(tasks, "  \t "), tasks)
+
+    def test_invalid_syntax_raises_query_error(self):
+        for query in ('"unfinished phrase', "priority:high", "status:closed"):
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+    def test_invalid_field_is_checked_with_empty_task_input(self):
+        with self.assertRaises(QueryError):
+            search([], "owner:me")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_tt104_undo.py b/tests/test_tt104_undo.py
new file mode 100644
index 0000000..b36d539
--- /dev/null
+++ b/tests/test_tt104_undo.py
@@ -0,0 +1,65 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class TaskStoreUndoTest(unittest.TestCase):
+    def test_undo_each_operation_kind(self):
+        store = TaskStore()
+        task = store.add("keep", tags=["work"], due=date(2026, 4, 1))
+        other = store.add("temporary")
+
+        store.complete(task.id)
+        self.assertEqual(store.undo(), task)
+        self.assertEqual(store.get(task.id).status, "open")
+
+        deleted = store.delete(task.id)
+        self.assertIs(store.undo(), deleted)
+        self.assertIs(store.get(task.id), task)
+        self.assertEqual((task.title, task.tags, task.status, task.due),
+                         ("keep", ["work"], "open", date(2026, 4, 1)))
+
+        self.assertIs(store.undo(), other)
+        self.assertEqual([item.id for item in store.all()], [task.id])
+        with self.assertRaises(UnknownTask):
+            store.get(other.id)
+
+    def test_undo_is_lifo_across_operation_types(self):
+        store = TaskStore()
+        first = store.add("first")
+        second = store.add("second")
+        store.complete(first.id)
+        store.delete(second.id)
+
+        store.undo()  # Restore second.
+        self.assertEqual([item.id for item in store.all()], [first.id, second.id])
+        store.undo()  # Reopen first.
+        self.assertEqual(store.get(first.id).status, "open")
+        store.undo()  # Remove second.
+        with self.assertRaises(UnknownTask):
+            store.get(second.id)
+        store.undo()  # Remove first.
+        self.assertEqual(store.all(), [])
+
+    def test_undone_add_does_not_reuse_id(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_failed_operation_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_empty_history_raises_nothing_to_undo(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
