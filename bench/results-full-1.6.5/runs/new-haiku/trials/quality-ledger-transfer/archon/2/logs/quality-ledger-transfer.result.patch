+class LedgerConcurrency(unittest.TestCase):
+    def run_threads(self, targets):
+        threads = [threading.Thread(target=target) for target in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(THREAD_JOIN_TIMEOUT)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "deadlock")
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": WORKER_ROUNDS, "b": WORKER_ROUNDS})
+
+        def a_to_b():
+            for _ in range(WORKER_ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(WORKER_ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        self.run_threads([a_to_b, b_to_a])
+        self.assertEqual(sum(ledger.snapshot().values()), 2 * WORKER_ROUNDS)
+
+    def test_snapshots_never_see_a_half_transfer(self):
+        total = 3 * 100
+        ledger = Ledger({"a": 100, "b": 100, "c": 100})
+        observed_totals = []
+
+        def shuffle():
+            for i in range(WORKER_ROUNDS):
+                names = ("a", "b", "c")
+                ledger.transfer(names[i % 3], names[(i + 1) % 3], 1)
+
+        def watch():
+            for _ in range(WORKER_ROUNDS):
+                observed_totals.append(sum(ledger.snapshot().values()))
+
+        self.run_threads([shuffle, shuffle, watch])
+        self.assertEqual(set(observed_totals), {total})
+        self.assertEqual(sum(ledger.snapshot().values()), total)
+
+    def test_concurrent_overflow_never_exceeds_max(self):
+        ledger = Ledger({"sink": MAX_BALANCE - 10, "src": MAX_BALANCE})
+
+        def push():
+            for _ in range(WORKER_ROUNDS):
+                ledger.transfer("src", "sink", 1)
+
+        self.run_threads([push, push])
+        snap = ledger.snapshot()
+        self.assertEqual(snap["sink"], MAX_BALANCE)
+        self.assertEqual(snap["src"], MAX_BALANCE - 10)
+
+
+if __name__ == "__main__":
+    unittest.main()
