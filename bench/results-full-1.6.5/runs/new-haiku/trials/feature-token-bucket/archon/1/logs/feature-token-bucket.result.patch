+class ValidationTest(unittest.TestCase):
+    def test_invalid_rate_parameters_raise(self):
+        for capacity, refill in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, refill, clock=FakeClock())
+            with self.assertRaises(ValueError):
+                KeyedLimiter(capacity, refill, clock=FakeClock())
+
+    def test_invalid_n_raises_for_bucket(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_invalid_max_keys_raises(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+
+    def test_invalid_n_does_not_evict_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
+class RefillTest(unittest.TestCase):
+    def test_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_tokens_cap_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire())
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 10.0
+        self.assertEqual(bucket.available(), 2.0)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        clock.now = 9.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 11.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+
+class WaitTimeTest(unittest.TestCase):
+    def test_wait_time_zero_when_acquirable_now(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_empty_bucket_refuses_at_large_clock_and_high_rate(self):
+        clock = FakeClock()
+        clock.now = 1e8
+        bucket = TokenBucket(1, 1e8, clock=clock)
+        bucket.try_acquire()
+        self.assertFalse(bucket.try_acquire())
+        self.assertGreater(bucket.wait_time(), 0.0)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+    def test_advancing_by_wait_time_always_succeeds(self):
+        cases = [(1, 3.0), (3, 0.1), (5, 1 / 3), (7, 49.0), (1000, 7.3), (1, 1e8)]
+        for start in (-1e8, 0.0, 1e6, 1e8, 1e9):
+            for capacity, rate in cases:
+                clock = FakeClock()
+                clock.now = start
+                bucket = TokenBucket(capacity, rate, clock=clock)
+                bucket.try_acquire(capacity)
+                clock.now += bucket.wait_time(capacity)
+                self.assertTrue(bucket.try_acquire(capacity), (start, capacity, rate))
+
+    def test_wait_time_for_partial_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.0)
+
+
+class KeyedLimiterTest(unittest.TestCase):
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=10, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_lru_eviction_counts_wait_time_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a", 2))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(len(limiter), 1)
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+
 if __name__ == "__main__":
     unittest.main()
