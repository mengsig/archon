diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..c909a8f 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,36 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an int >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an int >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        exponent = attempt - 1
+        # Once the exponent reaches cap_ms.bit_length(), the product is
+        # guaranteed to meet or exceed the cap, without constructing it.
+        if exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms * (1 << exponent))
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..d4bf7db 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,58 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryEdges(unittest.TestCase):
+    def test_validates_every_argument_before_early_returns(self):
+        invalid = (
+            ((0, 0), {}),
+            ((1, -1), {}),
+            ((1, 0), {"max_attempts": 0}),
+            ((1, 0), {"budget_ms": -1}),
+            ((1, 0), {"base_ms": -1}),
+            ((1, 0), {"cap_ms": -1}),
+            ((1, 0), {"retry_after_ms": -1}),
+            ((True, 0), {}),
+            ((1, False), {}),
+            ((1.0, 0), {}),
+            ((1, 0.0), {}),
+            ((1, 0), {"max_attempts": True}),
+            ((1, 0), {"budget_ms": 1.0}),
+            ((1, 0), {"base_ms": False}),
+            ((1, 0), {"cap_ms": 1.0}),
+            ((1, 0), {"retry_after_ms": True}),
+            ((4, 0), {"base_ms": -1}),
+            ((1, 0), {"max_attempts": 1, "retry_after_ms": 0.5}),
+        )
+        for args, kwargs in invalid:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_attempt_count_includes_initial_attempt(self):
+        self.assertEqual(retry_delay(1, 0, max_attempts=2), 100)
+        self.assertIsNone(retry_delay(2, 0, max_attempts=2))
+        self.assertIsNone(retry_delay(3, 0, max_attempts=2))
+
+    def test_budget_requires_strictly_earlier_start(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+
+    def test_retry_after_floor_is_not_capped_or_shortened(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=5001, retry_after_ms=5000), 5000)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=5000, retry_after_ms=5000))
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=2), 2)
+
+    def test_zero_values_and_large_attempts(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**101), 400)
+        self.assertIsNone(retry_delay(10**100, 0, max_attempts=10**100))
+
+    def test_unbounded_integer_values(self):
+        huge = 10**100
+        self.assertEqual(retry_delay(1, 0, base_ms=huge, cap_ms=huge,
+                                     budget_ms=huge + 1), huge)
