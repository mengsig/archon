diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..f7512a2 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,42 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms >= 1 and cap_ms < 2**cap_ms.bit_length(), so a shift at or past
+    # that bit length already exceeds cap_ms; avoids building a huge power of two.
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..0222928 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,145 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_bool_and_float_and_str(self):
+        bad_calls = [
+            lambda: retry_delay(True, 0),
+            lambda: retry_delay(1, 0.0),
+            lambda: retry_delay(1, 0, budget_ms="1000"),
+            lambda: retry_delay(1, 0, base_ms=True),
+            lambda: retry_delay(1, 0, cap_ms=400.0),
+            lambda: retry_delay(1, 0, max_attempts=False),
+            lambda: retry_delay(1, 0, retry_after_ms=1.5),
+        ]
+        for call in bad_calls:
+            with self.subTest():
+                with self.assertRaises(ValueError):
+                    call()
+
+    def test_rejects_below_minimum(self):
+        bad_calls = [
+            lambda: retry_delay(0, 0),
+            lambda: retry_delay(1, -1),
+            lambda: retry_delay(1, 0, max_attempts=0),
+            lambda: retry_delay(1, 0, budget_ms=-1),
+            lambda: retry_delay(1, 0, base_ms=-1),
+            lambda: retry_delay(1, 0, cap_ms=-1),
+            lambda: retry_delay(1, 0, retry_after_ms=-1),
+        ]
+        for call in bad_calls:
+            with self.subTest():
+                with self.assertRaises(ValueError):
+                    call()
+
+    def test_validates_before_early_return(self):
+        with self.assertRaises(ValueError):
+            retry_delay(10, 0, max_attempts=4, budget_ms=-5)
+        with self.assertRaises(ValueError):
+            retry_delay(10, -1, max_attempts=4)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=1000, retry_after_ms=-1)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_no_upper_limit_on_large_ints(self):
+        self.assertIsNone(retry_delay(10**30, 0))
+        self.assertEqual(retry_delay(1, 10**30, budget_ms=10**31), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(10**20, 0, max_attempts=4))
+
+
+class Backoff(unittest.TestCase):
+    def test_cap_limits_backoff(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, cap_ms=150), 150)
+        self.assertEqual(retry_delay(9, 0, max_attempts=10, cap_ms=150), 150)
+
+    def test_base_may_exceed_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(2, 0, base_ms=0, cap_ms=400), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, cap_ms=0, max_attempts=10), 0)
+
+    def test_zero_base_with_zero_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, cap_ms=0), 0)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        delay = retry_delay(10**18, 0, max_attempts=10**19, budget_ms=10**19)
+        self.assertEqual(delay, 400)
+
+    def test_huge_attempt_with_large_cap_saturates(self):
+        cap = 2**200
+        delay = retry_delay(10**18, 0, max_attempts=10**19,
+                            base_ms=1, cap_ms=cap, budget_ms=2**201)
+        self.assertEqual(delay, cap)
+
+    def test_shift_boundary_matches_direct_formula(self):
+        for attempt in range(1, 80):
+            expected = min(400, 100 * 2 ** (attempt - 1))
+            actual = retry_delay(attempt, 0, max_attempts=10**6,
+                                 budget_ms=10**18)
+            with self.subTest(attempt=attempt):
+                self.assertEqual(actual, expected)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_floor_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=5000,
+                        budget_ms=10000),
+            5000,
+        )
+
+    def test_retry_after_below_backoff_is_ignored(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=50), 200)
+
+    def test_zero_retry_after_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_retry_after_zero_base_and_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=0, retry_after_ms=30), 30)
+
+
+class Budget(unittest.TestCase):
+    def test_exact_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_below_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_delay_is_not_shortened_to_fit(self):
+        self.assertIsNone(
+            retry_delay(1, 950, budget_ms=1000, retry_after_ms=100))
+
+    def test_zero_delay_allowed_when_before_budget(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_refused_when_elapsed_reaches_budget(self):
+        self.assertIsNone(retry_delay(1, 5, base_ms=0, budget_ms=5))
+
+    def test_zero_budget_refuses_everything(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+    def test_budget_checked_after_attempt_limit(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4, budget_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
