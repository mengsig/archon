+    def undo(self):
+        """Revert the most recent add, complete or delete that is not undone."""
+        if not self._history:
+            raise NothingToUndo("there is nothing to undo")
+        change = self._history.pop()
+        if change.kind == ADD:
+            self._remove_added(change.task_id)
