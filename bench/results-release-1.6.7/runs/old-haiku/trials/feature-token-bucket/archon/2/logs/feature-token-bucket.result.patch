+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_keyed_wait_time_matches_bucket_math(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(4, 2.0, clock=clock)
+        self.assertEqual(limiter.wait_time("a"), 0.0)
+        self.assertTrue(limiter.try_acquire("a", 4))
+        self.assertEqual(limiter.wait_time("a", 3), 1.5)
+        clock.now = 1.5
+        self.assertTrue(limiter.try_acquire("a", 3))
+
 
