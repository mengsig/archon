-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+Input has a currency column (ISO 4217) or, from the old ledger, none;
+rows without a currency column count as USD.
 """
 
 import csv
+import re
 import sys
 
+LEGACY_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
+
+
+class MalformedCurrency(ValueError):
+    pass
+
+
+def check_currency(code, line_number):
+    """Return the currency code, or raise MalformedCurrency for a bad one."""
+    if not isinstance(code, str) or not CURRENCY_PATTERN.fullmatch(code):
+        raise MalformedCurrency(
+            f"line {line_number}: malformed currency code {code!r}"
+        )
+    return code
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(reader):
+    """{(account, currency): total_cents} from a csv.DictReader."""
+    has_currency = "currency" in (reader.fieldnames or [])
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        currency = (
+            check_currency(row["currency"], reader.line_num)
+            if has_currency
+            else LEGACY_CURRENCY
+        )
+        key = (row["account"], currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for (account, currency), total in sorted(result.items()):
+        lines.append(f"{account},{currency},{total}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    reader = csv.DictReader(sys.stdin)
+    try:
+        result = totals(reader)
+    except MalformedCurrency as err:
+        sys.stderr.write(f"reports: {err}\n")
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
