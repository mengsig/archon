diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..e8e2174 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,44 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": attempt,
+        "elapsed_ms": elapsed_ms,
+        "max_attempts": max_attempts,
+        "budget_ms": budget_ms,
+        "base_ms": base_ms,
+        "cap_ms": cap_ms,
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = retry_after_ms
+
+    for name, value in values.items():
+        if type(value) is not int:
+            raise ValueError(f"{name} must be a built-in int")
+
+    if attempt < 1 or max_attempts < 1:
+        raise ValueError("attempt and max_attempts must be at least 1")
+    for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms",
+                 "retry_after_ms"):
+        value = values.get(name)
+        if value is not None and value < 0:
+            raise ValueError(f"{name} must be at least 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    elif base_ms >= cap_ms:
+        backoff = cap_ms
+    else:
+        exponent = attempt - 1
+        if exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..af84f14 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,68 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_budget_requires_start_strictly_before_deadline(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100))
+        self.assertEqual(retry_delay(1, 0, budget_ms=101), 100)
+
+    def test_retry_after_is_not_capped_or_shortened(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=10, retry_after_ms=500), 500)
+        self.assertIsNone(retry_delay(1, 500, budget_ms=1000,
+                                      retry_after_ms=500))
+
+    def test_zero_values_and_base_above_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=99, cap_ms=10), 10)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_large_attempt_saturates_without_building_power(self):
+        huge_attempt = 10 ** 100
+        self.assertEqual(retry_delay(huge_attempt, 0,
+                                     max_attempts=huge_attempt + 1), 400)
+        self.assertIsNone(retry_delay(huge_attempt, 0,
+                                      max_attempts=huge_attempt))
+
+    def test_attempt_above_limit_is_allowed(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+
+    def test_every_argument_is_validated_before_early_return(self):
+        invalid_calls = (
+            lambda: retry_delay(4, 0, retry_after_ms=-1),
+            lambda: retry_delay(4, 0, base_ms=True),
+            lambda: retry_delay(4, 0, cap_ms=1.0),
+            lambda: retry_delay(4, -1),
+            lambda: retry_delay(0, 0),
+            lambda: retry_delay(1, 0, max_attempts=True),
+        )
+        for call in invalid_calls:
+            with self.subTest(call=call):
+                with self.assertRaises(ValueError):
+                    call()
+
+    def test_non_builtin_numeric_types_are_rejected(self):
+        class IntSubclass(int):
+            pass
+
+        for value in (True, 1.0, IntSubclass(1)):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(value, 0)
+
+    def test_negative_optional_and_required_values_are_rejected(self):
+        invalid_calls = (
+            lambda: retry_delay(1, 0, budget_ms=-1),
+            lambda: retry_delay(1, 0, base_ms=-1),
+            lambda: retry_delay(1, 0, cap_ms=-1),
+            lambda: retry_delay(1, 0, retry_after_ms=-1),
+            lambda: retry_delay(1, 0, max_attempts=0),
+        )
+        for call in invalid_calls:
+            with self.subTest(call=call):
+                with self.assertRaises(ValueError):
+                    call()
