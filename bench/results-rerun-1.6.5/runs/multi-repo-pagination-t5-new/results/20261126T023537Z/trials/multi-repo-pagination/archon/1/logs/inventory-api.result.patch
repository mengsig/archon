 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_DECIMAL = re.compile(r"[0-9]{1,18}")
+
+
+class BadRequest(Exception):
+    """A query parameter the client supplied cannot be used."""
