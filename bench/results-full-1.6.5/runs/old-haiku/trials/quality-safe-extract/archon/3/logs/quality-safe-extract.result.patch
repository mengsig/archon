 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write every (name, data) entry below root and return the names in order."""
+    _check_batch(entries)
+    root_path = _check_root(root)
+    for name, _ in entries:
+        _check_target_free(root_path, name)
+    for name, data in entries:
+        _write_file(root_path / name, data)
+    return [name for name, _ in entries]
+
+
+def _check_batch(entries):
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list of (name, data) tuples")
+    for index, entry in enumerate(entries):
+        _check_entry(index, entry)
+    _check_no_collisions([name for name, _ in entries])
+
+
+def _check_entry(index, entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry {index} name must be a str")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry {index} data must be bytes")
+    _check_name(name)
+
+
+def _check_name(name):
+    if name == "" or name.startswith("/"):
+        raise ValueError(f"name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    if any(part in ("", ".", "..") for part in name.split("/")):
+        raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+
+
+def _check_no_collisions(names):
+    name_set = set(names)
+    if len(name_set) != len(names):
+        raise ValueError("batch contains duplicate names")
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in name_set:
+                raise ValueError(f"{name!r} needs {ancestor!r} to be a directory")
+
+
+def _check_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError("root must be a non-empty str or pathlib.Path")
+    root_path = Path(root)
+    info = _lstat_or_none(root_path)
+    if info is None or not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be an existing real directory: {root!r}")
+    return root_path
+
+
+def _check_target_free(root, name):
+    path = root
+    parts = name.split("/")
+    for depth, part in enumerate(parts, start=1):
+        path = path / part
+        info = _lstat_or_none(path)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"{name!r} passes through a symlink")
+        if depth == len(parts):
+            raise ValueError(f"{name!r} already exists")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"{name!r} has an ancestor that is not a directory")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_file(path, data):
+    assert isinstance(data, bytes)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    assert path.parent.is_dir()
+    with open(path, "xb") as handle:
+        handle.write(data)
