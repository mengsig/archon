new file mode 100644
index 0000000..fdac6d4
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,84 @@
+import unittest
+
+from tasktracker.models import DONE, Task
+from tasktracker.search import QueryError, search
+
+TASKS = [
+    Task(1, "Fix login bug", ["work", "urgent"]),
+    Task(2, "buy milk", ["home"], DONE),
+    Task(3, "Write REPORT for login review", ["Work"]),
+    Task(4, "fix the login page", []),
+    Task(5, 'read "Dune"', ["books"], DONE),
+]
+
+
+def ids(query):
+    return [task.id for task in search(TASKS, query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(ids(""), [1, 2, 3, 4, 5])
+        self.assertEqual(ids("   \t "), [1, 2, 3, 4, 5])
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(ids("login"), [1, 3, 4])
+        self.assertEqual(ids("LOGIN"), [1, 3, 4])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(ids('"fix login"'), [1])
+        self.assertEqual(ids('"LOGIN   bug"'), [])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(ids("fix login"), [1, 4])
+        self.assertEqual(ids("fix login bug"), [1])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(ids("tag:work"), [1, 3])
+        self.assertEqual(ids("TAG:WORK"), [1, 3])
+        self.assertEqual(ids("tag:wor"), [])
+
+    def test_tag_term_can_be_quoted_for_spaces(self):
+        tasks = [Task(7, "x", ["two words"]), Task(8, "y", ["two"])]
+        self.assertEqual([t.id for t in search(tasks, 'tag:"two words"')], [7])
+
+    def test_status_filters(self):
+        self.assertEqual(ids("status:open"), [1, 3, 4])
+        self.assertEqual(ids("status:done"), [2, 5])
+
+    def test_tag_and_status_combine_with_text(self):
+        self.assertEqual(ids("tag:work status:open login"), [1, 3])
+
+    def test_quoted_field_like_text_is_literal(self):
+        self.assertEqual(ids('"tag:work"'), [])
+        self.assertEqual(ids('"status:open"'), [])
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(TASKS))
+        self.assertEqual([t.id for t in search(reversed_tasks, "login")], [4, 3, 1])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "status:pending")
+
+    def test_empty_field_value_raises(self):
+        for query in ["tag:", "status:"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(TASKS, query)
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, '"fix login')
+
+    def test_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "due:today")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_undo.py b/tests/test_undo.py
new file mode 100644
index 0000000..7e42c3d
--- /dev/null
+++ b/tests/test_undo.py
@@ -0,0 +1,105 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+def titles(store):
+    return [t.title for t in store.all()]
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_add_never_reuses_id(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertEqual(second.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_repeated_complete_restores_previous_status(self):
+        store = TaskStore()
+        task = store.add("write")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("keep me", tags=["a", "b"], due=None)
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status), (task.id, "keep me", ["a", "b"], DONE))
+
+    def test_undo_delete_keeps_snapshot_from_caller_mutation(self):
+        store = TaskStore()
+        task = store.add("x", tags=["t"])
+        deleted = store.delete(task.id)
+        deleted.tags.append("mutated")
+        store.undo()
+        self.assertEqual(store.get(task.id).tags, ["t"])
+
+    def test_undo_walks_back_across_kinds_lifo(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(titles(store), ["a", "b"])
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual(titles(store), ["a"])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_nothing_to_undo_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        store.add("x")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_after_adding_more_tasks_only_touches_latest_change(self):
+        store = TaskStore()
+        a = store.add("a")
+        store.complete(a.id)
+        store.add("b")
+        store.undo()
+        self.assertEqual(titles(store), ["a"])
+        self.assertEqual(store.get(a.id).status, DONE)
+
+
+if __name__ == "__main__":
+    unittest.main()
