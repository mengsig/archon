@@ -0,0 +1,54 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_header_only_when_no_tasks(self):
+        self.assertEqual(to_csv([]), "id,title,tags,status,due\r\n")
+
+    def test_rows_keep_order_and_end_with_crlf(self):
+        tasks = [
+            Task(id=2, title="second", tags=["x"], status=DONE, due=date(2026, 5, 1)),
+            Task(id=1, title="first"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n"
+            "2,second,x,done,2026-05-01\r\n"
+            "1,first,,open,\r\n",
+        )
+
+    def test_tags_joined_with_semicolon(self):
+        tasks = [Task(id=1, title="t", tags=["a", "b", "c"])]
+        self.assertIn("1,t,a;b;c,open,\r\n", to_csv(tasks))
+
+    def test_title_with_comma_is_quoted(self):
+        tasks = [Task(id=1, title="milk, eggs")]
+        self.assertIn('1,"milk, eggs",,open,\r\n', to_csv(tasks))
+
+    def test_title_with_quotes_is_quoted_and_doubled(self):
+        tasks = [Task(id=1, title='say "hi"')]
+        self.assertIn('1,"say ""hi""",,open,\r\n', to_csv(tasks))
+
+    def test_title_with_lf_is_quoted(self):
+        tasks = [Task(id=1, title="line one\nline two")]
+        self.assertIn('1,"line one\nline two",,open,\r\n', to_csv(tasks))
+
+    def test_title_with_cr_is_quoted(self):
+        tasks = [Task(id=1, title="a\rb")]
+        self.assertIn('1,"a\rb",,open,\r\n', to_csv(tasks))
+
+    def test_plain_fields_are_not_quoted(self):
+        tasks = [Task(id=7, title="plain title", tags=["a"], due=date(2026, 1, 2))]
+        self.assertEqual(to_csv(tasks).split("\r\n")[1], "7,plain title,a,open,2026-01-02")
+
+    def test_tag_with_comma_is_quoted(self):
+        tasks = [Task(id=1, title="t", tags=["a,b", "c"])]
+        self.assertIn('1,t,"a,b;c",open,\r\n', to_csv(tasks))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..964622f
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,94 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def make_store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["work"])
+    store.add("write report", tags=["Work", "urgent"])
+    store.add("fix login page")
+    store.add("buy milk", tags=["home-work"])
+    store.complete(2)
+    return store
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = make_store().all()
+
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   ", "\t"]:
+            self.assertEqual(titles(search(self.tasks, query)), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(titles(search(self.tasks, "FIX")), ["Fix login bug", "fix login page"])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(titles(search(self.tasks, "fix bug")), ["Fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix login bug", "fix login page"])
+        self.assertEqual(titles(search(self.tasks, '"login bug"')), ["Fix login bug"])
+        self.assertEqual(titles(search(self.tasks, '"bug fix"')), [])
+
+    def test_quoted_phrase_may_contain_colon(self):
+        store = TaskStore()
+        store.add("fix: login")
+        store.add("fix login")
+        self.assertEqual(titles(search(store.all(), '"fix: login"')), ["fix: login"])
+
+    def test_tabs_separate_terms(self):
+        self.assertEqual(titles(search(self.tasks, "fix\tbug")), ["Fix login bug"])
+
+    def test_quoted_tag_value_with_space(self):
+        store = TaskStore()
+        store.add("a", tags=["big work"])
+        store.add("b", tags=["work"])
+        self.assertEqual(titles(search(store.all(), 'tag:"big work"')), ["a"])
+
+    def test_colon_in_bare_word_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "10:30")
+
+    def test_tag_is_exact_and_case_insensitive(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work")), ["Fix login bug", "write report"])
+        self.assertEqual(titles(search(self.tasks, "TAG:Urgent")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_status_terms(self):
+        self.assertEqual(titles(search(self.tasks, "status:open")), ["Fix login bug", "fix login page", "buy milk"])
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["write report"])
+
+    def test_terms_combine(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work status:done")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, '"fix login" tag:work')), ["Fix login bug"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:closed")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_query_error_raised_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "due:today")
+
+
+if __name__ == "__main__":
+    unittest.main()
