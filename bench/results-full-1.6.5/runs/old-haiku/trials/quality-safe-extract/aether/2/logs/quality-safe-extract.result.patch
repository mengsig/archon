+@unittest.skipUnless(hasattr(os, "symlink"), "symlinks unsupported")
+class SymlinkValidation(unittest.TestCase):
+    def setUp(self):
+        self._temp = tempfile.TemporaryDirectory()
+        self.base = Path(self._temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def tearDown(self):
+        self._temp.cleanup()
+
+    def assert_rejected(self, name):
+        with self.subTest(name=name):
+            root_before = tree_snapshot(self.root)
+            outside_before = tree_snapshot(self.outside)
+            with self.assertRaises(ValueError):
+                extract([("ok", b"1"), (name, b"x")], self.root)
+            self.assertEqual(tree_snapshot(self.root), root_before)
+            self.assertEqual(tree_snapshot(self.outside), outside_before)
+
+    def test_symlink_to_directory_component_is_rejected(self):
+        os.symlink(self.outside, self.root / "link", target_is_directory=True)
+        self.assert_rejected("link/file.txt")
+
+    def test_symlink_to_directory_inside_root_is_rejected(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "link", target_is_directory=True)
+        self.assert_rejected("link/file.txt")
+
+    def test_dangling_symlink_component_is_rejected(self):
+        os.symlink(self.base / "nowhere", self.root / "dangling")
+        self.assert_rejected("dangling/file.txt")
+
+    def test_dangling_symlink_target_is_rejected(self):
+        os.symlink(self.base / "nowhere", self.root / "dangling")
+        self.assert_rejected("dangling")
+
+    def test_symlink_to_file_target_is_rejected(self):
+        target = self.base / "secret.txt"
+        target.write_bytes(b"secret")
+        os.symlink(target, self.root / "link")
+        self.assert_rejected("link")
+        self.assertEqual(target.read_bytes(), b"secret")
+
