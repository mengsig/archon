+
+#[test]
+fn currency_defaults_to_usd_and_accepts_iso_codes() {
+    let implicit = parse_line("2026-03-01\tgroceries\t1").unwrap();
+    assert_eq!(implicit.currency, "USD");
+    let explicit = parse_line("2026-03-01\tgroceries\t1\tEUR").unwrap();
+    assert_eq!(explicit.currency, "EUR");
+    assert_eq!(to_csv_row(&explicit), "2026-03-01,groceries,100,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    let bad_codes = ["eur", "EURO", "E1R", "US", ""];
+    for code in bad_codes {
+        let line = format!("2026-03-01\tx\t1\t{code}");
+        assert!(matches!(parse_line(&line), Err(ParseError::BadCurrency(_))), "{line:?}");
+    }
+}
+
+#[test]
+fn exit_status_distinguishes_currency_errors() {
+    assert_eq!(run_cli("2026-03-01\tx\t1\tXYZW\n"), Some(2));
+    assert_eq!(run_cli("March 1\tx\t1\n"), Some(1));
+    assert_eq!(run_cli("2026-03-01\tx\t1\tGBP\n"), Some(0));
+}
+
+fn run_cli(input: &str) -> Option<i32> {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .expect("spawn ledger");
+    child.stdin.take().expect("piped stdin").write_all(input.as_bytes()).expect("write stdin");
+    child.wait().expect("wait for ledger").code()
+}
