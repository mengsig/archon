+// Follows next_cursor until it is null or absent, returning every item in order.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let query = {};
+  for (;;) {
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error('GET /items response has no items array');
+    }
+    items.push(...body.items);
+    const next = body.next_cursor;
+    if (next === undefined || next === null) return items;
+    if (typeof next !== 'string') {
+      throw new Error(`GET /items returned a non-string next_cursor: ${JSON.stringify(next)}`);
+    }
+    if (seenCursors.has(next)) {
+      throw new Error(`GET /items returned repeated next_cursor ${next}`);
+    }
+    seenCursors.add(next);
+    query = { cursor: next };
+  }
 }
 
