@@ -21,8 +27,55 @@ def handle(request):
 
 
 def list_items(query):
+    limit, error = _parse_limit(query.get("limit"))
+    if error:
+        return _error(400, error)
+    after_id, error = _decode_cursor(query.get("cursor"))
+    if error:
+        return _error(400, error)
+
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    if after_id is not None:
+        items = [item for item in items if item["id"] > after_id]
+    page = items[:limit]
+    has_more = len(items) > limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    assert len(page) <= limit
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT, None
+    limit = _parse_digits(raw)
+    if limit is None or not 1 <= limit <= MAX_LIMIT:
+        return None, f"limit must be an integer from 1 to {MAX_LIMIT}"
+    return limit, None
+
+
+def _encode_cursor(item_id):
+    assert item_id >= 0
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    if raw is None:
+        return None, None
+    try:
+        decoded = base64.b64decode(raw.encode("ascii"), altchars=b"-_", validate=True)
+        decoded_id = _parse_digits(decoded.decode("ascii"))
+    except ValueError:
+        return None, "cursor is invalid"
+    if decoded_id is None:
+        return None, "cursor is invalid"
+    return decoded_id, None
+
+
+def _parse_digits(text):
+    """Return `text` as an int when it is 1..MAX_DIGITS ASCII digits, else None."""
+    if not (text.isascii() and text.isdigit() and len(text) <= MAX_DIGITS):
+        return None
+    return int(text)
 
 
