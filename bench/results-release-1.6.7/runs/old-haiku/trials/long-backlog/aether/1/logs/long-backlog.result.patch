@@ -0,0 +1,81 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task_and_ids_are_not_reused(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        second = store.add("second")
+        self.assertEqual(first.id, 1)
+        self.assertEqual(second.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_task_under_same_id(self):
+        store = TaskStore()
+        store.add("a")
+        task = store.add("b", tags=["work"], due=date(2026, 5, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.title, restored.tags, restored.due, restored.status),
+                         ("b", ["work"], date(2026, 5, 1), DONE))
+        self.assertEqual([t.id for t in store.all()], [1, 2])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.delete(task.id)
+        self.assertEqual(store.undo().id, task.id)
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_repeated_complete_is_undone_one_step_at_a_time(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        store.add("kept")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
