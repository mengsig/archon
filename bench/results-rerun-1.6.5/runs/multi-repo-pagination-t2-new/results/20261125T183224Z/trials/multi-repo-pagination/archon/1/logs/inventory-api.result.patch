diff --git a/test_api.py b/test_api.py
index 55cd1fd..cd6a8d4 100644
--- a/test_api.py
+++ b/test_api.py
@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,58 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20_with_next_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsInstance(body["next_cursor"], str)
+
+    def test_paging_follows_next_cursor_to_the_end(self):
+        seen = []
+        cursor = None
+        while True:
+            body = get("/items", limit="10", **({"cursor": cursor} if cursor else {}))["body"]
+            seen.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="20", cursor=cursor_after(40))["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_fit_on_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="7", cursor=cursor_after(50))["body"]
+        self.assertEqual(len(body["items"]), 7)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_the_end_gives_empty_page(self):
+        body = get("/items", cursor=cursor_after(57))["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_invalid_limit_is_400(self):
+        for raw in ["0", "101", "-1", "abc", "", "1.5", " 5", "9" * 5000]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["", "!!!", "bm90LWEtbnVtYmVy", "%%%", "!!MTA=", cursor_after("9" * 5000)]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+
+def cursor_after(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
 
 if __name__ == "__main__":
     unittest.main()
