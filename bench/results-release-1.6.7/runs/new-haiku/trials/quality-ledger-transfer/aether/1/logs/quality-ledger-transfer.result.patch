+class LedgerConcurrency(unittest.TestCase):
+    ROUNDS = 1000
+
+    def test_opposite_transfers_preserve_total(self):
+        ledger = Ledger({"a": 500, "b": 500})
+
+        def move(source, destination):
+            for _ in range(self.ROUNDS):
+                ledger.transfer(source, destination, 1)
+
+        threads = [
+            threading.Thread(target=move, args=("a", "b")),
+            threading.Thread(target=move, args=("b", "a")),
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+        snap = ledger.snapshot()
+        self.assertEqual(snap["a"] + snap["b"], 1000)
+        self.assertTrue(all(0 <= balance <= 1000 for balance in snap.values()))
+
+    def test_snapshots_never_see_a_half_transfer(self):
+        ledger = Ledger({"a": 1, "b": 0})
+        stop = threading.Event()
+
+        def bounce():
+            try:
+                for _ in range(self.ROUNDS):
+                    ledger.transfer("a", "b", 1)
+                    ledger.transfer("b", "a", 1)
+            finally:
+                stop.set()
+
+        worker = threading.Thread(target=bounce)
+        worker.start()
+        while not stop.is_set():
+            self.assertEqual(sum(ledger.snapshot().values()), 1)
+        worker.join()
+        self.assertEqual(sum(ledger.snapshot().values()), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
