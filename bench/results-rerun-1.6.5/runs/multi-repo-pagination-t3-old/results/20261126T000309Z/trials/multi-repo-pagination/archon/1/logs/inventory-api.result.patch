diff --git a/test_api.py b/test_api.py
index 55cd1fd..b4189fe 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,56 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_defaults_to_twenty_items(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_walking_next_cursor_returns_every_item_once(self):
+        seen = []
+        query = {"limit": "10"}
+        for _ in range(10):
+            body = get("/items", **query)["body"]
+            seen.extend(item["id"] for item in body["items"])
+            if body["next_cursor"] is None:
+                break
+            query = {"limit": "10", "cursor": body["next_cursor"]}
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="50", cursor="50")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(51, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_exactly_filling_limit_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_end_is_empty_page(self):
+        body = get("/items", cursor="999")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for raw in ["0", "101", "-1", "abc", "1.5", "", " 5", "٥"]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_oversized_digit_strings_are_400_not_crash(self):
+        self.assertEqual(get("/items", limit="1" * 5000)["status"], 400)
+        self.assertEqual(get("/items", cursor="9" * 5000)["status"], 400)
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["", "abc", "-3", "1.0"]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertEqual(res["body"], {"error": "cursor is invalid"})
+
 
 if __name__ == "__main__":
     unittest.main()
