@@ -24,6 +24,62 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size(self):
+        res = get("/items")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_limit_bounds_accepted(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_full_page_with_nothing_after_has_null_next_cursor(self):
+        # Items 1..57: 19 per page gives 19, 19, 19 and then no more pages.
+        res = get("/items", limit="19", cursor="38")
+        self.assertEqual(len(res["body"]["items"]), 19)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_invalid_limit_returns_400(self):
+        for limit in ("0", "101", "-1", "abc", "1.5", "", " 5", "9" * 30):
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("error", res["body"])
+
+    def test_walking_pages_returns_every_item_once_in_order(self):
+        all_ids = [item["id"] for item in get("/items", limit="100")["body"]["items"]]
+        walked = []
+        cursor = None
+        while True:
+            query = {"limit": "5"} if cursor is None else {"limit": "5", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            walked.extend(item["id"] for item in res["body"]["items"])
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(walked, all_ids)
+        self.assertEqual(walked, sorted(set(walked)))
+
+    def test_last_page_has_null_next_cursor(self):
+        # Items have ids 1..57, so the items after id 40 are 41..57 (17 items).
+        res = get("/items", limit="20", cursor="40")
+        self.assertEqual([item["id"] for item in res["body"]["items"]][-1], 57)
+        self.assertEqual(len(res["body"]["items"]), 17)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_invalid_cursor_returns_400(self):
+        for cursor in ("", "abc", "-3", "1.5", "9" * 30):
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("error", res["body"])
+
+    def test_repeated_or_non_string_params_return_400(self):
+        for query in ({"limit": ["5", "6"]}, {"limit": 5}, {"cursor": ["1"]}, {"cursor": 1}):
+            res = handle({"method": "GET", "path": "/items", "query": query})
+            self.assertEqual(res["status"], 400, query)
+            self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
