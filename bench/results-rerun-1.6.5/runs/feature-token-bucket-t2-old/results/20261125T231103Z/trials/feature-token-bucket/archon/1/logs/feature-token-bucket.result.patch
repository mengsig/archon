+class KeyedLimiterTest(unittest.TestCase):
+    def test_invalid_params_rejected(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0, clock=FakeClock())
+        for max_keys in (0, -1):
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_max_keys_must_be_int(self):
+        with self.assertRaises(TypeError):
+            KeyedLimiter(1, 1.0, max_keys=2.0, clock=FakeClock())
+
+    def test_keys_created_on_first_use(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_invalid_request_does_not_create_key(self):
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", n=3)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", n=0)
+        self.assertEqual(len(limiter), 0)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")  # "a" is now most recent
+        limiter.try_acquire("c")  # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("c"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # "a" becomes most recent; "b" is evicted next
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_failed_bucket_construction_keeps_tracked_keys(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=clock)
+        limiter.try_acquire("a")
+        clock.now = float("nan")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b")
+        self.assertEqual(len(limiter), 1)
+        self.assertIn("a", limiter._buckets)
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(len(limiter), 1)
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_keyed_wait_time_matches_bucket(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, clock=clock)
+        limiter.try_acquire("a", n=2)
+        self.assertAlmostEqual(limiter.wait_time("a", n=2), 2.0)
+        self.assertEqual(limiter.wait_time("b", n=2), 0.0)
+
+
 if __name__ == "__main__":
