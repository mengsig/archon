diff --git a/test_api.py b/test_api.py
index 55cd1fd..255f884 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,62 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_has_twenty_items_and_a_next_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_following_cursors_yields_every_item_in_order(self):
+        ids = []
+        for page in all_pages(limit="10"):
+            self.assertLessEqual(len(page["items"]), 10)
+            ids.extend(item["id"] for item in page["items"])
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_fit_has_null_next_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_resumes_after_its_last_item(self):
+        first = get("/items", limit="5")["body"]
+        second = get("/items", limit="5", cursor=first["next_cursor"])["body"]
+        self.assertEqual([item["id"] for item in second["items"]], list(range(6, 11)))
+
+    def test_limit_must_be_an_integer_from_1_to_100(self):
+        for raw in ["0", "101", "-1", "1.5", "", "x", "1000", " 5"]:
+            res = get("/items", limit=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("error", res["body"], raw)
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_malformed_cursor_is_rejected(self):
+        for raw in ["", "!!!", "YWJj", "a b", "*"]:
+            res = get("/items", cursor=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("error", res["body"], raw)
+
+
+def all_pages(limit):
+    """Yield every page of `GET /items` at the given limit, following cursors."""
+    cursor = None
+    while True:
+        query = {"limit": limit}
+        if cursor is not None:
+            query["cursor"] = cursor
+        page = get("/items", **query)
+        assert page["status"] == 200
+        yield page["body"]
+        cursor = page["body"]["next_cursor"]
+        if cursor is None:
+            return
+
 
 if __name__ == "__main__":
     unittest.main()
