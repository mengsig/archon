+import unittest
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+
+class CsvExportTest(unittest.TestCase):
+    def test_quotes_special_fields_and_uses_crlf(self):
+        store = TaskStore()
+        store.add('say "hi", then\nleave', tags=["a,b", 'c"d'])
+        self.assertEqual(to_csv(store.all()), 'id,title,tags,status,due\r\n1,"say ""hi"", then\nleave","a,b;c""d",open,\r\n')
+
+
+if __name__ == "__main__":
+    unittest.main()
