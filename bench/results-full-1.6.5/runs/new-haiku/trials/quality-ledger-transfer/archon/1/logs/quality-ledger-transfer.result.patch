+class LedgerHalfTransfer(unittest.TestCase):
+    def test_snapshot_taken_mid_transfer_sees_no_half_transfer(self):
+        # Reaches into _balances to pause a transfer deterministically.
+        ledger = Ledger({"a": 10, "b": 0})
+        readers = []
+        observed = []
+
+        def snapshot_from_another_thread():
+            reader = threading.Thread(
+                target=lambda: observed.append(ledger.snapshot()), daemon=True
+            )
+            readers.append(reader)
+            reader.start()
+            reader.join(HALF_TRANSFER_WAIT_SECONDS)
+
+        ledger._balances = _HookAfterFirstWrite(ledger._balances, snapshot_from_another_thread)
+        self.assertIs(ledger.transfer("a", "b", 10), True)
+        for reader in readers:
+            reader.join(JOIN_TIMEOUT_SECONDS)
+        self.assertEqual(observed, [{"a": 0, "b": 10}])
+
