 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _validate_batch(entries)
+    root_path = _validate_root(root)
+    names = [name for name, _ in entries]
+    for name in names:
+        _check_target(root_path, name)
+    for name, data in entries:
+        _write_entry(root_path, name, data)
+    return names
+
+
+def _validate_batch(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    names = [_validate_entry(entry) for entry in entries]
+    _validate_name_set(names)
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, got {type(entry).__name__}")
+    name, data = entry
+    _validate_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes")
+    return name
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, not {type(name).__name__}")
+    if name == "":
+        raise ValueError("name must not be empty")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name {name!r} contains a forbidden character")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"name {name!r} has an invalid path component")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name {name!r} is not valid UTF-8 text") from exc
+
+
+def _validate_name_set(names):
+    unique = set(names)
+    if len(unique) != len(names):
+        raise ValueError("duplicate entry names in batch")
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in unique:
+                raise ValueError(f"{name!r} collides with file {ancestor!r}")
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or str(root) == "":
+        raise ValueError("root must be a non-empty str or Path")
+    root_path = Path(root)
+    if ".." in root_path.parts:
+        raise ValueError(f"root {root!r} must not contain '..' components")
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root {root!r} does not exist") from exc
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root {root!r} must be a real directory, not a link or file")
+    return root_path
+
+
+def _check_target(root, name):
+    """Raise ValueError if creating `name` under `root` would conflict."""
+    parts = name.split("/")
+    current = root
+    for depth, part in enumerate(parts):
+        current = os.path.join(current, part)
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"{name!r} passes through or targets a symlink")
+        if depth == len(parts) - 1:
+            raise ValueError(f"{name!r} already exists")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"{name!r}: ancestor {part!r} is not a directory")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_entry(root, name, data):
+    target = os.path.join(root, *name.split("/"))
+    parent = os.path.dirname(target)
+    os.makedirs(parent, exist_ok=True)
+    assert os.path.isdir(parent), f"parent of {target!r} was not created"
+    with open(target, "xb") as handle:
+        handle.write(data)
