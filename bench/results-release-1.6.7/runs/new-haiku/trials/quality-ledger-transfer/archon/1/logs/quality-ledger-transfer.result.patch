+def run_workers(test, workers):
+    """Run each worker in its own thread; fail on any worker error or hang."""
+    errors = []
+
+    def guarded(work):
+        try:
+            work()
+        except Exception as exc:
+            errors.append(exc)
+
+    threads = [threading.Thread(target=guarded, args=(w,), daemon=True) for w in workers]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(JOIN_TIMEOUT_SECONDS)
+    test.assertFalse(any(t.is_alive() for t in threads), "worker hung: possible deadlock")
+    test.assertEqual(errors, [])
+
+
+class Concurrency(unittest.TestCase):
+    def test_concurrent_transfers_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000, "c": 1000})
+        pairs = [("a", "b"), ("b", "c"), ("c", "a"), ("b", "a")]
+
+        def worker(source, destination):
+            def run():
+                for _ in range(ROUNDS):
+                    ledger.transfer(source, destination, 1)
+            return run
+
+        run_workers(self, [worker(s, d) for s, d in pairs for _ in range(2)])
+        snap = ledger.snapshot()
+        self.assertEqual(sum(snap.values()), 3000)
+        self.assertTrue(all(balance >= 0 for balance in snap.values()))
+
+    def test_opposite_direction_transfers_complete(self):
+        ledger = Ledger({"a": ROUNDS, "b": ROUNDS})
+        moved_forward = []
+        moved_backward = []
+
+        def forward():
+            moved_forward.append(sum(ledger.transfer("a", "b", 1) for _ in range(ROUNDS)))
+
+        def backward():
+            moved_backward.append(sum(ledger.transfer("b", "a", 1) for _ in range(ROUNDS)))
+
+        run_workers(self, [forward, backward] * 2)
+        net = sum(moved_forward) - sum(moved_backward)
+        self.assertEqual(ledger.snapshot(), {"a": ROUNDS - net, "b": ROUNDS + net})
+
+    def test_snapshots_never_observe_half_transfer(self):
+        ledger = Ledger({"a": ROUNDS, "b": 0})
+
+        def writer():
+            for _ in range(ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def reader():
+            for _ in range(ROUNDS):
+                self.assertEqual(sum(ledger.snapshot().values()), ROUNDS)
+
+        run_workers(self, [writer, reader])
+
+    def test_snapshot_during_paused_transfer_sees_no_half_transfer(self):
+        ledger = Ledger({"a": 1, "b": 0})
+        paused = threading.Event()
+        release = threading.Event()
+        ledger._balances = PausingDict(ledger._balances, "b", paused, release)
+        snapshots = []
+        writer = threading.Thread(target=ledger.transfer, args=("a", "b", 1), daemon=True)
+        reader = threading.Thread(target=lambda: snapshots.append(ledger.snapshot()), daemon=True)
+        writer.start()
+        try:
+            self.assertTrue(paused.wait(JOIN_TIMEOUT_SECONDS), "transfer never paused")
+            reader.start()
+            # Long enough for a lock-free snapshot to finish while the transfer is paused.
+            reader.join(PROBE_SECONDS)
+        finally:
+            release.set()
+        writer.join(JOIN_TIMEOUT_SECONDS)
+        reader.join(JOIN_TIMEOUT_SECONDS)
+        self.assertFalse(writer.is_alive() or reader.is_alive(), "worker hung: possible deadlock")
+        self.assertEqual(snapshots, [{"a": 0, "b": 1}])
+
+
