+
+
+class RetryValidation(unittest.TestCase):
+    def assertRejects(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_float_and_int_subclasses(self):
+        self.assertRejects(True, 0)
+        self.assertRejects(1, False)
+        self.assertRejects(1.0, 0)
+        self.assertRejects(1, 0, base_ms=100.0)
+        self.assertRejects(1, 0, cap_ms=True)
+        self.assertRejects(1, 0, budget_ms=IntLike(5))
+        self.assertRejects(1, 0, max_attempts=Color.RED)
+
+    def test_rejects_non_numbers(self):
+        self.assertRejects("1", 0)
+        self.assertRejects(1, None)
+        self.assertRejects(1, 0, retry_after_ms="10")
+
+    def test_rejects_attempt_and_max_attempts_below_one(self):
+        self.assertRejects(0, 0)
+        self.assertRejects(-1, 0)
+        self.assertRejects(1, 0, max_attempts=0)
+
+    def test_rejects_negative_values(self):
+        self.assertRejects(1, -1)
+        self.assertRejects(1, 0, budget_ms=-1)
+        self.assertRejects(1, 0, base_ms=-1)
+        self.assertRejects(1, 0, cap_ms=-1)
+        self.assertRejects(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_attempt_limit_return(self):
+        self.assertRejects(4, -1, max_attempts=1)
+        self.assertRejects(5, 0, max_attempts=1, base_ms=-1)
+
+    def test_validates_before_budget_return(self):
+        self.assertRejects(1, 1000, base_ms=-1)
+        self.assertRejects(1, 0, budget_ms=0, retry_after_ms=-5)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_greater_than_max_attempts_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_last_allowed_attempt_still_gets_a_retry(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(5, 0, base_ms=0, max_attempts=10), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, cap_ms=0, base_ms=500), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(
+            retry_delay(10**6, 0, max_attempts=10**7, budget_ms=10**9), 400)
+
+    def test_huge_base_and_cap_do_not_overflow(self):
+        big = 10**400
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=big, cap_ms=big, budget_ms=2 * big), big)
+
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=900, cap_ms=400, budget_ms=2000), 900)
+
+    def test_budget_boundary_is_exclusive(self):
+        self.assertIsNone(retry_delay(1, 900))
+        self.assertEqual(retry_delay(1, 899), 100)
+
+    def test_retry_after_pushing_past_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=999), 999)
+
+    def test_zero_budget_allows_no_retry(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+    def test_zero_delay_is_returned_inside_budget(self):
+        self.assertEqual(retry_delay(1, 999, base_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
