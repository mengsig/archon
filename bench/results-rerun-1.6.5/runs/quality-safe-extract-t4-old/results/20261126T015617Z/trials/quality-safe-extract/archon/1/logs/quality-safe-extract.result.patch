+import os
 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
@@ -18,3 +20,250 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+_DEFAULT_ROOT = object()
+
+
+def _snapshot(base):
+    """List every path under base without following symlinks."""
+    found = []
+    for dirpath, dirnames, filenames in os.walk(base):
+        for name in dirnames + filenames:
+            found.append(os.path.relpath(os.path.join(dirpath, name), base))
+    return sorted(found)
+
+
+class ExtractTestCase(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.base = Path(tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertRejected(self, entries, root=_DEFAULT_ROOT):
+        before = _snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is _DEFAULT_ROOT else root)
+        self.assertEqual(_snapshot(self.base), before)
+
+
+class RejectsNonListBatch(ExtractTestCase):
+    def test_tuple_batch(self):
+        self.assertRejected((("a", b"x"),))
+
+    def test_empty_tuple_batch(self):
+        self.assertRejected(())
+
+    def test_generator_is_rejected_and_not_consumed(self):
+        gen = ((name, b"x") for name in ["a", "b"])
+        self.assertRejected(gen)
+        self.assertEqual(list(gen), [("a", b"x"), ("b", b"x")])
+
+    def test_iterator_is_rejected_and_not_consumed(self):
+        it = iter([("a", b"x")])
+        self.assertRejected(it)
+        self.assertEqual(list(it), [("a", b"x")])
+
+    def test_none_batch(self):
+        self.assertRejected(None)
+
+
+class MalformedEntries(ExtractTestCase):
+    def test_entry_that_is_not_a_tuple(self):
+        for entry in (["a", b"x"], "a", b"ax", {"a": b"x"}):
+            with self.subTest(entry=entry):
+                self.assertRejected([entry])
+
+    def test_entry_with_wrong_arity(self):
+        for entry in ((), ("a",), ("a", b"x", b"y")):
+            with self.subTest(entry=entry):
+                self.assertRejected([entry])
+
+    def test_non_string_names(self):
+        for name in (b"a", None, 3, Path("a")):
+            with self.subTest(name=name):
+                self.assertRejected([(name, b"x")])
+
+    def test_non_bytes_data(self):
+        for data in ("text", None, 0, bytearray(b"x")):
+            with self.subTest(data=data):
+                self.assertRejected([("a", data)])
+
+    def test_invalid_entry_after_valid_ones_creates_nothing(self):
+        self.assertRejected([("ok/new.txt", b"x"), ("bad", "not bytes")])
+
+
+class NameRules(ExtractTestCase):
+    def test_invalid_names_are_rejected(self):
+        names = [
+            "", "/abs", "/", "a\\b", "C:/x", "c:x", "a:b", "a\0b",
+            "a//b", "a/", "./a", "a/./b", "a/../b", "..", ".", "a/..",
+        ]
+        for name in names:
+            with self.subTest(name=name):
+                self.assertRejected([(name, b"x")])
+
+    def test_surrogate_name_is_rejected(self):
+        self.assertRejected([("bad\udcff", b"x")])
+
+    def test_valid_literal_names_are_kept_unchanged(self):
+        names = ["a%2Fb", "100%", "a..b", "...", ".hidden", "with space", "é.txt"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
+        self.assertEqual(sorted(os.listdir(self.root)), sorted(names))
+        self.assertEqual((self.root / "a%2Fb").read_bytes(), b"x")
+
+
+class BatchConflicts(ExtractTestCase):
+    def test_duplicate_name(self):
+        self.assertRejected([("a", b"1"), ("a", b"2")])
+
+    def test_file_then_directory_collision(self):
+        self.assertRejected([("a", b"1"), ("a/b", b"2")])
+
+    def test_directory_then_file_collision(self):
+        self.assertRejected([("a/b", b"2"), ("a", b"1")])
+
+    def test_deep_collision(self):
+        self.assertRejected([("a/b/c", b"1"), ("a/b", b"2")])
+
+    def test_similar_names_do_not_collide(self):
+        entries = [("a/b", b"1"), ("a/c", b"2"), ("ab", b"3")]
+        self.assertEqual(extract(entries, self.root), ["a/b", "a/c", "ab"])
+
+    def test_collision_later_in_batch_creates_nothing(self):
+        self.assertRejected([("new/x", b"1"), ("ok", b"2"), ("new/x/y", b"3")])
+
+
+class RootRules(ExtractTestCase):
+    def test_missing_root_rejected_for_string_and_path(self):
+        missing = self.base / "missing"
+        self.assertRejected([("a", b"x")], root=str(missing))
+        self.assertRejected([("a", b"x")], root=missing)
+
+    def test_empty_batch_still_validates_root(self):
+        self.assertRejected([], root=self.base / "missing")
+
+    def test_root_is_a_regular_file(self):
+        file_root = self.base / "file"
+        file_root.write_bytes(b"x")
+        self.assertRejected([("a", b"x")], root=file_root)
+
+    def test_root_below_a_regular_file(self):
+        (self.base / "file").write_bytes(b"x")
+        self.assertRejected([("a", b"x")], root=self.base / "file" / "child")
+
+    def test_root_that_is_a_symlink_to_a_directory(self):
+        target = self.base / "target"
+        target.mkdir()
+        link = self.base / "link"
+        os.symlink(target, link)
+        self.assertRejected([("a", b"x")], root=link)
+        self.assertRejected([("a", b"x")], root=str(link) + "/")
+
+    def test_empty_string_root(self):
+        self.assertRejected([("a", b"x")], root="")
+
+    def test_non_path_root(self):
+        for root in (3, None, b"bytes-root"):
+            with self.subTest(root=root):
+                self.assertRejected([("a", b"x")], root=root)
+
+    def test_valid_string_root_with_trailing_slash(self):
+        self.assertEqual(extract([("a", b"x")], str(self.root) + "/"), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"x")
+
+    def test_empty_batch_on_valid_root_creates_nothing(self):
+        self.assertEqual(extract([], self.root), [])
+        self.assertEqual(_snapshot(self.root), [])
+
+
+class ExistingPaths(ExtractTestCase):
+    def test_existing_file_is_not_overwritten(self):
+        (self.root / "a").write_bytes(b"keep")
+        self.assertRejected([("a", b"new")])
+        self.assertEqual((self.root / "a").read_bytes(), b"keep")
+
+    def test_existing_directory_is_a_conflict(self):
+        (self.root / "docs").mkdir()
+        self.assertRejected([("docs", b"x")])
+
+    def test_regular_file_as_ancestor(self):
+        (self.root / "f").write_bytes(b"keep")
+        self.assertRejected([("f/x", b"x")])
+        self.assertEqual((self.root / "f").read_bytes(), b"keep")
+
+    def test_symlink_to_file_as_target_is_not_followed(self):
+        outside = self.base / "outside.txt"
+        outside.write_bytes(b"keep")
+        os.symlink(outside, self.root / "a")
+        self.assertRejected([("a", b"new")])
+        self.assertEqual(outside.read_bytes(), b"keep")
+
+    def test_dangling_symlink_as_target(self):
+        os.symlink(self.base / "nowhere", self.root / "dangling")
+        self.assertRejected([("dangling", b"x")])
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_symlink_to_directory_as_ancestor_is_not_followed(self):
+        outside = self.base / "outside"
+        outside.mkdir()
+        os.symlink(outside, self.root / "link")
+        self.assertRejected([("link/x", b"x")])
+        self.assertEqual(_snapshot(outside), [])
+
+    def test_dangling_symlink_as_ancestor_is_not_followed(self):
+        os.symlink(self.base / "nowhere", self.root / "dangling")
+        self.assertRejected([("dangling/x", b"x")])
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_symlink_deeper_in_existing_tree(self):
+        (self.root / "docs").mkdir()
+        outside = self.base / "outside"
+        outside.mkdir()
+        os.symlink(outside, self.root / "docs" / "link")
+        self.assertRejected([("docs/link/x", b"x")])
+        self.assertEqual(_snapshot(outside), [])
+
+
+class IoErrorsPropagate(ExtractTestCase):
+    def test_unexpected_os_error_during_validation_is_not_hidden(self):
+        with mock.patch("safe_extract.os.lstat", side_effect=PermissionError("denied")):
+            with self.assertRaises(PermissionError):
+                extract([("a", b"x")], self.root)
+        self.assertEqual(_snapshot(self.base), ["root"])
+
+    def test_existing_path_later_in_batch_creates_nothing(self):
+        (self.root / "existing").write_bytes(b"keep")
+        self.assertRejected([("ok", b"1"), ("existing", b"2")])
+        self.assertEqual((self.root / "existing").read_bytes(), b"keep")
+
+
+class WritesFiles(ExtractTestCase):
+    def test_exact_bytes_including_binary_and_empty(self):
+        payload = bytes(range(256))
+        extract([("bin", payload), ("empty", b"")], self.root)
+        self.assertEqual((self.root / "bin").read_bytes(), payload)
+        self.assertEqual((self.root / "empty").read_bytes(), b"")
+
+    def test_creates_missing_parents_and_keeps_existing_siblings(self):
+        (self.root / "docs").mkdir()
+        (self.root / "docs" / "keep.txt").write_bytes(b"keep")
+        entries = [("docs/new/deep/file.txt", b"x"), ("docs/other.txt", b"y")]
+        self.assertEqual(extract(entries, self.root), [n for n, _ in entries])
+        self.assertEqual((self.root / "docs/new/deep/file.txt").read_bytes(), b"x")
+        self.assertEqual((self.root / "docs/other.txt").read_bytes(), b"y")
+        self.assertEqual((self.root / "docs/keep.txt").read_bytes(), b"keep")
+
+    def test_returns_names_in_input_order(self):
+        names = ["z.txt", "a/b.txt", "m", "a/a.txt"]
+        entries = [(name, b"") for name in names]
+        self.assertEqual(extract(entries, self.root), names)
+
+    def test_path_and_string_roots_are_equivalent(self):
+        for index, root in enumerate((self.root, str(self.root))):
+            with self.subTest(root_type=type(root).__name__):
+                name = f"f{index}"
+                self.assertEqual(extract([(name, b"x")], root), [name])
