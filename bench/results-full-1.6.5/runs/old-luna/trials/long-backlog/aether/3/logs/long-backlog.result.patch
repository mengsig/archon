@@ -0,0 +1,42 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_failed_operations_do_not_add_history(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add(" ")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_walks_back_and_ids_are_not_reused(self):
+        store = TaskStore()
+        task = store.add("original", ["x"], date(2026, 4, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.title, restored.tags, restored.due, restored.status),
+                         ("original", ["x"], date(2026, 4, 1), "done"))
+        store.undo()
+        self.assertEqual(restored.status, "open")
+        store.undo()
+        with self.assertRaises(KeyError):
+            store.get(task.id)
+        next_task = store.add("next")
+        store.undo()
+        self.assertEqual(store.add("later").id, next_task.id + 1)
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
