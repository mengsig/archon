+
+#[test]
+fn cli_reports_currency_errors_with_status_two_and_other_errors_with_status_one() {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let run = |input: &str| {
+        let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+            .stdin(Stdio::piped())
+            .stderr(Stdio::piped())
+            .stdout(Stdio::null())
+            .spawn()
+            .unwrap();
+        child
+            .stdin
+            .take()
+            .unwrap()
+            .write_all(input.as_bytes())
+            .unwrap();
+        child.wait_with_output().unwrap()
+    };
+    let malformed = run("\n2026-03-01\ta\t1\tusd\n");
+    assert_eq!(malformed.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&malformed.stderr).contains("line 2:"));
+    assert_eq!(run("2026-03-01\ta\tbad\n").status.code(), Some(1));
+}
