+function paginated(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    const index = seen.length - 1;
+    return { status: 200, body: pages[index] };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages until it is null', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'abc' },
+    { items: [ITEMS[1]], next_cursor: null },
+  ];
+  const { transport, seen } = paginated(pages);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}, { cursor: 'abc' }]);
+});
+
+test('treats a missing next_cursor as the last page', async () => {
+  const { transport, seen } = paginated([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('rejects a server that repeats a cursor', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'same' },
+    { items: [ITEMS[1]], next_cursor: 'same' },
+  ];
+  await assert.rejects(listItems(paginated(pages).transport), /repeated cursor/);
+});
+
