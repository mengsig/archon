+class RootValidation(TempRootCase):
+    def test_str_and_path_roots_accepted(self):
+        self.assertEqual(extract([("x", b"1")], str(self.root)), ["x"])
+        self.assertEqual(extract([("y", b"2")], self.root), ["y"])
+
+    def test_invalid_root_types_rejected(self):
