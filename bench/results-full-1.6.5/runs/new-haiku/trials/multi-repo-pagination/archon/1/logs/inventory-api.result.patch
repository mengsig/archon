diff --git a/test_api.py b/test_api.py
index 55cd1fd..4aeabac 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,65 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20(self):
+        res = get("/items")
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(1, 21)))
+        self.assertEqual(res["body"]["next_cursor"], "20")
+
+    def test_max_limit_returns_up_to_100(self):
+        res = get("/items", limit="100")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_limit_out_of_range_is_400(self):
+        for raw in ["0", "101", "-1", "1.5", "abc", "", " 5", "+5", "٢"]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["abc", "-1", "", "1.5"]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("cursor", res["body"]["error"])
+
+    def test_pages_cover_all_items_without_gaps_or_duplicates(self):
+        seen = []
+        cursor = None
+        pages = 0
+        while True:
+            query = {"limit": "10"}
+            if cursor is not None:
+                query["cursor"] = cursor
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            seen.extend(item["id"] for item in res["body"]["items"])
+            pages += 1
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(pages, 6)
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        res = get("/items", limit="20", cursor="40")
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(41, 58)))
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_page_ending_exactly_at_last_item_has_null_cursor(self):
+        res = get("/items", limit="57")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_cursor_past_last_item_is_empty_page(self):
+        res = get("/items", cursor="999")
+        self.assertEqual(res["body"], {"items": [], "next_cursor": None})
+
 
 if __name__ == "__main__":
     unittest.main()
