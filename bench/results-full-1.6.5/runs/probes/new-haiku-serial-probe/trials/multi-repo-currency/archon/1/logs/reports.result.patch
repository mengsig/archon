-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+Accepts the header `date,account,amount_cents,currency` and the older
+`date,account,amount_cents` (rows then count as USD).
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+OLD_FIELDS = ["date", "account", "amount_cents"]
+NEW_FIELDS = OLD_FIELDS + ["currency"]
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
+
+
+class MalformedCurrency(Exception):
+    pass
+
+
+def parse_currency(code, line_no):
+    if not CURRENCY_PATTERN.fullmatch(code or ""):
+        raise MalformedCurrency(f"line {line_no}: malformed currency code {code!r}")
+    return code
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(reader):
+    """{(account, currency): total_cents} from a CSV DictReader."""
+    fields = reader.fieldnames
+    if fields is None:
+        return {}
+    if fields not in (OLD_FIELDS, NEW_FIELDS):
+        raise ValueError(f"unexpected CSV header: {','.join(fields)}")
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        line_no = reader.line_num
+        currency = parse_currency(
+            row["currency"] if "currency" in fields else DEFAULT_CURRENCY,
+            line_no,
+        )
+        key = (row["account"], currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(csv.DictReader(sys.stdin))
+    except MalformedCurrency as err:
+        sys.stderr.write(f"reports: {err}\n")
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
