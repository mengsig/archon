 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _is_valid_integer(value):
+    return type(value) is int and 0 <= value <= MAX_BALANCE
+
+
+def _validate_balances(balances):
+    if type(balances) is not dict:
+        raise ValueError("balances must be a dict")
+    for name, balance in balances.items():
+        if type(name) is not str or not name:
+            raise ValueError(f"invalid account name: {name!r}")
+        if not _is_valid_integer(balance):
+            raise ValueError(f"invalid balance for {name!r}: {balance!r}")
+
+
+def _validate_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"invalid amount: {amount!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        _validate_balances(balances)
+        self._lock = threading.Lock()
+        self._balances = dict(balances)
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _validate_amount(amount)
+        with self._lock:
+            self._check_accounts(source, destination)
+            if source == destination:
+                return self._balances[source] >= amount
+            return self._move(source, destination, amount)
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _check_accounts(self, source, destination):
+        for name in (source, destination):
+            if type(name) is not str or name not in self._balances:
+                raise KeyError(name)
+
+    def _move(self, source, destination, amount):
+        """Caller must hold the lock and have verified both accounts exist."""
+        source_balance = self._balances[source]
+        destination_balance = self._balances[destination]
+        if source_balance < amount:
+            return False
+        if destination_balance + amount > MAX_BALANCE:
+            return False
+        self._balances[source] = source_balance - amount
+        self._balances[destination] = destination_balance + amount
+        assert self._balances[source] >= 0
+        assert self._balances[destination] <= MAX_BALANCE
+        return True
