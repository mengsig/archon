+class LedgerConstruction(unittest.TestCase):
+    def test_empty_ledger_is_allowed(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_non_dict_input_is_rejected(self):
+        for value in (None, [("a", 1)], "ab"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    Ledger(value)
+
+    def test_invalid_names_are_rejected(self):
+        for name in ("", 1, None, b"a"):
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    Ledger({name: 1})
+
+    def test_invalid_balances_are_rejected(self):
+        for balance in (-1, MAX_BALANCE + 1, 1.0, "3", True, None):
+            with self.subTest(balance=balance):
+                with self.assertRaises(ValueError):
+                    Ledger({"a": balance})
+
+    def test_boundary_balances_are_accepted(self):
+        self.assertEqual(Ledger({"a": 0, "b": MAX_BALANCE}).snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+    def test_input_dict_is_copied(self):
+        source = {"a": 1}
+        ledger = Ledger(source)
+        source["a"] = 99
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
+    def test_snapshot_is_a_copy(self):
+        ledger = Ledger({"a": 1})
+        snap = ledger.snapshot()
+        snap["a"] = 99
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
