+class LedgerConcurrency(unittest.TestCase):
+    THREADS = 8
+    ROUNDS = 500
+    JOIN_TIMEOUT = 10
+
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        errors = []
+
+        def worker(src, dst):
+            try:
+                for _ in range(self.ROUNDS):
+                    ledger.transfer(src, dst, 1)
+                    ledger.transfer(dst, src, 1)
+            except Exception as exc:
+                errors.append(exc)
+
+        threads = []
+        for i in range(self.THREADS):
+            pair = ("a", "b") if i % 2 == 0 else ("b", "a")
+            threads.append(threading.Thread(target=worker, args=pair, daemon=True))
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.JOIN_TIMEOUT)
+
+        self.assertFalse(any(t.is_alive() for t in threads), "possible deadlock")
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+
+if __name__ == "__main__":
+    unittest.main()
