diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..ec9a488
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,50 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn default_currency_is_usd() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn explicit_currency_is_emitted() {
+    let out = run_ledger("2026-03-01\tgroceries\t1\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert!(String::from_utf8_lossy(&out.stdout).ends_with("2026-03-01,groceries,100,EUR\n"));
+}
+
+#[test]
+fn malformed_currency_exits_2_naming_line() {
+    let out = run_ledger("2026-03-01\tgroceries\t1\n\n2026-03-02\trent\t2\teur\n");
+    assert_eq!(out.status.code(), Some(2));
+    let stderr = String::from_utf8_lossy(&out.stderr);
+    assert!(stderr.starts_with("line 3: "), "stderr was {stderr:?}");
+}
+
+#[test]
+fn other_input_errors_exit_1() {
+    let out = run_ledger("2026-03-01\tgroceries\tnope\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&out.stderr).starts_with("line 1: "));
+}
