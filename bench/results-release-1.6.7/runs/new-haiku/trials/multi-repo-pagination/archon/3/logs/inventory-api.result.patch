     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    page = [item for item in items if after_id is None or item["id"] > after_id]
+    next_cursor = None
+    if len(page) > limit:
+        page = page[:limit]
+        next_cursor = encode_cursor(page[-1]["id"])
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _DIGITS.fullmatch(raw):
+        raise ValueError("limit must be an integer between 1 and 100")
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        raise ValueError("limit must be an integer between 1 and 100")
+    return limit
+
+
+def encode_cursor(item_id):
+    assert isinstance(item_id, int) and item_id > 0, "cursor ids are positive ints"
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def parse_cursor(raw):
+    """Return the id the page starts after, or None when no cursor is given."""
+    if raw is None:
+        return None
+    try:
+        decoded = base64.urlsafe_b64decode(raw.encode("ascii")).decode("ascii")
+    except (ValueError, UnicodeError):
+        raise ValueError("invalid cursor") from None
+    if not _DIGITS.fullmatch(decoded):
+        raise ValueError("invalid cursor")
+    return int(decoded)
 
 
