 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError(f"account name must be a nonempty str, got {name!r}")
+
+
+def _check_balance(balance):
+    if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+        raise ValueError(f"balance must be an int in [0, MAX_BALANCE], got {balance!r}")
+
+
+def _check_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"amount must be an int in [1, MAX_BALANCE], got {amount!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError(f"balances must be a dict, got {type(balances).__name__}")
+        accounts = dict(balances)
+        for name, balance in accounts.items():
+            _check_name(name)
+            _check_balance(balance)
+        self._balances = accounts
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        with self._lock:
+            source_balance = self._balances[source]
+            destination_balance = self._balances[destination]
+            if source == destination:
+                return source_balance >= amount
+            if source_balance < amount:
+                return False
+            if destination_balance + amount > MAX_BALANCE:
+                return False
+            self._balances[source] = source_balance - amount
+            self._balances[destination] = destination_balance + amount
+            assert 0 <= self._balances[source] <= MAX_BALANCE
+            assert 0 <= self._balances[destination] <= MAX_BALANCE
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
