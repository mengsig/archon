 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    if isinstance(raw_limit, bool) or not str(raw_limit).isascii() or not str(raw_limit).isdigit():
+        return _error(400, "limit must be an integer between 1 and 100")
+    limit = int(raw_limit)
+    if not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer between 1 and 100")
+
+    cursor = query.get("cursor")
+    if cursor is not None:
+        if not isinstance(cursor, str) or not cursor.isascii() or not cursor.isdigit():
+            return _error(400, "cursor is invalid")
+        cursor_id = int(cursor)
+        if str(cursor_id) != cursor or not any(item["id"] == cursor_id for item in items):
+            return _error(400, "cursor is invalid")
+        items = [item for item in items if item["id"] > cursor_id]
+
+    page = items[:limit + 1]
+    has_more = len(page) > limit
+    page = page[:limit]
+    next_cursor = str(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
