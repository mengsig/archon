+// Follows `next_cursor` across pages of GET /items, passing the cursor back unchanged.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  let cursor = null;
+  do {
+    const query = cursor === null ? {} : { cursor };
+    const page = await request(transport, '/items', query);
+    if (!Array.isArray(page.items)) {
+      throw new Error(`GET /items returned a page without an items array: ${JSON.stringify(page)}`);
+    }
+    items.push(...page.items);
+    const next = page.next_cursor ?? null;
+    if (next !== null && next === cursor) {
+      throw new Error(`GET /items returned the same cursor twice: ${JSON.stringify(next)}`);
+    }
+    cursor = next;
+  } while (cursor !== null);
+  return items;
 }
 
