+/// Parse a transaction, identifying malformed currency separately for the CLI.
+pub fn parse_line_detailed(line: &str) -> Result<Entry, (String, bool)> {
     let fields: Vec<&str> = line.split('\t').collect();
-    if fields.len() != 3 {
-        return Err(format!("expected 3 tab-separated fields, got {}", fields.len()));
+    if fields.len() != 3 && fields.len() != 4 {
