diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..56f48a1 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,42 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": attempt,
+        "elapsed_ms": elapsed_ms,
+        "max_attempts": max_attempts,
+        "budget_ms": budget_ms,
+        "base_ms": base_ms,
+        "cap_ms": cap_ms,
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = retry_after_ms
+
+    for name, value in values.items():
+        if type(value) is not int:
+            raise ValueError(f"{name} must be an integer")
+
+    if attempt < 1 or max_attempts < 1:
+        raise ValueError("attempt and max_attempts must be at least 1")
+    if any(value < 0 for name, value in values.items()
+           if name not in ("attempt", "max_attempts")):
+        raise ValueError("times and backoff values must be nonnegative")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        exponent = attempt - 1
+        # Once 2**exponent is at least cap_ms, the capped result is certain.
+        # This avoids constructing a huge power for very large attempt values.
+        if base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms * (1 << exponent))
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..0c783cb 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,37 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_before_exhaustion(self):
+        invalid_cases = (
+            ((4, 0), {"base_ms": True}),
+            ((4, 0), {"budget_ms": 1.0}),
+            ((1, 0), {"max_attempts": False}),
+            ((1, 0), {"retry_after_ms": -1}),
+            ((1, -1), {}),
+            ((0, 0), {}),
+            ((1, 0), {"max_attempts": 0}),
+            ((1, 0), {"cap_ms": -1}),
+        )
+        for args, kwargs in invalid_cases:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_zero_values_and_base_above_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=900, cap_ms=3), 3)
+
+    def test_large_attempt_saturates_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
+
+    def test_retry_after_is_not_capped_and_budget_is_strict(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=450), 450)
+        self.assertIsNone(retry_delay(1, 550, budget_ms=650, retry_after_ms=100))
+        self.assertEqual(retry_delay(1, 549, budget_ms=650, retry_after_ms=100), 100)
+
+    def test_attempt_above_limit_is_legal(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
