+class BatchShapeRejected(unittest.TestCase):
+    def setUp(self):
+        self._temp = tempfile.TemporaryDirectory()
+        self.root = Path(self._temp.name)
+
+    def tearDown(self):
+        self._temp.cleanup()
+
+    def test_non_list_batches_are_rejected(self):
+        for batch in [(), (("a", b"x"),), iter([("a", b"x")]), (x for x in [])]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(tree_snapshot(self.root), [])
+
+    def test_generator_is_not_consumed(self):
+        generator = (entry for entry in [("a", b"x")])
+        with self.assertRaises(ValueError):
+            extract(generator, self.root)
+        self.assertEqual(list(generator), [("a", b"x")])
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", "extra"),
+            (1, b"x"),
+            (None, b"x"),
+            (b"a", b"x"),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", memoryview(b"x")),
+            ("a", None),
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([("ok.txt", b"ok"), entry], self.root)
+        self.assertEqual(tree_snapshot(self.root), [])
+
