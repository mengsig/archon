+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation(self):
+        invalid = [
+            None,
+            [],
+            {"": 0},
+            {1: 0},
+            {"a": -1},
+            {"a": MAX_BALANCE + 1},
+            {"a": True},
+            {"a": 1.0},
+        ]
+        for balances in invalid:
+            with self.subTest(balances=balances), self.assertRaises(ValueError):
+                Ledger(balances)
+
+    def test_constructor_and_snapshot_are_copies(self):
+        initial = {"a": 4}
+        ledger = Ledger(initial)
+        initial["a"] = 99
+        initial["b"] = 3
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 0
+        snapshot["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_empty_ledger_and_balance_limits(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+        ledger = Ledger({"zero": 0, "max": MAX_BALANCE})
+        self.assertEqual(ledger.snapshot(), {"zero": 0, "max": MAX_BALANCE})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error_without_changes(self):
+        ledger = Ledger({"a": 5})
+        for source, destination in (("missing", "a"), ("a", "missing")):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+                self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_destination_overflow_is_atomic(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 2})
+        self.assertFalse(ledger.transfer("a", "b", 3))
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE - 2})
+        self.assertTrue(ledger.transfer("a", "b", 2))
+        self.assertEqual(ledger.snapshot(), {"a": 3, "b": MAX_BALANCE})
+
+    def test_same_account_transfer_checks_funds_without_mutating(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+
+        smaller = Ledger({"a": 4})
+        self.assertFalse(smaller.transfer("a", "a", 5))
+        self.assertEqual(smaller.snapshot(), {"a": 4})
+
+    def test_opposite_concurrent_transfers_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = Barrier(3)
+        errors = []
+
+        def move(source, destination):
+            try:
+                start.wait()
+                for _ in range(500):
+                    ledger.transfer(source, destination, 1)
+            except BaseException as error:
+                errors.append(error)
+
+        workers = [
+            Thread(target=move, args=("a", "b")),
+            Thread(target=move, args=("b", "a")),
+        ]
+        for worker in workers:
+            worker.start()
+        start.wait()
+        for worker in workers:
+            worker.join()
+
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 200)
