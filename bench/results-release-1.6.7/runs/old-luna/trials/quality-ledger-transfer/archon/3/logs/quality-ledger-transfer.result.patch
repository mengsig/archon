+class LedgerConcurrency(unittest.TestCase):
+    def test_opposite_transfers_and_snapshots_are_thread_safe(self):
+        ledger = Ledger({"a": 10_000, "b": 10_000})
+        start = Barrier(4)
+        errors = []
+
+        def transfer_many(source, destination):
+            try:
+                start.wait(timeout=2)
+                for _ in range(2_000):
+                    if not ledger.transfer(source, destination, 1):
+                        errors.append("unexpected insufficient funds")
+            except BaseException as exc:
+                errors.append(exc)
+
+        def snapshot_many():
+            try:
+                start.wait(timeout=2)
+                for _ in range(4_000):
+                    snapshot = ledger.snapshot()
+                    if sum(snapshot.values()) != 20_000:
+                        errors.append(snapshot)
+            except BaseException as exc:
+                errors.append(exc)
+
+        threads = [
+            Thread(target=transfer_many, args=("a", "b")),
+            Thread(target=transfer_many, args=("b", "a")),
+            Thread(target=snapshot_many),
+        ]
+        for thread in threads:
+            thread.start()
+        start.wait(timeout=2)
+        for thread in threads:
+            thread.join(timeout=3)
+
+        self.assertFalse(any(thread.is_alive() for thread in threads), "worker deadlocked")
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 20_000)
