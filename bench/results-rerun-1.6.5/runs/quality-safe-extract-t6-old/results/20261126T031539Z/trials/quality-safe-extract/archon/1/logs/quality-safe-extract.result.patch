+
+    def test_symlink_ancestor_inside_root_is_not_followed(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "link")
+        self.assert_rejected_without_change([("link/x", b"x")])
+        self.assertEqual(list((self.root / "real").iterdir()), [])
+
+    def test_symlink_target_is_rejected_and_not_followed(self):
+        (self.root / "file").write_bytes(b"orig")
