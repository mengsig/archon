@@ -21,8 +29,49 @@ def handle(request):
 
 
 def list_items(query):
+    try:
+        limit = parse_limit(query.get("limit"))
+        after_id = parse_cursor(query.get("cursor"))
+    except InvalidQuery as exc:
+        return _error(400, str(exc))
+    return {"status": 200, "body": _page(after_id, limit)}
+
+
+def parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_digits(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise InvalidQuery(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def parse_cursor(raw):
+    """Return the id the page starts after, or None for the first page."""
+    if raw is None:
+        return None
+    if not _is_digits(raw):
+        raise InvalidQuery("cursor is not valid")
+    return int(raw)
+
+
+def _page(after_id, limit):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    if after_id is not None:
+        items = [item for item in items if item["id"] > after_id]
+    page = items[:limit]
+    has_more = len(items) > limit
+    next_cursor = str(page[-1]["id"]) if has_more else None
+    return {"items": page, "next_cursor": next_cursor}
+
+
+def _is_digits(raw):
+    """Plain ASCII digits, short enough that int() cannot fail on them."""
+    return (
+        isinstance(raw, str)
+        and raw.isascii()
+        and raw.isdigit()
+        and len(raw) <= MAX_DIGITS
+    )
 
 
