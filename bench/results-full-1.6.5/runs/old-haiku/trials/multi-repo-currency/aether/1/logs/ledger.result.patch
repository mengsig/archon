+++ b/tests/ledger.rs
@@ -1,3 +1,6 @@
+use std::io::Write;
+use std::process::{Command, Stdio};
+
 use ledger::{parse_cents, parse_line, to_csv_row};
 
 #[test]
@@ -14,7 +17,76 @@ fn parses_lines() {
     let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
     assert_eq!(entry.account, "groceries");
     assert_eq!(entry.amount_cents, -4510);
-    assert!(to_csv_row(&entry).starts_with("2026-03-01,groceries,-4510"));
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,USD");
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn parses_explicit_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency() {
+    for code in ["eur", "EURO", "US", "U5D", ""] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert_eq!(err.exit_code(), 2, "currency {code:?}");
+    }
+}
+
+#[test]
+fn other_errors_exit_one() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tEUR\textra").unwrap_err();
+    assert_eq!(err.exit_code(), 1);
+}
+
+fn run_cli(stdin: &str) -> (i32, String, String) {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(stdin.as_bytes())
+        .unwrap();
+    let out = child.wait_with_output().unwrap();
+    (
+        out.status.code().unwrap(),
+        String::from_utf8(out.stdout).unwrap(),
+        String::from_utf8(out.stderr).unwrap(),
+    )
+}
+
+#[test]
+fn cli_prints_currency_column() {
+    let (code, stdout, _) = run_cli("2026-03-01\trent\t-10\n2026-03-02\tcafe\t3.50\tEUR\n");
+    assert_eq!(code, 0);
+    assert_eq!(
+        stdout,
+        "date,account,amount_cents,currency\n2026-03-01,rent,-1000,USD\n2026-03-02,cafe,350,EUR\n"
+    );
+}
+
+#[test]
+fn cli_bad_currency_exits_two_with_line_number() {
+    let (code, stdout, stderr) = run_cli("2026-03-01\trent\t-10\n2026-03-02\tcafe\t3.50\teur\n");
+    assert_eq!(code, 2);
+    assert!(stderr.starts_with("line 2: "), "stderr: {stderr}");
+    assert!(!stdout.contains("cafe"));
+}
+
+#[test]
+fn cli_bad_amount_still_exits_one() {
+    let (code, _, stderr) = run_cli("2026-03-01\trent\tlots\n");
+    assert_eq!(code, 1);
+    assert!(stderr.starts_with("line 1: "), "stderr: {stderr}");
+}
