@@ -0,0 +1,57 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_task_list_gives_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_header_and_rows_end_with_crlf(self):
+        text = to_csv([Task(1, "plain", [], "open", None)])
+        self.assertEqual(text, HEADER + "1,plain,,open,\r\n")
+
+    def test_rows_keep_input_order(self):
+        tasks = [Task(3, "third", [], "open", None), Task(1, "first", [], "done", None)]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + "3,third,,open,\r\n1,first,,done,\r\n",
+        )
+
+    def test_tags_joined_with_semicolon_and_due_is_iso(self):
+        task = Task(2, "report", ["work", "urgent"], "open", date(2026, 4, 1))
+        self.assertEqual(to_csv([task]), HEADER + "2,report,work;urgent,open,2026-04-01\r\n")
+
+    def test_empty_tags_and_due_leave_fields_empty(self):
+        self.assertEqual(to_csv([Task(4, "milk", [], "open", None)]), HEADER + "4,milk,,open,\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        task = Task(1, "buy milk, eggs", [], "open", None)
+        self.assertEqual(to_csv([task]), HEADER + '1,"buy milk, eggs",,open,\r\n')
+
+    def test_title_with_double_quotes_is_quoted_and_doubled(self):
+        task = Task(1, 'say "hi"', [], "open", None)
+        self.assertEqual(to_csv([task]), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_title_with_cr_or_lf_is_quoted(self):
+        tasks = [Task(1, "line\rone", [], "open", None), Task(2, "line\ntwo", [], "open", None)]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + '1,"line\rone",,open,\r\n2,"line\ntwo",,open,\r\n',
+        )
+
+    def test_tag_containing_comma_is_quoted(self):
+        task = Task(1, "x", ["a,b", "c"], "open", None)
+        self.assertEqual(to_csv([task]), HEADER + '1,x,"a,b;c",open,\r\n')
+
+    def test_plain_fields_are_not_quoted(self):
+        task = Task(7, "walk the dog", ["home"], "done", date(2026, 5, 2))
+        self.assertEqual(to_csv([task]), HEADER + "7,walk the dog,home,done,2026-05-02\r\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
