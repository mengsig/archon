+//! Characterization of the orders crate's observable behaviour.
+//! Expected values are the exact pre-refactor outputs. Status is read through
+//! `Display` so these tests do not depend on the type of `Order::status`.
+
+use orders::{billing, report, shipping, Order};
+
+fn status(order: &Order) -> String {
+    order.status.to_string()
+}
+
+fn paid() -> Order {
+    let mut order = Order::new(7, "ada", 100);
+    billing::pay(&mut order).unwrap();
+    order
+}
+
+fn shipped() -> Order {
+    let mut order = paid();
+    shipping::ship(&mut order).unwrap();
+    order
+}
+
+fn cancelled() -> Order {
+    let mut order = Order::new(7, "ada", 100);
+    order.cancel().unwrap();
+    order
+}
+
+#[test]
+fn new_order_starts_pending_with_its_given_fields() {
+    let order = Order::new(7, "ada", 100);
+    assert_eq!(order.id, 7);
+    assert_eq!(order.customer, "ada");
+    assert_eq!(order.total_cents, 100);
+    assert_eq!(status(&order), "pending");
+}
+
+#[test]
+fn open_means_pending_or_paid() {
+    assert!(Order::new(7, "ada", 100).is_open());
+    assert!(paid().is_open());
+    assert!(!shipped().is_open());
+    assert!(!cancelled().is_open());
+}
+
+#[test]
+fn pay_is_refused_for_every_status_except_pending() {
+    let mut order = paid();
+    let err = billing::pay(&mut order).unwrap_err();
+    assert_eq!(err, "order 7 cannot be paid: it is paid");
+    assert_eq!(status(&order), "paid");
+
+    let mut order = shipped();
+    let err = billing::pay(&mut order).unwrap_err();
+    assert_eq!(err, "order 7 cannot be paid: it is shipped");
+    assert_eq!(status(&order), "shipped");
+}
+
+#[test]
+fn ship_is_refused_for_every_status_except_paid() {
+    let mut order = Order::new(7, "ada", 100);
+    let err = shipping::ship(&mut order).unwrap_err();
+    assert_eq!(err, "order 7 cannot be shipped: it is pending");
+    assert_eq!(status(&order), "pending");
+
+    let mut order = shipped();
+    let err = shipping::ship(&mut order).unwrap_err();
+    assert_eq!(err, "order 7 cannot be shipped: it is shipped");
+    assert_eq!(status(&order), "shipped");
+
+    let mut order = cancelled();
+    let err = shipping::ship(&mut order).unwrap_err();
+    assert_eq!(err, "order 7 cannot be shipped: it is cancelled");
+    assert_eq!(status(&order), "cancelled");
+}
+
+#[test]
+fn cancel_succeeds_from_pending_and_from_paid() {
+    let mut order = Order::new(7, "ada", 100);
+    order.cancel().unwrap();
+    assert_eq!(status(&order), "cancelled");
+
+    let mut order = paid();
+    order.cancel().unwrap();
+    assert_eq!(status(&order), "cancelled");
+}
+
+#[test]
+fn cancel_is_refused_for_shipped_and_cancelled_orders() {
+    let mut order = shipped();
+    let err = order.cancel().unwrap_err();
+    assert_eq!(err, "order 7 cannot be cancelled: it is shipped");
+    assert_eq!(status(&order), "shipped");
+
+    let mut order = cancelled();
+    let err = order.cancel().unwrap_err();
+    assert_eq!(err, "order 7 cannot be cancelled: it is cancelled");
+    assert_eq!(status(&order), "cancelled");
+}
+
+#[test]
+fn status_counts_lists_each_present_status_sorted_by_name() {
+    let orders = vec![Order::new(1, "a", 1), paid(), shipped(), cancelled()];
+    let counts: Vec<(String, usize)> = report::status_counts(&orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        counts,
+        [
+            ("cancelled".to_string(), 1),
+            ("paid".to_string(), 1),
+            ("pending".to_string(), 1),
+            ("shipped".to_string(), 1),
+        ]
+    );
+}
+
+#[test]
+fn status_counts_counts_repeats_and_omits_absent_statuses() {
+    let orders = vec![Order::new(1, "a", 1), Order::new(2, "b", 1), shipped()];
+    let counts: Vec<(String, usize)> = report::status_counts(&orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        counts,
+        [("pending".to_string(), 2), ("shipped".to_string(), 1)]
+    );
+}
+
+#[test]
+fn status_counts_of_no_orders_is_empty() {
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn to_line_writes_id_customer_total_and_status_name() {
+    assert_eq!(
+        report::to_line(&Order::new(1, "ada", 100)),
+        "1,ada,100,pending"
+    );
+    assert_eq!(report::to_line(&paid()), "7,ada,100,paid");
+    assert_eq!(report::to_line(&shipped()), "7,ada,100,shipped");
+    assert_eq!(report::to_line(&cancelled()), "7,ada,100,cancelled");
+}
+
+#[test]
+fn to_line_does_not_escape_commas_in_the_customer() {
+    let line = report::to_line(&Order::new(1, "a,b", 100));
+    assert_eq!(line, "1,a,b,100,pending");
+    let err = report::from_line(&line).unwrap_err();
+    assert_eq!(err, "expected 4 fields, got 5");
+}
+
+#[test]
+fn from_line_round_trips_every_status() {
+    for order in [Order::new(1, "ada", 100), paid(), shipped(), cancelled()] {
+        let parsed = report::from_line(&report::to_line(&order)).unwrap();
+        assert_eq!(parsed, order);
+    }
+}
+
+#[test]
+fn from_line_trims_the_outer_whitespace_only() {
+    let order = report::from_line("  1, ada ,100,paid\r\n").unwrap();
+    assert_eq!(order.id, 1);
+    assert_eq!(order.customer, " ada ");
+    assert_eq!(order.total_cents, 100);
+    assert_eq!(status(&order), "paid");
+}
+
+#[test]
+fn from_line_rejects_the_wrong_number_of_fields() {
+    assert_eq!(
+        report::from_line("").unwrap_err(),
+        "expected 4 fields, got 1"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,paid,x").unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+}
+
+#[test]
+fn from_line_reports_bad_numbers_with_the_rust_parse_error() {
+    let err = report::from_line("x,ada,100,paid").unwrap_err();
+    assert_eq!(err, r#"bad id "x": invalid digit found in string"#);
+    let err = report::from_line("1,ada,abc,paid").unwrap_err();
+    assert_eq!(err, r#"bad total "abc": invalid digit found in string"#);
+    let err = report::from_line(",ada,100,paid").unwrap_err();
+    assert_eq!(err, r#"bad id "": cannot parse integer from empty string"#);
+    let err = report::from_line("-1,ada,100,paid").unwrap_err();
+    assert_eq!(err, r#"bad id "-1": invalid digit found in string"#);
+    let err = report::from_line("4294967296,ada,100,paid").unwrap_err();
+    assert_eq!(
+        err,
+        r#"bad id "4294967296": number too large to fit in target type"#
+    );
+    let err = report::from_line("1,ada, 100,paid").unwrap_err();
+    assert_eq!(err, r#"bad total " 100": invalid digit found in string"#);
+}
+
+#[test]
+fn from_line_checks_id_then_total_then_status() {
+    let err = report::from_line("x,ada,bad,lost").unwrap_err();
+    assert_eq!(err, r#"bad id "x": invalid digit found in string"#);
+    let err = report::from_line("1,ada,bad,lost").unwrap_err();
+    assert_eq!(err, r#"bad total "bad": invalid digit found in string"#);
+}
+
+#[test]
+fn from_line_rejects_unknown_statuses_case_sensitively_and_exactly() {
+    assert_eq!(
+        report::from_line("1,ada,100,lost").unwrap_err(),
+        r#"unknown status "lost""#
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,Paid").unwrap_err(),
+        r#"unknown status "Paid""#
+    );
+    assert_eq!(
+        report::from_line("1,ada,100, paid").unwrap_err(),
+        r#"unknown status " paid""#
+    );
+}
+
+type Step = fn(&mut Order) -> Result<(), String>;
+
+fn order_with(id: u32, total_cents: u64, steps: &[Step]) -> Order {
+    let mut order = Order::new(id, "x", total_cents);
+    for step in steps {
+        step(&mut order).unwrap();
+    }
+    order
+}
+
+fn pay_step(order: &mut Order) -> Result<(), String> {
+    billing::pay(order)
+}
+
+fn ship_step(order: &mut Order) -> Result<(), String> {
+    shipping::ship(order)
+}
+
+fn cancel_step(order: &mut Order) -> Result<(), String> {
+    order.cancel()
+}
+
+#[test]
+fn outstanding_cents_sums_only_pending_orders() {
+    let orders = vec![
+        order_with(1, 100, &[]),
+        order_with(2, 200, &[pay_step]),
+        order_with(3, 400, &[pay_step, ship_step]),
+        order_with(4, 800, &[cancel_step]),
+        order_with(5, 30, &[]),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 130);
+}
+
+#[test]
+fn outstanding_cents_of_no_orders_is_zero() {
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_returns_paid_ids_in_input_order() {
+    let orders = vec![
+        order_with(3, 1, &[pay_step]),
+        order_with(4, 1, &[]),
+        order_with(1, 1, &[pay_step]),
+        order_with(5, 1, &[pay_step, ship_step]),
+        order_with(2, 1, &[pay_step]),
+        order_with(6, 1, &[cancel_step]),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [3, 1, 2]);
+}
+
+#[test]
+fn ready_to_ship_of_no_orders_is_empty() {
+    assert!(shipping::ready_to_ship(&[]).is_empty());
+}
