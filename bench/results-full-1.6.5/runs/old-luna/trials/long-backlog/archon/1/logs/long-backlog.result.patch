@@ -0,0 +1,89 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class TaskStoreUndoTest(unittest.TestCase):
+    def test_undo_add_removes_task_without_reusing_id(self):
+        store = TaskStore()
+        task = store.add("first")
+
+        store.undo()
+
+        self.assertEqual(store.all(), [])
+        next_task = store.add("second")
+        self.assertGreater(next_task.id, task.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("finish", tags=["work"])
+        store.complete(task.id)
+
+        store.undo()
+
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_exact_task_with_same_id(self):
+        store = TaskStore()
+        task = store.add("finish", tags=["work"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = (task.id, task.title, list(task.tags), task.status, task.due)
+        store.delete(task.id)
+
+        store.undo()
+
+        restored = store.get(task.id)
+        self.assertEqual(
+            (restored.id, restored.title, restored.tags, restored.status, restored.due),
+            before,
+        )
+
+    def test_undo_is_lifo_across_operation_kinds(self):
+        store = TaskStore()
+        task = store.add("work")
+        store.complete(task.id)
+        store.delete(task.id)
+
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_repeated_undo_exhausts_history(self):
+        store = TaskStore()
+        store.add("one")
+        store.add("two")
+
+        store.undo()
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_do_not_enter_history(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(UnknownTask):
+            store.complete(42)
+        with self.assertRaises(UnknownTask):
+            store.delete(42)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_preserve_prior_history(self):
+        store = TaskStore()
+        task = store.add("keep")
+        with self.assertRaises(UnknownTask):
+            store.complete(42)
+
+        store.undo()
+
+        self.assertEqual(store.all(), [])
+        self.assertGreater(store.add("next").id, task.id)
+
+
+if __name__ == "__main__":
+    unittest.main()
