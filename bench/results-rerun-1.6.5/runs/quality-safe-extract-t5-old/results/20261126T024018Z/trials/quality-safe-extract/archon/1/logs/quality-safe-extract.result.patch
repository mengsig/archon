+        self.assertEqual((self.root / "existing/new.txt").read_bytes(), b"x")
+
+    def test_rejected_batch_creates_no_parent_directories(self):
+        self.assertRejectedUnchanged([("nested/dir/ok.txt", b"x"), ("nested/dir/ok.txt", b"y")])
+
+    def test_percent_and_unicode_names_are_kept_literally(self):
+        names = ["100%/done%.txt", "héllo.txt"]
