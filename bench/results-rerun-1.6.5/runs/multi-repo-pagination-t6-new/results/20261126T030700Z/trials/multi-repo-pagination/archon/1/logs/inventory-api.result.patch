+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not (isinstance(raw, str) and raw.isascii() and raw.isdigit()):
+        raise BadRequest("limit must be an integer from 1 to 100")
+    try:
+        limit = int(raw)
+    except ValueError:
+        raise BadRequest("limit must be an integer from 1 to 100")
+    if not 1 <= limit <= MAX_LIMIT:
+        raise BadRequest("limit must be an integer from 1 to 100")
+    return limit
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    if raw is None:
+        return None
+    if not isinstance(raw, str):
+        raise BadRequest("invalid cursor")
+    known_ids = {item["id"] for item in ITEMS}
+    try:
+        text = base64.b64decode(raw.encode("ascii"), altchars=b"-_", validate=True)
+        text = text.decode("ascii")
+        item_id = int(text) if text.isdigit() else None
+    except ValueError:
+        raise BadRequest("invalid cursor")
+    if item_id not in known_ids:
+        raise BadRequest("invalid cursor")
+    return item_id
 
 
