--- a/api.py
+++ b/api.py
@@ -5,8 +5,14 @@ response is `{"status": int, "body": object}`; the transport layer lives
 elsewhere.
 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,52 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after = None
+    if "cursor" in query:
+        after = _decode_cursor(query["cursor"])
+        if after is None:
+            return _error(400, "cursor is not valid")
+    candidates = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after is None or item["id"] > after
+    ]
+    page = candidates[:limit]
+    has_more = len(candidates) > limit
+    assert len(page) <= limit
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:]))
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    """Return the page size, or None when `raw` is not an integer in range."""
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not re.fullmatch(r"[0-9]{1,3}", raw):
+        return None
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    """Return the id the cursor points after, or None when it is malformed."""
+    try:
+        text = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except ValueError:
+        return None
+    if not re.fullmatch(r"[0-9]{1,18}", text):
+        return None
+    return int(text)
 
 
