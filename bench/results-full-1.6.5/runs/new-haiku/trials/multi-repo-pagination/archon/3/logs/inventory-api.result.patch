@@ -24,6 +25,55 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size_is_20(self):
+        res = get("/items")
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_walking_cursors_returns_every_item_once_in_order(self):
+        all_ids = [item["id"] for item in get("/items", limit="100")["body"]["items"]]
+        self.assertEqual(all_ids, list(range(1, 58)))
+        walked, cursor = [], None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            walked += [item["id"] for item in res["body"]["items"]]
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(walked, all_ids)
+
+    def test_last_page_has_null_next_cursor(self):
+        res = get("/items", limit="20", cursor=get("/items", limit="50")["body"]["next_cursor"])
+        self.assertEqual(res["body"]["next_cursor"], None)
+        self.assertEqual([item["id"] for item in res["body"]["items"]], list(range(51, 58)))
+
+    def test_exact_fit_has_null_next_cursor(self):
+        res = get("/items", limit="57")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_cursor_past_last_item_gives_empty_last_page(self):
+        res = get("/items", cursor=encode_cursor(57))
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(res["body"], {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        for limit in ["1", "100"]:
+            self.assertEqual(get("/items", limit=limit)["status"], 200)
+        for limit in ["0", "101", "-1", "", "abc", "2.5", "1_0", " 5", "9" * 5000, "é"]:
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_400(self):
+        overlong = base64.urlsafe_b64encode(b"9" * 5000).decode("ascii")
+        for cursor in ["", "!!!", "x", "bm90IGEgbnVtYmVy", "MQ", overlong, "é"]:
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("cursor", res["body"]["error"])
+
 
 if __name__ == "__main__":
     unittest.main()
