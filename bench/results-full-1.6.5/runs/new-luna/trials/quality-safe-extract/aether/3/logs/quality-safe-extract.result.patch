+
+
+class ExtractValidation(unittest.TestCase):
+    def test_batch_must_be_list_and_is_not_consumed(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for entries in ((), iter(())):
+                with self.subTest(entries=type(entries)):
+                    with self.assertRaises(ValueError):
+                        extract(entries, Path(directory))
+
+    def test_rejects_malformed_entries_and_data(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for entries in (["x"], [("x", bytearray())], [("x", b"a", b"b")]):
+                with self.subTest(entries=entries):
+                    with self.assertRaises(ValueError):
+                        extract(entries, Path(directory))
+            self.assertEqual(list(Path(directory).iterdir()), [])
+
+    def test_rejects_unsafe_names(self):
+        with tempfile.TemporaryDirectory() as directory:
+            invalid = ["", "/abs", "a//b", "a/./b", "a/../b", "a\\b", "C:/x", "x\x00y"]
+            for name in invalid:
+                with self.subTest(name=name):
+                    with self.assertRaises(ValueError):
+                        extract([(name, b"x")], Path(directory))
+            self.assertEqual(extract([("100%ready", b"ok")], Path(directory)), ["100%ready"])
+
+    def test_rejects_collisions_in_either_order(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for entries in ([('a', b'x'), ('a/b', b'y')], [('a/b', b'y'), ('a', b'x')], [('x', b'a'), ('x', b'b')]):
+                with self.subTest(entries=entries):
+                    with self.assertRaises(ValueError):
+                        extract(entries, Path(directory))
+            self.assertEqual(list(Path(directory).iterdir()), [])
+
+    def test_conflict_late_in_batch_leaves_no_new_files(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            (root / "present").write_bytes(b"original")
+            with self.assertRaises(ValueError):
+                extract([("new/first", b"x"), ("present", b"replace")], root)
+            self.assertEqual(list(root.iterdir()), [root / "present"])
+            self.assertEqual((root / "present").read_bytes(), b"original")
+
+    def test_rejects_symlinks_and_non_directory_ancestors(self):
+        with tempfile.TemporaryDirectory() as directory, tempfile.TemporaryDirectory() as outside:
+            root = Path(directory)
+            outside_path = Path(outside)
+            (root / "file").write_bytes(b"x")
+            (root / "link").symlink_to(outside_path, target_is_directory=True)
+            (root / "dangling").symlink_to(outside_path / "missing")
+            for name in ("file/child", "link/created", "dangling"):
+                with self.subTest(name=name):
+                    with self.assertRaises(ValueError):
+                        extract([(name, b"data")], root)
+            self.assertEqual(list(outside_path.iterdir()), [])
+
+    def test_rejects_invalid_root(self):
+        with tempfile.TemporaryDirectory() as directory, tempfile.TemporaryDirectory() as elsewhere:
+            link = Path(directory) / "link"
+            link.symlink_to(elsewhere, target_is_directory=True)
+            with self.assertRaises(ValueError):
+                extract([], link)
+            with self.assertRaises(ValueError):
+                extract([], Path(directory) / "missing")
