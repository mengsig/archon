 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+_WAIT_MARGIN_SEC = 1e-9
+
+
+def _check_positive_finite(name, value):
+    if not math.isfinite(value) or value <= 0:
+        raise ValueError(f"{name} must be a finite number > 0, got {value!r}")
+
+
+def _check_bucket_params(capacity, refill_per_sec):
+    _check_positive_finite("capacity", capacity)
+    _check_positive_finite("refill_per_sec", refill_per_sec)
+
+
+def _check_request(n, capacity):
+    _check_positive_finite("n", n)
+    if n > capacity:
+        raise ValueError(f"n={n!r} exceeds bucket capacity {capacity!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    def _refill(self):
+        now = self._clock()
+        # A clock that did not advance past the latest time seen adds nothing.
+        if now <= self._last:
+            return now
+        elapsed = now - self._last
+        self._tokens = min(self._capacity, self._tokens + elapsed * self._refill_per_sec)
+        self._last = now
+        assert 0 <= self._tokens <= self._capacity
+        return now
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        assert self._tokens >= 0
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        now = self._refill()
+        if self._tokens >= n:
+            return 0.0
+        assert self._last >= now
+        # Refill resumes only once the clock passes the latest time seen.
+        clock_gap = self._last - now
+        refill_wait = (n - self._tokens) / self._refill_per_sec
+        wait = clock_gap + refill_wait
+        # Clock float rounding grows with the clock value, so pad by its ulp.
+        return wait + _WAIT_MARGIN_SEC + 4 * math.ulp(self._last + refill_wait)
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        if not isinstance(max_keys, int) or max_keys < 1:
+            raise ValueError(f"max_keys must be an int >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        # Validate before touching _bucket so a bad request cannot evict a key.
+        _check_request(n, self._capacity)
+        return self._bucket(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
