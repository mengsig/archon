 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
+
+
+def _invalid_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a path")
+    path = Path(root)
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        raise ValueError("root must be an existing directory") from None
+    if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
+        raise ValueError("root must be a real directory")
+    return path
+
+
+def _validate_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError("entry names must be nonempty strings")
+    if name.startswith("/") or "\\" in name or ":" in name or "\0" in name:
+        raise ValueError("entry name is not a relative POSIX path")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError("entry name contains an invalid path component")
+    return parts
+
+
+def _validate_destination(root, parts):
+    current = root
+    for index, component in enumerate(parts):
+        current = current / component
+        try:
+            mode = current.lstat().st_mode
+        except FileNotFoundError:
+            return
+        if stat.S_ISLNK(mode):
+            raise ValueError("destination contains a symlink")
+        if index == len(parts) - 1:
+            raise ValueError("destination already exists")
+        if not stat.S_ISDIR(mode):
+            raise ValueError("destination ancestor is not a directory")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    # Validate the entire batch before examining or changing destinations.
+    validated = []
+    names = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        parts = _validate_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in names:
+            raise ValueError("duplicate entry name")
+        names.add(name)
+        validated.append((name, data, parts))
+
+    for name, _, parts in validated:
+        for length in range(1, len(parts)):
+            if "/".join(parts[:length]) in names:
+                raise ValueError("file/directory collision in batch")
+
+    root_path = _invalid_root(root)
+    for _, _, parts in validated:
+        _validate_destination(root_path, parts)
+
+    for _, _, parts in validated:
+        (root_path / Path(*parts)).parent.mkdir(parents=True, exist_ok=True)
+    for _, data, parts in validated:
+        # Exclusive creation protects against accidental replacement.
+        target = root_path / Path(*parts)
+        with target.open("xb") as output:
+            output.write(data)
+    return [name for name, _, _ in validated]
