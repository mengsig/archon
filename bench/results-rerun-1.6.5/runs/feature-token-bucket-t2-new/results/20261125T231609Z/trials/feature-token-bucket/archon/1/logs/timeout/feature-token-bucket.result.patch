+class TokenBucketValidationTest(unittest.TestCase):
+    def test_invalid_capacity_or_rate_raises(self):
+        bad_values = [0, -1, math.nan, math.inf]
+        for value in bad_values:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    TokenBucket(value, 1.0, clock=FakeClock())
+                with self.assertRaises(ValueError):
+                    TokenBucket(1, value, clock=FakeClock())
+
+    def test_invalid_n_raises_and_changes_nothing(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, math.nan]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_nan_and_infinite_clock_raise(self):
+        for value in [math.nan, math.inf, -math.inf]:
+            with self.subTest(value=value):
+                clock = FakeClock()
+                bucket = TokenBucket(1, 1.0, clock=clock)
+                clock.now = value
+                with self.assertRaises(ValueError):
+                    bucket.available()
+
+
+class TokenBucketBehaviourTest(unittest.TestCase):
+    def test_starts_full(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.25)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+        self.assertAlmostEqual(bucket.available(), 0.0)
+
+    def test_failed_acquire_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_wait_time_values(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertEqual(bucket.wait_time(), 0.0)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(), 0.5)
+        self.assertAlmostEqual(bucket.wait_time(2), 1.0)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        bucket.wait_time()
+        self.assertAlmostEqual(bucket.available(), 0.0)
+
+    def test_acquire_succeeds_after_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now += bucket.wait_time(2)
+        self.assertTrue(bucket.try_acquire(2))
+
+    def test_clock_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 11.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_acquire_succeeds_after_wait_time_for_inexact_rate(self):
+        for rate in [3.7, 0.1]:
+            for n in [1, 2]:
+                with self.subTest(rate=rate, n=n):
+                    clock = FakeClock()
+                    bucket = TokenBucket(2, rate, clock=clock)
+                    bucket.try_acquire(2)
+                    clock.now += bucket.wait_time(n)
+                    self.assertTrue(bucket.try_acquire(n))
+
+    def test_acquire_succeeds_after_wait_time_at_large_clock(self):
+        for start in [1e3, 1e6]:
+            for capacity in [1, 10, 1e4]:
+                for rate in [0.3, 3.7]:
+                    for fraction in [1 / 3, 0.5, 0.999]:
+                        with self.subTest(start=start, capacity=capacity, rate=rate, fraction=fraction):
+                            clock = FakeClock()
+                            clock.now = start
+                            bucket = TokenBucket(capacity, rate, clock=clock)
+                            bucket.try_acquire(capacity)
+                            n = capacity * fraction
+                            clock.now += bucket.wait_time(n)
+                            self.assertTrue(bucket.try_acquire(n))
+
+    def test_wait_time_after_backwards_clock_counts_from_latest_seen(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.wait_time(), 6.0)
+        clock.now = 11.0
+        self.assertTrue(bucket.try_acquire())
+
+    def test_no_false_accept_at_large_rate_times_clock(self):
+        clock = FakeClock()
+        clock.now = 1e9
+        bucket = TokenBucket(1, 1e6, clock=clock)
+        bucket.try_acquire(1)
+        self.assertFalse(bucket.try_acquire(0.5))
+        self.assertGreater(bucket.wait_time(0.5), 0.0)
+
+    def test_small_capacity_large_clock_round_trips(self):
+        clock = FakeClock()
+        clock.now = 1e6
+        bucket = TokenBucket(1, 0.3, clock=clock)
+        bucket.try_acquire(1)
+        clock.now += bucket.wait_time(0.5)
+        self.assertTrue(bucket.try_acquire(0.5))
+
+    def test_wait_time_round_trip_sweep(self):
+        for capacity in [1, 3.0, 1e4, 1e8]:
+            for rate in [0.3, 3.7, 1e6]:
+                for start in [0.0, 1e3, 1e6, 1e9]:
+                    for fraction in [1 / 3, 0.5, 0.999, 1.0]:
+                        n = capacity * fraction
+                        with self.subTest(capacity=capacity, rate=rate, start=start, n=n):
+                            clock = FakeClock()
+                            clock.now = start
+                            bucket = TokenBucket(capacity, rate, clock=clock)
+                            bucket.try_acquire(capacity)
+                            clock.now += bucket.wait_time(n)
+                            self.assertTrue(bucket.try_acquire(n))
+
+    def test_tiny_request_on_fast_bucket_round_trips(self):
+        for start in [0.0, 1e6]:
+            with self.subTest(start=start):
+                clock = FakeClock()
+                clock.now = start
+                bucket = TokenBucket(1, 1e300, clock=clock)
+                bucket.try_acquire(1)
+                clock.now += bucket.wait_time(1e-300)
+                self.assertTrue(bucket.try_acquire(1e-300))
+
+    def test_acquire_succeeds_after_wait_time_at_large_capacity(self):
+        for rate in [0.3, 3.7, 12345.6789]:
+            with self.subTest(rate=rate):
+                clock = FakeClock()
+                bucket = TokenBucket(1e8, rate, clock=clock)
+                bucket.try_acquire(1e8)
+                clock.now += bucket.wait_time(1e8 / 3)
+                self.assertTrue(bucket.try_acquire(1e8 / 3))
+
