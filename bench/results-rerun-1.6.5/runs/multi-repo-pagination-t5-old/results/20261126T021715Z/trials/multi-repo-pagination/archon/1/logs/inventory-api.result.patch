diff --git a/test_api.py b/test_api.py
index 55cd1fd..4910291 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,54 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_has_default_limit_and_cursor(self):
+        res = get("/items")
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(1, 21)))
+        self.assertEqual(res["body"]["next_cursor"], "20")
+
+    def test_following_cursors_walks_every_item_once(self):
+        seen = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            seen.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="20", cursor="40")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_fit_page_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_end_is_empty_page(self):
+        body = get("/items", cursor="999")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for raw in ["0", "101", "-1", "1.5", "abc", "", " 5"]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor(self):
+        for raw in ["abc", "-3", "1.5", ""]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
