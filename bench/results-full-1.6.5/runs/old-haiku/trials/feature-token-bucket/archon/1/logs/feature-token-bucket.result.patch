 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _is_real(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def _check_positive_finite(name, value):
+    if not _is_real(value) or not math.isfinite(value) or value <= 0:
+        raise ValueError(f"{name} must be a finite number > 0, got {value!r}")
+
+
+def _check_rate(capacity, refill_per_sec):
+    _check_positive_finite("capacity", capacity)
+    _check_positive_finite("refill_per_sec", refill_per_sec)
+
+
+def _check_count(n, capacity):
+    _check_positive_finite("n", n)
+    if n > capacity:
+        raise ValueError(f"n={n} exceeds capacity {capacity}; it can never succeed")
+
+
+def _check_max_keys(max_keys):
+    if not isinstance(max_keys, int) or isinstance(max_keys, bool) or max_keys < 1:
+        raise ValueError(f"max_keys must be an integer >= 1, got {max_keys!r}")
+
+
+def _read_clock(clock):
+    now = clock()
+    if not _is_real(now) or not math.isfinite(now):
+        raise ValueError(f"clock must return a finite real number, got {now!r}")
+    return now
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate(capacity, refill_per_sec)
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        # Latest clock reading seen; the clock going backwards never moves it back.
+        self._latest = _read_clock(clock)
+
+    def _refill(self):
+        now = _read_clock(self._clock)
+        if now <= self._latest:
+            return
+        elapsed = now - self._latest
+        self._tokens = min(
+            self._capacity, self._tokens + elapsed * self._refill_per_sec
+        )
+        self._latest = now
+        assert 0 <= self._tokens <= self._capacity
+        assert elapsed > 0
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_count(n, self._capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        assert self._tokens >= 0
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_count(n, self._capacity)
+        self._refill()
+        deficit = n - self._tokens
+        if deficit <= 0:
+            return 0.0
+        return deficit / self._refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate(capacity, refill_per_sec)
+        _check_max_keys(max_keys)
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        # Ordered from least to most recently used.
+        self._buckets = OrderedDict()
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_count(n, self._capacity)
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_count(n, self._capacity)
+        return self._bucket_for(key).wait_time(n)
+
+    def _bucket_for(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys
+        return bucket
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
