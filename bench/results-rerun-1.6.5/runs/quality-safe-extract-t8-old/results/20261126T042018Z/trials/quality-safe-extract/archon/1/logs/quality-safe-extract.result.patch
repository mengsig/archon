+        self.assertEqual(tree(self.root), [])
+
+    def test_root_is_rejected_for_empty_batch_when_symlink(self):
+        link = self.base / "link"
+        link.symlink_to(self.root, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([], link)
