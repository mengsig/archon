@@ -0,0 +1,44 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login flow", ["work", "urgent"]),
+            Task(2, "Write login tests", ["work"], status="done"),
+            Task(3, "Buy milk", ["home"]),
+        ]
+
+    def test_terms_are_case_insensitive_and_anded(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "FIX login")], [1]
+        )
+        self.assertEqual(
+            [task.id for task in search(self.tasks, '"login flow"')], [1]
+        )
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "login tag:WORK status:open")],
+            [1],
+        )
+
+    def test_empty_query_keeps_all_tasks_in_order(self):
+        self.assertEqual(search(self.tasks, "  \t "), self.tasks)
+
+    def test_rejects_invalid_terms_and_quotes(self):
+        for query in (
+            "owner:me",
+            "status:pending",
+            "tag:",
+            '"unfinished phrase',
+            '"closed"suffix',
+        ):
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+
+if __name__ == "__main__":
+    unittest.main()
