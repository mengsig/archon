@@ -0,0 +1,53 @@
+import unittest
+
+from tasktracker.models import DONE, Task
+from tasktracker.search import QueryError, search
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login flow", tags=["Work", "urgent"]),
+            Task(2, "Review login tests", tags=["work"], status=DONE),
+            Task(3, "Fix logout flow", tags=["home"]),
+        ]
+
+    def test_bare_terms_match_case_insensitively_and_are_anded(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "FIX login")], [1]
+        )
+        self.assertEqual(search(self.tasks, "fix absent"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, '"login flow"')], [1]
+        )
+        self.assertEqual(search(self.tasks, '"flow login"'), [])
+
+    def test_tag_is_an_exact_case_insensitive_match(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "tag:WORK")], [1, 2]
+        )
+        self.assertEqual(search(self.tasks, "tag:wor"), [])
+
+    def test_status_filters_and_combines_with_other_terms(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "status:done login")], [2]
+        )
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "fix status:open")], [1, 3]
+        )
+
+    def test_blank_query_returns_all_tasks_in_input_order(self):
+        tasks = [self.tasks[2], self.tasks[0], self.tasks[1]]
+        self.assertEqual(search(tasks, " \t\n "), tasks)
+
+    def test_invalid_query_terms_raise_query_error(self):
+        for query in ("owner:me", "status:pending", '"unfinished phrase'):
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+
+if __name__ == "__main__":
+    unittest.main()
