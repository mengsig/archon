 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MAX_DIGITS = 18
+
+
+class QueryError(ValueError):
+    """A client-supplied query parameter is invalid; the message is sent back as the error."""
