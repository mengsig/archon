@@ -0,0 +1,95 @@
+"""Tests for TaskStore.undo (TT-104)."""
+import unittest
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(a.id)
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        a = store.add("first")
+        store.undo()
+        b = store.add("second")
+        self.assertEqual(a.id, 1)
+        self.assertEqual(b.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+
+    def test_undo_complete_keeps_task_done_if_it_was_already_done(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, DONE)
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["work"], due=None)
+        store.complete(a.id)
+        before = store.get(a.id)
+        snapshot = (before.id, before.title, list(before.tags), before.status, before.due)
+        store.delete(a.id)
+        store.undo()
+        restored = store.get(a.id)
+        self.assertIs(restored, before)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status, restored.due), snapshot)
+        self.assertEqual([t.id for t in store.all()], [a.id])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.delete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(a.id)
+
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("first")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
