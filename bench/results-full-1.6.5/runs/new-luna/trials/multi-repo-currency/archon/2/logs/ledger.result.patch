+#[test]
+fn validates_currency() {
+    for currency in ["usd", "US", "US1", "ÉUR", "EURO", " EUR "] {
+        assert!(matches!(
+            parse_line(&format!("2026-03-01\ta\t1\t{currency}")),
+            Err(ledger::ParseError::InvalidCurrency(_))
+        ));
+    }
+    assert!(parse_line("2026-03-01\ta\t1\tUSD\textra").is_err());
