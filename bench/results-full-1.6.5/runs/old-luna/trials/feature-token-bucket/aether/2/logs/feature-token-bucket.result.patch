 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _validate_request(n, capacity):
+    if n <= 0 or n > capacity:
+        raise ValueError("n must be > 0 and no greater than capacity")
+
+
+def _validate_configuration(capacity, refill_per_sec):
+    if capacity <= 0:
+        raise ValueError("capacity must be > 0")
+    if refill_per_sec <= 0:
+        raise ValueError("refill_per_sec must be > 0")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_configuration(capacity, refill_per_sec)
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = capacity
+        self._updated_at = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now > self._updated_at:
+            self._tokens = min(
+                self.capacity,
+                self._tokens + (now - self._updated_at) * self.refill_per_sec,
+            )
+            self._updated_at = now
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_configuration(capacity, refill_per_sec)
+        if max_keys < 1:
+            raise ValueError("max_keys must be >= 1")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket_for(self, key, n):
+        # Reject impossible requests before they create or evict a bucket.
+        _validate_request(n, self.capacity)
+        try:
+            bucket = self._buckets.pop(key)
+        except KeyError:
+            if len(self._buckets) >= self.max_keys:
+                self._buckets.popitem(last=False)
+            bucket = TokenBucket(self.capacity, self.refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        return bucket
 
