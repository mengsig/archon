 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _validate_positive(value, name):
+    if not value > 0:
+        raise ValueError("%s must be > 0" % name)
+
+
+def _validate_request(n, capacity):
+    if not (n > 0 and n <= capacity):
+        raise ValueError("n must be > 0 and <= capacity")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_positive(capacity, "capacity")
+        _validate_positive(refill_per_sec, "refill_per_sec")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.clock = clock
+        self._tokens = capacity
+        self._last_time = clock()
+
+    def _refill(self):
+        now = self.clock()
+        if now > self._last_time:
+            elapsed = now - self._last_time
+            self._tokens = min(
+                self.capacity, self._tokens + elapsed * self.refill_per_sec
+            )
+            self._last_time = now
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
 
 
 class KeyedLimiter:
