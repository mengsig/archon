+/// Accept an ISO 4217 code: exactly three uppercase ASCII letters.
+fn parse_currency(s: &str) -> Result<String, ParseError> {
+    if !is_currency_code(s) {
+        return Err(ParseError::BadCurrency(format!("bad currency {s:?}")));
+    }
+    Ok(s.to_string())
+}
+
+fn is_currency_code(s: &str) -> bool {
+    s.len() == 3 && s.bytes().all(|c| c.is_ascii_uppercase())
