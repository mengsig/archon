 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
+
+
+def _validated_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError("entry names must be nonempty strings")
+    if name.startswith("/") or "\\" in name or ":" in name or "\0" in name:
+        raise ValueError(f"invalid entry name: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"invalid entry name: {name!r}")
+    return parts
+
+
+def _validated_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a path string or pathlib.Path")
+    if isinstance(root, str) and not root:
+        raise ValueError("root must name an existing directory")
+    try:
+        path = Path(root)
+        mode = path.lstat().st_mode
+    except (TypeError, ValueError, OSError) as error:
+        # A missing or malformed root is an invalid API input. Other errors
+        # such as permission failures remain visible to the caller.
+        if isinstance(error, OSError) and not isinstance(
+            error, (FileNotFoundError, NotADirectoryError)
+        ):
+            raise
+        raise ValueError("root must name an existing directory") from error
+    if not stat.S_ISDIR(mode):
+        raise ValueError("root must be an existing real directory")
+    return path
+
+
+def _validate_filesystem(root, paths):
+    """Check targets and their ancestors without changing the filesystem."""
+    for parts in paths:
+        current = root
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = current.lstat().st_mode
+            except FileNotFoundError:
+                # A missing parent means all remaining components are absent.
+                break
+
+            is_target = index == len(parts) - 1
+            if stat.S_ISLNK(mode):
+                raise ValueError(f"symlink in extraction path: {current}")
+            if is_target:
+                raise ValueError(f"target already exists: {current}")
+            if not stat.S_ISDIR(mode):
+                raise ValueError(f"non-directory in extraction path: {current}")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write ``(relative_posix_name, bytes)`` entries beneath *root*.
+
+    The whole batch and all current filesystem conflicts are checked before
+    creating any directories or files.
+    """
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    names = set()
+    files = []
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        parts = _validated_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in names:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        names.add(name)
+        files.append((name, data, parts))
+
+    # A file may not also be an ancestor directory of another entry.
+    for name, _data, parts in files:
+        for index in range(1, len(parts)):
+            if "/".join(parts[:index]) in names:
+                raise ValueError(f"file/directory collision at {name!r}")
+
+    root_path = _validated_root(root)
+    _validate_filesystem(root_path, (parts for _name, _data, parts in files))
+
+    for _name, data, parts in files:
+        target = root_path.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        # Validation guaranteed absence. Exclusive creation also avoids
+        # overwriting a target if the filesystem changes during extraction.
+        with target.open("xb") as output:
+            output.write(data)
+
+    return [name for name, _data, _parts in files]
