@@ -0,0 +1,61 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, OPEN, Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class Tt102ExportTest(unittest.TestCase):
+    def test_header_only_when_no_tasks(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_rows_keep_input_order_and_crlf_endings(self):
+        tasks = [Task(2, "second"), Task(1, "first")]
+        self.assertEqual(to_csv(tasks), HEADER + "2,second,,open,\r\n1,first,,open,\r\n")
+
+    def test_tags_joined_with_semicolon_and_due_iso(self):
+        task = Task(3, "report", ["work", "urgent"], DONE, date(2026, 4, 1))
+        self.assertEqual(to_csv([task]), HEADER + "3,report,work;urgent,done,2026-04-01\r\n")
+
+    def test_empty_tags_and_due_are_empty_fields(self):
+        self.assertEqual(to_csv([Task(4, "plain", [], OPEN, None)]), HEADER + "4,plain,,open,\r\n")
+
+    def test_plain_fields_are_not_quoted(self):
+        self.assertEqual(to_csv([Task(5, "buy milk", ["home"])]), HEADER + "5,buy milk,home,open,\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        self.assertEqual(to_csv([Task(6, "a, b")]), HEADER + '6,"a, b",,open,\r\n')
+
+    def test_title_with_double_quote_is_quoted_and_doubled(self):
+        self.assertEqual(to_csv([Task(7, 'say "hi"')]), HEADER + '7,"say ""hi""",,open,\r\n')
+
+    def test_title_with_lf_is_quoted(self):
+        self.assertEqual(to_csv([Task(8, "line1\nline2")]), HEADER + '8,"line1\nline2",,open,\r\n')
+
+    def test_title_with_cr_is_quoted(self):
+        self.assertEqual(to_csv([Task(9, "a\rb")]), HEADER + '9,"a\rb",,open,\r\n')
+
+    def test_tag_with_comma_is_quoted(self):
+        self.assertEqual(to_csv([Task(10, "t", ["x,y", "z"])]), HEADER + '10,t,"x,y;z",open,\r\n')
+
+    def test_quoted_fields_parse_back_with_csv_reader(self):
+        title = 'fix, "login"\nnow\r\ndone'
+        text = to_csv([Task(11, title, ["a"], OPEN, date(2026, 5, 2))])
+        rows = list(csv.reader(io.StringIO(text, newline="")))
+        self.assertEqual(rows[1], ["11", title, "a", "open", "2026-05-02"])
+
+    def test_rejects_non_string_title(self):
+        with self.assertRaises(AssertionError):
+            to_csv([Task(12, 42)])
+
+    def test_rejects_non_date_due(self):
+        with self.assertRaises(AssertionError):
+            to_csv([Task(13, "t", [], OPEN, "2026-05-02")])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_tt103_search.py b/tests/test_tt103_search.py
