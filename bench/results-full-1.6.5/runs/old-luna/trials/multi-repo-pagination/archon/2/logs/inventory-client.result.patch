+test('lists every page in request order and round-trips opaque cursors', async () => {
+  const calls = [];
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'opaque /?token=first' },
+    { items: [ITEMS[1]], next_cursor: 'second:token' },
+    { items: [{ id: 3, sku: 'SKU-0003', qty: 8 }], next_cursor: null },
+  ];
+  const transport = async (request) => {
+    calls.push(request);
+    return { status: 200, body: pages[calls.length - 1] };
+  };
+
+  assert.deepEqual(await listItems(transport), [
+    ...ITEMS,
+    { id: 3, sku: 'SKU-0003', qty: 8 },
+  ]);
+  assert.deepEqual(calls.map(({ query }) => query), [
+    {},
+    { cursor: 'opaque /?token=first' },
+    { cursor: 'second:token' },
+  ]);
+});
+
+test('stops when next_cursor is absent', async () => {
+  const calls = [];
+  const transport = async (request) => {
+    calls.push(request);
+    return { status: 200, body: { items: ITEMS } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(calls.map(({ query }) => query), [{}]);
+});
+
