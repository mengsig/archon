diff --git a/test_api.py b/test_api.py
index 55cd1fd..862c3d3 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,51 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_defaults_to_20_items(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertEqual(body["next_cursor"], "21")
+
+    def test_following_next_cursor_visits_every_item_once(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "10"}
+            if cursor is not None:
+                query["cursor"] = cursor
+            body = get("/items", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_no_next_cursor(self):
+        body = get("/items", limit="20", cursor="41")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_limit_100_returns_everything_in_one_page(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_the_end_is_an_empty_last_page(self):
+        body = get("/items", cursor="1000")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_invalid_limit_is_400(self):
+        for limit in ["0", "101", "-1", "abc", "", "1.5", "+5"]:
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("error", res["body"], limit)
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ["abc", "-1", "", "1.5", "12x"]:
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("error", res["body"], cursor)
+
 
 if __name__ == "__main__":
     unittest.main()
