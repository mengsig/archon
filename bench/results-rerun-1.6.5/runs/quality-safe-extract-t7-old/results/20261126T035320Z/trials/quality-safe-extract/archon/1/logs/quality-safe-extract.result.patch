@@ -5,6 +6,244 @@ from pathlib import Path
 from safe_extract import extract
 
 
+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.base = Path(directory.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertRootEmpty(self):
+        self.assertEqual(list(self.root.iterdir()), [])
+
+
+class ExtractBatchValidation(TempRootCase):
+    def test_rejects_non_list_batches_without_consuming_them(self):
+        generator = ((name, b"") for name in ["a", "b"])
+        for batch in [(("a", b""),), generator, iter([("a", b"")]), "a"]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b""))
+        self.assertRootEmpty()
+
+    def test_rejects_non_list_empty_batches(self):
+        with self.assertRaises(ValueError):
+            extract((), self.root)
+
+    def test_empty_list_succeeds_after_root_validation(self):
+        self.assertEqual(extract([], str(self.root)), [])
+        self.assertRootEmpty()
+
+    def test_rejects_malformed_entries(self):
+        malformed = [
+            ["a", b""],
+            ("a",),
+            ("a", b"", b""),
+            "ab",
+            None,
+        ]
+        for entry in malformed:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b""), entry], self.root)
+        self.assertRootEmpty()
+
+    def test_rejects_non_string_names_and_non_bytes_data(self):
+        bad_entries = [
+            (b"a", b""),
+            (1, b""),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", None),
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([entry], self.root)
+        self.assertRootEmpty()
+
+    def test_rejects_invalid_names(self):
+        bad_names = [
+            "",
+            "/abs",
+            "a\\b",
+            "C:file",
+            "a:b",
+            "a\0b",
+            "a//b",
+            "a/",
+            "./a",
+            "a/./b",
+            "../a",
+            "a/../b",
+            "..",
+            ".",
+        ]
+        for name in bad_names:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([(name, b"x")], self.root)
+        self.assertRootEmpty()
+
+    def test_literal_percent_and_unicode_names_are_kept(self):
+        names = ["100%.txt", "dir%2e%2e/file", "unicodé/ü.bin", "...", ".hidden"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
+        for name in names:
+            self.assertEqual((self.root / name).read_bytes(), b"x")
+
+    def test_rejects_names_that_are_not_valid_unicode_before_writing(self):
+        for name in ["bad\ud800", "\udc80x", "\ud800"]:
+            with self.subTest(name=repr(name)):
+                with self.assertRaises(ValueError):
+                    extract([("ok.txt", b"1"), (name, b"2")], self.root)
+                self.assertRootEmpty()
+
+    def test_overlong_name_error_surfaces_before_writing(self):
+        with self.assertRaises(OSError):
+            extract([("ok.txt", b"1"), ("a" * 300, b"2")], self.root)
+        self.assertRootEmpty()
+
+    def test_rejects_duplicate_names_in_batch(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a", b"2")], self.root)
+        self.assertRootEmpty()
+
+    def test_rejects_file_directory_collision_in_either_order(self):
+        orders = [[("a", b""), ("a/b", b"")], [("a/b", b""), ("a", b"")]]
+        for entries in orders:
+            with self.subTest(entries=[name for name, _ in entries]):
+                with self.assertRaises(ValueError):
+                    extract(entries, self.root)
+        self.assertRootEmpty()
+
+    def test_rejects_batch_when_any_later_entry_is_invalid(self):
+        entries = [("good/one", b"1"), ("good/two", b"2"), ("bad/../x", b"3")]
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertRootEmpty()
+
+    def test_sibling_names_sharing_a_prefix_are_not_collisions(self):
+        entries = [("a", b"1"), ("ab", b"2"), ("a2/b", b"3")]
+        self.assertEqual(extract(entries, self.root), ["a", "ab", "a2/b"])
+
+
+class ExtractRootValidation(TempRootCase):
+    def test_rejects_missing_root(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"")], self.base / "missing")
+        self.assertFalse((self.base / "missing").exists())
+
+    def test_rejects_root_that_is_a_file(self):
+        target = self.base / "file"
+        target.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], target)
+        with self.assertRaises(ValueError):
+            extract([("a", b"")], target)
+
+    def test_rejects_root_of_wrong_type(self):
+        for root in [None, 42, b"/tmp", ""]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([], root)
+
+    def test_rejects_symlink_root_even_when_it_points_to_a_directory(self):
+        link = self.base / "link"
+        os.symlink(self.root, link, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("a", b"")], link)
+        self.assertRootEmpty()
+
+
+class ExtractConflicts(TempRootCase):
+    def test_rejects_existing_file_without_overwriting(self):
+        (self.root / "a").write_bytes(b"original")
+        with self.assertRaises(ValueError):
+            extract([("b", b""), ("a", b"new")], self.root)
+        self.assertEqual((self.root / "a").read_bytes(), b"original")
+        self.assertFalse((self.root / "b").exists())
+
+    def test_rejects_existing_directory_as_target(self):
+        (self.root / "dir").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("dir", b"x")], self.root)
+
+    def test_rejects_existing_file_as_ancestor(self):
+        (self.root / "f").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("f/child", b"x")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"")
+
+    def test_accepts_existing_directory_ancestor(self):
+        (self.root / "dir").mkdir()
+        self.assertEqual(extract([("dir/new.txt", b"ok")], self.root), ["dir/new.txt"])
+        self.assertEqual((self.root / "dir/new.txt").read_bytes(), b"ok")
+
+
+class ExtractSymlinkRejection(TempRootCase):
+    def setUp(self):
+        super().setUp()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def test_rejects_symlink_target_to_file_inside_root(self):
+        (self.root / "real").write_bytes(b"keep")
+        os.symlink(self.root / "real", self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link", b"x")], self.root)
+        self.assertEqual((self.root / "real").read_bytes(), b"keep")
+
+    def test_rejects_dangling_symlink_target(self):
+        os.symlink(self.base / "nowhere", self.root / "dangling")
+        with self.assertRaises(ValueError):
+            extract([("dangling", b"x")], self.root)
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_rejects_symlinked_ancestor_pointing_outside(self):
+        os.symlink(self.outside, self.root / "escape", target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("escape/pwned.txt", b"x")], self.root)
+        self.assertEqual(list(self.outside.iterdir()), [])
+
+    def test_rejects_symlinked_ancestor_pointing_inside_root(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "alias", target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("alias/x.txt", b"x")], self.root)
+        self.assertEqual(list((self.root / "real").iterdir()), [])
+
+    def test_rejects_dangling_symlink_ancestor(self):
+        os.symlink(self.outside / "missing", self.root / "dangling")
+        with self.assertRaises(ValueError):
+            extract([("dangling/x", b"x")], self.root)
+        self.assertFalse((self.outside / "missing").exists())
+
+    def test_rejects_batch_with_symlink_conflict_after_valid_entries(self):
+        os.symlink(self.outside, self.root / "escape", target_is_directory=True)
+        entries = [("ok/one.txt", b"1"), ("escape/two.txt", b"2")]
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertFalse((self.root / "ok").exists())
+        self.assertEqual(list(self.outside.iterdir()), [])
+
+
+class ExtractWrites(TempRootCase):
+    def test_creates_missing_parents_and_exact_bytes(self):
+        payload = bytes(range(256))
+        self.assertEqual(extract([("a/b/c.bin", payload)], self.root), ["a/b/c.bin"])
+        self.assertEqual((self.root / "a/b/c.bin").read_bytes(), payload)
+
+    def test_writes_empty_file(self):
