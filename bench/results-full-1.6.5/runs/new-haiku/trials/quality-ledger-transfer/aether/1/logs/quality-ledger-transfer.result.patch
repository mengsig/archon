 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"amount must be an integer in [1, {MAX_BALANCE}]")
+
+
+def _check_balance(name, balance):
+    if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+        raise ValueError(
+            f"balance for {name!r} must be an integer in [0, {MAX_BALANCE}]"
+        )
+
+
+def _check_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError("account name must be a nonempty string")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+        accounts = dict(balances)
+        for name, balance in accounts.items():
+            _check_name(name)
+            _check_balance(name, balance)
+        self._balances = accounts
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        with self._lock:
+            self._require_accounts(source, destination)
+            return self._move(source, destination, amount)
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _require_accounts(self, *names):
+        for name in names:
+            if name not in self._balances:
+                raise KeyError(name)
+
+    def _move(self, source, destination, amount):
+        if source == destination:
+            return self._balances[source] >= amount
+        if self._balances[source] < amount:
+            return False
+        if self._balances[destination] > MAX_BALANCE - amount:
+            return False
+        self._balances[source] -= amount
+        self._balances[destination] += amount
+        assert self._balances[source] >= 0
+        assert self._balances[destination] <= MAX_BALANCE
+        return True
