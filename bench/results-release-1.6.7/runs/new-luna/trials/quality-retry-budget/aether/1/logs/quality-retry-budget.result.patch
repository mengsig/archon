diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..e03372f 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,40 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+        type(retry_after_ms) is not int or retry_after_ms < 0
+    ):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        exponent = attempt - 1
+        # Once 2**exponent reaches cap_ms, multiplying by base_ms cannot
+        # reduce the result. This keeps very large attempt values bounded.
+        if base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms * (1 << exponent))
+
+    delay = backoff
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..dcbcfdf 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,55 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validation_rejects_non_builtin_integers(self):
+        class IntSubclass(int):
+            pass
+
+        cases = (
+            ((True, 0), {}),
+            ((1, False), {}),
+            ((1, 0), {"max_attempts": True}),
+            ((1, 0), {"budget_ms": 2.0}),
+            ((1, 0), {"base_ms": -1}),
+            ((1, 0), {"cap_ms": -1}),
+            ((1, 0), {"retry_after_ms": -1}),
+            ((1, 0), {"retry_after_ms": 1.5}),
+            ((IntSubclass(1), 0), {}),
+        )
+        for args, kwargs in cases:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_validation_happens_before_exhaustion_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, retry_after_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_attempts_above_limit_are_exhausted_after_validation(self):
+        self.assertIsNone(retry_delay(7, 0, max_attempts=4))
+
+    def test_zero_values_and_base_above_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=900, cap_ms=10), 10)
+
+    def test_retry_after_is_uncapped_and_budget_boundary_is_strict(self):
+        self.assertEqual(
+            retry_delay(1, 0, budget_ms=251, retry_after_ms=250), 250
+        )
+        self.assertIsNone(
+            retry_delay(1, 0, budget_ms=250, retry_after_ms=250)
+        )
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_zero_delay_still_requires_time_before_budget(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=1, base_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 1, budget_ms=1, base_ms=0))
+
+    def test_huge_attempt_saturates_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
