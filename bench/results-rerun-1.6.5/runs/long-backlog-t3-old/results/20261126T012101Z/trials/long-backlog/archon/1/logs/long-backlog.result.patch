+++ b/tests/test_search.py
@@ -0,0 +1,93 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("write report", tags=["home", "work-extra"])
+    store.add("Login page copy")
+    store.complete(2)
+    return store
+
+
+def _titles(query):
+    return [t.title for t in search(_store().all(), query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_empty_and_blank_query_match_everything_in_order(self):
+        all_titles = ["Fix login bug", "write report", "Login page copy"]
+        self.assertEqual(_titles(""), all_titles)
+        self.assertEqual(_titles("   \t "), all_titles)
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(_titles("LOGIN"), ["Fix login bug", "Login page copy"])
+        self.assertEqual(_titles("invoice"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_titles('"fix login"'), ["Fix login bug"])
+        self.assertEqual(_titles('"login fix"'), [])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(_titles("login bug"), ["Fix login bug"])
+        self.assertEqual(_titles("login report"), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(_titles("tag:work"), ["Fix login bug"])
+        self.assertEqual(_titles("tag:WORK"), ["Fix login bug"])
+        self.assertEqual(_titles("tag:wor"), [])
+
+    def test_tag_with_quoted_value(self):
+        self.assertEqual(_titles('tag:"work-extra"'), ["write report"])
+
+    def test_status_filters(self):
+        self.assertEqual(_titles("status:done"), ["write report"])
+        self.assertEqual(_titles("status:open"), ["Fix login bug", "Login page copy"])
+        self.assertEqual(_titles("status:Done"), ["write report"])
+
+    def test_field_and_word_combine(self):
+        self.assertEqual(_titles("login status:open"), ["Fix login bug", "Login page copy"])
+        self.assertEqual(_titles("tag:work status:done"), [])
+
+    def test_quoted_colon_is_a_phrase_not_a_field(self):
+        self.assertEqual(_titles('"tag:work"'), [])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "priority:high")
+        with self.assertRaises(QueryError):
+            search(_store().all(), "due-date:friday")
+        with self.assertRaises(QueryError):
+            search(_store().all(), "a-b:c")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "status:archived")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "tag:")
+        with self.assertRaises(QueryError):
+            search(_store().all(), "status:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), 'login "fix')
+
+    def test_empty_phrase_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), '""')
+        with self.assertRaises(QueryError):
+            search(_store().all(), '"   "')
+
+    def test_no_tasks_still_validates_query(self):
+        self.assertEqual(search([], "login"), [])
+        with self.assertRaises(QueryError):
+            search([], "status:archived")
+
+
+if __name__ == "__main__":
+    unittest.main()
