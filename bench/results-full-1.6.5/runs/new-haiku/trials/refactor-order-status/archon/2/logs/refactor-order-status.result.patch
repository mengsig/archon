diff --git a/src/status.rs b/src/status.rs
new file mode 100644
index 0000000..aea2970
--- /dev/null
+++ b/src/status.rs
@@ -0,0 +1,136 @@
+use std::fmt;
+use std::str::FromStr;
+
+/// Lifecycle state of an order. The only place status names are spelled out.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum OrderStatus {
+    Pending,
+    Paid,
+    Shipped,
+    Cancelled,
+}
+
+impl OrderStatus {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            OrderStatus::Pending => "pending",
+            OrderStatus::Paid => "paid",
+            OrderStatus::Shipped => "shipped",
+            OrderStatus::Cancelled => "cancelled",
+        }
+    }
+
+    pub fn can_transition_to(self, next: OrderStatus) -> bool {
+        matches!(
+            (self, next),
+            (OrderStatus::Pending, OrderStatus::Paid)
+                | (OrderStatus::Pending, OrderStatus::Cancelled)
+                | (OrderStatus::Paid, OrderStatus::Shipped)
+                | (OrderStatus::Paid, OrderStatus::Cancelled)
+        )
+    }
+}
+
+impl fmt::Display for OrderStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.pad(self.as_str())
+    }
+}
+
+/// Error for a status name that is not one of the four known statuses.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ParseStatusError {
+    input: String,
+}
+
+impl fmt::Display for ParseStatusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "unknown status {:?}", self.input)
+    }
+}
+
+impl std::error::Error for ParseStatusError {}
+
+impl FromStr for OrderStatus {
+    type Err = ParseStatusError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        const ALL: [OrderStatus; 4] = [
+            OrderStatus::Pending,
+            OrderStatus::Paid,
+            OrderStatus::Shipped,
+            OrderStatus::Cancelled,
+        ];
+        ALL.into_iter()
+            .find(|status| status.as_str() == s)
+            .ok_or_else(|| ParseStatusError {
+                input: s.to_string(),
+            })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ALL: [OrderStatus; 4] = [
+        OrderStatus::Pending,
+        OrderStatus::Paid,
+        OrderStatus::Shipped,
+        OrderStatus::Cancelled,
+    ];
+
+    #[test]
+    fn as_str_returns_lowercase_names() {
+        assert_eq!(OrderStatus::Pending.as_str(), "pending");
+        assert_eq!(OrderStatus::Paid.as_str(), "paid");
+        assert_eq!(OrderStatus::Shipped.as_str(), "shipped");
+        assert_eq!(OrderStatus::Cancelled.as_str(), "cancelled");
+    }
+
+    #[test]
+    fn display_prints_the_same_text_and_honours_padding() {
+        for status in ALL {
+            assert_eq!(status.to_string(), status.as_str());
+        }
+        assert_eq!(format!("[{:>10}]", OrderStatus::Paid), "[      paid]");
+    }
+
+    #[test]
+    fn parse_accepts_each_name() {
+        for status in ALL {
+            assert_eq!(status.as_str().parse::<OrderStatus>(), Ok(status));
+        }
+    }
+
+    #[test]
+    fn parse_rejects_other_text_and_names_the_input() {
+        for input in ["lost", "Paid", " paid", ""] {
+            let err = input.parse::<OrderStatus>().unwrap_err();
+            assert_eq!(err.to_string(), format!("unknown status {input:?}"));
+            assert!(err.to_string().contains(&format!("{input:?}")));
+        }
+    }
+
+    #[test]
+    fn parse_error_implements_std_error() {
+        let err: Box<dyn std::error::Error> = Box::new("lost".parse::<OrderStatus>().unwrap_err());
+        assert_eq!(err.to_string(), r#"unknown status "lost""#);
+    }
+
+    #[test]
+    fn transitions_follow_the_lifecycle_table() {
+        let allowed = [
+            (OrderStatus::Pending, OrderStatus::Paid),
+            (OrderStatus::Pending, OrderStatus::Cancelled),
+            (OrderStatus::Paid, OrderStatus::Shipped),
+            (OrderStatus::Paid, OrderStatus::Cancelled),
+        ];
+        for from in ALL {
+            for to in ALL {
+                let expected = allowed.contains(&(from, to));
+                assert_eq!(from.can_transition_to(to), expected, "{from} -> {to}");
+            }
+        }
+    }
+}
diff --git a/tests/characterization.rs b/tests/characterization.rs
new file mode 100644
index 0000000..e4d1fc0
--- /dev/null
+++ b/tests/characterization.rs
@@ -0,0 +1,211 @@
+//! Characterization of current order behaviour. Status is observed through
+//! `to_string()` and error text only, so these tests hold for a String field
+//! and for a typed status alike.
+
+use orders::{billing, report, shipping, Order};
+
+fn pending() -> Order {
+    Order::new(7, "ada", 900)
+}
+
+fn paid() -> Order {
+    let mut order = pending();
+    billing::pay(&mut order).unwrap();
+    order
+}
+
+fn shipped() -> Order {
+    let mut order = paid();
+    shipping::ship(&mut order).unwrap();
+    order
+}
+
+fn cancelled() -> Order {
+    let mut order = pending();
+    order.cancel().unwrap();
+    order
+}
+
+fn states() -> Vec<(&'static str, Order)> {
+    vec![
+        ("pending", pending()),
+        ("paid", paid()),
+        ("shipped", shipped()),
+        ("cancelled", cancelled()),
+    ]
+}
+
+#[test]
+fn pay_succeeds_only_from_pending() {
+    for (name, mut order) in states() {
+        let result = billing::pay(&mut order);
+        if name == "pending" {
+            assert!(result.is_ok());
+            assert_eq!(order.status.to_string(), "paid");
+        } else {
+            assert_eq!(
+                result.unwrap_err(),
+                format!("order 7 cannot be paid: it is {name}")
+            );
+            assert_eq!(order.status.to_string(), name);
+        }
+    }
+}
+
+#[test]
+fn ship_succeeds_only_from_paid() {
+    for (name, mut order) in states() {
+        let result = shipping::ship(&mut order);
+        if name == "paid" {
+            assert!(result.is_ok());
+            assert_eq!(order.status.to_string(), "shipped");
+        } else {
+            assert_eq!(
+                result.unwrap_err(),
+                format!("order 7 cannot be shipped: it is {name}")
+            );
+            assert_eq!(order.status.to_string(), name);
+        }
+    }
+}
+
+#[test]
+fn cancel_succeeds_only_from_pending_or_paid() {
+    for (name, mut order) in states() {
+        let result = order.cancel();
+        if name == "pending" || name == "paid" {
+            assert!(result.is_ok());
+            assert_eq!(order.status.to_string(), "cancelled");
+        } else {
+            assert_eq!(
+                result.unwrap_err(),
+                format!("order 7 cannot be cancelled: it is {name}")
+            );
+            assert_eq!(order.status.to_string(), name);
+        }
+    }
+}
+
+#[test]
+fn is_open_is_true_only_for_pending_and_paid() {
+    for (name, order) in states() {
+        let expected = name == "pending" || name == "paid";
+        assert_eq!(order.is_open(), expected, "status {name}");
+    }
+}
+
+#[test]
+fn new_orders_start_pending_with_given_fields() {
+    let order = Order::new(3, "cy", 1234);
+    assert_eq!(order.id, 3);
+    assert_eq!(order.customer, "cy");
+    assert_eq!(order.total_cents, 1234);
+    assert_eq!(order.status.to_string(), "pending");
+}
+
+#[test]
+fn outstanding_cents_sums_only_pending_orders() {
+    let mut orders = Vec::new();
+    for (price, (_, order)) in [1u64, 10, 100, 1000].into_iter().zip(states()) {
+        let mut order = order;
+        order.total_cents = price;
+        orders.push(order);
+    }
+    assert_eq!(billing::outstanding_cents(&orders), 1);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_keeps_input_order_and_only_paid_orders() {
+    let mut orders = Vec::new();
+    for id in [5u32, 2, 9, 4] {
+        let mut order = Order::new(id, "x", 1);
+        if id != 2 {
+            billing::pay(&mut order).unwrap();
+        }
+        if id == 4 {
+            shipping::ship(&mut order).unwrap();
+        }
+        orders.push(order);
+    }
+    assert_eq!(shipping::ready_to_ship(&orders), [5, 9]);
+    assert_eq!(shipping::ready_to_ship(&[]), Vec::<u32>::new());
+}
+
+#[test]
+fn status_counts_are_sorted_by_status_name() {
+    let mut orders: Vec<Order> = states().into_iter().map(|(_, o)| o).collect();
+    orders.push(pending());
+    let counts: Vec<(String, usize)> = report::status_counts(&orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        counts,
+        [
+            ("cancelled".to_string(), 1),
+            ("paid".to_string(), 1),
+            ("pending".to_string(), 2),
+            ("shipped".to_string(), 1),
+        ]
+    );
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn to_line_writes_each_status_name_and_round_trips() {
+    for (name, order) in states() {
+        let line = report::to_line(&order);
+        assert_eq!(line, format!("7,ada,900,{name}"));
+        assert_eq!(report::from_line(&line).unwrap(), order);
+    }
+}
+
+#[test]
+fn from_line_reports_wrong_field_count() {
+    let err = report::from_line("1,ada,100").unwrap_err();
+    assert_eq!(err, "expected 4 fields, got 3");
+    let err = report::from_line("1,ada,100,paid,extra").unwrap_err();
+    assert_eq!(err, "expected 4 fields, got 5");
+}
+
+#[test]
+fn from_line_checks_id_then_total_then_status() {
+    let err = report::from_line("x,ada,100,lost").unwrap_err();
+    assert_eq!(err, r#"bad id "x": invalid digit found in string"#);
+    let err = report::from_line("1,ada,x,lost").unwrap_err();
+    assert_eq!(err, r#"bad total "x": invalid digit found in string"#);
+    let err = report::from_line("1,ada,100,lost").unwrap_err();
+    assert_eq!(err, r#"unknown status "lost""#);
+}
+
+#[test]
+fn from_line_rejects_empty_and_negative_numbers() {
+    let err = report::from_line("-1,ada,100,paid").unwrap_err();
+    assert_eq!(err, r#"bad id "-1": invalid digit found in string"#);
+    let err = report::from_line(",ada,100,paid").unwrap_err();
+    assert_eq!(err, r#"bad id "": cannot parse integer from empty string"#);
+}
+
+#[test]
+fn from_line_status_is_case_and_space_sensitive() {
+    let err = report::from_line("1,ada,100,Paid").unwrap_err();
+    assert_eq!(err, r#"unknown status "Paid""#);
+    let err = report::from_line("1,ada,100, paid").unwrap_err();
+    assert_eq!(err, r#"unknown status " paid""#);
+}
+
+#[test]
+fn from_line_trims_the_whole_line_but_not_fields() {
+    let order = report::from_line("  1,ada,100,paid\n").unwrap();
+    assert_eq!(order.status.to_string(), "paid");
+    let order = report::from_line("1, ada ,100,paid").unwrap();
+    assert_eq!(order.customer, " ada ");
+}
+
+#[test]
+fn from_line_accepts_an_empty_customer() {
+    let order = report::from_line("1,,100,pending").unwrap();
+    assert_eq!(order.customer, "");
+    assert_eq!(order.status.to_string(), "pending");
+}
