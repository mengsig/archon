+class ExtractBatchValidation(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def assertRejectsWithoutChanges(self, entries, root=None):
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_non_list_batches_rejected_and_not_consumed(self):
+        generator = ((name, b"") for name in ["a"])
+        iterator = iter([("a", b"")])
+        for batch in [(), (("a", b""),), iterator, generator]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b""))
+        self.assertEqual(next(iterator), ("a", b""))
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_malformed_entries_rejected(self):
+        bad_entries = [
+            [["a", b""]],
+            [("a",)],
+            [("a", b"", "extra")],
+            ["a"],
+        ]
+        for entries in bad_entries:
+            with self.subTest(entries=entries):
+                self.assertRejectsWithoutChanges(entries)
+
+    def test_non_string_name_and_non_bytes_data_rejected(self):
+        self.assertRejectsWithoutChanges([("ok", b""), (b"bytes-name", b"")])
+        self.assertRejectsWithoutChanges([("ok", b""), (None, b"")])
+        self.assertRejectsWithoutChanges([("ok", "text")])
+        self.assertRejectsWithoutChanges([("ok", bytearray(b"x"))])
+
+    def test_invalid_names_rejected(self):
+        bad_names = [
+            "",
+            "/abs",
+            "a/",
+            "a//b",
+            "./a",
+            "a/.",
+            "a/../b",
+            "..",
+            ".",
+            "a\\b",
+            "C:x",
+            "a:b",
+            "a\0b",
+            "\ud800",
+        ]
+        for name in bad_names:
+            with self.subTest(name=name):
+                self.assertRejectsWithoutChanges([("ok", b""), (name, b"x")])
+
+    def test_literal_percent_names_are_kept_exactly(self):
+        names = ["100%", "%2e%2e/x", "a%20b"]
+        entries = [(name, name.encode()) for name in names]
+        self.assertEqual(extract(entries, self.root), names)
+        self.assertEqual((self.root / "%2e%2e" / "x").read_bytes(), b"%2e%2e/x")
+        self.assertEqual((self.root / "a%20b").read_bytes(), b"a%20b")
+
+    def test_duplicate_names_rejected(self):
+        self.assertRejectsWithoutChanges([("a", b""), ("a", b"x")])
+
+    def test_file_directory_collisions_rejected_in_either_order(self):
+        self.assertRejectsWithoutChanges([("a", b""), ("a/b", b"")])
+        self.assertRejectsWithoutChanges([("a/b", b""), ("a", b"")])
+        self.assertRejectsWithoutChanges([("a/b/c", b""), ("a/b", b"")])
+
+    def test_validation_failure_leaves_root_unchanged(self):
+        self.assertRejectsWithoutChanges([("good/file", b"x"), ("bad/../x", b"")])
+
+    def test_string_root_is_accepted(self):
+        self.assertEqual(extract([("f", b"x")], str(self.root)), ["f"])
+        self.assertEqual((self.root / "f").read_bytes(), b"x")
+
+
+class ExtractRootValidation(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.base = Path(self._tmp.name)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_missing_root_rejected_even_for_empty_batch(self):
+        for batch in [[], [("a", b"")]]:
+            with self.subTest(batch=batch):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.base / "missing")
+
+    def test_file_root_rejected(self):
+        target = self.base / "file"
+        target.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], target)
+
+    def test_symlink_root_rejected_even_for_empty_batch(self):
+        real = self.base / "real"
+        real.mkdir()
+        link = self.base / "link"
+        os.symlink(real, link)
+        with self.assertRaises(ValueError):
+            extract([], link)
+        with self.assertRaises(ValueError):
+            extract([("f", b"x")], link)
+        self.assertEqual(list(real.iterdir()), [])
+
+    def test_invalid_root_types_rejected(self):
+        for root in [None, 42, b"/tmp"]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([], root)
+
+
+class ExtractExistingPaths(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_existing_file_is_never_overwritten(self):
+        (self.root / "keep").write_bytes(b"original")
+        with self.assertRaises(ValueError):
+            extract([("ok", b"x"), ("keep", b"new")], self.root)
+        self.assertEqual((self.root / "keep").read_bytes(), b"original")
+        self.assertFalse((self.root / "ok").exists())
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "dir").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("dir", b"x")], self.root)
+
+    def test_file_ancestor_rejected(self):
+        (self.root / "a").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("a/b", b"x")], self.root)
+
+    def test_symlink_ancestor_rejected_even_inside_root(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link/f", b"x")], self.root)
+        self.assertEqual(list((self.root / "real").iterdir()), [])
+
+    def test_dangling_symlink_target_rejected(self):
+        os.symlink(self.root / "nowhere", self.root / "dangling")
+        with self.assertRaises(ValueError):
+            extract([("dangling", b"x")], self.root)
+        self.assertFalse((self.root / "nowhere").exists())
+
+    def test_symlink_target_to_file_inside_root_not_followed(self):
+        (self.root / "real").write_bytes(b"orig")
+        os.symlink(self.root / "real", self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link", b"x")], self.root)
+        self.assertEqual((self.root / "real").read_bytes(), b"orig")
+
+    def test_unexpected_io_error_propagates(self):
+        with mock.patch("safe_extract.os.open", side_effect=PermissionError("denied")):
+            with self.assertRaises(PermissionError):
+                extract([("f", b"x")], self.root)
+
+
+class ExtractWrites(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self._tmp.name)
+
+    def tearDown(self):
+        self._tmp.cleanup()
+
+    def test_creates_missing_parents_and_exact_bytes(self):
+        payload = bytes(range(256))
+        entries = [("a/b/c.bin", payload), ("a/empty", b""), ("z", b"last")]
+        self.assertEqual(extract(entries, self.root), ["a/b/c.bin", "a/empty", "z"])
+        self.assertEqual((self.root / "a/b/c.bin").read_bytes(), payload)
+        self.assertEqual((self.root / "a/empty").read_bytes(), b"")
+        self.assertEqual((self.root / "z").read_bytes(), b"last")
+
+    def test_returns_names_in_input_order(self):
+        names = ["c", "a/x", "b"]
+        result = extract([(name, b"") for name in names], self.root)
+        self.assertEqual(result, names)
+
+    def test_names_containing_spaces_and_unicode_are_kept(self):
+        names = ["dir with space/é.txt"]
+        self.assertEqual(extract([(names[0], b"x")], self.root), names)
+        self.assertEqual((self.root / names[0]).read_bytes(), b"x")
