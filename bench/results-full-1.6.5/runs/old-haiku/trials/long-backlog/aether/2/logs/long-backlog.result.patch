diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..fa62b5f 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,62 @@
+import re
+
+from .models import DONE, OPEN
+
+TOKEN = re.compile(r'(?:[^\s"]|"[^"]*")+')
+FIELD = re.compile(r"(\w+):(.*)", re.DOTALL)
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order.
+
+    Terms are split on whitespace outside double quotes. A bare word or quoted
+    phrase matches titles; `tag:NAME` and `status:VALUE` match fields.
+    """
+    assert isinstance(query, str), "query must be a string"
+    _check_quotes_closed(query)
+    matchers = [_term_matcher(token) for token in TOKEN.findall(query)]
+    return [task for task in tasks if all(matches(task) for matches in matchers)]
+
+
+def _check_quotes_closed(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+
+
+def _term_matcher(token):
+    text = token.replace('"', "")
+    if token.startswith('"'):
+        return _title_matcher(text)
+    field = FIELD.fullmatch(text)
+    if not field:
+        return _title_matcher(text)
+    name, value = field.groups()
+    if not value:
+        raise QueryError(f"empty value for {name}:")
+    if name == "tag":
+        return _tag_matcher(value)
+    if name == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown field: {name}")
+
+
+def _title_matcher(phrase):
+    needle = phrase.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_matcher(name):
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_matcher(value):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status: {value}")
+    return lambda task: task.status == status
