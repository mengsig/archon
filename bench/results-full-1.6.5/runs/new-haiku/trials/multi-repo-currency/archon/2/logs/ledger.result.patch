diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..df63b86
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,82 @@
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+struct Run {
+    code: Option<i32>,
+    stdout: String,
+    stderr: String,
+}
+
+fn run_ledger(input: &str) -> Run {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    let output = child.wait_with_output().expect("wait ledger");
+    Run {
+        code: output.status.code(),
+        stdout: String::from_utf8(output.stdout).expect("utf8 stdout"),
+        stderr: String::from_utf8(output.stderr).expect("utf8 stderr"),
+    }
+}
+
+#[test]
+fn three_column_input_defaults_to_usd() {
+    let run = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(run.code, Some(0));
+    assert_eq!(
+        run.stdout,
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn four_column_input_carries_currency() {
+    let run = run_ledger("2026-03-01\tcafe\t3.50\tEUR\n2026-03-02\tfuel\t10\tUSD\n");
+    assert_eq!(run.code, Some(0));
+    assert_eq!(
+        run.stdout,
+        "date,account,amount_cents,currency\n\
+         2026-03-01,cafe,350,EUR\n\
+         2026-03-02,fuel,1000,USD\n"
+    );
+}
+
+#[test]
+fn malformed_currency_exits_2_naming_line() {
+    for (input, bad_line) in [
+        ("2026-03-01\tcafe\t1\tUSD\n2026-03-02\tfuel\t2\teur\n", 2),
+        ("# note\n\n2026-03-01\tcafe\t1\tUSDX\n", 3),
+        ("2026-03-01\tcafe\t1\tU5D\n", 1),
+    ] {
+        let run = run_ledger(input);
+        assert_eq!(run.code, Some(2), "input {input:?}");
+        assert!(
+            run.stderr.starts_with(&format!("line {bad_line}: ")),
+            "input {input:?} stderr {:?}",
+            run.stderr
+        );
+    }
+}
+
+#[test]
+fn other_input_errors_still_exit_1() {
+    let bad_date = run_ledger("March 1\tgroceries\t1\n");
+    assert_eq!(bad_date.code, Some(1));
+    assert!(bad_date.stderr.starts_with("line 1: "));
+
+    let bad_amount = run_ledger("2026-03-01\tgroceries\t1.234\n");
+    assert_eq!(bad_amount.code, Some(1));
+
+    let short = run_ledger("2026-03-01\tgroceries\n");
+    assert_eq!(short.code, Some(1));
+    assert!(short.stderr.starts_with("line 1: "));
+}
