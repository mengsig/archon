--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,45 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_rows_keep_input_order_and_crlf_endings(self):
+        tasks = [
+            Task(2, "second", ["a", "b"], "done", date(2026, 4, 1)),
+            Task(1, "first"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + "2,second,a;b,done,2026-04-01\r\n" + "1,first,,open,\r\n",
+        )
+
+    def test_title_with_comma_is_quoted(self):
+        tasks = [Task(1, "milk, eggs")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"milk, eggs",,open,\r\n')
+
+    def test_embedded_quotes_are_doubled_and_quoted(self):
+        tasks = [Task(1, 'say "hi"')]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_newlines_and_carriage_returns_are_quoted(self):
+        tasks = [Task(1, "line one\nline two"), Task(2, "cr\rhere")]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + '1,"line one\nline two",,open,\r\n' + '2,"cr\rhere",,open,\r\n',
+        )
+
+    def test_plain_fields_are_not_quoted(self):
+        tasks = [Task(1, "plain", ["x;y"], "open", date(2026, 1, 2))]
+        self.assertEqual(to_csv(tasks), HEADER + "1,plain,x;y,open,2026-01-02\r\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_search.py b/tests/test_search.py
