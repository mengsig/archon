new file mode 100644
index 0000000..bb5f708
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,42 @@
+import unittest
+
+from tasktracker.models import DONE, Task
+from tasktracker.search import QueryError, search
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login flow", ["Auth", "urgent"]),
+            Task(2, "Review login copy", ["writing"], DONE),
+            Task(3, "Fix logout flow", ["auth"]),
+        ]
+
+    def test_terms_and_quoted_phrase(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, '"login flow" fix')], [1]
+        )
+        self.assertEqual([task.id for task in search(self.tasks, '"login copy"')], [2])
+
+    def test_case_insensitive_title_tag_and_status(self):
+        self.assertEqual([task.id for task in search(self.tasks, "FIX")], [1, 3])
+        self.assertEqual([task.id for task in search(self.tasks, "tag:AUTH")], [1, 3])
+        self.assertEqual([task.id for task in search(self.tasks, "status:DONE")], [2])
+        self.assertEqual([task.id for task in search(self.tasks, "status:open tag:urgent")], [1])
+
+    def test_blank_query_matches_every_task_in_order(self):
+        self.assertEqual(search(self.tasks, " \t\n"), self.tasks)
+        self.assertEqual(search(iter(self.tasks), ""), self.tasks)
+
+    def test_invalid_terms_raise_query_error(self):
+        for query in ('title:login', "status:blocked", '"unfinished phrase', "tag:"):
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+    def test_nonmatching_query_preserves_order_of_matches(self):
+        self.assertEqual([task.id for task in search(self.tasks, "flow")], [1, 3])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_store_undo.py b/tests/test_store_undo.py
new file mode 100644
index 0000000..da5e341
--- /dev/null
+++ b/tests/test_store_undo.py
@@ -0,0 +1,78 @@
+import unittest
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class StoreUndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work"])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_exact_task(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work"])
+        store.complete(task.id)
+        original_values = (task.id, task.title, task.tags[:], task.status, task.due)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertIs(restored, task)
+        self.assertEqual(
+            (restored.id, restored.title, restored.tags, restored.status, restored.due),
+            original_values,
+        )
+
+    def test_undo_traverses_mixed_history_lifo(self):
+        store = TaskStore()
+        first = store.add("first")
+        second = store.add("second")
+        store.complete(first.id)
+        store.delete(second.id)
+
+        store.undo()  # delete
+        self.assertEqual([task.id for task in store.all()], [first.id, second.id])
+        store.undo()  # complete
+        self.assertEqual(store.get(first.id).status, "open")
+        store.undo()  # add second
+        with self.assertRaises(UnknownTask):
+            store.get(second.id)
+        store.undo()  # add first
+        self.assertEqual(store.all(), [])
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_failed_operations_and_empty_history_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        with self.assertRaises(ValueError):
+            store.add("  ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+        store.add("valid")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
