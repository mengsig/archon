+++ b/tests/test_search.py
@@ -0,0 +1,78 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def make_store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("write report", tags=["work", "urgent"])
+    store.add("buy milk", tags=["home"])
+    store.add("Fix the fridge")
+    store.complete(2)
+    return store
+
+
+def titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = make_store().all()
+
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(titles(search(self.tasks, "")), titles(self.tasks))
+        self.assertEqual(titles(search(self.tasks, "   ")), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(titles(search(self.tasks, "FIX")), ["Fix login bug", "Fix the fridge"])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(titles(search(self.tasks, "fix login")), ["Fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix login bug"])
+        self.assertEqual(titles(search(self.tasks, '"login fix"')), [])
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Fix login bug", "write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_tag_value_may_be_quoted(self):
+        self.assertEqual(titles(search(self.tasks, 'tag:"urgent"')), ["write report"])
+
+    def test_tag_with_empty_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, "STATUS:open fix")), ["Fix login bug", "Fix the fridge"])
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:archived")
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_colon_inside_quotes_is_plain_text(self):
+        store = TaskStore()
+        store.add("meet at 12:30")
+        self.assertEqual(titles(search(store.all(), '"12:30"')), ["meet at 12:30"])
+        with self.assertRaises(QueryError):
+            search(store.all(), "12:30")
+
+    def test_no_match_returns_empty_list(self):
+        self.assertEqual(search(self.tasks, "nonexistent"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_undo.py b/tests/test_undo.py
