+function paged(pages) {
+  const requests = [];
+  const transport = async (request) => {
+    requests.push(request);
+    const key = request.query.cursor ?? 'first';
+    return pages[key] ?? { status: 500, body: { error: 'bad cursor' } };
+  };
+  return { transport, requests };
+}
+
+const PAGES = {
+  first: { status: 200, body: { items: [ITEMS[0]], next_cursor: 'c1' } },
+  c1: { status: 200, body: { items: [ITEMS[1]], next_cursor: 'c2' } },
+  c2: { status: 200, body: { items: [], next_cursor: null } },
+};
+
+test('follows next_cursor across pages until it is null', async () => {
+  const { transport, requests } = paged(PAGES);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(
+    requests.map((request) => request.query),
+    [{}, { cursor: 'c1' }, { cursor: 'c2' }],
+  );
+});
+
+test('treats a missing next_cursor as the last page', async () => {
+  const { transport, requests } = paged({
+    first: { status: 200, body: { items: ITEMS } },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(requests.length, 1);
+});
+
+test('rejects when the server repeats a cursor', async () => {
+  const { transport } = paged({
+    first: { status: 200, body: { items: [ITEMS[0]], next_cursor: 'c1' } },
+    c1: { status: 200, body: { items: [ITEMS[1]], next_cursor: 'c1' } },
+  });
+  await assert.rejects(listItems(transport), /same cursor twice/);
+});
+
+test('rejects when a later page fails', async () => {
+  const { transport } = paged({
+    first: { status: 200, body: { items: [ITEMS[0]], next_cursor: 'nope' } },
+  });
+  await assert.rejects(listItems(transport), /failed with 500/);
+});
+
 test('finds low stock', () => {
   assert.deepEqual(lowStock(ITEMS, 10), ['SKU-0001']);
 });
