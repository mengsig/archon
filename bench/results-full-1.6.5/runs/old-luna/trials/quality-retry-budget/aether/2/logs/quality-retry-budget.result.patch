diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..65026dc 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,37 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": (attempt, 1),
+        "elapsed_ms": (elapsed_ms, 0),
+        "max_attempts": (max_attempts, 1),
+        "budget_ms": (budget_ms, 0),
+        "base_ms": (base_ms, 0),
+        "cap_ms": (cap_ms, 0),
+    }
+    for name, (value, minimum) in values.items():
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        exponent = attempt - 1
+        # If exponent reaches cap_ms.bit_length(), the shifted positive base
+        # is certainly at least cap_ms. This avoids constructing 2**exponent
+        # for arbitrarily large attempt values.
+        if exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+
+    delay = max(backoff, retry_after_ms) if retry_after_ms is not None else backoff
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..9891ad2 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,52 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_even_when_attempts_are_exhausted(self):
+        invalid = [
+            ((0, 0), {}),
+            ((1, -1), {}),
+            ((1, 0), {"max_attempts": 0}),
+            ((1, 0), {"budget_ms": -1}),
+            ((1, 0), {"base_ms": -1}),
+            ((1, 0), {"cap_ms": -1}),
+            ((1, 0), {"retry_after_ms": -1}),
+            ((4, 0), {"base_ms": True}),
+            ((4, 0), {"retry_after_ms": 1.0}),
+        ]
+        for args, kwargs in invalid:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_only_builtin_integers_are_accepted(self):
+        for value in (True, False, 1.0, "1"):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(value, 0)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, value)
+
+    def test_attempts_greater_than_limit_are_exhausted(self):
+        self.assertIsNone(retry_delay(8, 0, max_attempts=4))
+
+    def test_zero_values_and_base_above_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, cap_ms=400), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=100, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=10), 10)
+
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=900,
+                                     cap_ms=10, budget_ms=1000), 900)
+
+    def test_budget_requires_strictly_earlier_start(self):
+        self.assertIsNone(retry_delay(1, 900, base_ms=100, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, base_ms=100, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_huge_attempt_saturates_without_growing_power_of_two(self):
+        attempt = 10 ** 100
+        self.assertEqual(retry_delay(attempt, 0, max_attempts=attempt + 1,
+                                     base_ms=1, cap_ms=400), 400)
