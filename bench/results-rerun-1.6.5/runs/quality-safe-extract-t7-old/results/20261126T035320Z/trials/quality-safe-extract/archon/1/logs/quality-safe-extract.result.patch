 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+RESERVED_COMPONENTS = ("", ".", "..")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _checked_root(root)
+    checked = _validate_batch(entries, root_path)
+    for name, parts, data in checked:
+        _write_new_file(root_path.joinpath(*parts), data)
+    return [name for name, _, _ in checked]
+
+
+def _checked_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, not {type(root).__name__}")
+    if str(root) == "":
+        raise ValueError("root must not be an empty string")
+    root_path = Path(root)
+    if root_path.is_symlink():
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not root_path.is_dir():
+        raise ValueError(f"root must be an existing directory: {root_path}")
+    return root_path
+
+
+def _validate_batch(entries, root_path):
+    """Check all entries before creating anything; return (name, parts, data)."""
+    seen_files = set()
+    seen_dirs = set()
+    checked = []
+    for entry in entries:
+        name, data = _split_entry(entry)
+        parts = _name_parts(name)
+        _check_batch_conflicts(name, parts, seen_files, seen_dirs)
+        _check_disk_target(root_path, name, parts)
+        seen_files.add(parts)
+        seen_dirs.update(parts[:i] for i in range(1, len(parts)))
+        checked.append((name, parts, data))
+    return checked
+
+
+def _split_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be a str, not {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes, not {type(data).__name__}")
+    return name, data
+
+
+def _name_parts(name):
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative: {name!r}")
+    for char in FORBIDDEN_NAME_CHARS:
+        if char in name:
+            raise ValueError(
+                f"entry name contains forbidden character {char!r}: {name!r}"
+            )
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"entry name is not valid Unicode text: {name!r}") from error
+    parts = tuple(name.split("/"))
+    for part in parts:
+        if part in RESERVED_COMPONENTS:
+            raise ValueError(
+                f"entry name has an empty, '.' or '..' component: {name!r}"
+            )
+    return parts
+
+
+def _check_batch_conflicts(name, parts, seen_files, seen_dirs):
+    if parts in seen_files:
+        raise ValueError(f"duplicate entry name: {name!r}")
+    if parts in seen_dirs:
+        raise ValueError(f"entry name collides with a directory in the batch: {name!r}")
+    if any(parts[:i] in seen_files for i in range(1, len(parts))):
+        raise ValueError(f"entry name lies below a file in the batch: {name!r}")
+
+
+def _check_disk_target(root_path, name, parts):
+    for i in range(1, len(parts)):
+        ancestor = root_path.joinpath(*parts[:i])
+        if not _exists_no_follow(ancestor):
+            break
+        if ancestor.is_symlink() or not ancestor.is_dir():
+            raise ValueError(f"existing ancestor is not a real directory: {ancestor}")
+    target = root_path.joinpath(*parts)
+    if _exists_no_follow(target):
+        raise ValueError(f"target already exists: {name!r}")
+
+
+def _exists_no_follow(path):
+    """Return whether path exists as a link or file; OS errors propagate."""
+    try:
+        os.lstat(path)
+    except FileNotFoundError:
+        return False
+    return True
+
+
+def _write_new_file(path, data):
+    assert isinstance(data, bytes), "data must be bytes"
+    assert not os.path.lexists(path), "target must be absent before writing"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "xb") as handle:
+        handle.write(data)
