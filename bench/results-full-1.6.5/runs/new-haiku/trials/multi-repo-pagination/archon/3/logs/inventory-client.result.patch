+// Follows next_cursor until it is null or absent, so every page is returned in order.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor = null;
+  do {
+    const query = cursor === null ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error(`GET /items returned a body without an items array: ${JSON.stringify(body)}`);
+    }
+    const next = body.next_cursor ?? null;
+    if (next !== null && seenCursors.has(next)) {
+      throw new Error(`GET /items returned a next_cursor it already returned: ${JSON.stringify(next)}`);
+    }
+    if (next !== null) seenCursors.add(next);
+    items.push(...body.items);
+    cursor = next;
+  } while (cursor !== null);
+  return items;
 }
 
