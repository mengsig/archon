+class ValidationTest(unittest.TestCase):
+    def test_invalid_bucket_params_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_amount_raises_and_consumes_nothing(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_keyed_rejects_bad_max_keys(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+
+    def test_keyed_invalid_amount_does_not_create_or_evict_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
+class RefillTest(unittest.TestCase):
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        self.assertAlmostEqual(bucket.wait_time(), 0.25)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(3)
+        clock.now = 2.0
+        self.assertAlmostEqual(bucket.available(), 2.0)
+        clock.now = 1.0
+        self.assertAlmostEqual(bucket.available(), 2.0)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 2.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+
+class WaitTimeTest(unittest.TestCase):
+    def test_wait_time_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 4.0, clock=clock)
+        bucket.try_acquire()
+        self.assertAlmostEqual(bucket.wait_time(), 0.25)
+        self.assertAlmostEqual(bucket.wait_time(), 0.25)
+        self.assertAlmostEqual(bucket.available(), 0.0)
+
+    def test_acquire_succeeds_exactly_after_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 0.3, clock=clock)
+        bucket.try_acquire(3)
+        wait = bucket.wait_time(2)
+        clock.now += wait
+        self.assertTrue(bucket.try_acquire(2))
+
+
+class KeyedEvictionTest(unittest.TestCase):
+    def test_evicts_least_recently_used_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("c"))
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=10, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
