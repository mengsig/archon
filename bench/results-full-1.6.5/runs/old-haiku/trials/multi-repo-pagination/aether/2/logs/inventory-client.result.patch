diff --git a/test/client.test.js b/test/client.test.js
index db0605e..3173380 100644
--- a/test/client.test.js
+++ b/test/client.test.js
@@ -28,3 +28,54 @@ test('gets one item and reports failures', async () => {
 test('finds low stock', () => {
   assert.deepEqual(lowStock(ITEMS, 10), ['SKU-0001']);
 });
+
+// Serves ALL_ITEMS two at a time, with cursors of the form `cursor-<offset>`.
+const ALL_ITEMS = [1, 2, 3, 4, 5].map((id) => ({ id, sku: `SKU-${id}`, qty: id }));
+
+function paged() {
+  const sent = [];
+  const transport = async (request) => {
+    sent.push(request.query);
+    const start = request.query.cursor === undefined ? 0 : Number(request.query.cursor.slice(7));
+    const items = ALL_ITEMS.slice(start, start + 2);
+    const next = start + 2 < ALL_ITEMS.length ? `cursor-${start + 2}` : null;
+    return { status: 200, body: { items, next_cursor: next } };
+  };
+  return { transport, sent };
+}
+
+test('follows next_cursor across pages, passing each cursor back unchanged', async () => {
+  const { transport, sent } = paged();
+  assert.deepEqual(await listItems(transport), ALL_ITEMS);
+  assert.deepEqual(sent, [{}, { cursor: 'cursor-2' }, { cursor: 'cursor-4' }]);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const transport = async () => ({ status: 200, body: { items: ALL_ITEMS } });
+  assert.deepEqual(await listItems(transport), ALL_ITEMS);
+});
+
+test('returns an empty list when the first page is empty', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: null } });
+  assert.deepEqual(await listItems(transport), []);
+});
+
+test('rejects a repeated cursor instead of looping forever', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /repeated cursor/);
+});
+
+test('rejects a non-string next_cursor', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 7 } });
+  await assert.rejects(listItems(transport), /non-string next_cursor/);
+});
+
+test('rejects a page without an items array', async () => {
+  const transport = async () => ({ status: 200, body: { next_cursor: null } });
+  await assert.rejects(listItems(transport), /items array/);
+});
+
+test('propagates a failed page request', async () => {
+  const transport = async () => ({ status: 400, body: { error: 'cursor is invalid' } });
+  await assert.rejects(listItems(transport), /400/);
+});
