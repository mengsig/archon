     def complete(self, task_id):
         task = self.get(task_id)
+        previous_status = task.status
         task.status = DONE
+        self._history.append(("complete", task_id, previous_status))
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        snapshot = Task(task.id, task.title, list(task.tags), task.status, task.due)
         del self._tasks[task_id]
+        self._history.append(("delete", snapshot))
         return task
 
+    def undo(self):
+        if not self._history:
+            raise NothingToUndo()
+
+        entry = self._history.pop()
+        operation, value = entry[:2]
+        if operation == "add":
+            del self._tasks[value]
+        elif operation == "complete":
+            self._tasks[value].status = entry[2]
+        else:
+            self._tasks[value.id] = value
+        return None
