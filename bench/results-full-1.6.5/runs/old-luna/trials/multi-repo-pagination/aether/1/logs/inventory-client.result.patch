+  const items = [];
+  let cursor;
+  do {
+    const query = { limit: 20 };
+    if (cursor !== undefined) query.cursor = cursor;
+    const body = await request(transport, '/items', query);
+    items.push(...body.items);
+    cursor = body.next_cursor;
+  } while (cursor !== null && cursor !== undefined);
+  return items;
 }
 
