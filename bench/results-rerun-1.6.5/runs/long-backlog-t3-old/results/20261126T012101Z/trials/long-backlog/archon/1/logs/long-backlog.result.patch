--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,75 @@
+import re
+
+from .models import DONE, OPEN
+
+FIELD = re.compile(r'([^\s":]+):(.*)', re.DOTALL)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`; an empty query matches all."""
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_term_predicate(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes, keeping the quote characters."""
+    terms, current, in_quote = [], [], False
+    for char in query:
+        if char == '"':
+            in_quote = not in_quote
+        if char.isspace() and not in_quote:
+            if current:
+                terms.append("".join(current))
+            current = []
+        else:
+            current.append(char)
+    if in_quote:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
+def _term_predicate(raw):
+    field = FIELD.fullmatch(raw)
+    if field:
+        return _field_predicate(field.group(1).lower(), _unquote(field.group(2)))
+    return _phrase_predicate(_unquote(raw))
+
+
+def _unquote(text):
+    return text.replace('"', "")
+
+
+def _field_predicate(field, value):
+    if field == "tag":
+        return _tag_predicate(value)
+    if field == "status":
+        return _status_predicate(value)
+    raise QueryError(f"unknown field: {field}")
+
+
+def _tag_predicate(tag):
+    if not tag:
+        raise QueryError("tag: needs a tag name")
+    wanted = tag.casefold()
+    return lambda task: any(own.casefold() == wanted for own in task.tags)
+
+
+def _status_predicate(status):
+    wanted = status.casefold()
+    if wanted not in (OPEN, DONE):
+        raise QueryError(f"unknown status: {status}")
+    return lambda task: task.status == wanted
+
+
+def _phrase_predicate(phrase):
+    if not phrase.strip():
+        raise QueryError("empty search term")
+    needle = phrase.casefold()
+    return lambda task: needle in task.title.casefold()
