 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path, PosixPath, WindowsPath
+
+# Exact types only: subclasses may override split/__eq__/__iter__ and bypass checks.
+_ROOT_TYPES = (str, PosixPath, WindowsPath)
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _require_list(entries)
+    root_path = _validated_root(root)
+    plans = _validate_batch(entries)
+    for _, _, parts in plans:
+        _check_target_free(root_path, parts)
+    for _, data, parts in plans:
+        _write_entry(root_path, parts, data)
+    return [name for name, _, _ in plans]
+
+
+def _require_list(entries):
+    if type(entries) is not list:
+        raise ValueError("entries must be a list of (name, data) tuples")
+
+
+def _validated_root(root):
+    if type(root) not in _ROOT_TYPES or str(root) == "":
+        raise ValueError("root must be a non-empty str or pathlib.Path")
+    root_path = Path(root)
+    info = _lstat_or_none(root_path)
+    if info is None or not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root is not an existing real directory: {root_path}")
+    return root_path
+
+
+def _validate_batch(entries):
+    """Return (name, data, parts) for every entry; raise ValueError on any defect."""
+    plans = [_plan_entry(index, entry) for index, entry in enumerate(entries)]
+    names = [name for name, _, _ in plans]
+    if len(set(names)) != len(names):
+        raise ValueError("batch contains duplicate entry names")
+    _check_no_file_directory_collisions(set(names))
+    return plans
+
+
+def _plan_entry(index, entry):
+    if type(entry) is not tuple or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if type(data) is not bytes:
+        raise ValueError(f"entry {index} data must be bytes")
+    return name, data, _split_name(name, index)
+
+
+def _split_name(name, index):
+    if type(name) is not str:
+        raise ValueError(f"entry {index} name must be a str")
+    if name == "" or name.startswith("/"):
+        raise ValueError(f"entry {index} name must be a nonempty relative path")
+    if any(char in name for char in "\\:\x00"):
+        raise ValueError(f"entry {index} name contains a forbidden character")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"entry {index} name has an empty, '.' or '..' component")
+    _require_utf8(name, index)
+    return parts
+
+
+def _require_utf8(name, index):
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"entry {index} name is not valid UTF-8 text") from error
+
+
+def _check_no_file_directory_collisions(names):
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in names:
+                raise ValueError(f"'{ancestor}' is both a file and a directory")
+
+
+def _check_target_free(root_path, parts):
+    assert parts and all(parts), "validated names have nonempty components"
+    current = root_path
+    for part in parts[:-1]:
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor is not a real directory: {current}")
+    target = root_path.joinpath(*parts)
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"target already exists: {target}")
+
+
+def _write_entry(root_path, parts, data):
+    assert isinstance(data, bytes), "data is validated before writing"
+    target = root_path.joinpath(*parts)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with open(target, "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return path.lstat()
+    except (FileNotFoundError, NotADirectoryError):
+        return None
