+// `pages` maps the cursor a request carries (undefined on the first request)
+// to the response body for that page.
+function pagedTransport(pages, seen = []) {
+  return async (request) => {
+    seen.push(request.query);
+    const page = pages.get(request.query.cursor);
+    if (!page) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages, passing it back unchanged', async () => {
+  const seen = [];
+  const transport = pagedTransport(
+    new Map([
+      [undefined, { items: ITEMS.slice(0, 1), next_cursor: 'opaque/1==' }],
+      ['opaque/1==', { items: ITEMS.slice(1), next_cursor: null }],
+    ]),
+    seen,
+  );
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}, { cursor: 'opaque/1==' }]);
+});
+
+test('fails when a later page is rejected', async () => {
+  const transport = pagedTransport(
+    new Map([[undefined, { items: ITEMS.slice(0, 1), next_cursor: 'stale' }]]),
+  );
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('fails when the cursor does not advance', async () => {
+  const transport = pagedTransport(
+    new Map([
+      [undefined, { items: ITEMS.slice(0, 1), next_cursor: 'same' }],
+      ['same', { items: ITEMS.slice(1), next_cursor: 'same' }],
+    ]),
+  );
+  await assert.rejects(listItems(transport), /not advancing/);
+});
+
+test('fails when a response has no items array', async () => {
+  const transport = pagedTransport(new Map([[undefined, { next_cursor: null }]]));
+  await assert.rejects(listItems(transport), /items array/);
+});
+
