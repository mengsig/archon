diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..901947f 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,44 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    assert attempt >= 1 and base_ms >= 0 and cap_ms >= 0
+    if base_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms * 2**shift >= 2**shift > cap_ms once shift >= cap_ms.bit_length(),
+    # so the cap is reached without building the huge power of two.
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    assert delay >= 0
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..d7279b1 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,113 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def assertRejects(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_and_float_and_non_numbers(self):
+        self.assertRejects(True, 0)
+        self.assertRejects(1, False)
+        self.assertRejects(1.0, 0)
+        self.assertRejects(1, 0, max_attempts=4.0)
+        self.assertRejects(1, 0, budget_ms=True)
+        self.assertRejects(1, 0, base_ms=1.5)
+        self.assertRejects(1, 0, cap_ms="400")
+        self.assertRejects(1, 0, retry_after_ms=10.0)
+        self.assertRejects(1, None)
+
+    def test_rejects_below_minimum(self):
+        self.assertRejects(0, 0)
+        self.assertRejects(1, -1)
+        self.assertRejects(1, 0, max_attempts=0)
+        self.assertRejects(1, 0, budget_ms=-1)
+        self.assertRejects(1, 0, base_ms=-1)
+        self.assertRejects(1, 0, cap_ms=-1)
+        self.assertRejects(1, 0, retry_after_ms=-1)
+
+    def test_validation_happens_before_exhausted_returns(self):
+        self.assertRejects(10, 0, max_attempts=1, base_ms=-5)
+        self.assertRejects(1, -1, budget_ms=0)
+        self.assertRejects(1, 0, retry_after_ms=True, max_attempts=1)
+
+    def test_valid_extremes_are_accepted(self):
+        self.assertIsNone(retry_delay(1, 0, max_attempts=1))
+        self.assertEqual(retry_delay(1, 0, base_ms=0, cap_ms=0, budget_ms=1), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0, base_ms=0), 0)
+
+
+class RetryAttemptLimit(unittest.TestCase):
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_above_max_is_legal_and_exhausted(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+
+
+class RetryBackoffShape(unittest.TestCase):
+    def test_doubling_then_cap(self):
+        delays = [retry_delay(a, 0, max_attempts=10**6, budget_ms=10**9)
+                  for a in range(1, 7)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400, 400])
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(10**100, 0, base_ms=0,
+                                     max_attempts=10**101), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_power_of_two_cap_boundaries(self):
+        delays = [retry_delay(a, 0, base_ms=1, cap_ms=8, max_attempts=100,
+                              budget_ms=10**9) for a in range(1, 7)]
+        self.assertEqual(delays, [1, 2, 4, 8, 8, 8])
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(retry_delay(10**30, 0, max_attempts=10**31,
+                                     budget_ms=10**9), 400)
+
+    def test_huge_base_does_not_overflow(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=10**1000), 400)
+
+
+class RetryRetryAfter(unittest.TestCase):
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=5000,
+                                     budget_ms=10**9), 5000)
+
+    def test_retry_after_applies_with_zero_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0, retry_after_ms=30), 30)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class RetryBudget(unittest.TestCase):
+    def test_next_attempt_must_start_strictly_before_budget(self):
+        self.assertEqual(retry_delay(1, 899), 100)
+        self.assertIsNone(retry_delay(1, 900))
+
+    def test_elapsed_already_at_budget_is_exhausted(self):
+        self.assertIsNone(retry_delay(1, 1000))
+        self.assertIsNone(retry_delay(1, 1500))
+
+    def test_zero_delay_exhausted_when_elapsed_reaches_budget(self):
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_wait_is_never_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(1, 800, retry_after_ms=300))
+        self.assertEqual(retry_delay(1, 600, retry_after_ms=300), 300)
+
+
+if __name__ == "__main__":
+    unittest.main()
