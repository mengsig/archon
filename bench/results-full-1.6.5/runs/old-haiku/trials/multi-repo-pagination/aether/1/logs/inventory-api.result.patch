@@ -21,8 +26,43 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after_id = _parse_cursor(query.get("cursor"))
+    except ValueError as exc:
+        return _error(400, str(exc))
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    remaining = [item for item in ordered if item["id"] > after_id]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:]))
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not (raw.isascii() and raw.isdigit()) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise ValueError(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    """Return the id after which the page starts; 0 means the first page."""
+    if raw is None:
+        return 0
+    try:
+        decoded = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except ValueError as exc:
+        raise ValueError("cursor is invalid") from exc
+    if not (decoded.isascii() and decoded.isdigit()):
+        raise ValueError("cursor is invalid")
+    return int(decoded)
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
 
 
