+import os
 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
 
+def snapshot(base):
+    found = []
+    for dirpath, dirnames, filenames in os.walk(base):
+        for name in dirnames + filenames:
+            found.append(os.path.relpath(os.path.join(dirpath, name), base))
+    return sorted(found)
+
+
+class ExtractCase(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def assertRejectedWithoutChange(self, entries, root=None):
+        before = snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(snapshot(self.base), before)
+
+
