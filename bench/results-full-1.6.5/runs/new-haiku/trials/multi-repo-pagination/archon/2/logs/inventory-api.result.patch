diff --git a/test_api.py b/test_api.py
index 55cd1fd..cdd1227 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,66 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def walk(self, **query):
+        """Follow next_cursor from the first page; return the pages in order."""
+        pages = []
+        while True:
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            pages.append(res["body"])
+            query["cursor"] = res["body"]["next_cursor"]
+            if query["cursor"] is None:
+                return pages
+
+    def test_default_page_is_twenty_items(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_following_cursors_returns_every_item_once_in_order(self):
+        pages = self.walk(limit="5")
+        ids = [item["id"] for page in pages for item in page["items"]]
+        self.assertEqual(ids, list(range(1, 58)))
+        self.assertEqual(len(pages), 12)
+        self.assertIsNone(pages[-1]["next_cursor"])
+        self.assertEqual(len(pages[-1]["items"]), 2)
+
+    def test_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="20", cursor="40")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_that_exactly_fills_limit_on_last_page_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_limit_boundaries(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(get("/items", limit="1")["body"]["next_cursor"], "1")
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        self.assertIsNone(get("/items", limit="100")["body"]["next_cursor"])
+
+    def test_cursor_past_the_end_is_an_empty_last_page(self):
+        body = get("/items", cursor="999")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_invalid_limit_is_400(self):
+        for raw in ["0", "101", "-1", "abc", "", "1.5", " 5", "+5", "٥"]:
+            res = get("/items", limit=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("limit", res["body"]["error"])
+
+    def test_overlong_numeric_strings_are_400_not_crashes(self):
+        self.assertEqual(get("/items", limit="1" * 5000)["status"], 400)
+        self.assertEqual(get("/items", cursor="9" * 5000)["status"], 400)
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["", "-1", "abc", "1.5", "12x"]:
+            res = get("/items", cursor=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("cursor", res["body"]["error"])
+
 
 if __name__ == "__main__":
     unittest.main()
