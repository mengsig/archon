@@ -0,0 +1,48 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class TaskStoreUndoTest(unittest.TestCase):
+    def test_undoes_delete_complete_and_add_in_lifo_order(self):
+        store = TaskStore()
+        task = store.add("prepare launch", tags=["work"], due=date(2026, 5, 1))
+        store.complete(task.id)
+        deleted = store.delete(task.id)
+
+        deleted.title = "mutated after deletion"
+        deleted.tags.append("extra")
+        deleted.status = "open"
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.title, "prepare launch")
+        self.assertEqual(restored.tags, ["work"])
+        self.assertEqual(restored.status, "done")
+        self.assertEqual(restored.due, date(2026, 5, 1))
+
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+        replacement = store.add("new task")
+        self.assertEqual(replacement.id, task.id + 1)
+
+    def test_failed_operations_do_not_create_undo_entries(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_empty_history_raises(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
