 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+# Common filesystem NAME_MAX; rejecting longer components up front keeps
+# ENAMETOOLONG from surfacing mid-batch after earlier files were created.
+_MAX_COMPONENT_BYTES = 255
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, got {type(entries).__name__}")
+    root_path = _validate_root(root)
+    if not entries:
+        return []
+    batch = _validate_batch(entries)
+    names = [name for name, _ in batch]
+    for name in names:
+        _check_target(root_path, name)
+    for name, data in batch:
+        _write_file(root_path / name, data)
+    return names
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty str or Path, got {root!r}")
+    root_path = Path(root)
+    info = _lstat_or_none(root_path)
+    if info is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root must not be a symbolic link: {root_path}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _validate_batch(entries):
+    batch = [_validate_entry(entry) for entry in entries]
+    _check_name_conflicts([name for name, _ in batch])
+    return batch
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    _validate_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, got {type(data).__name__}")
+    return name, data
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, got {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    if any(part in ("", ".", "..") for part in name.split("/")):
+        raise ValueError(f"entry name has an empty, '.' or '..' component: {name!r}")
+    try:
+        encoded_parts = [part.encode("utf-8") for part in name.split("/")]
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not valid Unicode: {name!r}") from exc
+    if any(len(part) > _MAX_COMPONENT_BYTES for part in encoded_parts):
+        raise ValueError(f"entry name has a component over {_MAX_COMPONENT_BYTES} bytes: {name!r}")
+
+
+def _check_name_conflicts(names):
+    name_set = set(names)
+    if len(name_set) != len(names):
+        raise ValueError("batch contains duplicate entry names")
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in name_set:
+                raise ValueError(f"entry {ancestor!r} collides with entry {name!r}")
+
+
+def _check_target(root, name):
+    parts = name.split("/")
+    assert all(parts), "names must be validated before target checks"
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"path component is a symbolic link: {current}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"path component is not a directory: {current}")
+    target = root / name
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"target already exists: {target}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
+
+
+def _write_file(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    assert path.parent.is_dir(), "parent directory must exist before writing"
+    with open(path, "xb") as handle:
+        handle.write(data)
diff --git a/test_safe_extract.py b/test_safe_extract.py
