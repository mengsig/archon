@@ -21,6 +21,42 @@ class ApiTest(unittest.TestCase):
         self.assertEqual(get("/items/999")["status"], 404)
         self.assertEqual(get("/items/x")["status"], 400)
 
+    def test_default_page_has_twenty_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_walking_cursors_returns_every_item_in_order(self):
+        seen, cursor = [], None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            seen.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        cursor = get("/items", limit="50")["body"]["next_cursor"]
+        body = get("/items", limit="50", cursor=cursor)["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(51, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        for bad in ["0", "101", "-1", "abc", "", "1.5", "²"]:
+            res = get("/items", limit=bad)
+            self.assertEqual(res["status"], 400, bad)
+            self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_rejected(self):
+        for bad in ["!!!", "", "bm90IGEgbnVtYmVy", "%%%"]:
+            res = get("/items", cursor=bad)
+            self.assertEqual(res["status"], 400, bad)
+            self.assertIn("cursor", res["body"]["error"])
