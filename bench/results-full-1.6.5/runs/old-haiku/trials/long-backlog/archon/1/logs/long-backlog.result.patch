index 0000000..5d14edf
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,41 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def test_impossible_calendar_dates_are_rejected(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                with self.assertRaisesRegex(InvalidDate, text):
+                    parse_due(text, TODAY)
+
+    def test_leap_day_is_accepted_in_leap_year(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+
+    def test_unsupported_forms_are_rejected(self):
+        for text in ["-3d", "3d", "bogus", "", "2026-3-1"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_offset_overflow_is_rejected(self):
+        with self.assertRaisesRegex(InvalidDate, r"\+99999999999d"):
+            parse_due("+99999999999d", TODAY)
+
+    def test_zero_offset_is_today(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+
+    def test_keywords_and_whitespace_still_work(self):
+        self.assertEqual(parse_due("  TODAY ", TODAY), TODAY)
+        self.assertEqual(parse_due("\tTomorrow\n", TODAY), date(2026, 3, 11))
+
+    def test_invalid_date_is_a_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+
+if __name__ == "__main__":
+    unittest.main()
