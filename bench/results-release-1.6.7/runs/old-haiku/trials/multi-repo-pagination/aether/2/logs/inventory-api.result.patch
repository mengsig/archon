diff --git a/test_api.py b/test_api.py
index 55cd1fd..2aa86b9 100644
--- a/test_api.py
+++ b/test_api.py
@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,55 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_uses_default_limit(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_pages_cover_every_item_once_in_order(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        cursor = get("/items", limit="50")["body"]["next_cursor"]
+        body = get("/items", limit="50", cursor=cursor)["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(51, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_multiple_ends_without_cursor(self):
+        cursor = get("/items", limit="57")["body"]["next_cursor"]
+        self.assertIsNone(cursor)
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for bad in ["0", "101", "-1", "", "abc", "1.5", " 5", "+5"]:
+            with self.subTest(limit=bad):
+                res = get("/items", limit=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for bad in ["", "not-a-cursor!", "MTA", "eA=="]:
+            with self.subTest(cursor=bad):
+                res = get("/items", cursor=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_cursor_past_the_end_is_empty(self):
+        cursor = base64.urlsafe_b64encode(b"999").decode("ascii")
+        res = get("/items", cursor=cursor)
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(res["body"], {"items": [], "next_cursor": None})
+
 
 if __name__ == "__main__":
     unittest.main()
