diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..ccdde10
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,51 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def assertInvalid(self, text):
+        with self.assertRaises(InvalidDate) as ctx:
+            parse_due(text, TODAY)
+        self.assertIn(text, str(ctx.exception))
+
+    def test_invalid_date_is_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+    def test_valid_iso_dates(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+        self.assertEqual(parse_due("2026-12-31", TODAY), date(2026, 12, 31))
+
+    def test_impossible_calendar_dates_are_rejected(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                self.assertInvalid(text)
+
+    def test_unsupported_forms_are_rejected(self):
+        for text in ["garbage", "", "2026-3-1", "10/03/2026", "next week", "3d", "-3d", "+3", "+3w"]:
+            with self.subTest(text=text):
+                self.assertInvalid(text)
+
+    def test_relative_offsets(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+5d", TODAY), date(2026, 3, 15))
+        self.assertEqual(parse_due("+365d", TODAY), date(2027, 3, 10))
+
+    def test_offset_out_of_range_is_rejected(self):
+        self.assertInvalid("+99999999999d")
+        self.assertInvalid("+999999999d")
+
+    def test_huge_offset_text_is_rejected_as_invalid_date(self):
+        self.assertInvalid("+" + "9" * 5000 + "d")
+
+    def test_keywords_are_case_and_space_insensitive(self):
+        self.assertEqual(parse_due("  TODAY ", TODAY), TODAY)
+        self.assertEqual(parse_due(" Tomorrow ", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("\t+1D\n", TODAY), date(2026, 3, 11))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..7834107
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,86 @@
+"""Search query syntax."""
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        store = TaskStore()
+        store.add("Fix Login bug", tags=["Work", "urgent"])
+        store.add("write report", tags=["work"])
+        store.add("fix login page", tags=["home"])
+        store.add("buy milk")
+        store.complete(2)
+        self.tasks = store.all()
+
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(titles(search(self.tasks, "")), titles(self.tasks))
+        self.assertEqual(titles(search(self.tasks, "   \t ")), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(titles(search(self.tasks, "LOGIN")),
+                         ["Fix Login bug", "fix login page"])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(titles(search(self.tasks, "fix login")),
+                         ["Fix Login bug", "fix login page"])
+        self.assertEqual(titles(search(self.tasks, "fix milk")), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"login bug"')), ["Fix Login bug"])
+        self.assertEqual(titles(search(self.tasks, '"bug login"')), [])
+
+    def test_tag_is_exact_and_case_insensitive(self):
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")),
+                         ["Fix Login bug", "write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_tag_value_can_be_quoted(self):
+        self.assertEqual(titles(search(self.tasks, 'tag:"urgent"')), ["Fix Login bug"])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, "status:open login")),
+                         ["Fix Login bug", "fix login page"])
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(self.tasks))
+        self.assertEqual(titles(search(reversed_tasks, "fix")),
+                         ["fix login page", "Fix Login bug"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+        with self.assertRaises(QueryError):
+            search(self.tasks, 'status:""')
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_malformed_query_raises_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "due:today")
+
+    def test_colon_inside_quotes_is_a_phrase(self):
+        store = TaskStore()
+        store.add("note: call Bob")
+        self.assertEqual(titles(search(store.all(), '"note: call"')), ["note: call Bob"])
+
+
+if __name__ == "__main__":
+    unittest.main()
