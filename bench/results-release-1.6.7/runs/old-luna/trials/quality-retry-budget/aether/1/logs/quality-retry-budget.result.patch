diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..4dc7151 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,42 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+        type(retry_after_ms) is not int or retry_after_ms < 0
+    ):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    elif base_ms >= cap_ms:
+        backoff = cap_ms
+    else:
+        exponent = attempt - 1
+        # Find the first exponent that reaches the cap, without constructing
+        # an unbounded power of two.
+        saturation = cap_ms.bit_length() - base_ms.bit_length()
+        if base_ms << saturation < cap_ms:
+            saturation += 1
+        backoff = cap_ms if exponent >= saturation else base_ms << exponent
+
+    delay = backoff
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..af38317 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,79 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_before_exhaustion(self):
+        bad_calls = (
+            lambda: retry_delay(4, 0, retry_after_ms=-1),
+            lambda: retry_delay(4, 0, cap_ms=True),
+            lambda: retry_delay(1, 0, max_attempts=0),
+            lambda: retry_delay(1, 0, budget_ms=1.0),
+        )
+        for call in bad_calls:
+            with self.subTest(call=call):
+                with self.assertRaises(ValueError):
+                    call()
+
+    def test_rejects_bool_and_non_builtin_integer_inputs(self):
+        for name in ("attempt", "elapsed_ms", "max_attempts", "budget_ms",
+                     "base_ms", "cap_ms", "retry_after_ms"):
+            kwargs = {name: True}
+            if name == "attempt":
+                args = (True, 0)
+                kwargs = {}
+            elif name == "elapsed_ms":
+                args = (1, True)
+                kwargs = {}
+            else:
+                args = (1, 0)
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                retry_delay(*args, **kwargs)
+
+        class IntSubclass(int):
+            pass
+
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=IntSubclass(100))
+
+    def test_rejects_negative_values(self):
+        for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms",
+                     "retry_after_ms"):
+            args = (1, -1) if name == "elapsed_ms" else (1, 0)
+            kwargs = {} if name == "elapsed_ms" else {name: -1}
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                retry_delay(*args, **kwargs)
+        for name in ("attempt", "max_attempts"):
+            kwargs = {name: 0}
+            args = (1, 0)
+            if name == "attempt":
+                args = (0, 0)
+                kwargs = {}
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                retry_delay(*args, **kwargs)
+
+    def test_strict_budget_boundary_and_zero_delay(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=0), None)
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_retry_after_is_uncapped_and_must_fit_whole(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=10, retry_after_ms=500), 500
+        )
+        self.assertIsNone(
+            retry_delay(1, 500, budget_ms=1000, retry_after_ms=500)
+        )
+
+    def test_zero_cap_and_base(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=100, cap_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, base_ms=0, cap_ms=100), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=100), 100)
+
+    def test_huge_attempt_saturates_without_huge_power(self):
+        attempt = 10 ** 100
+        self.assertEqual(
+            retry_delay(attempt, 0, max_attempts=attempt + 1), 400
+        )
