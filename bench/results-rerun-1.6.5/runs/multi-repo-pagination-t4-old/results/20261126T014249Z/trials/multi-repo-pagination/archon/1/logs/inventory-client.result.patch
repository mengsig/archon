+function paged(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    const page = pages[request.query.cursor ?? ''];
+    if (!page) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const { transport, seen } = paged({
+    '': { items: [ITEMS[0]], next_cursor: 'opaque/2==' },
+    'opaque/2==': { items: [ITEMS[1]], next_cursor: 'opaque/3==' },
+    'opaque/3==': { items: [{ id: 3, sku: 'SKU-0003', qty: 0 }], next_cursor: null },
+  });
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seen, [{}, { cursor: 'opaque/2==' }, { cursor: 'opaque/3==' }]);
+});
+
+test('returns a single page when next_cursor is null', async () => {
+  const { transport, seen } = paged({ '': { items: ITEMS, next_cursor: null } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('returns a single page when next_cursor is missing', async () => {
+  const { transport, seen } = paged({ '': { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('rejects a repeated cursor instead of looping forever', async () => {
+  const { transport } = paged({ '': { items: ITEMS, next_cursor: 'same' }, same: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /repeated cursor/);
+});
+
+test('rejects a cursor cycle across pages instead of looping forever', async () => {
+  const { transport, seen } = paged({
+    '': { items: [ITEMS[0]], next_cursor: 'a' },
+    a: { items: [ITEMS[1]], next_cursor: 'b' },
+    b: { items: [], next_cursor: 'a' },
+  });
+  await assert.rejects(listItems(transport), /repeated cursor "a"/);
+  assert.equal(seen.length, 3);
+});
