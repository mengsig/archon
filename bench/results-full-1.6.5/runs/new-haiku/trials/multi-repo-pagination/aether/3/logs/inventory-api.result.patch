@@ -5,8 +5,14 @@ response is `{"status": int, "body": object}`; the transport layer lives
 elsewhere.
 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,21 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after_id = _parse_cursor(query.get("cursor"))
+    if after_id is None:
+        return _error(400, "invalid cursor")
+
+    remaining = sorted(
+        (item for item in ITEMS if item["id"] > after_id),
+        key=lambda item: item["id"],
+    )
+    page = remaining[:limit]
+    has_more = len(remaining) > limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
 def get_item(raw_id):
@@ -36,3 +55,34 @@ def get_item(raw_id):
 
 def _error(status, message):
     return {"status": status, "body": {"error": message}}
+
+
+def _parse_limit(raw):
+    """Return the page size, or None when `raw` is not an integer in 1..MAX_LIMIT."""
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not re.fullmatch(r"[0-9]+", raw):
+        return None
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(last_id):
+    assert isinstance(last_id, int) and last_id >= 0, "cursor ids are non-negative ints"
+    return base64.urlsafe_b64encode(str(last_id).encode()).decode().rstrip("=")
+
+
+def _parse_cursor(raw):
+    """Return the id to page after, or None when `raw` was not issued by `_encode_cursor`."""
+    if raw is None:
+        return 0
+    padded = raw + "=" * (-len(raw) % 4)
+    try:
+        decoded = base64.urlsafe_b64decode(padded).decode()
+    except ValueError:
+        return None
+    if not re.fullmatch(r"[0-9]+", decoded):
+        return None
+    return int(decoded)
