 def list_items(query):
+    limit = _parse_limit(query.get("limit", 20))
+    if limit is None:
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    has_cursor = "cursor" in query
+    cursor = query.get("cursor")
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    after_id = None
+    if has_cursor:
+        after_id = _decode_cursor(cursor)
+        if after_id is None or after_id not in {item["id"] for item in items}:
+            return _error(400, "invalid cursor")
+
+    remaining = [item for item in items if after_id is None or item["id"] > after_id]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {
+        "status": 200,
+        "body": {"items": page, "next_cursor": next_cursor},
+    }
+
+
+def _parse_limit(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        limit = value
+    elif isinstance(value, str) and re.fullmatch(r"[0-9]+", value):
+        limit = int(value)
+    else:
+        return None
+    return limit if 1 <= limit <= 100 else None
+
+
+def _encode_cursor(item_id):
+    raw = f"item:{item_id}".encode("ascii")
+    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", cursor):
+        return None
+    try:
+        padded = cursor + "=" * (-len(cursor) % 4)
+        raw = base64.b64decode(padded, altchars=b"-_", validate=True).decode("ascii")
+    except (binascii.Error, UnicodeDecodeError):
+        return None
+    match = re.fullmatch(r"item:([1-9][0-9]*)", raw)
+    if not match or _encode_cursor(int(match.group(1))) != cursor:
+        return None
+    return int(match.group(1))
 
 
