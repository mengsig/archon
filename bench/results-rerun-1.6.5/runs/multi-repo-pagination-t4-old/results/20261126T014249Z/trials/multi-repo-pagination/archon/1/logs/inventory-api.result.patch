 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +24,40 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        start_id = _parse_cursor(query.get("cursor"))
+    except ValueError as exc:
+        return _error(400, str(exc))
+    remaining = sorted(
+        (item for item in ITEMS if item["id"] >= start_id),
+        key=lambda item: item["id"],
+    )
+    page = remaining[:limit]
+    assert len(page) <= limit, "page exceeds limit"
+    assert all(item["id"] >= start_id for item in page), "item before cursor"
+    next_cursor = str(remaining[limit]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_decimal(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise ValueError(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return 0
+    if not _is_decimal(raw):
+        raise ValueError("cursor is invalid")
+    return int(raw)
+
+
+def _is_decimal(raw):
+    return raw.isascii() and raw.isdigit()
 
 
