+class BucketConstructionTest(unittest.TestCase):
+    def test_non_positive_rates_raise(self):
+        for capacity, refill in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5)]:
+            with self.subTest(capacity=capacity, refill=refill):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, refill, clock=FakeClock())
+
+    def test_nan_rates_raise(self):
+        with self.assertRaises(ValueError):
+            TokenBucket(float("nan"), 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            TokenBucket(1, float("nan"), clock=FakeClock())
+
+    def test_fractional_capacity_is_allowed(self):
+        bucket = TokenBucket(0.5, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(0.5))
+        self.assertFalse(bucket.try_acquire(0.1))
+
+
+class RequestValidationTest(unittest.TestCase):
+    def test_try_acquire_rejects_non_positive_n(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        for n in [0, -1]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+
+    def test_try_acquire_rejects_n_above_capacity(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            bucket.try_acquire(4)
+
+    def test_wait_time_rejects_invalid_n(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            bucket.wait_time(0)
+        with self.assertRaises(ValueError):
+            bucket.wait_time(4)
+
+    def test_rejected_request_does_not_consume_tokens(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            bucket.try_acquire(4)
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_keyed_invalid_n_creates_no_key_and_evicts_nothing(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
+class BucketSemanticsTest(unittest.TestCase):
+    def test_bucket_starts_full(self):
+        bucket = TokenBucket(5, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.available(), 5.0)
+
+    def test_failed_acquire_removes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        bucket.try_acquire(2)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_available_does_not_consume(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.available(), 2.0)
+        self.assertEqual(bucket.available(), 2.0)
+        self.assertTrue(bucket.try_acquire(2))
+
+
+class WaitTimeTest(unittest.TestCase):
+    def test_zero_when_request_would_succeed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_matches_deficit_over_rate(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        clock.now = 1.5
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        bucket.wait_time()
+        bucket.wait_time()
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+
+class ClockTest(unittest.TestCase):
+    def test_backwards_clock_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 10.0
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_only_time_past_latest_seen_accrues(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 4.0
+        self.assertEqual(bucket.available(), 4.0)
+        clock.now = 2.0
+        bucket.try_acquire(4)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 1.0)
+
+
+class KeyedLimiterTest(unittest.TestCase):
+    def test_invalid_rates_raise_at_construction(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0, clock=FakeClock())
+
+    def test_max_keys_below_one_raises(self):
+        for max_keys in [0, -3]:
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_keyed_wait_time_is_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, clock=clock)
+        limiter.try_acquire("a", 2)
+        self.assertEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_lru_key_is_evicted_at_limit(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_try_acquire_refreshes_recency(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_wait_time_refreshes_recency(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_default_max_keys_is_1024(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        for i in range(1025):
+            limiter.try_acquire(i)
+        self.assertEqual(len(limiter), 1024)
+
+
