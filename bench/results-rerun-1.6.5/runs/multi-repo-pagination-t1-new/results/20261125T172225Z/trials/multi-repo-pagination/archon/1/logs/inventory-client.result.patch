+// Serves pages[0] for the cursor-less request and pages[i] for the cursor
+// that pages[i - 1] returned, so cursors are only valid when echoed back.
+function paged(pages) {
+  const byCursor = new Map();
+  for (let i = 1; i < pages.length; i += 1) {
+    byCursor.set(pages[i - 1].next_cursor, pages[i]);
+  }
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    if (request.path !== '/items') return { status: 404, body: { error: 'not found' } };
+    const page = 'cursor' in request.query ? byCursor.get(request.query.cursor) : pages[0];
+    return { status: 200, body: page };
+  };
+  return { transport, seen };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('walks every page in order following next_cursor', async () => {
+  const pages = [
+    { items: [{ id: 1 }], next_cursor: 'c1' },
+    { items: [{ id: 2 }], next_cursor: 'c2' },
+    { items: [{ id: 3 }], next_cursor: null },
+  ];
+  const { transport } = paged(pages);
+  assert.deepEqual(await listItems(transport), [{ id: 1 }, { id: 2 }, { id: 3 }]);
+});
+
+test('single page with null next_cursor makes one request', async () => {
+  const { transport, seen } = paged([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('absent next_cursor ends the walk', async () => {
+  const { transport, seen } = paged([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('first request sends no cursor and later ones echo it unchanged', async () => {
+  const opaque = 'a+/=_~ opaque';
+  const pages = [
+    { items: [{ id: 1 }], next_cursor: opaque },
+    { items: [{ id: 2 }], next_cursor: null },
+  ];
+  const { transport, seen } = paged(pages);
+  await listItems(transport);
+  assert.equal('cursor' in seen[0].query, false);
+  assert.equal(seen[1].query.cursor, opaque);
+});
+
+test('rejects a page without an items array', async () => {
+  const { transport } = paged([{ next_cursor: null }]);
+  await assert.rejects(listItems(transport), /without an items array/);
+});
+
+test('rejects a repeated cursor instead of looping forever', async () => {
