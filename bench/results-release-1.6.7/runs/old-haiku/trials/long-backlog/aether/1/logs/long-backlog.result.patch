@@ -0,0 +1,55 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only_with_crlf(self):
+        self.assertEqual(to_csv([]), "id,title,tags,status,due\r\n")
+
+    def test_rows_keep_given_order_and_crlf_endings(self):
+        tasks = [
+            Task(2, "second", ["b"], DONE, date(2026, 4, 1)),
+            Task(1, "first"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n"
+            "2,second,b,done,2026-04-01\r\n"
+            "1,first,,open,\r\n",
+        )
+
+    def test_plain_fields_are_not_quoted(self):
+        tasks = [Task(1, "a; b c", ["x;y"], "open", None)]
+        self.assertEqual(to_csv(tasks).splitlines()[1], "1,a; b c,x;y,open,")
+
+    def test_special_characters_are_quoted_and_escaped(self):
+        tasks = [
+            Task(1, 'say "hi", then\nleave'),
+            Task(2, "carriage\rreturn"),
+            Task(3, "tags", ["a,b", "c"]),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n"
+            '1,"say ""hi"", then\nleave",,open,\r\n'
+            '2,"carriage\rreturn",,open,\r\n'
+            '3,tags,"a,b;c",open,\r\n',
+        )
+
+    def test_output_round_trips_through_csv_reader(self):
+        title = 'tricky, "quoted"\nmultiline'
+        tasks = [Task(7, title, ["one, two", "three"], DONE, date(2026, 1, 2))]
+        rows = list(csv.reader(io.StringIO(to_csv(tasks), newline="")))
+        self.assertEqual(rows, [
+            ["id", "title", "tags", "status", "due"],
+            ["7", title, "one, two;three", "done", "2026-01-02"],
+        ])
+
+
+if __name__ == "__main__":
+    unittest.main()
