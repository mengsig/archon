+function pagedTransport(pages) {
+  const calls = [];
+  const transport = async (request) => {
+    calls.push(request);
+    const cursor = request.query.cursor ?? null;
+    const page = pages.get(cursor);
+    if (!page) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, calls };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const pages = new Map([
+    [null, { items: [ITEMS[0]], next_cursor: 'c1' }],
+    ['c1', { items: [ITEMS[1]], next_cursor: 'c2' }],
+    ['c2', { items: [{ id: 3, sku: 'SKU-0003', qty: 0 }], next_cursor: null }],
+  ]);
+  const { transport, calls } = pagedTransport(pages);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(calls.map((call) => call.query), [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('lists a single page when next_cursor is null', async () => {
+  const { transport, calls } = pagedTransport(new Map([[null, { items: ITEMS, next_cursor: null }]]));
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(calls.length, 1);
+});
+
+test('lists a single page when next_cursor is absent', async () => {
+  const { transport, calls } = pagedTransport(new Map([[null, { items: ITEMS }]]));
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(calls.length, 1);
+});
+
+test('first request sends no cursor', async () => {
+  const { transport, calls } = pagedTransport(new Map([[null, { items: ITEMS, next_cursor: null }]]));
+  await listItems(transport);
+  assert.equal(calls[0].path, '/items');
+  assert.equal('cursor' in calls[0].query, false);
+});
+
+test('rejects when a page fails', async () => {
+  const { transport } = pagedTransport(new Map([[null, { items: ITEMS, next_cursor: 'missing' }]]));
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('rejects a page without an items array', async () => {
+  const { transport } = pagedTransport(new Map([[null, { next_cursor: null }]]));
+  await assert.rejects(listItems(transport), /no items array/);
+});
+
+test('rejects a cursor that repeats instead of looping forever', async () => {
+  const pages = new Map([
+    [null, { items: [ITEMS[0]], next_cursor: 'loop' }],
+    ['loop', { items: [ITEMS[1]], next_cursor: 'loop' }],
+  ]);
+  const { transport } = pagedTransport(pages);
+  await assert.rejects(listItems(transport), /repeated cursor/);
+});
+
