+#[test]
+fn currency_column_is_optional_and_defaults_to_usd() {
+    let eur = parse_line("2026-03-01\tgroceries\t-45.10\tEUR").unwrap();
+    assert_eq!(eur.currency, "EUR");
+    assert_eq!(to_csv_row(&eur), "2026-03-01,groceries,-4510,EUR");
+
+    let legacy = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
+    assert_eq!(legacy.currency, "USD");
+    assert_eq!(to_csv_row(&legacy), "2026-03-01,groceries,-4510,USD");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    for code in ["eur", "EURO", "EU", "E1R", "US$", ""] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        assert!(
+            matches!(parse_line(&line), Err(ParseError::BadCurrency(_))),
+            "{code:?} should be rejected"
+        );
+    }
+}
+
+#[test]
+fn bad_field_count_is_a_malformed_error() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tEUR\textra").unwrap_err();
+    assert!(matches!(err, ParseError::Malformed(_)));
+    assert_eq!(err.exit_code(), 1);
+}
