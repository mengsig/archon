+class LedgerBoundaries(unittest.TestCase):
+    def test_destination_overflow_is_atomic(self):
+        ledger = Ledger({"source": 1, "full": MAX_BALANCE})
+        self.assertFalse(ledger.transfer("source", "full", 1))
+        self.assertEqual(ledger.snapshot(), {"source": 1, "full": MAX_BALANCE})
+
+    def test_same_account_checks_funds_without_mutation(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+
+        smaller = Ledger({"a": 5})
+        self.assertFalse(smaller.transfer("a", "a", 6))
+        self.assertEqual(smaller.snapshot(), {"a": 5})
+
+
+class LedgerConcurrency(unittest.TestCase):
+    def test_opposite_transfers_are_deadlock_free_and_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = Barrier(3)
+        outcomes = []
+
+        def move(source, destination):
+            start.wait()
+            outcomes.extend(ledger.transfer(source, destination, 1) for _ in range(100))
+
+        threads = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for thread in threads:
+            thread.start()
+        start.wait()
+        for thread in threads:
+            thread.join(timeout=3)
+        self.assertTrue(all(not thread.is_alive() for thread in threads))
+        self.assertEqual(len(outcomes), 200)
+        snapshot = ledger.snapshot()
+        self.assertEqual(sum(snapshot.values()), 200)
+        self.assertEqual(snapshot, {"a": 100, "b": 100})
+
+    def test_snapshots_observe_complete_transfers(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = Barrier(2)
+
+        def move_repeatedly():
+            start.wait()
+            for _ in range(500):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        thread = Thread(target=move_repeatedly)
+        thread.start()
+        start.wait()
+        while thread.is_alive():
+            snapshot = ledger.snapshot()
+            self.assertEqual(sum(snapshot.values()), 200)
+        thread.join(timeout=3)
+        self.assertFalse(thread.is_alive())
