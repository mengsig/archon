+class LedgerTransferSemantics(unittest.TestCase):
+    def test_exact_balance_transfer_succeeds(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 5})
+
+    def test_insufficient_by_one_fails_unchanged(self):
+        ledger = Ledger({"a": 4, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), False)
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 0})
+
+    def test_destination_overflow_fails_unchanged(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE})
+
+    def test_destination_filling_to_max_succeeds(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 2})
+        self.assertIs(ledger.transfer("a", "b", 2), True)
+        self.assertEqual(ledger.snapshot(), {"a": 3, "b": MAX_BALANCE})
+
+    def test_successful_transfer_preserves_total(self):
+        ledger = Ledger({"a": 100, "b": 50, "c": 0})
+        ledger.transfer("a", "c", 30)
+        ledger.transfer("b", "a", 50)
+        snap = ledger.snapshot()
+        self.assertEqual(sum(snap.values()), 150)
+        self.assertEqual(snap, {"a": 120, "b": 0, "c": 30})
+
+    def test_self_transfer_with_funds_returns_true_unchanged(self):
+        ledger = Ledger({"a": 5})
+        self.assertIs(ledger.transfer("a", "a", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_self_transfer_without_funds_returns_false(self):
+        ledger = Ledger({"a": 5})
+        self.assertIs(ledger.transfer("a", "a", 6), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_self_transfer_at_max_balance_unchanged(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
