index 0000000..f6d5baa
--- /dev/null
+++ b/tests/test_undo.py
@@ -0,0 +1,73 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task_and_never_reuses_its_id(self):
+        store = TaskStore()
+        store.add("first")
+        store.add("second")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [1])
+        self.assertEqual(store.add("third").id, 3)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        task = store.add("pay rent", tags=["home"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.id, restored.title, restored.tags), (1, "pay rent", ["home"]))
+        self.assertEqual((restored.status, restored.due), ("done", date(2026, 4, 1)))
+
+    def test_undo_delete_ignores_later_mutation_of_returned_task(self):
+        store = TaskStore()
+        task = store.add("original")
+        deleted = store.delete(task.id)
+        deleted.title = "mutated"
+        store.undo()
+        self.assertEqual(store.get(task.id).title, "original")
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_on_fresh_store_raises(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        store.add("only")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
