diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..a3ae77c 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,66 @@
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    terms = []
+    index = 0
+    while index < len(query):
+        while index < len(query) and query[index].isspace():
+            index += 1
+        if index == len(query):
+            break
+
+        if query[index] == '"':
+            end = query.find('"', index + 1)
+            if end == -1:
+                raise QueryError("unterminated quoted phrase")
+            if end + 1 < len(query) and not query[end + 1].isspace():
+                raise QueryError("quoted phrase must be a complete term")
+            terms.append((query[index + 1:end], True))
+            index = end + 1
+            continue
+
+        end = index
+        while end < len(query) and not query[end].isspace():
+            if query[end] == '"':
+                raise QueryError("quote must begin a term")
+            end += 1
+        terms.append((query[index:end], False))
+        index = end
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    if not terms:
+        return list(tasks)
+
+    filters = []
+    for value, is_phrase in terms:
+        if is_phrase or ":" not in value:
+            filters.append(("title", value.casefold()))
+            continue
+
+        field, argument = value.split(":", 1)
+        field = field.casefold()
+        argument = argument.casefold()
+        if field == "tag" and argument:
+            filters.append(("tag", argument))
+        elif field == "status" and argument in ("open", "done"):
+            filters.append(("status", argument))
+        else:
+            raise QueryError(f"invalid query term: {value}")
+
+    matches = []
+    for task in tasks:
+        title = task.title.casefold()
+        task_tags = {tag.casefold() for tag in task.tags}
+        if all(
+            (kind == "title" and value in title)
+            or (kind == "tag" and value in task_tags)
+            or (kind == "status" and task.status.casefold() == value)
+            for kind, value in filters
+        ):
+            matches.append(task)
+    return matches
