+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation_and_copying(self):
+        for invalid in (None, [], {"": 1}, {1: 1}, {"a": True},
+                        {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(invalid=invalid), self.assertRaises(ValueError):
+                Ledger(invalid)
+
+        original = {"a": 4}
+        ledger = Ledger(original)
+        original["a"] = 9
+        original["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_amount_validated_before_account_lookup(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_and_snapshot_copy(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 99
+        snapshot["new"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
+    def test_overflow_and_same_account(self):
+        ledger = Ledger({"full": MAX_BALANCE, "source": 5, "a": 2})
+        before = ledger.snapshot()
+        self.assertFalse(ledger.transfer("source", "full", 1))
+        self.assertEqual(ledger.snapshot(), before)
+        self.assertTrue(ledger.transfer("full", "full", MAX_BALANCE))
+        with self.assertRaises(ValueError):
+            ledger.transfer("full", "full", MAX_BALANCE + 1)
+        self.assertFalse(ledger.transfer("a", "a", 3))
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_empty_ledger_and_total_preservation(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+        ledger = Ledger({"a": 10, "b": 20})
+        self.assertTrue(ledger.transfer("a", "b", 7))
+        self.assertEqual(sum(ledger.snapshot().values()), 30)
+
+    def test_concurrent_opposite_transfers_terminate_and_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        barrier = Barrier(3)
+
+        def move(source, destination):
+            barrier.wait()
+            for _ in range(500):
+                ledger.transfer(source, destination, 1)
+
+        threads = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for thread in threads:
+            thread.start()
+        barrier.wait()
+        for thread in threads:
+            thread.join(timeout=2)
+            self.assertFalse(thread.is_alive(), "opposite transfers deadlocked")
+        self.assertEqual(sum(ledger.snapshot().values()), 200)
