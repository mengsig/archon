-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
 """
 
 import csv
+import re
 import sys
 
+LEGACY_CURRENCY = "USD"
+CURRENCY_CODE = re.compile(r"[A-Z]{3}")
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+
+class InvalidCurrency(ValueError):
+    """A currency code that is not exactly three uppercase ASCII letters."""
+
+
+def is_currency_code(value):
+    return isinstance(value, str) and CURRENCY_CODE.fullmatch(value) is not None
+
+
+def totals(reader):
+    """{(account, currency): total_cents} from a CSV DictReader."""
+    has_currency = "currency" in (reader.fieldnames or [])
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        currency = row["currency"] if has_currency else LEGACY_CURRENCY
+        if not is_currency_code(currency):
+            raise InvalidCurrency(
+                f"line {reader.line_num}: invalid currency code {currency!r}"
+            )
+        key = (row["account"], currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(csv.DictReader(sys.stdin))
+    except InvalidCurrency as error:
+        sys.stderr.write(f"reports: {error}\n")
+        return 2
+    sys.stdout.write(render(result))
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
