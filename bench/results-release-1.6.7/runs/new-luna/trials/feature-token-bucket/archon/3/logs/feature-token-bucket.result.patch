@@ -32,6 +32,54 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_and_wait_time_do_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.25
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(1), 0.25)
+        self.assertEqual(bucket.available(), 0.5)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_clock_rollback_preserves_tokens_and_high_water_mark(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 2.0
+        self.assertEqual(bucket.available(), 2.0)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertFalse(bucket.try_acquire())
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertEqual(bucket.wait_time(), 2.0)
+        clock.now = 2.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 2.5
+        self.assertEqual(bucket.available(), 0.5)
+
+    def test_validation(self):
+        for args in ((0, 1), (1, 0), (float("nan"), 1), (1, float("inf"))):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                TokenBucket(*args, clock=FakeClock())
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3, float("nan"), float("inf")):
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.subTest(wait_n=n), self.assertRaises(ValueError):
+                bucket.wait_time(n)
+
+    def test_keyed_lru_uses_wait_time_and_evicted_key_starts_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertEqual(limiter.wait_time("a"), 0.0)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # Makes a most recently used.
+        limiter.try_acquire("c")  # Evicts b.
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))
+
 
 if __name__ == "__main__":
     unittest.main()
