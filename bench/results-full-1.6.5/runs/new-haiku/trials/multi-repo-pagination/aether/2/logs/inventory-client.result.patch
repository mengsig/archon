 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  let cursor = null;
+  do {
+    const query = cursor === null ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error('GET /items returned a body without an items array');
+    }
+    if (body.next_cursor != null && body.next_cursor === cursor) {
+      throw new Error(`GET /items returned the same cursor twice: ${cursor}`);
+    }
+    items.push(...body.items);
+    cursor = body.next_cursor ?? null;
+  } while (cursor !== null);
+  return items;
 }
 
