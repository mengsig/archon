+fn is_currency_code(s: &str) -> bool {
+    let bytes = s.as_bytes();
+    bytes.len() == 3 && bytes.iter().all(u8::is_ascii_uppercase)
+}
+
 fn is_iso_date(s: &str) -> bool {
