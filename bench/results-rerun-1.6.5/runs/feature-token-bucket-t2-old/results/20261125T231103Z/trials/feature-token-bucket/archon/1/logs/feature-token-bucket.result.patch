 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
+import numbers
 import time
+from collections import OrderedDict
+
+
+def _check_number(name, value):
+    if isinstance(value, bool) or not isinstance(value, numbers.Real):
+        raise TypeError(f"{name} must be a number, got {type(value).__name__}")
+    if not math.isfinite(value):
+        raise ValueError(f"{name} must be finite, got {value!r}")
+    return value
+
+
+def _check_positive(name, value):
+    _check_number(name, value)
+    if value <= 0:
+        raise ValueError(f"{name} must be > 0, got {value!r}")
+    return value
+
+
+def _check_bucket_params(capacity, refill_per_sec):
+    _check_positive("capacity", capacity)
+    _check_positive("refill_per_sec", refill_per_sec)
+
+
+def _check_request(n, capacity):
+    _check_positive("n", n)
+    if n > capacity:
+        raise ValueError(f"n={n!r} exceeds capacity {capacity!r}; it can never succeed")
+
+
+def _read_clock(clock):
+    return _check_number("clock value", clock())
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        self._capacity = capacity
+        self._rate = refill_per_sec
+        self._clock = clock
+        self._tokens = capacity
+        self._last = _read_clock(clock)
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        assert self._tokens >= 0, "token count went negative"
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self._rate
+
+    def _refill(self):
+        now = _read_clock(self._clock)
+        if now <= self._last:
+            # Clock did not move forward past the latest time seen: no credit.
+            return
+        self._tokens = min(self._capacity, self._tokens + (now - self._last) * self._rate)
+        self._last = now
+        assert 0 <= self._tokens <= self._capacity, "tokens outside [0, capacity]"
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        if isinstance(max_keys, bool) or not isinstance(max_keys, numbers.Integral):
+            raise TypeError(f"max_keys must be an int, got {type(max_keys).__name__}")
+        if max_keys < 1:
+            raise ValueError(f"max_keys must be >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        return self._bucket_for(key, n).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        return self._bucket_for(key, n).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
+
+    def _bucket_for(self, key, n):
+        _check_request(n, self._capacity)
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys, "more keys than max_keys"
+        return bucket
