-        return Err(format!("bad account {account:?}"));
+        return Err(ParseError::Malformed(format!("bad account {account:?}")));
     }
+    let currency = match fields.get(3) {
+        Some(code) => parse_currency(code.trim())?,
+        None => DEFAULT_CURRENCY.to_string(),
+    };
     Ok(Entry {
