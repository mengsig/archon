+const FIVE = [1, 2, 3, 4, 5].map((id) => ({ id, sku: `SKU-000${id}`, qty: id }));
+
+// Serves `/items` like the API: pages of `pageSize`, keyed by the last id.
+function pagedTransport(items, pageSize, queries) {
+  return async (request) => {
+    queries.push(request.query);
+    const after = request.query.cursor === undefined ? 0 : Number(request.query.cursor);
+    const remaining = items.filter((item) => item.id > after);
+    const page = remaining.slice(0, pageSize);
+    const next_cursor = remaining.length > pageSize ? String(page[page.length - 1].id) : null;
+    return { status: 200, body: { items: page, next_cursor } };
+  };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor until it is null, sending no cursor first', async () => {
+  const queries = [];
+  assert.deepEqual(await listItems(pagedTransport(FIVE, 2, queries)), FIVE);
+  assert.deepEqual(queries, [{}, { cursor: '2' }, { cursor: '4' }]);
+});
+
+test('stops when next_cursor is absent', async () => {
+  const queries = [];
+  const transport = async (request) => {
+    queries.push(request.query);
+    return { status: 200, body: { items: ITEMS } };
+  };
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(queries.length, 1);
+});
+
+test('fails on a repeated cursor instead of looping', async () => {
