-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+CSV without a currency column (the pre-currency ledger format) counts as USD.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_CODE = re.compile(r"[A-Z]{3}")
+
+
+class CurrencyError(ValueError):
+    """A row carries a currency code that is not three uppercase letters."""
+
+
+def currency_of(row, line_num):
+    """The row's currency; rows without a currency column count as USD."""
+    if "currency" not in row:
+        return DEFAULT_CURRENCY
+    code = row["currency"]
+    if code is None or not CURRENCY_CODE.fullmatch(code):
+        raise CurrencyError(f"line {line_num}: bad currency {code!r}")
+    return code
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(reader):
+    """{(account, currency): total_cents} from a csv.DictReader."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        key = (row["account"], currency_of(row, reader.line_num))
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    reader = csv.DictReader(sys.stdin)
+    try:
+        result = totals(reader)
+    except CurrencyError as error:
+        print(f"error: {error}", file=sys.stderr)
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
