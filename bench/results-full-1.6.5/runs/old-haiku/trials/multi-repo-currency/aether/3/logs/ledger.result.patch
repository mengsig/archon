+use std::io::Write;
+use std::process::{Command, Stdio};
+
+use ledger::{parse_cents, parse_line, to_csv_row, LineError, CSV_HEADER};
 
 #[test]
 fn parses_amounts() {
@@ -14,7 +17,88 @@ fn parses_lines() {
     let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
