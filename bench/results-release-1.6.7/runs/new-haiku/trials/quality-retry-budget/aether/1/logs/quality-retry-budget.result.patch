diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..b8e39ef 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,44 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _check_int("attempt", attempt, minimum=1)
+    _check_int("elapsed_ms", elapsed_ms, minimum=0)
+    _check_int("max_attempts", max_attempts, minimum=1)
+    _check_int("budget_ms", budget_ms, minimum=0)
+    _check_int("base_ms", base_ms, minimum=0)
+    _check_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff_ms(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    assert delay >= 0, "delay must be non-negative"
+    return delay
+
+
+def _check_int(name, value, *, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff_ms(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without large powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # With base_ms >= 1, base_ms * 2**exponent exceeds cap_ms once
+    # exponent >= cap_ms.bit_length(), so the shift stays small.
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    backoff = min(cap_ms, base_ms << exponent)
+    assert 0 <= backoff <= cap_ms, "backoff must lie within [0, cap_ms]"
+    return backoff
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..1c9db21 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,148 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_bool_and_float_and_str(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms="100")
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.5)
+
+    def test_rejects_int_subclass(self):
+        class MyInt(int):
+            pass
+        with self.assertRaises(ValueError):
+            retry_delay(MyInt(1), 0)
+
+    def test_rejects_none_for_required_int(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, None)
+
+    def test_minimums(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validation_precedes_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=2, retry_after_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=2)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 2000, budget_ms=1000, base_ms=1.0)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_last_allowed_attempt_gets_a_delay(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_returns_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+
+class Backoff(unittest.TestCase):
+    def test_sequence_saturates_at_cap(self):
+        delays = [retry_delay(a, 0, max_attempts=10, budget_ms=10**9)
+                  for a in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(9, 0, base_ms=0, max_attempts=10), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_zero_cap_with_retry_after_uses_floor(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0, retry_after_ms=50), 50)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_huge_attempt_is_fast_and_capped(self):
+        self.assertEqual(
+            retry_delay(10**9, 0, max_attempts=10**10, base_ms=1,
+                        cap_ms=400, budget_ms=10**12),
+            400)
+
+    def test_huge_attempt_with_huge_cap(self):
+        cap = 2**200
+        self.assertEqual(
+            retry_delay(300, 0, max_attempts=10**6, base_ms=1,
+                        cap_ms=cap, budget_ms=2**300),
+            cap)
+
+    def test_matches_naive_formula(self):
+        for base in (1, 3, 100):
+            for cap in (1, 7, 400, 10**6):
+                for attempt in range(1, 40):
+                    expected = min(cap, base * 2 ** (attempt - 1))
+                    got = retry_delay(attempt, 0, max_attempts=10**6,
+                                      base_ms=base, cap_ms=cap,
+                                      budget_ms=10**30)
+                    self.assertEqual(got, expected,
+                                     (base, cap, attempt))
+
+
+class RetryAfter(unittest.TestCase):
+    def test_floor_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=1000, budget_ms=5000), 1000)
+
+    def test_floor_below_backoff_is_ignored(self):
+        self.assertEqual(retry_delay(3, 0, retry_after_ms=399), 400)
+
+    def test_zero_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class Budget(unittest.TestCase):
+    def test_finish_exactly_at_budget_is_rejected(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_finish_just_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_retry_after_is_never_shortened_to_fit(self):
+        self.assertIsNone(
+            retry_delay(1, 0, retry_after_ms=1000, budget_ms=1000))
+
+    def test_zero_budget_never_retries(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_zero_delay_returned_when_within_budget(self):
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+
+    def test_zero_delay_rejected_when_elapsed_reaches_budget(self):
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+
+    def test_large_integers_have_no_upper_limit(self):
+        big = 10**40
+        self.assertEqual(
+            retry_delay(1, big, base_ms=big, cap_ms=big,
+                        budget_ms=big + 10**41),
+            big)
+
+
+if __name__ == "__main__":
+    unittest.main()
