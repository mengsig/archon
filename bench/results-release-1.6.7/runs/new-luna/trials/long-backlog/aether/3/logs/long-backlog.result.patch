diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..fd8ea64 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,61 @@
+class QueryError(ValueError):
+    """Raised when a search query is malformed or uses an unknown field."""
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    active = False
+    for character in query:
+        if character == '"':
+            quoted = not quoted
+            active = True
+        elif character.isspace() and not quoted:
+            if active:
+                terms.append("".join(current))
+                current = []
+                active = False
+        else:
+            current.append(character)
+            active = True
+    if quoted:
+        raise QueryError("unterminated quoted phrase")
+    if active:
+        terms.append("".join(current))
+    return terms
+
+
+def _validate(term):
+    if ":" not in term:
+        return
+    field, value = term.split(":", 1)
+    field = field.casefold()
+    if field == "status":
+        if value.casefold() not in ("open", "done"):
+            raise QueryError(f"unknown status: {value}")
+    elif field != "tag":
+        raise QueryError(f"unknown query field: {field}")
+
+
+def _matches(task, term):
+    if ":" not in term:
+        return term.casefold() in task.title.casefold()
+
+    field, value = term.split(":", 1)
+    field = field.casefold()
+    if field == "tag":
+        return any(value.casefold() == tag.casefold() for tag in task.tags)
+    if field == "status":
+        normalized = value.casefold()
+        if normalized not in ("open", "done"):
+            raise QueryError(f"unknown status: {value}")
+        return task.status.casefold() == normalized
+    raise QueryError(f"unknown query field: {field}")
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    for term in terms:
+        _validate(term)
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
