+import base64
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MAX_INT_DIGITS = 18
+
+
+class InvalidQuery(ValueError):
+    """A query parameter sent by the client is malformed."""
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +31,49 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after_id = _decode_cursor(query.get("cursor"))
+    except InvalidQuery as exc:
+        return _error(400, str(exc))
+    remaining = [
+        item for item in sorted(ITEMS, key=lambda item: item["id"])
+        if item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    assert len(page) <= limit
+    assert next_cursor is None or len(page) == limit
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_plain_int(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise InvalidQuery(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _encode_cursor(item_id):
+    return base64.b64encode(str(item_id).encode("ascii"), altchars=b"-_").decode("ascii")
+
+
+def _decode_cursor(raw):
+    """Return the id the page starts after; 0 when no cursor was sent."""
+    if raw is None:
+        return 0
+    try:
+        decoded = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except ValueError as exc:
+        raise InvalidQuery("cursor is not valid") from exc
+    if not _is_plain_int(decoded):
+        raise InvalidQuery("cursor is not valid")
+    return int(decoded)
+
+
+def _is_plain_int(text):
+    return text.isascii() and text.isdigit() and len(text) <= MAX_INT_DIGITS
 
 
