@@ -0,0 +1,111 @@
+"""Tests for TaskStore.undo (TT-104)."""
+import unittest
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+        self.assertEqual(store.all(), [])
+
+    def test_undo_add_does_not_reuse_id(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_complete_restores_previous_status(self):
+        store = TaskStore()
+        task = store.add("already done")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+
+    def test_undo_delete_restores_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work"], due=None)
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.title, "write report")
+        self.assertEqual(restored.tags, ["work"])
+        self.assertEqual(restored.status, DONE)
+        self.assertEqual([t.id for t in store.all()], [task.id])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(store.get(b.id).title, "b")
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_skips_already_undone_entries(self):
+        store = TaskStore()
+        a = store.add("a")
+        store.add("b")
+        store.undo()
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        self.assertEqual(store.all(), [])
+        self.assertEqual(store.add("c").id, a.id + 2)
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        task = store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        self.assertEqual(task.status, OPEN)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.delete(1)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
