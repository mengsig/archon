+class BucketEdgeTest(unittest.TestCase):
+    def test_invalid_parameters_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0), (float("nan"), 1.0), (1, float("nan"))]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_n_raises_for_all_methods(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_failed_acquire_consumes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_refill_and_cap(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.25)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_wait_time_is_zero_when_available_and_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        self.assertEqual(bucket.available(), 4.0)
+
+    def test_wait_time_predicts_acquire(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        clock.now = 0.5
+        wait = bucket.wait_time(3)
+        self.assertAlmostEqual(wait, 1.0)
+        clock.now += wait
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(4, 1.0, clock=clock)
+        bucket.try_acquire(4)
+        clock.now = 12.0
+        self.assertAlmostEqual(bucket.available(), 2.0)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.available(), 2.0)
+        self.assertEqual(bucket.wait_time(3), 1.0)
+        clock.now = 13.0
+        self.assertAlmostEqual(bucket.available(), 3.0)
+
+
+class KeyedEdgeTest(unittest.TestCase):
+    def test_invalid_max_keys_raises(self):
+        for max_keys in [0, -1]:
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_bucket_parameters_raise(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0, clock=FakeClock())
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_invalid_n_on_new_key_does_not_create_or_evict(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=2)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", n=0)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_keyed_clock_is_shared_and_refills(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, clock=clock)
+        limiter.try_acquire("a", 2)
+        clock.now = 1.0
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
