 """Extract validated regular-file entries. See SPEC.md."""
 
+import errno
+import os
+import stat
+from pathlib import Path
+
+_NATIVE_PATH = type(Path())
+_NAME_MAX = 255
+_PATH_MAX = 4096
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write every entry under root and return the names in input order.
+
+    Only validation is atomic: an OSError while writing can leave earlier
+    entries on disk, because rollback is outside this API's scope.
+    """
+    if type(entries) is not list:
+        raise ValueError("entries must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    planned = _plan_batch(entries, root_path)
+    for _, parts, data in planned:
+        _write_file(root_path, parts, data)
+    return [name for name, _, _ in planned]
+
+
+def _validate_root(root):
+    if type(root) is str:
+        if not root:
+            raise ValueError("root must not be an empty string")
+        root_path = Path(root)
+    elif type(root) is _NATIVE_PATH:
+        root_path = root
+    else:
+        raise ValueError("root must be a str or pathlib.Path")
+    if ".." in root_path.parts:
+        raise ValueError(f"root {root_path} must not contain '..' components")
+    info = _lstat_or_none(root_path)
+    if info is None:
+        raise ValueError(f"root {root_path} does not exist or has a non-directory ancestor")
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root {root_path} must not be a symlink")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root {root_path} is not a directory")
+    return root_path
+
+
+def _plan_batch(entries, root):
+    """Validate every entry before any filesystem change; return (name, parts, data)."""
+    planned = []
+    for entry in entries:
+        name, data = _check_entry(entry)
+        planned.append((name, _split_name(name), data))
+    _check_batch_conflicts([parts for _, parts, _ in planned])
+    for _, parts, _ in planned:
+        _check_fs_target(root, parts)
+    return planned
+
+
+def _check_entry(entry):
+    """Accept only exact builtin types so no caller-supplied method can run."""
+    if type(entry) is not tuple or len(entry) != 2:
+        raise ValueError(f"entry of type {type(entry).__name__} must be an exact (name, data) tuple")
+    name, data = entry
+    if type(name) is not str:
+        raise ValueError(f"entry name of type {type(name).__name__} must be an exact str")
+    if type(data) is not bytes:
+        raise ValueError(f"data for {name!r} must be bytes")
+    return name, data
+
+
+def _split_name(name):
+    """Return the path components of a relative POSIX name, rejecting unsafe ones."""
+    if name.startswith("/"):
+        raise ValueError(f"name {name!r} must be relative")
+    for forbidden in ("\\", ":", "\x00"):
+        if forbidden in name:
+            raise ValueError(f"name {name!r} must not contain {forbidden!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name {name!r} is not valid Unicode") from exc
+    parts = tuple(name.split("/"))
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise ValueError(f"name {name!r} has an empty, '.' or '..' component")
+        if len(part.encode("utf-8")) > _NAME_MAX:
+            raise ValueError(f"name {name!r} has a component longer than {_NAME_MAX} bytes")
+    return parts
+
+
+def _check_batch_conflicts(all_parts):
+    """Reject duplicate names and names where one is a directory of another."""
+    files = set()
+    for parts in all_parts:
+        if parts in files:
+            raise ValueError(f"duplicate name {'/'.join(parts)!r} in batch")
+        files.add(parts)
+    for parts in files:
+        for depth in range(1, len(parts)):
+            if parts[:depth] in files:
+                raise ValueError(
+                    f"name {'/'.join(parts[:depth])!r} collides with a directory of "
+                    f"{'/'.join(parts)!r} in batch"
+                )
+
+
+def _check_fs_target(root, parts):
+    """Ensure every existing ancestor below root is a real directory and the target is absent."""
+    if len(os.fsencode(root.joinpath(*parts))) >= _PATH_MAX:
+        raise ValueError(f"path under {root} exceeds {_PATH_MAX} bytes")
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"{current} exists and is not a real directory")
+    target = current / parts[-1]
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"{target} already exists")
+
+
+def _write_file(root, parts, data):
+    assert all(part not in ("", ".", "..") and "/" not in part for part in parts)
+    assert type(data) is bytes
+    parent = root.joinpath(*parts[:-1])
+    os.makedirs(parent, exist_ok=True)
+    with open(parent / parts[-1], "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    """Return lstat info, or None when the path does not exist."""
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
+    except OSError as exc:
+        if exc.errno == errno.ENAMETOOLONG:
+            raise ValueError(f"path {path} is too long") from exc
+        raise
