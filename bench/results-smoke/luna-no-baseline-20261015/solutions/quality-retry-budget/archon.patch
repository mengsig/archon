diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..ac54591 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,42 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": attempt,
+        "elapsed_ms": elapsed_ms,
+        "max_attempts": max_attempts,
+        "budget_ms": budget_ms,
+        "base_ms": base_ms,
+        "cap_ms": cap_ms,
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = retry_after_ms
+
+    for name, value in values.items():
+        if type(value) is not int:
+            raise ValueError(f"{name} must be an integer")
+
+    if attempt < 1 or max_attempts < 1:
+        raise ValueError("attempt and max_attempts must be at least 1")
+    for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms"):
+        if values[name] < 0:
+            raise ValueError(f"{name} must be non-negative")
+    if retry_after_ms is not None and retry_after_ms < 0:
+        raise ValueError("retry_after_ms must be non-negative")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        exponent = attempt - 1
+        if base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+    delay = max(backoff, retry_after_ms or 0)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..afc30dc 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,42 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_and_budget_limits(self):
+        self.assertIsNone(retry_delay(5, 0))
+        self.assertIsNone(retry_delay(1, 900))
+        self.assertIsNone(retry_delay(1, 800, budget_ms=900))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertEqual(retry_delay(1, 0, budget_ms=100), None)
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+
+    def test_retry_after_is_an_uncapped_minimum(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=1000), None)
+        self.assertEqual(retry_delay(1, 0, budget_ms=2000,
+                                     retry_after_ms=1000), 1000)
+        self.assertEqual(retry_delay(1, 0, base_ms=0,
+                                     retry_after_ms=50), 50)
+
+    def test_saturation_handles_huge_attempts(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1),
+                         400)
+
+    def test_validation_precedes_exhaustion(self):
+        for kwargs in ({"attempt": True}, {"attempt": 0},
+                       {"elapsed_ms": -1}, {"max_attempts": 0},
+                       {"budget_ms": -1}, {"base_ms": 1.0},
+                       {"cap_ms": False}, {"retry_after_ms": -1}):
+            with self.subTest(kwargs=kwargs):
+                args = {"attempt": 4, "elapsed_ms": 0}
+                args.update(kwargs)
+                with self.assertRaises(ValueError):
+                    retry_delay(**args)
+
+    def test_integer_subclasses_are_rejected(self):
+        class IntSubclass(int):
+            pass
+
+        with self.assertRaises(ValueError):
+            retry_delay(IntSubclass(1), 0)
