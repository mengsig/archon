diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..3a5461e 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,44 @@
+class QueryError(ValueError):
+    """Raised when a search query contains invalid syntax."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = []
+    term = []
+    quoted = False
+    active = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            active = True
+        elif char.isspace() and not quoted:
+            if active:
+                terms.append("".join(term))
+                term = []
+                active = False
+        else:
+            term.append(char)
+            active = True
+    if quoted:
+        raise QueryError("Unterminated quoted phrase")
+    if active:
+        terms.append("".join(term))
+
+    predicates = []
+    for term in terms:
+        if ":" not in term:
+            needle = term.casefold()
+            predicates.append(lambda task, needle=needle: needle in task.title.casefold())
+            continue
+
+        field, value = term.split(":", 1)
+        if field == "tag" and value:
+            tag = value.casefold()
+            predicates.append(lambda task, tag=tag: any(item.casefold() == tag for item in task.tags))
+        elif field == "status" and value.casefold() in ("open", "done"):
+            status = value.casefold()
+            predicates.append(lambda task, status=status: task.status.casefold() == status)
+        else:
+            raise QueryError(f"Invalid search term: {term}")
+
+    return [task for task in tasks if all(predicate(task) for predicate in predicates)]
