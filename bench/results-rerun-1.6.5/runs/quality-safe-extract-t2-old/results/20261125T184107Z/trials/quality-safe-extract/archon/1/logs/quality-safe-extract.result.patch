 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, got {type(entries).__name__}")
+    root_path = _validate_root(root)
+    plan = _validate_batch(entries)
+    _check_targets_absent(root_path, plan)
+    for _, parts, data in plan:
+        _write_file(root_path, parts, data)
+    return [name for name, _, _ in plan]
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty path, got {type(root).__name__}")
+    root_path = Path(root)
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as err:
+        raise ValueError(f"root does not exist: {root!r}") from err
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be a real directory, not a symlink or file: {root!r}")
+    return root_path
+
+
+def _validate_batch(entries):
+    """Return [(name, parts, data)] for the whole batch, or raise ValueError."""
+    plan = []
+    files = set()
+    dirs = set()
+    for entry in entries:
+        name, data = _unpack_entry(entry)
+        parts = _split_name(name)
+        _register_target(name, parts, files, dirs)
+        plan.append((name, parts, data))
+    return plan
+
+
+def _unpack_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, got {type(entry).__name__}")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be a string, got {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes, got {type(data).__name__}")
+    return name, data
+
+
+def _split_name(name):
+    """Return the path components of a relative POSIX name, or raise ValueError."""
+    if name == "":
+        raise ValueError("entry name must be nonempty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative: {name!r}")
+    for char in FORBIDDEN_NAME_CHARS:
+        if char in name:
+            raise ValueError(f"entry name contains forbidden character {char!r}: {name!r}")
+    parts = tuple(name.split("/"))
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name has an empty, '.' or '..' component: {name!r}")
+    return parts
+
+
+def _register_target(name, parts, files, dirs):
+    """Record a file target and its parent directories, rejecting any collision."""
+    assert parts and all(parts), "name components must be nonempty"
+    if parts in files or parts in dirs:
+        raise ValueError(f"duplicate entry name: {name!r}")
+    for depth in range(1, len(parts)):
+        prefix = parts[:depth]
+        if prefix in files:
+            raise ValueError(f"entry {name!r} lies below file entry {'/'.join(prefix)!r}")
+        dirs.add(prefix)
+    files.add(parts)
+
+
+def _check_targets_absent(root, plan):
+    for name, parts, _ in plan:
+        _check_one_target(root, name, parts)
+
+
+def _check_one_target(root, name, parts):
+    """Fail unless every existing component below root is a real directory
+    and the target itself does not exist."""
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"existing symlink blocks {name!r} at {str(current)!r}")
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists: {name!r}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"existing non-directory blocks {name!r} at {str(current)!r}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_file(root, parts, data):
+    target = root.joinpath(*parts)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with open(target, "xb") as handle:
+        handle.write(data)
