-use ledger::{parse_cents, parse_line, to_csv_row};
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+use ledger::{parse_cents, parse_line, to_csv_row, ParseError, CSV_HEADER};
 
 #[test]
 fn parses_amounts() {
@@ -18,3 +21,89 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,EUR");
+}
+
+#[test]
+fn malformed_currency_is_a_bad_currency_error() {
+    for code in ["usd", "US", "USDX", "U5D", "", "EU "] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let result = parse_line(&line);
+        assert!(
+            matches!(result, Err(ParseError::BadCurrency(_))),
+            "code {code:?} gave {result:?}"
+        );
+    }
+}
+
+#[test]
+fn csv_header_has_currency_column() {
+    assert_eq!(CSV_HEADER, "date,account,amount_cents,currency");
+}
+
+#[test]
+fn too_many_fields_is_malformed_not_currency() {
+    let result = parse_line("2026-03-01\tgroceries\t1\tUSD\textra");
+    assert!(matches!(result, Err(ParseError::Malformed(_))));
+}
+
+fn run_ledger(input: &str) -> (i32, String, String) {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    let output = child.wait_with_output().expect("wait for ledger");
+    (
+        output.status.code().expect("exit code"),
+        String::from_utf8(output.stdout).expect("utf8 stdout"),
+        String::from_utf8(output.stderr).expect("utf8 stderr"),
+    )
+}
+
+#[test]
+fn binary_writes_header_and_rows_with_currency() {
+    let input = "2026-03-01\tgroceries\t-45.10\n2026-03-02\trent\t900\tEUR\n";
+    let (code, stdout, _) = run_ledger(input);
+    assert_eq!(code, 0);
+    assert_eq!(
+        stdout,
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,-4510,USD\n\
+         2026-03-02,rent,90000,EUR\n"
+    );
+}
+
+#[test]
+fn binary_exits_2_on_malformed_currency_with_line_number() {
+    let (code, stdout, stderr) = run_ledger("2026-03-01\tgroceries\t1\tUSD\n2026-03-02\trent\t2\teur\n");
+    assert_eq!(code, 2);
+    assert!(stderr.starts_with("line 2: "), "stderr was {stderr:?}");
+    assert!(stdout.starts_with("date,account,amount_cents,currency\n"));
+}
+
+#[test]
+fn binary_exits_1_on_other_input_errors() {
+    let (code, _, stderr) = run_ledger("2026-03-01\tgroceries\tabc\n");
+    assert_eq!(code, 1);
+    assert!(stderr.starts_with("line 1: "), "stderr was {stderr:?}");
+}
