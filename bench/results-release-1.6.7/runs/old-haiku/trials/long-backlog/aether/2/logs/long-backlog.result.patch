+++ b/tests/test_search.py
@@ -0,0 +1,73 @@
+import unittest
+
+from tasktracker.models import DONE, Task
+from tasktracker.search import QueryError, search
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login page", ["work"]),
+            Task(2, "login fix ideas", ["Home"], DONE),
+            Task(3, "Buy milk", ["workshop"]),
+            Task(4, "status:open note", []),
+        ]
+
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   "]:
+            with self.subTest(query=query):
+                self.assertEqual(titles(search(self.tasks, query)), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(titles(search(self.tasks, "LOGIN")), ["Fix login page", "login fix ideas"])
+
+    def test_bare_words_must_all_match(self):
+        self.assertEqual(titles(search(self.tasks, "login fix")), ["Fix login page", "login fix ideas"])
+        self.assertEqual(titles(search(self.tasks, "login milk")), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix login page"])
+
+    def test_quoted_term_is_never_a_field(self):
+        self.assertEqual(titles(search(self.tasks, '"status:open"')), ["status:open note"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Fix login page"])
+        self.assertEqual(titles(search(self.tasks, "tag:home")), ["login fix ideas"])
+
+    def test_quoted_tag_value_may_contain_spaces(self):
+        tasks = [Task(1, "a", ["my tag"]), Task(2, "b", ["my"])]
+        self.assertEqual(titles(search(tasks, 'tag:"My Tag"')), ["a"])
+
+    def test_status_matches_open_or_done(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["login fix ideas"])
+        self.assertEqual(len(search(self.tasks, "status:open")), 3)
+
+    def test_text_and_fields_combine_with_and(self):
+        self.assertEqual(titles(search(self.tasks, "login tag:work")), ["Fix login page"])
+
+    def test_unknown_field_is_an_error(self):
+        for query in ["title:login", "http://example.com"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+    def test_unknown_status_is_an_error(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_empty_tag_is_an_error(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_is_an_error(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+
+if __name__ == "__main__":
+    unittest.main()
