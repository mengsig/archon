+/// The optional currency column: `None` means the default, otherwise a code.
+fn parse_currency(field: Option<&str>) -> Result<String, ParseError> {
+    let Some(field) = field else {
+        return Ok(DEFAULT_CURRENCY.to_string());
+    };
+    let code = field.trim();
+    if !is_currency_code(code) {
+        return Err(ParseError::BadCurrency(format!("bad currency {code:?}")));
+    }
+    Ok(code.to_string())
+}
+
+/// ISO 4217 shape: exactly three uppercase ASCII letters.
+fn is_currency_code(s: &str) -> bool {
+    s.len() == 3 && s.bytes().all(|c| c.is_ascii_uppercase())
+}
