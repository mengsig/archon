@@ -0,0 +1,98 @@
+import unittest
+
+from tasktracker.search import QueryError, search, tokenize
+from tasktracker.store import TaskStore
+
+
+def make_store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("fix logout", tags=["home"])
+    store.add("write report", tags=["work", "urgent"])
+    store.add("buy milk")
+    return store
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.store = make_store()
+
+    def run_search(self, query):
+        return titles(search(self.store.all(), query))
+
+    def test_bare_word_is_case_insensitive_substring_of_title(self):
+        self.assertEqual(self.run_search("FIX"), ["Fix login bug", "fix logout"])
+
+    def test_bare_word_does_not_match_tags(self):
+        self.assertEqual(self.run_search("work"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(self.run_search('"fix login"'), ["Fix login bug"])
+
+    def test_unquoted_words_are_and_terms(self):
+        self.assertEqual(self.run_search("fix login"), ["Fix login bug"])
+
+    def test_phrase_and_word_combine_with_and(self):
+        self.assertEqual(self.run_search('"fix" bug'), ["Fix login bug"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(self.run_search("tag:WORK"), ["Fix login bug", "write report"])
+
+    def test_tag_does_not_match_partial_tag_name(self):
+        self.assertEqual(self.run_search("tag:wor"), [])
+
+    def test_status_open_and_done(self):
+        self.store.complete(self.store.all()[0].id)
+        self.assertEqual(self.run_search("status:done"), ["Fix login bug"])
+        self.assertEqual(
+            self.run_search("status:OPEN"), ["fix logout", "write report", "buy milk"]
+        )
+
+    def test_field_terms_combine_with_words(self):
+        self.assertEqual(self.run_search("tag:work report"), ["write report"])
+
+    def test_quoted_field_like_text_is_a_title_phrase(self):
+        self.assertEqual(self.run_search('"tag:work"'), [])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.store.all(), "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.store.all(), "status:pending")
+
+    def test_tag_without_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.store.all(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.store.all(), '"fix login')
+
+    def test_tokenize_rejects_unterminated_quote(self):
+        with self.assertRaises(QueryError):
+            tokenize('a "b')
+
+    def test_blank_query_matches_everything_in_order(self):
+        expected = titles(self.store.all())
+        self.assertEqual(self.run_search(""), expected)
+        self.assertEqual(self.run_search("   \t "), expected)
+
+    def test_query_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:pending")
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(self.store.all()))
+        self.assertEqual(
+            titles(search(reversed_tasks, "fix")), ["fix logout", "Fix login bug"]
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
