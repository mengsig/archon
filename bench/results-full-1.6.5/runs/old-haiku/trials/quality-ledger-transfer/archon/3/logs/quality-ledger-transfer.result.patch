+class LedgerConcurrency(unittest.TestCase):
+    def run_threads(self, targets):
+        errors = []
+
+        def guarded(target):
+            try:
+                target()
+            except Exception as exc:
+                errors.append(exc)
+
+        threads = [threading.Thread(target=guarded, args=(t,), daemon=True) for t in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(THREAD_JOIN_SECONDS)
+            self.assertFalse(thread.is_alive(), "thread did not finish: possible deadlock")
+        self.assertEqual(errors, [])
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def a_to_b():
+            for _ in range(2000):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(2000):
+                ledger.transfer("b", "a", 1)
+
+        self.run_threads([a_to_b, b_to_a] * 2)
+        final = ledger.snapshot()
+        self.assertEqual(sum(final.values()), 2000)
+        self.assertTrue(all(balance >= 0 for balance in final.values()))
+
+    def test_concurrent_transfers_preserve_total_and_balances(self):
+        accounts = {"a": 500, "b": 500, "c": 500}
+        ledger = Ledger(accounts)
+        pairs = [("a", "b"), ("b", "c"), ("c", "a")]
+
+        def worker(source, destination):
+            def run():
+                for _ in range(1000):
+                    ledger.transfer(source, destination, 1)
+            return run
+
+        self.run_threads([worker(s, d) for s, d in pairs])
+        self.assertEqual(sum(ledger.snapshot().values()), 1500)
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 0})
+        observed = []
+
+        def mover():
+            for _ in range(1000):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def observer():
+            for _ in range(2000):
+                observed.append(sum(ledger.snapshot().values()))
+
+        self.run_threads([mover, observer])
+        self.assertEqual(set(observed), {1000})
+
+
+if __name__ == "__main__":
+    unittest.main()
