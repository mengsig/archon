diff --git a/src/status.rs b/src/status.rs
new file mode 100644
index 0000000..458d010
--- /dev/null
+++ b/src/status.rs
@@ -0,0 +1,121 @@
+use std::error::Error;
+use std::fmt;
+use std::str::FromStr;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum OrderStatus {
+    Pending,
+    Paid,
+    Shipped,
+    Cancelled,
+}
+
+impl OrderStatus {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            OrderStatus::Pending => "pending",
+            OrderStatus::Paid => "paid",
+            OrderStatus::Shipped => "shipped",
+            OrderStatus::Cancelled => "cancelled",
+        }
+    }
+
+    pub fn can_transition_to(self, next: OrderStatus) -> bool {
+        matches!(
+            (self, next),
+            (OrderStatus::Pending, OrderStatus::Paid)
+                | (OrderStatus::Pending, OrderStatus::Cancelled)
+                | (OrderStatus::Paid, OrderStatus::Shipped)
+                | (OrderStatus::Paid, OrderStatus::Cancelled)
+        )
+    }
+}
+
+impl fmt::Display for OrderStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.pad(self.as_str())
+    }
+}
+
+/// The rejected input is kept so the message can name it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ParseStatusError {
+    input: String,
+}
+
+impl fmt::Display for ParseStatusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "unknown status {:?}", self.input)
+    }
+}
+
+impl Error for ParseStatusError {}
+
+impl FromStr for OrderStatus {
+    type Err = ParseStatusError;
+
+    /// Exact and case-sensitive: only the lowercase names are accepted.
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        match s {
+            "pending" => Ok(OrderStatus::Pending),
+            "paid" => Ok(OrderStatus::Paid),
+            "shipped" => Ok(OrderStatus::Shipped),
+            "cancelled" => Ok(OrderStatus::Cancelled),
+            _ => Err(ParseStatusError {
+                input: s.to_string(),
+            }),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ALL: [OrderStatus; 4] = [
+        OrderStatus::Pending,
+        OrderStatus::Paid,
+        OrderStatus::Shipped,
+        OrderStatus::Cancelled,
+    ];
+
+    #[test]
+    fn names_round_trip_through_parse_and_display() {
+        for status in ALL {
+            assert_eq!(status.to_string(), status.as_str());
+            assert_eq!(status.as_str().parse::<OrderStatus>(), Ok(status));
+        }
+    }
+
+    #[test]
+    fn parse_rejects_anything_but_the_exact_lowercase_name() {
+        for input in ["Paid", " paid", "paid ", "lost", ""] {
+            let err = input.parse::<OrderStatus>().unwrap_err();
+            assert_eq!(err.to_string(), format!("unknown status {input:?}"));
+        }
+    }
+
+    #[test]
+    fn display_honours_width_like_str_does() {
+        assert_eq!(format!("[{:>9}]", OrderStatus::Paid), "[     paid]");
+    }
+
+    #[test]
+    fn lifecycle_allows_only_the_four_documented_steps() {
+        let allowed = [
+            (OrderStatus::Pending, OrderStatus::Paid),
+            (OrderStatus::Pending, OrderStatus::Cancelled),
+            (OrderStatus::Paid, OrderStatus::Shipped),
+            (OrderStatus::Paid, OrderStatus::Cancelled),
+        ];
+        for from in ALL {
+            for to in ALL {
+                assert_eq!(
+                    from.can_transition_to(to),
+                    allowed.contains(&(from, to)),
+                    "{from} -> {to}"
+                );
+            }
+        }
+    }
+}
diff --git a/tests/characterization_reports.rs b/tests/characterization_reports.rs
new file mode 100644
index 0000000..c5b1357
--- /dev/null
+++ b/tests/characterization_reports.rs
@@ -0,0 +1,175 @@
+use orders::{billing, report, shipping, Order};
+
+fn order_with(id: u32, total_cents: u64, status: &str) -> Order {
+    let mut order = Order::new(id, "zoe", total_cents);
+    match status {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("test helper does not know status {other}"),
+    }
+    order
+}
+
+#[test]
+fn status_counts_sort_by_status_name_not_lifecycle() {
+    let orders = vec![
+        order_with(1, 10, "shipped"),
+        order_with(2, 10, "pending"),
+        order_with(3, 10, "cancelled"),
+        order_with(4, 10, "shipped"),
+        order_with(5, 10, "paid"),
+    ];
+    let counts: Vec<(String, usize)> = report::status_counts(&orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        counts,
+        [
+            ("cancelled".to_string(), 1),
+            ("paid".to_string(), 1),
+            ("pending".to_string(), 1),
+            ("shipped".to_string(), 2),
+        ]
+    );
+}
+
+#[test]
+fn status_counts_of_nothing_is_empty() {
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn outstanding_cents_counts_only_pending_orders() {
+    let orders = vec![
+        order_with(1, 100, "pending"),
+        order_with(2, 200, "paid"),
+        order_with(3, 400, "shipped"),
+        order_with(4, 800, "cancelled"),
+        order_with(5, 1600, "pending"),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 1700);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_lists_paid_ids_in_input_order() {
+    let orders = vec![
+        order_with(9, 1, "paid"),
+        order_with(3, 1, "pending"),
+        order_with(4, 1, "paid"),
+        order_with(1, 1, "shipped"),
+        order_with(2, 1, "paid"),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [9, 4, 2]);
+}
+
+#[test]
+fn to_line_writes_id_customer_total_and_status() {
+    let order = order_with(12, 4500, "cancelled");
+    assert_eq!(report::to_line(&order), "12,zoe,4500,cancelled");
+}
+
+#[test]
+fn to_line_does_not_escape_commas_in_customer() {
+    let order = Order::new(1, "smith, jo", 5);
+    let line = report::to_line(&order);
+    assert_eq!(line, "1,smith, jo,5,pending");
+    let err = report::from_line(&line).unwrap_err();
+    assert_eq!(err, "expected 4 fields, got 5");
+}
+
+#[test]
+fn from_line_round_trips_every_status() {
+    for status in ["pending", "paid", "shipped", "cancelled"] {
+        let order = order_with(3, 99, status);
+        let line = report::to_line(&order);
+        assert_eq!(report::from_line(&line).unwrap(), order);
+    }
+}
+
+#[test]
+fn from_line_trims_only_the_outer_whitespace_of_the_line() {
+    let order = report::from_line(" 1,ada,100,paid\n").unwrap();
+    assert_eq!(order.id, 1);
+    assert_eq!(order.customer, "ada");
+    assert_eq!(order.total_cents, 100);
+    assert_eq!(order.status.to_string(), "paid");
+    let padded_status = report::from_line("1,ada,100, paid").unwrap_err();
+    assert_eq!(padded_status, "unknown status \" paid\"");
+}
+
+#[test]
+fn from_line_keeps_inner_field_whitespace_in_the_customer() {
+    let order = report::from_line("1, ada,100,paid").unwrap();
+    assert_eq!(order.customer, " ada");
+}
+
+#[test]
+fn from_line_rejects_wrong_field_counts() {
+    assert_eq!(
+        report::from_line("").unwrap_err(),
+        "expected 4 fields, got 1"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,paid,extra").unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+}
+
+#[test]
+fn from_line_rejects_unparseable_numbers() {
+    assert_eq!(
+        report::from_line("x,ada,100,paid").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line(",ada,100,paid").unwrap_err(),
+        "bad id \"\": cannot parse integer from empty string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,-1,paid").unwrap_err(),
+        "bad total \"-1\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("4294967296,ada,1,paid").unwrap_err(),
+        "bad id \"4294967296\": number too large to fit in target type"
+    );
+}
+
+#[test]
+fn from_line_checks_id_and_total_before_status() {
+    assert_eq!(
+        report::from_line("x,ada,100,lost").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,nope,lost").unwrap_err(),
+        "bad total \"nope\": invalid digit found in string"
+    );
+}
+
+#[test]
+fn from_line_status_is_case_sensitive_and_exact() {
+    assert_eq!(
+        report::from_line("1,ada,100,Paid").unwrap_err(),
+        "unknown status \"Paid\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,lost").unwrap_err(),
+        "unknown status \"lost\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,").unwrap_err(),
+        "unknown status \"\""
+    );
+}
diff --git a/tests/characterization_transitions.rs b/tests/characterization_transitions.rs
new file mode 100644
index 0000000..764c6fc
--- /dev/null
+++ b/tests/characterization_transitions.rs
@@ -0,0 +1,84 @@
+use orders::{billing, shipping, Order};
+
+fn status_text(order: &Order) -> String {
+    order.status.to_string()
+}
+
+fn order_in(status: &str) -> Order {
+    let mut order = Order::new(7, "eve", 300);
+    match status {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("test helper does not know status {other}"),
+    }
+    assert_eq!(status_text(&order), status);
+    order
+}
+
+#[test]
+fn new_orders_start_pending_and_open() {
+    let order = Order::new(1, "ada", 1200);
+    assert_eq!(status_text(&order), "pending");
+    assert!(order.is_open());
+}
+
+#[test]
+fn is_open_is_true_only_for_pending_and_paid() {
+    assert!(order_in("pending").is_open());
+    assert!(order_in("paid").is_open());
+    assert!(!order_in("shipped").is_open());
+    assert!(!order_in("cancelled").is_open());
+}
+
+#[test]
+fn pay_succeeds_only_from_pending() {
+    let mut order = order_in("pending");
+    billing::pay(&mut order).unwrap();
+    assert_eq!(status_text(&order), "paid");
+
+    for status in ["paid", "shipped", "cancelled"] {
+        let mut order = order_in(status);
+        let err = billing::pay(&mut order).unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be paid: it is {status}"));
+        assert_eq!(status_text(&order), status);
+    }
+}
+
+#[test]
+fn ship_succeeds_only_from_paid() {
+    let mut order = order_in("paid");
+    shipping::ship(&mut order).unwrap();
+    assert_eq!(status_text(&order), "shipped");
+
+    for status in ["pending", "shipped", "cancelled"] {
+        let mut order = order_in(status);
+        let err = shipping::ship(&mut order).unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be shipped: it is {status}"));
+        assert_eq!(status_text(&order), status);
+    }
+}
+
+#[test]
+fn cancel_succeeds_from_pending_and_paid() {
+    for status in ["pending", "paid"] {
+        let mut order = order_in(status);
+        order.cancel().unwrap();
+        assert_eq!(status_text(&order), "cancelled");
+        assert!(!order.is_open());
+    }
+}
+
+#[test]
+fn cancel_is_refused_once_shipped_or_cancelled() {
+    for status in ["shipped", "cancelled"] {
+        let mut order = order_in(status);
+        let err = order.cancel().unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be cancelled: it is {status}"));
+        assert_eq!(status_text(&order), status);
+    }
+}
