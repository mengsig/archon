 }
+
+#[test]
+fn defaults_currency_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert!(to_csv_row(&entry).ends_with(",100,USD"));
+}
+
+#[test]
+fn parses_explicit_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency() {
+    for bad in ["eur", "EURO", "US1", "", "E R"] {
+        let line = format!("2026-03-01\tgroceries\t1\t{bad}");
+        let err = parse_line(&line).unwrap_err();
+        assert!(
+            matches!(err, ParseError::Currency(_)),
+            "{bad:?} gave {err:?}"
+        );
+        assert_eq!(err.exit_code(), 2);
+    }
+}
+
+#[test]
+fn other_input_errors_exit_1() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tEUR\textra").unwrap_err();
+    assert_eq!(err.exit_code(), 1);
+    let err = parse_line("2026-03-01\tgroceries\tabc\tEUR").unwrap_err();
+    assert_eq!(err.exit_code(), 1);
+}
