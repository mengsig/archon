@@ -0,0 +1,73 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN, Task
+from tasktracker.search import QueryError, search
+
+TASKS = [
+    Task(1, "Write report", ["work"], OPEN),
+    Task(2, "Fix login page", ["Work", "big task"], DONE),
+    Task(3, "buy milk", ["homework"], OPEN),
+    Task(4, "login fix notes", [], DONE),
+]
+
+
+def titles(query, tasks=TASKS):
+    return [task.title for task in search(tasks, query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_input_order(self):
+        reversed_tasks = list(reversed(TASKS))
+        for query in ["", "   ", "\t\n"]:
+            with self.subTest(query=query):
+                self.assertEqual(search(reversed_tasks, query), reversed_tasks)
+
+    def test_bare_word_is_case_insensitive_substring_of_title(self):
+        self.assertEqual(titles("REPORT"), ["Write report"])
+
+    def test_terms_must_all_match(self):
+        self.assertEqual(titles("buy   milk"), ["buy milk"])
+        self.assertEqual(titles("login buy"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles('"fix login"'), ["Fix login page"])
+        self.assertEqual(titles('"login fix"'), ["login fix notes"])
+
+    def test_quoted_phrase_is_never_a_field(self):
+        tasks = [Task(1, "status:open is text")]
+        self.assertEqual(titles('"status:open"', tasks), ["status:open is text"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles("tag:work"), ["Write report", "Fix login page"])
+        self.assertEqual(titles("tag:WORK"), ["Write report", "Fix login page"])
+        self.assertEqual(titles("tag:ork"), [])
+
+    def test_tag_with_spaces_uses_quotes(self):
+        self.assertEqual(titles('tag:"big task"'), ["Fix login page"])
+
+    def test_status_matches_on_status(self):
+        self.assertEqual(titles("status:open"), ["Write report", "buy milk"])
+        self.assertEqual(titles("STATUS:Done"), ["Fix login page", "login fix notes"])
+
+    def test_field_and_word_combine_with_and(self):
+        self.assertEqual(titles("tag:work status:done"), ["Fix login page"])
+
+    def test_unknown_field_is_rejected(self):
+        for query in ["due:today", "foo:bar", "tag:work due:today"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(TASKS, query)
+
+    def test_unknown_status_and_empty_tag_are_rejected(self):
+        for query in ["status:pending", "status:", "tag:"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(TASKS, query)
+
+    def test_unterminated_quote_is_rejected(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, '"fix login')
+
+
+if __name__ == "__main__":
+    unittest.main()
