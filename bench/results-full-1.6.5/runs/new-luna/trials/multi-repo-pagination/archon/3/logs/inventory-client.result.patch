+test('follows cursors and preserves item order', async () => {
+  const requests = [];
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'opaque cursor/+=' },
+    { items: [ITEMS[1]], next_cursor: null },
+  ];
+  const transport = async (request) => {
+    requests.push(request);
+    return { status: 200, body: pages.shift() };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(requests.map(({ query }) => query), [
+    {},
+    { cursor: 'opaque cursor/+=' },
+  ]);
+});
+
+test('stops when next_cursor is absent', async () => {
+  const transport = async () => ({ status: 200, body: { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
