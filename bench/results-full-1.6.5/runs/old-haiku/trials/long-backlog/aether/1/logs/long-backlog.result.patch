--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,45 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_plain_rows_use_crlf_and_are_not_quoted(self):
+        store = TaskStore()
+        store.add("plain title", tags=["a", "b"], due=date(2026, 4, 1))
+        store.add("no extras")
+        store.complete(2)
+        self.assertEqual(
+            to_csv(store.all()),
+            f"{HEADER}\r\n1,plain title,a;b,open,2026-04-01\r\n2,no extras,,done,\r\n",
+        )
+
+    def test_comma_quote_and_newlines_are_quoted(self):
+        store = TaskStore()
+        store.add('say "hi", then\nleave\rnow')
+        store.add("tags", tags=["x,y", 'q"r'])
+        self.assertEqual(
+            to_csv(store.all()),
+            f'{HEADER}\r\n1,"say ""hi"", then\nleave\rnow",,open,\r\n'
+            '2,tags,"x,y;q""r",open,\r\n',
+        )
+
+    def test_rows_keep_given_order(self):
+        store = TaskStore()
+        store.add("first")
+        store.add("second")
+        tasks = list(reversed(store.all()))
+        lines = to_csv(tasks).split("\r\n")
+        self.assertEqual(lines[1].split(",")[0], "2")
+        self.assertEqual(lines[2].split(",")[0], "1")
+
+
+if __name__ == "__main__":
+    unittest.main()
