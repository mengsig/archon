@@ -0,0 +1,62 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_header_and_row_order(self):
+        tasks = [Task(2, "second"), Task(1, "first")]
+        self.assertEqual(to_csv(tasks), f"{HEADER}\r\n2,second,,open,\r\n1,first,,open,\r\n")
+
+    def test_empty_task_list_has_only_header(self):
+        self.assertEqual(to_csv([]), f"{HEADER}\r\n")
+
+    def test_tags_joined_with_semicolon_and_not_quoted(self):
+        task = Task(1, "t", tags=["work", "home"])
+        self.assertEqual(to_csv([task]).split("\r\n")[1], "1,t,work;home,open,")
+
+    def test_due_date_is_iso_or_empty(self):
+        dated = Task(1, "t", due=date(2026, 4, 1))
+        self.assertEqual(to_csv([dated]).split("\r\n")[1], "1,t,,open,2026-04-01")
+
+    def test_status_is_written(self):
+        task = Task(1, "t", status=DONE)
+        self.assertEqual(to_csv([task]).split("\r\n")[1], "1,t,,done,")
+
+    def test_comma_in_title_is_quoted(self):
+        task = Task(1, "milk, eggs")
+        self.assertEqual(to_csv([task]).split("\r\n")[1], '1,"milk, eggs",,open,')
+
+    def test_double_quote_is_quoted_and_doubled(self):
+        task = Task(1, 'say "hi"')
+        self.assertEqual(to_csv([task]).split("\r\n")[1], '1,"say ""hi""",,open,')
+
+    def test_lf_in_title_is_quoted(self):
+        task = Task(1, "line1\nline2")
+        self.assertEqual(to_csv([task]), f'{HEADER}\r\n1,"line1\nline2",,open,\r\n')
+
+    def test_cr_in_title_is_quoted(self):
+        task = Task(1, "a\rb")
+        self.assertEqual(to_csv([task]), f'{HEADER}\r\n1,"a\rb",,open,\r\n')
+
+    def test_comma_in_tag_quotes_the_joined_tags_field(self):
+        task = Task(1, "t", tags=["a,b", "c"])
+        self.assertEqual(to_csv([task]).split("\r\n")[1], '1,t,"a,b;c",open,')
+
+    def test_other_fields_are_not_quoted(self):
+        task = Task(1, "plain title; with spaces", tags=["x"])
+        self.assertEqual(to_csv([task]).split("\r\n")[1], "1,plain title; with spaces,x,open,")
+
+    def test_every_line_ends_with_crlf(self):
+        tasks = [Task(1, "a,b"), Task(2, "c")]
+        output = to_csv(tasks)
+        self.assertEqual(output, f'{HEADER}\r\n1,"a,b",,open,\r\n2,c,,open,\r\n')
+        self.assertNotIn("\n", output.replace("\r\n", ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
