index 6825096..e20537c 100644
--- a/client.js
+++ b/client.js
@@ -12,10 +12,34 @@ async function request(transport, path, query = {}) {
 }
 
 async function listItems(transport) {
-  const body = await request(transport, '/items');
+  const items = [];
+  const seenCursors = new Set();
+  let cursor = null;
+  do {
+    const body = await request(transport, '/items', cursor === null ? {} : { cursor });
+    items.push(...pageItems(body));
+    cursor = nextCursor(body, seenCursors);
+  } while (cursor !== null);
+  return items;
+}
+
+function pageItems(body) {
+  if (!body || !Array.isArray(body.items)) {
+    throw new Error('GET /items: response has no items array');
+  }
   return body.items;
 }
 
+function nextCursor(body, seenCursors) {
+  const next = body.next_cursor ?? null;
+  if (next === null) return null;
+  if (typeof next !== 'string' || seenCursors.has(next)) {
+    throw new Error(`GET /items: unusable next_cursor ${JSON.stringify(next)}`);
+  }
+  seenCursors.add(next);
+  return next;
+}
+
 async function getItem(transport, id) {
   return request(transport, `/items/${id}`);
 }
