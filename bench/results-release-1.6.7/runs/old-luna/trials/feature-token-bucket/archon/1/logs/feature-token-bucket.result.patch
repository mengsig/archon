 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _validate_request(n, capacity):
+    if n <= 0 or n > capacity:
+        raise ValueError("n must be greater than zero and no greater than capacity")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        if capacity <= 0:
+            raise ValueError("capacity must be greater than zero")
+        if refill_per_sec <= 0:
+            raise ValueError("refill_per_sec must be greater than zero")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.clock = clock
+        self._tokens = capacity
+        self._updated_at = clock()
+
+    def _refill(self):
+        now = self.clock()
+        if now > self._updated_at:
+            self._tokens = min(
+                self.capacity,
+                self._tokens + (now - self._updated_at) * self.refill_per_sec,
+            )
+            self._updated_at = now
+        return self._tokens
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        if self._refill() >= n:
+            self._tokens -= n
+            return True
+        return False
 
     def available(self):
-        raise NotImplementedError
+        return self._refill()
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        tokens = self._refill()
+        return max(0.0, (n - tokens) / self.refill_per_sec)
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        if max_keys < 1:
+            raise ValueError("max_keys must be at least one")
+        # Validate shared bucket parameters even before a key is requested.
+        if capacity <= 0:
+            raise ValueError("capacity must be greater than zero")
+        if refill_per_sec <= 0:
+            raise ValueError("refill_per_sec must be greater than zero")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
+        self.clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket_for(self, key):
+        if key in self._buckets:
+            self._buckets.move_to_end(key)
+            return self._buckets[key]
+        if len(self._buckets) >= self.max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self.capacity, self.refill_per_sec, clock=self.clock)
+        self._buckets[key] = bucket
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        return self._bucket_for(key).wait_time(n)
 
