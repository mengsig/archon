+// pages maps a cursor (or 'first' for the no-cursor request) to a response body.
+function pagedTransport(pages) {
+  const queries = [];
+  const transport = async (request) => {
+    queries.push(request.query);
+    const key = request.query.cursor === undefined ? 'first' : request.query.cursor;
+    if (!(key in pages)) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: pages[key] };
+  };
+  return { transport, queries };
+}
