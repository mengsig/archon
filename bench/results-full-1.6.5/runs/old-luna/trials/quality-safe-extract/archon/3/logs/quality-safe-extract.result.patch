--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,77 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
 
-def extract(entries, root):
-    raise NotImplementedError
+
+def _valid_name(name):
+    if not name or name.startswith("/") or "\\" in name or ":" in name or "\0" in name:
+        return False
+    return all(part not in ("", ".", "..") for part in name.split("/"))
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a path to an existing directory")
+    path = Path(root)
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        raise ValueError("root must be an existing directory") from None
+    except NotADirectoryError:
+        raise ValueError("root must be an existing directory") from None
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
+        raise ValueError("root must be a real directory")
+    return path
+
+
+def _validate_destination(root, name):
+    current = root
+    parts = name.split("/")
+    for part in parts:
+        current = current / part
+        try:
+            info = current.lstat()
+        except FileNotFoundError:
+            continue
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError("destination contains a symlink")
+        if current == root.joinpath(*parts):
+            raise ValueError("destination already exists")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError("destination parent is not a directory")
+
+
+def extract(entries, root) -> list[str]:
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    paths = _validate_root(root)
+    names = []
+    seen = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must contain a name and data")
+        name, data = entry
+        if not isinstance(name, str) or not _valid_name(name):
+            raise ValueError("invalid entry name")
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in seen:
+            raise ValueError("duplicate entry name")
+        seen.add(name)
+        names.append(name)
+
+    for name in names:
+        components = name.split("/")
+        if any("/".join(components[:i]) in seen for i in range(1, len(components))):
+            raise ValueError("file and directory collision")
+    for name in names:
+        _validate_destination(paths, name)
+
+    for name, data in entries:
+        destination = paths.joinpath(*name.split("/"))
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        with destination.open("xb") as output:
+            output.write(data)
+    return names
