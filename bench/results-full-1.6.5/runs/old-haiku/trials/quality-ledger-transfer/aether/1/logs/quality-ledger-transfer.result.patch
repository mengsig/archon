+from ledger import MAX_BALANCE, Ledger
+
+
+class LedgerConstruction(unittest.TestCase):
+    def test_empty_ledger_allowed(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_rejects_non_dict(self):
+        for bad in [None, [("a", 1)], "ab"]:
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                Ledger(bad)
+
+    def test_rejects_invalid_names(self):
+        for bad in [{"": 1}, {1: 1}, {None: 1}, {b"a": 1}]:
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                Ledger(bad)
+
+    def test_rejects_invalid_balances(self):
+        for bad in [-1, MAX_BALANCE + 1, 1.0, "1", None, True, False]:
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                Ledger({"a": bad})
+
+    def test_accepts_boundary_balances(self):
+        ledger = Ledger({"lo": 0, "hi": MAX_BALANCE})
+        self.assertEqual(ledger.snapshot(), {"lo": 0, "hi": MAX_BALANCE})
+
+    def test_copies_input(self):
+        source = {"a": 5}
+        ledger = Ledger(source)
+        source["a"] = 999
+        source["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_snapshot_does_not_alias_state(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        snap = ledger.snapshot()
+        snap["a"] = 999
+        snap["c"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": 0})
+
+
+class LedgerTransferValidation(unittest.TestCase):
+    def setUp(self):
+        self.ledger = Ledger({"a": 10, "b": 10})
+
+    def test_rejects_invalid_amounts(self):
+        for bad in [0, -1, MAX_BALANCE + 1, 1.0, "1", None, True]:
+            with self.subTest(bad=bad), self.assertRaises(ValueError):
+                self.ledger.transfer("a", "b", bad)
+        self.assertEqual(self.ledger.snapshot(), {"a": 10, "b": 10})
+
+    def test_amount_validated_before_accounts(self):
+        with self.assertRaises(ValueError):
+            self.ledger.transfer("missing", "missing", 0)
+
+    def test_unknown_source_raises_key_error(self):
+        with self.assertRaises(KeyError):
+            self.ledger.transfer("x", "b", 1)
+
+    def test_unknown_destination_raises_key_error(self):
+        with self.assertRaises(KeyError):
+            self.ledger.transfer("a", "x", 1)
+
+    def test_non_string_account_raises_key_error(self):
+        with self.assertRaises(KeyError):
+            self.ledger.transfer(["a"], "b", 1)
+        self.assertEqual(self.ledger.snapshot(), {"a": 10, "b": 10})
+
+    def test_accounts_cannot_be_created(self):
+        with self.assertRaises(KeyError):
+            self.ledger.transfer("a", "new", 1)
+        self.assertNotIn("new", self.ledger.snapshot())
+
+
+class LedgerTransferSemantics(unittest.TestCase):
+    def test_exact_balance_transfer_succeeds(self):
+        ledger = Ledger({"a": 3, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 3), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 3})
+
+    def test_destination_overflow_fails_unchanged(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE})
+
+    def test_destination_filled_to_exact_max_succeeds(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 5})
+        self.assertIs(ledger.transfer("a", "b", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+    def test_insufficient_funds_checked_before_overflow(self):
+        ledger = Ledger({"a": 1, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 2), False)
+        self.assertEqual(ledger.snapshot(), {"a": 1, "b": MAX_BALANCE})
+
+    def test_total_preserved(self):
+        ledger = Ledger({"a": 7, "b": 4, "c": 9})
+        for src, dst, amt in [("a", "b", 3), ("c", "a", 9), ("b", "c", 1)]:
+            ledger.transfer(src, dst, amt)
+        self.assertEqual(sum(ledger.snapshot().values()), 20)
+
+    def test_self_transfer_with_funds_returns_true_unchanged(self):
+        ledger = Ledger({"a": 5})
+        self.assertIs(ledger.transfer("a", "a", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_self_transfer_without_funds_returns_false(self):
+        ledger = Ledger({"a": 4})
+        self.assertIs(ledger.transfer("a", "a", 5), False)
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_self_transfer_at_max_balance_is_unchanged(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+
