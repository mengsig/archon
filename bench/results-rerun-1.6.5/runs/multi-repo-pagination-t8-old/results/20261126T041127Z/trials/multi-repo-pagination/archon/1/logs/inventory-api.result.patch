 elsewhere.
 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_DIGITS = re.compile(r"[0-9]{1,18}")
+
+
+class BadRequest(Exception):
+    """Invalid client input; reported to the caller as HTTP 400."""
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -14,15 +25,56 @@ def handle(request):
     path = request.get("path", "")
     query = request.get("query") or {}
     if path == "/items":
-        return list_items(query)
+        try:
+            return list_items(query)
+        except BadRequest as exc:
+            return _error(400, str(exc))
     if path.startswith("/items/"):
         return get_item(path.removeprefix("/items/"))
     return _error(404, "not found")
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = parse_limit(query.get("limit"))
+    after_id = parse_cursor(query.get("cursor"))
+    candidates = sorted(ITEMS, key=lambda item: item["id"])
+    if after_id is not None:
+        candidates = [item for item in candidates if item["id"] > after_id]
+    page = candidates[:limit]
+    next_cursor = encode_cursor(page[-1]["id"]) if len(candidates) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not isinstance(raw, str) or not _DIGITS.fullmatch(raw):
+        raise BadRequest("limit must be an integer")
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        raise BadRequest(f"limit must be between 1 and {MAX_LIMIT}")
+    return limit
+
+
+def encode_cursor(item_id):
+    assert isinstance(item_id, int)
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def parse_cursor(raw):
+    """Return the id the page starts after, or None for the first page."""
+    if raw is None:
+        return None
+    if not isinstance(raw, str):
+        raise BadRequest("cursor is invalid")
+    try:
+        decoded = base64.b64decode(raw.encode("ascii"), altchars=b"-_", validate=True)
+    except ValueError as exc:
+        raise BadRequest("cursor is invalid") from exc
+    text = decoded.decode("ascii", errors="replace")
+    if not _DIGITS.fullmatch(text):
+        raise BadRequest("cursor is invalid")
+    return int(text)
 
 
