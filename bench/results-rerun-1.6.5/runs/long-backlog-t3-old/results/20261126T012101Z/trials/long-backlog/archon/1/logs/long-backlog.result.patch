diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..726da79
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,49 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def assertRejected(self, text):
+        with self.assertRaises(InvalidDate) as ctx:
+            parse_due(text, TODAY)
+        self.assertIn(text, str(ctx.exception))
+
+    def test_invalid_date_is_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+    def test_impossible_calendar_dates_are_rejected(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                self.assertRejected(text)
+
+    def test_real_calendar_dates_are_accepted(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+        self.assertEqual(parse_due("2026-02-28", TODAY), date(2026, 2, 28))
+        self.assertEqual(parse_due("2026-12-31", TODAY), date(2026, 12, 31))
+
+    def test_unsupported_forms_are_rejected(self):
+        for text in ["", "   ", "soon", "2026-3-1", "2026/03/01", "-3d", "3d", "+d", "+1.5d"]:
+            with self.subTest(text=text):
+                self.assertRejected(text)
+
+    def test_offsets_are_relative_to_today(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+1d", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("+365d", TODAY), date(2027, 3, 10))
+
+    def test_offset_past_max_date_is_rejected(self):
+        self.assertRejected("+99999999d")
+        self.assertRejected("+9999999999999999999999999d")
+
+    def test_keywords_are_case_and_space_insensitive(self):
+        self.assertEqual(parse_due("  TODAY ", TODAY), TODAY)
+        self.assertEqual(parse_due("Tomorrow", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due(" +5D ", TODAY), date(2026, 3, 15))
+
+
+if __name__ == "__main__":
+    unittest.main()
