+        "March 1\tgroceries\t1",
+        "2026-03-01\t\t1",
+        "2026-03-01\tgroceries\t1.234",
+    ];
+    for line in bad {
+        let err = parse_line(line).unwrap_err();
+        assert!(matches!(err, LineError::Malformed(_)), "{line:?}: {err:?}");
+        assert_eq!(err.exit_code(), 1, "{line:?}");
+    }
+}
