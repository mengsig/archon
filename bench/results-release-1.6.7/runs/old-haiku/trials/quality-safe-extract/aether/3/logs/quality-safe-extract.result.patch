+class ConflictValidation(TempRootCase):
+    def test_existing_file_target_not_overwritten(self):
+        (self.root / "a").write_bytes(b"old")
+        with self.assertRaises(ValueError):
+            extract([("b", b"new"), ("a", b"new")], self.root)
+        self.assertEqual((self.root / "a").read_bytes(), b"old")
+        self.assertEqual(snapshot(self.root), ["a"])
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"x")], self.root)
+        self.assertEqual(snapshot(self.root), ["d"])
+
+    def test_file_as_parent_rejected(self):
+        (self.root / "a").write_bytes(b"old")
+        with self.assertRaises(ValueError):
+            extract([("a/b", b"x")], self.root)
+        self.assertEqual(snapshot(self.root), ["a"])
+
+    def test_symlink_parent_inside_root_rejected(self):
