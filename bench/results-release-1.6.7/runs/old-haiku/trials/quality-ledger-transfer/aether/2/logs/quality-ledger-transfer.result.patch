+    def test_destination_overflow_returns_false_and_changes_nothing(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 1})
+        self.assertIs(ledger.transfer("a", "b", 2), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE - 1})
