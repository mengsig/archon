+class TokenBucketEdgeTest(unittest.TestCase):
+    def test_invalid_capacity_or_rate_raises(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0), (float("nan"), 1.0)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_request_size_raises(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_invalid_request_consumes_nothing(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            bucket.try_acquire(3)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_failed_acquire_removes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertFalse(bucket.try_acquire())
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_wait_time_is_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_time_predicts_next_success(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        clock.now = 1.5
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_waiting_exactly_wait_time_always_succeeds(self):
+        rng = random.Random(1)
+        for _ in range(2000):
+            clock = FakeClock()
+            capacity = rng.uniform(0.5, 50)
+            bucket = TokenBucket(capacity, rng.uniform(0.01, 30), clock=clock)
+            bucket.try_acquire(capacity)
+            n = rng.uniform(0.001, capacity)
+            clock.now += bucket.wait_time(n)
+            self.assertTrue(bucket.try_acquire(n), (capacity, n))
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        bucket.wait_time(1)
+        clock.now = 1.0
+        self.assertEqual(bucket.wait_time(1), 0.0)
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        bucket.available()
+        clock.now = 0.0
+        self.assertEqual(bucket.available(), 1.0)
+        clock.now = 1.5
+        self.assertEqual(bucket.available(), 1.5)
+
+    def test_nan_clock_raises(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        clock.now = float("nan")
+        with self.assertRaises(ValueError):
+            bucket.available()
+
