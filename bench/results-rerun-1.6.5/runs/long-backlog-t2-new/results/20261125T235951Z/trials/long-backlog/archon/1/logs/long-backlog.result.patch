@@ -0,0 +1,77 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_empty_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task_and_never_reuses_id(self):
+        store = TaskStore()
+        a = store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        b = store.add("second")
+        self.assertEqual(b.id, a.id + 1)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+
+    def test_undo_delete_restores_task_exactly(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["work"], due=None)
+        store.complete(a.id)
+        before = store.get(a.id)
+        snapshot = (before.id, before.title, list(before.tags), before.status, before.due)
+        store.delete(a.id)
+        store.undo()
+        restored = store.get(a.id)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status, restored.due), snapshot)
+
+    def test_undo_delete_restores_snapshot_not_later_mutation(self):
+        store = TaskStore()
+        a = store.add("keep", tags=["x"])
+        returned = store.delete(a.id)
+        returned.tags.append("mutated")
+        store.undo()
+        self.assertEqual(store.get(a.id).tags, ["x"])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertIn(b.id, [t.id for t in store.all()])
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
