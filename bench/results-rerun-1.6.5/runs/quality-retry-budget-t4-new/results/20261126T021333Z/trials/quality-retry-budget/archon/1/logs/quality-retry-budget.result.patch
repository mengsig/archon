diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..c64d76a 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,47 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms):
+    _check_int("attempt", attempt, 1)
+    _check_int("max_attempts", max_attempts, 1)
+    _check_int("elapsed_ms", elapsed_ms, 0)
+    _check_int("budget_ms", budget_ms, 0)
+    _check_int("base_ms", base_ms, 0)
+    _check_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, 0)
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    if base_ms >= cap_ms:
+        return cap_ms
+    # base_ms < cap_ms: once the shift reaches cap_ms's bit length the
+    # result already exceeds cap_ms, so larger shifts add nothing.
+    shift = min(attempt - 1, cap_ms.bit_length())
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return ms to wait before the next attempt, or None if none may start."""
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..04ce91a 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,145 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.5)
+
+    def test_rejects_non_int_types(self):
+        with self.assertRaises(ValueError):
+            retry_delay("1", 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, None)
+
+    def test_attempt_and_max_attempts_at_least_one(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(-1, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_negative_values_rejected(self):
+        cases = [
+            (lambda: retry_delay(1, -1), "elapsed_ms"),
+            (lambda: retry_delay(1, 0, budget_ms=-1), "budget_ms"),
+            (lambda: retry_delay(1, 0, base_ms=-1), "base_ms"),
+            (lambda: retry_delay(1, 0, cap_ms=-1), "cap_ms"),
+            (lambda: retry_delay(1, 0, retry_after_ms=-1), "retry_after_ms"),
+        ]
+        for call, name in cases:
+            with self.subTest(name=name):
+                with self.assertRaisesRegex(ValueError, name):
+                    call()
+
+    def test_zero_is_valid_for_non_attempt_values(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=1, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0, base_ms=0), 0)
+
+    def test_validation_runs_before_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=2, budget_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 2000, max_attempts=4, retry_after_ms=-3)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_last_allowed_attempt_still_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_is_legal_and_returns_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(10**30, 0, max_attempts=10**29))
+
+
+class Backoff(unittest.TestCase):
+    def test_cap_limits_backoff(self):
+        self.assertEqual(
+            retry_delay(5, 0, max_attempts=10, budget_ms=10**6), 400)
+
+    def test_zero_base_gives_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0, budget_ms=10), 0)
+
+    def test_zero_cap_gives_zero_backoff(self):
+        self.assertEqual(retry_delay(2, 0, cap_ms=0, budget_ms=10), 0)
+
+    def test_base_above_cap_returns_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=300), 300)
+
+    def test_huge_attempt_saturates_without_big_intermediate(self):
+        delay = retry_delay(10**18, 0, max_attempts=10**19, budget_ms=10**20,
+                            base_ms=1, cap_ms=400)
+        self.assertEqual(delay, 400)
+
+    def test_huge_base_and_cap_do_not_overflow(self):
+        big = 10**100
+        self.assertEqual(
+            retry_delay(3, 0, base_ms=big, cap_ms=big + 1, budget_ms=2 * big),
+            big + 1)
+
+    def test_backoff_doubles_until_cap(self):
+        delays = [retry_delay(a, 0, base_ms=3, cap_ms=50, max_attempts=99,
+                              budget_ms=10**6) for a in range(1, 8)]
+        self.assertEqual(delays, [3, 6, 12, 24, 48, 50, 50])
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_floor_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=50, retry_after_ms=300, budget_ms=1000),
+            300)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+    def test_retry_after_equal_to_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=100), 100)
+
+    def test_retry_after_over_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+
+class Budget(unittest.TestCase):
+    def test_end_exactly_at_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_end_one_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_wait_is_never_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(1, 950, budget_ms=1000))
+
+    def test_zero_delay_allowed_when_elapsed_under_budget(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_rejected_when_elapsed_reaches_budget(self):
+        self.assertIsNone(retry_delay(1, 1, base_ms=0, budget_ms=1))
+
+    def test_zero_budget_allows_nothing(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_no_integer_upper_limit(self):
+        self.assertEqual(
+            retry_delay(1, 10**40, budget_ms=10**41, base_ms=10**40,
+                        cap_ms=10**41),
+            10**40)
+
+
+if __name__ == "__main__":
+    unittest.main()
