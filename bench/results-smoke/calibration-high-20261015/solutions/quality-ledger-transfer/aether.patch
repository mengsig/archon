 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _is_valid_balance(value):
+    # type() check rejects bool and int subclasses
+    return type(value) is int and 0 <= value <= MAX_BALANCE
+
+
+def _is_valid_amount(value):
+    return type(value) is int and 1 <= value <= MAX_BALANCE
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError(f"balances must be a dict, got {type(balances).__name__}")
+        copied = {}
+        for name, balance in balances.items():
+            if not isinstance(name, str) or not name:
+                raise ValueError(f"invalid account name: {name!r}")
+            if not _is_valid_balance(balance):
+                raise ValueError(f"invalid balance for {name!r}: {balance!r}")
+            copied[name] = balance
+        self._balances = copied
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        if not _is_valid_amount(amount):
+            raise ValueError(f"invalid amount: {amount!r}")
+        with self._lock:
+            source_balance = self._balances[source]
+            destination_balance = self._balances[destination]
+            if source == destination:
+                # no-op; skip overflow check, which would fail at MAX_BALANCE
+                return source_balance >= amount
+            if source_balance < amount:
+                return False
+            if destination_balance + amount > MAX_BALANCE:
+                return False
+            self._balances[source] = source_balance - amount
+            self._balances[destination] = destination_balance + amount
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
