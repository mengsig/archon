@@ -0,0 +1,57 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_rows_keep_input_order_and_use_crlf(self):
+        store = TaskStore()
+        first = store.add("first")
+        second = store.add("second")
+        store.complete(first.id)
+        expected = f"{HEADER}\r\n2,second,,open,\r\n1,first,,done,\r\n"
+        self.assertEqual(to_csv([second, first]), expected)
+
+    def test_tags_and_due_date(self):
+        store = TaskStore()
+        store.add("plain title", tags=["a", "b"], due=date(2026, 4, 1))
+        self.assertEqual(to_csv(store.all()), f"{HEADER}\r\n1,plain title,a;b,open,2026-04-01\r\n")
+
+    def test_comma_in_title_is_quoted(self):
+        store = TaskStore()
+        store.add("buy milk, eggs")
+        self.assertIn('1,"buy milk, eggs",,open,\r\n', to_csv(store.all()))
+
+    def test_quotes_are_doubled_and_wrapped(self):
+        store = TaskStore()
+        store.add('say "hi"')
+        self.assertIn('1,"say ""hi""",,open,\r\n', to_csv(store.all()))
+
+    def test_newlines_are_quoted(self):
+        store = TaskStore()
+        store.add("line one\nline two")
+        store.add("carriage\rreturn")
+        out = to_csv(store.all())
+        self.assertIn('1,"line one\nline two",,open,\r\n', out)
+        self.assertIn('2,"carriage\rreturn",,open,\r\n', out)
+
+    def test_tag_containing_comma_quotes_the_tags_field(self):
+        store = TaskStore()
+        store.add("t", tags=["x,y", "z"])
+        self.assertIn('1,t,"x,y;z",open,\r\n', to_csv(store.all()))
+
+    def test_plain_fields_are_not_quoted(self):
+        store = TaskStore()
+        store.add("spaces are fine", tags=["work"])
+        self.assertEqual(to_csv(store.all()).split("\r\n")[1], "1,spaces are fine,work,open,")
+
+
+if __name__ == "__main__":
+    unittest.main()
