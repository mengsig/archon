@@ -32,6 +32,70 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_and_wait_time_do_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertEqual(bucket.wait_time(1), 0.5)
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(1), 0.25)
+
+    def test_tokens_are_capped_and_backward_clock_does_not_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 3
+        self.assertEqual(bucket.available(), 2)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 2
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 3
+        self.assertEqual(bucket.available(), 0)
+
+    def test_bucket_validation(self):
+        for capacity, rate in ((0, 1), (-1, 1), (1, 0), (1, -1)):
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate)
+        bucket = TokenBucket(2, 1, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_lru_eviction_and_wait_time_count_as_use(self):
+        limiter = KeyedLimiter(1, 1, max_keys=2, clock=FakeClock())
+        self.assertEqual(limiter.wait_time("a"), 0)
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # Makes a most recently used.
+        limiter.try_acquire("c")  # Evicts b.
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # Evicted keys start full.
+
+    def test_invalid_keyed_request_does_not_evict(self):
+        limiter = KeyedLimiter(1, 1, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertEqual(len(limiter), 1)
+
+    def test_keyed_limiter_validation(self):
+        for args in ((1, 1, 0), (0, 1, 1), (1, 0, 1)):
+            with self.subTest(args=args):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(*args)
+
+    def test_fractional_max_keys_is_still_a_hard_limit(self):
+        limiter = KeyedLimiter(1, 1, max_keys=1.5, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertEqual(len(limiter), 1)
+
 
 if __name__ == "__main__":
     unittest.main()
