-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+CSV without a `currency` column (the pre-currency ledger export) counts as USD.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
+EXIT_BAD_CURRENCY = 2
+
+
+class BadCurrency(ValueError):
+    pass
+
+
+def currency_of(row, line_num):
+    """The row's currency code, or USD when the input has no currency column."""
+    code = row.get("currency", DEFAULT_CURRENCY)
+    if code is None or not CURRENCY_PATTERN.fullmatch(code):
+        raise BadCurrency(f"line {line_num}: bad currency {code!r}")
+    return code
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(reader):
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        key = (row["account"], currency_of(row, reader.line_num))
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        report = render(totals(csv.DictReader(sys.stdin)))
+    except BadCurrency as error:
+        print(f"error: {error}", file=sys.stderr)
+        return EXIT_BAD_CURRENCY
+    sys.stdout.write(report)
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
