-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+A CSV without a currency column (older exports) counts as USD.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+
+class BadCurrency(ValueError):
+    pass
+
+
+def currency_of(row):
+    """Currency of a CSV dict row; rows without a currency column are USD."""
+    if "currency" not in row:
+        return DEFAULT_CURRENCY
+    currency = row["currency"]
+    if currency is None or not CURRENCY_PATTERN.fullmatch(currency):
+        raise BadCurrency(f"bad currency {currency!r}")
+    return currency
+
+
+def totals(reader):
+    """{(account, currency): total_cents} from a csv.DictReader."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        try:
+            key = (row["account"], currency_of(row))
+        except BadCurrency as e:
+            raise BadCurrency(f"line {reader.line_num}: {e}") from e
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for key in sorted(result):
+        account, currency = key
+        lines.append(f"{account},{currency},{result[key]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(csv.DictReader(sys.stdin))
+    except BadCurrency as e:
+        print(f"error: {e}", file=sys.stderr)
+        return 2
+    sys.stdout.write(render(result))
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
