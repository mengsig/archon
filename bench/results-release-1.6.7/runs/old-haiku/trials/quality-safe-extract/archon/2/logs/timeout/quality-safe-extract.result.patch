-"""Extract validated regular-file entries. See SPEC.md."""
+"""Extract validated regular-file entries; see SPEC.md. Roots with '..' are rejected.
+Out of scope: concurrent root changes, case-only collisions, partial output after I/O errors.
+"""
+
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\x00")
+_MAX_COMPONENT_BYTES = 255
 
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, got {type(entries).__name__}")
+    root_path = _checked_root(root)
+    validated = _validate_entries(entries)
+    _check_targets(root_path, [name for name, _ in validated])
+    for name, data in validated:
+        _create_file(root_path, name, data)
+    return [name for name, _ in validated]
+
+
+def _checked_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty str or pathlib.Path, got {root!r}")
+    root_path = Path(root)
+    if ".." in root_path.parts:
+        raise ValueError(f"root must not contain '..' components: {root_path}")
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root_path}") from exc
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be a real directory, not a symlink or file: {root_path}")
+    return root_path
+
+
+def _validate_entries(entries):
+    validated = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError(f"entry {index} must be a (name, data) tuple")
+        name, data = entry
+        _validate_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError(f"data for {name!r} must be bytes, got {type(data).__name__}")
+        validated.append((name, data))
+    _validate_name_conflicts([name for name, _ in validated])
+    return validated
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, got {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"entry name has an empty, '.' or '..' component: {name!r}")
+    _validate_component_sizes(name, parts)
+
+
+def _validate_component_sizes(name, parts):
+    try:
+        encoded_parts = [part.encode("utf-8") for part in parts]
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not valid Unicode text: {name!r}") from exc
+    if any(len(part) > _MAX_COMPONENT_BYTES for part in encoded_parts):
+        raise ValueError(f"entry name has a component over {_MAX_COMPONENT_BYTES} bytes: {name!r}")
+
+
+def _validate_name_conflicts(names):
+    unique = set()
+    for name in names:
+        if name in unique:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        unique.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in unique:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in the batch")
+
+
+def _check_targets(root, names):
+    checked_dirs = set()
+    for name in names:
+        _check_target(root, name, checked_dirs)
+
+
+def _check_target(root, name, checked_dirs):
+    parts = name.split("/")
+    assert parts[-1], "names are validated before filesystem checks"
+    for depth in range(1, len(parts)):
+        ancestor = root.joinpath(*parts[:depth])
+        if ancestor in checked_dirs:
+            continue
+        info = _lstat_or_none(ancestor)
+        if info is None:
+            # An absent ancestor means the target is absent too.
+            return
+        if not stat.S_ISDIR(info.st_mode):
+            ancestor_name = "/".join(parts[:depth])
+            raise ValueError(
+                f"{name!r}: ancestor {ancestor_name!r} is a symlink or not a directory"
+            )
+        checked_dirs.add(ancestor)
+    if _lstat_or_none(root / name) is not None:
+        raise ValueError(f"target already exists: {name!r}")
+
+
+def _create_file(root, name, data):
+    path = root / name
+    os.makedirs(path.parent, exist_ok=True)
+    with open(path, "xb") as handle:
+        handle.write(data)
+    assert stat.S_ISREG(os.lstat(path).st_mode), f"{name!r} was not created as a regular file"
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
