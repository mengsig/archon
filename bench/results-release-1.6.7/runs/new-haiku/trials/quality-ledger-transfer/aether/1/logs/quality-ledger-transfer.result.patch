+class LedgerTransfer(unittest.TestCase):
+    def test_exact_balance_moves_completely(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 5})
+
+    def test_invalid_amounts_are_rejected_without_changes(self):
+        ledger = Ledger({"a": 5, "b": 5})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0, "1", None):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("a", "b", amount)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": 5})
+
+    def test_amount_is_validated_before_accounts(self):
+        ledger = Ledger({"a": 5})
+        with self.assertRaises(ValueError):
+            ledger.transfer("missing", "also-missing", 0)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 5})
+        for source, destination in (("x", "a"), ("a", "x"), (None, "a"), ("a", ["a"])):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_destination_overflow_returns_false(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE})
+
+    def test_destination_filled_exactly_to_max(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": MAX_BALANCE - 1})
+        self.assertIs(ledger.transfer("a", "b", 1), True)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE - 1, "b": MAX_BALANCE})
+
+    def test_full_max_balance_transfers_out(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
