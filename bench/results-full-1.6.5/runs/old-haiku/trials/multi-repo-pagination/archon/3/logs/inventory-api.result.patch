diff --git a/test_api.py b/test_api.py
index 55cd1fd..003fe9d 100644
--- a/test_api.py
+++ b/test_api.py
@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,72 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20_with_next_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_multi_page_traversal_visits_every_item_once(self):
+        for limit in (1, 10, 20, 100):
+            ids = [item["id"] for item in walk_pages(limit)]
+            self.assertEqual(ids, list(range(1, 58)), f"limit={limit}")
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="10", cursor=encode(50))["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(51, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_fit_last_page_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_for_absent_id_starts_after_it(self):
+        body = get("/items", limit="3", cursor=encode(0))["body"]
+        self.assertEqual([item["id"] for item in body["items"]], [1, 2, 3])
+
+    def test_cursor_past_last_item_gives_empty_page(self):
+        body = get("/items", cursor=encode(999))["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        for limit in ("1", "100"):
+            self.assertEqual(get("/items", limit=limit)["status"], 200, limit)
+        for limit in ("0", "101", "-1", "1.5", "abc", "", " 5", "9" * 5000):
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        oversized = encode_raw(b"9" * 5000)
+        for cursor in ("", "!!!", "not-base64", encode_raw(b"abc"), encode_raw(b"\xff"), oversized):
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertEqual(res["body"], {"error": "cursor is invalid"})
+
+
+def encode(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def encode_raw(payload):
+    return base64.urlsafe_b64encode(payload).decode("ascii")
+
+
+def walk_pages(limit):
+    """Follow next_cursor from the first page until it is null."""
+    items, cursor = [], None
+    while True:
+        query = {"limit": str(limit)}
+        if cursor is not None:
+            query["cursor"] = cursor
+        res = get("/items", **query)
+        assert res["status"] == 200, res
+        items.extend(res["body"]["items"])
+        cursor = res["body"]["next_cursor"]
+        if cursor is None:
+            return items
+
 
 if __name__ == "__main__":
     unittest.main()
