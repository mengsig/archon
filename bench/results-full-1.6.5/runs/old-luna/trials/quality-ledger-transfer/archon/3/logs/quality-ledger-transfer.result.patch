+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation_and_copy(self):
+        for value in (None, [], {"": 0}, {1: 0}, {"a": True},
+                      {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                Ledger(value)
+
+        original = {"a": MAX_BALANCE}
+        ledger = Ledger(original)
+        original["a"] = 0
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_validated_before_accounts(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_and_failures_leave_state_unchanged(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        for source, destination in (("missing", "b"), ("a", "missing")):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        for source, destination in (([], "b"), ("a", [])):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        before = ledger.snapshot()
+        self.assertFalse(ledger.transfer("a", "b", 1))
+        self.assertFalse(ledger.transfer("a", "b", 6))
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_self_transfer_and_exact_boundaries(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 1, "c": MAX_BALANCE - 1})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertFalse(ledger.transfer("b", "b", 2))
+        self.assertTrue(ledger.transfer("b", "c", 1))
+        self.assertEqual(ledger.snapshot(), {
+            "a": MAX_BALANCE, "b": 0, "c": MAX_BALANCE,
+        })
+
+    def test_opposite_transfers_are_safe_across_threads(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        barrier = Barrier(3)
+        failures = []
+
+        def transfer(source, destination):
+            try:
+                barrier.wait()
+                for _ in range(1000):
+                    ledger.transfer(source, destination, 1)
+                    ledger.snapshot()
+            except BaseException as error:
+                failures.append(error)
+
+        threads = [
+            Thread(target=transfer, args=("a", "b"), daemon=True),
+            Thread(target=transfer, args=("b", "a"), daemon=True),
+        ]
+        for thread in threads:
+            thread.start()
+        barrier.wait()
+        for thread in threads:
+            thread.join(timeout=2)
+
+        self.assertFalse(any(thread.is_alive() for thread in threads), "transfer deadlocked")
+        self.assertEqual(failures, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
