diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..7f421a4 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,44 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms,
+              cap_ms, retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms,
+              cap_ms, retry_after_ms):
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # Once exponent >= cap_ms.bit_length(), base_ms * 2**exponent > cap_ms,
+    # so the power is only materialised when it is small.
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms * (1 << exponent))
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..b734ffe 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,98 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.0)
+
+    def test_rejects_below_minimum(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(10, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=2, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 2000, budget_ms=1000, retry_after_ms=-5)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+
+    def test_attempt_above_max_returns_none(self):
+        self.assertIsNone(retry_delay(100, 0, max_attempts=4))
+
+    def test_zero_base_yields_zero_delay(self):
+        self.assertEqual(retry_delay(5, 0, base_ms=0, max_attempts=10), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=30), 30)
+
+    def test_zero_cap_yields_zero_delay(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=200), 200)
+
+    def test_backoff_capped_at_cap(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, budget_ms=10**9,
+                                     cap_ms=300), 300)
+
+    def test_huge_attempt_saturates_without_big_power(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1,
+                        budget_ms=10**30), 400)
+
+    def test_huge_attempt_with_zero_cap_is_zero(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1, cap_ms=0,
+                        budget_ms=10**30), 0)
+
+    def test_exact_budget_boundary_is_rejected(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_inside_budget_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_at_exhausted_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_retry_after_floor_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=50, retry_after_ms=300,
+                                     budget_ms=10**6), 300)
+
+    def test_retry_after_does_not_shorten_wait_to_fit_budget(self):
+        self.assertIsNone(retry_delay(1, 800, retry_after_ms=250))
+        self.assertEqual(retry_delay(1, 700, retry_after_ms=250), 250)
+
+    def test_large_ints_accepted(self):
+        self.assertEqual(
+            retry_delay(1, 10**20, budget_ms=10**21, base_ms=10**19,
+                        cap_ms=10**19), 10**19)
