+++ b/tests/test_search.py
@@ -0,0 +1,77 @@
+import unittest
+
+from tasktracker.models import DONE, Task
+from tasktracker.search import QueryError, search
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login bug", tags=["Work"]),
+            Task(2, "buy milk", tags=["home"], status=DONE),
+            Task(3, "Fix the login page", tags=["work", "web"]),
+            Task(4, "write report"),
+        ]
+
+    def test_blank_query_matches_all_in_order(self):
+        self.assertEqual(titles(search(self.tasks, "")), titles(self.tasks))
+        self.assertEqual(titles(search(self.tasks, "   ")), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(titles(search(self.tasks, "LOGIN")), ["Fix login bug", "Fix the login page"])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(titles(search(self.tasks, "fix bug")), ["Fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"login bug"')), ["Fix login bug"])
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix login bug"])
+
+    def test_phrase_does_not_match_split_words(self):
+        self.assertEqual(search(self.tasks, '"login fix"'), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Fix login bug", "Fix the login page"])
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["buy milk"])
+        self.assertEqual(len(search(self.tasks, "status:open")), 3)
+
+    def test_combined_terms(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work status:open login")), ["Fix login bug", "Fix the login page"])
+
+    def test_quoted_text_with_colon_is_a_phrase(self):
+        self.assertEqual(search(self.tasks, '"tag:work"'), [])
+
+    def test_tag_with_quoted_value_keeps_spaces(self):
+        tasks = [Task(1, "a", tags=["big task"]), Task(2, "b", tags=["big"])]
+        self.assertEqual(titles(search(tasks, 'tag:"big task"')), ["a"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:closed")
+
+    def test_empty_tag_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_non_string_query_raises(self):
+        with self.assertRaises(TypeError):
+            search(self.tasks, None)
+
+
+if __name__ == "__main__":
+    unittest.main()
