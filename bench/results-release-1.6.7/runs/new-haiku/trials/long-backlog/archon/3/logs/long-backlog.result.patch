     def get(self, task_id):
@@ -26,13 +48,29 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._history.append(_Change(COMPLETE, task_id, previous_status=task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        self._history.append(_Change(DELETE, task_id, snapshot=deepcopy(task)))
         del self._tasks[task_id]
