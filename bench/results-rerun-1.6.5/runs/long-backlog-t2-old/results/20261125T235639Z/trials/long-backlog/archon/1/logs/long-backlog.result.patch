+++ b/tests/test_export.py
@@ -0,0 +1,91 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+def _task(id, title, tags=(), status="open", due=None):
+    return Task(id=id, title=title, tags=list(tags), status=status, due=due)
+
+
+def _parse(text):
+    return list(csv.reader(io.StringIO(text, newline="")))
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_list_gives_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_header_and_rows_in_given_order(self):
+        tasks = [_task(2, "second"), _task(1, "first")]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + "2,second,,open,\r\n" + "1,first,,open,\r\n",
+        )
+
+    def test_every_line_ends_with_crlf(self):
+        text = to_csv([_task(1, "a"), _task(2, "b")])
+        self.assertTrue(text.endswith("\r\n"))
+        self.assertEqual(text.count("\n"), text.count("\r\n"))
+        self.assertEqual(text.count("\r"), 3)
+
+    def test_plain_fields_are_not_quoted(self):
+        text = to_csv([_task(7, "plain title", ["a"], "done", date(2026, 4, 1))])
+        self.assertEqual(text, HEADER + "7,plain title,a,done,2026-04-01\r\n")
+
+    def test_tags_joined_with_semicolon(self):
+        text = to_csv([_task(1, "t", ["work", "home", "urgent"])])
+        self.assertIn(",work;home;urgent,", text)
+
+    def test_no_tags_gives_empty_field(self):
+        text = to_csv([_task(1, "t", [])])
+        self.assertEqual(text, HEADER + "1,t,,open,\r\n")
+
+    def test_no_due_gives_empty_field(self):
+        text = to_csv([_task(1, "t", due=None)])
+        self.assertTrue(text.endswith(",open,\r\n"))
+
+    def test_due_is_iso_date(self):
+        text = to_csv([_task(1, "t", due=date(2026, 3, 5))])
+        self.assertTrue(text.endswith(",open,2026-03-05\r\n"))
+
+    def test_title_with_comma_is_quoted(self):
+        text = to_csv([_task(1, "buy eggs, milk")])
+        self.assertIn('1,"buy eggs, milk",,open,', text)
+
+    def test_title_with_quote_is_quoted_and_doubled(self):
+        text = to_csv([_task(1, 'say "hi"')])
+        self.assertIn('1,"say ""hi""",,open,', text)
+
+    def test_title_with_cr_is_quoted(self):
+        text = to_csv([_task(1, "a\rb")])
+        self.assertIn('1,"a\rb",,open,', text)
+
+    def test_title_with_lf_is_quoted(self):
+        text = to_csv([_task(1, "line one\nline two")])
+        self.assertIn('1,"line one\nline two",,open,', text)
+
+    def test_tag_with_comma_quotes_the_tags_field(self):
+        text = to_csv([_task(1, "t", ["a,b", "c"])])
+        self.assertIn('1,t,"a,b;c",open,', text)
+
+    def test_tag_with_quote_is_quoted_and_doubled(self):
+        text = to_csv([_task(1, "t", ['say "x"'])])
+        self.assertIn('1,t,"say ""x""",open,', text)
+
+    def test_round_trip_with_special_characters(self):
+        titles = ['comma, here', 'quote "here"', "cr\rhere", "lf\nhere", "all, \"of\"\r\nthem"]
+        tasks = [_task(i, title, ["x;y"]) for i, title in enumerate(titles, start=1)]
+        rows = _parse(to_csv(tasks))
+        self.assertEqual(rows[0], ["id", "title", "tags", "status", "due"])
+        self.assertEqual([row[1] for row in rows[1:]], titles)
+        self.assertEqual({len(row) for row in rows}, {5})
+
+
+if __name__ == "__main__":
+    unittest.main()
