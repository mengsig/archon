+++ b/tests/test_search.py
@@ -0,0 +1,70 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN, Task
+from tasktracker.search import QueryError, search
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Write Report", ["work"], OPEN),
+            Task(2, "fix login", ["Side Project"], DONE),
+            Task(3, "Re: notes", ["workshop"], OPEN),
+            Task(4, "login fix", [], OPEN),
+        ]
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(titles(search(self.tasks, "report")), ["Write Report"])
+        self.assertEqual(titles(search(self.tasks, "PORT")), ["Write Report"])
+
+    def test_phrase_in_quotes_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["fix login"])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(titles(search(self.tasks, "login fix")), ["fix login", "login fix"])
+        self.assertEqual(titles(search(self.tasks, "write login")), [])
+
+    def test_quoted_text_is_literal_even_with_colon(self):
+        self.assertEqual(titles(search(self.tasks, '"re: notes"')), ["Re: notes"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Write Report"])
+        self.assertEqual(titles(search(self.tasks, "tag:work")), ["Write Report"])
+
+    def test_tag_with_space_in_quoted_value(self):
+        self.assertEqual(titles(search(self.tasks, 'tag:"side project"')), ["fix login"])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["fix login"])
+        self.assertEqual(len(search(self.tasks, "STATUS:open")), 3)
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_other_fields_raise(self):
+        for query in ["due:today", "tag:", "http://example.com"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_blank_query_matches_everything_in_input_order(self):
+        reversed_tasks = list(reversed(self.tasks))
+        self.assertEqual(search(reversed_tasks, ""), reversed_tasks)
+        self.assertEqual(search(reversed_tasks, "   "), reversed_tasks)
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(self.tasks))
+        self.assertEqual(titles(search(reversed_tasks, "login")), ["login fix", "fix login"])
+
+
+if __name__ == "__main__":
+    unittest.main()
