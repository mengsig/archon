+class TokenBucketValidationTest(unittest.TestCase):
+    def test_nonpositive_capacity_raises(self):
+        for capacity in (0, -1, float("nan")):
+            with self.subTest(capacity=capacity):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, 1.0, clock=FakeClock())
+
+    def test_nonpositive_refill_raises(self):
+        for refill in (0, -0.5, float("nan")):
+            with self.subTest(refill=refill):
+                with self.assertRaises(ValueError):
+                    TokenBucket(1, refill, clock=FakeClock())
+
+    def test_acquire_n_out_of_range_raises(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3, float("nan")):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_invalid_acquire_removes_nothing(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            bucket.try_acquire(3)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_acquire_exactly_capacity_succeeds(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(3))
+        self.assertFalse(bucket.try_acquire(1))
+
+
+class TokenBucketEdgeTest(unittest.TestCase):
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_refill_never_exceeds_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_available_reports_refilled_tokens(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 1.0, clock=clock)
+        bucket.try_acquire(4)
+        clock.now = 1.5
+        self.assertAlmostEqual(bucket.available(), 1.5)
+
+    def test_wait_time_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_time_is_seconds_until_acquire_succeeds(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        clock.now = 1.5
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+
+class ClockBackwardsTest(unittest.TestCase):
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 5.0
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_refill_resumes_from_latest_time_seen(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 4.0
+        self.assertAlmostEqual(bucket.available(), 4.0)
+        clock.now = 2.0
+        self.assertAlmostEqual(bucket.available(), 4.0)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+
+    def test_wait_time_unaffected_by_backwards_clock(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        clock.now = 10.0
+        bucket.try_acquire()
+        clock.now = 3.0
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+
