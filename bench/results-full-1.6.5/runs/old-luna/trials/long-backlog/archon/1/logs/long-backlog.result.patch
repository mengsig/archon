@@ -0,0 +1,32 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+
+class ExportTest(unittest.TestCase):
+    def test_rfc4180_escaping_line_endings_order_and_due_dates(self):
+        tasks = [
+            Task(2, 'title, with "quote"\nand LF', ["tag,one", 'tag"two'], "done", date(2026, 4, 1)),
+            Task(1, "plain\rtitle", [], "open"),
+            Task(3, "plain title", ["plain"], "open"),
+        ]
+
+        self.assertEqual(
+            to_csv(tasks),
+            'id,title,tags,status,due\r\n'
+            '2,"title, with ""quote""\nand LF","tag,one;tag""two",done,2026-04-01\r\n'
+            '1,"plain\rtitle",,open,\r\n'
+            '3,plain title,plain,open,\r\n',
+        )
+
+    def test_quotes_only_fields_with_csv_special_characters(self):
+        self.assertEqual(
+            to_csv([Task(1, "plain", ["tag"], "open")]),
+            "id,title,tags,status,due\r\n1,plain,tag,open,\r\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
