+class LedgerConcurrency(unittest.TestCase):
+    """Opposite transfers and snapshots run in lockstep. Every transfer
+    succeeds, so the final state is deterministic. A missing lock lets a
+    snapshot observe a debit without its credit, which the sum check catches."""
+
+    THREADS_PER_DIRECTION = 4
+    TRANSFERS_PER_THREAD = 5000
+    SNAPSHOTS = 20000
+    START_BALANCE = 10**6
+    SWITCH_INTERVAL_SECONDS = 1e-6
+
+    def setUp(self):
+        self._saved_switch_interval = sys.getswitchinterval()
+        sys.setswitchinterval(self.SWITCH_INTERVAL_SECONDS)
+
+    def tearDown(self):
+        sys.setswitchinterval(self._saved_switch_interval)
+
+    def test_opposite_transfers_and_snapshots_stay_consistent(self):
+        total = 2 * self.START_BALANCE
+        ledger = Ledger({"a": self.START_BALANCE, "b": self.START_BALANCE})
+        failures = []
+        party_count = 2 * self.THREADS_PER_DIRECTION + 1
+        barrier = threading.Barrier(party_count)
+        threads = [
+            self._thread(self._transfer_loop, barrier, ledger, "a", "b", failures)
+            for _ in range(self.THREADS_PER_DIRECTION)
+        ] + [
+            self._thread(self._transfer_loop, barrier, ledger, "b", "a", failures)
+            for _ in range(self.THREADS_PER_DIRECTION)
+        ] + [self._thread(self._snapshot_loop, barrier, ledger, total, failures)]
+        for thread in threads:
+            thread.start()
+        self._join_all(threads)
+
+        self.assertEqual(failures, [])
+        self.assertEqual(ledger.snapshot(), {"a": self.START_BALANCE, "b": self.START_BALANCE})
+
+    def _thread(self, target, *args):
+        return threading.Thread(target=target, args=args, daemon=True)
+
+    def _join_all(self, threads):
+        deadline = time.monotonic() + JOIN_TIMEOUT_SECONDS
+        for thread in threads:
+            thread.join(max(0.0, deadline - time.monotonic()))
+        stuck = [thread.name for thread in threads if thread.is_alive()]
+        self.assertEqual(stuck, [], "threads still running after timeout: possible deadlock")
+
+    def _transfer_loop(self, barrier, ledger, source, destination, failures):
+        barrier.wait(JOIN_TIMEOUT_SECONDS)
+        for _ in range(self.TRANSFERS_PER_THREAD):
+            if ledger.transfer(source, destination, 1) is not True:
+                failures.append((source, destination))
+
+    def _snapshot_loop(self, barrier, ledger, total, failures):
+        barrier.wait(JOIN_TIMEOUT_SECONDS)
+        for _ in range(self.SNAPSHOTS):
+            snap = ledger.snapshot()
+            if sum(snap.values()) != total:
+                failures.append(snap)
+
+
+if __name__ == "__main__":
+    unittest.main()
