@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,58 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20(self):
+        res = get("/items")
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_explicit_limit(self):
+        res = get("/items", limit="5")
+        self.assertEqual([item["id"] for item in res["body"]["items"]], [1, 2, 3, 4, 5])
+
+    def test_limit_bounds_are_accepted(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_invalid_limit_is_400(self):
+        for raw in ["0", "101", "-1", "abc", "1.5", "", " 5", "9" * 5000]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        overlong = base64.urlsafe_b64encode(b"9" * 5000).decode("ascii")
+        for raw in ["!!!", "MQ", "bm90LWEtbnVtYmVy", "", "OTk5OQ==", "MA==", overlong]:
+            with self.subTest(cursor=raw[:20]):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_non_string_query_values_are_400(self):
+        for query in [{"limit": 5}, {"limit": ["5"]}, {"cursor": 5}]:
+            with self.subTest(query=query):
+                res = handle({"method": "GET", "path": "/items", "query": query})
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_last_page_has_null_next_cursor(self):
+        res = get("/items", limit="100")
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_following_cursors_returns_every_item_once(self):
+        seen = []
+        query = {"limit": "8"}
+        while True:
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            seen.extend(item["id"] for item in res["body"]["items"])
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+            query = {"limit": "8", "cursor": cursor}
+        self.assertEqual(seen, list(range(1, 58)))
+
 
 if __name__ == "__main__":
     unittest.main()
