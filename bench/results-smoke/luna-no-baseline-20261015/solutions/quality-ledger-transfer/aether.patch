 """Bounded, thread-safe ledger. See SPEC.md."""
 
+from threading import Lock
+
 MAX_BALANCE = 2**63 - 1
 
 
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+
+        for account, balance in balances.items():
+            if not isinstance(account, str) or not account:
+                raise ValueError("account names must be nonempty strings")
+            if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+                raise ValueError("balances must be integers in the supported range")
+
+        self._balances = balances.copy()
+        self._lock = Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+            raise ValueError("amount must be an integer in the supported range")
+
+        with self._lock:
+            source_balance = self._balances[source]
+            destination_balance = self._balances[destination]
+
+            if source == destination:
+                return source_balance >= amount
+            if source_balance < amount:
+                return False
+            if destination_balance > MAX_BALANCE - amount:
+                return False
+
+            self._balances[source] = source_balance - amount
+            self._balances[destination] = destination_balance + amount
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return self._balances.copy()
