-    return {"status": 200, "body": {"items": items}}
+    cursor = query.get("cursor")
+    if cursor is not None:
+        after_id = _decode_cursor(cursor)
+        if after_id is None or not any(item["id"] == after_id for item in items):
+            return _error(400, "invalid cursor")
+        items = [item for item in items if item["id"] > after_id]
+
+    page = items[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(items) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(item_id):
+    payload = str(item_id).encode("ascii")
+    signature = hmac.new(_CURSOR_SECRET, payload, hashlib.sha256).hexdigest()[:32]
+    token = base64.urlsafe_b64encode(payload + b"." + signature.encode("ascii"))
+    return token.decode("ascii").rstrip("=")
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not cursor or not re.fullmatch(r"[A-Za-z0-9_-]+", cursor):
+        return None
+    try:
+        raw = base64.b64decode(cursor + "=" * (-len(cursor) % 4), altchars=b"-_", validate=True)
+        match = _CURSOR_PATTERN.fullmatch(raw.decode("ascii"))
+    except (ValueError, UnicodeDecodeError):
+        return None
+    if match is None:
+        return None
+    item_id, signature = match.groups()
+    expected = hmac.new(_CURSOR_SECRET, item_id.encode("ascii"), hashlib.sha256).hexdigest()[:32]
+    if not hmac.compare_digest(signature, expected):
+        return None
+    return int(item_id)
 
 
