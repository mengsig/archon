diff --git a/tests/ledger.rs b/tests/ledger.rs
index 6293987..ca8e0b2 100644
--- a/tests/ledger.rs
+++ b/tests/ledger.rs
@@ -1,3 +1,6 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
 use ledger::{parse_cents, parse_line, to_csv_row};
 
 #[test]
@@ -14,7 +17,101 @@ fn parses_lines() {
     let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
     assert_eq!(entry.account, "groceries");
     assert_eq!(entry.amount_cents, -4510);
-    assert!(to_csv_row(&entry).starts_with("2026-03-01,groceries,-4510"));
+    assert!(to_csv_row(&entry).starts_with("2026-03-01,groceries,-4510,"));
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tgroceries\t12\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,1200,EUR");
+}
+
+#[test]
+fn malformed_currency_is_bad_currency_error() {
+    for code in ["eur", "EURO", "EU", "U5D", ""] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert!(
+            matches!(err, ledger::LineError::BadCurrency(_)),
+            "{code:?} should be a currency error, got {err}"
+        );
+    }
+}
+
+#[test]
+fn currency_with_surrounding_whitespace_is_malformed() {
+    for code in [" EUR", "EUR ", " EUR ", "  EUR  "] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert!(
+            matches!(err, ledger::LineError::BadCurrency(_)),
+            "{code:?} should be a currency error, got {err}"
+        );
+    }
+}
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("stdin is piped")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn cli_writes_currency_column_with_usd_default() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n2026-03-02\tsalary\t100\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8(out.stdout).unwrap(),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,-4510,USD\n\
+         2026-03-02,salary,10000,EUR\n"
+    );
+}
+
+#[test]
+fn cli_malformed_currency_exits_2_naming_line() {
+    for code in ["eur", "EURO", "EU", "E5R", "", " EUR", "EUR "] {
+        let input = format!("2026-03-01\tgroceries\t1\n2026-03-02\trent\t2\t{code}\n");
+        let out = run_ledger(&input);
+        let stderr = String::from_utf8(out.stderr).unwrap();
+        assert_eq!(out.status.code(), Some(2), "currency {code:?}");
+        assert!(
+            stderr.starts_with("line 2: "),
+            "currency {code:?}: {stderr}"
+        );
+    }
+}
+
+#[test]
+fn cli_other_input_errors_exit_1() {
+    let out = run_ledger("2026-03-01\tgroceries\t1\n# note\nMarch 1\tgroceries\t1\n");
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert_eq!(out.status.code(), Some(1));
+    assert!(stderr.starts_with("line 3: "), "{stderr}");
+
+    let out = run_ledger("2026-03-01\tgroceries\t1\tEUR\textra\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(String::from_utf8(out.stderr)
+        .unwrap()
+        .starts_with("line 1: "));
+}
