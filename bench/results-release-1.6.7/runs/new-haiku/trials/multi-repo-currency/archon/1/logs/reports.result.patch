-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+Input may have a currency column; without one, amounts are USD.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+
+class MalformedCurrencyError(ValueError):
+    pass
+
+
+def currency_of(row, line_num):
+    """Currency code of a CSV row; a missing column means USD."""
+    currency = row.get("currency")
+    if currency is None:
+        return DEFAULT_CURRENCY
+    if not CURRENCY_PATTERN.fullmatch(currency):
+        raise MalformedCurrencyError(
+            f"line {line_num}: malformed currency code {currency!r}"
+        )
+    return currency
+
+
+def totals(reader):
+    """{(account, currency): total_cents} from a csv.DictReader."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        key = (row["account"], currency_of(row, reader.line_num))
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        total = result[(account, currency)]
+        lines.append(f"{account},{currency},{total}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(csv.DictReader(sys.stdin))
+    except MalformedCurrencyError as err:
+        sys.stderr.write(f"reports: {err}\n")
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
