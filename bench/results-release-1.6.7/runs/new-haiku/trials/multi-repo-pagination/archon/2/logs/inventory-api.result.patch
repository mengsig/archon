@@ -21,8 +28,41 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after = _parse_cursor(query.get("cursor"))
+    if after is None:
+        return _error(400, "cursor is invalid")
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    remaining = [item for item in ordered if item["id"] > after]
+    page = remaining[:limit]
+    next_cursor = str(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    value = _parse_digits(raw)
+    if value is None or not 1 <= value <= MAX_LIMIT:
+        return None
+    return value
+
+
+def _parse_cursor(raw):
+    """Return the id to start after; 0 means from the first item."""
+    if raw is None:
+        return 0
+    return _parse_digits(raw)
+
+
+def _parse_digits(raw):
+    if not isinstance(raw, str) or len(raw) > MAX_DIGITS:
+        return None
+    if not re.fullmatch(r"[0-9]+", raw):
+        return None
+    return int(raw)
 
 
