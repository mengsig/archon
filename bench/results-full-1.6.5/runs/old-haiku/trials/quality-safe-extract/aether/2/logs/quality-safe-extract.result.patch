+class NameValidation(unittest.TestCase):
+    def setUp(self):
+        self._temp = tempfile.TemporaryDirectory()
+        self.root = Path(self._temp.name)
+
+    def tearDown(self):
+        self._temp.cleanup()
+
+    def assert_rejected(self, name):
+        with self.subTest(name=name):
+            with self.assertRaises(ValueError):
+                extract([("ok.txt", b"ok"), (name, b"x")], self.root)
+            self.assertEqual(tree_snapshot(self.root), [])
+
+    def test_empty_and_absolute_names_are_rejected(self):
+        for name in ["", "/abs", "/"]:
+            self.assert_rejected(name)
+
+    def test_forbidden_characters_are_rejected(self):
+        for name in ["a\\b", "C:file", "C:/file", "a\x00b", "dir/a:b"]:
+            self.assert_rejected(name)
+
+    def test_empty_dot_and_dotdot_components_are_rejected(self):
+        for name in ["a//b", "a/", "./a", "a/.", "a/../b", "..", ".", "a/./b"]:
+            self.assert_rejected(name)
+
+    def test_non_string_names_are_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([(b"a", b"x")], self.root)
+        self.assertEqual(tree_snapshot(self.root), [])
+
+    def test_names_are_not_normalized(self):
+        self.assertEqual(extract([("a b/c d.txt", b"s")], self.root), ["a b/c d.txt"])
+        self.assertTrue((self.root / "a b" / "c d.txt").exists())
+
