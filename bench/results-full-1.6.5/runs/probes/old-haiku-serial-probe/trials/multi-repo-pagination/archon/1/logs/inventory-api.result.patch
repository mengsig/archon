@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,60 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_is_20_items_with_next_cursor(self):
+        res = get("/items")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_paging_visits_every_item_once_in_order(self):
+        seen = []
+        cursor = None
+        pages = 0
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            seen += [item["id"] for item in res["body"]["items"]]
+            pages += 1
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(pages, 6)
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        first = get("/items", limit="50")
+        last = get("/items", limit="50", cursor=first["body"]["next_cursor"])
+        self.assertEqual([item["id"] for item in last["body"]["items"]], list(range(51, 58)))
+        self.assertIsNone(last["body"]["next_cursor"])
+
+    def test_exact_fit_has_null_next_cursor(self):
+        res = get("/items", limit="57")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_cursor_past_end_gives_empty_last_page(self):
+        res = get("/items", cursor=_cursor_for(57))
+        self.assertEqual(res["body"], {"items": [], "next_cursor": None})
+
+    def test_invalid_limit_is_400(self):
+        for limit in ["0", "101", "-1", "abc", "", "2.5", " 5", "٥", "1" * 5000]:
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_400(self):
+        huge_id = base64.b64encode(b"9" * 5000).decode()
+        for cursor in ["", "!!!", "not-base64", base64.b64encode(b"abc").decode(), huge_id]:
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("cursor", res["body"]["error"])
+
+
+def _cursor_for(item_id):
+    return base64.b64encode(str(item_id).encode("ascii"), altchars=b"-_").decode("ascii")
+
 
 if __name__ == "__main__":
     unittest.main()
