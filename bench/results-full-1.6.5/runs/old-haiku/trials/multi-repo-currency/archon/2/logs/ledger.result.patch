+++ b/tests/cli.rs
@@ -0,0 +1,77 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+fn stdout(out: &Output) -> String {
+    String::from_utf8(out.stdout.clone()).expect("utf8 stdout")
+}
+
+fn stderr(out: &Output) -> String {
+    String::from_utf8(out.stderr.clone()).expect("utf8 stderr")
+}
+
+#[test]
+fn three_column_input_defaults_to_usd() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        stdout(&out),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn four_column_input_keeps_currency_per_row() {
+    let input = "# comment\n2026-03-01\tgroceries\t10\tEUR\n\n2026-03-02\trent\t5\n";
+    let out = run_ledger(input);
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        stdout(&out),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,1000,EUR\n\
+         2026-03-02,rent,500,USD\n"
+    );
+}
+
+#[test]
+fn malformed_currency_exits_2_naming_line() {
+    for code in ["eur", "EU", "EURO", "E1R"] {
+        let input = format!("2026-03-01\tgroceries\t1\n2026-03-02\trent\t2\t{code}\n");
+        let out = run_ledger(&input);
+        assert_eq!(out.status.code(), Some(2), "{code}");
+        assert!(
+            stderr(&out).starts_with("line 2: "),
+            "{code}: {}",
+            stderr(&out)
+        );
+    }
+}
+
+#[test]
+fn line_number_counts_skipped_lines() {
+    let out = run_ledger("# header note\n\n2026-03-01\tgroceries\t1\tusd\n");
+    assert_eq!(out.status.code(), Some(2));
+    assert!(stderr(&out).starts_with("line 3: "), "{}", stderr(&out));
+}
+
+#[test]
+fn other_input_errors_exit_1() {
+    let out = run_ledger("2026-03-01\tgroceries\t1\nMarch 1\tgroceries\t1\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(stderr(&out).starts_with("line 2: "), "{}", stderr(&out));
+}
