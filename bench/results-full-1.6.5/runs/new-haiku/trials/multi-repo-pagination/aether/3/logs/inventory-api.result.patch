+    def test_default_page_size_is_20(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_walking_pages_returns_every_item_once_in_order(self):
+        self.assertEqual(walk_pages(), list(range(1, 58)))
+        self.assertEqual(walk_pages(limit="7"), list(range(1, 58)))
+        self.assertEqual(walk_pages(limit="57"), list(range(1, 58)))
