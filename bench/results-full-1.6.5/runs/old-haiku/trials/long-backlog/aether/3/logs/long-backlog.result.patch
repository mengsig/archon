diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..1dfeb15 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,75 @@
+from collections import namedtuple
+
+from .models import DONE, OPEN
+
+Term = namedtuple("Term", ["text", "phrase"])
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in their input order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_matcher(term) for term in _tokenize(query)]
+    return [task for task in tasks if all(matches(task) for matches in matchers)]
+
+
+def _tokenize(query):
+    """Split on whitespace outside double quotes; a term starting with a quote is a literal phrase."""
+    terms = []
+    chars = []
+    started = starts_quoted = in_quote = False
+    for char in query:
+        if in_quote and char != '"':
+            chars.append(char)
+        elif char == '"':
+            if not started:
+                starts_quoted = True
+            started = True
+            in_quote = not in_quote
+        elif char.isspace():
+            if started:
+                terms.append(Term("".join(chars), starts_quoted))
+                chars, started, starts_quoted = [], False, False
+        else:
+            chars.append(char)
+            started = True
+    if in_quote:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if started:
+        terms.append(Term("".join(chars), starts_quoted))
+    return terms
+
+
+def _matcher(term):
+    if term.phrase or ":" not in term.text:
+        return _title_matcher(term.text)
+    field, value = term.text.split(":", 1)
+    if field == "tag":
+        return _tag_matcher(value)
+    if field == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown search field: {field}")
+
+
+def _title_matcher(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_matcher(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_matcher(value):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status: {value}")
+    return lambda task: task.status == status
