 }
+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn reads_currency_column() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_as_currency_error() {
+    for bad in ["eur", "EU", "EURO", "E1R", "US$", "ÉUR"] {
+        let line = format!("2026-03-01\tgroceries\t1\t{bad}");
+        assert!(
+            matches!(parse_line(&line), Err(ParseError::Currency(_))),
+            "{bad:?} should be rejected as a currency"
+        );
+    }
+}
+
+#[test]
+fn other_field_errors_are_input_errors() {
+    assert!(matches!(
+        parse_line("2026-03-01\tgroceries\t1\tEUR\textra"),
+        Err(ParseError::Input(_))
+    ));
+    assert!(matches!(
+        parse_line("2026-03-01\tgroceries\tabc\tEUR"),
+        Err(ParseError::Input(_))
+    ));
+}
+
+#[test]
+fn csv_header_has_currency_column() {
+    assert_eq!(CSV_HEADER, "date,account,amount_cents,currency");
+}
+
+fn run_cli(stdin: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawning ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(stdin.as_bytes())
+        .expect("writing stdin");
+    child.wait_with_output().expect("waiting for ledger")
+}
+
+#[test]
+fn cli_exports_currency_column() {
+    let out = run_cli("2026-03-01\tgroceries\t1.00\tEUR\n2026-03-02\trent\t-5\n");
+    assert!(out.status.success());
+    assert_eq!(
+        String::from_utf8(out.stdout).unwrap(),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,100,EUR\n\
+         2026-03-02,rent,-500,USD\n"
+    );
+}
+
+#[test]
+fn cli_malformed_currency_exits_2_naming_line() {
+    let out = run_cli("# header-ish comment\n\n2026-03-01\tgroceries\t1\tusd\n");
+    assert_eq!(out.status.code(), Some(2));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 3: "), "stderr was {stderr:?}");
+}
+
+#[test]
+fn cli_other_input_error_exits_1() {
+    let out = run_cli("2026-03-01\tgroceries\tabc\n");
+    assert_eq!(out.status.code(), Some(1));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 1: "), "stderr was {stderr:?}");
+}
