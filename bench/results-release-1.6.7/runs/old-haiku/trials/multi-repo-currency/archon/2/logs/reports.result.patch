-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+CSV without a currency column (old ledger output) counts every row as USD.
+A malformed currency code exits with status 2.
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
+
+
+class MalformedCurrency(ValueError):
+    """A row's currency is not exactly three uppercase ASCII letters."""
+
+
+def row_currency(row, data_row_number):
+    """Currency of a CSV dict row; rows without a currency column are USD."""
+    if "currency" not in row:
+        return DEFAULT_CURRENCY
+    currency = row["currency"]
+    if not isinstance(currency, str) or not CURRENCY_PATTERN.fullmatch(currency):
+        raise MalformedCurrency(
+            f"data row {data_row_number}: missing or malformed currency "
+            f"{currency!r}, expected three uppercase letters"
+        )
+    return currency
+
 
 def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for data_row_number, row in enumerate(rows, start=1):
+        key = (row["account"], row_currency(row, data_row_number))
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
     rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(rows)
+    except MalformedCurrency as error:
+        print(f"reports: {error}", file=sys.stderr)
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
