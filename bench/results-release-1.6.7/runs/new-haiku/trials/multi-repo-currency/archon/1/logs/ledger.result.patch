diff --git a/tests/ledger.rs b/tests/ledger.rs
index 6293987..65032a9 100644
--- a/tests/ledger.rs
+++ b/tests/ledger.rs
@@ -18,3 +18,96 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn three_column_line_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,USD");
+}
+
+#[test]
+fn four_column_line_keeps_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,EUR");
+}
+
+#[test]
+fn malformed_currency_is_exit_two() {
+    let err = parse_line("2026-03-01\tgroceries\t1\teur").unwrap_err();
+    assert_eq!(err.exit_code(), 2);
+    for bad in ["US", "USDX", "U5D", "", "usd"] {
+        let line = format!("2026-03-01\tgroceries\t1\t{bad}");
+        let err = parse_line(&line).unwrap_err();
+        assert_eq!(err.exit_code(), 2, "currency {bad:?}");
+    }
+}
+
+#[test]
+fn structural_errors_are_exit_one() {
+    assert_eq!(
+        parse_line("2026-03-01\tgroceries").unwrap_err().exit_code(),
+        1
+    );
+    assert_eq!(
+        parse_line("2026-03-01\tgroceries\t1\tUSD\textra")
+            .unwrap_err()
+            .exit_code(),
+        1
+    );
+    assert_eq!(
+        parse_line("March 1\tgroceries\t1").unwrap_err().exit_code(),
+        1
+    );
+}
+
+fn run_ledger(input: &str) -> std::process::Output {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("stdin is piped")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn cli_writes_currency_column_for_mixed_input() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n2026-03-02\trent\t1200\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8(out.stdout).unwrap(),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,-4510,USD\n\
+         2026-03-02,rent,120000,EUR\n"
+    );
+}
+
+#[test]
+fn cli_reports_malformed_currency_line_and_exits_two() {
+    let out = run_ledger("# header comment\n2026-03-01\tgroceries\t1\n2026-03-02\trent\t2\tusd\n");
+    assert_eq!(out.status.code(), Some(2));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(
+        stderr.starts_with("line 3: bad currency"),
+        "stderr: {stderr}"
+    );
+}
+
+#[test]
+fn cli_structural_error_exits_one() {
+    let out = run_ledger("2026-03-01\tgroceries\t1\nnot a date\trent\t2\n");
+    assert_eq!(out.status.code(), Some(1));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 2: bad date"), "stderr: {stderr}");
+}
