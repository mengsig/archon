+++ b/tests/test_export.py
@@ -0,0 +1,50 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_rows_keep_order_and_use_crlf(self):
+        store = TaskStore()
+        store.add("first", tags=["a", "b"], due=date(2026, 4, 1))
+        second = store.add("second")
+        store.complete(second.id)
+        self.assertEqual(
+            to_csv(store.all()),
+            f"{HEADER}\r\n1,first,a;b,open,2026-04-01\r\n2,second,,done,\r\n",
+        )
+
+    def test_title_with_comma_is_quoted(self):
+        store = TaskStore()
+        store.add("milk, eggs")
+        self.assertIn('1,"milk, eggs",,open,\r\n', to_csv(store.all()))
+
+    def test_quotes_are_doubled_and_wrapped(self):
+        store = TaskStore()
+        store.add('say "hi"')
+        self.assertIn('1,"say ""hi""",,open,\r\n', to_csv(store.all()))
+
+    def test_newlines_and_carriage_returns_are_quoted(self):
+        store = TaskStore()
+        store.add("line one\nline two")
+        store.add("cr\rhere")
+        output = to_csv(store.all())
+        self.assertIn('1,"line one\nline two",,open,\r\n', output)
+        self.assertIn('2,"cr\rhere",,open,\r\n', output)
+
+    def test_tag_with_comma_is_quoted(self):
+        store = TaskStore()
+        store.add("x", tags=["a,b", "c"])
+        self.assertIn('1,x,"a,b;c",open,\r\n', to_csv(store.all()))
+
+    def test_plain_fields_are_not_quoted(self):
+        store = TaskStore()
+        store.add("plain", tags=["t"], due=date(2026, 1, 2))
+        self.assertEqual(to_csv(store.all()).splitlines()[1], "1,plain,t,open,2026-01-02")
