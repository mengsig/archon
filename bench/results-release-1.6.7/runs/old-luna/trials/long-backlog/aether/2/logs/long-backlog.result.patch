@@ -0,0 +1,37 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+
+class DueDateValidationTest(unittest.TestCase):
+    def setUp(self):
+        self.today = date(2026, 3, 10)
+
+    def test_rejects_impossible_calendar_dates(self):
+        for value in (
+            "2026-02-30",
+            "2025-02-29",
+            "2026-04-31",
+            "2026-13-01",
+            "2026-00-10",
+        ):
+            with self.subTest(value=value):
+                with self.assertRaisesRegex(InvalidDate, value):
+                    parse_due(value, self.today)
+
+    def test_rejects_unsupported_forms_and_offsets(self):
+        for value in ("next week", "-3d", "3d", "2026-3-10"):
+            with self.subTest(value=value):
+                with self.assertRaises(InvalidDate):
+                    parse_due(value, self.today)
+
+    def test_relative_and_named_dates(self):
+        self.assertEqual(parse_due(" +0D ", self.today), self.today)
+        self.assertEqual(parse_due("TODAY", self.today), self.today)
+        self.assertEqual(parse_due(" tomorrow ", self.today), date(2026, 3, 11))
+        self.assertEqual(parse_due("+3d", self.today), date(2026, 3, 13))
+
+
+if __name__ == "__main__":
+    unittest.main()
