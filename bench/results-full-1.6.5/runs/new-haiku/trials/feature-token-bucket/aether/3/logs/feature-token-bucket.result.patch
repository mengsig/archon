 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _check_bucket_params(capacity, refill_per_sec):
+    if not capacity > 0:
+        raise ValueError(f"capacity must be > 0, got {capacity!r}")
+    if not refill_per_sec > 0:
+        raise ValueError(f"refill_per_sec must be > 0, got {refill_per_sec!r}")
+
+
+def _check_n(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must be in (0, {capacity}], got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        self._capacity = float(capacity)
+        self._refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = self._capacity
+        # Latest clock reading seen; refill never moves backwards past it.
+        self._last = clock()
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_n(n, self._capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        assert self._tokens >= 0, "token count went negative"
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_n(n, self._capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self._refill_per_sec
+
+    def _refill(self):
+        now = self._clock()
+        if now <= self._last:
+            return
+        elapsed = now - self._last
+        self._tokens = min(self._capacity, self._tokens + elapsed * self._refill_per_sec)
+        self._last = now
+        assert 0 <= self._tokens <= self._capacity, "token count out of bounds"
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        if not isinstance(max_keys, int) or max_keys < 1:
+            raise ValueError(f"max_keys must be an int >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        # Ordered from least to most recently used.
+        self._buckets = OrderedDict()
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        return self._get_bucket(key, n).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        return self._get_bucket(key, n).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
+
+    def _get_bucket(self, key, n):
+        # Validate n before touching the map so a bad request has no side effects.
+        _check_n(n, self._capacity)
+        bucket = self._buckets.get(key)
+        if bucket is None:
+            return self._add_bucket(key)
+        self._buckets.move_to_end(key)
+        return bucket
+
+    def _add_bucket(self, key):
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys, "key limit exceeded"
+        return bucket
