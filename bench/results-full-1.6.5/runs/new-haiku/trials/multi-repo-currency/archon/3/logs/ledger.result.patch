diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..9de49da
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,72 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn defaults_missing_currency_to_usd() {
+    let out = run_ledger("2026-03-01\trent\t1200\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "date,account,amount_cents,currency\n2026-03-01,rent,120000,USD\n"
+    );
+}
+
+#[test]
+fn emits_given_currency_per_row() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n2026-03-02\trent\t1200\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,-4510,USD\n\
+         2026-03-02,rent,120000,EUR\n"
+    );
+}
+
+#[test]
+fn malformed_currency_exits_2_with_line_number() {
+    let out = run_ledger("2026-03-01\trent\t1\tUSD\n2026-03-02\trent\t1\teur\n");
+    assert_eq!(out.status.code(), Some(2));
+    assert!(
+        String::from_utf8_lossy(&out.stderr).starts_with("line 2: bad currency \"eur\""),
+        "stderr was {:?}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+}
+
+#[test]
+fn padded_currency_code_exits_2_with_line_number() {
+    for (line, code) in [(" EUR", " EUR"), ("EUR ", "EUR ")] {
+        let input = format!("2026-03-01\trent\t1\tUSD\n2026-03-02\trent\t1\t{line}\n");
+        let out = run_ledger(&input);
+        assert_eq!(out.status.code(), Some(2), "code {code:?}");
+        assert!(
+            String::from_utf8_lossy(&out.stderr).starts_with("line 2: bad currency"),
+            "code {code:?}, stderr was {:?}",
+            String::from_utf8_lossy(&out.stderr)
+        );
+    }
+}
+
+#[test]
+fn other_input_errors_still_exit_1() {
+    let out = run_ledger("2026-03-01\trent\tabc\tEUR\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&out.stderr).starts_with("line 1: bad amount"));
+}
