@@ -49,3 +53,49 @@ fn reports_count_and_round_trip() {
     assert_eq!(report::from_line(&line).unwrap(), a);
     assert!(report::from_line("4,dee,1,lost").is_err());
 }
+
+#[test]
+fn cancellation_is_allowed_before_and_after_payment_but_only_once() {
+    let mut pending = Order::new(7, "eve", 900);
+    pending.cancel().unwrap();
+    assert_eq!(status(&pending), "cancelled");
+    assert_eq!(
+        pending.cancel().unwrap_err(),
+        "order 7 cannot be cancelled: it is cancelled"
+    );
+
+    let mut paid = Order::new(8, "frank", 1100);
+    billing::pay(&mut paid).unwrap();
+    paid.cancel().unwrap();
+    assert_eq!(status(&paid), "cancelled");
+    assert_eq!(
+        paid.cancel().unwrap_err(),
+        "order 8 cannot be cancelled: it is cancelled"
+    );
+}
+
+#[test]
+fn report_parser_preserves_field_errors_and_trim_behavior() {
+    assert_eq!(
+        report::from_line("1,ada,5").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("x,ada,5,pending").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,no,pending").unwrap_err(),
+        "bad total \"no\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,5,Pending").unwrap_err(),
+        "unknown status \"Pending\""
+    );
+
+    let parsed = report::from_line(" 1, ada,5,pending \n").unwrap();
+    assert_eq!(parsed.id, 1);
+    assert_eq!(parsed.customer, " ada");
+    assert_eq!(parsed.total_cents, 5);
+    assert_eq!(status(&parsed), "pending");
+}
