-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    if not isinstance(raw_limit, (str, int)) or not re.fullmatch(r"[0-9]+", str(raw_limit)):
+        return _error(400, "limit must be an integer between 1 and 100")
+    limit = int(raw_limit)
+    if not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer between 1 and 100")
+
+    cursor = query.get("cursor")
+    if cursor is not None:
+        if not isinstance(cursor, str):
+            return _error(400, "invalid cursor")
+        try:
+            decoded = base64.b64decode(cursor + "=" * (-len(cursor) % 4), altchars=b"-_", validate=True)
+            cursor_id = int(decoded.decode("ascii"))
+            if (not re.fullmatch(r"[A-Za-z0-9_-]+", cursor)
+                    or base64.urlsafe_b64encode(decoded).decode("ascii").rstrip("=") != cursor
+                    or str(cursor_id).encode("ascii") != decoded
+                    or cursor_id not in {item["id"] for item in items}):
+                raise ValueError
+        except (ValueError, UnicodeDecodeError, binascii.Error):
+            return _error(400, "invalid cursor")
+        items = [item for item in items if item["id"] > cursor_id]
+
+    page = items[:limit]
+    next_cursor = None
+    if len(items) > limit:
+        encoded = base64.urlsafe_b64encode(str(page[-1]["id"]).encode("ascii"))
+        next_cursor = encoded.decode("ascii").rstrip("=")
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
