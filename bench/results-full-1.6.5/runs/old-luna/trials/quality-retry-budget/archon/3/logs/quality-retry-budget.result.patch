diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..906f9a7 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,45 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": (attempt, 1),
+        "elapsed_ms": (elapsed_ms, 0),
+        "max_attempts": (max_attempts, 1),
+        "budget_ms": (budget_ms, 0),
+        "base_ms": (base_ms, 0),
+        "cap_ms": (cap_ms, 0),
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = (retry_after_ms, 0)
+
+    for name, (value, minimum) in values.items():
+        if type(value) is not int or value < minimum:
+            raise ValueError("{} must be an integer >= {}".format(name, minimum))
+
+    if attempt >= max_attempts:
+        return None
+
+    # Compare the exponent against the number of doublings needed to reach the
+    # cap before computing it. This avoids constructing huge powers for large
+    # attempt values, and also handles zero base/cap without special arithmetic.
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    elif base_ms >= cap_ms:
+        delay = cap_ms
+    else:
+        doublings_to_cap = max(0, (cap_ms - 1).bit_length() -
+                               (base_ms - 1).bit_length())
+        if base_ms << doublings_to_cap < cap_ms:
+            doublings_to_cap += 1
+        exponent = attempt - 1
+        if exponent >= doublings_to_cap:
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms << exponent)
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..0ef44ec 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,56 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validation_precedes_exhaustion(self):
+        for kwargs in ({"elapsed_ms": True}, {"base_ms": 1.0},
+                       {"retry_after_ms": -1}, {"max_attempts": 0}):
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                retry_delay(4, **({"elapsed_ms": 0} | kwargs))
+
+    def test_builtin_integer_validation(self):
+        class IntSubclass(int):
+            pass
+
+        for value in (True, 1.0, IntSubclass(1)):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                retry_delay(value, 0)
+
+    def test_all_nonnegative_fields(self):
+        for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms"):
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                retry_delay(1, **({"elapsed_ms": 0, name: -1}))
+
+    def test_attempts_count_initial_attempt_and_greater_is_legal(self):
+        self.assertIsNone(retry_delay(100, 0, max_attempts=4))
+        self.assertEqual(retry_delay(1, 0, max_attempts=2), 100)
+
+    def test_saturates_huge_attempt_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
+
+    def test_zero_base_and_cap(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1,
+                                     base_ms=0), 0)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1,
+                                     cap_ms=0), 0)
+
+    def test_base_may_exceed_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=20), 20)
+
+    def test_saturation_threshold_does_not_round_up_early(self):
+        self.assertEqual(retry_delay(2, 0, base_ms=3, cap_ms=7), 6)
+        self.assertEqual(retry_delay(3, 0, base_ms=3, cap_ms=7), 7)
+
+    def test_retry_after_floor_is_not_capped(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=500), 500)
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+    def test_budget_boundary_is_strict_and_zero_delay_is_allowed(self):
+        self.assertEqual(retry_delay(1, 10, budget_ms=111, base_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 10, budget_ms=10, base_ms=0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100))
+
+    def test_does_not_shorten_wait_to_fit_budget(self):
+        self.assertIsNone(retry_delay(1, 950, budget_ms=1000))
