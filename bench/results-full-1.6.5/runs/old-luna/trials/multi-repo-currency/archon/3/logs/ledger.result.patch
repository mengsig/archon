+#[test]
+fn parses_and_validates_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t1\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    for currency in ["eur", "US", "USDD", "U$D", "ÉUR"] {
+        let line = format!("2026-03-01\tgroceries\t1\t{currency}");
+        assert!(parse_line(&line).unwrap_err().contains("currency"));
+    }
+}
+
+#[test]
+fn cli_sets_currency_error_exit_status_and_line_number() {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(b"2026-03-01\ta\t1\n2026-03-02\tb\t1\tusd\n")
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("line 2:"));
+}
+
+#[test]
+fn other_cli_input_errors_keep_exit_status_one() {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(b"2026-03-01\ta\tbad\n")
+        .unwrap();
+    assert_eq!(child.wait().unwrap().code(), Some(1));
+}
