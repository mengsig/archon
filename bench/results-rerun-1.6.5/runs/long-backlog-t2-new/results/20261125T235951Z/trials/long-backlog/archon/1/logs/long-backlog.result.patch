@@ -0,0 +1,97 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("write report", tags=["home", "urgent"])
+    store.complete(store.add("Buy milk").id)
+    return store
+
+
+def _titles(store, query):
+    return [t.title for t in search(store.all(), query)]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        store = _store()
+        for query in ["", "   ", "\t"]:
+            self.assertEqual(_titles(store, query), ["Fix login bug", "write report", "Buy milk"])
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        store = _store()
+        self.assertEqual(_titles(store, "LOGIN"), ["Fix login bug"])
+        self.assertEqual(_titles(store, "rep"), ["write report"])
+
+    def test_terms_are_anded(self):
+        store = _store()
+        self.assertEqual(_titles(store, "fix bug"), ["Fix login bug"])
+        self.assertEqual(_titles(store, "fix report"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        store = _store()
+        self.assertEqual(_titles(store, '"fix login"'), ["Fix login bug"])
+        self.assertEqual(_titles(store, '"login fix"'), [])
+        self.assertEqual(_titles(store, '"" milk'), ["Buy milk"])
+
+    def test_quoted_phrase_may_contain_colon(self):
+        store = TaskStore()
+        store.add("note: call Bob")
+        store.add("call Bob")
+        self.assertEqual(_titles(store, '"note: call"'), ["note: call Bob"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        store = _store()
+        self.assertEqual(_titles(store, "tag:work"), ["Fix login bug"])
+        self.assertEqual(_titles(store, "TAG:URGENT"), ["write report"])
+        self.assertEqual(_titles(store, "tag:wor"), [])
+
+    def test_status_filters(self):
+        store = _store()
+        self.assertEqual(_titles(store, "status:open"), ["Fix login bug", "write report"])
+        self.assertEqual(_titles(store, "status:done"), ["Buy milk"])
+        self.assertEqual(_titles(store, "STATUS:Done tag:work"), [])
+
+    def test_mixed_terms(self):
+        store = _store()
+        self.assertEqual(_titles(store, 'tag:home "write rep" status:open'), ["write report"])
+
+    def test_unknown_field_raises(self):
+        store = _store()
+        with self.assertRaises(QueryError):
+            search(store.all(), "foo:bar")
+        with self.assertRaises(QueryError):
+            search(store.all(), "http://x")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(_store().all(), "status:pending")
+
+    def test_empty_tag_or_status_value_raises(self):
+        store = _store()
+        with self.assertRaises(QueryError):
+            search(store.all(), "tag:")
+        with self.assertRaises(QueryError):
+            search(store.all(), "status:")
+
+    def test_unterminated_quote_raises(self):
+        store = _store()
+        with self.assertRaises(QueryError):
+            search(store.all(), '"fix login')
+
+    def test_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "foo:bar")
+
+    def test_quoted_field_syntax_is_a_phrase(self):
+        store = TaskStore()
+        store.add('say "tag:x" twice')
+        self.assertEqual(_titles(store, '"tag:x"'), ['say "tag:x" twice'])
+
+
+if __name__ == "__main__":
+    unittest.main()
