@@ -0,0 +1,98 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task_and_never_reuses_its_id(self):
+        store = TaskStore()
+        first = store.add("a")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        second = store.add("b")
+        self.assertEqual(first.id, 1)
+        self.assertEqual(second.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        task = store.add("a", tags=["x", "y"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = store.get(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored, before)
+        self.assertEqual(restored.status, "done")
+
+    def test_undo_delete_uses_state_at_delete_time(self):
+        store = TaskStore()
+        task = store.add("a", tags=["x"])
+        returned = store.delete(task.id)
+        returned.tags.append("mutated")
+        store.undo()
+        self.assertEqual(store.get(task.id).tags, ["x"])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_of_complete_applies_to_task_restored_by_undo_delete(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_double_complete_undo_restores_previous_status(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
