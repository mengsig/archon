diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..29361f2 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,71 @@
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            current.append(char)
+        elif char.isspace() and not quoted:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
+def _parse_term(term):
+    if term.startswith('"'):
+        if len(term) < 2 or not term.endswith('"') or '"' in term[1:-1]:
+            raise QueryError(f"invalid quoted term: {term}")
+        return "title", term[1:-1]
+
+    if '"' in term:
+        field, separator, value = term.partition(":")
+        if not separator or not value.startswith('"') or not value.endswith('"') or '"' in value[1:-1]:
+            raise QueryError(f"invalid quoted term: {term}")
+        value = value[1:-1]
+    elif ":" in term:
+        field, _, value = term.partition(":")
+        if not value:
+            raise QueryError(f"invalid query term: {term}")
+    else:
+        return "title", term
+
+    field = field.lower()
+    if field == "tag":
+        return "tag", value
+    if field == "status":
+        if value.lower() not in ("open", "done"):
+            raise QueryError(f"unknown status: {value}")
+        return "status", value.lower()
+    raise QueryError(f"unknown query field: {field}")
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = [_parse_term(term) for term in _terms(query)]
+    if not terms:
+        return list(tasks)
+
+    matches = []
+    for task in tasks:
+        title = task.title.casefold()
+        for kind, value in terms:
+            if kind == "title" and value.casefold() not in title:
+                break
+            if kind == "tag" and value.casefold() not in (tag.casefold() for tag in task.tags):
+                break
+            if kind == "status" and task.status.casefold() != value:
+                break
+        else:
+            matches.append(task)
+    return matches
