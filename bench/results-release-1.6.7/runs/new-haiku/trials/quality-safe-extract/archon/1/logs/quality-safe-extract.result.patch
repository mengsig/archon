--- a/test_safe_extract.py
+++ b/test_safe_extract.py
@@ -1,3 +1,5 @@
+import os
+import shutil
 import tempfile
 import unittest
 from pathlib import Path
@@ -18,3 +20,237 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        self.base = Path(tempfile.mkdtemp())
+        self.addCleanup(shutil.rmtree, self.base, True)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def snapshot(self, path):
+        return sorted(p.relative_to(path).as_posix() for p in path.rglob("*"))
+
+
+class ErrorCases(TempRootCase):
+    def test_rejects_non_list_batches_without_consuming_them(self):
+        generator = (entry for entry in [("a", b"x")])
+        for batch in [(("a", b"x"),), iter([("a", b"x")]), generator, ()]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_malformed_entries(self):
+        malformed = [["a", b"x"], ("a",), ("a", b"x", "extra"), "ab", None]
+        for entry in malformed:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([entry], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_non_string_names(self):
+        for name in [b"a", None, 1]:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([(name, b"x")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_non_bytes_data(self):
+        for data in ["x", bytearray(b"x"), memoryview(b"x"), None]:
+            with self.subTest(data=type(data).__name__):
+                with self.assertRaises(ValueError):
+                    extract([("a", data)], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_invalid_names(self):
+        invalid = [
+            "", "/abs", "/", "a\\b", "C:x", "c:/x", "a\0b", "a//b", "a/",
+            "./a", "a/./b", ".", "..", "../x", "a/../b",
+        ]
+        for name in invalid:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b""), (name, b"x")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_lone_surrogate_names(self):
+        with self.assertRaises(ValueError):
+            extract([("bad\ud800", b"x")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_duplicate_names(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a", b"2")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_file_directory_collisions_in_either_order(self):
+        batches = [
+            [("a", b""), ("a/b", b"")],
+            [("a/b", b""), ("a", b"")],
+            [("a/b", b""), ("a/b/c", b"")],
+            [("a/b/c", b""), ("a/b", b"")],
+        ]
+        for batch in batches:
+            with self.subTest(batch=[name for name, _ in batch]):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_invalid_roots(self):
+        roots = [
+            str(self.base / "missing"),
+            self.base / "missing",
+            "",
+            None,
+            123,
+            os.fsencode(str(self.root)),
+            f"{self.root}/../root",
+        ]
+        for root in roots:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([("a", b"x")], root)
+
+    def test_rejects_regular_file_as_root(self):
+        file_root = self.base / "file"
+        file_root.write_bytes(b"data")
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], file_root)
+        self.assertEqual(file_root.read_bytes(), b"data")
+
+    def test_rejects_symlink_root_and_leaves_target_unchanged(self):
+        link = self.base / "link"
+        link.symlink_to(self.root, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], link)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_rejects_dangling_symlink_root(self):
+        link = self.base / "dangling"
+        link.symlink_to(self.base / "nowhere")
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], link)
+        self.assertFalse((self.base / "nowhere").exists())
+
+    def test_rejects_symlink_ancestor_inside_root(self):
+        real = self.root / "real"
+        real.mkdir()
+        (self.root / "link").symlink_to(real, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"x")], self.root)
+        self.assertEqual(self.snapshot(real), [])
+
+    def test_rejects_symlink_ancestor_pointing_outside_root(self):
+        (self.root / "link").symlink_to(self.outside, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"x")], self.root)
+        self.assertEqual(self.snapshot(self.outside), [])
+
+    def test_rejects_dangling_symlink_ancestor(self):
+        (self.root / "dangling").symlink_to(self.outside / "new")
+        with self.assertRaises(ValueError):
+            extract([("dangling/x", b"x")], self.root)
+        self.assertFalse((self.outside / "new").exists())
+
+    def test_rejects_file_ancestor(self):
+        (self.root / "f").write_bytes(b"data")
+        with self.assertRaises(ValueError):
+            extract([("f/x", b"x")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"data")
+
+    def test_never_overwrites_existing_file(self):
+        (self.root / "a").write_bytes(b"old")
+        with self.assertRaises(ValueError):
+            extract([("a", b"new")], self.root)
+        self.assertEqual((self.root / "a").read_bytes(), b"old")
+
+    def test_rejects_existing_directory_target(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"x")], self.root)
+        self.assertEqual(self.snapshot(self.root), ["d"])
+
+    def test_rejects_dangling_symlink_target_without_following_it(self):
+        (self.root / "t").symlink_to(self.outside / "new")
+        with self.assertRaises(ValueError):
+            extract([("t", b"x")], self.root)
+        self.assertFalse((self.outside / "new").exists())
+
+    def test_validation_failure_creates_nothing(self):
+        with self.assertRaises(ValueError):
+            extract([("new/ok", b"x"), ("bad/../x", b"y")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_disk_conflict_later_in_batch_creates_nothing(self):
+        (self.root / "exists").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("newdir/a", b"x"), ("exists/b", b"")], self.root)
+        self.assertEqual(self.snapshot(self.root), ["exists"])
+
+    def test_empty_batch_still_validates_root(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+    @unittest.skipIf(os.geteuid() == 0, "root ignores directory permissions")
+    def test_unexpected_io_error_propagates(self):
+        self.root.chmod(0o500)
+        self.addCleanup(self.root.chmod, 0o700)
+        with self.assertRaises(PermissionError):
+            extract([("sub/x", b"x")], self.root)
+
+
+class BoundaryCases(TempRootCase):
+    def test_accepts_pathlib_and_string_roots(self):
+        self.assertEqual(extract([("p", b"1")], self.root), ["p"])
+        self.assertEqual(extract([("s", b"2")], str(self.root)), ["s"])
+        self.assertEqual((self.root / "p").read_bytes(), b"1")
+        self.assertEqual((self.root / "s").read_bytes(), b"2")
+
+    def test_empty_batch_returns_empty_list(self):
+        self.assertEqual(extract([], self.root), [])
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_returns_names_in_input_order(self):
+        entries = [("z", b""), ("a/b", b""), ("m", b"")]
+        self.assertEqual(extract(entries, self.root), ["z", "a/b", "m"])
+
+    def test_writes_exact_bytes(self):
+        data = bytes(range(256)) + b"\0\r\n"
+        extract([("bin.dat", data)], self.root)
+        self.assertEqual((self.root / "bin.dat").read_bytes(), data)
+
+    def test_empty_file_is_created(self):
+        extract([("e", b"")], self.root)
+        self.assertEqual((self.root / "e").stat().st_size, 0)
+
+    def test_creates_missing_parent_directories(self):
+        extract([("a/b/c/d.txt", b"x")], self.root)
+        self.assertEqual((self.root / "a/b/c/d.txt").read_bytes(), b"x")
+
+    def test_reuses_existing_real_directory(self):
+        (self.root / "docs").mkdir()
+        extract([("docs/x", b"x")], self.root)
+        self.assertEqual((self.root / "docs/x").read_bytes(), b"x")
+
+    def test_shared_parent_directory_in_one_batch(self):
+        extract([("d/a", b"1"), ("d/b", b"2")], self.root)
+        self.assertEqual(self.snapshot(self.root), ["d", "d/a", "d/b"])
+
+    def test_literal_percent_and_unicode_names(self):
+        names = ["100%.txt", "a%2Fb", "naïve/ü.txt"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
+        for name in names:
+            self.assertEqual((self.root / name).read_bytes(), b"x")
+
+    def test_similar_names_do_not_collide(self):
+        names = ["a", "ab", "a.b", "a-b/c"]
+        self.assertEqual(extract([(n, b"") for n in names], self.root), names)
+
+    def test_dot_prefixed_and_triple_dot_components_are_allowed(self):
+        names = ["...", ".hidden/x", "...x"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
