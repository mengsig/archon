 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import copy
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _is_int(value):
+    # type() check: bool and int subclasses are rejected
+    return type(value) is int
+
+
+def _check_amount(amount):
+    if not _is_int(amount) or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"amount must be an int in [1, MAX_BALANCE], got {amount!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+        for name, balance in balances.items():
+            if type(name) is not str or not name:
+                raise ValueError(f"invalid account name {name!r}")
+            if not _is_int(balance) or not 0 <= balance <= MAX_BALANCE:
+                raise ValueError(f"invalid balance for {name!r}: {balance!r}")
+        # one lock guards every read and write: no ordering needed, no deadlock
+        self._lock = threading.Lock()
+        self._balances = copy.deepcopy(balances)
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        with self._lock:
+            source_balance = self._balances[source]
+            destination_balance = self._balances[destination]
+            if source == destination:
+                return source_balance >= amount
+            if source_balance < amount:
+                return False
+            if destination_balance + amount > MAX_BALANCE:
+                return False
+            self._balances[source] = source_balance - amount
+            self._balances[destination] = destination_balance + amount
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return copy.deepcopy(self._balances)
