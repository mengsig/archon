@@ -0,0 +1,89 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("write report", tags=["work", "urgent"])
+    store.add("buy milk")
+    store.add("login page: redesign", tags=["web"])
+    store.complete(store.all()[2].id)
+    return store
+
+
+def _titles(query):
+    return [t.title for t in search(_store().all(), query)]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(_titles("LOGIN"), ["Fix login bug", "login page: redesign"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_titles('"fix login"'), ["Fix login bug"])
+        self.assertEqual(_titles('"login bug"'), ["Fix login bug"])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(_titles("login bug"), ["Fix login bug"])
+        self.assertEqual(_titles("login milk"), [])
+
+    def test_quoted_colon_is_text_not_field(self):
+        self.assertEqual(_titles('"page: redesign"'), ["login page: redesign"])
+
+    def test_tag_is_exact_and_case_insensitive(self):
+        self.assertEqual(_titles("tag:WORK"), ["Fix login bug", "write report"])
+        self.assertEqual(_titles("tag:wor"), [])
+
+    def test_tag_with_quoted_value(self):
+        self.assertEqual(_titles('tag:"urgent"'), ["write report"])
+
+    def test_status_filters(self):
+        self.assertEqual(_titles("status:done"), ["buy milk"])
+        self.assertEqual(_titles("status:OPEN"), ["Fix login bug", "write report", "login page: redesign"])
+
+    def test_combined_terms(self):
+        self.assertEqual(_titles("tag:work status:open login"), ["Fix login bug"])
+
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   ", "\t"]:
+            self.assertEqual(len(_titles(query)), 4, query)
+        self.assertEqual(_titles("")[0], "Fix login bug")
+
+    def test_empty_quoted_phrase_matches_every_title(self):
+        self.assertEqual(len(_titles('""')), 4)
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            _titles("due:today")
+        with self.assertRaises(QueryError):
+            _titles(":x")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            _titles("status:closed")
+
+    def test_empty_tag_raises(self):
+        with self.assertRaises(QueryError):
+            _titles("tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            _titles('"fix login')
+
+    def test_query_error_is_value_error(self):
+        self.assertTrue(issubclass(QueryError, ValueError))
+
+    def test_non_string_query_is_type_error(self):
+        with self.assertRaises(TypeError):
+            search(_store().all(), None)
+
+    def test_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:bogus")
+
+
+if __name__ == "__main__":
+    unittest.main()
