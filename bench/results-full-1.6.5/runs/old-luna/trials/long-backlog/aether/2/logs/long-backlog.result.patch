diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..500c324 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,50 @@
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    active = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            active = True
+        elif char.isspace() and not quoted:
+            if active:
+                terms.append("".join(current))
+                current = []
+                active = False
+        else:
+            current.append(char)
+            active = True
+    if quoted:
+        raise QueryError("unterminated quote")
+    if active:
+        terms.append("".join(current))
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    def matches(task):
+        for term in terms:
+            if ":" not in term:
+                if term.casefold() not in task.title.casefold():
+                    return False
+                continue
+            field, value = term.split(":", 1)
+            field, value = field.casefold(), value.casefold()
+            if field == "tag":
+                if not value or value not in (tag.casefold() for tag in task.tags):
+                    return False
+            elif field == "status":
+                if value not in ("open", "done"):
+                    raise QueryError(f"unknown status: {term.split(':', 1)[1]}")
+                if task.status.casefold() != value:
+                    return False
+            else:
+                raise QueryError(f"unknown query field: {field}")
+        return True
+    return [task for task in tasks if matches(task)]
