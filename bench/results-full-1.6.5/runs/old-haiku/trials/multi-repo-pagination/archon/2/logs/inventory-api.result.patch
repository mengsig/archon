     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    remaining = [item for item in items if item["id"] > after_id]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:]))
+    next_cursor = str(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_page_query(query):
+    return _parse_limit(query.get("limit")), _parse_cursor(query.get("cursor"))
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_digits(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise ValueError(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return 0
+    if not _is_digits(raw):
+        raise ValueError("cursor is invalid")
+    return int(raw)
+
+
+def _is_digits(raw):
+    return raw.isascii() and raw.isdigit()
 
 
