+  '': { items: [ITEMS[0]], next_cursor: 'c1' },
+  c1: { items: [ITEMS[1]], next_cursor: null },
+};
+
+function paged(requests) {
+  return async (request) => {
+    requests.push(request.query);
+    if (request.path !== '/items') return { status: 404, body: { error: 'not found' } };
+    return { status: 200, body: PAGES[request.query.cursor ?? ''] };
+  };
+}
+
 test('lists items', async () => {
