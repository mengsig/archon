+// Follows next_cursor until it is null or absent, returning every item in order.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (body === null || typeof body !== 'object' || !Array.isArray(body.items)) {
+      throw new Error(`GET /items returned no items array: ${JSON.stringify(body)}`);
+    }
+    const next = body.next_cursor ?? undefined;
+    if (next !== undefined && typeof next !== 'string') {
+      throw new Error(`GET /items returned a non-string next_cursor: ${JSON.stringify(next)}`);
+    }
+    if (next !== undefined && seenCursors.has(next)) {
+      throw new Error(`GET /items repeated next_cursor ${next}; refusing to loop forever`);
+    }
+    if (next !== undefined) seenCursors.add(next);
+    items.push(...body.items);
+    cursor = next;
+  } while (cursor !== undefined);
+  return items;
 }
 
