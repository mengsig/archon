+class SandboxCase(unittest.TestCase):
+    """Each test gets a fresh root and an outside sibling directory."""
+
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        base = Path(self._tmp.name)
+        self.root = base / "root"
+        self.root.mkdir()
+        self.outside = base / "outside"
+        self.outside.mkdir()
+
+    def assert_root_empty(self):
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def assert_rejected_without_changes(self, entries, root=None):
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assert_root_empty()
+        self.assertEqual(list(self.outside.iterdir()), [])
+
+
+class BatchShape(SandboxCase):
+    def test_tuple_batch_rejected(self):
+        self.assert_rejected_without_changes(tuple())
+
+    def test_tuple_of_entries_rejected(self):
+        self.assert_rejected_without_changes((("a", b"x"),))
+
+    def test_none_rejected(self):
+        self.assert_rejected_without_changes(None)
+
+    def test_generator_rejected_and_not_consumed(self):
+        gen = ((name, b"x") for name in ["a", "b"])
+        with self.assertRaises(ValueError):
+            extract(gen, self.root)
+        self.assertEqual(next(gen), ("a", b"x"))
+        self.assert_root_empty()
+
+    def test_iterator_rejected_even_when_empty(self):
+        with self.assertRaises(ValueError):
+            extract(iter([]), self.root)
+        self.assert_root_empty()
+
+
