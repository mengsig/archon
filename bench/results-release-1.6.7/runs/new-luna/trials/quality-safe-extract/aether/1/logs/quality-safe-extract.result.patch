diff --git a/safe_extract.py b/safe_extract.py
index 0007027..c3fb5d2 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,92 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
 
-def extract(entries, root):
-    raise NotImplementedError
+
+def _root_path(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a path string or pathlib.Path")
+    try:
+        path = Path(root)
+    except (TypeError, ValueError):
+        raise ValueError("invalid root path") from None
+
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        raise ValueError("root must already exist") from None
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
+        raise ValueError("root must be a real directory")
+    return path
+
+
+def _validate_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError("entry names must be nonempty strings")
+    if name.startswith("/") or "\\" in name or ":" in name or "\0" in name:
+        raise ValueError("entry name is not a supported relative POSIX path")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError("entry name contains an invalid path component")
+    return parts
+
+
+def _validate_entries(entries):
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    names = []
+    name_set = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        parts = _validate_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in name_set:
+            raise ValueError("duplicate entry name")
+        name_set.add(name)
+        names.append((name, parts, data))
+
+    for name, parts, _ in names:
+        for index in range(1, len(parts)):
+            if "/".join(parts[:index]) in name_set:
+                raise ValueError("file and directory paths collide")
+    return names
+
+
+def _validate_destination(root, parts):
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        is_target = index == len(parts) - 1
+        try:
+            info = current.lstat()
+        except FileNotFoundError:
+            continue
+
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError("destination path contains a symlink")
+        if is_target:
+            raise ValueError("destination already exists")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError("destination parent is not a directory")
+
+
+def extract(entries, root) -> list[str]:
+    """Write regular files beneath an existing directory after full validation."""
+    validated = _validate_entries(entries)
+    root_path = _root_path(root)
+
+    for _, parts, _ in validated:
+        _validate_destination(root_path, parts)
+
+    for _, parts, data in validated:
+        destination = root_path.joinpath(*parts)
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        with destination.open("xb") as output:
+            output.write(data)
+
+    return [name for name, _, _ in validated]
diff --git a/test_safe_extract.py b/test_safe_extract.py
index bbd5cb7..fa27ef8 100644
--- a/test_safe_extract.py
+++ b/test_safe_extract.py
@@ -18,3 +18,114 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractValidation(unittest.TestCase):
+    def test_non_list_batches_are_rejected_without_consuming_iterables(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            consumed = []
+
+            def entries():
+                consumed.append(True)
+                yield ("file", b"data")
+
+            for batch in ((), iter(()), entries()):
+                with self.subTest(batch=type(batch).__name__):
+                    with self.assertRaises(ValueError):
+                        extract(batch, root)
+            self.assertEqual(consumed, [])
+            self.assertEqual(list(root.iterdir()), [])
+
+    def test_malformed_entries_and_names_are_rejected_before_writes(self):
+        bad_batches = [
+            [("a",)],
+            [["a", b"data"]],
+            [(1, b"data")],
+            [("a", bytearray(b"data"))],
+            [("", b"")],
+            [("/absolute", b"")],
+            [("a//b", b"")],
+            [("a/./b", b"")],
+            [("a/../b", b"")],
+            [("a\\b", b"")],
+            [("C:drive", b"")],
+            [("nul\0name", b"")],
+        ]
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            for batch in bad_batches:
+                with self.subTest(batch=batch):
+                    with self.assertRaises(ValueError):
+                        extract(batch, root)
+                    self.assertEqual(list(root.iterdir()), [])
+
+    def test_literal_percent_is_preserved_and_duplicates_are_rejected(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            self.assertEqual(extract([("100%25.txt", b"ok")], root), ["100%25.txt"])
+            self.assertEqual((root / "100%25.txt").read_bytes(), b"ok")
+            with self.assertRaises(ValueError):
+                extract([("dup", b"1"), ("dup", b"2")], root)
+
+    def test_file_directory_collisions_in_either_order(self):
+        for batch in (
+            [("a", b"file"), ("a/b", b"child")],
+            [("a/b", b"child"), ("a", b"file")],
+        ):
+            with self.subTest(batch=batch), tempfile.TemporaryDirectory(dir=".") as directory:
+                root = Path(directory)
+                with self.assertRaises(ValueError):
+                    extract(batch, root)
+                self.assertEqual(list(root.iterdir()), [])
+
+    def test_existing_targets_and_non_directory_parents_are_rejected(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            (root / "occupied").write_bytes(b"original")
+            with self.assertRaises(ValueError):
+                extract([("new/file", b"new"), ("occupied", b"replace")], root)
+            self.assertFalse((root / "new").exists())
+            self.assertEqual((root / "occupied").read_bytes(), b"original")
+            with self.assertRaises(ValueError):
+                extract([("occupied/child", b"x")], root)
+
+    def test_symlink_components_targets_and_root_are_rejected(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            base = Path(directory)
+            root = base / "root"
+            root.mkdir()
+            outside = base / "outside"
+            outside.mkdir()
+            (outside / "keep").write_bytes(b"safe")
+            (root / "link").symlink_to(outside, target_is_directory=True)
+            (root / "dangling").symlink_to(base / "missing")
+            for name in ("link/new", "dangling"):
+                with self.subTest(name=name), self.assertRaises(ValueError):
+                    extract([(name, b"bad")], root)
+            with self.assertRaises(ValueError):
+                extract([], root / "link")
+            self.assertEqual((outside / "keep").read_bytes(), b"safe")
+            self.assertEqual(list(outside.iterdir()), [outside / "keep"])
+
+    def test_root_must_be_an_existing_non_symlink_directory(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            base = Path(directory)
+            file_path = base / "file"
+            file_path.write_bytes(b"")
+            for root in (base / "missing", file_path, 42):
+                with self.subTest(root=root), self.assertRaises(ValueError):
+                    extract([], root)
+            link = base / "root-link"
+            link.symlink_to(base, target_is_directory=True)
+            with self.assertRaises(ValueError):
+                extract([], link)
+
+    def test_invalid_later_destination_prevents_earlier_directories(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            (root / "blocked").write_bytes(b"stay")
+            with self.assertRaises(ValueError):
+                extract([("would/create/file", b"new"), ("blocked/child", b"bad")], root)
+            self.assertFalse((root / "would").exists())
+            self.assertEqual((root / "blocked").read_bytes(), b"stay")
