+    def test_default_page_size(self):
+        res = get("/items")
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_following_cursors_yields_every_item_once(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "7"} if cursor is None else {"limit": "7", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            ids.extend(item["id"] for item in res["body"]["items"])
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor_even_when_exactly_full(self):
+        res = get("/items", limit="57")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_invalid_limit_is_400(self):
+        for limit in ["0", "101", "-1", "abc", "", "1.5", "+5"]:
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ["", "abc", "-3", "1.0"]:
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("error", res["body"])
+
