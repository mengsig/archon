--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,47 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_has_only_header(self):
+        self.assertEqual(to_csv([]), "id,title,tags,status,due\r\n")
+
+    def test_plain_rows_are_unquoted_and_crlf_terminated(self):
+        tasks = [
+            Task(1, "plain title", ["a", "b"], "open", date(2026, 4, 1)),
+            Task(2, "no extras", [], "done", None),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n"
+            "1,plain title,a;b,open,2026-04-01\r\n"
+            "2,no extras,,done,\r\n",
+        )
+
+    def test_title_with_comma_is_quoted(self):
+        out = to_csv([Task(1, "buy eggs, milk", status="open")])
+        self.assertEqual(out.splitlines()[1], '1,"buy eggs, milk",,open,')
+
+    def test_embedded_quotes_are_doubled_and_wrapped(self):
+        out = to_csv([Task(1, 'say "hi"', status="open")])
+        self.assertEqual(out.splitlines()[1], '1,"say ""hi""",,open,')
+
+    def test_newlines_and_carriage_returns_are_quoted(self):
+        out = to_csv([Task(1, "line1\nline2", status="open"), Task(2, "a\rb", status="open")])
+        self.assertEqual(out, 'id,title,tags,status,due\r\n1,"line1\nline2",,open,\r\n2,"a\rb",,open,\r\n')
+
+    def test_tag_containing_comma_is_quoted(self):
+        out = to_csv([Task(1, "x", ["a,b", "c"], "open")])
+        self.assertEqual(out.splitlines()[1], '1,x,"a,b;c",open,')
+
+    def test_row_order_follows_input(self):
+        tasks = [Task(3, "third", status="open"), Task(1, "first", status="open")]
+        ids = [line.split(",")[0] for line in to_csv(tasks).split("\r\n")[1:-1]]
+        self.assertEqual(ids, ["3", "1"])
+
+
+if __name__ == "__main__":
+    unittest.main()
