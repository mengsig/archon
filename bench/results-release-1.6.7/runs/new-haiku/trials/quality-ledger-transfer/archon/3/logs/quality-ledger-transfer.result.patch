+class LedgerConcurrency(unittest.TestCase):
+    def _run_threads(self, targets):
+        threads = [threading.Thread(target=target, daemon=True) for target in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=THREAD_JOIN_TIMEOUT_SECONDS)
+            self.assertFalse(thread.is_alive(), "thread did not finish: possible deadlock")
+
+    def test_opposite_transfers_complete_without_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        results = []
+
+        def forward():
+            results.extend(ledger.transfer("a", "b", 1) for _ in range(1000))
+
+        def backward():
+            results.extend(ledger.transfer("b", "a", 1) for _ in range(1000))
+
+        self._run_threads([forward, backward])
+        self.assertEqual(len(results), 2000)
+        self.assertTrue(all(results))
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_concurrent_transfers_preserve_total_and_snapshots_are_consistent(self):
+        ledger = Ledger({"a": 1000, "b": 1000, "c": 1000})
+        total = 3000
+        results = []
+        snapshots = []
+
+        def ab_then_ba():
+            results.extend(ledger.transfer("a", "b", 1) for _ in range(500))
+            results.extend(ledger.transfer("b", "a", 1) for _ in range(500))
+
+        def bc_then_cb():
+            results.extend(ledger.transfer("b", "c", 1) for _ in range(500))
+            results.extend(ledger.transfer("c", "b", 1) for _ in range(500))
+
+        def take_snapshots():
+            for _ in range(300):
+                snapshots.append(ledger.snapshot())
+
+        self._run_threads([ab_then_ba, bc_then_cb, take_snapshots])
+        self.assertEqual(len(results), 2000)
+        self.assertTrue(all(results))
+        self.assertEqual(len(snapshots), 300)
+        for snap in snapshots:
+            self.assertEqual(sum(snap.values()), total)
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000, "c": 1000})
+
+
+if __name__ == "__main__":
+    unittest.main()
