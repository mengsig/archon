+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation_and_copying(self):
+        for value in (None, [], {"": 0}, {1: 0}, {"a": True},
+                      {"a": -1}, {"a": MAX_BALANCE + 1}, {"a": 1.0}):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    Ledger(value)
+
+        original = {"a": 1}
+        ledger = Ledger(original)
+        original["a"] = 99
+        result = ledger.snapshot()
+        result["a"] = 88
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also-missing", amount)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+    def test_overflow_and_self_transfer(self):
+        ledger = Ledger({"a": 10, "full": MAX_BALANCE})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("a", "full", 1), False)
+        self.assertEqual(ledger.snapshot(), before)
+        self.assertIs(ledger.transfer("full", "full", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("a", "a", 11), False)
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_concurrent_opposite_transfers_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        barrier = Barrier(3)
+
+        def move(source, destination):
+            barrier.wait()
+            for _ in range(500):
+                self.assertIs(ledger.transfer(source, destination, 1), True)
+
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            futures = [pool.submit(move, "a", "b"), pool.submit(move, "b", "a")]
+            barrier.wait()
+            for future in futures:
+                future.result()
+
+        snapshot = ledger.snapshot()
+        self.assertEqual(snapshot, {"a": 1000, "b": 1000})
+        self.assertEqual(sum(snapshot.values()), 2000)
