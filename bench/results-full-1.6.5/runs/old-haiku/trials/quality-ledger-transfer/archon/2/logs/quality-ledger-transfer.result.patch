+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": 0})
+
+    def test_destination_overflow_fails_unchanged(self):
+        ledger = Ledger({"a": 10, "b": MAX_BALANCE - 5})
+        self.assertIs(ledger.transfer("a", "b", 6), False)
+        self.assertEqual(ledger.snapshot(), {"a": 10, "b": MAX_BALANCE - 5})
