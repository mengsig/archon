diff --git a/src/status.rs b/src/status.rs
new file mode 100644
index 0000000..62553a2
--- /dev/null
+++ b/src/status.rs
@@ -0,0 +1,114 @@
+use std::error::Error;
+use std::fmt;
+use std::str::FromStr;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum OrderStatus {
+    Pending,
+    Paid,
+    Shipped,
+    Cancelled,
+}
+
+const ALL: [OrderStatus; 4] = [
+    OrderStatus::Pending,
+    OrderStatus::Paid,
+    OrderStatus::Shipped,
+    OrderStatus::Cancelled,
+];
+
+impl OrderStatus {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            OrderStatus::Pending => "pending",
+            OrderStatus::Paid => "paid",
+            OrderStatus::Shipped => "shipped",
+            OrderStatus::Cancelled => "cancelled",
+        }
+    }
+
+    pub fn can_transition_to(self, next: OrderStatus) -> bool {
+        matches!(
+            (self, next),
+            (OrderStatus::Pending, OrderStatus::Paid)
+                | (OrderStatus::Pending, OrderStatus::Cancelled)
+                | (OrderStatus::Paid, OrderStatus::Shipped)
+                | (OrderStatus::Paid, OrderStatus::Cancelled)
+        )
+    }
+}
+
+impl fmt::Display for OrderStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.pad(self.as_str())
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ParseStatusError {
+    input: String,
+}
+
+impl fmt::Display for ParseStatusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "unknown status {:?}", self.input)
+    }
+}
+
+impl Error for ParseStatusError {}
+
+impl FromStr for OrderStatus {
+    type Err = ParseStatusError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        ALL.into_iter()
+            .find(|status| status.as_str() == s)
+            .ok_or_else(|| ParseStatusError {
+                input: s.to_string(),
+            })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn can_transition_to_allows_only_the_lifecycle_edges() {
+        let allowed = [
+            (OrderStatus::Pending, OrderStatus::Paid),
+            (OrderStatus::Pending, OrderStatus::Cancelled),
+            (OrderStatus::Paid, OrderStatus::Shipped),
+            (OrderStatus::Paid, OrderStatus::Cancelled),
+        ];
+        for from in ALL {
+            for to in ALL {
+                assert_eq!(
+                    from.can_transition_to(to),
+                    allowed.contains(&(from, to)),
+                    "{from} -> {to}"
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn names_round_trip_through_display_and_from_str() {
+        for status in ALL {
+            assert_eq!(status.to_string(), status.as_str());
+            assert_eq!(status.as_str().parse::<OrderStatus>(), Ok(status));
+        }
+    }
+
+    #[test]
+    fn from_str_rejects_other_text_and_names_it() {
+        let err = "Paid".parse::<OrderStatus>().unwrap_err();
+        assert_eq!(err.to_string(), "unknown status \"Paid\"");
+        let _: &dyn Error = &err;
+    }
+
+    #[test]
+    fn display_honours_width_like_the_plain_name() {
+        assert_eq!(format!("{:>10}|", OrderStatus::Paid), "      paid|");
+    }
+}
diff --git a/tests/characterization_csv.rs b/tests/characterization_csv.rs
new file mode 100644
index 0000000..f68ea3b
--- /dev/null
+++ b/tests/characterization_csv.rs
@@ -0,0 +1,123 @@
+use orders::{report, Order};
+
+#[test]
+fn known_statuses_round_trip_through_csv_lines() {
+    // (line, status text the parsed order must report)
+    let table = [
+        ("1,ada,100,pending", "pending"),
+        ("2,bob,250,paid", "paid"),
+        ("3,cy,75,shipped", "shipped"),
+        ("4,dee,0,cancelled", "cancelled"),
+    ];
+    for (line, status) in table {
+        let order = report::from_line(line).unwrap();
+        assert_eq!(order.status.to_string(), status, "status of {line}");
+        assert_eq!(report::to_line(&order), line);
+    }
+}
+
+#[test]
+fn from_line_trims_only_the_ends_of_the_line() {
+    let order = report::from_line("  7,cy,75,paid \n").unwrap();
+    assert_eq!(order.id, 7);
+    assert_eq!(order.status.to_string(), "paid");
+
+    let order = report::from_line("1, ada ,100,paid").unwrap();
+    assert_eq!(order.customer, " ada ");
+}
+
+#[test]
+fn from_line_rejects_wrong_field_counts() {
+    assert_eq!(
+        report::from_line("").unwrap_err(),
+        "expected 4 fields, got 1"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("1,a,b,100,paid").unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+}
+
+#[test]
+fn from_line_reports_bad_numbers_with_the_rejected_text() {
+    assert_eq!(
+        report::from_line("x,ada,100,paid").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("4294967296,ada,1,paid").unwrap_err(),
+        "bad id \"4294967296\": number too large to fit in target type"
+    );
+    assert_eq!(
+        report::from_line("1,ada,-5,paid").unwrap_err(),
+        "bad total \"-5\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,,paid").unwrap_err(),
+        "bad total \"\": cannot parse integer from empty string"
+    );
+}
+
+#[test]
+fn from_line_rejects_unknown_status_text_exactly() {
+    assert_eq!(
+        report::from_line("4,dee,1,lost").unwrap_err(),
+        "unknown status \"lost\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,Paid").unwrap_err(),
+        "unknown status \"Paid\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,100, paid").unwrap_err(),
+        "unknown status \" paid\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,").unwrap_err(),
+        "unknown status \"\""
+    );
+}
+
+#[test]
+fn from_line_checks_field_count_then_id_then_total_then_status() {
+    assert_eq!(
+        report::from_line("x,ada").unwrap_err(),
+        "expected 4 fields, got 2"
+    );
+    assert_eq!(
+        report::from_line("x,ada,bad,lost").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,bad,lost").unwrap_err(),
+        "bad total \"bad\": invalid digit found in string"
+    );
+}
+
+#[test]
+fn from_line_accepts_any_known_status_without_checking_transitions() {
+    let order = report::from_line("9,zed,1,shipped").unwrap();
+    assert_eq!(order.status.to_string(), "shipped");
+    assert!(!order.is_open());
+}
+
+#[test]
+fn empty_customer_is_allowed() {
+    let order = report::from_line("1,,100,pending").unwrap();
+    assert_eq!(order.customer, "");
+}
+
+#[test]
+fn commas_in_customer_names_break_the_round_trip() {
+    let order = Order::new(1, "a,b", 100);
+    let line = report::to_line(&order);
+    assert_eq!(line, "1,a,b,100,pending");
+    assert_eq!(
+        report::from_line(&line).unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+}
diff --git a/tests/characterization_lifecycle.rs b/tests/characterization_lifecycle.rs
new file mode 100644
index 0000000..1b76fa2
--- /dev/null
+++ b/tests/characterization_lifecycle.rs
@@ -0,0 +1,104 @@
+use orders::{billing, shipping, Order};
+
+fn order_in(status: &str) -> Order {
+    let mut order = Order::new(1, "ada", 100);
+    match status {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("no lifecycle path reaches status {other}"),
+    }
+    order
+}
+
+#[test]
+fn each_status_allows_only_the_documented_operations() {
+    // (start, pay ok, ship ok, cancel ok, is_open)
+    let table = [
+        ("pending", true, false, true, true),
+        ("paid", false, true, true, true),
+        ("shipped", false, false, false, false),
+        ("cancelled", false, false, false, false),
+    ];
+    for (start, pay_ok, ship_ok, cancel_ok, open) in table {
+        assert_eq!(order_in(start).is_open(), open, "is_open from {start}");
+        assert_eq!(
+            billing::pay(&mut order_in(start)).is_ok(),
+            pay_ok,
+            "pay from {start}"
+        );
+        assert_eq!(
+            shipping::ship(&mut order_in(start)).is_ok(),
+            ship_ok,
+            "ship from {start}"
+        );
+        assert_eq!(
+            order_in(start).cancel().is_ok(),
+            cancel_ok,
+            "cancel from {start}"
+        );
+    }
+}
+
+#[test]
+fn cancel_moves_pending_and_paid_orders_to_cancelled() {
+    let mut pending = order_in("pending");
+    pending.cancel().unwrap();
+    assert_eq!(pending.status.to_string(), "cancelled");
+
+    let mut paid = order_in("paid");
+    paid.cancel().unwrap();
+    assert_eq!(paid.status.to_string(), "cancelled");
+    assert!(!paid.is_open());
+}
+
+#[test]
+fn refused_operations_name_the_current_status_and_leave_it_unchanged() {
+    let mut paid = order_in("paid");
+    assert_eq!(
+        billing::pay(&mut paid).unwrap_err(),
+        "order 1 cannot be paid: it is paid"
+    );
+    assert_eq!(paid.status.to_string(), "paid");
+
+    let mut pending = order_in("pending");
+    assert_eq!(
+        shipping::ship(&mut pending).unwrap_err(),
+        "order 1 cannot be shipped: it is pending"
+    );
+    assert_eq!(pending.status.to_string(), "pending");
+
+    let mut shipped = order_in("shipped");
+    assert_eq!(
+        billing::pay(&mut shipped).unwrap_err(),
+        "order 1 cannot be paid: it is shipped"
+    );
+    assert_eq!(
+        shipping::ship(&mut shipped).unwrap_err(),
+        "order 1 cannot be shipped: it is shipped"
+    );
+    assert_eq!(
+        shipped.cancel().unwrap_err(),
+        "order 1 cannot be cancelled: it is shipped"
+    );
+    assert_eq!(shipped.status.to_string(), "shipped");
+
+    let mut cancelled = order_in("cancelled");
+    assert_eq!(
+        billing::pay(&mut cancelled).unwrap_err(),
+        "order 1 cannot be paid: it is cancelled"
+    );
+    assert_eq!(
+        shipping::ship(&mut cancelled).unwrap_err(),
+        "order 1 cannot be shipped: it is cancelled"
+    );
+    assert_eq!(
+        cancelled.cancel().unwrap_err(),
+        "order 1 cannot be cancelled: it is cancelled"
+    );
+    assert_eq!(cancelled.status.to_string(), "cancelled");
+}
diff --git a/tests/characterization_reports.rs b/tests/characterization_reports.rs
new file mode 100644
index 0000000..9e4a090
--- /dev/null
+++ b/tests/characterization_reports.rs
@@ -0,0 +1,61 @@
+use orders::{billing, report, shipping, Order};
+
+fn order(id: u32, total_cents: u64, status: &str) -> Order {
+    report::from_line(&format!("{id},c,{total_cents},{status}")).unwrap()
+}
+
+fn counts_as_text(orders: &[Order]) -> Vec<(String, usize)> {
+    report::status_counts(orders)
+        .into_iter()
+        .map(|(status, n)| (status.to_string(), n))
+        .collect()
+}
+
+#[test]
+fn status_counts_sort_by_status_name_not_by_lifecycle_order() {
+    let orders = vec![
+        order(1, 1, "shipped"),
+        order(2, 1, "pending"),
+        order(3, 1, "cancelled"),
+        order(4, 1, "paid"),
+        order(5, 1, "pending"),
+    ];
+    let expected: Vec<(String, usize)> = vec![
+        ("cancelled".into(), 1),
+        ("paid".into(), 1),
+        ("pending".into(), 2),
+        ("shipped".into(), 1),
+    ];
+    assert_eq!(counts_as_text(&orders), expected);
+}
+
+#[test]
+fn status_counts_of_no_orders_is_empty() {
+    assert!(counts_as_text(&[]).is_empty());
+}
+
+#[test]
+fn outstanding_cents_sums_only_pending_orders() {
+    let orders = vec![
+        order(1, 100, "pending"),
+        order(2, 1000, "paid"),
+        order(3, 250, "pending"),
+        order(4, 5000, "shipped"),
+        order(5, 9000, "cancelled"),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 350);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_lists_paid_ids_in_input_order() {
+    let orders = vec![
+        order(5, 1, "paid"),
+        order(2, 1, "pending"),
+        order(9, 1, "paid"),
+        order(1, 1, "shipped"),
+        order(3, 1, "paid"),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [5, 9, 3]);
+    assert!(shipping::ready_to_ship(&[]).is_empty());
+}
