+import base64
+import binascii
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,46 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after_id = 0
+    if "cursor" in query:
+        after_id = _decode_cursor(query["cursor"])
+        if after_id is None:
+            return _error(400, "invalid cursor")
+
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    remaining = [item for item in ordered if item["id"] > after_id]
+    page = remaining[:limit]
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:])), "ids must be unique and ordered"
+    has_more = len(remaining) > limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not (raw.isascii() and raw.isdigit()):
+        return None
+    limit = int(raw)
+    return limit if 1 <= limit <= MAX_LIMIT else None
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    """Return the id the page starts after, or None when the cursor is invalid."""
+    try:
+        decoded = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except (binascii.Error, UnicodeDecodeError, ValueError):
+        return None
+    if not decoded.isdigit():
+        return None
+    return int(decoded)
 
 
