 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  let cursor = null;
+  do {
+    const query = cursor === null ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error(`GET /items returned no items array: ${JSON.stringify(body)}`);
+    }
+    items.push(...body.items);
+    const next = body.next_cursor ?? null;
+    if (next !== null && typeof next !== 'string') {
+      throw new Error(`GET /items returned a non-string next_cursor: ${JSON.stringify(next)}`);
+    }
+    if (next !== null && next === cursor) {
+      throw new Error(`GET /items returned the same cursor twice: ${JSON.stringify(next)}`);
+    }
+    cursor = next;
+  } while (cursor !== null);
+  return items;
 }
 
