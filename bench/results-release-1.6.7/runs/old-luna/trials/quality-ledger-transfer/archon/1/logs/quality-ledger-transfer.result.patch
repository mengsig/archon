+class LedgerValidation(unittest.TestCase):
+    def test_constructor_validation(self):
+        for balances in (None, [], {"": 1}, {1: 1}, {"a": True},
+                         {"a": 1.0}, {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+    def test_empty_ledger_and_input_copy(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+        original = {"a": 8, "b": 2}
+        ledger = Ledger(original)
+        original["a"] = 0
+        original["c"] = 4
+        self.assertEqual(ledger.snapshot(), {"a": 8, "b": 2})
+
+        result = ledger.snapshot()
+        result["a"] = 0
+        result["c"] = 4
+        self.assertEqual(ledger.snapshot(), {"a": 8, "b": 2})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({"a": 2})
+        for amount in (None, True, 0, -1, MAX_BALANCE + 1, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 2})
+        for source, destination in (("missing", "a"), ("a", "missing"),
+                                    ([], "a"), ("a", [])):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_destination_overflow_is_atomic(self):
+        ledger = Ledger({"source": 3, "destination": MAX_BALANCE - 2})
+        self.assertIs(ledger.transfer("source", "destination", 3), False)
+        self.assertEqual(ledger.snapshot(),
+                         {"source": 3, "destination": MAX_BALANCE - 2})
+
+    def test_exact_ceiling_and_zero_balance(self):
+        ledger = Ledger({"source": MAX_BALANCE, "destination": 0})
+        self.assertIs(ledger.transfer("source", "destination", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"source": 0, "destination": MAX_BALANCE})
+
+    def test_same_account_does_not_change_even_at_ceiling(self):
+        ledger = Ledger({"a": MAX_BALANCE, "empty": 0})
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("empty", "empty", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE, "empty": 0})
+
+
+class LedgerConcurrency(unittest.TestCase):
+    def test_opposing_transfers_and_snapshots_are_atomic(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        start = Barrier(3)
+        pair = Barrier(2)
+        failures = []
+
+        def move(source, destination):
+            try:
+                start.wait(timeout=3)
+                for _ in range(1000):
+                    if not ledger.transfer(source, destination, 1):
+                        failures.append((source, destination))
+                    pair.wait(timeout=3)
+            except BaseException as exc:  # Make worker failures visible to the test.
+                failures.append(exc)
+
+        workers = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for worker in workers:
+            worker.start()
+        start.wait(timeout=3)
+
+        for _ in range(2000):
+            self.assertEqual(sum(ledger.snapshot().values()), 2000)
+        for worker in workers:
+            worker.join(timeout=3)
+            self.assertFalse(worker.is_alive(), "opposing transfers deadlocked")
+
+        self.assertEqual(failures, [])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
