@@ -0,0 +1,29 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+
+
+class SearchQueryTests(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login flow", ["Auth", "urgent"]),
+            Task(2, "fix logout", ["auth"], status="done"),
+            Task(3, "Repair login", ["web"]),
+        ]
+
+    def test_terms_phrases_and_case_insensitive_matching(self):
+        self.assertEqual([t.id for t in search(self.tasks, "FIX login")], [1])
+        self.assertEqual([t.id for t in search(self.tasks, '"fix login"')], [1])
+        self.assertEqual([t.id for t in search(self.tasks, 'login tag:WEB status:open')], [3])
+        self.assertEqual([t.id for t in search(self.tasks, "")], [1, 2, 3])
+        self.assertEqual([t.id for t in search(self.tasks, "  ")], [1, 2, 3])
+
+    def test_tag_exact_and_status(self):
+        self.assertEqual([t.id for t in search(self.tasks, "tag:auth")], [1, 2])
+        self.assertEqual([t.id for t in search(self.tasks, "status:DONE")], [2])
+
+    def test_invalid_queries(self):
+        for query in ('"unfinished phrase', "owner:me", "status:pending", "tag:"):
+            with self.subTest(query=query), self.assertRaises(QueryError):
+                search(self.tasks, query)
