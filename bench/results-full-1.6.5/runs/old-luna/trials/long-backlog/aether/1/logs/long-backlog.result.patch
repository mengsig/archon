diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..34b6c07 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,48 @@
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+        elif char.isspace() and not quoted:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+
+    def matches(task):
+        for term in terms:
+            if ":" not in term:
+                if term.casefold() not in task.title.casefold():
+                    return False
+                continue
+            field, value = term.split(":", 1)
+            field, value = field.casefold(), value.casefold()
+            if field == "tag":
+                if not any(value == tag.casefold() for tag in task.tags):
+                    return False
+            elif field == "status":
+                if value not in ("open", "done"):
+                    raise QueryError(f"unknown status: {value}")
+                if task.status.casefold() != value:
+                    return False
+            else:
+                raise QueryError(f"unknown field: {field}")
+        return True
+
+    return [task for task in tasks if matches(task)]
