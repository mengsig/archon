+++ b/tests/test_search.py
@@ -0,0 +1,71 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+
+TASKS = [
+    Task(1, "Write report", ["work"], "open"),
+    Task(2, "Buy milk", ["home", "Errands"], "done"),
+    Task(3, "fix login page", ["Work", "urgent"], "open"),
+    Task(4, "Fix LOGIN bug", [], "done"),
+]
+
+
+def ids(tasks):
+    return [task.id for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def test_bare_word_matches_title_case_insensitively(self):
+        self.assertEqual(ids(search(TASKS, "report")), [1])
+        self.assertEqual(ids(search(TASKS, "LOGIN")), [3, 4])
+
+    def test_bare_word_does_not_match_tags(self):
+        self.assertEqual(ids(search(TASKS, "urgent")), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(ids(search(TASKS, '"fix login"')), [3, 4])
+        self.assertEqual(ids(search(TASKS, '"fix page"')), [])
+        self.assertEqual(ids(search(TASKS, "fix page")), [3])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(ids(search(TASKS, "fix login status:open")), [3])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(ids(search(TASKS, "tag:work")), [1, 3])
+        self.assertEqual(ids(search(TASKS, "tag:errand")), [])
+        self.assertEqual(ids(search(TASKS, "tag:ERRANDS")), [2])
+
+    def test_status_filters(self):
+        self.assertEqual(ids(search(TASKS, "status:open")), [1, 3])
+        self.assertEqual(ids(search(TASKS, "STATUS:Done")), [2, 4])
+
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(ids(search(TASKS, "")), [1, 2, 3, 4])
+        self.assertEqual(ids(search(TASKS, "   \t ")), [1, 2, 3, 4])
+
+    def test_no_tasks_gives_empty_result(self):
+        self.assertEqual(search([], "anything"), [])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "status:closed")
+
+    def test_empty_tag_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, '"fix login')
+
+    def test_quoted_colon_is_a_phrase_not_a_field(self):
+        self.assertEqual(ids(search(TASKS, '"due:today"')), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_store_undo.py b/tests/test_store_undo.py
new file mode 100644
index 0000000..5f5fd54
