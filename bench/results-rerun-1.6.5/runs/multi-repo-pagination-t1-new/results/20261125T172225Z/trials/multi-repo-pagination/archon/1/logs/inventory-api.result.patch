@@ -24,6 +24,53 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_size(self):
+        res = get("/items")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 20)
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_limit_bounds(self):
+        for limit in ["0", "101", "-1", "1.5", "abc", ""]:
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("error", res["body"])
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        full = get("/items", limit="100")["body"]
+        self.assertEqual(len(full["items"]), 57)
+        self.assertIsNone(full["next_cursor"])
+
+    def test_walking_pages_returns_every_item_once_in_order(self):
+        seen = []
+        cursor = None
+        while True:
+            query = {"limit": "7"} if cursor is None else {"limit": "7", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            seen.extend(item["id"] for item in res["body"]["items"])
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, sorted(seen))
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        first = get("/items", limit="30")
+        last = get("/items", limit="30", cursor=first["body"]["next_cursor"])
+        self.assertEqual(len(last["body"]["items"]), 27)
+        self.assertIsNone(last["body"]["next_cursor"])
+
+    def test_exact_multiple_page_has_null_next_cursor(self):
+        res = get("/items", limit="57")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ["!!!", "not base64", "bm90LWEtbnVtYmVy", "MA==", "OTk5"]:
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
