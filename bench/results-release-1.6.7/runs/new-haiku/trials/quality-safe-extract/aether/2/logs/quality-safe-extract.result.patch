+class BatchTypeTests(ExtractCase):
+    def test_non_list_batches_are_rejected(self):
+        for batch in [(), (("a", b""),), None, {}, "ab"]:
+            with self.subTest(batch=batch):
+                self.assert_rejected_unchanged(batch)
+
+    def test_generator_and_iterator_are_not_consumed(self):
+        consumed = []
+
+        def generator():
+            consumed.append("started")
+            yield ("a", b"")
+
+        gen = generator()
+        with self.assertRaises(ValueError):
+            extract(gen, self.root)
+        self.assertEqual(consumed, [])
+        self.assertEqual(list(gen), [("a", b"")])
+
+        iterator = iter([("a", b"")])
+        with self.assertRaises(ValueError):
+            extract(iterator, self.root)
+        self.assertEqual(next(iterator), ("a", b""))
+
+    def test_empty_tuple_and_empty_generator_are_rejected(self):
+        self.assert_rejected_unchanged(())
+        self.assert_rejected_unchanged(x for x in [])
