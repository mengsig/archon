+import os
 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
@@ -18,3 +20,279 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ScratchRootTestCase(unittest.TestCase):
+    def setUp(self):
+        scratch = tempfile.TemporaryDirectory()
+        self.addCleanup(scratch.cleanup)
+        self.base = Path(scratch.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assert_root_untouched(self):
+        self.assertEqual(sorted(self.root.iterdir()), [])
+
+
+class NonListBatch(ScratchRootTestCase):
+    def assert_rejected(self, batch):
+        with self.assertRaises(ValueError):
+            extract(batch, self.root)
+        self.assert_root_untouched()
+
+    def test_tuple_rejected_even_when_empty(self):
+        self.assert_rejected(())
+        self.assert_rejected((("a", b"x"),))
+
+    def test_generator_is_not_consumed(self):
+        produced = []
+
+        def generate():
+            for name in ["a", "b"]:
+                produced.append(name)
+                yield (name, b"x")
+
+        generator = generate()
+        with self.assertRaises(ValueError):
+            extract(generator, self.root)
+        self.assertEqual(produced, [])
+        self.assertEqual(list(generator), [("a", b"x"), ("b", b"x")])
+        self.assert_root_untouched()
+
+    def test_iterator_and_none_rejected(self):
+        self.assert_rejected(iter([("a", b"x")]))
+        self.assert_rejected(iter([]))
+        self.assert_rejected(None)
+
+
+class MalformedEntries(ScratchRootTestCase):
+    def assert_rejected(self, entries):
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assert_root_untouched()
+
+    def test_entry_must_be_two_tuple(self):
+        self.assert_rejected([["a", b"x"]])
+        self.assert_rejected([("a", b"x", "extra")])
+        self.assert_rejected([("a",)])
+        self.assert_rejected(["a"])
+
+    def test_name_must_be_str(self):
+        self.assert_rejected([(b"a", b"x")])
+        self.assert_rejected([(None, b"x")])
+
+    def test_data_must_be_bytes(self):
+        self.assert_rejected([("a", "text")])
+        self.assert_rejected([("a", bytearray(b"x"))])
+        self.assert_rejected([("a", memoryview(b"x"))])
+        self.assert_rejected([("a", None)])
+
+    def test_valid_prefix_does_not_leak_into_rejected_batch(self):
+        self.assert_rejected([("good/file", b"x"), ("bad", 5)])
+
+
+class UnsafeNames(ScratchRootTestCase):
+    def test_invalid_names_rejected(self):
+        bad_names = [
+            "",
+            "/abs",
+            "/",
+            "a\\b",
+            "c:d",
+            "C:/x",
+            "a\0b",
+            "a//b",
+            "a/",
+            "./x",
+            "a/./b",
+            "x/../y",
+            "..",
+            ".",
+        ]
+        for name in bad_names:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([(name, b"x")], self.root)
+                self.assert_root_untouched()
+
+    def test_literal_percent_is_kept_verbatim(self):
+        names = ["100%/file%20.txt", "%2e%2e"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
+        self.assertEqual((self.root / "100%/file%20.txt").read_bytes(), b"x")
+        self.assertEqual((self.root / "%2e%2e").read_bytes(), b"x")
+
+    def test_returns_names_in_input_order(self):
+        names = ["z", "a/b", "m/n/o", "a/c"]
+        result = extract([(n, b"") for n in names], self.root)
+        self.assertEqual(result, names)
+
+
+class BatchConflicts(ScratchRootTestCase):
+    def assert_conflict(self, names):
+        with self.assertRaises(ValueError):
+            extract([(n, b"x") for n in names], self.root)
+        self.assert_root_untouched()
+
+    def test_duplicate_names(self):
+        self.assert_conflict(["a", "a"])
+        self.assert_conflict(["a/b", "a/b"])
+
+    def test_file_then_directory_collision(self):
+        self.assert_conflict(["a", "a/b"])
+        self.assert_conflict(["a/b", "a/b/c"])
+
+    def test_directory_then_file_collision(self):
+        self.assert_conflict(["a/b", "a"])
+        self.assert_conflict(["a/b/c", "a/b"])
+
+    def test_conflict_later_in_batch_leaves_root_untouched(self):
+        self.assert_conflict(["ok/one", "ok/two", "ok", "ok/three"])
+
+
+class RootValidation(ScratchRootTestCase):
+    def test_string_root_is_accepted(self):
+        self.assertEqual(extract([("f", b"x")], str(self.root)), ["f"])
+        self.assertEqual((self.root / "f").read_bytes(), b"x")
+
+    def test_missing_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+        with self.assertRaises(ValueError):
+            extract([("f", b"x")], self.base / "missing" / "deeper")
+
+    def test_root_below_file_rejected(self):
+        plain = self.base / "plain"
+        plain.write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([], plain / "child")
+
+    def test_file_as_root_rejected(self):
+        plain = self.base / "plain"
+        plain.write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("f", b"x")], plain)
+        self.assertEqual(plain.read_bytes(), b"x")
+
+    def test_symlink_root_rejected(self):
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        with self.assertRaises(ValueError):
+            extract([("f", b"x")], link)
+        self.assert_root_untouched()
+
+    def test_empty_string_and_wrong_types_rejected(self):
+        for root in ["", 3, None, b"bytes-path"]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([], root)
+
+    def test_empty_batch_on_valid_root_succeeds(self):
+        self.assertEqual(extract([], self.root), [])
+        self.assert_root_untouched()
+
+
+class ExistingTargets(ScratchRootTestCase):
+    def test_existing_file_never_overwritten(self):
+        (self.root / "f").write_bytes(b"original")
+        with self.assertRaises(ValueError):
+            extract([("f", b"new")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"original")
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"x")], self.root)
+        self.assertEqual(sorted((self.root / "d").iterdir()), [])
+
+    def test_existing_file_as_ancestor_rejected(self):
+        (self.root / "f").write_bytes(b"original")
+        with self.assertRaises(ValueError):
+            extract([("f/child", b"x")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"original")
+        self.assertEqual(sorted(self.root.iterdir()), [self.root / "f"])
+
+    def test_existing_directories_are_reused(self):
+        (self.root / "d" / "sub").mkdir(parents=True)
+        self.assertEqual(extract([("d/sub/new", b"x")], self.root), ["d/sub/new"])
+        self.assertEqual((self.root / "d/sub/new").read_bytes(), b"x")
+
+
+class SymlinkEscapes(ScratchRootTestCase):
+    def setUp(self):
+        super().setUp()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def test_symlink_directory_outside_root_rejected(self):
+        os.symlink(self.outside, self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link/escaped", b"x")], self.root)
+        self.assertEqual(sorted(self.outside.iterdir()), [])
+
+    def test_symlink_directory_inside_root_rejected(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link/f", b"x")], self.root)
+        self.assertEqual(sorted((self.root / "real").iterdir()), [])
+
+    def test_dangling_symlink_at_target_is_not_followed(self):
+        os.symlink(self.outside / "made", self.root / "f")
+        with self.assertRaises(ValueError):
+            extract([("f", b"x")], self.root)
+        self.assertEqual(sorted(self.outside.iterdir()), [])
+
+    def test_dangling_symlink_as_ancestor_is_not_followed(self):
+        os.symlink(self.outside / "made", self.root / "d")
+        with self.assertRaises(ValueError):
+            extract([("d/f", b"x")], self.root)
+        self.assertEqual(sorted(self.outside.iterdir()), [])
+
+    def test_symlink_anywhere_in_batch_blocks_all_writes(self):
+        os.symlink(self.outside, self.root / "link")
+        entries = [("ok/first", b"x"), ("link/bad", b"y")]
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(sorted(self.root.iterdir()), [self.root / "link"])
+
+
+class WriteContent(ScratchRootTestCase):
+    def test_exact_bytes_including_binary_and_empty(self):
+        payload = bytes(range(256)) + b"\r\n\x00"
+        entries = [("bin", payload), ("empty", b""), ("d/e/f", b"tail")]
+        extract(entries, self.root)
+        self.assertEqual((self.root / "bin").read_bytes(), payload)
+        self.assertEqual((self.root / "empty").read_bytes(), b"")
+        self.assertEqual((self.root / "d/e/f").read_bytes(), b"tail")
+
+    def test_missing_parent_directories_created(self):
+        extract([("a/b/c/file", b"x")], self.root)
+        self.assertTrue((self.root / "a/b/c").is_dir())
+
+
+class IoErrorsAreVisible(ScratchRootTestCase):
+    def test_unexpected_root_lstat_error_propagates(self):
+        with mock.patch("safe_extract.os.lstat", side_effect=PermissionError("denied")):
+            with self.assertRaises(PermissionError):
+                extract([("f", b"x")], self.root)
+        self.assert_root_untouched()
+
+    def test_unexpected_error_during_target_walk_propagates(self):
+        (self.root / "d").mkdir()
+        real_lstat = os.lstat
+
+        def lstat_denying_blocked(path, *args, **kwargs):
+            if Path(path).name == "blocked":
+                raise PermissionError("denied")
+            return real_lstat(path, *args, **kwargs)
+
+        with mock.patch("safe_extract.os.lstat", side_effect=lstat_denying_blocked):
+            with self.assertRaises(PermissionError):
+                extract([("d/blocked", b"x")], self.root)
+        self.assertEqual(sorted((self.root / "d").iterdir()), [])
+
+    def test_unexpected_error_during_write_propagates(self):
+        with mock.patch("safe_extract.open", create=True, side_effect=OSError("disk gone")):
+            with self.assertRaises(OSError):
+                extract([("f", b"x")], self.root)
+        self.assertEqual(sorted(self.root.iterdir()), [])
