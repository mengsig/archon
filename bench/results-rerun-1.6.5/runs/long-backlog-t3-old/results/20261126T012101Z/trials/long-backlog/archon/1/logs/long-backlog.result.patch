+++ b/tests/test_export.py
@@ -0,0 +1,46 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, OPEN, Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_list_gives_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_rows_keep_order_and_end_with_crlf(self):
+        tasks = [Task(2, "second"), Task(1, "first", status=DONE)]
+        self.assertEqual(to_csv(tasks), HEADER + "2,second,,open,\r\n1,first,,done,\r\n")
+
+    def test_tags_joined_with_semicolon_and_due_iso(self):
+        task = Task(3, "pay rent", tags=["home", "money"], due=date(2026, 12, 1))
+        self.assertEqual(to_csv([task]), HEADER + "3,pay rent,home;money,open,2026-12-01\r\n")
+
+    def test_comma_in_title_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "a, b")]), HEADER + '1,"a, b",,open,\r\n')
+
+    def test_double_quote_is_quoted_and_doubled(self):
+        self.assertEqual(to_csv([Task(1, 'say "hi"')]), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_newline_and_carriage_return_are_quoted(self):
+        self.assertEqual(to_csv([Task(1, "line1\nline2")]), HEADER + '1,"line1\nline2",,open,\r\n')
+        self.assertEqual(to_csv([Task(1, "a\rb")]), HEADER + '1,"a\rb",,open,\r\n')
+
+    def test_comma_in_tag_quotes_the_tags_field(self):
+        task = Task(1, "x", tags=["a,b", "c"])
+        self.assertEqual(to_csv([task]), HEADER + '1,x,"a,b;c",open,\r\n')
+
+    def test_semicolon_alone_is_not_quoted(self):
+        task = Task(1, "x", tags=["a", "b"], status=OPEN)
+        self.assertEqual(to_csv([task]), HEADER + "1,x,a;b,open,\r\n")
+
+    def test_rejects_non_int_id(self):
+        with self.assertRaises(AssertionError):
+            to_csv([Task("1", "x")])
+
+
+if __name__ == "__main__":
+    unittest.main()
