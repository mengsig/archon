+class Concurrency(unittest.TestCase):
+    ROUNDS = 2000
+
+    def _run_all(self, targets):
+        errors = []
+
+        def guarded(target):
+            try:
+                target()
+            except Exception as exc:
+                errors.append(exc)
+
+        threads = [threading.Thread(target=guarded, args=(t,), daemon=True) for t in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=10)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "deadlock")
+        self.assertEqual(errors, [])
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def a_to_b():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        self._run_all([a_to_b, b_to_a])
+        final = ledger.snapshot()
+        self.assertEqual(sum(final.values()), 2000)
+        self.assertTrue(all(balance >= 0 for balance in final.values()))
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 500, "b": 500})
+        seen_totals = set()
+
+        def shuffle():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def observe():
+            for _ in range(self.ROUNDS):
+                seen_totals.add(sum(ledger.snapshot().values()))
+
+        self._run_all([shuffle, observe])
+        self.assertEqual(seen_totals, {1000})
+
+
+if __name__ == "__main__":
+    unittest.main()
