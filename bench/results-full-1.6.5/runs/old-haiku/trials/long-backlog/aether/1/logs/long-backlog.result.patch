diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..46953d0 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,71 @@
+from .models import DONE, OPEN
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in their input order."""
+    assert isinstance(query, str), "query must be a string"
+    terms = _parse_query(query)
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
+
+
+def _parse_query(query):
+    return [_parse_term(raw) for raw in _split_terms(query) if _strip_quotes(raw)]
+
+
+def _split_terms(query):
+    """Whitespace-separated terms; whitespace inside double quotes does not split."""
+    raw_terms = []
+    current = ""
+    in_quote = False
+    for char in query:
+        if char == '"':
+            in_quote = not in_quote
+        if char.isspace() and not in_quote:
+            if current:
+                raw_terms.append(current)
+            current = ""
+        else:
+            current += char
+    if in_quote:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if current:
+        raw_terms.append(current)
+    return raw_terms
+
+
+def _strip_quotes(raw):
+    return raw.replace('"', "")
+
+
+def _parse_term(raw):
+    text = _strip_quotes(raw)
+    assert text, "empty terms are filtered before parsing"
+    if raw.startswith('"') or ":" not in text:
+        return ("text", text.lower())
+    name, _, value = text.partition(":")
+    return _parse_field(name.lower(), value)
+
+
+def _parse_field(name, value):
+    if name == "tag":
+        if not value:
+            raise QueryError("tag: needs a tag name")
+        return ("tag", value.lower())
+    if name == "status":
+        if value.lower() not in (OPEN, DONE):
+            raise QueryError(f"unknown status: {value}")
+        return ("status", value.lower())
+    raise QueryError(f"unknown search field: {name}")
+
+
+def _matches(task, term):
+    kind, value = term
+    if kind == "text":
+        return value in task.title.lower()
+    if kind == "tag":
+        return any(tag.lower() == value for tag in task.tags)
+    return task.status == value
