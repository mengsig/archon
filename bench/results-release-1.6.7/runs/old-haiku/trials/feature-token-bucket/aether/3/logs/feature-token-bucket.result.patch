 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+# Absorbs float rounding in clock arithmetic so wait_time() is always enough to succeed.
+_TOKEN_EPSILON = 1e-9
+
+
+def _has_tokens(tokens, n):
+    return tokens + _TOKEN_EPSILON >= n
+
+
+def _check_rate(capacity, refill_per_sec):
+    if not _is_positive_finite(capacity):
+        raise ValueError(f"capacity must be a positive finite number, got {capacity!r}")
+    if not _is_positive_finite(refill_per_sec):
+        raise ValueError(f"refill_per_sec must be a positive finite number, got {refill_per_sec!r}")
+
+
+def _is_positive_finite(value):
+    return math.isfinite(value) and value > 0
+
+
+def _check_count(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must be in (0, {capacity}], got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate(capacity, refill_per_sec)
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_count(n, self.capacity)
+        self._refill()
+        if not _has_tokens(self._tokens, n):
+            return False
+        self._tokens = max(0.0, self._tokens - n)
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_count(n, self.capacity)
+        self._refill()
+        if _has_tokens(self._tokens, n):
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
+
+    def _refill(self):
+        # A clock that goes backwards adds nothing; _last keeps the latest time seen.
+        now = self._clock()
+        if now <= self._last:
+            return
+        elapsed = now - self._last
+        self._tokens = min(self.capacity, self._tokens + elapsed * self.refill_per_sec)
+        self._last = now
+        assert 0 <= self._tokens <= self.capacity
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate(capacity, refill_per_sec)
+        if not isinstance(max_keys, int) or max_keys < 1:
+            raise ValueError(f"max_keys must be an int >= 1, got {max_keys!r}")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_count(n, self.capacity)
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_count(n, self.capacity)
+        return self._bucket_for(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
+
+    def _bucket_for(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self.max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self.capacity, self.refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self.max_keys
+        return bucket
