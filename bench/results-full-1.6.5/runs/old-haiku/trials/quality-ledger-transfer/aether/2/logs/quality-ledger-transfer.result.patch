+class Concurrency(unittest.TestCase):
+    ITERATIONS = 2000
+
+    def _run_all(self, targets):
+        threads = [threading.Thread(target=t) for t in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=60)
+            self.assertFalse(thread.is_alive(), "thread did not finish (deadlock?)")
+
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def a_to_b():
+            for _ in range(self.ITERATIONS):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(self.ITERATIONS):
+                ledger.transfer("b", "a", 1)
+
+        self._run_all([a_to_b, b_to_a])
+        snap = ledger.snapshot()
+        self.assertEqual(snap["a"] + snap["b"], 2000)
+
+    def test_snapshots_never_observe_partial_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        seen_totals = set()
+
+        def mover():
+            for _ in range(self.ITERATIONS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def observer():
+            for _ in range(self.ITERATIONS):
+                snap = ledger.snapshot()
+                seen_totals.add(snap["a"] + snap["b"])
+
+        self._run_all([mover, observer])
+        self.assertEqual(seen_totals, {2000})
+
+    def test_concurrent_drains_never_overdraw(self):
+        ledger = Ledger({"src": 100, "d1": 0, "d2": 0})
+        results = []
+
+        def drain(dest):
+            for _ in range(self.ITERATIONS):
+                results.append(ledger.transfer("src", dest, 1))
+
+        self._run_all([lambda: drain("d1"), lambda: drain("d2")])
+        self.assertEqual(results.count(True), 100)
+        snap = ledger.snapshot()
+        self.assertEqual(snap["src"], 0)
+        self.assertEqual(snap["d1"] + snap["d2"], 100)
+
+
+if __name__ == "__main__":
+    unittest.main()
