@@ -33,5 +33,88 @@ class BasicTest(unittest.TestCase):
         self.assertFalse(limiter.try_acquire("a"))
 
 
+class EdgeCaseTest(unittest.TestCase):
+    def test_invalid_constructor_arguments(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, rate, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+
+    def test_invalid_request_size_raises(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+                with self.assertRaises(ValueError):
+                    limiter.try_acquire("a", n)
+                with self.assertRaises(ValueError):
+                    limiter.wait_time("a", n)
+        self.assertEqual(len(limiter), 0)
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        self.assertAlmostEqual(bucket.wait_time(), 0.5)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        self.assertEqual(bucket.wait_time(2), 0.0)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertAlmostEqual(bucket.wait_time(2), 2.0)
+        self.assertAlmostEqual(bucket.available(), 0.0)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+        clock.now = 0.2
+        self.assertAlmostEqual(bucket.available(), 1.0)
+        clock.now = 1.5
+        self.assertAlmostEqual(bucket.available(), 1.5)
+
+    def test_lru_eviction_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("a"))  # "a" becomes most recent
+        self.assertTrue(limiter.try_acquire("c"))   # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))   # "b" fresh again, evicts "a"
+        self.assertTrue(limiter.try_acquire("a"))   # "a" fresh again, evicts "c"
+        self.assertEqual(len(limiter), 2)
+
+    def test_wait_time_counts_as_use_for_eviction(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)  # "a" becomes most recent
+        limiter.try_acquire("c")                             # evicts "b", not "a"
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
