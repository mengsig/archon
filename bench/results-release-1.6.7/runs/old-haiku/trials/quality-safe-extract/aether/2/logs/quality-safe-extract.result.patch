 """Extract validated regular-file entries. See SPEC.md."""
 
+from __future__ import annotations
 
-def extract(entries, root):
-    raise NotImplementedError
+import os
+import stat
+from pathlib import Path
+
+
+def extract(entries: list[tuple[str, bytes]], root: str | Path) -> list[str]:
+    """Write every entry below root, or raise ValueError before writing anything."""
+    _check_batch_type(entries)
+    root_path = _check_root(root)
+    names = _check_entries(entries)
+    _check_batch_conflicts(names)
+    for name in names:
+        _check_target_free(root_path, name)
+    _write_entries(root_path, entries)
+    return names
+
+
+def _check_batch_type(entries) -> None:
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _check_root(root) -> Path:
+    if isinstance(root, str):
+        if not root:
+            raise ValueError("root must be a non-empty path")
+        root = Path(root)
+    elif not isinstance(root, Path):
+        raise ValueError(f"root must be a str or pathlib.Path, not {type(root).__name__}")
+
+    # Path() normalizes trailing slashes, so lstat sees a symlink even for "link/".
+    info = _lstat_or_none(root)
+    if info is None:
+        raise ValueError(f"root does not exist: {str(root)!r}")
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root must not be a symlink: {str(root)!r}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root is not a directory: {str(root)!r}")
+    return root
+
+
+def _check_entries(entries: list) -> list[str]:
+    return [_check_entry(index, entry) for index, entry in enumerate(entries)]
+
+
+def _check_entry(index: int, entry) -> str:
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry {index} name must be str, not {type(name).__name__}")
+    _check_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry {name!r} data must be bytes, not {type(data).__name__}")
+    return name
+
+
+def _check_name(name: str) -> None:
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative, not {name!r}")
+    for forbidden in ("\\", ":", "\0"):
+        if forbidden in name:
+            raise ValueError(f"entry name {name!r} contains forbidden {forbidden!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name {name!r} has invalid component {part!r}")
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name {name!r} cannot be encoded for the filesystem") from exc
+
+
+def _check_batch_conflicts(names: list[str]) -> None:
+    seen = set()
+    for name in names:
+        if name in seen:
+            raise ValueError(f"duplicate entry name {name!r}")
+        seen.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in seen:
+                raise ValueError(f"entry {ancestor!r} collides with entry {name!r}")
+
+
+def _check_target_free(root: Path, name: str) -> None:
+    current = root
+    for part in name.split("/")[:-1]:
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"entry {name!r} passes through symlink {str(current)!r}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"entry {name!r} needs directory {str(current)!r}, found non-directory")
+    if _lstat_or_none(root / name) is not None:
+        raise ValueError(f"entry {name!r} already exists")
+
+
+def _lstat_or_none(path: Path) -> os.stat_result | None:
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_entries(root: Path, entries: list[tuple[str, bytes]]) -> None:
+    for name, data in entries:
+        target = root / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        assert target.parent.is_dir() and not target.parent.is_symlink()
+        # Mode "xb" refuses to overwrite, so a file created since validation is an error.
+        with open(target, "xb") as handle:
+            handle.write(data)
