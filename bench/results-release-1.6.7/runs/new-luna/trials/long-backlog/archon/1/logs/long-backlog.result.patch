diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..c0d5399 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,61 @@
+class QueryError(ValueError):
+    """Raised when a search query contains invalid syntax."""
+
+
+def _terms(query):
+    terms = []
+    term = []
+    quoted = False
+    has_quote = False
+
+    for character in query:
+        if character == '"':
+            quoted = not quoted
+            has_quote = True
+        elif character.isspace() and not quoted:
+            if term:
+                terms.append(("".join(term), has_quote))
+                term = []
+                has_quote = False
+        else:
+            term.append(character)
+
+    if quoted:
+        raise QueryError("unterminated quote")
+    if term:
+        terms.append(("".join(term), has_quote))
+    return terms
+
+
+def _matches(task, term, quoted=False):
+    if quoted or ":" not in term:
+        return term.casefold() in task.title.casefold()
+
+    field, value = term.split(":", 1)
+    field = field.casefold()
+    value = value.casefold()
+
+    if field == "tag":
+        return any(value == tag.casefold() for tag in task.tags)
+    if field == "status":
+        if value not in ("open", "done"):
+            raise QueryError("unknown status: {}".format(value))
+        return task.status.casefold() == value
+    raise QueryError("unknown query field: {}".format(field))
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    if not terms:
+        return list(tasks)
+
+    # Parse fields and validate status terms even when there are no tasks.
+    for term, quoted in terms:
+        if not quoted and ":" in term:
+            field, value = term.split(":", 1)
+            if field.casefold() == "status" and value.casefold() not in ("open", "done"):
+                raise QueryError("unknown status: {}".format(value))
+            if field.casefold() not in ("tag", "status"):
+                raise QueryError("unknown query field: {}".format(field))
+
+    return [task for task in tasks if all(_matches(task, term, quoted) for term, quoted in terms)]
