+++ b/tests/test_ticket_tt103.py
@@ -0,0 +1,79 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN, Task
+from tasktracker.search import QueryError, search
+
+TASKS = [
+    Task(1, "Fix login bug", tags=["Work", "urgent"]),
+    Task(2, "Buy milk", tags=["home"], status=DONE),
+    Task(3, "fix the login page", tags=["work"], status=DONE),
+    Task(4, "Plan trip: Japan", tags=["Travel"]),
+]
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchQuerySyntaxTest(unittest.TestCase):
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(titles(search(TASKS, "LOGIN")), ["Fix login bug", "fix the login page"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(TASKS, '"fix login"')), ["Fix login bug"])
+
+    def test_terms_must_all_match(self):
+        self.assertEqual(titles(search(TASKS, "fix login")), ["Fix login bug", "fix the login page"])
+        self.assertEqual(titles(search(TASKS, "fix milk")), [])
+
+    def test_quoted_colon_is_literal_text(self):
+        self.assertEqual(titles(search(TASKS, '"trip: japan"')), ["Plan trip: Japan"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(TASKS, "tag:WORK")), ["Fix login bug", "fix the login page"])
+        self.assertEqual(titles(search(TASKS, "tag:wor")), [])
+
+    def test_tag_value_can_be_quoted(self):
+        self.assertEqual(titles(search(TASKS, 'tag:"urgent"')), ["Fix login bug"])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(TASKS, "status:open")), ["Fix login bug", "Plan trip: Japan"])
+        self.assertEqual(titles(search(TASKS, "status:DONE")), ["Buy milk", "fix the login page"])
+
+    def test_status_and_tag_combine_with_and(self):
+        self.assertEqual(titles(search(TASKS, "status:done tag:work")), ["fix the login page"])
+
+    def test_blank_query_matches_all_in_input_order(self):
+        for query in ["", "   ", "\t"]:
+            self.assertEqual(titles(search(TASKS, query)), titles(TASKS))
+
+    def test_empty_task_list_returns_empty(self):
+        self.assertEqual(search([], "login"), [])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "due:today")
+
+    def test_bare_word_with_colon_is_unknown_field(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "12:30")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "status:pending")
+
+    def test_empty_tag_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, '"fix login')
+
+    def test_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:pending")
+
+
+if __name__ == "__main__":
+    unittest.main()
