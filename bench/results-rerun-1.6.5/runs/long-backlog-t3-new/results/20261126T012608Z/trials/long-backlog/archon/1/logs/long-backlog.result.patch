new file mode 100644
index 0000000..ed23ddf
--- /dev/null
+++ b/tests/test_undo.py
@@ -0,0 +1,103 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+
+    def test_undo_complete_of_done_task_keeps_it_done(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "done")
+
+    def test_undo_delete_restores_same_task_and_id(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["work"], due=date(2026, 4, 1))
+        store.complete(a.id)
+        store.delete(a.id)
+        store.undo()
+        restored = store.get(a.id)
+        self.assertEqual(restored.id, a.id)
+        self.assertEqual(restored.title, "write report")
+        self.assertEqual(restored.tags, ["work"])
+        self.assertEqual(restored.status, "done")
+        self.assertEqual(restored.due, date(2026, 4, 1))
+
+    def test_undo_delete_ignores_later_changes_to_returned_task(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["t"])
+        returned = store.delete(a.id)
+        returned.tags.append("changed")
+        store.undo()
+        self.assertEqual(store.get(a.id).tags, ["t"])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_ids_are_not_reused_after_undo_add(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        b = store.add("second")
+        self.assertEqual(b.id, 2)
+
+    def test_nothing_to_undo_on_empty_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_nothing_to_undo_after_exhausting_history(self):
+        store = TaskStore()
+        store.add("a")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
