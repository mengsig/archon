+class EdgeCaseTest(unittest.TestCase):
+    def test_invalid_bucket_parameters_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_n_raises_and_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        for n in (0, -1, 3):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_failed_acquire_removes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_tokens_cap_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertEqual(bucket.wait_time(2), 0.0)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(1), 0.5)
+        self.assertAlmostEqual(bucket.wait_time(2), 1.0)
+        clock.now = 0.5
+        self.assertEqual(bucket.wait_time(1), 0.0)
+        self.assertTrue(bucket.try_acquire())
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 10.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_invalid_keyed_parameters_raise(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+
+    def test_keyed_invalid_n_does_not_create_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", n=2)
+        self.assertEqual(len(limiter), 0)
+
+    def test_lru_eviction(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # "a" is now most recently used
+        limiter.try_acquire("c")  # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))  # evicted key returns full
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=clock)
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))  # evicts "a"
+        self.assertTrue(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
     unittest.main()
