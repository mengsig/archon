+import os
 import tempfile
 import unittest
 from pathlib import Path
@@ -5,6 +6,37 @@ from pathlib import Path
 from safe_extract import extract
 
 
+def tree_state(base):
+    state = {}
+    for path in sorted(base.rglob("*")):
+        key = path.relative_to(base).as_posix()
+        if path.is_symlink():
+            state[key] = ("link", os.readlink(path))
+        elif path.is_dir():
+            state[key] = ("dir",)
+        else:
+            state[key] = ("file", path.read_bytes())
+    return state
+
+
+class ExtractCase(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+        (self.outside / "secret").write_bytes(b"keep")
+
+    def assert_rejected_unchanged(self, entries, root=None):
+        before = tree_state(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(tree_state(self.base), before)
+
+
