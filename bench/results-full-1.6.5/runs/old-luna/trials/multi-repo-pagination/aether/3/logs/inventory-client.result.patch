+  const requests = [];
+  const transport = async (request) => {
+    requests.push(request);
+    if (requests.length === 1) {
+      return { status: 200, body: { items: ITEMS.slice(0, 1), next_cursor: 'opaque+/=' } };
+    }
+    return { status: 200, body: { items: ITEMS.slice(1), next_cursor: null } };
+  };
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(requests[0].query, {});
+  assert.equal(requests[1].query.cursor, 'opaque+/=');
+});
