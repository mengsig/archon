+from datetime import date
+
+HEADER = "id,title,tags,status,due"
+LINE_END = "\r\n"
+QUOTE_TRIGGERS = (",", '"', "\r", "\n")
+
+
 def to_csv(tasks):
-    lines = ["id,title,tags,status,due"]
+    lines = [HEADER]
     for task in tasks:
-        due = task.due.isoformat() if task.due else ""
-        lines.append(f"{task.id},{task.title},{';'.join(task.tags)},{task.status},{due}")
-    return "\n".join(lines) + "\n"
+        lines.append(_row(task))
+    return "".join(line + LINE_END for line in lines)
+
+
+def _row(task):
+    _check_task(task)
+    due = task.due.isoformat() if task.due else ""
+    fields = [str(task.id), task.title, ";".join(task.tags), task.status, due]
+    return ",".join(_quote(field) for field in fields)
+
+
+def _quote(field):
+    if not any(char in field for char in QUOTE_TRIGGERS):
+        return field
+    return '"' + field.replace('"', '""') + '"'
+
+
+def _check_task(task):
+    if isinstance(task.id, bool) or not isinstance(task.id, int):
+        raise TypeError(f"task id must be an int, got {task.id!r}")
+    if not isinstance(task.title, str):
+        raise TypeError(f"task {task.id} title must be a str")
+    if not isinstance(task.tags, list) or not all(isinstance(t, str) for t in task.tags):
+        raise TypeError(f"task {task.id} tags must be a list of str")
+    if not isinstance(task.status, str):
+        raise TypeError(f"task {task.id} status must be a str")
+    if task.due is not None and not isinstance(task.due, date):
+        raise TypeError(f"task {task.id} due must be a date or None")
