 class LedgerBasics(unittest.TestCase):
@@ -13,3 +14,86 @@ class LedgerBasics(unittest.TestCase):
         ledger = Ledger({"a": 2, "b": 0})
         self.assertIs(ledger.transfer("a", "b", 3), False)
         self.assertEqual(ledger.snapshot(), {"a": 2, "b": 0})
+
+    def test_constructor_validation_and_copying(self):
+        for balances in (None, [], {"": 1}, {1: 1}, {"a": True},
+                         {"a": -1}, {"a": MAX_BALANCE + 1}, {"a": 1.0}):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+        balances = {"a": 1}
+        ledger = Ledger(balances)
+        balances["a"] = 9
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        for source, destination in (("missing", "a"), ("a", "missing"),
+                                    ([], "a"), ("a", [])):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+
+    def test_overflow_is_atomic(self):
+        ledger = Ledger({"a": 1, "b": MAX_BALANCE})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_same_account_boundaries(self):
+        ledger = Ledger({"full": MAX_BALANCE, "empty": 0})
+        self.assertIs(ledger.transfer("full", "full", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("empty", "empty", 1), False)
+        with self.assertRaises(ValueError):
+            ledger.transfer("full", "full", MAX_BALANCE + 1)
+        self.assertEqual(ledger.snapshot(), {"full": MAX_BALANCE, "empty": 0})
+
+    def test_snapshot_is_independent(self):
+        ledger = Ledger({"a": 4, "b": 2})
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 100
+        snapshot["new"] = 3
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 2})
+
+    def test_transfer_conserves_total(self):
+        ledger = Ledger({"a": 20, "b": 10, "c": 0})
+        initial_total = sum(ledger.snapshot().values())
+        for source, destination, amount in (("a", "b", 7), ("b", "c", 4),
+                                            ("c", "a", 2), ("a", "c", 100)):
+            ledger.transfer(source, destination, amount)
+            self.assertEqual(sum(ledger.snapshot().values()), initial_total)
+
+    def test_opposite_transfers_are_thread_safe_and_do_not_deadlock(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        barrier = Barrier(3)
+        errors = []
+
+        def transfer_repeatedly(source, destination):
+            try:
+                barrier.wait(timeout=2)
+                for _ in range(2000):
+                    ledger.transfer(source, destination, 1)
+                    ledger.snapshot()
+            except BaseException as error:
+                errors.append(error)
+
+        threads = [Thread(target=transfer_repeatedly, args=pair) for pair in
+                   (("a", "b"), ("b", "a"))]
+        for thread in threads:
+            thread.start()
+        barrier.wait(timeout=2)
+        for thread in threads:
+            thread.join(timeout=3)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "ledger calls deadlocked")
+        self.assertEqual(errors, [])
+        snapshot = ledger.snapshot()
+        self.assertEqual(sum(snapshot.values()), 200)
+        self.assertEqual(set(snapshot), {"a", "b"})
