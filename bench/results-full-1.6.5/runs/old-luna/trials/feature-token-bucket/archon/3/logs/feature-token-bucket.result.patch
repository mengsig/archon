@@ -32,6 +32,59 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_wait_time_and_no_consumption(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 0.25
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertEqual(bucket.wait_time(1), 0.25)
+        self.assertEqual(bucket.available(), 0.5)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_backwards_clock_does_not_refill_or_move_time_anchor(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertEqual(bucket.available(), 1.0)
+        clock.now = 0.0
+        self.assertEqual(bucket.available(), 1.0)
+        clock.now = 1.5
+        self.assertEqual(bucket.available(), 1.5)
+
+    def test_invalid_bucket_parameters_and_requests(self):
+        for args in ((0, 1), (1, 0), (-1, 1), (1, -1)):
+            with self.subTest(args=args), self.assertRaises(ValueError):
+                TokenBucket(*args)
+        bucket = TokenBucket(2, 1)
+        for n in (0, -1, 3):
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.subTest(wait_n=n), self.assertRaises(ValueError):
+                bucket.wait_time(n)
+
+    def test_keyed_limiter_lru_includes_wait_time(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        self.assertEqual(limiter.wait_time("a"), 0.0)
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # Makes a most recently used.
+        limiter.try_acquire("c")  # Evicts b.
+        self.assertEqual(len(limiter), 2)
+        self.assertEqual(limiter.wait_time("a"), 0.0)
+        self.assertTrue(limiter.try_acquire("b"))  # Evicted keys start full.
+
+    def test_keyed_limiter_validates_max_keys_and_request_before_tracking(self):
+        for max_keys in (0, -1):
+            with self.subTest(max_keys=max_keys), self.assertRaises(ValueError):
+                KeyedLimiter(1, 1.0, max_keys=max_keys)
+        limiter = KeyedLimiter(1, 1.0)
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("invalid", 2)
+        self.assertEqual(len(limiter), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
