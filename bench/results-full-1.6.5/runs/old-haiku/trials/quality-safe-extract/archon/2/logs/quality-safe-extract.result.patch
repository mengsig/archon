+class IoErrorsStayVisible(ExtractTestCase):
+    def test_filesystem_error_during_write_propagates(self):
+        with mock.patch("safe_extract.open", create=True, side_effect=PermissionError("denied")):
+            with self.assertRaises(PermissionError):
+                extract([("a", b"1")], self.root)
+
+    def test_exclusive_create_refuses_existing_file_even_if_check_is_bypassed(self):
+        (self.root / "keep.txt").write_bytes(b"original")
+        with mock.patch.object(safe_extract, "_check_target_free"):
+            with self.assertRaises(FileExistsError):
+                extract([("keep.txt", b"replaced")], self.root)
+        self.assertEqual((self.root / "keep.txt").read_bytes(), b"original")
+
+    def test_write_into_existing_subdirectory_leaves_siblings_untouched(self):
+        (self.root / "dir").mkdir()
+        (self.root / "dir" / "sibling.txt").write_bytes(b"sibling")
+        self.assertEqual(extract([("dir/new.txt", b"new")], self.root), ["dir/new.txt"])
+        self.assertEqual((self.root / "dir" / "sibling.txt").read_bytes(), b"sibling")
+        self.assertEqual((self.root / "dir" / "new.txt").read_bytes(), b"new")
