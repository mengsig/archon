@@ -0,0 +1,88 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def make_store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["work", "urgent"])
+    store.add("write report", tags=["work"])
+    store.add("buy milk", tags=["home"])
+    store.add("Don't forget", tags=["Home"])
+    store.complete(2)
+    return store
+
+
+def titles(query, store=None):
+    tasks = (store or make_store()).all()
+    return [task.title for task in search(tasks, query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   ", "\t"]:
+            with self.subTest(query=query):
+                self.assertEqual(titles(query), ["Fix login bug", "write report", "buy milk", "Don't forget"])
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(titles("LOGIN"), ["Fix login bug"])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(titles("fix bug"), ["Fix login bug"])
+        self.assertEqual(titles("fix report"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles('"login bug"'), ["Fix login bug"])
+        self.assertEqual(titles('"bug login"'), [])
+
+    def test_phrase_and_word_combine(self):
+        self.assertEqual(titles('"fix login" bug'), ["Fix login bug"])
+
+    def test_apostrophes_are_ordinary_characters(self):
+        self.assertEqual(titles("don't"), ["Don't forget"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles("tag:work"), ["Fix login bug", "write report"])
+        self.assertEqual(titles("tag:HOME"), ["buy milk", "Don't forget"])
+        self.assertEqual(titles("tag:wor"), [])
+
+    def test_status_matches_open_or_done(self):
+        self.assertEqual(titles("status:done"), ["write report"])
+        self.assertEqual(titles("status:open"), ["Fix login bug", "buy milk", "Don't forget"])
+
+    def test_field_and_word_terms_combine(self):
+        self.assertEqual(titles("tag:work status:open"), ["Fix login bug"])
+
+    def test_quoted_field_value_may_contain_spaces(self):
+        store = TaskStore()
+        store.add("errand", tags=["to do"])
+        self.assertEqual(titles('tag:"to do"', store), ["errand"])
+
+    def test_quoted_text_containing_colon_is_a_phrase(self):
+        store = TaskStore()
+        store.add("meeting: notes")
+        self.assertEqual(titles('"meeting: notes"', store), ["meeting: notes"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), "priority:high")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), "status:maybe")
+
+    def test_empty_tag_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), '"login bug')
+
+    def test_query_error_is_a_value_error(self):
+        self.assertTrue(issubclass(QueryError, ValueError))
+
+
+if __name__ == "__main__":
+    unittest.main()
