diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..4180772 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,37 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": (attempt, 1),
+        "elapsed_ms": (elapsed_ms, 0),
+        "max_attempts": (max_attempts, 1),
+        "budget_ms": (budget_ms, 0),
+        "base_ms": (base_ms, 0),
+        "cap_ms": (cap_ms, 0),
+    }
+    for name, (value, minimum) in values.items():
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    else:
+        exponent = attempt - 1
+        threshold = (cap_ms + base_ms - 1) // base_ms
+        saturation_exponent = (threshold - 1).bit_length()
+        if exponent >= saturation_exponent:
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms << exponent)
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..79ff8f2 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,49 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validation_precedes_exhaustion(self):
+        invalid = (
+            ((4, 0), {"max_attempts": True}),
+            ((4, 0), {"budget_ms": -1}),
+            ((4, 0), {"base_ms": 1.0}),
+            ((4, 0), {"retry_after_ms": False}),
+            ((True, 0), {}),
+            ((1, False), {}),
+        )
+        for args, kwargs in invalid:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_non_exhausted_values_and_ranges(self):
+        for kwargs in ({"attempt": 0}, {"max_attempts": 0},
+                       {"elapsed_ms": -1}, {"cap_ms": -1}):
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    values = {"attempt": 1, "elapsed_ms": 0}
+                    values.update(kwargs)
+                    retry_delay(**values)
+
+    def test_strict_budget_boundary(self):
+        self.assertIsNone(retry_delay(1, 900))
+        self.assertEqual(retry_delay(1, 899), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100, base_ms=100))
+
+    def test_zero_backoff_and_large_attempt(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, base_ms=100, cap_ms=0), 0)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**101), 400)
+
+    def test_retry_after_floor_is_not_capped(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=1000,
+                                     budget_ms=1001), 1000)
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000,
+                                      budget_ms=1000))
+
+    def test_arbitrary_size_integer_arguments(self):
+        huge = 10**100
+        self.assertEqual(retry_delay(1, 0, base_ms=huge, cap_ms=huge,
+                                     budget_ms=huge + 1), huge)
