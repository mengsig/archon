index 07b3b5e..4a91082 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,40 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+    return value
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    doublings = attempt - 1
+    # Once 2**doublings exceeds cap_ms, the capped value is reached; avoid building the power.
+    if doublings >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << doublings)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    attempt = _require_int("attempt", attempt, 1)
+    elapsed_ms = _require_int("elapsed_ms", elapsed_ms, 0)
+    max_attempts = _require_int("max_attempts", max_attempts, 1)
+    budget_ms = _require_int("budget_ms", budget_ms, 0)
+    base_ms = _require_int("base_ms", base_ms, 0)
+    cap_ms = _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        retry_after_ms = _require_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
