+class KeyedLimiterValidationTest(unittest.TestCase):
+    def test_invalid_capacity_or_refill_raises_at_construction(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, -1.0, clock=FakeClock())
+
+    def test_max_keys_below_one_raises(self):
+        for max_keys in (0, -1):
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_n_raises_and_creates_no_key(self):
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 3)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", 0)
+        self.assertEqual(len(limiter), 0)
+
+
+class KeyedLimiterEvictionTest(unittest.TestCase):
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_use_refreshes_recency(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=clock)
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_max_keys_one_keeps_single_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        for key in ("a", "b", "c"):
+            limiter.try_acquire(key)
+            self.assertEqual(len(limiter), 1)
+
+    def test_default_max_keys_is_1024(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        for i in range(1025):
+            limiter.wait_time(i)
+        self.assertEqual(len(limiter), 1024)
+
+    def test_keyed_refill_uses_shared_clock(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        clock.now = 1.0
+        self.assertTrue(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
