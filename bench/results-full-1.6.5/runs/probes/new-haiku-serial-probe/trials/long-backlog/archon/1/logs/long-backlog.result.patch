diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..64a2d1f 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,67 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    terms = [_parse_term(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quotes stay in the raw term."""
+    raw_terms, current, in_quote = [], [], False
+    for ch in query:
+        if ch == '"':
+            in_quote = not in_quote
+        elif ch.isspace() and not in_quote:
+            if current:
+                raw_terms.append("".join(current))
+                current = []
+            continue
+        current.append(ch)
+    if in_quote:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        raw_terms.append("".join(current))
+    return raw_terms
+
+
+def _parse_term(raw):
+    assert raw, "raw terms are never empty"
+    if not raw.startswith('"'):
+        name, sep, value = raw.partition(":")
+        if sep and '"' not in name:
+            return _field_term(name, _unquote(value))
+    return ("text", _unquote(raw))
+
+
+def _field_term(name, value):
+    if not value:
+        raise QueryError(f"empty value for {name}:")
+    if name == "tag":
+        return ("tag", value.lower())
+    if name == "status":
+        if value.lower() not in STATUSES:
+            raise QueryError(f"unknown status: {value!r}")
+        return ("status", value.lower())
+    raise QueryError(f"unknown field: {name!r}")
+
+
+def _matches(task, term):
+    kind, value = term
+    if kind == "text":
+        return value.lower() in task.title.lower()
+    if kind == "tag":
+        return value in (tag.lower() for tag in task.tags)
+    assert kind == "status", f"unknown term kind: {kind!r}"
+    return task.status == value
+
+
+def _unquote(text):
+    return text.replace('"', "")
