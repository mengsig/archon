+class RootTestCase(unittest.TestCase):
+    """Gives each test a fresh outside directory and an inside root below it."""
+
+    def setUp(self):
+        outer = tempfile.TemporaryDirectory()
+        self.addCleanup(outer.cleanup)
+        self.outside = Path(outer.name)
+        self.root = self.outside / "root"
+        self.root.mkdir()
+
+    def assertRejectedUnchanged(self, entries, root=DEFAULT_ROOT):
+        before_root = snapshot(self.root)
+        before_outside = snapshot(self.outside)
+        if root is DEFAULT_ROOT:
+            root = self.root
+        with self.assertRaises(ValueError):
+            extract(entries, root)
+        self.assertEqual(snapshot(self.root), before_root)
+        self.assertEqual(snapshot(self.outside), before_outside)
+
+
+class BatchShape(RootTestCase):
+    def test_non_list_batches_are_rejected_without_consuming_them(self):
+        iterator = iter([("a", b"x")])
+        generator = (entry for entry in [("a", b"x")])
+        for batch in [(), (("a", b"x"),), iterator, generator]:
+            with self.subTest(batch=type(batch).__name__):
+                self.assertRejectedUnchanged(batch)
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertEqual(next(generator), ("a", b"x"))
+
+    def test_empty_list_with_invalid_root_is_rejected(self):
+        self.assertRejectedUnchanged([], self.outside / "missing")
+
+    def test_returns_names_in_input_order(self):
+        entries = [("z", b"1"), ("a", b"2"), ("m/n", b"3")]
+        self.assertEqual(extract(entries, self.root), ["z", "a", "m/n"])
+
+    def test_writes_exact_bytes_including_empty_and_binary(self):
+        payload = b"\x00\xff\r\n"
+        extract([("bin", payload), ("empty", b"")], self.root)
+        self.assertEqual((self.root / "bin").read_bytes(), payload)
+        self.assertEqual((self.root / "empty").read_bytes(), b"")
+
+    def test_nested_missing_parents_are_created(self):
+        extract([("a/b/c/d.txt", b"deep")], self.root)
+        self.assertEqual((self.root / "a/b/c/d.txt").read_bytes(), b"deep")
+
+    def test_existing_real_directory_ancestor_is_reused(self):
+        (self.root / "existing").mkdir()
