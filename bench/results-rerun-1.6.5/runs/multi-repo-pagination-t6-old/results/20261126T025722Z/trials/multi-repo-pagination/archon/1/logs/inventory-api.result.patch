+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,47 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = parse_limit(query.get("limit"))
+        after_id = parse_cursor(query.get("cursor"))
+    except ValueError as exc:
+        return _error(400, str(exc))
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    next_cursor = encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not re.fullmatch(r"[0-9]+", raw):
+        raise ValueError("limit must be an integer")
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        raise ValueError(f"limit must be between 1 and {MAX_LIMIT}")
+    return limit
+
+
+def encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def parse_cursor(raw):
+    """Return the id of the last item already served, or None for the first page."""
+    if raw is None:
+        return None
+    try:
+        decoded = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except ValueError as exc:
+        raise ValueError("cursor is invalid") from exc
+    if not re.fullmatch(r"[0-9]+", decoded):
+        raise ValueError("cursor is invalid")
+    return int(decoded)
 
 
