@@ -0,0 +1,89 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_with_nothing_recorded_raises(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_task_exactly(self):
+        store = TaskStore()
+        task = store.add("plan trip", tags=["home", "fun"], due=date(2026, 5, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.id, task.id)
+        self.assertEqual(restored.title, "plan trip")
+        self.assertEqual(restored.tags, ["home", "fun"])
+        self.assertEqual(restored.due, date(2026, 5, 1))
+        self.assertEqual(restored.status, DONE)
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(store.get(b.id).status, OPEN)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("keep me")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.delete(1)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_does_not_record_itself(self):
+        store = TaskStore()
+        store.add("only")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
