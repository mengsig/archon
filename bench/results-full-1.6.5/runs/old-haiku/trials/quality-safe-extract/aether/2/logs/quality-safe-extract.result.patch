+class ConflictsOnDisk(unittest.TestCase):
+    def setUp(self):
+        self._temp = tempfile.TemporaryDirectory()
+        self.root = Path(self._temp.name)
+
+    def tearDown(self):
+        self._temp.cleanup()
+
+    def test_existing_file_is_never_overwritten(self):
+        (self.root / "keep.txt").write_bytes(b"original")
+        with self.assertRaises(ValueError):
+            extract([("new.txt", b"n"), ("keep.txt", b"replaced")], self.root)
+        self.assertEqual((self.root / "keep.txt").read_bytes(), b"original")
+        self.assertFalse((self.root / "new.txt").exists())
+
+    def test_existing_directory_target_is_rejected(self):
+        (self.root / "dir").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("dir", b"x")], self.root)
+
+    def test_regular_file_in_ancestor_position_is_rejected(self):
+        (self.root / "a").write_bytes(b"file")
+        with self.assertRaises(ValueError):
+            extract([("ok", b"1"), ("a/b", b"x")], self.root)
+        self.assertEqual(tree_snapshot(self.root), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"file")
+
+    def test_no_files_created_when_later_entry_conflicts(self):
+        (self.root / "taken").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("first/x", b"1"), ("taken", b"2")], self.root)
+        self.assertEqual(tree_snapshot(self.root), ["taken"])
+
+
+class WriteBehavior(unittest.TestCase):
+    def setUp(self):
+        self._temp = tempfile.TemporaryDirectory()
+        self.root = Path(self._temp.name)
+
+    def tearDown(self):
+        self._temp.cleanup()
+
+    def test_exact_bytes_including_binary_are_written(self):
+        payload = bytes(range(256))
+        extract([("bin/data.bin", payload)], self.root)
+        self.assertEqual((self.root / "bin/data.bin").read_bytes(), payload)
+
+    def test_deep_parents_are_created(self):
+        extract([("a/b/c/d.txt", b"deep")], self.root)
+        self.assertEqual((self.root / "a/b/c/d.txt").read_bytes(), b"deep")
+
+    def test_siblings_share_created_parents(self):
+        extract([("dir/a", b"1"), ("dir/b", b"2")], self.root)
+        self.assertEqual(tree_snapshot(self.root), ["dir", "dir/a", "dir/b"])
+
+
+if __name__ == "__main__":
