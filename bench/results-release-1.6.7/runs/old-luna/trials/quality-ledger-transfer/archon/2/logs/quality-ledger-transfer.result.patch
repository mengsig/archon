+class LedgerValidation(unittest.TestCase):
+    def test_constructor_rejects_invalid_mapping_and_entries(self):
+        invalid = [[], None, {"": 0}, {1: 0}, {"a": True}, {"a": 1.0},
+                   {"a": -1}, {"a": MAX_BALANCE + 1}]
+        for value in invalid:
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                Ledger(value)
+
+    def test_constructor_copies_input(self):
+        balances = {"a": 4}
+        ledger = Ledger(balances)
+        balances["a"] = 99
+        balances["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (True, False, 0, -1, MAX_BALANCE + 1, 1.0, "1", None):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        for source, destination in (("missing", "a"), ("a", "missing"),
+                                    ("missing", "also missing")):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        for source, destination in (("a", []), ([], "a")):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
