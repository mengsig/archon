+        if after_id is None or after_id not in {item["id"] for item in items}:
+            return _error(400, "invalid cursor")
+        items = [item for item in items if item["id"] > after_id]
+
+    page = items[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(items) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(item_id):
+    token = base64.urlsafe_b64encode(f"items:{item_id}".encode()).decode().rstrip("=")
+    return token
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", cursor):
+        return None
+    try:
+        decoded = base64.urlsafe_b64decode(cursor + "=" * (-len(cursor) % 4)).decode()
+    except (ValueError, UnicodeDecodeError):
+        return None
+    match = re.fullmatch(r"items:([0-9]+)", decoded)
+    return int(match.group(1)) if match else None
 
 
