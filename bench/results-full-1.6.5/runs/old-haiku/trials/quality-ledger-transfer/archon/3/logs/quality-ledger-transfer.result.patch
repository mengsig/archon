 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _validate_balance(value, account):
+    if type(value) is not int or not 0 <= value <= MAX_BALANCE:
+        raise ValueError(
+            f"balance for {account!r} must be an int in [0, MAX_BALANCE], got {value!r}"
+        )
+
+
+def _validate_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError(f"account name must be a nonempty string, got {name!r}")
+
+
+def _validate_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(
+            f"amount must be an int in [1, MAX_BALANCE], got {amount!r}"
+        )
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError(f"balances must be a dict, got {type(balances).__name__}")
+        copied = dict(balances)
+        for name, balance in copied.items():
+            _validate_name(name)
+            _validate_balance(balance, name)
+        self._balances = copied
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _validate_amount(amount)
+        with self._lock:
+            self._require_account(source)
+            self._require_account(destination)
+            if source == destination:
+                return self._balances[source] >= amount
+            if self._balances[source] < amount:
+                return False
+            if self._balances[destination] + amount > MAX_BALANCE:
+                return False
+            self._balances[source] -= amount
+            self._balances[destination] += amount
+            assert self._balances[source] >= 0
+            assert self._balances[destination] <= MAX_BALANCE
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _require_account(self, name):
+        try:
+            known = name in self._balances
+        except TypeError as exc:
+            raise KeyError(name) from exc
+        if not known:
+            raise KeyError(name)
