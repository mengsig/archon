@@ -0,0 +1,72 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvRfc4180Test(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_every_line_ends_with_crlf(self):
+        store = TaskStore()
+        store.add("one")
+        store.add("two")
+        self.assertEqual(to_csv(store.all()), HEADER + "\r\n1,one,,open,\r\n2,two,,open,\r\n")
+
+    def test_rows_keep_input_order(self):
+        store = TaskStore()
+        a = store.add("first")
+        b = store.add("second")
+        out = to_csv([b, a])
+        self.assertEqual(out.splitlines()[1:], ["2,second,,open,", "1,first,,open,"])
+
+    def test_tags_joined_with_semicolon_and_due_iso(self):
+        store = TaskStore()
+        store.add("pay rent", tags=["home", "money"], due=date(2026, 4, 1))
+        self.assertEqual(to_csv(store.all()).splitlines()[1], "1,pay rent,home;money,open,2026-04-01")
+
+    def test_title_with_comma_is_quoted(self):
+        store = TaskStore()
+        store.add("milk, eggs")
+        self.assertEqual(to_csv(store.all()).splitlines()[1], '1,"milk, eggs",,open,')
+
+    def test_embedded_double_quotes_are_doubled(self):
+        store = TaskStore()
+        store.add('say "hi"')
+        self.assertEqual(to_csv(store.all()).splitlines()[1], '1,"say ""hi""",,open,')
+
+    def test_newline_and_carriage_return_are_quoted(self):
+        store = TaskStore()
+        store.add("line one\nline two")
+        store.add("a\rb")
+        self.assertEqual(
+            to_csv(store.all()),
+            HEADER + '\r\n1,"line one\nline two",,open,\r\n2,"a\rb",,open,\r\n',
+        )
+
+    def test_tag_containing_comma_is_quoted_as_field(self):
+        store = TaskStore()
+        store.add("x", tags=["a,b", "c"])
+        self.assertEqual(to_csv(store.all()).splitlines()[1], '1,x,"a,b;c",open,')
+
+    def test_plain_fields_are_not_quoted(self):
+        store = TaskStore()
+        store.add("plain title", tags=["a"])
+        self.assertEqual(to_csv(store.all()).splitlines()[1], "1,plain title,a,open,")
+
+    def test_round_trips_through_csv_reader(self):
+        title = 'tricky, "quoted"\nmultiline\r\ntitle'
+        store = TaskStore()
+        store.add(title, tags=["x", "y"], due=date(2026, 5, 9))
+        rows = list(csv.reader(io.StringIO(to_csv(store.all()), newline="")))
+        self.assertEqual(rows, [HEADER.split(","), ["1", title, "x;y", "open", "2026-05-09"]])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_ticket_tt103.py b/tests/test_ticket_tt103.py
new file mode 100644
index 0000000..781230e
