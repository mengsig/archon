 """
 
+import base64
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MAX_LIMIT_DIGITS = len(str(MAX_LIMIT))
+MAX_ID_DIGITS = 18
+
+
+class BadParameter(ValueError):
+    """A query parameter the client sent is malformed or out of range."""
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +32,50 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = parse_limit(query.get("limit"))
+        after = parse_cursor(query.get("cursor"))
+    except BadParameter as err:
+        return _error(400, str(err))
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after is None or item["id"] > after
+    ]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:]))
+    next_cursor = encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    # Length check first: int() raises ValueError on very long digit strings.
+    if not (raw.isascii() and raw.isdigit()) or len(raw) > MAX_LIMIT_DIGITS:
+        raise BadParameter(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        raise BadParameter(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return limit
+
+
+def encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def parse_cursor(raw):
+    if raw is None:
+        return None
+    try:
+        decoded = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except ValueError as err:
+        raise BadParameter("cursor is not valid") from err
+    # Length check first: int() raises ValueError on very long digit strings.
+    if not (decoded.isascii() and decoded.isdigit()) or len(decoded) > MAX_ID_DIGITS:
+        raise BadParameter("cursor is not valid")
+    return int(decoded)
 
 
