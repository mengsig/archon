 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARACTERS = ("\\", ":", "\0")
+_MAX_COMPONENT_BYTES = 255
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, got {type(entries).__name__}")
+    root_path = _validate_root(root)
+    parsed = [_parse_entry(entry) for entry in entries]
+    _check_batch_collisions(parsed)
+    for name, parts, _ in parsed:
+        _check_target(root_path, name, parts)
+    for _, parts, data in parsed:
+        _write_file(root_path, parts, data)
+    return [name for name, _, _ in parsed]
+
+
+def _lstat_or_none(path):
+    """Return lstat(path), or None when the path does not exist."""
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be str or pathlib.Path, got {type(root).__name__}")
+    if root == "":
+        raise ValueError("root must be a nonempty path, not ''")
+    root_path = Path(root)
+    try:
+        status = _lstat_or_none(root_path)
+    except NotADirectoryError as error:
+        raise ValueError(f"root has a non-directory ancestor: {root_path}") from error
+    if status is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if stat.S_ISLNK(status.st_mode):
+        raise ValueError(f"root must not be a symbolic link: {root_path}")
+    if not stat.S_ISDIR(status.st_mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _parse_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, got {type(entry).__name__}")
+    name, data = entry
+    parts = _split_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, got {type(data).__name__}")
+    return name, parts, data
+
+
+def _split_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, got {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"name must be a nonempty relative path: {name!r}")
+    for character in _FORBIDDEN_NAME_CHARACTERS:
+        if character in name:
+            raise ValueError(f"name contains forbidden character {character!r}: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"name is not valid Unicode: {name!r}") from error
+    parts = tuple(name.split("/"))
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+    if any(len(part.encode("utf-8")) > _MAX_COMPONENT_BYTES for part in parts):
+        raise ValueError(f"name has a component longer than {_MAX_COMPONENT_BYTES} bytes: {name!r}")
+    return parts
+
+
+def _check_batch_collisions(parsed):
+    files = set()
+    directories = set()
+    for name, parts, _ in parsed:
+        if parts in files:
+            raise ValueError(f"duplicate name in batch: {name!r}")
+        if parts in directories:
+            raise ValueError(f"name is a directory of another entry in batch: {name!r}")
+        ancestors = [parts[:i] for i in range(1, len(parts))]
+        if any(ancestor in files for ancestor in ancestors):
+            raise ValueError(f"name lies under a file of another entry in batch: {name!r}")
+        files.add(parts)
+        directories.update(ancestors)
+    assert len(files) == len(parsed), "batch collision check let a duplicate through"
+
+
+def _check_target(root, name, parts):
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        status = _lstat_or_none(current)
+        if status is None:
+            return
+        if stat.S_ISLNK(status.st_mode):
+            raise ValueError(f"symbolic link in the way of {name!r}: {current}")
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists for {name!r}: {current}")
+        if not stat.S_ISDIR(status.st_mode):
+            raise ValueError(f"ancestor of {name!r} is not a directory: {current}")
+
+
+def _write_file(root, parts, data):
+    assert parts, "validated names have at least one component"
+    target = root.joinpath(*parts)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    assert target.parent.is_dir(), "parent directory must exist before writing"
+    with open(target, "xb") as handle:
+        handle.write(data)
