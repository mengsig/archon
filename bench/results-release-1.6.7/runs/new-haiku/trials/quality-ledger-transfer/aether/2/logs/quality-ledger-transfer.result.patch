+class LedgerTransferSemantics(unittest.TestCase):
+    def test_exact_balance_transfer_succeeds(self):
+        ledger = Ledger({"a": 4, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 4), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 4})
+
+    def test_one_over_balance_fails_unchanged(self):
+        ledger = Ledger({"a": 4, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), False)
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 0})
+
+    def test_destination_overflow_fails_unchanged(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE - 1})
+        self.assertIs(ledger.transfer("a", "b", 2), False)
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": MAX_BALANCE - 1})
+
+    def test_destination_filled_exactly_to_max_succeeds(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE - 1})
+        self.assertIs(ledger.transfer("a", "b", 1), True)
+        self.assertEqual(ledger.snapshot(), {"a": 1, "b": MAX_BALANCE})
+
+    def test_total_is_preserved(self):
+        ledger = Ledger({"a": 7, "b": 11, "c": 13})
+        ledger.transfer("a", "b", 3)
+        ledger.transfer("c", "a", 13)
+        ledger.transfer("b", "c", 20)
+        self.assertEqual(sum(ledger.snapshot().values()), 31)
+
+    def test_failed_transfer_does_not_partially_apply(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE})
+
