@@ -0,0 +1,94 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task_and_never_reuses_its_id(self):
+        store = TaskStore()
+        store.add("first")
+        second = store.add("second")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [1])
+        self.assertEqual(store.add("third").id, second.id + 1)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_complete_of_already_done_task_keeps_it_done(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        store.add("keep")
+        task = store.add("report", tags=["work", "q3"], due=date(2026, 5, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.title, "report")
+        self.assertEqual(restored.tags, ["work", "q3"])
+        self.assertEqual(restored.due, date(2026, 5, 1))
+        self.assertEqual(restored.status, "done")
+        self.assertEqual([t.id for t in store.all()], [1, 2])
+
+    def test_undo_delete_snapshot_is_not_affected_by_caller_mutation(self):
+        store = TaskStore()
+        task = store.add("report", tags=["work"])
+        deleted = store.delete(task.id)
+        deleted.tags.append("changed-after-delete")
+        store.undo()
+        self.assertEqual(store.get(task.id).tags, ["work"])
+
+    def test_undo_walks_back_across_kinds_lifo(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_returns_affected_task(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        self.assertEqual(store.undo().id, task.id)
+        self.assertEqual(store.undo().id, task.id)
+
+
+if __name__ == "__main__":
+    unittest.main()
