+// Follows next_cursor until it is null or absent. The first request sends no cursor.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor = null;
+  do {
+    const query = cursor === null ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error('GET /items failed: response has no items array');
+    }
+    items.push(...body.items);
+    cursor = body.next_cursor ?? null;
+    if (cursor !== null && seenCursors.has(cursor)) {
+      throw new Error(`GET /items repeated cursor ${JSON.stringify(cursor)}; pagination would not end`);
+    }
+    if (cursor !== null) seenCursors.add(cursor);
+  } while (cursor !== null);
+  return items;
 }
 
