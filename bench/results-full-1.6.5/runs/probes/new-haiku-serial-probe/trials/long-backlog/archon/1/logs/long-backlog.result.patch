+++ b/tests/test_search.py
@@ -0,0 +1,77 @@
+"""Tests for the TT-103 search query language."""
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def sample_store():
+    store = TaskStore()
+    store.add("Fix Login bug", tags=["Work"])
+    store.add("write report", tags=["home", "work"])
+    store.add("fix login page", tags=["web"])
+    store.add("buy milk")
+    store.complete(2)
+    return store
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = sample_store().all()
+
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(titles(search(self.tasks, "")), titles(self.tasks))
+        self.assertEqual(titles(search(self.tasks, "   ")), titles(self.tasks))
+
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(titles(search(self.tasks, "LOGIN")), ["Fix Login bug", "fix login page"])
+
+    def test_terms_must_all_match(self):
+        self.assertEqual(titles(search(self.tasks, "fix page")), ["fix login page"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix Login bug", "fix login page"])
+        self.assertEqual(titles(search(self.tasks, '"login fix"')), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Fix Login bug", "write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+
+    def test_status_filters(self):
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["write report"])
+        self.assertEqual(titles(search(self.tasks, "status:OPEN fix")), ["Fix Login bug", "fix login page"])
+
+    def test_combined_terms(self):
+        self.assertEqual(titles(search(self.tasks, "login tag:web")), ["fix login page"])
+        self.assertEqual(titles(search(self.tasks, 'tag:"work" "report"')), ["write report"])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_quoted_field_like_text_is_a_phrase(self):
+        self.assertEqual(titles(search(self.tasks, '"due:today"')), [])
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(self.tasks))
+        self.assertEqual(titles(search(reversed_tasks, "fix")), ["fix login page", "Fix Login bug"])
+
+
+if __name__ == "__main__":
+    unittest.main()
