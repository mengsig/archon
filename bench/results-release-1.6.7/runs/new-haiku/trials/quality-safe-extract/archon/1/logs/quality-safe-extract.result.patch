diff --git a/safe_extract.py b/safe_extract.py
index 0007027..76478f4 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,113 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Validate the whole batch, then write it under root. Returns the names in input order."""
+    if type(entries) is not list:
+        raise ValueError("entries must be a list of (name, data) tuples")
+    names = [_validate_entry(entry) for entry in entries]
+    _check_batch_conflicts(names)
+    root_path = _validate_root(root)
+    _check_filesystem(root_path, names)
+    _write_entries(root_path, entries)
+    return names
+
+
+def _validate_entry(entry):
+    if type(entry) is not tuple or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    _validate_name(name)
+    if type(data) is not bytes:
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name
+
+
+def _validate_name(name):
+    if type(name) is not str:
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative: {name!r}")
+    for character in ("\\", ":", "\0"):
+        if character in name:
+            raise ValueError(f"entry name {name!r} contains forbidden character {character!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name {name!r} has an empty, '.' or '..' component")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name {name!r} is not valid UTF-8 text") from exc
+
+
+def _ancestors(name):
+    parts = name.split("/")
+    assert all(parts), "names must be validated before use"
+    return ["/".join(parts[:i]) for i in range(1, len(parts))]
+
+
+def _check_batch_conflicts(names):
+    unique_names = set()
+    for name in names:
+        if name in unique_names:
+            raise ValueError(f"duplicate entry name {name!r}")
+        unique_names.add(name)
+    for name in names:
+        for ancestor in _ancestors(name):
+            if ancestor in unique_names:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in this batch")
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError("root must be a non-empty str or pathlib.Path")
+    root_path = Path(root)
+    if ".." in root_path.parts:
+        raise ValueError(f"root must not contain '..': {root_path}")
+    status = _lstat_or_none(root_path)
+    if status is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if stat.S_ISLNK(status.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not stat.S_ISDIR(status.st_mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
+
+
+def _check_filesystem(root, names):
+    directories = {ancestor for name in names for ancestor in _ancestors(name)}
+    for directory in sorted(directories):
+        _check_directory_or_absent(root, directory)
+    for name in names:
+        if _lstat_or_none(root / name) is not None:
+            raise ValueError(f"target already exists: {name!r}")
+
+
+def _check_directory_or_absent(root, relative):
+    status = _lstat_or_none(root / relative)
+    if status is None:
+        return
+    if not stat.S_ISDIR(status.st_mode):
+        raise ValueError(f"{relative!r} exists and is not a real directory")
+
+
+def _write_entries(root, entries):
+    for name, data in entries:
+        target = root / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        assert target.parent.is_dir() and not target.parent.is_symlink()
+        with open(target, "xb") as handle:
+            handle.write(data)
diff --git a/test_safe_extract.py b/test_safe_extract.py
