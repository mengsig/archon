+import os
 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
 
+def snapshot(root):
+    """Return every path below root, so tests can prove nothing was created."""
+    found = []
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in dirnames + filenames:
+            found.append(os.path.relpath(os.path.join(dirpath, name), root))
+    return sorted(found)
+
+
+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.base = Path(self._tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertRejects(self, entries, root=None):
+        """Assert extract raises ValueError and leaves the whole tree unchanged."""
+        before = snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(snapshot(self.base), before)
+
+
