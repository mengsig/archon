@@ -1,4 +1,7 @@
-use ledger::{parse_cents, parse_line, to_csv_row};
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+use ledger::{parse_cents, parse_currency, parse_line, to_csv_row, ParseError, CSV_HEADER};
 
 #[test]
 fn parses_amounts() {
@@ -18,3 +21,81 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\trent\t-900\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,rent,-90000,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    for code in ["eur", "EU", "EURO", "E1R", "", "€UR"] {
+        assert_eq!(
+            parse_currency(code),
+            Err(ParseError::BadCurrency(code.to_string())),
+            "code {code:?}"
+        );
+        let line = format!("2026-03-01\trent\t1\t{code}");
+        assert!(
+            matches!(parse_line(&line), Err(ParseError::BadCurrency(_))),
+            "line {line:?}"
+        );
+    }
+}
+
+#[test]
+fn header_lists_currency_column() {
+    assert_eq!(CSV_HEADER, "date,account,amount_cents,currency");
+}
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("stdin is piped")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn binary_exports_currency_column() {
+    let out = run_ledger("2026-03-01\trent\t-9\tEUR\n2026-03-02\tcoffee\t3.50\n");
+    assert_eq!(out.status.code(), Some(0));
+    let stdout = String::from_utf8(out.stdout).unwrap();
+    assert_eq!(
+        stdout,
+        format!("{CSV_HEADER}\n2026-03-01,rent,-900,EUR\n2026-03-02,coffee,350,USD\n")
+    );
+}
+
+#[test]
+fn binary_exits_2_on_bad_currency_naming_line() {
+    let out = run_ledger("2026-03-01\trent\t-9\tEUR\n2026-03-02\tcoffee\t3.50\teur\n");
+    assert_eq!(out.status.code(), Some(2));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 2: bad currency"), "stderr: {stderr}");
+}
+
+#[test]
+fn binary_exits_1_on_other_input_errors() {
+    let out = run_ledger("March 1\trent\t1\tEUR\n");
+    assert_eq!(out.status.code(), Some(1));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 1: bad date"), "stderr: {stderr}");
+}
