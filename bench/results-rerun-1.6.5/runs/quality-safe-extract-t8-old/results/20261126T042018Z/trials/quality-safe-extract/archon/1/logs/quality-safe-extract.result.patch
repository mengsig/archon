+class ExtractNonListBatch(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_non_list_batches_are_rejected(self):
+        batches = [(("a", b"x"),), (), None, "a", b"", {}]
+        for batch in batches:
+            with self.subTest(batch=batch):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(tree(self.root), [])
+
+    def test_iterator_and_generator_are_not_consumed(self):
+        iterator = iter([("a", b"x")])
+        generator = ((name, b"x") for name in ["b"])
+        for batch in (iterator, generator):
+            with self.assertRaises(ValueError):
+                extract(batch, self.root)
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertEqual(next(generator), ("b", b"x"))
+        self.assertEqual(tree(self.root), [])
+
+    def test_empty_tuple_batch_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract((), self.root)
+
