@@ -1,5 +1,106 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+_BAD_COMPONENTS = ("", ".", "..")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    names = _validate_entries(entries)
+    assert len(names) == len(entries)
+    if not names:
+        return []
+    for name in names:
+        _check_absent_on_disk(root_path, name)
+    for name, data in entries:
+        _write_file(root_path, name, data)
+    return names
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, os.PathLike)):
+        raise ValueError("root must be a str or pathlib.Path")
+    root_path = os.fspath(root)
+    if not isinstance(root_path, str):
+        raise ValueError("root must be a str or pathlib.Path")
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError):
+        raise ValueError(f"root does not exist: {root_path!r}") from None
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_path!r}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root is not a directory: {root_path!r}")
+    return root_path
+
+
+def _validate_entries(entries):
+    names = []
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        _check_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError(f"data for {name!r} must be bytes")
+        names.append(name)
+    _check_name_conflicts(names)
+    return names
+
+
+def _check_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, got {type(name).__name__}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    if any(part in _BAD_COMPONENTS for part in name.split("/")):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not encodable: {name!r}") from exc
+
+
+def _check_name_conflicts(names):
+    name_set = set(names)
+    if len(name_set) != len(names):
+        raise ValueError("batch contains duplicate entry names")
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in name_set:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in the batch")
+
+
+def _check_absent_on_disk(root, name):
+    parts = name.split("/")
+    for depth in range(1, len(parts) + 1):
+        path = os.path.join(root, *parts[:depth])
+        info = _lstat_or_none(path)
+        if info is None:
+            return
+        if depth == len(parts):
+            raise ValueError(f"target already exists: {name!r}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor of {name!r} is not a real directory: {path!r}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_file(root, name, data):
+    path = os.path.join(root, *name.split("/"))
+    os.makedirs(os.path.dirname(path), exist_ok=True)
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
