+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    if (request.query.cursor === undefined) {
+      return { status: 200, body: { items: [ITEMS[0]], next_cursor: 'opaque-token' } };
+    }
+    assert.equal(request.query.cursor, 'opaque-token');
+    return { status: 200, body: { items: [ITEMS[1]], next_cursor: null } };
+  };
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 2);
+  assert.equal(seen[0].cursor, undefined);
+});
