+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation_and_copying(self):
+        for balances in (None, [], {"": 1}, {1: 1}, {"a": True},
+                         {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+        original = {"a": 4}
+        ledger = Ledger(original)
+        original["a"] = 9
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 12
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_is_validated_before_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+    def test_overflow_and_insufficient_funds_are_atomic(self):
+        ledger = Ledger({"empty": 0, "full": MAX_BALANCE, "source": 5})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("source", "full", 1), False)
+        self.assertIs(ledger.transfer("empty", "source", 1), False)
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_self_transfer_checks_funds_without_mutating(self):
+        ledger = Ledger({"a": MAX_BALANCE, "small": 2})
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("small", "small", 3), False)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE, "small": 2})
+
+    def test_concurrent_opposite_transfers_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = Barrier(3)
+
+        def move(source, destination):
+            start.wait()
+            for _ in range(1000):
+                ledger.transfer(source, destination, 1)
+
+        workers = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for worker in workers:
+            worker.start()
+        start.wait()
+        for _ in range(1000):
+            snapshot = ledger.snapshot()
+            self.assertEqual(sum(snapshot.values()), 200)
+        for worker in workers:
+            worker.join()
+        self.assertEqual(sum(ledger.snapshot().values()), 200)
