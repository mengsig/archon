+++ b/tests/test_export.py
@@ -0,0 +1,60 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+HEADER = "id,title,tags,status,due"
+
+
+def parse(text):
+    return list(csv.reader(io.StringIO(text, newline="")))
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_header_only_when_no_tasks(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_plain_row_is_not_quoted_and_uses_crlf(self):
+        task = Task(1, "plain title", ["a", "b"], "open", date(2026, 4, 1))
+        self.assertEqual(to_csv([task]), HEADER + "\r\n1,plain title,a;b,open,2026-04-01\r\n")
+
+    def test_missing_due_and_tags_are_empty(self):
+        task = Task(2, "no extras", [], DONE, None)
+        self.assertEqual(to_csv([task]), HEADER + "\r\n2,no extras,,done,\r\n")
+
+    def test_rows_keep_input_order(self):
+        tasks = [Task(3, "c"), Task(1, "a"), Task(2, "b")]
+        rows = parse(to_csv(tasks))[1:]
+        self.assertEqual([row[0] for row in rows], ["3", "1", "2"])
+
+    def test_comma_quote_and_newlines_are_quoted(self):
+        tasks = [
+            Task(1, "buy milk, eggs"),
+            Task(2, 'say "hi"'),
+            Task(3, "line one\nline two"),
+            Task(4, "carriage\rreturn"),
+        ]
+        rows = parse(to_csv(tasks))
+        self.assertEqual([row[1] for row in rows[1:]], [
+            "buy milk, eggs",
+            'say "hi"',
+            "line one\nline two",
+            "carriage\rreturn",
+        ])
+        self.assertIn('1,"buy milk, eggs",,open,', to_csv(tasks))
+        self.assertIn('2,"say ""hi""",,open,', to_csv(tasks))
+
+    def test_quoted_fields_round_trip_with_all_columns(self):
+        task = Task(5, 'a, "b"\nc', ["x;y"], "open", date(2027, 1, 2))
+        self.assertEqual(parse(to_csv([task]))[1], ["5", 'a, "b"\nc', "x;y", "open", "2027-01-02"])
+
+    def test_semicolon_and_spaces_are_not_quoted(self):
+        task = Task(6, "  spaced; title  ", ["t1", "t2"])
+        self.assertEqual(to_csv([task]), HEADER + "\r\n6,  spaced; title  ,t1;t2,open,\r\n")
+
+
+if __name__ == "__main__":
+    unittest.main()
