+class ValidationTest(unittest.TestCase):
+    def test_bad_rate_parameters_raise(self):
+        for capacity, refill in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5),
+                                 (float("nan"), 1.0), (1, float("inf")),
+                                 (float("inf"), 1.0)]:
+            with self.subTest(capacity=capacity, refill=refill):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, refill)
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, refill)
+
+    def test_bad_max_keys_raises(self):
+        for max_keys in [0, -1, 1.5]:
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys)
+
+    def test_bad_n_raises_for_bucket_methods(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_bad_n_does_not_create_key(self):
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("x", 0)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("x", 5)
+        self.assertEqual(len(limiter), 0)
+
+
+class BucketTest(unittest.TestCase):
+    def test_failed_acquire_removes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 0.5, clock=clock)
+        self.assertTrue(bucket.try_acquire())
+        clock.now = 1.0
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 2.0
+        self.assertTrue(bucket.try_acquire())
+
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_wait_time_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertEqual(bucket.wait_time(1), 0.5)
+        self.assertEqual(bucket.wait_time(1), 0.5)
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_wait_time_is_enough_to_succeed(self):
+        clock = FakeClock()
+        bucket = TokenBucket(5, 3.0, clock=clock)
+        bucket.try_acquire(5)
+        clock.now = 0.25
+        wait = bucket.wait_time(4)
+        clock.now += wait
+        self.assertTrue(bucket.try_acquire(4))
+
+    def test_wait_time_survives_float_rounding(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 3.7, clock=clock)
+        for n in [0.7, 1.4544466768785653, 0.9123, 1.9]:
+            with self.subTest(n=n):
+                clock.now += 0.1
+                bucket.try_acquire(n)
+                clock.now += bucket.wait_time(n)
+                self.assertTrue(bucket.try_acquire(n))
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 3.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 6.0
+        self.assertEqual(bucket.available(), 6.0)
+
+
+class KeyedLimiterTest(unittest.TestCase):
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        limiter.try_acquire("a")
+        self.assertEqual(len(limiter), 2)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("a"))  # touches "a", so "b" is LRU
+        self.assertTrue(limiter.try_acquire("c"))   # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))   # "b" returns full; evicts "a"
+        self.assertTrue(limiter.try_acquire("a"))   # "a" returns full again
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertEqual(limiter.wait_time("a"), 1.0)  # touches "a", so "b" is LRU
+        limiter.try_acquire("c")                       # evicts "b"
+        self.assertEqual(limiter.wait_time("a"), 1.0)  # "a" kept its drained state
+        self.assertTrue(limiter.try_acquire("b"))      # "b" was evicted, starts full
+
+    def test_evicted_drained_key_returns_full(self):
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a", 2)
+        limiter.try_acquire("b")
+        self.assertEqual(limiter.wait_time("a", 2), 0.0)
+
+    def test_shared_clock_drives_all_keys(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        clock.now = 1.0
+        self.assertTrue(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
     unittest.main()
