+class LedgerConcurrency(unittest.TestCase):
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        rounds = 2000
+
+        def ping():
+            for _ in range(rounds):
+                ledger.transfer("a", "b", 1)
+
+        def pong():
+            for _ in range(rounds):
+                ledger.transfer("b", "a", 1)
+
+        threads = [threading.Thread(target=ping), threading.Thread(target=pong)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        self.assertFalse(any(t.is_alive() for t in threads))
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 500, "b": 500})
+        stop = threading.Event()
+        bad_totals = []
+
+        def mover():
+            for _ in range(2000):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+            stop.set()
+
+        def observer():
+            while not stop.is_set():
+                if sum(ledger.snapshot().values()) != 1000:
+                    bad_totals.append(True)
+
+        threads = [threading.Thread(target=mover), threading.Thread(target=observer)]
+        for t in threads:
+            t.start()
+        for t in threads:
+            t.join()
+        self.assertEqual(bad_totals, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
