@@ -26,13 +40,41 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append((COMPLETE, task_id, task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append((DELETE, task_id, replace(task, tags=list(task.tags))))
         del self._tasks[task_id]
         return task
 
+    def undo(self):
+        if not self._undo_log:
+            raise NothingToUndo("no add, complete or delete to undo")
+        kind, task_id, saved = self._undo_log.pop()
+        if kind == ADD:
+            return self._undo_add(task_id)
+        if kind == COMPLETE:
+            return self._undo_complete(task_id, saved)
+        assert kind == DELETE, f"unknown undo kind {kind!r}"
+        return self._undo_delete(saved)
+
+    def _undo_add(self, task_id):
+        assert task_id in self._tasks, f"added task {task_id} is missing"
+        return self._tasks.pop(task_id)
+
+    def _undo_complete(self, task_id, previous_status):
+        assert previous_status in (OPEN, DONE), f"bad status {previous_status!r}"
+        task = self.get(task_id)
+        task.status = previous_status
+        return task
+
+    def _undo_delete(self, task):
+        assert task.id not in self._tasks, f"task {task.id} was reused"
+        self._tasks[task.id] = task
+        return task
+
     def all(self):
         return sorted(self._tasks.values(), key=lambda t: t.id)
