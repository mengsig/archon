     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn parses_explicit_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t10.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,1000,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    for line in [
+        "2026-03-01\trent\t1\teur",
+        "2026-03-01\trent\t1\tEURO",
+        "2026-03-01\trent\t1\tEU",
+        "2026-03-01\trent\t1\tE1R",
+        "2026-03-01\trent\t1\t",
+    ] {
+        let err = parse_line(line).unwrap_err();
+        assert!(matches!(err, LineError::BadCurrency(_)), "{line:?} gave {err:?}");
+        assert_eq!(err.exit_code(), 2);
+    }
+}
+
+#[test]
+fn other_errors_exit_with_one() {
+    let err = parse_line("2026-03-01\trent\tabc\tEUR").unwrap_err();
+    assert_eq!(err.exit_code(), 1);
+    let err = parse_line("2026-03-01\trent\t1\tEUR\textra").unwrap_err();
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn csv_header_has_currency_column() {
+    assert_eq!(CSV_HEADER, "date,account,amount_cents,currency");
+}
+
+fn run_binary(stdin: &str) -> (i32, String, String) {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child.stdin.take().unwrap().write_all(stdin.as_bytes()).unwrap();
+    let out = child.wait_with_output().unwrap();
+    (
+        out.status.code().unwrap(),
+        String::from_utf8(out.stdout).unwrap(),
+        String::from_utf8(out.stderr).unwrap(),
+    )
+}
+
+#[test]
+fn binary_exports_currency_and_defaults_to_usd() {
+    let (code, stdout, _) = run_binary("2026-03-01\trent\t-10\n2026-03-02\tfood\t2.50\tEUR\n");
+    assert_eq!(code, 0);
+    assert_eq!(
+        stdout,
+        "date,account,amount_cents,currency\n\
+         2026-03-01,rent,-1000,USD\n\
+         2026-03-02,food,250,EUR\n"
+    );
+}
+
+#[test]
+fn binary_exits_two_on_bad_currency_naming_line() {
+    let (code, stdout, stderr) = run_binary(
+        "2026-03-01\trent\t-10\n# note\n2026-03-02\tfood\t2.50\teu\n",
+    );
+    assert_eq!(code, 2);
+    assert!(stderr.starts_with("line 3: bad currency"), "stderr: {stderr}");
+    assert!(stdout.starts_with("date,account,amount_cents,currency\n"));
+}
+
+#[test]
+fn binary_exits_one_on_other_errors() {
+    let (code, _, stderr) = run_binary("2026-03-01\trent\tabc\n");
+    assert_eq!(code, 1);
+    assert!(stderr.starts_with("line 1: bad amount"), "stderr: {stderr}");
+}
