 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_integer(value, low, high, label):
+    if type(value) is not int:
+        raise ValueError(f"{label} must be a built-in integer")
+    if not low <= value <= high:
+        raise ValueError(f"{label} must be in [{low}, {high}]")
+
+
+def _check_account_name(name):
+    if type(name) is not str or not name:
+        raise ValueError("account name must be a nonempty string")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+        checked = {}
+        for name, balance in balances.items():
+            _check_account_name(name)
+            _check_integer(balance, 0, MAX_BALANCE, f"balance for {name!r}")
+            checked[name] = balance
+        self._balances = checked
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_integer(amount, 1, MAX_BALANCE, "amount")
+        # Account keys never change after construction, so membership needs no lock.
+        self._require_account(source)
+        self._require_account(destination)
+        with self._lock:
+            if source == destination:
+                return self._balances[source] >= amount
+            if self._balances[source] < amount:
+                return False
+            if self._balances[destination] + amount > MAX_BALANCE:
+                return False
+            self._balances[source] -= amount
+            self._balances[destination] += amount
+            assert self._balances[source] >= 0
+            assert self._balances[destination] <= MAX_BALANCE
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _require_account(self, name):
+        # Non-str names cannot be accounts; checking the type first avoids hashing them.
+        if type(name) is not str or name not in self._balances:
+            raise KeyError(name)
