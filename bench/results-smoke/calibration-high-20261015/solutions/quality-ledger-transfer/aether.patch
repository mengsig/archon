+class LedgerConstruction(unittest.TestCase):
+    def test_empty_ledger_allowed(self):
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_boundary_balances_accepted(self):
+        ledger = Ledger({"zero": 0, "max": MAX_BALANCE})
+        self.assertEqual(ledger.snapshot(), {"zero": 0, "max": MAX_BALANCE})
+
+    def test_non_dict_rejected(self):
