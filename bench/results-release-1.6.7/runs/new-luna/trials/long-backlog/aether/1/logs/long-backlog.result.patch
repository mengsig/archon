diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..124087e 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,49 @@
+class QueryError(ValueError):
+    pass
+
+
+def _split_terms(query):
+    terms = []
+    current = []
+    quoted = False
+    term_quoted = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+            term_quoted = True
+        elif char.isspace() and not quoted:
+            if current or term_quoted:
+                terms.append(("".join(current), term_quoted))
+                current = []
+                term_quoted = False
+        else:
+            current.append(char)
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current or term_quoted:
+        terms.append(("".join(current), term_quoted))
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _split_terms(query)
+    predicates = []
+    for term, quoted in terms:
+        if not quoted and ":" in term:
+            field, value = term.split(":", 1)
+            if field == "tag" and value:
+                expected = value.casefold()
+                predicates.append(
+                    lambda task, expected=expected: any(
+                        str(tag).casefold() == expected for tag in task.tags
+                    )
+                )
+            elif field == "status" and value.casefold() in ("open", "done"):
+                expected = value.casefold()
+                predicates.append(lambda task, expected=expected: task.status.casefold() == expected)
+            else:
+                raise QueryError(f"invalid query term: {term}")
+        else:
+            expected = term.casefold()
+            predicates.append(lambda task, expected=expected: expected in task.title.casefold())
+    return [task for task in tasks if all(predicate(task) for predicate in predicates)]
