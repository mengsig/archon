 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _validate_root(root)
+    names = _validate_entries(entries)
+    _check_batch_conflicts(names)
+    for name in names:
+        _check_target_absent(root_path, name)
+    for name, data in entries:
+        _write_entry(root_path, name, data)
+    return names
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be str or Path, not {type(root).__name__}")
+    if root == "":
+        raise ValueError("root must not be empty")
+    root_path = Path(root)
+    root_stat = _lstat_or_none(root_path)
+    if root_stat is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if stat.S_ISLNK(root_stat.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _validate_entries(entries):
+    names = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError(f"entry {index} must be a (name, data) tuple")
+        name, data = entry
+        _validate_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+        names.append(name)
+    return names
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if name == "" or name.startswith("/"):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not encodable: {name!r}") from exc
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name has an invalid component: {name!r}")
+
+
+def _check_batch_conflicts(names):
+    unique = set()
+    for name in names:
+        if name in unique:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        unique.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in unique:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in the batch")
+
+
+def _check_target_absent(root, name):
+    parts = name.split("/")
+    assert all(parts), "names must be validated before checking the filesystem"
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        current_stat = _lstat_or_none(current)
+        if current_stat is None:
+            return
+        if stat.S_ISLNK(current_stat.st_mode):
+            raise ValueError(f"symlink below root is not allowed: {current}")
+        if not stat.S_ISDIR(current_stat.st_mode):
+            raise ValueError(f"ancestor is not a directory: {current}")
+    target = current / parts[-1]
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"target already exists: {target}")
+
+
+def _write_entry(root, name, data):
+    assert isinstance(data, bytes), "data must be validated before writing"
+    parts = name.split("/")
+    os.makedirs(root.joinpath(*parts[:-1]), exist_ok=True)
+    with open(root / name, "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    # A non-directory ancestor means the path cannot exist, so it is reported as absent.
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
