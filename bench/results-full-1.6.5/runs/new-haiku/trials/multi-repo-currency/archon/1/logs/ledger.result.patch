diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..112f87a
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,70 @@
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+struct Run {
+    status: i32,
+    stdout: String,
+    stderr: String,
+}
+
+fn run(input: &str) -> Run {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("stdin is piped")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    let out = child.wait_with_output().expect("wait for ledger");
+    Run {
+        status: out.status.code().expect("exit code"),
+        stdout: String::from_utf8(out.stdout).expect("utf8 stdout"),
+        stderr: String::from_utf8(out.stderr).expect("utf8 stderr"),
+    }
+}
+
+#[test]
+fn missing_currency_exports_usd() {
+    let run_result = run("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(run_result.status, 0);
+    assert_eq!(
+        run_result.stdout,
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn explicit_currency_is_exported() {
+    let run_result = run("2026-03-01\tgroceries\t10\tEUR\n");
+    assert_eq!(run_result.status, 0);
+    assert!(run_result
+        .stdout
+        .ends_with("2026-03-01,groceries,1000,EUR\n"));
+}
+
+#[test]
+fn malformed_currency_exits_2_with_line_number() {
+    let run_result = run("# note\n\n2026-03-01\tgroceries\t1\tEUR\n2026-03-02\trent\t2\teur\n");
+    assert_eq!(run_result.status, 2);
+    assert!(
+        run_result.stderr.starts_with("line 4: bad currency"),
+        "stderr: {}",
+        run_result.stderr
+    );
+}
+
+#[test]
+fn other_input_errors_exit_1_with_line_number() {
+    let run_result = run("# note\n\n2026-03-01\tgroceries\t1\n2026/03/02\trent\t2\n");
+    assert_eq!(run_result.status, 1);
+    assert!(
+        run_result.stderr.starts_with("line 4: bad date"),
+        "stderr: {}",
+        run_result.stderr
+    );
+}
