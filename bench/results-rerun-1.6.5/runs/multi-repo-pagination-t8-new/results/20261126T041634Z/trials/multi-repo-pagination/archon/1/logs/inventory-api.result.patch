@@ -21,8 +31,48 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit, after_id = _page_params(query)
+    except BadRequest as exc:
+        return _error(400, str(exc))
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    has_more = len(remaining) > limit
+    next_cursor = str(page[-1]["id"]) if has_more else None
+    assert len(page) <= limit
+    assert next_cursor is None or page
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _page_params(query):
+    """Return `(limit, after_id)`; `after_id` is None on the first page."""
+    limit = _parse_limit(query.get("limit"))
+    after_id = _parse_cursor(query.get("cursor"))
+    return limit, after_id
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_plain_int(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None
+    if not _is_plain_int(raw):
+        raise BadRequest("invalid cursor")
+    return int(raw)
+
+
+def _is_plain_int(raw):
+    return isinstance(raw, str) and _PLAIN_INT.fullmatch(raw) is not None
 
 
