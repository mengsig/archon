index 0007027..db0bc34 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,118 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = frozenset("\\:\x00")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _check_batch_type(entries)
+    root_path = _check_root(root)
+    planned = [_check_entry(entry) for entry in entries]
+    _check_batch_conflicts(planned)
+    for parts, _ in planned:
+        _check_target(root_path, parts)
+
+    for parts, data in planned:
+        _write_entry(root_path, parts, data)
+
+    names = [name for name, _ in entries]
+    assert len(names) == len(planned)
+    return names
+
+
+def _check_batch_type(entries):
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"entries must be a list, got {type(entries).__name__}"
+        )
+
+
+def _check_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty path or string, got {root!r}")
+    root_path = Path(root)
+    try:
+        root_stat = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root!r}") from exc
+    if stat.S_ISLNK(root_stat.st_mode):
+        raise ValueError(f"root must not be a symlink: {root!r}")
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise ValueError(f"root is not a directory: {root!r}")
+    return root_path
+
+
+def _check_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, got {entry!r}")
+    name, data = entry
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes")
+    return _split_name(name), data
+
+
+def _split_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be a string, got {name!r}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"name must be a nonempty relative path: {name!r}")
+    if any(char in _FORBIDDEN_NAME_CHARS for char in name):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name is not valid UTF-8: {name!r}") from exc
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+    assert "/".join(parts) == name
+    return parts
+
+
+def _check_batch_conflicts(planned):
+    """Reject duplicate names and file/directory collisions within the batch."""
+    files = set()
+    directories = set()
+    for parts, _ in planned:
+        key = tuple(parts)
+        if key in files or key in directories:
+            raise ValueError(f"duplicate entry name: {'/'.join(parts)!r}")
+        for depth in range(1, len(parts)):
+            prefix = tuple(parts[:depth])
+            if prefix in files:
+                raise ValueError(
+                    f"{'/'.join(prefix)!r} is both a file and a directory"
+                )
+            directories.add(prefix)
+        files.add(key)
+
+
+def _check_target(root_path, parts):
+    """Reject an existing target, or any existing component that is a symlink or non-directory."""
+    current = root_path
+    for depth, part in enumerate(parts):
+        current = current / part
+        try:
+            component_stat = os.lstat(current)
+        except FileNotFoundError:
+            return
+        except NotADirectoryError as exc:
+            raise ValueError(f"ancestor is not a directory: {current}") from exc
+        if stat.S_ISLNK(component_stat.st_mode):
+            raise ValueError(f"path contains a symlink: {current}")
+        is_last = depth == len(parts) - 1
+        if is_last:
+            raise ValueError(f"target already exists: {current}")
+        if not stat.S_ISDIR(component_stat.st_mode):
+            raise ValueError(f"ancestor is not a directory: {current}")
+
+
+def _write_entry(root_path, parts, data):
+    target = root_path.joinpath(*parts)
+    assert target.is_relative_to(root_path)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with open(target, "xb") as handle:
+        handle.write(data)
diff --git a/test_safe_extract.py b/test_safe_extract.py
