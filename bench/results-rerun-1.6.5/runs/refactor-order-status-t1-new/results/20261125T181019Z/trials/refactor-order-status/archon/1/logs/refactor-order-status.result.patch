@@ -0,0 +1,296 @@
+//! Characterization of the observable behaviour of the orders crate.
+//! Written against the public API only, and kept independent of how the
+//! status is stored: statuses are read through `Display`/`to_string()`.
+
+use orders::{billing, report, shipping, Order};
+
+fn status(order: &Order) -> String {
+    order.status.to_string()
+}
+
+fn pending(id: u32, total_cents: u64) -> Order {
+    Order::new(id, "ada", total_cents)
+}
+
+fn paid(id: u32, total_cents: u64) -> Order {
+    let mut order = pending(id, total_cents);
+    billing::pay(&mut order).unwrap();
+    order
+}
+
+fn shipped(id: u32, total_cents: u64) -> Order {
+    let mut order = paid(id, total_cents);
+    shipping::ship(&mut order).unwrap();
+    order
+}
+
+fn cancelled(id: u32, total_cents: u64) -> Order {
+    let mut order = pending(id, total_cents);
+    order.cancel().unwrap();
+    order
+}
+
+#[test]
+fn new_orders_start_pending_and_open() {
+    let order = Order::new(9, "eve", 4300);
+    assert_eq!(order.id, 9);
+    assert_eq!(order.customer, "eve");
+    assert_eq!(order.total_cents, 4300);
+    assert_eq!(status(&order), "pending");
+    assert!(order.is_open());
+}
+
+#[test]
+fn is_open_is_true_only_before_shipping_and_cancellation() {
+    assert!(pending(1, 1).is_open());
+    assert!(paid(1, 1).is_open());
+    assert!(!shipped(1, 1).is_open());
+    assert!(!cancelled(1, 1).is_open());
+}
+
+#[test]
+fn pay_is_allowed_only_from_pending() {
+    let mut order = pending(1, 1);
+    billing::pay(&mut order).unwrap();
+    assert_eq!(status(&order), "paid");
+
+    for mut order in [paid(4, 1), shipped(5, 1), cancelled(6, 1)] {
+        let before = status(&order);
+        let err = billing::pay(&mut order).unwrap_err();
+        assert_eq!(
+            err,
+            format!("order {} cannot be paid: it is {}", order.id, before)
+        );
+        assert_eq!(status(&order), before);
+    }
+}
+
+#[test]
+fn ship_is_allowed_only_from_paid() {
+    let mut order = paid(1, 1);
+    shipping::ship(&mut order).unwrap();
+    assert_eq!(status(&order), "shipped");
+
+    for mut order in [pending(4, 1), shipped(5, 1), cancelled(6, 1)] {
+        let before = status(&order);
+        let err = shipping::ship(&mut order).unwrap_err();
+        assert_eq!(
+            err,
+            format!("order {} cannot be shipped: it is {}", order.id, before)
+        );
+        assert_eq!(status(&order), before);
+    }
+}
+
+#[test]
+fn cancel_is_allowed_from_pending_and_paid_only() {
+    let mut from_pending = pending(1, 1);
+    from_pending.cancel().unwrap();
+    assert_eq!(status(&from_pending), "cancelled");
+
+    let mut from_paid = paid(2, 1);
+    from_paid.cancel().unwrap();
+    assert_eq!(status(&from_paid), "cancelled");
+
+    for mut order in [shipped(3, 1), cancelled(4, 1)] {
+        let before = status(&order);
+        let err = order.cancel().unwrap_err();
+        assert_eq!(
+            err,
+            format!("order {} cannot be cancelled: it is {}", order.id, before)
+        );
+        assert_eq!(status(&order), before);
+    }
+}
+
+#[test]
+fn full_lifecycle_error_messages_name_the_current_status() {
+    let mut order = Order::new(7, "fay", 10);
+    assert_eq!(
+        shipping::ship(&mut order).unwrap_err(),
+        "order 7 cannot be shipped: it is pending"
+    );
+    billing::pay(&mut order).unwrap();
+    shipping::ship(&mut order).unwrap();
+    assert_eq!(
+        billing::pay(&mut order).unwrap_err(),
+        "order 7 cannot be paid: it is shipped"
+    );
+    assert_eq!(
+        order.cancel().unwrap_err(),
+        "order 7 cannot be cancelled: it is shipped"
+    );
+}
+
+#[test]
+fn cancelled_order_error_messages_for_every_step() {
+    let mut order = cancelled(8, 1);
+    assert_eq!(
+        shipping::ship(&mut order).unwrap_err(),
+        "order 8 cannot be shipped: it is cancelled"
+    );
+    assert_eq!(
+        billing::pay(&mut order).unwrap_err(),
+        "order 8 cannot be paid: it is cancelled"
+    );
+    assert_eq!(
+        order.cancel().unwrap_err(),
+        "order 8 cannot be cancelled: it is cancelled"
+    );
+}
+
+#[test]
+fn outstanding_cents_counts_only_pending_orders() {
+    let orders = vec![
+        pending(1, 100),
+        paid(2, 200),
+        shipped(3, 400),
+        cancelled(4, 800),
+        pending(5, 16),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 116);
+}
+
+#[test]
+fn outstanding_cents_of_no_orders_is_zero() {
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_keeps_input_order_and_excludes_other_statuses() {
+    let orders = vec![
+        paid(3, 1),
+        pending(1, 1),
+        shipped(4, 1),
+        paid(2, 1),
+        cancelled(5, 1),
+        paid(9, 1),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [3, 2, 9]);
+}
+
+#[test]
+fn ready_to_ship_of_no_orders_is_empty() {
+    assert!(shipping::ready_to_ship(&[]).is_empty());
+}
+
+#[test]
+fn status_counts_are_sorted_by_status_name() {
+    let orders = vec![
+        shipped(1, 1),
+        pending(2, 1),
+        pending(3, 1),
+        cancelled(4, 1),
+        paid(5, 1),
+    ];
+    let counts: Vec<(String, usize)> = report::status_counts(&orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        counts,
+        [
+            ("cancelled".to_string(), 1),
+            ("paid".to_string(), 1),
+            ("pending".to_string(), 2),
+            ("shipped".to_string(), 1),
+        ]
+    );
+}
+
+#[test]
+fn status_counts_of_no_orders_is_empty() {
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn to_line_writes_id_customer_total_and_status_in_that_order() {
+    let order = Order::new(12, "grace hopper", 99);
+    assert_eq!(report::to_line(&order), "12,grace hopper,99,pending");
+    assert_eq!(report::to_line(&paid(13, 0)), "13,ada,0,paid");
+    assert_eq!(report::to_line(&shipped(14, 5)), "14,ada,5,shipped");
+    assert_eq!(report::to_line(&cancelled(15, 7)), "15,ada,7,cancelled");
+}
+
+#[test]
+fn from_line_round_trips_every_status() {
+    for order in [pending(1, 1), paid(2, 2), shipped(3, 3), cancelled(4, 4)] {
+        let line = report::to_line(&order);
+        assert_eq!(report::from_line(&line).unwrap(), order, "line: {line}");
+    }
+}
+
+#[test]
+fn from_line_trims_only_the_ends_of_the_whole_line() {
+    let mut expected = Order::new(5, "bo", 250);
+    billing::pay(&mut expected).unwrap();
+    shipping::ship(&mut expected).unwrap();
+    assert_eq!(
+        report::from_line("  5,bo,250,shipped \r\n").unwrap(),
+        expected
+    );
+    assert_eq!(report::from_line("5,bo,250,shipped  ").unwrap(), expected);
+}
+
+#[test]
+fn from_line_accepts_an_empty_customer() {
+    let parsed = report::from_line("6,,10,pending").unwrap();
+    assert_eq!(parsed.customer, "");
+    assert_eq!(status(&parsed), "pending");
+}
+
+#[test]
+fn from_line_rejects_status_text_that_is_not_exactly_lowercase() {
+    for bad in ["Paid", "PAID", "Pending", " paid", ""] {
+        let line = format!("1,ada,100,{bad}");
+        assert!(report::from_line(&line).is_err(), "accepted {line:?}");
+    }
+}
+
+#[test]
+fn from_line_error_messages_are_exact() {
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,paid,extra").unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+    assert_eq!(
+        report::from_line("").unwrap_err(),
+        "expected 4 fields, got 1"
+    );
+    assert_eq!(
+        report::from_line("x,ada,100,paid").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,-5,paid").unwrap_err(),
+        "bad total \"-5\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("4294967296,ada,1,paid").unwrap_err(),
+        "bad id \"4294967296\": number too large to fit in target type"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,lost").unwrap_err(),
+        "unknown status \"lost\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,100, paid").unwrap_err(),
+        "unknown status \" paid\""
+    );
+}
+
+#[test]
+fn from_line_reports_field_errors_in_order_before_status() {
+    assert_eq!(
+        report::from_line("x,ada,y,lost").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,y,lost").unwrap_err(),
+        "bad total \"y\": invalid digit found in string"
+    );
+}
