+/// Accepts an ISO 4217-shaped code: exactly three uppercase ASCII letters.
+fn parse_currency(s: &str) -> Result<String, LineError> {
+    let valid = s.len() == 3 && s.bytes().all(|c| c.is_ascii_uppercase());
+    if !valid {
+        return Err(LineError::Currency(format!("bad currency {s:?}")));
+    }
+    Ok(s.to_string())
+}
