+class LedgerConcurrency(unittest.TestCase):
+    ROUNDS = 2000
+
+    def _run_threads(self, targets):
+        threads = [threading.Thread(target=t) for t in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=30)
+            self.assertFalse(thread.is_alive(), "possible deadlock")
+
+    def test_opposite_transfers_do_not_deadlock_and_conserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def forward():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def backward():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        self._run_threads([forward, backward] * 2)
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+    def test_snapshots_never_see_partial_transfer(self):
+        ledger = Ledger({"a": 500, "b": 500})
+        seen_totals = []
+
+        def mover():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def observer():
+            for _ in range(self.ROUNDS):
+                seen_totals.append(sum(ledger.snapshot().values()))
+
+        self._run_threads([mover, observer])
+        self.assertTrue(all(total == 1000 for total in seen_totals))
+
+
+if __name__ == "__main__":
+    unittest.main()
