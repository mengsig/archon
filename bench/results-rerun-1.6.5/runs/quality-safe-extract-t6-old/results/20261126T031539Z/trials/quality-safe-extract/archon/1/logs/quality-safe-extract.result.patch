+class IoErrorsStayVisible(ExtractCase):
+    def test_directory_creation_error_propagates(self):
+        with mock.patch("safe_extract.os.makedirs", side_effect=PermissionError("denied")):
+            with self.assertRaises(PermissionError):
+                extract([("d/f", b"1")], self.root)
+
+    def test_validation_stage_io_error_propagates_without_writes(self):
+        real_lstat = os.lstat
+
+        def failing_lstat(path, *args, **kwargs):
+            if str(path).endswith("blocked"):
+                raise PermissionError("denied")
+            return real_lstat(path, *args, **kwargs)
+
+        before = tree_state(self.base)
+        with mock.patch("safe_extract.os.lstat", side_effect=failing_lstat):
+            with self.assertRaises(PermissionError):
+                extract([("ok", b"1"), ("blocked", b"2")], self.root)
+        self.assertEqual(tree_state(self.base), before)
+
+    def test_write_error_propagates(self):
+        with mock.patch("safe_extract.open", side_effect=OSError("disk full"), create=True):
+            with self.assertRaises(OSError):
+                extract([("f", b"1")], self.root)
