 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
+
+
+def _parts(name):
+    """Return validated POSIX path components, or raise ValueError."""
+    if (
+        not isinstance(name, str)
+        or not name
+        or name.startswith("/")
+        or "\\" in name
+        or ":" in name
+        or "\0" in name
+    ):
+        raise ValueError("invalid entry name")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError("invalid entry name")
+    return parts
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a path")
+    path = Path(root)
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        raise ValueError("root must be an existing directory") from None
+    if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
+        raise ValueError("root must be a real directory")
+    return path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Validate and extract ``(name, bytes)`` entries beneath *root*."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    # Validate the complete batch without touching the filesystem.
+    prepared = []
+    names = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        parts = _parts(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in names:
+            raise ValueError("duplicate entry name")
+        names.add(name)
+        prepared.append((name, parts, data))
+
+    # A file cannot also be a parent directory, regardless of entry order.
+    for _, parts, _ in prepared:
+        for length in range(1, len(parts)):
+            if "/".join(parts[:length]) in names:
+                raise ValueError("file/directory path collision")
+
+    base = _validate_root(root)
+
+    # Inspect every target before creating anything. lstat detects dangling
+    # links as well as links whose targets happen to be inside the root.
+    for _, parts, _ in prepared:
+        current = base
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = current.lstat().st_mode
+            except FileNotFoundError:
+                break
+            if stat.S_ISLNK(mode):
+                raise ValueError("symlink in extraction path")
+            if index == len(parts) - 1:
+                raise ValueError("target already exists")
+            if not stat.S_ISDIR(mode):
+                raise ValueError("parent path is not a directory")
+
+    for _, parts, data in prepared:
+        target = base.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_bytes(data)
+
+    return [name for name, _, _ in prepared]
diff --git a/test_safe_extract.py b/test_safe_extract.py
