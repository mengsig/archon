@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,66 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20_with_next_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_limit_bounds(self):
+        self.assertEqual(get("/items", limit="1")["status"], 200)
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(get("/items", limit="100")["status"], 200)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for bad in ["0", "101", "-1", "1.5", "abc", "", " 5", "+5", "1000"]:
+            with self.subTest(limit=bad):
+                res = get("/items", limit=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("limit", res["body"]["error"])
+
+    def test_cursor_round_trip_visits_every_item_once(self):
+        seen = []
+        cursor = None
+        for _ in range(10):
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            seen.extend(item["id"] for item in res["body"]["items"])
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertIsNone(cursor, "pagination did not finish within 10 pages")
+        self.assertEqual(seen, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        first = get("/items", limit="50")["body"]
+        self.assertIsNotNone(first["next_cursor"])
+        last = get("/items", limit="50", cursor=first["next_cursor"])["body"]
+        self.assertEqual([item["id"] for item in last["items"]], list(range(51, 58)))
+        self.assertIsNone(last["next_cursor"])
+
+    def test_exact_fit_last_page_has_null_next_cursor(self):
+        res = get("/items", limit="57")["body"]
+        self.assertEqual(len(res["items"]), 57)
+        self.assertIsNone(res["next_cursor"])
+
+    def test_invalid_cursor_is_400(self):
+        oversized = base64.urlsafe_b64encode(b"1" * 5000).decode("ascii")
+        for bad in ["", "!!!", "abc", "x", "bm90IGEgbnVtYmVy", "é", oversized,
+                    "MQ==!!", "MDE=", "MQ===", "MQ", 5]:
+            with self.subTest(cursor=bad):
+                res = get("/items", cursor=bad)
+                self.assertEqual(res["status"], 400)
+                self.assertEqual(res["body"], {"error": "invalid cursor"})
+
+    def test_non_string_query_values_are_400(self):
+        res = handle({"method": "GET", "path": "/items", "query": {"limit": 5}})
+        self.assertEqual(res["status"], 400)
+        self.assertIn("limit", res["body"]["error"])
+
+    def test_limit_accepts_leading_zeros(self):
+        self.assertEqual(len(get("/items", limit="010")["body"]["items"]), 10)
+        self.assertEqual(get("/items", limit="0000")["status"], 400)
+
 
 if __name__ == "__main__":
     unittest.main()
