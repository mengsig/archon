+class BatchShape(ExtractCase):
+    def test_rejects_subclassed_containers_and_values(self):
+        class Batch(list):
+            pass
+
+        class Entry(tuple):
+            pass
+
+        class Name(str):
+            pass
+
+        class Data(bytes):
+            pass
+
+        cases = [
+            Batch([("a", b"")]),
+            [Entry(("a", b""))],
+            [(Name("a"), b"")],
+            [("a", Data(b""))],
+        ]
+        for entries in cases:
+            with self.subTest(entries=type(entries).__name__):
+                self.assertRejectedWithoutChange(entries)
+
+    def test_rejects_non_list_batches_without_consuming_them(self):
+        generator = (entry for entry in [("a", b"")])
+        for batch in [(), (("a", b""),), iter([("a", b"")]), generator, None, "ab"]:
+            with self.subTest(batch=type(batch).__name__):
+                self.assertRejectedWithoutChange(batch)
+        self.assertEqual(next(generator), ("a", b""))
+
+    def test_rejects_malformed_entries(self):
+        for entries in [[["a", b""]], [("a",)], [("a", b"", 1)], ["a"], [None]]:
+            with self.subTest(entries=entries):
+                self.assertRejectedWithoutChange(entries)
+
+    def test_rejects_non_string_names(self):
+        for entries in [[(b"a", b"")], [(None, b"")]]:
+            with self.subTest(entries=entries):
+                self.assertRejectedWithoutChange(entries)
+
+    def test_rejects_non_bytes_data(self):
+        for data in ["text", bytearray(b"x"), None]:
+            with self.subTest(data=data):
+                self.assertRejectedWithoutChange([("a", data)])
