 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _validate_bucket_config(capacity, refill_per_sec):
+    if capacity <= 0:
+        raise ValueError("capacity must be positive")
+    if refill_per_sec <= 0:
+        raise ValueError("refill_per_sec must be positive")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_bucket_config(capacity, refill_per_sec)
+
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = capacity
+        self._last_time = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now > self._last_time:
+            elapsed = now - self._last_time
+            self._tokens = min(
+                self.capacity, self._tokens + elapsed * self.refill_per_sec
+            )
+            self._last_time = now
+
+    def _validate_request(self, n):
+        if n <= 0 or n > self.capacity:
+            raise ValueError("n must be positive and no greater than capacity")
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        if max_keys < 1:
+            raise ValueError("max_keys must be at least 1")
+        _validate_bucket_config(capacity, refill_per_sec)
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket_for(self, key):
+        try:
+            bucket = self._buckets.pop(key)
+        except KeyError:
+            bucket = TokenBucket(
+                self.capacity, self.refill_per_sec, clock=self._clock
+            )
+            if len(self._buckets) >= self.max_keys:
+                self._buckets.popitem(last=False)
+        self._buckets[key] = bucket
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        return self._bucket_for(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
diff --git a/test_ratelimit.py b/test_ratelimit.py
index 3474fcc..1f961e3 100644
--- a/test_ratelimit.py
+++ b/test_ratelimit.py
@@ -32,6 +32,74 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_and_capacity_cap(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.25
+        self.assertEqual(bucket.available(), 0.5)
+        clock.now = 10
+        self.assertEqual(bucket.available(), 2)
+
+    def test_wait_time_does_not_consume_and_tracks_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertEqual(bucket.wait_time(), 0.5)
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 0.25
+        self.assertEqual(bucket.wait_time(), 0.25)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_backwards_clock_does_not_refill_until_latest_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 2
+        self.assertEqual(bucket.available(), 2)
+        bucket.try_acquire(2)
+        clock.now = 1
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 2
+        self.assertEqual(bucket.available(), 0)
+        clock.now = 3
+        self.assertEqual(bucket.available(), 1)
+
+    def test_bucket_validation(self):
+        for capacity, rate in ((0, 1), (-1, 1), (1, 0), (1, -1)):
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate)
+        bucket = TokenBucket(2, 1)
+        for method in (bucket.try_acquire, bucket.wait_time):
+            for n in (0, -1, 3):
+                with self.subTest(method=method.__name__, n=n):
+                    with self.assertRaises(ValueError):
+                        method(n)
+
+    def test_keyed_limiter_lru_counts_wait_as_use(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        self.assertEqual(limiter.wait_time("a"), 0)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")  # b is least recently used and is evicted.
+        self.assertEqual(len(limiter), 2)
+        self.assertEqual(limiter.wait_time("b"), 0)  # evicted key starts full.
+
+    def test_keyed_limiter_validation_and_hashable_keys(self):
+        for capacity, rate, max_keys in ((0, 1, 1), (1, 0, 1), (1, 1, 0)):
+            with self.subTest(capacity=capacity, rate=rate, max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, rate, max_keys=max_keys)
+        limiter = KeyedLimiter(1, 1)
+        with self.assertRaises(TypeError):
+            limiter.try_acquire([])
+        self.assertEqual(len(limiter), 0)
+
 
 if __name__ == "__main__":
     unittest.main()
