-  return body.items;
+  const items = [];
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    assert(Array.isArray(body.items), 'GET /items body must contain an items array');
+    for (const item of body.items) items.push(item);
+    cursor = body.next_cursor;
+    assert(cursor === undefined || cursor === null || typeof cursor === 'string', 'next_cursor must be a string or null');
+  } while (cursor !== undefined && cursor !== null);
+  return items;
 }
 
