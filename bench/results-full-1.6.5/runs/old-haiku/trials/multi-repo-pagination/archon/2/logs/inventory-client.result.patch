+// Follows next_cursor until it is null or absent. The first request sends no cursor.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error(`GET /items returned a body without an items array: ${JSON.stringify(body)}`);
+    }
+    for (const item of body.items) items.push(item);
+    cursor = body.next_cursor ?? null;
+    if (cursor !== null) {
+      if (typeof cursor !== 'string') throw new Error(`GET /items returned a non-string next_cursor: ${JSON.stringify(cursor)}`);
+      if (seenCursors.has(cursor)) throw new Error(`GET /items repeated cursor ${cursor}; pagination would not end`);
+      seenCursors.add(cursor);
+    }
+  } while (cursor !== null);
+  return items;
 }
 
