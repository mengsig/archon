+test('follows cursors unchanged until the final page', async () => {
+  const calls = [];
+  const transport = async (request) => {
+    calls.push(request);
+    if (request.query.cursor === undefined) {
+      return { status: 200, body: { items: [ITEMS[0]], next_cursor: 'opaque+/=' } };
+    }
+    assert.equal(request.query.cursor, 'opaque+/=');
+    return { status: 200, body: { items: [ITEMS[1]], next_cursor: null } };
+  };
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(calls.length, 2);
+  assert.deepEqual(calls[0].query, {});
+  assert.deepEqual(calls[1].query, { cursor: 'opaque+/=' });
+});
