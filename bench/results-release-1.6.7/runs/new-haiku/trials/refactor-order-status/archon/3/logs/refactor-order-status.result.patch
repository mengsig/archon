@@ -0,0 +1,237 @@
+//! Characterization of the current order status behaviour.
+//! Status is compared via `to_string()` so these tests hold whether the
+//! field is a `String` or an enum with `Display`.
+
+use orders::{billing, report, shipping, Order};
+
+fn status(order: &Order) -> String {
+    order.status.to_string()
+}
+
+/// Builds an order and advances it to `state` using only public operations.
+fn order_in(id: u32, state: &str, total_cents: u64) -> Order {
+    let mut order = Order::new(id, "ada", total_cents);
+    match state {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("unknown test state {other}"),
+    }
+    order
+}
+
+fn counts(orders: &[Order]) -> Vec<(String, usize)> {
+    report::status_counts(orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect()
+}
+
+#[test]
+fn pay_succeeds_only_from_pending() {
+    let mut order = order_in(7, "pending", 900);
+    billing::pay(&mut order).unwrap();
+    assert_eq!(status(&order), "paid");
+
+    for state in ["paid", "shipped", "cancelled"] {
+        let mut order = order_in(7, state, 900);
+        let err = billing::pay(&mut order).unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be paid: it is {state}"));
+        assert_eq!(status(&order), state);
+    }
+}
+
+#[test]
+fn ship_succeeds_only_from_paid() {
+    let mut order = order_in(7, "paid", 900);
+    shipping::ship(&mut order).unwrap();
+    assert_eq!(status(&order), "shipped");
+
+    for state in ["pending", "shipped", "cancelled"] {
+        let mut order = order_in(7, state, 900);
+        let err = shipping::ship(&mut order).unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be shipped: it is {state}"));
+        assert_eq!(status(&order), state);
+    }
+}
+
+#[test]
+fn cancel_succeeds_from_pending_and_paid_only() {
+    for state in ["pending", "paid"] {
+        let mut order = order_in(7, state, 900);
+        order.cancel().unwrap();
+        assert_eq!(status(&order), "cancelled");
+    }
+
+    for state in ["shipped", "cancelled"] {
+        let mut order = order_in(7, state, 900);
+        let err = order.cancel().unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be cancelled: it is {state}"));
+        assert_eq!(status(&order), state);
+    }
+}
+
+#[test]
+fn is_open_is_true_only_for_pending_and_paid() {
+    assert!(order_in(1, "pending", 1).is_open());
+    assert!(order_in(1, "paid", 1).is_open());
+    assert!(!order_in(1, "shipped", 1).is_open());
+    assert!(!order_in(1, "cancelled", 1).is_open());
+}
+
+#[test]
+fn outstanding_cents_sums_only_pending_orders() {
+    let orders = [
+        order_in(1, "pending", 100),
+        order_in(2, "paid", 200),
+        order_in(3, "shipped", 400),
+        order_in(4, "cancelled", 800),
+        order_in(5, "pending", 16),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 116);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_lists_paid_ids_in_input_order() {
+    let orders = [
+        order_in(3, "paid", 1),
+        order_in(1, "pending", 1),
+        order_in(2, "paid", 1),
+        order_in(4, "shipped", 1),
+        order_in(5, "paid", 1),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [3, 2, 5]);
+    assert_eq!(shipping::ready_to_ship(&[]), Vec::<u32>::new());
+}
+
+#[test]
+fn status_counts_lists_all_four_statuses_sorted_by_name() {
+    // Alphabetical by status name, not lifecycle order.
+    let orders = [
+        order_in(1, "pending", 1),
+        order_in(2, "paid", 1),
+        order_in(3, "shipped", 1),
+        order_in(4, "cancelled", 1),
+    ];
+    assert_eq!(
+        counts(&orders),
+        [
+            ("cancelled".to_string(), 1),
+            ("paid".to_string(), 1),
+            ("pending".to_string(), 1),
+            ("shipped".to_string(), 1),
+        ]
+    );
+}
+
+#[test]
+fn status_counts_omits_absent_statuses_and_sums_duplicates() {
+    let orders = [
+        order_in(1, "pending", 1),
+        order_in(2, "pending", 1),
+        order_in(3, "shipped", 1),
+    ];
+    assert_eq!(
+        counts(&orders),
+        [("pending".to_string(), 2), ("shipped".to_string(), 1)]
+    );
+    assert_eq!(counts(&[]), Vec::<(String, usize)>::new());
+}
+
+#[test]
+fn to_line_writes_each_status_name() {
+    for state in ["pending", "paid", "shipped", "cancelled"] {
+        let line = report::to_line(&order_in(5, state, 250));
+        assert_eq!(line, format!("5,ada,250,{state}"));
+    }
+}
+
+#[test]
+fn from_line_round_trips_every_status() {
+    for state in ["pending", "paid", "shipped", "cancelled"] {
+        let line = format!("9,bob,40,{state}");
+        let order = report::from_line(&line).unwrap();
+        assert_eq!(status(&order), state);
+        assert_eq!(report::to_line(&order), line);
+    }
+}
+
+#[test]
+fn from_line_trims_surrounding_whitespace() {
+    let order = report::from_line("  5,eve,300,shipped \n").unwrap();
+    assert_eq!(order.id, 5);
+    assert_eq!(order.customer, "eve");
+    assert_eq!(order.total_cents, 300);
+    assert_eq!(status(&order), "shipped");
+}
+
+#[test]
+fn from_line_accepts_an_empty_customer() {
+    let order = report::from_line("1,,100,paid").unwrap();
+    assert_eq!(order.customer, "");
+    assert_eq!(status(&order), "paid");
+}
+
+#[test]
+fn from_line_rejects_wrong_field_counts() {
+    assert_eq!(
+        report::from_line("").unwrap_err(),
+        "expected 4 fields, got 1"
+    );
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("1,a,da,100,paid").unwrap_err(),
+        "expected 4 fields, got 5"
+    );
+}
+
+#[test]
+fn from_line_checks_id_then_total_then_status() {
+    assert_eq!(
+        report::from_line("x,ada,100,lost").unwrap_err(),
+        r#"bad id "x": invalid digit found in string"#
+    );
+    assert_eq!(
+        report::from_line("1,ada,abc,lost").unwrap_err(),
+        r#"bad total "abc": invalid digit found in string"#
+    );
+    assert_eq!(
+        report::from_line("4294967296,ada,1,paid").unwrap_err(),
+        r#"bad id "4294967296": number too large to fit in target type"#
+    );
+}
+
+#[test]
+fn from_line_rejects_unknown_status_names_case_sensitively() {
+    assert_eq!(
+        report::from_line("4,dee,1,lost").unwrap_err(),
+        r#"unknown status "lost""#
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,Paid").unwrap_err(),
+        r#"unknown status "Paid""#
+    );
+    assert_eq!(
+        report::from_line("1,ada,100,").unwrap_err(),
+        r#"unknown status """#
+    );
+}
+
+#[test]
+fn operation_errors_are_plain_strings() {
+    let mut order = order_in(1, "shipped", 1);
+    let pay_err: String = billing::pay(&mut order).unwrap_err();
+    let cancel_err: String = order.cancel().unwrap_err();
+    let parse_err: String = report::from_line("1,ada,1,lost").unwrap_err();
+    assert_eq!(pay_err, "order 1 cannot be paid: it is shipped");
+    assert_eq!(cancel_err, "order 1 cannot be cancelled: it is shipped");
+    assert_eq!(parse_err, r#"unknown status "lost""#);
+}
