diff --git a/tests/test_tt101_dates.py b/tests/test_tt101_dates.py
new file mode 100644
index 0000000..585dd2d
--- /dev/null
+++ b/tests/test_tt101_dates.py
@@ -0,0 +1,66 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ImpossibleDateTest(unittest.TestCase):
+    def test_impossible_calendar_dates_raise(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text), self.assertRaises(InvalidDate) as ctx:
+                parse_due(text, TODAY)
+            self.assertIn(text, str(ctx.exception))
+
+    def test_invalid_date_is_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+    def test_real_boundary_dates_still_parse(self):
+        self.assertEqual(parse_due("2026-02-28", TODAY), date(2026, 2, 28))
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+        self.assertEqual(parse_due("2026-12-31", TODAY), date(2026, 12, 31))
+
+
+class UnrecognisedTest(unittest.TestCase):
+    def test_unsupported_forms_raise_invalid_date(self):
+        for text in ["", "March 3", "2026/03/10", "2026-3-1", "10-03-2026", "soon"]:
+            with self.subTest(text=text), self.assertRaises(InvalidDate) as ctx:
+                parse_due(text, TODAY)
+            self.assertIn(text, str(ctx.exception))
+
+    def test_negative_or_unsigned_offsets_raise(self):
+        for text in ["-3d", "3d", "+3", "+3w"]:
+            with self.subTest(text=text), self.assertRaises(InvalidDate):
+                parse_due(text, TODAY)
+
+    def test_offset_beyond_date_range_raises(self):
+        with self.assertRaises(InvalidDate) as ctx:
+            parse_due("+99999999999d", TODAY)
+        self.assertIn("+99999999999d", str(ctx.exception))
+
+
+class RelativeOffsetTest(unittest.TestCase):
+    def test_zero_offset_is_today(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+
+    def test_offset_adds_days(self):
+        self.assertEqual(parse_due("+5d", TODAY), date(2026, 3, 15))
+
+    def test_offset_crosses_year_end(self):
+        self.assertEqual(parse_due("+400d", TODAY), date(2027, 4, 14))
+
+
+class KeywordTest(unittest.TestCase):
+    def test_today_and_tomorrow(self):
+        self.assertEqual(parse_due("today", TODAY), TODAY)
+        self.assertEqual(parse_due("tomorrow", TODAY), date(2026, 3, 11))
+
+    def test_case_and_whitespace_are_ignored(self):
+        self.assertEqual(parse_due("  TODAY  ", TODAY), TODAY)
+        self.assertEqual(parse_due(" Tomorrow ", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("+5D", TODAY), date(2026, 3, 15))
+
+
+if __name__ == "__main__":
+    unittest.main()
