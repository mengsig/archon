diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..25d99c0 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,40 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without huge powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # base_ms >= 1 and cap_ms < 2**cap_ms.bit_length(), so larger exponents exceed cap.
+    if base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << exponent)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..06c07d5 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,107 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.5)
+
+    def test_rejects_below_minimum(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validation_precedes_early_none_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1000, 5000, budget_ms=-1)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_greater_than_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=3))
+
+    def test_last_allowed_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_cap_limits_backoff(self):
+        self.assertEqual(retry_delay(5, 0, max_attempts=10), 400)
+
+    def test_base_above_cap_yields_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=200), 200)
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_retry_after_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=50, retry_after_ms=300), 300)
+
+    def test_retry_after_zero_with_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=0), 0)
+
+
+class RetryBudget(unittest.TestCase):
+    def test_exact_budget_boundary_is_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_below_budget_boundary_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_delay_is_not_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100, retry_after_ms=150))
+
+    def test_zero_delay_within_budget_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_budget_always_none(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+
+class RetryLargeValues(unittest.TestCase):
+    def test_huge_attempt_saturates_without_big_intermediate(self):
+        self.assertEqual(retry_delay(10**18, 0, max_attempts=10**19), 400)
+
+    def test_huge_base_and_cap_are_unbounded(self):
+        big = 10**30
+        self.assertEqual(retry_delay(1, 0, base_ms=big, cap_ms=big + 1, budget_ms=big + 1), big)
+        self.assertEqual(retry_delay(1, 0, budget_ms=big + 1, base_ms=big, cap_ms=big), big)
+
+    def test_exponent_at_cap_bit_length_boundary(self):
+        cap = 1000  # bit_length 10
+        kwargs = {"base_ms": 1, "cap_ms": cap, "max_attempts": 99, "budget_ms": 10**6}
+        self.assertEqual(retry_delay(10, 0, **kwargs), 2**9)
+        self.assertEqual(retry_delay(11, 0, **kwargs), cap)
+
+
+if __name__ == "__main__":
+    unittest.main()
