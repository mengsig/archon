+}
+
+#[test]
+fn malformed_currency_is_bad_currency() {
+    for line in [
+        "2026-03-01\tcafe\t1\teur",
+        "2026-03-01\tcafe\t1\tEURO",
+        "2026-03-01\tcafe\t1\tEU",
+        "2026-03-01\tcafe\t1\tU5D",
+        "2026-03-01\tcafe\t1\t",
+    ] {
+        let err = parse_line(line).unwrap_err();
+        assert!(
+            matches!(err, LineError::BadCurrency(_)),
+            "{line:?} gave {err:?}"
+        );
+        assert_eq!(err.exit_code(), 2);
+    }
+}
+
+#[test]
+fn structural_errors_keep_exit_1() {
+    let too_many = parse_line("2026-03-01\tcafe\t1\tUSD\textra").unwrap_err();
+    assert!(matches!(too_many, LineError::Malformed(_)));
+    assert_eq!(too_many.exit_code(), 1);
+    let bad_amount = parse_line("2026-03-01\tcafe\tx\tUSD").unwrap_err();
+    assert_eq!(bad_amount.exit_code(), 1);
+}
