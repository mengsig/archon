@@ -18,3 +18,89 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractValidation(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(dir=".")
+        self.root = Path(self.tmp.name) / "root"
+        self.root.mkdir()
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def assert_rejected_without_changes(self, entries):
+        before = sorted(str(path.relative_to(self.root)) for path in self.root.rglob("*"))
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        after = sorted(str(path.relative_to(self.root)) for path in self.root.rglob("*"))
+        self.assertEqual(after, before)
+
+    def test_only_lists_are_accepted_and_generators_are_not_consumed(self):
+        consumed = []
+
+        def entries():
+            consumed.append(True)
+            yield "x", b"x"
+
+        for batch in ((), iter(()), entries()):
+            with self.assertRaises(ValueError):
+                extract(batch, self.root)
+        self.assertEqual(consumed, [])
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_malformed_entries_and_names(self):
+        invalid = [
+            ["x"], [(1, b"x")], [("x", bytearray(b"x"))],
+            [("", b"")], [("/x", b"")], [("a//b", b"")],
+            [("a/./b", b"")], [("a/../b", b"")], [("a\\b", b"")],
+            [("C:x", b"")], [("a\0b", b"")],
+        ]
+        for batch in invalid:
+            with self.subTest(batch=batch):
+                self.assert_rejected_without_changes(batch)
+
+    def test_duplicates_and_collisions_in_both_orders(self):
+        for batch in (
+            [("a", b"1"), ("a", b"2")],
+            [("a", b"1"), ("a/b", b"2")],
+            [("a/b", b"2"), ("a", b"1")],
+        ):
+            with self.subTest(batch=batch):
+                self.assert_rejected_without_changes(batch)
+
+    def test_existing_target_and_non_directory_parent(self):
+        (self.root / "present").write_bytes(b"old")
+        (self.root / "file-parent").write_bytes(b"old")
+        self.assert_rejected_without_changes([("new/ok", b"new"), ("present", b"x")])
+        self.assert_rejected_without_changes([("file-parent/child", b"x")])
+        self.assertEqual((self.root / "present").read_bytes(), b"old")
+
+    def test_symlinks_in_parent_and_target_are_rejected(self):
+        outside = Path(self.tmp.name) / "outside"
+        outside.mkdir()
+        (outside / "keep").write_bytes(b"safe")
+        (self.root / "parent-link").symlink_to(outside, target_is_directory=True)
+        (self.root / "dangling").symlink_to(outside / "missing")
+        self.assert_rejected_without_changes([("new/file", b"x"), ("parent-link/keep", b"x")])
+        self.assert_rejected_without_changes([("dangling", b"x")])
+        self.assertEqual((outside / "keep").read_bytes(), b"safe")
+
+    def test_root_must_be_existing_real_directory(self):
+        missing = Path(self.tmp.name) / "missing"
+        file_root = Path(self.tmp.name) / "file"
+        file_root.write_bytes(b"x")
+        linked_root = Path(self.tmp.name) / "linked"
+        linked_root.symlink_to(self.root, target_is_directory=True)
+        for invalid_root in (missing, file_root, linked_root, object()):
+            with self.subTest(root=invalid_root):
+                with self.assertRaises(ValueError):
+                    extract([], invalid_root)
+
+    def test_percent_names_are_literal_and_existing_directories_are_allowed(self):
+        (self.root / "existing-dir").mkdir()
+        self.assertEqual(
+            extract([("existing-dir/100%25", b"data")], self.root),
+            ["existing-dir/100%25"],
+        )
+        self.assertEqual((self.root / "existing-dir/100%25").read_bytes(), b"data")
