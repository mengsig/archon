+    def undo(self):
+        if not self._undo:
+            raise NothingToUndo("nothing to undo")
+        operation = self._undo.pop()
+        if operation[0] == "add":
+            del self._tasks[operation[1].id]
+        elif operation[0] == "complete":
+            _, task, previous_status = operation
+            task.status = previous_status if previous_status in (OPEN, DONE) else OPEN
+        else:  # delete
