 """Extract validated regular-file entries. See SPEC.md."""
 
+import errno
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _check_batch_type(entries)
+    root_path = _check_root(root)
+    batch = _normalize_batch(entries)
+    _check_no_collisions([name for name, _ in batch])
+    for name, _ in batch:
+        _check_target_absent(root_path, name)
+    for name, data in batch:
+        _write_file(root_path, name, data)
+    return [name for name, _ in batch]
+
+
+def _check_batch_type(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _check_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, not {type(root).__name__}")
+    if isinstance(root, str) and not root:
+        raise ValueError("root must not be an empty string")
+    root_path = Path(root)
+    info = _lstat_or_none(root_path)
+    if info is None:
+        raise ValueError(f"root does not exist: {root_path}")
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be a directory: {root_path}")
+    return root_path
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
+    except OSError as error:
+        if error.errno == errno.ENAMETOOLONG:
+            raise ValueError(f"path component is too long: {path}") from error
+        raise
+
+
+def _normalize_batch(entries):
+    # Each entry is read exactly once into a fresh exact tuple, so later
+    # stages can never see different contents than were validated.
+    return [_normalize_entry(entry) for entry in list(entries)]
+
+
+def _normalize_entry(entry):
+    if type(entry) is not tuple or len(entry) != 2:
+        raise ValueError("each entry must be an exact (name, data) tuple")
+    name, data = entry
+    _check_name(name)
+    if type(data) is not bytes:
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return (name, data)
+
+
+def _check_name(name):
+    if type(name) is not str:
+        raise ValueError(f"entry name must be a str, not {type(name).__name__}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    if any(part in ("", ".", "..") for part in name.split("/")):
+        raise ValueError(f"entry name must be a relative path without empty, '.' or '..': {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"entry name is not valid text: {name!r}") from error
+
+
+def _check_no_collisions(names):
+    name_set = set(names)
+    if len(name_set) != len(names):
+        raise ValueError("duplicate entry names in batch")
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in name_set:
+                raise ValueError(f"entry {ancestor!r} collides with {name!r}")
+
+
+def _check_target_absent(root_path, name):
+    current = root_path
+    parts = name.split("/")
+    for index, part in enumerate(parts):
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists: {name!r}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor of {name!r} is not a plain directory: {part!r}")
+
+
+def _write_file(root_path, name, data):
+    path = root_path.joinpath(*name.split("/"))
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "xb") as handle:
+        handle.write(data)
