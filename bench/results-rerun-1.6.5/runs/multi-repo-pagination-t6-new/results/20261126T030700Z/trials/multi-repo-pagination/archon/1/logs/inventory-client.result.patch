+// Follows next_cursor until it is null or absent, so the first request sends no cursor.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!body || !Array.isArray(body.items)) {
+      throw new Error(`GET /items returned a body without an items array: ${JSON.stringify(body)}`);
+    }
+    items.push(...body.items);
+    cursor = body.next_cursor ?? undefined;
+    if (cursor !== undefined && seenCursors.has(cursor)) {
+      throw new Error(`GET /items returned a repeated next_cursor: ${JSON.stringify(cursor)}`);
+    }
+    seenCursors.add(cursor);
+  } while (cursor !== undefined);
+  return items;
 }
 
