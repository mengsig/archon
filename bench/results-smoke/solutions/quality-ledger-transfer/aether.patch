+class LedgerConcurrency(unittest.TestCase):
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        # 2000 each: each side sends at most 2000 units, so no transfer can fail.
+        ledger = Ledger({"a": 2000, "b": 2000})
+        start = threading.Barrier(8)
+        results = []
+        results_lock = threading.Lock()
+
+        def worker(src, dst):
+            start.wait()
+            outcomes = [ledger.transfer(src, dst, 1) for _ in range(500)]
+            with results_lock:
+                results.extend(outcomes)
+
+        threads = [
+            threading.Thread(target=worker, args=(src, dst))
+            for src, dst in [("a", "b"), ("b", "a")] * 4
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=30)
+            self.assertFalse(thread.is_alive(), "transfer threads deadlocked")
+
+        self.assertEqual(len(results), 4000)
+        self.assertTrue(all(results))
+        self.assertEqual(ledger.snapshot(), {"a": 2000, "b": 2000})
+
+
+if __name__ == "__main__":
+    unittest.main()
