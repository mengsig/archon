diff --git a/test/client.test.js b/test/client.test.js
index db0605e..3dd147e 100644
--- a/test/client.test.js
+++ b/test/client.test.js
@@ -16,6 +16,67 @@ async function singlePage(request) {
   return { status: 404, body: { error: 'not found' } };
 }
 
+function paginated(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    const page = pages[request.query.cursor ?? 'first'];
+    if (!page) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, seen };
+}
+
+test('lists a single page with null next_cursor', async () => {
+  const { transport, seen } = paginated({
+    first: { items: ITEMS, next_cursor: null },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('lists a single page with no next_cursor field', async () => {
+  const { transport, seen } = paginated({ first: { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('follows next_cursor across pages, in order', async () => {
+  const pages = {
+    first: { items: [ITEMS[0]], next_cursor: 'c1' },
+    c1: { items: [ITEMS[1]], next_cursor: 'c2' },
+    c2: { items: [{ id: 3, sku: 'SKU-0003', qty: 7 }], next_cursor: null },
+  };
+  const { transport, seen } = paginated(pages);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seen, [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('fails when a page is rejected', async () => {
+  const { transport } = paginated({
+    first: { items: [ITEMS[0]], next_cursor: 'bad' },
+  });
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('fails when next_cursor repeats instead of looping forever', async () => {
+  const { transport } = paginated({
+    first: { items: [ITEMS[0]], next_cursor: 'c1' },
+    c1: { items: [ITEMS[1]], next_cursor: 'c1' },
+  });
+  await assert.rejects(listItems(transport), /already followed/);
+});
+
+test('fails when pages form a cycle across several cursors', async () => {
+  const { transport } = paginated({
+    first: { items: [ITEMS[0]], next_cursor: 'c1' },
+    c1: { items: [ITEMS[1]], next_cursor: 'c2' },
+    c2: { items: [ITEMS[0]], next_cursor: 'c1' },
+  });
+  await assert.rejects(listItems(transport), /already followed: c1/);
+});
+
 test('lists items', async () => {
