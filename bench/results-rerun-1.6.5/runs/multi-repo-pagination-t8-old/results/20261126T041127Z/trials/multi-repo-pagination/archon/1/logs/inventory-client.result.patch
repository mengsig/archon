   return { status: 404, body: { error: 'not found' } };
 }
 
+// Serves `pages` keyed by cursor; the first request carries no cursor.
+function paginated(pages) {
+  const seenQueries = [];
+  const transport = async (request) => {
+    seenQueries.push(request.query);
+    const page = pages[request.query.cursor ?? ''];
+    if (!page) return { status: 400, body: { error: 'bad cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, seenQueries };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages, passing each cursor back unchanged', async () => {
+  const { transport, seenQueries } = paginated({
+    '': { items: [ITEMS[0]], next_cursor: 'opaque/a+b=' },
+    'opaque/a+b=': { items: [ITEMS[1]], next_cursor: 'c2' },
+    c2: { items: [{ id: 3, sku: 'SKU-0003', qty: 0 }], next_cursor: null },
+  });
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seenQueries, [{}, { cursor: 'opaque/a+b=' }, { cursor: 'c2' }]);
+});
+
+test('a single page with null next_cursor makes one request', async () => {
+  const { transport, seenQueries } = paginated({
+    '': { items: ITEMS, next_cursor: null },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seenQueries, [{}]);
+});
+
+test('a missing next_cursor field ends the listing after one page', async () => {
+  const { transport, seenQueries } = paginated({ '': { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seenQueries.length, 1);
+});
+
+test('fails visibly when a later page errors', async () => {
+  const { transport } = paginated({
+    '': { items: [ITEMS[0]], next_cursor: 'bogus' },
+  });
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('fails visibly on a repeated cursor instead of looping forever', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /repeated cursor/);
+});
+
+test('fails visibly on a malformed page', async () => {
+  const transport = async () => ({ status: 200, body: { items: 'nope' } });
+  await assert.rejects(listItems(transport), /items array/);
+});
+
+test('fails visibly on a non-string next_cursor', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 7 } });
+  await assert.rejects(listItems(transport), /non-string next_cursor/);
+});
+
