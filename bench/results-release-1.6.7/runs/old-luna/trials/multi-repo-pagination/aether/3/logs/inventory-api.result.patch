 """
 
+import base64
+import binascii
+
 from data import ITEMS
 
 
@@ -22,7 +25,39 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", 20)
+    try:
+        if isinstance(raw_limit, bool):
+            raise ValueError
+        limit = int(raw_limit)
+        if str(limit) != str(raw_limit) or not 1 <= limit <= 100:
+            raise ValueError
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    if cursor is None:
+        start = 0
+    else:
+        if not isinstance(cursor, str) or not cursor:
+            return _error(400, "invalid cursor")
+        try:
+            padded = cursor + "=" * (-len(cursor) % 4)
+            decoded = base64.b64decode(padded, altchars=b"-_", validate=True).decode("ascii")
+            last_id = int(decoded)
+            if str(last_id) != decoded or _encode_cursor(last_id) != cursor:
+                raise ValueError
+            start = next(index + 1 for index, item in enumerate(items) if item["id"] == last_id)
+        except (ValueError, UnicodeDecodeError, binascii.Error, StopIteration):
+            return _error(400, "invalid cursor")
+
+    page = items[start : start + limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if start + len(page) < len(items) else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii").rstrip("=")
 
 
