diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..a424d4d 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,42 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the delay before another attempt, or ``None`` if it cannot start.
+
+    Arguments are integer milliseconds, except that ``retry_after_ms`` may be
+    ``None``. Validation is deliberately performed before checking either
+    retry limit so invalid input is never hidden by an exhausted budget.
+    """
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an int >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an int >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    # Compute min(cap_ms, base_ms * 2**(attempt - 1)) without creating a
+    # potentially enormous power for large attempt values.
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    elif base_ms >= cap_ms or attempt - 1 >= cap_ms.bit_length():
+        delay = cap_ms
+    else:
+        delay = min(cap_ms, base_ms << (attempt - 1))
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..0e99354 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,53 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validation_rejects_non_builtin_integers_and_negative_values(self):
+        invalid = (
+            ((True, 0), {}),
+            ((1, 0.0), {}),
+            ((0, 0), {}),
+            ((1, -1), {}),
+            ((1, 0), {"max_attempts": True}),
+            ((1, 0), {"max_attempts": 0}),
+            ((1, 0), {"budget_ms": -1}),
+            ((1, 0), {"base_ms": -1}),
+            ((1, 0), {"cap_ms": -1}),
+            ((1, 0), {"retry_after_ms": False}),
+            ((1, 0), {"retry_after_ms": -1}),
+        )
+        for args, kwargs in invalid:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_validation_precedes_exhausted_attempt_return(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, retry_after_ms=1.5)
+        with self.assertRaises(ValueError):
+            retry_delay(4, -1)
+
+    def test_next_attempt_must_start_strictly_before_budget(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100))
+        self.assertEqual(retry_delay(1, 0, budget_ms=101), 100)
+
+    def test_zero_values_and_cap_below_base(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=100, cap_ms=5), 5)
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=7), 7)
+
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=10, retry_after_ms=50), 50)
+        self.assertIsNone(
+            retry_delay(1, 50, budget_ms=100, cap_ms=10,
+                        retry_after_ms=50))
+
+    def test_large_attempt_saturates_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
+        self.assertIsNone(retry_delay(10**100, 0, max_attempts=4))
