+import base64
+import binascii
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MAX_CURSOR_DIGITS = 18
+
+
+class BadRequest(Exception):
+    """Invalid client input; the message is returned to the caller as the error."""
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +32,51 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after = _parse_cursor(query.get("cursor"))
+    except BadRequest as exc:
+        return _error(400, str(exc))
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after is None or item["id"] > after
+    ]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    assert all(a["id"] < b["id"] for a, b in zip(page, page[1:]))
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_digits(raw, max_len=len(str(MAX_LIMIT))) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    """Return the id the page starts after, or None for the first page."""
+    if raw is None:
+        return None
+    try:
+        decoded = base64.b64decode(raw.encode("ascii"), altchars=b"-_", validate=True)
+        text = decoded.decode("ascii")
+    except (UnicodeError, binascii.Error) as exc:
+        raise BadRequest("cursor is invalid") from exc
+    if not _is_digits(text, max_len=MAX_CURSOR_DIGITS):
+        raise BadRequest("cursor is invalid")
+    return int(text)
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _is_digits(text, max_len):
+    return text.isascii() and text.isdigit() and len(text) <= max_len
 
 
