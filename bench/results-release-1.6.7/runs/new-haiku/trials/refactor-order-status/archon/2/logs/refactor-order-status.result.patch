@@ -0,0 +1,299 @@
+//! Pins the current observable behaviour of order statuses, transitions,
+//! parsing and reports. Uses the public API only.
+
+use orders::{billing, report, shipping, Order};
+
+fn status_of(order: &Order) -> String {
+    order.status.to_string()
+}
+
+fn order_with(id: u32, status: &str) -> Order {
+    let mut order = Order::new(id, "eve", 900);
+    match status {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("no fixture for status {other:?}"),
+    }
+    assert_eq!(status_of(&order), status);
+    order
+}
+
+fn order_at(status: &str) -> Order {
+    order_with(7, status)
+}
+
+fn assert_moved(result: Result<(), String>, order: &Order, next: &str) {
+    assert_eq!(result, Ok(()));
+    assert_eq!(status_of(order), next);
+}
+
+fn assert_refused(result: Result<(), String>, order: &Order, before: &str, message: &str) {
+    assert_eq!(result, Err(message.to_string()));
+    assert_eq!(
+        status_of(order),
+        before,
+        "a refused step must not change the status"
+    );
+}
+
+fn counts_as_text(orders: &[Order]) -> Vec<(String, usize)> {
+    report::status_counts(orders)
+        .into_iter()
+        .map(|(status, n)| (status.to_string(), n))
+        .collect()
+}
+
+#[test]
+fn new_orders_start_pending_with_the_given_fields() {
+    let order = Order::new(9, "fay", 1500);
+    assert_eq!(
+        (order.id, order.customer.as_str(), order.total_cents),
+        (9, "fay", 1500)
+    );
+    assert_eq!(status_of(&order), "pending");
+}
+
+#[test]
+fn pay_succeeds_only_from_pending() {
+    let mut order = order_at("pending");
+    assert_moved(billing::pay(&mut order), &order, "paid");
+
+    for (start, message) in [
+        ("paid", "order 7 cannot be paid: it is paid"),
+        ("shipped", "order 7 cannot be paid: it is shipped"),
+        ("cancelled", "order 7 cannot be paid: it is cancelled"),
+    ] {
+        let mut order = order_at(start);
+        assert_refused(billing::pay(&mut order), &order, start, message);
+    }
+}
+
+#[test]
+fn ship_succeeds_only_from_paid() {
+    let mut order = order_at("paid");
+    assert_moved(shipping::ship(&mut order), &order, "shipped");
+
+    for (start, message) in [
+        ("pending", "order 7 cannot be shipped: it is pending"),
+        ("shipped", "order 7 cannot be shipped: it is shipped"),
+        ("cancelled", "order 7 cannot be shipped: it is cancelled"),
+    ] {
+        let mut order = order_at(start);
+        assert_refused(shipping::ship(&mut order), &order, start, message);
+    }
+}
+
+#[test]
+fn cancel_succeeds_from_pending_and_paid_only() {
+    for start in ["pending", "paid"] {
+        let mut order = order_at(start);
+        assert_moved(order.cancel(), &order, "cancelled");
+    }
+
+    for (start, message) in [
+        ("shipped", "order 7 cannot be cancelled: it is shipped"),
+        ("cancelled", "order 7 cannot be cancelled: it is cancelled"),
+    ] {
+        let mut order = order_at(start);
+        assert_refused(order.cancel(), &order, start, message);
+    }
+}
+
+#[test]
+fn only_pending_and_paid_orders_are_open() {
+    let expected = [
+        ("pending", true),
+        ("paid", true),
+        ("shipped", false),
+        ("cancelled", false),
+    ];
+    for (status, open) in expected {
+        assert_eq!(order_at(status).is_open(), open, "status {status}");
+    }
+}
+
+#[test]
+fn status_counts_are_sorted_by_name_across_all_statuses() {
+    let orders = vec![
+        order_at("shipped"),
+        order_at("pending"),
+        order_at("cancelled"),
+        order_at("paid"),
+        order_at("paid"),
+    ];
+    assert_eq!(
+        counts_as_text(&orders),
+        [
+            ("cancelled".into(), 1),
+            ("paid".into(), 2),
+            ("pending".into(), 1),
+            ("shipped".into(), 1),
+        ]
+    );
+}
+
+#[test]
+fn status_counts_of_no_orders_is_empty() {
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn ready_to_ship_lists_paid_ids_in_input_order() {
+    let orders = vec![
+        order_with(3, "paid"),
+        order_with(1, "pending"),
+        order_with(2, "paid"),
+        order_with(4, "shipped"),
+        order_with(5, "cancelled"),
+        order_with(6, "paid"),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [3, 2, 6]);
+}
+
+#[test]
+fn outstanding_counts_only_pending_totals() {
+    let mut paid = Order::new(2, "bob", 250);
+    billing::pay(&mut paid).unwrap();
+    let mut cancelled = Order::new(3, "cy", 400);
+    cancelled.cancel().unwrap();
+    let orders = vec![
+        Order::new(1, "ada", 100),
+        paid,
+        cancelled,
+        Order::new(4, "dee", 50),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 150);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn to_line_writes_each_status_by_name() {
+    for status in ["pending", "paid", "shipped", "cancelled"] {
+        let line = report::to_line(&order_at(status));
+        assert_eq!(line, format!("7,eve,900,{status}"));
+    }
+}
+
+#[test]
+fn from_line_round_trips_every_status() {
+    for status in ["pending", "paid", "shipped", "cancelled"] {
+        let order = order_at(status);
+        let line = report::to_line(&order);
+        assert_eq!(report::from_line(&line), Ok(order));
+    }
+}
+
+#[test]
+fn from_line_trims_the_whole_line_only() {
+    assert_eq!(
+        report::from_line("  7,eve,900,paid\r\n"),
+        Ok(order_at("paid"))
+    );
+}
+
+#[test]
+fn from_line_keeps_customer_text_as_given() {
+    let order = report::from_line("7,Ada Lovelace,900,paid").unwrap();
+    assert_eq!(order.customer, "Ada Lovelace");
+    let blank = report::from_line("7,,900,pending").unwrap();
+    assert_eq!(blank.customer, "");
+}
+
+#[test]
+fn from_line_rejects_status_text_that_is_not_exactly_a_name() {
+    for (status_field, message) in [
+        ("lost", r#"unknown status "lost""#),
+        ("Paid", r#"unknown status "Paid""#),
+        ("PENDING", r#"unknown status "PENDING""#),
+        (" paid", r#"unknown status " paid""#),
+        ("", r#"unknown status """#),
+    ] {
+        let line = format!("7,eve,900,{status_field}");
+        assert_eq!(
+            report::from_line(&line),
+            Err(message.to_string()),
+            "line {line:?}"
+        );
+    }
+}
+
+#[test]
+fn from_line_checks_field_count_before_any_value() {
+    for (line, count) in [
+        ("", 1),
+        ("7,eve,900", 3),
+        ("x,eve,y", 3),
+        ("7,eve,900,paid,", 5),
+        ("7,eve,900,lost,extra", 5),
+    ] {
+        assert_eq!(
+            report::from_line(line),
+            Err(format!("expected 4 fields, got {count}")),
+            "line {line:?}"
+        );
+    }
+}
+
+#[test]
+fn from_line_checks_id_then_total_then_status() {
+    let bad_id = r#"bad id "x": invalid digit found in string"#;
+    let bad_total = r#"bad total "x": invalid digit found in string"#;
+    assert_eq!(report::from_line("x,eve,900,lost"), Err(bad_id.to_string()));
+    assert_eq!(report::from_line("x,eve,x,paid"), Err(bad_id.to_string()));
+    assert_eq!(
+        report::from_line("7,eve,x,lost"),
+        Err(bad_total.to_string())
+    );
+    assert_eq!(
+        report::from_line("7,eve,900,lost"),
+        Err(r#"unknown status "lost""#.to_string())
+    );
+}
+
+#[test]
+fn from_line_numeric_field_errors_are_exact() {
+    let cases = [
+        (
+            "-1,eve,900,paid",
+            r#"bad id "-1": invalid digit found in string"#,
+        ),
+        (
+            ",eve,900,paid",
+            r#"bad id "": cannot parse integer from empty string"#,
+        ),
+        (
+            "4294967296,eve,900,paid",
+            r#"bad id "4294967296": number too large to fit in target type"#,
+        ),
+        (
+            "7,eve,,paid",
+            r#"bad total "": cannot parse integer from empty string"#,
+        ),
+        (
+            "7,eve,-5,paid",
+            r#"bad total "-5": invalid digit found in string"#,
+        ),
+        (
+            "7,eve,18446744073709551616,paid",
+            r#"bad total "18446744073709551616": number too large to fit in target type"#,
+        ),
+    ];
+    for (line, message) in cases {
+        assert_eq!(
+            report::from_line(line),
+            Err(message.to_string()),
+            "line {line:?}"
+        );
+    }
+}
+
+#[test]
+fn from_line_accepts_a_leading_plus_on_numbers() {
+    let order = report::from_line("+7,eve,+900,paid").unwrap();
+    assert_eq!((order.id, order.total_cents), (7, 900));
+}
