diff --git a/tests/test_tt101_dates.py b/tests/test_tt101_dates.py
new file mode 100644
index 0000000..d233d83
--- /dev/null
+++ b/tests/test_tt101_dates.py
@@ -0,0 +1,41 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+
+TODAY = date(2026, 3, 10)
+
+
+class DueDateValidationTest(unittest.TestCase):
+    def test_rejects_impossible_calendar_dates_with_original_text(self):
+        for text in (
+            "2026-02-30",
+            "2025-02-29",
+            "2026-04-31",
+            "2026-13-01",
+            "2026-00-10",
+        ):
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as raised:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(raised.exception))
+
+    def test_unsupported_forms_raise_invalid_date_with_original_text(self):
+        for text in ("nonsense", "3d", "-3d"):
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as raised:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(raised.exception))
+
+    def test_relative_offsets_are_nonnegative_days_after_today(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+5d", TODAY), date(2026, 3, 15))
+
+    def test_keywords_are_case_insensitive_and_trimmed(self):
+        self.assertEqual(parse_due(" ToDaY ", TODAY), TODAY)
+        self.assertEqual(parse_due(" TOMORROW ", TODAY), date(2026, 3, 11))
+
+
+if __name__ == "__main__":
+    unittest.main()
