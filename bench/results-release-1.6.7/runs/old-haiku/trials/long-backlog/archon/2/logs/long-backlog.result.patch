+++ b/tests/test_tt103_search.py
@@ -0,0 +1,122 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _sample_store():
+    store = TaskStore()
+    store.add("Fix login page", tags=["Work", "bug"])
+    store.add("write report", tags=["work"])
+    store.add("buy milk", tags=["home"])
+    store.add("fix login timeout")
+    store.complete(store.all()[1].id)
+    return store
+
+
+def _titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = _sample_store().all()
+
+    def test_blank_and_empty_query_match_everything_in_order(self):
+        for query in ("", "   ", "\t"):
+            with self.subTest(query=query):
+                self.assertEqual(search(self.tasks, query), self.tasks)
+
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(
+            _titles(search(self.tasks, "LOGIN")),
+            ["Fix login page", "fix login timeout"],
+        )
+
+    def test_terms_are_anded(self):
+        self.assertEqual(
+            _titles(search(self.tasks, "fix page")),
+            ["Fix login page"],
+        )
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(
+            _titles(search(self.tasks, '"fix login"')),
+            ["Fix login page", "fix login timeout"],
+        )
+        self.assertEqual(search(self.tasks, '"login fix"'), [])
+
+    def test_phrase_and_word_combine(self):
+        self.assertEqual(
+            _titles(search(self.tasks, '"fix login" page')),
+            ["Fix login page"],
+        )
+
+    def test_quoted_text_containing_colon_is_a_phrase(self):
+        self.assertEqual(search(self.tasks, '"tag:work"'), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(
+            _titles(search(self.tasks, "tag:WORK")),
+            ["Fix login page", "write report"],
+        )
+
+    def test_tag_does_not_match_substring_or_title(self):
+        self.assertEqual(search(self.tasks, "tag:wor"), [])
+        self.assertEqual(search(self.tasks, "tag:login"), [])
+
+    def test_tag_value_may_be_quoted(self):
+        store = TaskStore()
+        store.add("errand", tags=["to do"])
+        self.assertEqual(_titles(search(store.all(), 'tag:"to do"')), ["errand"])
+
+    def test_status_open_and_done(self):
+        self.assertEqual(
+            _titles(search(self.tasks, "status:open")),
+            ["Fix login page", "buy milk", "fix login timeout"],
+        )
+        self.assertEqual(_titles(search(self.tasks, "status:done")), ["write report"])
+
+    def test_status_value_is_case_insensitive(self):
+        self.assertEqual(search(self.tasks, "status:DONE"), search(self.tasks, "status:done"))
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_empty_field_value_raises(self):
+        for query in ("tag:", 'tag:""', "status:  ", ":work"):
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(self.tasks, query)
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_empty_phrase_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '""')
+
+    def test_non_string_query_raises_type_error(self):
+        with self.assertRaises(TypeError):
+            search(self.tasks, None)
+
+    def test_invalid_query_raises_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "due:today")
+
+    def test_results_keep_input_order(self):
+        reversed_tasks = list(reversed(self.tasks))
+        self.assertEqual(
+            _titles(search(reversed_tasks, "login")),
+            ["fix login timeout", "Fix login page"],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
