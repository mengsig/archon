diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..ea0293f 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,68 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in their input order."""
+    matchers = [_matcher(*term) for term in _split_terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _split_terms(query):
+    """(text, colon_index) per term; colon_index is the first colon outside quotes, or None."""
+    terms = []
+    chars = []
+    colon_index = None
+    started = False
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            started = True
+        elif char.isspace() and not in_quotes:
+            if started:
+                terms.append(("".join(chars), colon_index))
+            chars, colon_index, started = [], None, False
+        else:
+            if char == ":" and not in_quotes and colon_index is None:
+                colon_index = len(chars)
+            chars.append(char)
+            started = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if started:
+        terms.append(("".join(chars), colon_index))
+    return terms
+
+
+def _matcher(term, colon_index):
+    if colon_index is None:
+        return _title_matcher(term.casefold())
+    field, value = term[:colon_index], term[colon_index + 1:]
+    if not value:
+        raise QueryError(f"empty value in query term: {term}")
+    field = field.casefold()
+    if field == "tag":
+        return _tag_matcher(value.casefold())
+    if field == "status":
+        return _status_matcher(value.casefold())
+    raise QueryError(f"unknown field in query term: {term}")
+
+
+def _title_matcher(phrase):
+    return lambda task: phrase in task.title.casefold()
+
+
+def _tag_matcher(tag):
+    return lambda task: any(tag == own.casefold() for own in task.tags)
+
+
+def _status_matcher(status):
+    if status not in STATUSES:
+        raise QueryError(f"unknown status in query: {status}")
+    return lambda task: task.status == status
