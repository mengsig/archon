+@unittest.skipUnless(hasattr(os, "symlink"), "symlinks unavailable")
+class SymlinkRules(ExtractTestCase):
+    def setUp(self):
+        super().setUp()
+        (self.root / "real").mkdir()
+        (self.root / "file").write_bytes(b"keep")
+        os.symlink(self.root / "real", self.root / "dirlink", target_is_directory=True)
+        os.symlink(self.root / "missing", self.root / "dangling")
+        os.symlink(self.root / "file", self.root / "filelink")
