diff --git a/safe_extract.py b/safe_extract.py
index 0007027..dd26035 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,71 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+from pathlib import Path
+import stat
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write entries beneath an existing directory after validating the batch."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+    if not isinstance(root, (Path, str)):
+        raise ValueError("root must be a pathlib.Path or string")
+
+    root = Path(root)
+    try:
+        root_info = root.lstat()
+    except (FileNotFoundError, ValueError):
+        raise ValueError("root must be an existing real directory") from None
+    if not stat.S_ISDIR(root_info.st_mode):
+        raise ValueError("root must be an existing real directory")
+
+    names = []
+    name_set = set()
+    for entry in entries:
+        if (not isinstance(entry, tuple) or len(entry) != 2
+                or not isinstance(entry[0], str) or not isinstance(entry[1], bytes)):
+            raise ValueError("each entry must be a (name, bytes) tuple")
+        name = entry[0]
+        if (not name or name.startswith("/") or "\\" in name or ":" in name
+                or "\0" in name):
+            raise ValueError("invalid path name")
+        parts = name.split("/")
+        if any(part in ("", ".", "..") for part in parts):
+            raise ValueError("invalid path component")
+        if name in name_set:
+            raise ValueError("duplicate path name")
+        name_set.add(name)
+        names.append((name, entry[1], parts))
+
+    for name, _, parts in names:
+        for end in range(1, len(parts)):
+            if "/".join(parts[:end]) in name_set:
+                raise ValueError("file and directory path collision")
+
+    # Inspect every path before creating anything so any validation error is
+    # side-effect free across the complete batch.
+    for _, _, parts in names:
+        current = root
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                info = current.lstat()
+            except FileNotFoundError:
+                continue
+            except OSError:
+                raise
+            if stat.S_ISLNK(info.st_mode):
+                raise ValueError("path component is a symlink")
+            if index == len(parts) - 1:
+                raise ValueError("target already exists")
+            if not os.path.isdir(current):
+                raise ValueError("existing path component is not a directory")
+
+    for _, data, parts in names:
+        target = root.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with target.open("xb") as output:
+            output.write(data)
+
+    return [name for name, _, _ in names]
