+/// Accepts exactly three uppercase ASCII letters, e.g. `EUR`.
+fn parse_currency(s: &str) -> Result<String, ParseError> {
+    let valid = s.len() == 3 && s.bytes().all(|c| c.is_ascii_uppercase());
+    if !valid {
+        return Err(ParseError::BadCurrency(format!(
+            "bad currency {s:?}: want three uppercase letters"
+        )));
+    }
+    Ok(s.to_string())
+}
