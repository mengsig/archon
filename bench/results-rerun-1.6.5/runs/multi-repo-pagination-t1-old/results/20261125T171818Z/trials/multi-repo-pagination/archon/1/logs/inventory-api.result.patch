@@ -21,8 +28,40 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = parse_limit(query.get("limit"))
+        after = parse_cursor(query.get("cursor"))
+    except BadRequest as exc:
+        return _error(400, str(exc))
+    remaining = sorted(
+        (item for item in ITEMS if after is None or item["id"] > after),
+        key=lambda item: item["id"],
+    )
+    page = remaining[:limit]
+    next_cursor = str(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    message = f"limit must be an integer from 1 to {MAX_LIMIT}"
+    if not isinstance(raw, str) or not (raw.isascii() and raw.isdigit()):
+        raise BadRequest(message)
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        raise BadRequest(message)
+    return limit
+
+
+def parse_cursor(raw):
+    """Return the id of the last item already served, or None for the first page."""
+    if raw is None:
+        return None
+    known_ids = {str(item["id"]) for item in ITEMS}
+    if not isinstance(raw, str) or raw not in known_ids:
+        raise BadRequest("invalid cursor")
+    return int(raw)
 
 
