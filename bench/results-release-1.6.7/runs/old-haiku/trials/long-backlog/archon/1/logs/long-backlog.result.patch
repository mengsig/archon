@@ -0,0 +1,81 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ImpossibleDatesTest(unittest.TestCase):
+    def test_impossible_calendar_dates_raise_with_original_text(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as raised:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(raised.exception))
+
+    def test_year_zero_is_rejected(self):
+        with self.assertRaises(InvalidDate):
+            parse_due("0000-01-01", TODAY)
+
+    def test_leap_day_in_leap_year_is_accepted(self):
+        self.assertEqual(parse_due("2028-02-29", TODAY), date(2028, 2, 29))
+        self.assertEqual(parse_due("2026-02-28", TODAY), date(2026, 2, 28))
+
+    def test_invalid_date_is_a_value_error(self):
+        self.assertTrue(issubclass(InvalidDate, ValueError))
+
+
+class MalformedInputTest(unittest.TestCase):
+    def test_unsupported_forms_raise_invalid_date(self):
+        for text in ["", "next week", "2026/03/01", "2026-3-1", "2026-03-01T10:00", "03-01-2026"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as raised:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(raised.exception))
+
+    def test_non_string_input_is_a_type_error(self):
+        with self.assertRaises(TypeError):
+            parse_due(None, TODAY)
+
+    def test_non_date_today_is_a_type_error(self):
+        with self.assertRaises(TypeError):
+            parse_due("today", "2026-03-10")
+
+
+class RelativeOffsetTest(unittest.TestCase):
+    def test_zero_offset_is_today(self):
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+
+    def test_positive_offset_is_days_after_today(self):
+        self.assertEqual(parse_due("+1d", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("+365d", TODAY), date(2027, 3, 10))
+
+    def test_negative_or_unsigned_offsets_raise(self):
+        for text in ["-3d", "3d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as raised:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(raised.exception))
+
+    def test_offset_beyond_representable_range_raises(self):
+        with self.assertRaises(InvalidDate):
+            parse_due("+99999999999d", TODAY)
+
+
+class KeywordTest(unittest.TestCase):
+    def test_today_and_tomorrow(self):
+        self.assertEqual(parse_due("today", TODAY), TODAY)
+        self.assertEqual(parse_due("tomorrow", TODAY), date(2026, 3, 11))
+
+    def test_keywords_ignore_case_and_surrounding_whitespace(self):
+        self.assertEqual(parse_due("  TODAY\t", TODAY), TODAY)
+        self.assertEqual(parse_due(" Tomorrow ", TODAY), date(2026, 3, 11))
+
+    def test_iso_and_offset_ignore_surrounding_whitespace(self):
+        self.assertEqual(parse_due(" 2026-03-12 ", TODAY), date(2026, 3, 12))
+        self.assertEqual(parse_due(" +2d ", TODAY), date(2026, 3, 12))
+
+
+if __name__ == "__main__":
+    unittest.main()
