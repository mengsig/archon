diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..4a62432 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,62 @@
+import re
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+TERM = re.compile(r'\s*(?:"([^"]*)"|([^\s"]+))')
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_parse_term(phrase, word) for phrase, word in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    """Split on whitespace, keeping double-quoted runs whole as (phrase, None)."""
+    terms = []
+    pos = 0
+    while query[pos:].strip():
+        match = TERM.match(query, pos)
+        if not match:
+            raise QueryError(f"unterminated or misplaced quote in query: {query!r}")
+        phrase, word = match.groups()
+        assert (phrase is None) != (word is None), "a term is either a phrase or a word"
+        terms.append((phrase, word))
+        pos = match.end()
+    return terms
+
+
+def _parse_term(phrase, word):
+    if phrase is not None:
+        return _title_contains(phrase)
+    field, separator, value = word.partition(":")
+    if not separator:
+        return _title_contains(word)
+    if field == "tag":
+        return _has_tag(value)
+    if field == "status":
+        return _has_status(value)
+    raise QueryError(f"unknown field {field!r} in term {word!r}")
+
+
+def _title_contains(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _has_tag(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    needle = name.lower()
+    return lambda task: any(tag.lower() == needle for tag in task.tags)
+
+
+def _has_status(value):
+    if value not in STATUSES:
+        raise QueryError(f"unknown status {value!r}; use open or done")
+    return lambda task: task.status == value
