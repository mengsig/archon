-    return {"status": 200, "body": {"items": items}}
+    if cursor is not None:
+        items = [item for item in items if item["id"] > cursor]
+    page = items[:limit]
+    next_cursor = str(page[-1]["id"]) if len(items) > limit else None
+    assert len(page) <= limit
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    """Return (limit, error); error is None when the limit is valid."""
+    if raw is None:
+        return DEFAULT_LIMIT, None
+    if not _is_decimal(raw, MAX_LIMIT_DIGITS) or not 1 <= int(raw) <= MAX_LIMIT:
+        return None, f"limit must be an integer from 1 to {MAX_LIMIT}"
+    return int(raw), None
+
+
+def _parse_cursor(raw):
+    """Return (last_id_seen, error); the cursor is the id of the page's last item."""
+    if raw is None:
+        return None, None
+    if not _is_decimal(raw, MAX_CURSOR_DIGITS):
+        return None, "cursor is invalid"
+    return int(raw), None
+
+
+def _is_decimal(raw, max_digits):
+    """True for a non-empty ASCII digit string short enough to convert safely."""
+    assert isinstance(raw, str), "query values must be strings"
+    return 0 < len(raw) <= max_digits and raw.isascii() and raw.isdigit()
 
 
