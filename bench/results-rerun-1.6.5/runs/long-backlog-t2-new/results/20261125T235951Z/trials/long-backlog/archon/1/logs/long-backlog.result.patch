diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..7066036 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,74 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    """A search query that is malformed or uses an unknown field or value."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_compile_term(text, quoted) for text, quoted in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; returns (text, quoted) pairs."""
+    terms = []
+    chars = []
+    in_quotes = False
+    quoted = False
+    in_term = False
+    for char in query:
+        if char == '"':
+            if not in_term:
+                quoted = True
+            in_quotes = not in_quotes
+            in_term = True
+        elif char.isspace() and not in_quotes:
+            if in_term:
+                terms.append((''.join(chars), quoted))
+            chars, quoted, in_term = [], False, False
+        else:
+            chars.append(char)
+            in_term = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query {query!r}")
+    if in_term:
+        terms.append((''.join(chars), quoted))
+    assert all(text or quoted for text, quoted in terms), "unquoted terms are never empty"
+    return terms
+
+
+def _compile_term(text, quoted):
+    if quoted:
+        return _title_matcher(text)
+    field, separator, value = text.partition(":")
+    if not separator:
+        return _title_matcher(text)
+    field = field.lower()
+    if field == "tag":
+        return _tag_matcher(value)
+    if field == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown field {field!r} in term {text!r}")
+
+
+def _title_matcher(phrase):
+    needle = phrase.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_matcher(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    needle = name.lower()
+    return lambda task: any(tag.lower() == needle for tag in task.tags)
+
+
+def _status_matcher(value):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status {value!r}; expected one of {', '.join(STATUSES)}")
+    return lambda task: task.status == status
