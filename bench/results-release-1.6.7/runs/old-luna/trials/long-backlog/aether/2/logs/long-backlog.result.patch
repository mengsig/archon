@@ -0,0 +1,23 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+
+class CsvExportTest(unittest.TestCase):
+    def test_rfc_4180_escaping_and_record_endings(self):
+        tasks = [
+            Task(7, 'fix, "login"\nnow', ["plain", "has,comma"], due=date(2026, 4, 1)),
+            Task(2, "plain title", ["tag\rname"], status="done"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            'id,title,tags,status,due\r\n'
+            '7,"fix, ""login""\nnow","plain;has,comma",open,2026-04-01\r\n'
+            '2,plain title,"tag\rname",done,\r\n',
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
