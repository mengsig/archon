+class SpecTest(unittest.TestCase):
+    def test_invalid_rate_params_rejected(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate)
+            with self.assertRaises(ValueError):
+                KeyedLimiter(capacity, rate)
+
+    def test_invalid_max_keys_rejected(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0)
+
+    def test_invalid_request_size_rejected(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+
+    def test_invalid_request_does_not_create_key(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 0)
+        self.assertEqual(len(limiter), 0)
+
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(2), 2.0)
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.wait_time(), 0.5)
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_wait_time_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertFalse(bucket.try_acquire())
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertAlmostEqual(bucket.wait_time(), 6.0)
+        clock.now = 10.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        clock.now = 11.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_evicts_least_recently_used_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # counts as a use, so "b" is now LRU
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))  # evicted, returns full
+
+    def test_keyed_wait_time_is_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+
 if __name__ == "__main__":
     unittest.main()
