+class PausingBalances(dict):
+    """Test double: blocks the credit write to `paused_key` until `resume` is set."""
+
+    def __init__(self, balances, paused_key):
+        super().__init__(balances)
+        self.paused_key = paused_key
+        self.paused = threading.Event()
+        self.resume = threading.Event()
+
+    def __setitem__(self, key, value):
+        if key == self.paused_key and not self.paused.is_set():
+            self.paused.set()
+            self.resume.wait(WATCHDOG_SECONDS)
+        super().__setitem__(key, value)
+
+
+class TransferAtomicity(unittest.TestCase):
+    def test_snapshot_never_sees_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        ledger._balances = PausingBalances(ledger._balances, paused_key="b")
+        balances = ledger._balances
+        errors = []
+        observed = []
+
+        def transfer():
+            try:
+                ledger.transfer("a", "b", 1)
+            except Exception as exc:
+                errors.append(exc)
+
+        def snapshot():
+            observed.append(ledger.snapshot())
+
+        writer = threading.Thread(target=transfer, daemon=True)
+        reader = threading.Thread(target=snapshot, daemon=True)
+        writer.start()
+        self.assertTrue(balances.paused.wait(WATCHDOG_SECONDS), "transfer never reached credit")
+        reader.start()
+        # A correct snapshot blocks until the paused transfer finishes. Without the lock
+        # it returns at once with a half-applied transfer, which is caught below.
+        reader.join(5)
+        balances.resume.set()
+        writer.join(WATCHDOG_SECONDS)
+        reader.join(WATCHDOG_SECONDS)
+        self.assertEqual(errors, [])
+        self.assertEqual(observed, [{"a": 999, "b": 1001}])
+
+
+class ConcurrentTransfers(unittest.TestCase):
+    ROUNDS = 2000
+
+    def test_opposite_transfers_do_not_deadlock_and_conserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        errors = []
+
+        def move(source, destination):
+            try:
+                for _ in range(self.ROUNDS):
+                    ledger.transfer(source, destination, 1)
+            except Exception as exc:
+                errors.append(exc)
+
+        def observe():
+            try:
+                for _ in range(self.ROUNDS):
+                    self.assertEqual(sum(ledger.snapshot().values()), 2000)
+            except Exception as exc:
+                errors.append(exc)
+
+        threads = [
+            threading.Thread(target=move, args=("a", "b"), daemon=True),
+            threading.Thread(target=move, args=("b", "a"), daemon=True),
+            threading.Thread(target=observe, daemon=True),
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(WATCHDOG_SECONDS)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "deadlock")
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+
+if __name__ == "__main__":
+    unittest.main()
