--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,53 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_plain_rows_end_with_crlf(self):
+        store = TaskStore()
+        store.add("plain", tags=["a", "b"], due=date(2026, 4, 1))
+        store.add("none")
+        store.complete(2)
+        expected = f"{HEADER}\r\n1,plain,a;b,open,2026-04-01\r\n2,none,,done,\r\n"
+        self.assertEqual(to_csv(store.all()), expected)
+
+    def test_rows_keep_given_order(self):
+        store = TaskStore()
+        store.add("first")
+        store.add("second")
+        lines = to_csv(list(reversed(store.all()))).split("\r\n")
+        self.assertEqual(lines[1].split(",")[1], "second")
+
+    def test_comma_quote_and_newlines_are_quoted(self):
+        store = TaskStore()
+        store.add('buy milk, eggs', tags=["home"])
+        store.add('say "hi"')
+        store.add("line one\nline two")
+        store.add("carriage\rreturn")
+        lines = to_csv(store.all())
+        self.assertIn('1,"buy milk, eggs",home,open,\r\n', lines)
+        self.assertIn('2,"say ""hi""",,open,\r\n', lines)
+        self.assertIn('3,"line one\nline two",,open,\r\n', lines)
+        self.assertIn('4,"carriage\rreturn",,open,\r\n', lines)
+
+    def test_quoted_tag_field_when_tag_contains_comma(self):
+        store = TaskStore()
+        store.add("t", tags=["a,b", "c"])
+        self.assertIn('1,t,"a,b;c",open,\r\n', to_csv(store.all()))
+
+    def test_plain_fields_are_not_quoted(self):
+        store = TaskStore()
+        store.add("simple title", tags=["x"], due=date(2026, 1, 2))
+        self.assertEqual(to_csv(store.all()).split("\r\n")[1], "1,simple title,x,open,2026-01-02")
+
+
+if __name__ == "__main__":
+    unittest.main()
