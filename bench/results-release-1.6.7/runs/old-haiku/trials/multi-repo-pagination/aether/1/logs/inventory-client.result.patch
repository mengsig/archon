diff --git a/test/client.test.js b/test/client.test.js
index db0605e..e4f545e 100644
--- a/test/client.test.js
+++ b/test/client.test.js
@@ -28,3 +28,55 @@ test('gets one item and reports failures', async () => {
 test('finds low stock', () => {
   assert.deepEqual(lowStock(ITEMS, 10), ['SKU-0001']);
 });
+
+const ALL_ITEMS = Array.from({ length: 5 }, (_, i) => ({ id: i + 1, sku: `SKU-${i + 1}`, qty: 1 }));
+
+// Serves ALL_ITEMS two at a time, like the API, and records each request.
+function pagedTransport(requests) {
+  return async (request) => {
+    requests.push(request);
+    const start = request.query.cursor === undefined ? 0 : Number(request.query.cursor);
+    const page = ALL_ITEMS.slice(start, start + 2);
+    const next = start + 2 < ALL_ITEMS.length ? String(start + 2) : null;
+    return { status: 200, body: { items: page, next_cursor: next } };
+  };
+}
+
+test('follows next_cursor across pages, in order', async () => {
+  const requests = [];
+  assert.deepEqual(await listItems(pagedTransport(requests)), ALL_ITEMS);
+  assert.deepEqual(
+    requests.map((r) => r.query),
+    [{}, { cursor: '2' }, { cursor: '4' }],
+  );
+});
+
+test('stops when next_cursor is null or absent', async () => {
+  const requests = [];
+  const transport = async (request) => {
+    requests.push(request);
+    return { status: 200, body: { items: [ALL_ITEMS[0]], next_cursor: null } };
+  };
+  assert.deepEqual(await listItems(transport), [ALL_ITEMS[0]]);
+  assert.equal(requests.length, 1);
+});
+
+test('fails when the server repeats a cursor instead of looping', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /same next_cursor twice/);
+});
+
+test('fails when a later page is not 200', async () => {
+  const transport = async (request) => {
+    if (request.query.cursor === undefined) {
+      return { status: 200, body: { items: ALL_ITEMS.slice(0, 2), next_cursor: 'x' } };
+    }
+    return { status: 400, body: { error: 'cursor is invalid' } };
+  };
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('fails when a page has no items array', async () => {
+  const transport = async () => ({ status: 200, body: { next_cursor: null } });
+  await assert.rejects(listItems(transport), /items array/);
+});
