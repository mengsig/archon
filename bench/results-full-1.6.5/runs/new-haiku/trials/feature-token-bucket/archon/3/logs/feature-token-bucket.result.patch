+class BucketSpecTest(unittest.TestCase):
+    def test_invalid_capacity_or_rate_rejected(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5), (float("nan"), 1.0)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_n_rejected_by_all_methods(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_failed_acquire_consumes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(), 0.5)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 0.5
+        self.assertEqual(bucket.wait_time(), 0.0)
+        self.assertTrue(bucket.try_acquire())
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 10.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        clock.now = 11.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+
+class KeyedSpecTest(unittest.TestCase):
+    def test_invalid_max_keys_rejected(self):
+        for max_keys in [0, -1]:
+            with self.subTest(max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_capacity_rejected(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0, clock=FakeClock())
+
+    def test_wait_time_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_lru_key_evicted_when_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("c"))
+
+    def test_use_refreshes_lru_order(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        limiter.try_acquire("a", 2)
+        limiter.try_acquire("b")
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_invalid_n_does_not_create_or_evict_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", 2)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", 0)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
     unittest.main()
