+        balances["a"] = 99
+        balances["b"] = 5
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
+    def test_snapshot_is_a_copy(self):
+        ledger = Ledger({"a": 1})
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 50
+        snapshot["b"] = 5
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
