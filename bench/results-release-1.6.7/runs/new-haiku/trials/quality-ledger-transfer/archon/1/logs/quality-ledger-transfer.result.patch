+from ledger import MAX_BALANCE, Ledger
+
+# Upper bound on how long a worker may run; a deadlock fails the test instead of hanging it.
+JOIN_TIMEOUT_SECONDS = 20
+PROBE_SECONDS = 1
+ROUNDS = 2000
+class MyInt(int):
+    pass
+
+
+class LyingDict(dict):
+    def items(self):
+        return [("a", 1)]
+
+
+class PausingDict(dict):
+    """Blocks the write to one key until released, so a transfer stays half done."""
+
+    def __init__(self, source, pause_key, paused, release):
+        super().__init__(source)
+        self._pause_key = pause_key
+        self._paused = paused
+        self._release = release
+
+    def __setitem__(self, key, value):
+        if key == self._pause_key:
+            self._paused.set()
+            self._release.wait(JOIN_TIMEOUT_SECONDS)
+        super().__setitem__(key, value)
+
+
+INVALID_AMOUNTS = [0, -1, MAX_BALANCE + 1, True, False, 1.0, "1", None, MyInt(1)]
+INVALID_BALANCES = [-1, MAX_BALANCE + 1, True, 1.5, "5", None, MyInt(3)]
+INVALID_NAMES = ["", 0, None, b"a"]
 
 
