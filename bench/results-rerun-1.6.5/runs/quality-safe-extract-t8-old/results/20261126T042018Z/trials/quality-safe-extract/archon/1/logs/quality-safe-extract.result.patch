--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,102 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import pathlib
+import stat
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+NAME_MAX_BYTES = 255
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("batch must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    _validate_entries(entries)
+    for name, _ in entries:
+        _validate_target(root_path, name)
+    for name, data in entries:
+        _write_file(root_path / name, data)
+    return [name for name, _ in entries]
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, pathlib.Path)) or root == "":
+        raise ValueError("root must be a nonempty str or pathlib.Path")
+    root_path = pathlib.Path(root)
+    if root_path.is_symlink() or not root_path.is_dir():
+        raise ValueError(f"root must be an existing real directory: {root_path}")
+    return root_path
+
+
+def _validate_entries(entries):
+    files = set()
+    directories = set()
+    for entry in entries:
+        name, data = _unpack_entry(entry)
+        parts = _validate_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError(f"data for {name!r} must be bytes")
+        ancestors = ["/".join(parts[:i]) for i in range(1, len(parts))]
+        if name in files:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        if name in directories:
+            raise ValueError(f"entry {name!r} is a directory of another entry")
+        if any(ancestor in files for ancestor in ancestors):
+            raise ValueError(f"entry {name!r} is below a file of the batch")
+        files.add(name)
+        directories.update(ancestors)
+
+
+def _unpack_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("entry must be a (name, data) tuple")
+    return entry
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, not {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+    try:
+        encoded_parts = [os.fsencode(part) for part in parts]
+    except UnicodeEncodeError as error:
+        raise ValueError(f"name cannot be encoded as a filename: {name!r}") from error
+    if any(len(part) > NAME_MAX_BYTES for part in encoded_parts):
+        raise ValueError(f"name has a component longer than {NAME_MAX_BYTES} bytes")
+    return parts
+
+
+def _validate_target(root, name):
+    parts = name.split("/")
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        mode = _lstat_mode(current)
+        if mode is None:
+            return
+        if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
+            raise ValueError(f"ancestor of {name!r} is not a real directory: {part!r}")
+    if _lstat_mode(current / parts[-1]) is not None:
+        raise ValueError(f"target already exists: {name!r}")
+
+
+def _lstat_mode(path):
+    try:
+        return os.lstat(path).st_mode
+    except FileNotFoundError:
+        return None
+
+
+def _write_file(path, data):
+    assert isinstance(data, bytes)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    assert path.parent.is_dir() and not path.parent.is_symlink()
+    with open(path, "xb") as handle:
+        handle.write(data)
