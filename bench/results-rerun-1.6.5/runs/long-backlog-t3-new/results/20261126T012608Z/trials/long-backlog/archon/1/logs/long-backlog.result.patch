+    def _undo_status(self, task_id, previous_status):
+        self.get(task_id).status = previous_status
+
+    def _undo_delete(self, snapshot):
+        assert snapshot.id not in self._tasks, "undone delete id must be free"
+        self._tasks[snapshot.id] = snapshot
+
     def all(self):
