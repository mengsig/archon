+#[test]
+fn parses_and_validates_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t1\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    for currency in ["usd", "US", "USDD", "U$D", "ÉUR", " EUR "] {
+        let error =
+            parse_line_with_error(&format!("2026-03-01\tgroceries\t1\t{currency}")).unwrap_err();
+        assert!(error.invalid_currency, "{currency:?}");
+    }
+    assert!(
+        !parse_line_with_error("2026-03-01\tgroceries\tbad\tEUR")
+            .unwrap_err()
+            .invalid_currency
+    );
+}
+
+#[test]
+fn currency_cli_reports_line_and_uses_exit_two() {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(b"# note\n2026-03-01\tfood\t1\n2026-03-02\tfood\t2\tusd\n")
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(2));
+    assert!(
+        String::from_utf8_lossy(&output.stdout).starts_with("date,account,amount_cents,currency\n")
+    );
+    assert!(String::from_utf8_lossy(&output.stderr).contains("line 3: bad currency"));
+
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(b"2026-03-01\tfood\tbad\n")
+        .unwrap();
+    assert_eq!(child.wait().unwrap().code(), Some(1));
+}
