@@ -0,0 +1,96 @@
+"""Search query syntax (TT-103)."""
+import unittest
+
+from tasktracker.models import DONE, OPEN, Task
+from tasktracker.search import QueryError, search
+
+TASKS = [
+    Task(1, "Fix login page", ["work"], OPEN),
+    Task(2, "write report", ["Work", "urgent"], DONE),
+    Task(3, "buy milk", [], OPEN),
+    Task(4, "fix login redirect", ["home"], DONE),
+]
+
+
+def ids(query, tasks=TASKS):
+    return [task.id for task in search(tasks, query)]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_input_order(self):
+        self.assertEqual(ids(""), [1, 2, 3, 4])
+        self.assertEqual(ids("   \t "), [1, 2, 3, 4])
+
+    def test_input_order_is_kept(self):
+        reversed_tasks = list(reversed(TASKS))
+        self.assertEqual(ids("login", reversed_tasks), [4, 1])
+
+    def test_bare_word_matches_title_substring(self):
+        self.assertEqual(ids("report"), [2])
+
+    def test_bare_word_is_case_insensitive(self):
+        self.assertEqual(ids("FIX"), [1, 4])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(ids('"fix login"'), [1, 4])
+        self.assertEqual(ids('"login fix"'), [])
+
+    def test_quoted_phrase_is_case_insensitive(self):
+        self.assertEqual(ids('"FIX LOGIN"'), [1, 4])
+
+    def test_terms_are_anded(self):
+        self.assertEqual(ids("fix redirect"), [4])
+        self.assertEqual(ids("fix milk"), [])
+
+    def test_quoted_and_bare_terms_combine(self):
+        self.assertEqual(ids('"fix login" redirect'), [4])
+
+    def test_tag_matches_exact_tag(self):
+        self.assertEqual(ids("tag:work"), [1, 2])
+
+    def test_tag_is_case_insensitive(self):
+        self.assertEqual(ids("tag:WORK"), [1, 2])
+
+    def test_tag_does_not_match_partial_tag(self):
+        self.assertEqual(ids("tag:wor"), [])
+
+    def test_tag_does_not_match_title(self):
+        self.assertEqual(ids("tag:login"), [])
+
+    def test_tag_combines_with_text(self):
+        self.assertEqual(ids("tag:work report"), [2])
+
+    def test_status_open_and_done(self):
+        self.assertEqual(ids("status:open"), [1, 3])
+        self.assertEqual(ids("status:done"), [2, 4])
+
+    def test_status_value_is_case_insensitive(self):
+        self.assertEqual(ids("status:DONE"), [2, 4])
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "status:pending")
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "due:today")
+
+    def test_empty_tag_name_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, '"fix login')
+
+    def test_colon_inside_quotes_is_literal_text(self):
+        tasks = [Task(1, "tag:work cleanup"), Task(2, "work")]
+        self.assertEqual(ids('"tag:work"', tasks), [1])
+
+    def test_quoted_field_value_keeps_spaces(self):
+        tasks = [Task(1, "a", ["team a"]), Task(2, "b", ["team"])]
+        self.assertEqual(ids('tag:"team a"', tasks), [1])
+
+
+if __name__ == "__main__":
+    unittest.main()
