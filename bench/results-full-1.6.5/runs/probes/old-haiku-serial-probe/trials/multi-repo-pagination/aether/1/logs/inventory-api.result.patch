-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after_id = _parse_cursor(query.get("cursor"))
+    except BadRequest as exc:
+        return _error(400, str(exc))
+    remaining = [item for item in sorted(ITEMS, key=lambda item: item["id"]) if item["id"] > after_id]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    assert len(page) <= limit
+    assert all(item["id"] > after_id for item in page)
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not isinstance(raw, str) or not _DIGITS.fullmatch(raw):
+        raise BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        raise BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return limit
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _parse_cursor(raw):
+    """Return the id of the last item already served; 0 means start from the beginning."""
+    if raw is None:
+        return 0
+    if not isinstance(raw, str):
+        raise BadRequest("cursor is invalid")
+    try:
+        text = base64.b64decode(raw, altchars=b"-_", validate=True).decode("ascii")
+    except ValueError as exc:
+        raise BadRequest("cursor is invalid") from exc
+    if not _DIGITS.fullmatch(text):
+        raise BadRequest("cursor is invalid")
+    return int(text)
 
 
