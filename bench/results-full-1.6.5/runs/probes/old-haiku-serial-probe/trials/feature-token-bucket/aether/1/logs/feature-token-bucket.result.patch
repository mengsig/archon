+class ValidationTest(unittest.TestCase):
+    def test_bad_bucket_params_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_bad_request_size_raises_without_consuming(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3]:
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_bad_keyed_params_raise(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+
+    def test_invalid_request_does_not_create_key_or_evict(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
+class RefillTest(unittest.TestCase):
+    def test_fractional_tokens_accumulate(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(1), 0.5)
+        self.assertAlmostEqual(bucket.wait_time(2), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(1), 0.5)
+        clock.now = 0.5
+        self.assertEqual(bucket.wait_time(1), 0.0)
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 10.0
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 10.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+
+class EvictionTest(unittest.TestCase):
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("c"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_wait_time_creates_key(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(limiter.wait_time("x"), 0.0)
+        self.assertEqual(len(limiter), 1)
+
+
 if __name__ == "__main__":
     unittest.main()
