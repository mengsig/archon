diff --git a/tests/test_dates.py b/tests/test_dates.py
new file mode 100644
index 0000000..bc4f502
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,19 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+
+class DueDateTest(unittest.TestCase):
+    def test_invalid_dates_and_offsets(self):
+        today = date(2026, 3, 10)
+        for value in ("2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10", "nope", "-3d", "3d"):
+            with self.subTest(value=value), self.assertRaises(InvalidDate) as caught:
+                parse_due(value, today)
+            self.assertIn(value, str(caught.exception))
+        self.assertEqual(parse_due("+0d", today), today)
+        self.assertEqual(parse_due(" Tomorrow ", today), date(2026, 3, 11))
+
+
+if __name__ == "__main__":
+    unittest.main()
