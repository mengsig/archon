@@ -0,0 +1,89 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def sample_tasks():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["work"])
+    store.add("write report", tags=["Work", "urgent"])
+    store.add("buy milk", tags=["home"])
+    store.add("fix the fence")
+    store.complete(3)
+    return store.all()
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def test_bare_word_matches_case_insensitively(self):
+        self.assertEqual(titles(search(sample_tasks(), "FIX")), ["Fix login bug", "fix the fence"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(sample_tasks(), '"fix login"')), ["Fix login bug"])
+        self.assertEqual(titles(search(sample_tasks(), '"login fix"')), [])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(titles(search(sample_tasks(), "fix login")), ["Fix login bug"])
+        self.assertEqual(titles(search(sample_tasks(), "fix milk")), [])
+
+    def test_blank_query_matches_everything_in_order(self):
+        tasks = sample_tasks()
+        for query in ["", "   ", "\t"]:
+            with self.subTest(query=query):
+                self.assertEqual(search(tasks, query), tasks)
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(sample_tasks(), "tag:work")), ["Fix login bug", "write report"])
+        self.assertEqual(titles(search(sample_tasks(), "tag:wor")), [])
+
+    def test_status_filters(self):
+        self.assertEqual(
+            titles(search(sample_tasks(), "status:open")),
+            ["Fix login bug", "write report", "fix the fence"],
+        )
+        self.assertEqual(titles(search(sample_tasks(), "status:done")), ["buy milk"])
+
+    def test_field_and_text_combine(self):
+        self.assertEqual(titles(search(sample_tasks(), "tag:work status:open fix")), ["Fix login bug"])
+
+    def test_quoted_field_like_text_is_literal(self):
+        tasks = sample_tasks()
+        self.assertEqual(search(tasks, '"tag:work"'), [])
+
+    def test_quoted_value_keeps_its_spaces(self):
+        store = TaskStore()
+        store.add("x", tags=["big project"])
+        self.assertEqual(len(search(store.all(), 'tag:"big project"')), 1)
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), "due:today")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), "status:later")
+
+    def test_empty_tag_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(sample_tasks(), '"fix login')
+
+    def test_errors_raise_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "due:today")
+
+    def test_works_on_plain_tasks(self):
+        tasks = [Task(1, "Alpha", tags=["t"])]
+        self.assertEqual(search(tasks, "alpha tag:t"), tasks)
+
+
+if __name__ == "__main__":
+    unittest.main()
