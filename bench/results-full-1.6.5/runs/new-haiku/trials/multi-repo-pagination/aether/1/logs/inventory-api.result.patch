@@ -21,8 +26,44 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after = None
+    if "cursor" in query:
+        after = _decode_cursor(query["cursor"])
+        if after is None:
+            return _error(400, "cursor is invalid")
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    pending = [item for item in ordered if after is None or item["id"] > after]
+    page = pending[:limit]
+    assert len(page) <= limit
+    assert after is None or all(item["id"] > after for item in page)
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(pending) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not (raw.isascii() and raw.isdigit()):
+        return None
+    limit = int(raw)
+    return limit if 1 <= limit <= MAX_LIMIT else None
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    try:
+        text = base64.urlsafe_b64decode(raw.encode("ascii")).decode("ascii")
+    except ValueError:
+        return None
+    if not (text.isascii() and text.isdigit()):
+        return None
+    return int(text)
 
 
