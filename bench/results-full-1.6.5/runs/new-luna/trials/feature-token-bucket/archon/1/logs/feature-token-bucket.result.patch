 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _validate_positive(value, name):
+    try:
+        valid = value > 0 and math.isfinite(value)
+    except (TypeError, OverflowError):
+        valid = False
+    if not valid:
+        raise ValueError("%s must be positive and finite" % name)
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_positive(capacity, "capacity")
+        _validate_positive(refill_per_sec, "refill_per_sec")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.clock = clock
+        self._tokens = capacity
+        self._updated_at = clock()
+
+    def _validate_request(self, n):
+        try:
+            valid = n > 0 and n <= self.capacity
+        except TypeError:
+            valid = False
+        if not valid:
+            raise ValueError("n must be positive and no greater than capacity")
+
+    def _refill(self):
+        now = self.clock()
+        if now > self._updated_at:
+            elapsed = now - self._updated_at
+            self._tokens = min(self.capacity, self._tokens + elapsed * self.refill_per_sec)
+            self._updated_at = now
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
