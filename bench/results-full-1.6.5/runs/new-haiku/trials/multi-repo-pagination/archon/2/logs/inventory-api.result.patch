@@ -21,8 +24,47 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = _parse_limit(query.get("limit"))
+        after_id = _parse_cursor(query.get("cursor"))
+    except _BadRequest as exc:
+        return _error(400, str(exc))
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    remaining = [item for item in ordered if after_id is None or item["id"] > after_id]
+    page = remaining[:limit]
+    assert len(page) <= limit
+    has_more = len(remaining) > limit
+    assert not has_more or len(page) == limit
+    next_cursor = str(page[-1]["id"]) if has_more else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+class _BadRequest(Exception):
+    pass
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    limit = _parse_decimal(raw, "limit")
+    if not 1 <= limit <= MAX_LIMIT:
+        raise _BadRequest(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return limit
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None
+    return _parse_decimal(raw, "cursor")
+
+
+def _parse_decimal(raw, name):
+    if not (raw.isascii() and raw.isdigit()):
+        raise _BadRequest(f"{name} is not valid")
+    try:
+        return int(raw)
+    except ValueError as exc:
+        raise _BadRequest(f"{name} is not valid") from exc
 
 
