+HEADER = "id,title,tags,status,due"
+NEEDS_QUOTES = (",", '"', "\r", "\n")
+
+
+def _field(value):
+    text = str(value)
+    if not any(char in text for char in NEEDS_QUOTES):
+        return text
+    return '"' + text.replace('"', '""') + '"'
+
+
+def _row(task):
+    due = task.due.isoformat() if task.due else ""
+    tags = ";".join(task.tags)
+    return ",".join(_field(v) for v in (task.id, task.title, tags, task.status, due))
+
+
 def to_csv(tasks):
-    lines = ["id,title,tags,status,due"]
-    for task in tasks:
-        due = task.due.isoformat() if task.due else ""
-        lines.append(f"{task.id},{task.title},{';'.join(task.tags)},{task.status},{due}")
-    return "\n".join(lines) + "\n"
+    """RFC 4180 CSV: a header row, then one row per task, every line CRLF-ended."""
+    lines = [HEADER] + [_row(task) for task in tasks]
