+import csv
+import io
+import unittest
+from datetime import date, datetime
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_task_list_gives_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_header_and_lines_end_with_crlf(self):
+        text = to_csv([Task(1, "a"), Task(2, "b")])
+        self.assertEqual(text, HEADER + "1,a,,open,\r\n2,b,,open,\r\n")
+
+    def test_rows_keep_given_order(self):
+        tasks = [Task(3, "third"), Task(1, "first"), Task(2, "second")]
+        rows = to_csv(tasks).split("\r\n")
+        self.assertEqual([row.split(",")[0] for row in rows[1:4]], ["3", "1", "2"])
+
+    def test_tags_joined_with_semicolon(self):
+        self.assertEqual(to_csv([Task(1, "t", tags=["work", "urgent"])]),
+                         HEADER + "1,t,work;urgent,open,\r\n")
+
+    def test_due_date_is_iso_or_empty(self):
+        text = to_csv([Task(1, "a", due=date(2026, 4, 1)), Task(2, "b")])
+        self.assertEqual(text, HEADER + "1,a,,open,2026-04-01\r\n2,b,,open,\r\n")
+
+    def test_status_is_written_as_is(self):
+        self.assertEqual(to_csv([Task(1, "a", status="done")]), HEADER + "1,a,,done,\r\n")
+
+    def test_comma_in_title_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "eggs, milk")]), HEADER + '1,"eggs, milk",,open,\r\n')
+
+    def test_double_quote_is_quoted_and_doubled(self):
+        self.assertEqual(to_csv([Task(1, 'say "hi"')]), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_carriage_return_in_title_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "a\rb")]), HEADER + '1,"a\rb",,open,\r\n')
+
+    def test_line_feed_in_title_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "a\nb")]), HEADER + '1,"a\nb",,open,\r\n')
+
+    def test_quoting_applies_to_any_field(self):
+        text = to_csv([Task(1, "t", tags=["x,y", 'q"z'])])
+        self.assertEqual(text, HEADER + '1,t,"x,y;q""z",open,\r\n')
+
+    def test_unspecial_fields_are_not_quoted(self):
+        text = to_csv([Task(1, "a; b 'c'", tags=["d e"])])
+        self.assertEqual(text, HEADER + "1,a; b 'c',d e,open,\r\n")
+
+    def test_round_trips_through_csv_reader(self):
+        title = 'x, "y"\r\nz'
+        text = to_csv([Task(7, title, tags=["a,b"])])
+        rows = list(csv.reader(io.StringIO(text, newline="")))
+        self.assertEqual(rows, [["id", "title", "tags", "status", "due"],
+                                ["7", title, "a,b", "open", ""]])
+
+    def test_rejects_non_task(self):
+        with self.assertRaises(TypeError):
+            to_csv(["not a task"])
+
+    def test_rejects_datetime_due(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(1, "a", due=datetime(2026, 4, 1, 9, 0))])
+
+    def test_rejects_non_string_tag(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(1, "a", tags=[3])])
+
+    def test_tuple_tags_are_joined(self):
+        self.assertEqual(to_csv([Task(1, "a", tags=("x", "y"))]), HEADER + "1,a,x;y,open,\r\n")
+
+    def test_rejects_string_due(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(1, "a", due="2026-04-01")])
+
+    def test_rejects_bool_id(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(True, "a")])
+
+
+if __name__ == "__main__":
+    unittest.main()
