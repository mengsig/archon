@@ -0,0 +1,91 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+HEADER = "id,title,tags,status,due"
+
+
+def parse(text):
+    return list(csv.reader(io.StringIO(text, newline="")))
+
+
+class ExportHeaderAndOrderTest(unittest.TestCase):
+    def test_empty_export_has_only_header(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_header_then_rows_in_given_order(self):
+        tasks = [Task(3, "third"), Task(1, "first")]
+        self.assertEqual(
+            to_csv(tasks).split("\r\n"),
+            [HEADER, "3,third,,open,", "1,first,,open,", ""],
+        )
+
+
+class ExportFieldFormatTest(unittest.TestCase):
+    def test_plain_fields_are_not_quoted(self):
+        task = Task(7, "plain title", ["a"], DONE, date(2026, 4, 1))
+        self.assertEqual(to_csv([task]), HEADER + "\r\n7,plain title,a,done,2026-04-01\r\n")
+
+    def test_multiple_tags_joined_with_semicolon(self):
+        task = Task(1, "t", ["work", "urgent", "home"])
+        self.assertEqual(parse(to_csv([task]))[1][2], "work;urgent;home")
+
+    def test_no_tags_gives_empty_field(self):
+        self.assertEqual(to_csv([Task(1, "t")]), HEADER + "\r\n1,t,,open,\r\n")
+
+    def test_due_date_is_iso_and_missing_due_is_empty(self):
+        with_due = Task(1, "t", due=date(2026, 1, 5))
+        without_due = Task(2, "t")
+        rows = parse(to_csv([with_due, without_due]))
+        self.assertEqual(rows[1][4], "2026-01-05")
+        self.assertEqual(rows[2][4], "")
+
+    def test_tag_containing_comma_is_quoted(self):
+        task = Task(1, "t", ["a,b", "c"])
+        self.assertEqual(parse(to_csv([task]))[1][2], "a,b;c")
+        self.assertIn('"a,b;c"', to_csv([task]))
+
+
+class ExportEscapingTest(unittest.TestCase):
+    def test_title_with_comma_is_quoted(self):
+        output = to_csv([Task(1, "buy milk, eggs")])
+        self.assertEqual(output, HEADER + '\r\n1,"buy milk, eggs",,open,\r\n')
+
+    def test_title_with_quotes_is_wrapped_and_doubled(self):
+        output = to_csv([Task(1, 'say "hi"')])
+        self.assertEqual(output, HEADER + '\r\n1,"say ""hi""",,open,\r\n')
+
+    def test_title_with_lf_is_quoted(self):
+        output = to_csv([Task(1, "line one\nline two")])
+        self.assertEqual(output, HEADER + '\r\n1,"line one\nline two",,open,\r\n')
+
+    def test_title_with_cr_is_quoted(self):
+        output = to_csv([Task(1, "carriage\rreturn")])
+        self.assertEqual(output, HEADER + '\r\n1,"carriage\rreturn",,open,\r\n')
+
+    def test_special_characters_round_trip(self):
+        titles = ['a,b', 'say "hi", ok', "two\r\nlines", "x\ny", '"', ""]
+        tasks = [Task(i, title) for i, title in enumerate(titles, start=1)]
+        rows = parse(to_csv(tasks))
+        self.assertEqual([row[1] for row in rows[1:]], titles)
+
+
+class ExportLineEndingTest(unittest.TestCase):
+    def test_every_line_ends_with_crlf(self):
+        output = to_csv([Task(1, "a"), Task(2, "c")])
+        self.assertTrue(output.endswith("\r\n"))
+        self.assertEqual(output.count("\r\n"), 3)
+        self.assertNotIn("\n", output.replace("\r\n", ""))
+
+    def test_round_trip_keeps_all_fields(self):
+        task = Task(5, 'mixed, "quoted"\nline', ["t1", "t,2"], DONE, date(2027, 12, 31))
+        rows = parse(to_csv([task]))
+        self.assertEqual(rows[1], ["5", 'mixed, "quoted"\nline', "t1;t,2", "done", "2027-12-31"])
+
+
+if __name__ == "__main__":
+    unittest.main()
