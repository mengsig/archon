 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Write every (name, data) regular file under root; return names in input order.
+
+    The whole batch and every target path are validated before anything is created.
+    """
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _validate_root(root)
+    parsed = [_parse_entry(entry) for entry in entries]
+    _check_collisions(parsed)
+    for _, parts, _ in parsed:
+        _check_target_absent(root_path, parts)
+    return _write_entries(root_path, parsed)
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, not {type(root).__name__}")
+    if isinstance(root, str) and not root:
+        raise ValueError("root must not be an empty string")
+    root_path = Path(root)
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist as a directory: {root!r}") from exc
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be a real directory, not a file or symlink: {root!r}")
+    return root_path
+
+
+def _parse_entry(entry):
+    """Return (name, path parts, data) for one (name, data) tuple."""
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple: {entry!r}")
+    name, data = entry
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name, _parse_name(name), data
+
+
+def _parse_name(name):
+    """Return the path components of a relative POSIX name, rejecting unsafe names."""
+    if not isinstance(name, str):
+        raise ValueError(f"name must be a str, not {type(name).__name__}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    parts = tuple(name.split("/"))
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+        _check_encodable(name, part)
+    return parts
+
+
+def _check_encodable(name, part):
+    try:
+        part.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name cannot be encoded for the filesystem: {name!r}") from exc
+
+
+def _check_collisions(parsed):
+    """Reject duplicate names and any file/directory overlap within the batch."""
+    files = set()
+    directories = set()
+    for name, parts, _ in parsed:
+        if parts in files or parts in directories:
+            raise ValueError(f"duplicate or conflicting name: {name!r}")
+        ancestors = [parts[:depth] for depth in range(1, len(parts))]
+        if any(ancestor in files for ancestor in ancestors):
+            raise ValueError(f"name collides with a file in the batch: {name!r}")
+        files.add(parts)
+        directories.update(ancestors)
+
+
+def _check_target_absent(root, parts):
+    """Reject a target whose existing ancestors are not real directories or that already exists."""
+    current = root
+    for depth, part in enumerate(parts):
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if depth == len(parts) - 1:
+            raise ValueError(f"target already exists: {str(current)!r}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor is not a real directory: {str(current)!r}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_entries(root, parsed):
+    names = []
+    for name, parts, data in parsed:
+        target = root.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with open(target, "xb") as handle:
+            handle.write(data)
+        names.append(name)
+    return names
