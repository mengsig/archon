index 0000000..e77bb95
--- /dev/null
+++ b/tests/test_dates.py
@@ -0,0 +1,54 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+
+TODAY = date(2026, 3, 10)
+
+
+class ParseDueTest(unittest.TestCase):
+    def test_iso_dates(self):
+        self.assertEqual(parse_due("2026-03-12", TODAY), date(2026, 3, 12))
+        self.assertEqual(parse_due("2024-02-29", TODAY), date(2024, 2, 29))
+
+    def test_impossible_calendar_dates_are_rejected(self):
+        for text in ["2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10", "0000-01-01"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate) as ctx:
+                    parse_due(text, TODAY)
+                self.assertIn(text, str(ctx.exception))
+
+    def test_invalid_date_is_a_value_error(self):
+        with self.assertRaises(ValueError):
+            parse_due("2026-02-30", TODAY)
+
+    def test_keywords(self):
+        self.assertEqual(parse_due("today", TODAY), TODAY)
+        self.assertEqual(parse_due(" Tomorrow ", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("TODAY\t", TODAY), TODAY)
+
+    def test_relative_offsets(self):
+        self.assertEqual(parse_due("+5d", TODAY), date(2026, 3, 15))
+        self.assertEqual(parse_due("+0d", TODAY), TODAY)
+        self.assertEqual(parse_due("+1D", TODAY), date(2026, 3, 11))
+        self.assertEqual(parse_due("+365d", TODAY), date(2027, 3, 10))
+
+    def test_negative_and_unsigned_offsets_are_rejected(self):
+        for text in ["-3d", "3d", "+3", "+-3d"]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+    def test_out_of_range_offset_is_rejected(self):
+        with self.assertRaises(InvalidDate):
+            parse_due("+99999999999d", TODAY)
+
+    def test_unrecognised_text_is_rejected(self):
+        for text in ["", "next week", "2026/03/12", "2026-3-2", "  "]:
+            with self.subTest(text=text):
+                with self.assertRaises(InvalidDate):
+                    parse_due(text, TODAY)
+
+
+if __name__ == "__main__":
+    unittest.main()
