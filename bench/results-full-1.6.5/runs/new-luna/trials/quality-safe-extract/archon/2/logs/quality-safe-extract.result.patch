diff --git a/safe_extract.py b/safe_extract.py
index 0007027..38722de 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,74 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    paths = []
+    seen = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        if not isinstance(name, str) or not isinstance(data, bytes):
+            raise ValueError("entry names must be strings and data must be bytes")
+        if (not name or name.startswith("/") or "\\" in name or ":" in name
+                or "\0" in name):
+            raise ValueError("invalid path name")
+        parts = name.split("/")
+        if any(part in ("", ".", "..") for part in parts):
+            raise ValueError("invalid path component")
+        if name in seen:
+            raise ValueError("duplicate path")
+        if any("/".join(parts[:i]) in seen for i in range(1, len(parts))):
+            raise ValueError("file/directory collision")
+        if any(existing.startswith(name + "/") for existing in seen):
+            raise ValueError("file/directory collision")
+        seen.add(name)
+        paths.append((name, parts, data))
+
+    try:
+        root_path = Path(root)
+        root_mode = os.lstat(root_path).st_mode
+    except (FileNotFoundError, NotADirectoryError, TypeError, ValueError):
+        raise ValueError("root must be an existing directory") from None
+    if not stat.S_ISDIR(root_mode):
+        raise ValueError("root must be a real directory")
+
+    # Inspect every existing component before any write. lstat detects dangling
+    # symlinks as well as links whose targets happen to be inside the root.
+    missing = set()
+    for name, parts, _data in paths:
+        current = root_path
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = os.lstat(current).st_mode
+            except FileNotFoundError:
+                missing.add(current)
+                continue
+            except OSError:
+                raise
+            if stat.S_ISLNK(mode):
+                raise ValueError("path contains a symlink")
+            if index < len(parts) - 1 and not stat.S_ISDIR(mode):
+                raise ValueError("path component is not a directory")
+            if index == len(parts) - 1:
+                raise ValueError("target already exists")
+
+    for name, parts, data in paths:
+        parent = root_path
+        for part in parts[:-1]:
+            parent = parent / part
+            if parent in missing:
+                parent.mkdir()
+        target = parent / parts[-1]
+        with target.open("xb") as output:
+            output.write(data)
+
+    return [name for name, _parts, _data in paths]
diff --git a/test_safe_extract.py b/test_safe_extract.py
