-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
+
+Input is `date,account,amount_cents,currency`. The legacy 3-column form
+`date,account,amount_cents` is read as USD.
 """
 
 import csv
+import re
 import sys
 
+LEGACY_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
+
+
+class MalformedCurrency(ValueError):
+    pass
+
+
+def currency_of(row, has_currency_column):
+    """Return the row's ISO 4217 currency code, or USD for legacy input."""
+    if not has_currency_column:
+        return LEGACY_CURRENCY
+    code = row["currency"]
+    if not isinstance(code, str) or not CURRENCY_PATTERN.fullmatch(code):
+        raise MalformedCurrency(f"malformed currency code {code!r}")
+    return code
+
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+def totals(rows, has_currency_column):
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
     for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+        key = (row["account"], currency_of(row, has_currency_column))
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    reader = csv.DictReader(sys.stdin)
+    has_currency_column = "currency" in (reader.fieldnames or [])
+    try:
+        result = totals(reader, has_currency_column)
+    except MalformedCurrency as error:
+        sys.stderr.write(f"reports: {error}\n")
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
