+class LedgerConcurrency(unittest.TestCase):
+    def run_threads(self, target, count):
+        threads = [threading.Thread(target=target) for _ in range(count)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def ping_pong():
+            for _ in range(500):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        threads = [threading.Thread(target=ping_pong) for _ in range(4)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=60)
+            self.assertFalse(thread.is_alive(), "possible deadlock")
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_concurrent_transfers_never_lose_money(self):
+        total = 3000
+        ledger = Ledger({"a": total, "b": 0})
+        observed = []
+
+        def mover():
+            for _ in range(1000):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+                observed.append(sum(ledger.snapshot().values()))
+
+        self.run_threads(mover, 3)
+        self.assertTrue(all(value == total for value in observed))
+        self.assertEqual(sum(ledger.snapshot().values()), total)
+
+    def test_no_overdraft_under_contention(self):
+        ledger = Ledger({"a": 100, "b": 0})
+        successes = []
+
+        def drain():
+            wins = 0
+            for _ in range(200):
+                if ledger.transfer("a", "b", 1):
+                    wins += 1
+            successes.append(wins)
+
+        self.run_threads(drain, 4)
+        self.assertEqual(sum(successes), 100)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 100})
 
 
 class LedgerBasics(unittest.TestCase):
