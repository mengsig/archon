 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _check_root(root)
+    plans = _plan_entries(entries, root_path)
+    for target, data in plans:
+        _write_file(target, data)
+    return [name for name, _ in entries]
+
+
+def _check_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty str or pathlib.Path: {root!r}")
+    root_path = Path(root)
+    try:
+        status = os.lstat(root_path)
+    except FileNotFoundError as exc:
+        raise ValueError(f"root does not exist: {root_path}") from exc
+    except NotADirectoryError as exc:
+        raise ValueError(f"root has a non-directory ancestor: {root_path}") from exc
+    if stat.S_ISLNK(status.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not stat.S_ISDIR(status.st_mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _plan_entries(entries, root):
+    names = set()
+    checked = []
+    for entry in entries:
+        name, data = _check_entry(entry)
+        if name in names:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        names.add(name)
+        checked.append((name, data))
+    _check_batch_collisions(names)
+    return [(_check_target(root, name), data) for name, data in checked]
+
+
+def _check_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple: {type(entry).__name__}")
+    name, data = entry
+    _check_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name, data
+
+
+def _check_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be a str, not {type(name).__name__}")
+    if name.startswith("/"):
+        raise ValueError(f"name must be relative: {name!r}")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name cannot be encoded for the filesystem: {name!r}") from exc
+
+
+def _check_batch_collisions(names):
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in names:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in the batch")
+
+
+def _check_target(root, name):
+    parts = name.split("/")
+    assert parts[-1], "validated names never end in '/'"
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        status = _lstat_or_none(current)
+        if status is None:
+            continue
+        if stat.S_ISLNK(status.st_mode):
+            raise ValueError(f"path component is a symlink: {current}")
+        if not stat.S_ISDIR(status.st_mode):
+            raise ValueError(f"path component is not a directory: {current}")
+    target = root / name
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"target already exists: {target}")
+    return target
+
+
+def _write_file(target, data):
+    assert isinstance(data, bytes), "data is validated before any write"
+    target.parent.mkdir(parents=True, exist_ok=True)
+    assert target.parent.is_dir(), "parent must be a directory before writing"
+    with open(target, "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
