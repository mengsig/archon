@@ -0,0 +1,32 @@
+import unittest
+from datetime import date
+
+from tasktracker.dates import InvalidDate, parse_due
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+
+class DueDateTests(unittest.TestCase):
+    def test_valid_forms_and_whitespace(self):
+        today = date(2026, 3, 10)
+        self.assertEqual(parse_due(" TODAY ", today), today)
+        self.assertEqual(parse_due("Tomorrow", today), date(2026, 3, 11))
+        self.assertEqual(parse_due("+0D", today), today)
+        self.assertEqual(parse_due("+5d", today), date(2026, 3, 15))
+        self.assertEqual(parse_due("2024-02-29", today), date(2024, 2, 29))
+
+    def test_invalid_dates_and_forms(self):
+        for value in ("2026-02-30", "2025-02-29", "2026-04-31", "2026-13-01", "2026-00-10", "-3d", "3d", "someday"):
+            with self.subTest(value=value), self.assertRaises(InvalidDate) as raised:
+                parse_due(value, date(2026, 3, 10))
+            self.assertIn(value, str(raised.exception))
+
+
+class CsvTests(unittest.TestCase):
+    def test_rfc4180_escaping_and_crlf(self):
+        tasks = [Task(1, 'comma, quote " and\nline', ["a", "b"], due=date(2026, 4, 1)), Task(2, "plain")]
+        self.assertEqual(to_csv(tasks), 'id,title,tags,status,due\r\n1,"comma, quote "" and\nline",a;b,open,2026-04-01\r\n2,plain,,open,\r\n')
+
+    def test_quotes_carriage_return_and_unquoted_plain_fields(self):
+        task = Task(7, "say \"hi\"", ["x\ry"])
+        self.assertEqual(to_csv([task]), 'id,title,tags,status,due\r\n7,"say ""hi""","x\ry",open,\r\n')
