diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..c22f4db 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,52 @@
+import re
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+_TERM = re.compile(r'(?:[^\s"]|"[^"]*")+')
+
+
+class QueryError(ValueError):
+    pass
+
+
+def parse_query(query):
+    """Return (field, value) pairs; field is None for bare words and phrases."""
+    assert isinstance(query, str), "query must be a string"
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    terms = []
+    for match in _TERM.finditer(query):
+        raw = match.group(0)
+        if raw.startswith('"') or ":" not in raw:
+            terms.append((None, raw.replace('"', "").lower()))
+            continue
+        field, _, value = raw.replace('"', "").partition(":")
+        terms.append(_field_term(field.lower(), value.lower()))
+    return terms
+
+
+def _field_term(field, value):
+    if not value:
+        raise QueryError(f"{field}: needs a value")
+    if field == "tag":
+        return ("tag", value)
+    if field == "status":
+        if value not in STATUSES:
+            raise QueryError(f"unknown status: {value!r}")
+        return ("status", value)
+    raise QueryError(f"unknown field: {field!r}")
+
+
+def _matches(task, term):
+    field, value = term
+    if field is None:
+        return value in task.title.lower()
+    if field == "tag":
+        return any(tag.lower() == value for tag in task.tags)
+    return task.status == value
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = parse_query(query)
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
