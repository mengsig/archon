+++ b/tests/test_undo.py
@@ -0,0 +1,87 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task_and_ids_are_not_reused(self):
+        store = TaskStore()
+        first = store.add("one")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        second = store.add("two")
+        self.assertGreater(second.id, first.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("one")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_complete_keeps_task_done_if_it_already_was(self):
+        store = TaskStore()
+        task = store.add("one")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+
+    def test_undo_delete_restores_same_task_and_id(self):
+        store = TaskStore()
+        task = store.add("one", tags=["t"], due=date(2026, 5, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertIs(restored, task)
+        self.assertEqual((restored.title, restored.tags, restored.due), ("one", ["t"], date(2026, 5, 1)))
+        self.assertEqual(restored.status, DONE)
+
+    def test_undo_walks_back_across_kinds_lifo(self):
+        store = TaskStore()
+        task = store.add("one")
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(42)
+        with self.assertRaises(UnknownTask):
+            store.delete(42)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operation_after_add_does_not_shadow_add(self):
+        store = TaskStore()
+        task = store.add("one")
+        with self.assertRaises(UnknownTask):
+            store.complete(task.id + 1)
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_returns_affected_task(self):
+        store = TaskStore()
+        task = store.add("one")
+        self.assertIs(store.undo(), task)
+
+
+if __name__ == "__main__":
+    unittest.main()
