@@ -24,6 +24,67 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20(self):
+        res = get("/items")
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(1, 21)))
+        self.assertEqual(res["body"]["next_cursor"], "20")
+
+    def test_paging_follows_next_cursor_to_the_end(self):
+        seen, cursor, pages = [], None, 0
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            seen += [item["id"] for item in body["items"]]
+            pages += 1
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, list(range(1, 58)))
+        self.assertEqual(pages, 6)
+
+    def test_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="10", cursor="50")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(51, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_the_end_is_empty_page(self):
+        body = get("/items", cursor="57")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds_are_inclusive(self):
+        one = get("/items", limit="1")["body"]
+        hundred = get("/items", limit="100")["body"]
+        self.assertEqual(len(one["items"]), 1)
+        self.assertEqual(len(hundred["items"]), 57)
+        self.assertIsNone(hundred["next_cursor"])
+
+    def test_invalid_limit_is_400(self):
+        for raw in ["0", "101", "-1", "1.5", "abc", "", " 5"]:
+            res = get("/items", limit=raw)
+            self.assertEqual(res["status"], 400, raw)
+            self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ["abc", "", "-3", "2.0", "9" * 5000]:
+            res = get("/items", cursor=raw)
+            self.assertEqual(res["status"], 400, raw[:20])
+            self.assertEqual(res["body"], {"error": "cursor is invalid"})
+
+    def test_oversized_limit_is_400_not_a_crash(self):
+        res = get("/items", limit="1" * 5000)
+        self.assertEqual(res["status"], 400)
+        self.assertIn("limit", res["body"]["error"])
+
+    def test_limit_19_pages_fill_exactly(self):
+        first = get("/items", limit="19")["body"]
+        second = get("/items", limit="19", cursor=first["next_cursor"])["body"]
+        third = get("/items", limit="19", cursor=second["next_cursor"])["body"]
+        self.assertEqual(len(first["items"]), 19)
+        self.assertEqual(len(second["items"]), 19)
+        self.assertEqual(len(third["items"]), 19)
+        self.assertIsNone(third["next_cursor"])
+
 
