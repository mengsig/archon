@@ -33,5 +33,93 @@ class BasicTest(unittest.TestCase):
         self.assertFalse(limiter.try_acquire("a"))
 
 
+class EdgeCaseTest(unittest.TestCase):
+    def test_invalid_bucket_parameters_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_request_size_raises(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+
+    def test_failed_acquire_consumes_nothing(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertFalse(bucket.try_acquire())
+        self.assertAlmostEqual(bucket.available(), 0.25)
+
+    def test_wait_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertAlmostEqual(bucket.wait_time(1), 0.5)
+        self.assertAlmostEqual(bucket.available(), 0.0)
+
+    def test_backwards_clock_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        clock.now = 2.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        clock.now = 6.0
+        self.assertAlmostEqual(bucket.available(), 6.0)
+
+    def test_invalid_keyed_parameters_raise(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+
+    def test_lru_eviction(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")  # "b" is now least recently used
+        limiter.try_acquire("c")  # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))  # evicted key starts full
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")  # evicts "b", not "a"
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_len_tracks_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("x")
+        limiter.wait_time("y")
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
