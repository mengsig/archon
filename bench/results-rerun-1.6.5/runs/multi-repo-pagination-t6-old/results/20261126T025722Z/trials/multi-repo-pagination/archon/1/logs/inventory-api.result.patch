@@ -25,5 +25,68 @@ class ApiTest(unittest.TestCase):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
 
+def all_ids(res):
+    return [item["id"] for item in res["body"]["items"]]
+
+
+class PaginationTest(unittest.TestCase):
+    def test_default_page_size_is_20(self):
+        res = get("/items")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(all_ids(res), list(range(1, 21)))
+        self.assertIsNotNone(res["body"]["next_cursor"])
+
+    def test_limit_bounds_are_accepted(self):
+        self.assertEqual(all_ids(get("/items", limit="1")), [1])
+        res = get("/items", limit="100")
+        self.assertEqual(res["status"], 200)
+        self.assertEqual(len(res["body"]["items"]), 57)
+
+    def test_invalid_limit_returns_400(self):
+        for raw in ["0", "101", "-1", "abc", "1.5", "", " 5"]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_walking_all_pages_yields_every_item_in_order(self):
+        ids, cursor, pages = [], None, 0
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            ids.extend(all_ids(res))
+            pages += 1
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(pages, 6)
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        cursor = get("/items", limit="50")["body"]["next_cursor"]
+        res = get("/items", limit="50", cursor=cursor)
+        self.assertEqual(all_ids(res), list(range(51, 58)))
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_exact_fit_has_null_cursor(self):
+        self.assertIsNone(get("/items", limit="57")["body"]["next_cursor"])
+
+    def test_cursor_resumes_after_its_item(self):
+        cursor = get("/items", limit="1")["body"]["next_cursor"]
+        self.assertEqual(all_ids(get("/items", limit="1", cursor=cursor)), [2])
+
+    def test_cursor_past_the_end_returns_empty_page(self):
+        res = get("/items", cursor=encode_cursor(57))
+        self.assertEqual(res["body"], {"items": [], "next_cursor": None})
+
+    def test_invalid_cursor_returns_400(self):
+        for raw in ["!!!", "abc", "", "eA==", "bm90IGEgbnVtYmVy"]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+
 if __name__ == "__main__":
     unittest.main()
