diff --git a/src/status.rs b/src/status.rs
new file mode 100644
index 0000000..b3f789b
--- /dev/null
+++ b/src/status.rs
@@ -0,0 +1,117 @@
+use std::fmt;
+use std::str::FromStr;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum OrderStatus {
+    Pending,
+    Paid,
+    Shipped,
+    Cancelled,
+}
+
+impl OrderStatus {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            Self::Pending => "pending",
+            Self::Paid => "paid",
+            Self::Shipped => "shipped",
+            Self::Cancelled => "cancelled",
+        }
+    }
+
+    pub fn can_transition_to(self, next: Self) -> bool {
+        matches!(
+            (self, next),
+            (Self::Pending, Self::Paid)
+                | (Self::Pending, Self::Cancelled)
+                | (Self::Paid, Self::Shipped)
+                | (Self::Paid, Self::Cancelled)
+        )
+    }
+}
+
+impl fmt::Display for OrderStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ParseStatusError {
+    input: String,
+}
+
+impl fmt::Display for ParseStatusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "unknown status {:?}", self.input)
+    }
+}
+
+impl std::error::Error for ParseStatusError {}
+
+impl FromStr for OrderStatus {
+    type Err = ParseStatusError;
+
+    fn from_str(input: &str) -> Result<Self, Self::Err> {
+        match input {
+            "pending" => Ok(Self::Pending),
+            "paid" => Ok(Self::Paid),
+            "shipped" => Ok(Self::Shipped),
+            "cancelled" => Ok(Self::Cancelled),
+            _ => Err(ParseStatusError {
+                input: input.to_string(),
+            }),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::OrderStatus;
+    use std::str::FromStr;
+
+    #[test]
+    fn parses_and_displays_each_status() {
+        for (name, status) in [
+            ("pending", OrderStatus::Pending),
+            ("paid", OrderStatus::Paid),
+            ("shipped", OrderStatus::Shipped),
+            ("cancelled", OrderStatus::Cancelled),
+        ] {
+            assert_eq!(OrderStatus::from_str(name).unwrap(), status);
+            assert_eq!(status.as_str(), name);
+            assert_eq!(status.to_string(), name);
+        }
+    }
+
+    #[test]
+    fn allows_only_the_defined_transitions() {
+        let statuses = [
+            OrderStatus::Pending,
+            OrderStatus::Paid,
+            OrderStatus::Shipped,
+            OrderStatus::Cancelled,
+        ];
+        for from in statuses {
+            for to in statuses {
+                assert_eq!(
+                    from.can_transition_to(to),
+                    matches!(
+                        (from, to),
+                        (OrderStatus::Pending, OrderStatus::Paid)
+                            | (OrderStatus::Pending, OrderStatus::Cancelled)
+                            | (OrderStatus::Paid, OrderStatus::Shipped)
+                            | (OrderStatus::Paid, OrderStatus::Cancelled)
+                    )
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn parse_error_names_rejected_input() {
+        let error = OrderStatus::from_str("lost").unwrap_err();
+        assert_eq!(error.to_string(), "unknown status \"lost\"");
+        let _: &dyn std::error::Error = &error;
+    }
+}
