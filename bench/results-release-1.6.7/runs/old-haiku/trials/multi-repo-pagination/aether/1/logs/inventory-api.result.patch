diff --git a/test_api.py b/test_api.py
index 55cd1fd..f92dc08 100644
--- a/test_api.py
+++ b/test_api.py
@@ -1,3 +1,4 @@
+import base64
 import unittest
 
 from api import handle
@@ -24,6 +25,51 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_page_has_twenty_items_and_a_cursor(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_following_cursors_yields_every_item_in_order(self):
+        ids = []
+        query = {"limit": "10"}
+        while True:
+            body = get("/items", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            if body["next_cursor"] is None:
+                break
+            query = {"limit": "10", "cursor": body["next_cursor"]}
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_exact_fill_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_is_exclusive_and_past_the_end_is_empty(self):
+        after_20 = get("/items", limit="1", cursor=encode_id(20))["body"]
+        self.assertEqual([item["id"] for item in after_20["items"]], [21])
+        after_57 = get("/items", cursor=encode_id(57))["body"]
+        self.assertEqual(after_57, {"items": [], "next_cursor": None})
+
+    def test_limit_bounds(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+        for bad in ["0", "101", "-1", "2.5", "abc", ""]:
+            res = get("/items", limit=bad)
+            self.assertEqual(res["status"], 400, bad)
+            self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_rejected(self):
+        for bad in ["!!!", "", "bm90LWEtbnVtYmVy", "x" * 5000]:
+            res = get("/items", cursor=bad)
+            self.assertEqual(res["status"], 400, bad)
+            self.assertIn("error", res["body"])
+
+
+def encode_id(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode()).decode().rstrip("=")
+
 
 if __name__ == "__main__":
     unittest.main()
