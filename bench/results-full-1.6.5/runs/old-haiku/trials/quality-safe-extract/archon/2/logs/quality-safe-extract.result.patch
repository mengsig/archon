+import os
 import tempfile
 import unittest
 from pathlib import Path
+from unittest import mock
 
+import safe_extract
 from safe_extract import extract
 
 
+def tree_snapshot(root):
+    return sorted(str(path.relative_to(root)) for path in Path(root).rglob("*"))
+
+
+class LyingStr(str):
+    def split(self, sep=None, maxsplit=-1):
+        return ["ok", ".."]
+
+    def __eq__(self, other):
+        return False
+
+    __hash__ = str.__hash__
+
+
+class LyingTuple(tuple):
+    def __len__(self):
+        return 2
+
+
+class LyingBytes(bytes):
+    pass
+
+
 class ExtractBasics(unittest.TestCase):
     def test_nested_files(self):
-        with tempfile.TemporaryDirectory(dir=".") as directory:
+        with tempfile.TemporaryDirectory() as directory:
             root = Path(directory)
             entries = [("docs/readme.txt", b"hello"), ("empty", b"")]
             self.assertEqual(extract(entries, root), ["docs/readme.txt", "empty"])
@@ -15,6 +41,247 @@ class ExtractBasics(unittest.TestCase):
             self.assertEqual((root / "empty").read_bytes(), b"")
 
     def test_empty_batch(self):
-        with tempfile.TemporaryDirectory(dir=".") as directory:
+        with tempfile.TemporaryDirectory() as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractTestCase(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.base = Path(self._tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assert_rejects_without_changes(self, entries, root=None):
+        before = tree_snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(tree_snapshot(self.base), before)
+
+    def assert_root_rejected_without_changes(self, root):
+        before = tree_snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], root)
+        self.assertEqual(tree_snapshot(self.base), before)
+
+
+class BatchShape(ExtractTestCase):
+    def test_non_list_batches_are_rejected(self):
+        for batch in [(), (("a", b"x"),), None, {}, "ab", b""]:
+            with self.subTest(batch=batch):
+                self.assert_rejects_without_changes(batch)
+
+    def test_generator_and_iterator_are_not_consumed(self):
+        generator = ((name, b"x") for name in ["a", "b"])
+        iterator = iter([("a", b"x")])
+        for batch in [generator, iterator]:
+            with self.subTest(batch=batch):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertEqual(tree_snapshot(self.base), ["root"])
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", "extra"),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", memoryview(b"x")),
+            ("a", None),
+            (b"a", b"x"),
+            (None, b"x"),
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                self.assert_rejects_without_changes([("ok", b"x"), entry])
+
+    def test_invalid_entry_later_in_batch_creates_nothing(self):
+        self.assert_rejects_without_changes([("first", b"1"), ("second", b"2"), ("bad", 3)])
+
+    def test_str_tuple_and_bytes_subclasses_are_rejected(self):
+        bad_batches = [
+            [("ok", b"x"), (LyingStr("x/y"), b"PWNED")],
+            [(LyingStr("a"), b"x")],
+            [LyingTuple(("a", b"x"))],
+            [("ok", LyingBytes(b"x"))],
+        ]
+        for batch in bad_batches:
+            with self.subTest(batch=batch):
+                self.assert_rejects_without_changes(batch)
+
+    def test_list_subclass_batch_is_rejected(self):
+        class SubList(list):
+            pass
+
+        self.assert_rejects_without_changes(SubList([("a", b"x")]))
+
+
+class NameRules(ExtractTestCase):
+    def test_invalid_names_are_rejected(self):
+        bad_names = [
+            "",
+            "/abs",
+            "a\\b",
+            "C:x",
+            "a:b",
+            "a\x00b",
+            "a//b",
+            "a/",
+            "./a",
+            "a/.",
+            "a/../b",
+            "..",
+            ".",
+            "\udcff",
+        ]
+        for name in bad_names:
+            with self.subTest(name=name):
+                self.assert_rejects_without_changes([("ok", b"x"), (name, b"y")])
+
+    def test_names_are_not_normalized_or_decoded(self):
+        names = ["100%25.txt", "%2e%2e", "dir with space/é.txt"]
+        entries = [(name, b"data") for name in names]
+        self.assertEqual(extract(entries, self.root), names)
+        self.assertEqual((self.root / "100%25.txt").read_bytes(), b"data")
+        self.assertTrue((self.root / "%2e%2e").is_file())
+
+    def test_duplicate_names_are_rejected(self):
+        self.assert_rejects_without_changes([("a", b"1"), ("a", b"2")])
+
+    def test_file_directory_collisions_are_rejected_in_either_order(self):
+        collisions = [
+            [("a", b"1"), ("a/b", b"2")],
+            [("a/b", b"2"), ("a", b"1")],
+            [("a/b/c", b"1"), ("a/b", b"2")],
+            [("x/y", b"1"), ("x", b"2"), ("z", b"3")],
+        ]
+        for entries in collisions:
+            with self.subTest(entries=entries):
+                self.assert_rejects_without_changes(entries)
+
+    def test_sibling_names_sharing_a_prefix_are_allowed(self):
+        entries = [("a", b"1"), ("ab", b"2"), ("a2/b", b"3")]
+        self.assertEqual(extract(entries, self.root), ["a", "ab", "a2/b"])
+
