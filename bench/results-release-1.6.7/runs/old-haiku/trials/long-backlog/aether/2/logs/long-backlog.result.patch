+from .models import DONE, OPEN
+
+HEADER = ["id", "title", "tags", "status", "due"]
+NEEDS_QUOTES = (",", '"', "\r", "\n")
+
+
 def to_csv(tasks):
-    lines = ["id,title,tags,status,due"]
-    for task in tasks:
-        due = task.due.isoformat() if task.due else ""
-        lines.append(f"{task.id},{task.title},{';'.join(task.tags)},{task.status},{due}")
-    return "\n".join(lines) + "\n"
+    rows = [HEADER] + [_task_fields(task) for task in tasks]
+    return "".join(_csv_line(fields) + "\r\n" for fields in rows)
+
+
+def _task_fields(task):
+    assert isinstance(task.title, str), f"title must be a string, got {task.title!r}"
+    assert not isinstance(task.tags, str), "tags must be a list, not a string"
+    assert task.status in (OPEN, DONE), f"unknown status {task.status!r}"
+    due = task.due.isoformat() if task.due is not None else ""
