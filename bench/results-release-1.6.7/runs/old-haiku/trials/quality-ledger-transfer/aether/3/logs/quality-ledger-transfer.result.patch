+class LedgerConcurrency(unittest.TestCase):
+    ROUNDS = 2000
+    JOIN_TIMEOUT = 30
+
+    def _run_all(self, targets):
+        threads = [threading.Thread(target=target) for target in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.JOIN_TIMEOUT)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "deadlock")
+
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def a_to_b():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        self._run_all([a_to_b, b_to_a])
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 0})
+        seen_totals = set()
+
+        def mover():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def reader():
+            for _ in range(self.ROUNDS):
+                seen_totals.add(sum(ledger.snapshot().values()))
+
+        self._run_all([mover, reader])
+        self.assertEqual(seen_totals, {1000})
+
+    def test_concurrent_transfers_into_one_account_respect_max(self):
+        # Only 10 units of room, but 2000 attempts: exactly 10 must succeed.
+        ledger = Ledger({"a": MAX_BALANCE - 10, "b": 1000, "c": 1000})
+
+        def pour(name):
+            def run():
+                for _ in range(self.ROUNDS):
+                    ledger.transfer(name, "a", 1)
+            return run
+
+        self._run_all([pour("b"), pour("c")])
+        snap = ledger.snapshot()
+        self.assertEqual(snap["a"], MAX_BALANCE)
+        self.assertEqual(snap["b"] + snap["c"], 1990)
+
+
+if __name__ == "__main__":
+    unittest.main()
