+class LedgerTransferRules(unittest.TestCase):
+    def test_full_balance_transfer_succeeds(self):
+        ledger = Ledger({"a": 3, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 3), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 3})
+
+    def test_total_is_preserved(self):
+        ledger = Ledger({"a": 7, "b": 4, "c": 9})
+        ledger.transfer("a", "b", 2)
+        ledger.transfer("c", "a", 9)
+        ledger.transfer("b", "c", 1)
