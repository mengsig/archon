+class LedgerBehavior(unittest.TestCase):
+    def test_failures_are_atomic(self):
+        ledger = Ledger({"a": 3, "b": MAX_BALANCE})
+        initial = ledger.snapshot()
+        self.assertFalse(ledger.transfer("a", "b", 4))
+        self.assertFalse(ledger.transfer("a", "b", 1))
+        self.assertEqual(ledger.snapshot(), initial)
+
+    def test_same_account_requires_funds_and_never_changes_balance(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 2})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertFalse(ledger.transfer("b", "b", 3))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE, "b": 2})
+
+    def test_exact_balances_and_total_preservation(self):
+        ledger = Ledger({"a": 20, "b": 5, "c": 0})
+        total = sum(ledger.snapshot().values())
+        self.assertTrue(ledger.transfer("a", "c", 7))
+        self.assertTrue(ledger.transfer("b", "a", 2))
+        self.assertEqual(ledger.snapshot(), {"a": 15, "b": 3, "c": 7})
+        self.assertEqual(sum(ledger.snapshot().values()), total)
+
+    def test_snapshot_isolation(self):
+        ledger = Ledger({"a": 2, "b": 3})
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 100
+        snapshot["new"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": 3})
+
+
+class LedgerConcurrency(unittest.TestCase):
+    def test_opposite_transfers_complete_without_deadlock(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = threading.Barrier(3)
+        errors = []
+
+        def worker(source, destination):
+            try:
+                start.wait()
+                for _ in range(500):
+                    ledger.transfer(source, destination, 1)
+            except BaseException as error:
+                errors.append(error)
+
+        threads = [threading.Thread(target=worker, args=pair) for pair in (("a", "b"), ("b", "a"))]
+        for thread in threads:
+            thread.start()
+        start.wait()
+        for thread in threads:
+            thread.join(3)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "opposite transfers deadlocked")
+        self.assertEqual(errors, [])
+        final = ledger.snapshot()
+        self.assertEqual(sum(final.values()), 200)
+        self.assertTrue(all(0 <= balance <= MAX_BALANCE for balance in final.values()))
+
+    def test_snapshots_never_observe_half_transfer(self):
+        ledger = Ledger({"a": 100, "b": 100})
+        start = threading.Barrier(3)
+        observed = []
+
+        def transfer_back_and_forth():
+            start.wait()
+            for _ in range(1000):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def take_snapshots():
+            start.wait()
+            for _ in range(1000):
+                state = ledger.snapshot()
+                observed.append((state["a"], state["b"]))
+
+        threads = [threading.Thread(target=transfer_back_and_forth),
+                   threading.Thread(target=take_snapshots)]
+        for thread in threads:
+            thread.start()
+        start.wait()
+        for thread in threads:
+            thread.join(3)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "concurrent calls deadlocked")
+        self.assertTrue(observed)
+        self.assertTrue(all(a + b == 200 for a, b in observed))
