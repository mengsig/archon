 from data import ITEMS
 
 
@@ -21,8 +24,40 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    try:
+        limit = int(query.get("limit", 20))
+        if not 1 <= limit <= 100:
+            raise ValueError
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    after_id = None
+    if cursor is not None:
+        try:
+            encoded = cursor.encode("ascii")
+            decoded = base64.b64decode(
+                encoded + b"=" * (-len(encoded) % 4), altchars=b"-_", validate=True
+            ).decode("ascii")
+            after_id = int(decoded)
+            if str(after_id) != decoded or _encode_cursor(after_id) != cursor:
+                raise ValueError
+        except (AttributeError, UnicodeError, ValueError, binascii.Error):
+            return _error(400, "invalid cursor")
+
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    if after_id is not None:
+        if after_id not in {item["id"] for item in ordered}:
+            return _error(400, "invalid cursor")
+        ordered = [item for item in ordered if item["id"] > after_id]
+
+    items = ordered[:limit]
+    next_cursor = _encode_cursor(items[-1]["id"]) if len(ordered) > limit else None
+    return {"status": 200, "body": {"items": items, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii").rstrip("=")
 
 
