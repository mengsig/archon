index 0007027..c8d45a4 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,117 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = frozenset("\\:\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Validate the whole batch, then create the files under root."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+    root_path = _validate_root(root)
+    parts_per_entry = _validate_batch(entries)
+    for parts in parts_per_entry:
+        _check_target_absent(root_path, parts)
+    for (_, data), parts in zip(entries, parts_per_entry):
+        _write_file(root_path, parts, data)
+    return [name for name, _ in entries]
+
+
+def _validate_root(root):
+    if isinstance(root, str):
+        if not root:
+            raise ValueError("root must not be an empty string")
+        root_path = Path(root)
+    elif isinstance(root, Path):
+        root_path = root
+    else:
+        raise ValueError("root must be a str or pathlib.Path")
+    try:
+        mode = os.lstat(root_path).st_mode
+    except (FileNotFoundError, NotADirectoryError) as error:
+        raise ValueError(f"root does not exist: {root_path}") from error
+    if stat.S_ISLNK(mode):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not stat.S_ISDIR(mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _validate_batch(entries):
+    """Return the path components of each entry, rejecting any conflict."""
+    files = set()
+    dirs = set()
+    parts_per_entry = []
+    for entry in entries:
+        name, _ = _unpack_entry(entry)
+        parts = _split_name(name)
+        _check_no_conflict(name, parts, files, dirs)
+        files.add(name)
+        dirs.update("/".join(parts[:i]) for i in range(1, len(parts)))
+        parts_per_entry.append(parts)
+    assert len(parts_per_entry) == len(entries)
+    return parts_per_entry
+
+
+def _unpack_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError("entry name must be a str")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes: {name!r}")
+    return name, data
+
+
+def _split_name(name):
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative: {name!r}")
+    if _FORBIDDEN_NAME_CHARS.intersection(name):
+        raise ValueError(f"entry name has a forbidden character: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"entry name has an invalid component: {name!r}")
+    return parts
+
+
+def _check_no_conflict(name, parts, files, dirs):
+    """Reject a duplicate, or a name that is a file and directory of the batch."""
+    if name in files:
+        raise ValueError(f"duplicate entry name: {name!r}")
+    if name in dirs:
+        raise ValueError(f"entry name is a directory of another entry: {name!r}")
+    for i in range(1, len(parts)):
+        prefix = "/".join(parts[:i])
+        if prefix in files:
+            raise ValueError(f"entry is inside file of another entry: {name!r}")
+
+
+def _check_target_absent(root, parts):
+    """Walk the existing part of the path below root; reject links and conflicts."""
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        try:
+            mode = os.lstat(current).st_mode
+        except FileNotFoundError:
+            return
+        if stat.S_ISLNK(mode):
+            raise ValueError(f"symlink below root: {current}")
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists: {current}")
+        if not stat.S_ISDIR(mode):
+            raise ValueError(f"ancestor is not a directory: {current}")
+
+
+def _write_file(root, parts, data):
+    assert parts and all(parts), "entry path components must be non-empty"
+    target = root.joinpath(*parts)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with open(target, "xb") as handle:
+        handle.write(data)
