 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +24,38 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after = _parse_cursor(query.get("cursor"))
+    if after is None:
+        return _error(400, "cursor is invalid")
+
+    remaining = sorted((item for item in ITEMS if item["id"] > after), key=lambda item: item["id"])
+    page = remaining[:limit]
+    assert len(page) <= limit, "page exceeds limit"
+    next_cursor = str(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_plain_digits(raw):
+        return None
+    limit = int(raw)
+    return limit if 1 <= limit <= MAX_LIMIT else None
+
+
+def _parse_cursor(raw):
+    # Item ids start at 1, so an absent cursor of 0 means "from the first item".
+    if raw is None:
+        return 0
+    return int(raw) if _is_plain_digits(raw) else None
+
+
+def _is_plain_digits(raw):
+    return raw.isascii() and raw.isdigit()
 
 
