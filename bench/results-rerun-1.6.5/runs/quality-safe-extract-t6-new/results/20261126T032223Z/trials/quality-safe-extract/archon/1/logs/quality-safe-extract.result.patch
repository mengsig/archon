+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(tmp.cleanup)
+        self.base = Path(tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertTreeEmpty(self, directory):
+        self.assertEqual(list(directory.iterdir()), [])
+
+
+class BatchShapeTests(TempRootCase):
+    def test_non_list_batches_are_rejected_untouched(self):
+        generator = ((name, b"x") for name in ["a"])
+        iterator = iter([("a", b"x")])
+        for batch in [(("a", b"x"),), iterator, generator, None, ()]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertTreeEmpty(self.root)
+
+    def test_empty_non_list_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract(tuple(), self.root)
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", b"y"),
+            (b"a", b"x"),
+            (None, b"x"),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", None),
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b"1"), entry], self.root)
+                self.assertTreeEmpty(self.root)
+
+    def test_results_keep_input_order(self):
+        entries = [("z", b"1"), ("a/b", b"2"), ("m", b"3")]
+        self.assertEqual(extract(entries, self.root), ["z", "a/b", "m"])
+
+
