+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_empty_ledger_and_input_copy(self):
+        initial = {"a": 5}
+        ledger = Ledger(initial)
+        initial["a"] = 0
+        initial["b"] = 10
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_invalid_construction(self):
+        invalid = [
+            None,
+            [],
+            {"": 0},
+            {1: 0},
+            {"a": -1},
+            {"a": MAX_BALANCE + 1},
+            {"a": True},
+            {"a": 1.0},
+        ]
+        for balances in invalid:
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+    def test_invalid_amount_precedes_account_lookup(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also-missing", amount)
+
+    def test_unknown_accounts_raise_key_error_without_mutation(self):
+        ledger = Ledger({"a": 3})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+        self.assertEqual(ledger.snapshot(), {"a": 3})
+
+    def test_overflow_is_atomic_and_exact_ceiling_is_allowed(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE - 1})
+        self.assertFalse(ledger.transfer("a", "b", 2))
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": MAX_BALANCE - 1})
+        self.assertTrue(ledger.transfer("a", "b", 1))
+        self.assertEqual(ledger.snapshot(), {"a": 1, "b": MAX_BALANCE})
+
+    def test_same_account_at_ceiling_and_insufficient_balance(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        with self.assertRaises(ValueError):
+            ledger.transfer("a", "a", MAX_BALANCE + 1)
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
+
+    def test_snapshot_is_a_copy(self):
+        ledger = Ledger({"a": 1})
+        result = ledger.snapshot()
+        result["a"] = 100
+        result["b"] = 2
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
+    def test_concurrent_transfers_preserve_total_and_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def move(source, destination):
+            for _ in range(500):
+                self.assertTrue(ledger.transfer(source, destination, 1))
+
+        with ThreadPoolExecutor(max_workers=2) as pool:
+            first = pool.submit(move, "a", "b")
+            second = pool.submit(move, "b", "a")
+            first.result(timeout=5)
+            second.result(timeout=5)
+
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
