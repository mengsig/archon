@@ -24,6 +24,60 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_uses_default_limit(self):
+        body = get("/items")["body"]
+        ids = [item["id"] for item in body["items"]]
+        self.assertEqual(ids, list(range(1, 21)))
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_cursor_walk_returns_every_item_once_in_order(self):
+        for limit in (1, 7, 20, 57, 100):
+            with self.subTest(limit=limit):
+                self.assertEqual(walk_ids(limit), list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", cursor="50")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(51, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_exactly_fills_limit_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_end_is_empty_page(self):
+        body = get("/items", cursor="999")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_invalid_limit_is_400(self):
+        for raw in ("0", "101", "-1", "abc", "", "1.5", " 5", "+5", "٢", "9" * 5000):
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for raw in ("abc", "", "-3", "1.0", "12 ", "9" * 5000, "9" * 19):
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+
+def walk_ids(limit):
+    """Follow next_cursor from the first page until it is null."""
+    ids = []
+    cursor = None
+    while True:
+        query = {"limit": str(limit)}
+        if cursor is not None:
+            query["cursor"] = cursor
+        body = get("/items", **query)["body"]
+        ids.extend(item["id"] for item in body["items"])
+        cursor = body["next_cursor"]
+        if cursor is None:
+            return ids
+
 
 if __name__ == "__main__":
     unittest.main()
