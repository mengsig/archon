@@ -0,0 +1,51 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER_LINE = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_input_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER_LINE)
+
+    def test_every_line_ends_with_crlf(self):
+        tasks = [Task(1, "a", ["x"], due=date(2026, 4, 1)), Task(2, "b")]
+        self.assertEqual(to_csv(tasks), HEADER_LINE + "1,a,x,open,2026-04-01\r\n2,b,,open,\r\n")
+
+    def test_rows_keep_input_order(self):
+        tasks = [Task(3, "third"), Task(1, "first")]
+        self.assertEqual(to_csv(tasks), HEADER_LINE + "3,third,,open,\r\n1,first,,open,\r\n")
+
+    def test_plain_fields_are_not_quoted(self):
+        tasks = [Task(7, "plain", ["a", "b"], status="done", due=date(2026, 1, 2))]
+        self.assertEqual(to_csv(tasks), HEADER_LINE + "7,plain,a;b,done,2026-01-02\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "buy milk, eggs")]), HEADER_LINE + '1,"buy milk, eggs",,open,\r\n')
+
+    def test_title_with_double_quote_is_quoted_and_doubled(self):
+        self.assertEqual(to_csv([Task(1, 'say "hi"')]), HEADER_LINE + '1,"say ""hi""",,open,\r\n')
+
+    def test_title_with_newline_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "line1\nline2")]), HEADER_LINE + '1,"line1\nline2",,open,\r\n')
+
+    def test_title_with_carriage_return_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "a\rb")]), HEADER_LINE + '1,"a\rb",,open,\r\n')
+
+    def test_tags_with_comma_are_quoted_as_one_field(self):
+        tasks = [Task(1, "t", ["work, urgent", "home"])]
+        self.assertEqual(to_csv(tasks), HEADER_LINE + '1,t,"work, urgent;home",open,\r\n')
+
+    def test_quoted_output_parses_back_with_csv_module(self):
+        title = 'a, "quoted"\nmultiline'
+        rows = list(csv.reader(io.StringIO(to_csv([Task(5, title, ["t"])]), newline="")))
+        self.assertEqual(rows, [["id", "title", "tags", "status", "due"], ["5", title, "t", "open", ""]])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..46343a3
