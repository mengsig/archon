+class LedgerConcurrency(unittest.TestCase):
+    THREADS = 8
+    ROUNDS = 500
+
+    def _run_all(self, workers):
+        threads = [threading.Thread(target=worker) for worker in workers]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=60)
+            self.assertFalse(thread.is_alive(), "worker did not finish; possible deadlock")
+
+    def test_opposite_transfers_do_not_deadlock_and_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def forward():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def backward():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        workers = [forward, backward] * (self.THREADS // 2)
+        self._run_all(workers)
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 500, "b": 0})
+        observed_totals = []
+
+        def mover():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def observer():
+            for _ in range(self.ROUNDS):
+                observed_totals.append(sum(ledger.snapshot().values()))
+
+        self._run_all([mover] * (self.THREADS // 2) + [observer] * (self.THREADS // 2))
+        self.assertTrue(all(total == 500 for total in observed_totals))
+        self.assertEqual(sum(ledger.snapshot().values()), 500)
+
+
+if __name__ == "__main__":
+    unittest.main()
