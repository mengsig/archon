+HEADER = ["id", "title", "tags", "status", "due"]
+NEEDS_QUOTES = frozenset(',"\r\n')
+
+
+def _escape(value):
+    """RFC 4180 form of one field: quoted only when it must be."""
+    text = str(value)
+    if not NEEDS_QUOTES.intersection(text):
+        return text
+    return '"' + text.replace('"', '""') + '"'
+
+
+def _row(fields):
+    return ",".join(_escape(field) for field in fields) + "\r\n"
