-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
 """
 
 import csv
+import re
 import sys
 
+CURRENCY_FIELD = "currency"
+DEFAULT_CURRENCY = "USD"
+CURRENCY_RE = re.compile(r"[A-Z]{3}")
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+
+class MalformedCurrency(ValueError):
+    pass
+
+
+def row_currency(row, has_currency, line_number):
+    """Currency of one CSV row; rows without a currency column are USD."""
+    if not has_currency:
+        return DEFAULT_CURRENCY
+    code = row[CURRENCY_FIELD]
+    if code is None or not CURRENCY_RE.fullmatch(code):
+        raise MalformedCurrency(
+            f"line {line_number}: malformed currency code {code!r}"
+        )
+    return code
+
+
+def totals(stdin):
+    """{(account, currency): total_cents} from the CSV on stdin."""
+    reader = csv.DictReader(stdin)
+    has_currency = CURRENCY_FIELD in (reader.fieldnames or [])
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for row in reader:
+        currency = row_currency(row, has_currency, reader.line_num)
+        key = (row["account"], currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(sys.stdin)
+    except MalformedCurrency as error:
+        print(f"error: {error}", file=sys.stderr)
+        sys.exit(2)
+    sys.stdout.write(render(result))
 
 
 if __name__ == "__main__":
