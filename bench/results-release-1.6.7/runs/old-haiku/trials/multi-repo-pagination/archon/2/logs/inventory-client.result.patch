+// Serves ITEMS in pages of one; `pages[i]` gives the next_cursor of page i.
+function pagedTransport(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    const index = request.query.cursor === undefined ? 0 : Number(request.query.cursor.slice(1));
+    const page = pages[index];
+    if (page.status !== undefined) return { status: page.status, body: page.body };
+    const body = { items: [ITEMS[index]] };
+    if (page.next !== undefined) body.next_cursor = page.next;
+    return { status: 200, body };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const { transport, seen } = pagedTransport([{ next: 'c1' }, { next: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 2);
+});
+
+test('sends no cursor on the first request and passes the cursor back unchanged', async () => {
+  const { transport, seen } = pagedTransport([{ next: 'c1' }, { next: null }]);
+  await listItems(transport);
+  assert.deepEqual(seen[0].query, {});
+  assert.deepEqual(seen[1].query, { cursor: 'c1' });
+  assert.equal(seen[0].path, '/items');
+  assert.equal(seen[1].path, '/items');
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const { transport, seen } = pagedTransport([{ next: 'c1' }, {}]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 2);
+});
+
+test('stops at the first page whose next_cursor is null', async () => {
+  const { transport, seen } = pagedTransport([{ next: null }, { next: 'c1' }]);
+  assert.deepEqual(await listItems(transport), [ITEMS[0]]);
+  assert.equal(seen.length, 1);
+});
+
+test('rejects when a later page fails', async () => {
+  const { transport } = pagedTransport([{ next: 'c1' }, { status: 400, body: { error: 'invalid cursor' } }]);
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('rejects a page without an items array', async () => {
+  const transport = async () => ({ status: 200, body: null });
+  await assert.rejects(listItems(transport), /no items array/);
+});
+
+test('rejects a page whose next_cursor is not a string', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 7 } });
+  await assert.rejects(listItems(transport), /non-string next_cursor/);
+});
+
