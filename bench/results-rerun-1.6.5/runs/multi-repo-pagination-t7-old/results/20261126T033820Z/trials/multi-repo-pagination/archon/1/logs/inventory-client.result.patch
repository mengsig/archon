+// Serves `pages` in order: page i is returned for the request carrying cursor i-1.
+function paginated(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request.query);
+    const index = seen.length - 1;
+    if (request.path !== '/items' || index >= pages.length) {
+      return { status: 404, body: { error: 'not found' } };
+    }
+    return { status: 200, body: pages[index] };
+  };
+  return { transport, seen };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages, in order', async () => {
+  const { transport, seen } = paginated([
+    { items: [ITEMS[0]], next_cursor: 'c1' },
+    { items: [ITEMS[1]], next_cursor: 'c2' },
+    { items: [{ id: 3, sku: 'SKU-0003', qty: 0 }], next_cursor: null },
+  ]);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seen, [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('single page with null next_cursor makes one request', async () => {
+  const { transport, seen } = paginated([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('absent next_cursor ends pagination after one request', async () => {
+  const { transport, seen } = paginated([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seen, [{}]);
+});
+
+test('passes the cursor back unchanged', async () => {
+  const cursor = 'opaque+/=value';
+  const { transport, seen } = paginated([
+    { items: [ITEMS[0]], next_cursor: cursor },
+    { items: [ITEMS[1]], next_cursor: null },
+  ]);
+  await listItems(transport);
+  assert.equal(seen[1].cursor, cursor);
+});
+
+test('rejects when a later page fails', async () => {
+  const transport = async (request) => (request.query.cursor
+    ? { status: 400, body: { error: 'invalid cursor' } }
+    : { status: 200, body: { items: ITEMS, next_cursor: 'c1' } });
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('rejects a repeated cursor instead of looping forever', async () => {
+  const transport = async () => ({ status: 200, body: { items: ITEMS, next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /repeated cursor/);
+});
