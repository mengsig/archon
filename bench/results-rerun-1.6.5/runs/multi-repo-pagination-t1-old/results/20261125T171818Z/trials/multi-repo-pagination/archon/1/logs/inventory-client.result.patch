+function pagedTransport(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    const cursor = request.query.cursor;
+    const page = pages.get(cursor);
+    if (!page) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const pages = new Map([
+    [undefined, { items: [ITEMS[0]], next_cursor: 'c1' }],
+    ['c1', { items: [ITEMS[1]], next_cursor: 'c2' }],
+    ['c2', { items: [], next_cursor: null }],
+  ]);
+  const { transport, seen } = pagedTransport(pages);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(
+    seen.map((request) => request.query),
+    [{}, { cursor: 'c1' }, { cursor: 'c2' }],
+  );
+});
+
+test('returns a single page when next_cursor is null', async () => {
+  const pages = new Map([[undefined, { items: ITEMS, next_cursor: null }]]);
+  const { transport, seen } = pagedTransport(pages);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const pages = new Map([[undefined, { items: ITEMS }]]);
+  const { transport, seen } = pagedTransport(pages);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('passes the cursor back unchanged and sends none first', async () => {
+  const opaque = 'a+/=b~ c%2F';
+  const pages = new Map([
+    [undefined, { items: [ITEMS[0]], next_cursor: opaque }],
+    [opaque, { items: [ITEMS[1]], next_cursor: null }],
+  ]);
+  const { transport, seen } = pagedTransport(pages);
+  await listItems(transport);
+  assert.equal(seen[0].path, '/items');
+  assert.equal('cursor' in seen[0].query, false);
+  assert.equal(seen[1].query.cursor, opaque);
+});
+
+test('rejects a server that repeats a cursor instead of looping', async () => {
+  const pages = new Map([
+    [undefined, { items: [ITEMS[0]], next_cursor: 'same' }],
+    ['same', { items: [ITEMS[1]], next_cursor: 'same' }],
+  ]);
+  const { transport } = pagedTransport(pages);
+  await assert.rejects(listItems(transport), /repeated cursor "same"/);
+});
+
+test('rejects a cycle across pages instead of looping', async () => {
+  const pages = new Map([
+    [undefined, { items: [ITEMS[0]], next_cursor: 'a' }],
+    ['a', { items: [ITEMS[1]], next_cursor: 'b' }],
+    ['b', { items: [], next_cursor: 'a' }],
+  ]);
+  const { transport, seen } = pagedTransport(pages);
+  await assert.rejects(listItems(transport), /repeated cursor "a"/);
+  assert.equal(seen.length, 3);
+});
+
