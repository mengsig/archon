diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..6682f63 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,41 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": (attempt, 1),
+        "elapsed_ms": (elapsed_ms, 0),
+        "max_attempts": (max_attempts, 1),
+        "budget_ms": (budget_ms, 0),
+        "base_ms": (base_ms, 0),
+        "cap_ms": (cap_ms, 0),
+    }
+    for name, (value, minimum) in values.items():
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    exponent = attempt - 1
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    elif base_ms >= cap_ms:
+        delay = cap_ms
+    else:
+        # Find the saturation exponent using integer bit lengths, avoiding a
+        # potentially enormous 2**exponent for large attempt values.
+        ratio_ceiling = (cap_ms + base_ms - 1) // base_ms
+        saturation_exponent = (ratio_ceiling - 1).bit_length()
+        if exponent >= saturation_exponent:
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms * (1 << exponent))
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..624c8a7 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,47 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_budget_requires_strictly_before_deadline(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100))
+
+    def test_zero_values_and_cap_relationship(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, base_ms=100, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=10), 10)
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=5), 5)
+
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=10, retry_after_ms=500), 500)
+        self.assertIsNone(
+            retry_delay(1, 500, budget_ms=1000, cap_ms=10,
+                        retry_after_ms=500))
+
+    def test_huge_attempt_saturates_without_building_huge_power(self):
+        self.assertEqual(retry_delay(10_000, 0, max_attempts=10_001), 400)
+
+    def test_validation_precedes_exhaustion(self):
+        invalid_options = (
+            {"elapsed_ms": True}, {"max_attempts": 1.0},
+            {"budget_ms": -1}, {"base_ms": False}, {"cap_ms": 1.5},
+            {"retry_after_ms": -1},
+        )
+        for options in invalid_options:
+            with self.subTest(options=options):
+                with self.assertRaises(ValueError):
+                    args = {"attempt": 4, "elapsed_ms": 0, **options}
+                    retry_delay(**args)
+
+    def test_all_numeric_arguments_reject_bool_and_float(self):
+        for name in ("attempt", "elapsed_ms", "max_attempts", "budget_ms",
+                     "base_ms", "cap_ms", "retry_after_ms"):
+            for bad in (True, 1.0):
+                with self.subTest(name=name, bad=bad):
+                    args = {"attempt": 1, "elapsed_ms": 0, name: bad}
+                    with self.assertRaises(ValueError):
+                        retry_delay(**args)
