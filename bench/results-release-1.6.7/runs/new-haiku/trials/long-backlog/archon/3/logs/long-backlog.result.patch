+++ b/tasktracker/search.py
@@ -1,2 +1,63 @@
+"""Search tasks with a small query language.
+
+Terms are separated by whitespace; double quotes group a phrase. Every term
+must match. A term containing quotes is a title phrase, not a field term.
+"""
+import re
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+TERM_PATTERN = re.compile(r'(?:[^\s"]|"[^"]*")+')
+
+
+class QueryError(ValueError):
+    """Raised for a malformed or unsupported search query."""
+
+
+def tokenize(query):
+    """Return the raw terms of a query, keeping quotes for the caller to read."""
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    terms = [match.group(0) for match in TERM_PATTERN.finditer(query)]
+    assert all(terms), "the term pattern never yields an empty term"
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Return the tasks matching every term of the query, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_matcher(term) for term in tokenize(query)]
+    return [task for task in tasks if all(matches(task) for matches in matchers)]
+
+
+def _matcher(term):
+    if '"' in term:
+        return _title_matcher(term.replace('"', ''))
+    if ":" not in term:
+        return _title_matcher(term)
+    field, value = term.split(":", 1)
+    if field.lower() == "tag":
+        return _tag_matcher(value)
+    if field.lower() == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown field {field!r} in term {term!r}")
+
+
+def _title_matcher(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_matcher(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_matcher(status):
+    wanted = status.lower()
+    if wanted not in STATUSES:
+        raise QueryError(f"unknown status {status!r}; expected one of {STATUSES}")
+    return lambda task: task.status == wanted
