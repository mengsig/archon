diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..3a48bae 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,42 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _check_int("attempt", attempt, minimum=1)
+    _check_int("max_attempts", max_attempts, minimum=1)
+    _check_int("elapsed_ms", elapsed_ms, minimum=0)
+    _check_int("budget_ms", budget_ms, minimum=0)
+    _check_int("base_ms", base_ms, minimum=0)
+    _check_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms * 2**shift >= 2**(bits(base_ms) - 1 + shift): saturate past cap
+    if base_ms.bit_length() - 1 + shift >= cap_ms.bit_length():
+        return cap_ms
+    backoff = min(cap_ms, base_ms << shift)
+    assert 0 <= backoff <= cap_ms
+    return backoff
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..12f214a 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,173 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, name, *args, **kwargs):
+        with self.assertRaisesRegex(ValueError, name):
+            retry_delay(*args, **kwargs)
+
+    def test_attempt_must_be_int_at_least_one(self):
+        self.assertInvalid("attempt", 0, 0)
+        self.assertInvalid("attempt", -1, 0)
+        self.assertInvalid("attempt", 1.0, 0)
+        self.assertInvalid("attempt", True, 0)
+        self.assertInvalid("attempt", "1", 0)
+        self.assertInvalid("attempt", None, 0)
+
+    def test_max_attempts_must_be_int_at_least_one(self):
+        self.assertInvalid("max_attempts", 1, 0, max_attempts=0)
+        self.assertInvalid("max_attempts", 1, 0, max_attempts=2.0)
+        self.assertInvalid("max_attempts", 1, 0, max_attempts=False)
+
+    def test_elapsed_must_be_non_negative_int(self):
+        self.assertInvalid("elapsed_ms", 1, -1)
+        self.assertInvalid("elapsed_ms", 1, 0.0)
+        self.assertInvalid("elapsed_ms", 1, True)
+        self.assertInvalid("elapsed_ms", 1, None)
+
+    def test_budget_must_be_non_negative_int(self):
+        self.assertInvalid("budget_ms", 1, 0, budget_ms=-1)
+        self.assertInvalid("budget_ms", 1, 0, budget_ms=1000.0)
+        self.assertInvalid("budget_ms", 1, 0, budget_ms=True)
+
+    def test_base_must_be_non_negative_int(self):
+        self.assertInvalid("base_ms", 1, 0, base_ms=-1)
+        self.assertInvalid("base_ms", 1, 0, base_ms=100.0)
+        self.assertInvalid("base_ms", 1, 0, base_ms=False)
+
+    def test_cap_must_be_non_negative_int(self):
+        self.assertInvalid("cap_ms", 1, 0, cap_ms=-1)
+        self.assertInvalid("cap_ms", 1, 0, cap_ms=400.0)
+        self.assertInvalid("cap_ms", 1, 0, cap_ms=True)
+
+    def test_retry_after_must_be_non_negative_int_when_given(self):
+        self.assertInvalid("retry_after_ms", 1, 0, retry_after_ms=-1)
+        self.assertInvalid("retry_after_ms", 1, 0, retry_after_ms=1.0)
+        self.assertInvalid("retry_after_ms", 1, 0, retry_after_ms=True)
+
+    def test_retry_after_none_is_accepted(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_validation_runs_before_attempt_limit_return(self):
+        self.assertInvalid("elapsed_ms", 4, -1)
+        self.assertInvalid("base_ms", 4, 0, base_ms=-1)
+
+    def test_validation_runs_before_exhausted_budget_return(self):
+        self.assertInvalid("base_ms", 1, 5000, budget_ms=10, base_ms=-1)
+        self.assertInvalid("retry_after_ms", 1, 5000, budget_ms=10,
+                           retry_after_ms=-1)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+
+    def test_attempt_greater_than_max_returns_none(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(10**9, 0, max_attempts=4))
+
+    def test_attempt_just_below_max_returns_delay(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(1, 0, max_attempts=2), 100)
+        self.assertIsNone(retry_delay(2, 0, max_attempts=2))
+
+
+class BackoffShape(unittest.TestCase):
+    def test_growth_is_capped(self):
+        delays = [retry_delay(a, 0, max_attempts=10, budget_ms=10**9)
+                  for a in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(5, 0, base_ms=0, max_attempts=9), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, cap_ms=0, max_attempts=9), 0)
+
+    def test_base_above_cap_is_capped_from_first_attempt(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_zero_delay_is_returned_when_budget_allows(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(
+            retry_delay(10**6, 0, max_attempts=10**7, budget_ms=10**9), 400)
+        self.assertEqual(
+            retry_delay(10**100, 0, max_attempts=10**100 + 1,
+                        budget_ms=10**9), 400)
+
+    def test_huge_attempt_with_huge_base_saturates(self):
+        self.assertEqual(
+            retry_delay(10**6, 0, max_attempts=10**7, budget_ms=10**70,
+                        base_ms=10**50, cap_ms=10**60),
+            10**60)
+
+    def test_exact_power_within_cap_is_not_saturated(self):
+        self.assertEqual(
+            retry_delay(3, 0, base_ms=100, cap_ms=400), 400)
+        self.assertEqual(
+            retry_delay(2, 0, base_ms=3, cap_ms=10**30), 6)
+
+
+class RetryAfterFloor(unittest.TestCase):
+    def test_retry_after_above_backoff_is_used(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
+
+    def test_retry_after_below_backoff_is_ignored(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_retry_after_above_cap_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=1000, budget_ms=10**6), 1000)
+
+    def test_retry_after_floor_applies_with_zero_base(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=50), 50)
+
+    def test_retry_after_floor_applies_with_zero_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0, retry_after_ms=50), 50)
+
+
+class BudgetBoundary(unittest.TestCase):
+    def test_elapsed_plus_delay_equal_to_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 500, budget_ms=600))
+
+    def test_one_less_than_budget_returns_delay(self):
+        self.assertEqual(retry_delay(1, 500, budget_ms=601), 100)
+
+    def test_retry_after_pushing_past_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 200, budget_ms=1000,
+                                      retry_after_ms=900))
+
+    def test_retry_after_fitting_budget_is_returned_unchanged(self):
+        self.assertEqual(
+            retry_delay(1, 200, budget_ms=1000, retry_after_ms=799), 799)
+
+    def test_zero_budget_always_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_zero_delay_with_elapsed_equal_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 5, budget_ms=5, base_ms=0))
+
+
+class LargeIntegers(unittest.TestCase):
+    def test_large_elapsed_and_budget(self):
+        big = 10**30
+        self.assertEqual(retry_delay(1, big, budget_ms=big + 101), 100)
+        self.assertIsNone(retry_delay(1, big, budget_ms=big + 100))
+
+    def test_large_retry_after_and_budget(self):
+        big = 10**40
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=big, budget_ms=big + 1), big)
+        self.assertIsNone(
+            retry_delay(1, 0, retry_after_ms=big, budget_ms=big))
