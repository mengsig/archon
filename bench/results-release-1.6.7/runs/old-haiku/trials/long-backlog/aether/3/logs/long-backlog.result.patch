+++ b/tests/test_search.py
@@ -0,0 +1,77 @@
+import unittest
+
+from tasktracker.models import DONE, Task
+from tasktracker.search import QueryError, search
+
+TASKS = [
+    Task(1, "Fix login bug", ["work", "urgent"], "open"),
+    Task(2, "buy milk", ["home"], "done"),
+    Task(3, "write login docs", ["Work"], "done"),
+    Task(4, "plan my tag", ["my tag"], "open"),
+    Task(5, "fix login", ["working"], "open"),
+]
+
+
+def ids(tasks):
+    return [task.id for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        self.assertEqual(ids(search(TASKS, "")), [1, 2, 3, 4, 5])
+        self.assertEqual(ids(search(TASKS, "   ")), [1, 2, 3, 4, 5])
+
+    def test_bare_words_must_all_match(self):
+        self.assertEqual(ids(search(TASKS, "login fix")), [1, 5])
+
+    def test_word_match_is_case_insensitive(self):
+        self.assertEqual(ids(search(TASKS, "LOGIN")), [1, 3, 5])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(ids(search(TASKS, '"fix login"')), [1, 5])
+        self.assertEqual(ids(search(TASKS, '"login fix"')), [])
+        self.assertEqual(ids(search(TASKS, '"Fix  login"')), [])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(ids(search(TASKS, "tag:work")), [1, 3])
+        self.assertEqual(ids(search(TASKS, "tag:WORK")), [1, 3])
+        self.assertEqual(ids(search(TASKS, "tag:wor")), [])
+
+    def test_tag_value_can_be_quoted(self):
+        self.assertEqual(ids(search(TASKS, 'tag:"my tag"')), [4])
+
+    def test_status_filters(self):
+        self.assertEqual(ids(search(TASKS, "status:open")), [1, 4, 5])
+        self.assertEqual(ids(search(TASKS, "status:done")), [2, 3])
+        self.assertEqual(ids(search(TASKS, "status:DONE login")), [3])
+
+    def test_terms_combine_with_and(self):
+        self.assertEqual(ids(search(TASKS, "tag:work status:done")), [3])
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "priority:high")
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "status:pending")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(TASKS, '"fix login')
+
+    def test_invalid_query_raises_even_without_tasks(self):
+        with self.assertRaises(QueryError):
+            search([], "status:pending")
+
+    def test_quoted_colon_is_a_phrase_not_a_field(self):
+        tasks = [Task(1, "ratio 3:1 check")]
+        self.assertEqual(ids(search(tasks, '"3:1"')), [1])
+
+
+if __name__ == "__main__":
+    unittest.main()
