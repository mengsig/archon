diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..f907e3a 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,40 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without big powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # cap_ms < 2**cap_ms.bit_length() <= 2**exponent < base_ms * 2**exponent
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << exponent)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..ae125d3 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,122 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=False)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.0)
+
+    def test_rejects_non_int_types(self):
+        with self.assertRaises(ValueError):
+            retry_delay("1", 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, None)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=None)
+
+    def test_attempt_and_max_attempts_at_least_one(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_negative_fields_rejected(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        for name in ("budget_ms", "base_ms", "cap_ms", "retry_after_ms"):
+            with self.subTest(field=name):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, **{name: -1})
+
+    def test_invalid_args_raise_before_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=4)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 2000, budget_ms=1000, retry_after_ms=-5)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=0, cap_ms=-1)
+
+    def test_zero_retry_after_is_valid(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_large_ints_are_accepted(self):
+        self.assertEqual(retry_delay(1, 10**30, budget_ms=10**31), 100)
+
+
+class RetryAttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_returns_none(self):
+        self.assertIsNone(retry_delay(10**18, 0, max_attempts=4))
+
+    def test_last_allowed_attempt_gets_a_delay(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+
+class RetryBackoff(unittest.TestCase):
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_cap_limits_growth(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, cap_ms=150), 150)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**19, budget_ms=10**19),
+            400)
+
+    def test_huge_attempt_with_huge_cap_is_fast(self):
+        delay = retry_delay(10**6, 0, max_attempts=10**7,
+                            budget_ms=10**40, base_ms=3, cap_ms=10**30)
+        self.assertEqual(delay, 10**30)
+
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=100, retry_after_ms=500),
+                         500)
+
+    def test_retry_after_zero_with_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=0), 0)
+
+
+class RetryBudget(unittest.TestCase):
+    def test_delay_ending_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_just_inside_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 1000, budget_ms=1000, base_ms=0))
+
+    def test_zero_delay_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 999, budget_ms=1000, base_ms=0), 0)
+
+    def test_retry_after_counts_toward_budget(self):
+        self.assertIsNone(
+            retry_delay(1, 0, budget_ms=1000, retry_after_ms=1000))
+        self.assertEqual(
+            retry_delay(1, 0, budget_ms=1000, retry_after_ms=999), 999)
+
+    def test_budget_is_not_bypassed_by_shortening(self):
+        self.assertIsNone(retry_delay(3, 700, budget_ms=1000))
+
+
+if __name__ == "__main__":
+    unittest.main()
