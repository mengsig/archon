index 2c7648a..f996d87 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,62 @@
+"""Search tasks with a small query language.
+
+A query is whitespace-separated terms, all of which must match (AND):
+bare words or "quoted phrases" match titles case-insensitively, `tag:NAME`
+matches an exact tag, and `status:open` / `status:done` match status.
+"""
+import re
+
+from tasktracker.models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+# A run of non-space characters and/or double-quoted segments.
+_TERM_PATTERN = re.compile(r'(?:[^\s"]|"[^"]*")+')
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    predicates = _parse_query(query)
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _parse_query(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    return [_make_predicate(raw) for raw in _TERM_PATTERN.findall(query)]
+
+
+def _make_predicate(raw):
+    if '"' in raw:
+        return _title_matcher(raw.replace('"', ""))
+    field, colon, value = raw.partition(":")
+    if not colon:
+        return _title_matcher(raw)
+    if not value:
+        raise QueryError(f"empty value in term {raw!r}")
+    if field == "tag":
+        return _tag_matcher(value)
+    if field == "status":
+        return _status_matcher(value, raw)
+    raise QueryError(f"unknown field {field!r} in term {raw!r}")
+
+
+def _title_matcher(text):
+    needle = text.casefold()
+    return lambda task: needle in task.title.casefold()
+
+
+def _tag_matcher(name):
+    needle = name.casefold()
+    return lambda task: any(tag.casefold() == needle for tag in task.tags)
+
+
+def _status_matcher(value, raw):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status in term {raw!r}")
+    return lambda task: task.status == status
