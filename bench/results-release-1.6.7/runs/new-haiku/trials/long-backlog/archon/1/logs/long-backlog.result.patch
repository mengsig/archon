@@ -0,0 +1,125 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.undo()
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+        self.assertEqual(store.all(), [])
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_task_exactly_under_same_id(self):
+        store = TaskStore()
+        task = store.add("buy milk", tags=["home", "shop"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = (task.id, task.title, list(task.tags), task.status, task.due)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertIs(restored, task)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status, restored.due), before)
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(store.get(b.id).title, "b")
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_interleaved_sequence_undone_in_reverse(self):
+        store = TaskStore()
+        a = store.add("a")
+        store.delete(a.id)
+        b = store.add("b")
+        store.complete(b.id)
+        c = store.add("c")
+        store.delete(b.id)
+        self.assertEqual([t.id for t in store.all()], [c.id])
+        store.undo()  # restore b
+        store.undo()  # un-add c
+        self.assertEqual([t.id for t in store.all()], [b.id])
+        self.assertEqual(store.get(b.id).status, "done")
+        store.undo()  # reopen b
+        self.assertEqual(store.get(b.id).status, "open")
+        store.undo()  # un-add b
+        store.undo()  # restore a
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        self.assertEqual(store.get(a.id).title, "a")
+
+    def test_ids_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertNotEqual(first.id, second.id)
+        self.assertEqual(second.id, first.id + 1)
+
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_nothing_to_undo_after_everything_undone(self):
+        store = TaskStore()
+        store.add("a")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_complete_after_real_change_undoes_only_real_change(self):
+        store = TaskStore()
+        task = store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        self.assertEqual(task.status, "open")
+
+    def test_undo_of_repeated_complete_restores_previous_status(self):
+        store = TaskStore()
+        task = store.add("a")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+
+if __name__ == "__main__":
+    unittest.main()
