 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error('GET /items response has no items array');
+    }
+    items.push(...body.items);
+    cursor = nextCursor(body);
+    if (cursor !== undefined) {
+      if (seenCursors.has(cursor)) throw new Error('GET /items returned a repeated next_cursor');
+      seenCursors.add(cursor);
+    }
+  } while (cursor !== undefined);
+  return items;
+}
+
+// Returns the cursor to send next, or undefined when there are no more pages.
+function nextCursor(body) {
+  const cursor = body.next_cursor;
+  if (cursor === undefined || cursor === null) return undefined;
+  if (typeof cursor !== 'string') {
+    throw new Error('GET /items next_cursor must be a string or null');
+  }
+  return cursor;
 }
 
