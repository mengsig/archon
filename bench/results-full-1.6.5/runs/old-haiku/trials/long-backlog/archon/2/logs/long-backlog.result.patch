@@ -0,0 +1,84 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due"
+
+
+def parse(text):
+    return list(csv.reader(io.StringIO(text, newline="")))
+
+
+class ExportTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_every_line_ends_with_crlf(self):
+        text = to_csv([Task(1, "a"), Task(2, "b")])
+        self.assertEqual(text, HEADER + "\r\n1,a,,open,\r\n2,b,,open,\r\n")
+
+    def test_rows_keep_input_order_and_fields(self):
+        tasks = [
+            Task(7, "later", tags=["x", "y"], status="done", due=date(2026, 5, 2)),
+            Task(3, "first"),
+        ]
+        rows = parse(to_csv(tasks))
+        self.assertEqual(rows, [
+            ["id", "title", "tags", "status", "due"],
+            ["7", "later", "x;y", "done", "2026-05-02"],
+            ["3", "first", "", "open", ""],
+        ])
+
+    def test_comma_in_title_is_quoted(self):
+        text = to_csv([Task(1, "buy milk, eggs")])
+        self.assertIn('1,"buy milk, eggs",,open,\r\n', text)
+
+    def test_quotes_in_title_are_doubled(self):
+        text = to_csv([Task(1, 'say "hi"')])
+        self.assertIn('1,"say ""hi""",,open,\r\n', text)
+
+    def test_newlines_in_title_are_quoted(self):
+        text = to_csv([Task(1, "line one\nline two\rthree")])
+        self.assertIn('1,"line one\nline two\rthree",,open,\r\n', text)
+        self.assertEqual(parse(text)[1][1], "line one\nline two\rthree")
+
+    def test_quoting_applies_to_tags(self):
+        text = to_csv([Task(1, "t", tags=["a,b", "c"])])
+        self.assertIn('1,t,"a,b;c",open,\r\n', text)
+
+    def test_plain_fields_are_not_quoted(self):
+        text = to_csv([Task(1, "plain title", tags=["a"], due=date(2026, 1, 9))])
+        self.assertEqual(text.splitlines()[1], "1,plain title,a,open,2026-01-09")
+
+    def test_round_trip_through_csv_reader(self):
+        title = 'tricky, "quoted"\nand multi-line'
+        rows = parse(to_csv([Task(4, title, tags=["p;q"])]))
+        self.assertEqual(rows[1], ["4", title, "p;q", "open", ""])
+
+    def test_rejects_non_int_id(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task("1", "a")])
+
+    def test_rejects_bool_id(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(True, "a")])
+
+    def test_rejects_non_str_title(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(1, None)])
+
+    def test_rejects_non_str_tags(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(1, "a", tags=["ok", 5])])
+
+    def test_rejects_string_due_date(self):
+        with self.assertRaises(TypeError):
+            to_csv([Task(1, "a", due="2026-01-01")])
+
+
+if __name__ == "__main__":
+    unittest.main()
