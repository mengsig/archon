diff --git a/test_api.py b/test_api.py
index 55cd1fd..e2c20d3 100644
--- a/test_api.py
+++ b/test_api.py
@@ -25,5 +25,68 @@ class ApiTest(unittest.TestCase):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
 
+def walk_pages(**query):
+    """Follow next_cursor from the first page to the end; return every page body."""
+    pages = []
+    cursor = None
+    while True:
+        params = dict(query, cursor=cursor) if cursor is not None else dict(query)
+        res = get("/items", **params)
+        assert res["status"] == 200, res
+        pages.append(res["body"])
+        cursor = res["body"]["next_cursor"]
+        if cursor is None:
+            return pages
+
+
+class PaginationTest(unittest.TestCase):
+    def test_default_page_size_is_20(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertEqual([item["id"] for item in body["items"]][0], 1)
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_limit_bounds_are_accepted(self):
+        for limit in ("1", "100"):
+            with self.subTest(limit=limit):
+                res = get("/items", limit=limit)
+                self.assertEqual(res["status"], 200)
+                self.assertEqual(len(res["body"]["items"]), min(int(limit), 57))
+
+    def test_invalid_limit_is_400(self):
+        for limit in ("0", "101", "-1", "abc", "1.5", "", " 5", 5):
+            with self.subTest(limit=limit):
+                res = get("/items", limit=limit)
+                self.assertEqual(res["status"], 400)
+                self.assertIsInstance(res["body"]["error"], str)
+
+    def test_cursor_round_trip_follows_next_cursor(self):
+        pages = walk_pages(limit="10")
+        self.assertEqual(len(pages), 6)
+        self.assertEqual([len(p["items"]) for p in pages], [10, 10, 10, 10, 10, 7])
+        self.assertEqual(pages[1]["items"][0]["id"], 11)
+
+    def test_last_page_has_null_next_cursor(self):
+        pages = walk_pages(limit="10")
+        self.assertIsNone(pages[-1]["next_cursor"])
+        for page in pages[:-1]:
+            self.assertIsNotNone(page["next_cursor"])
+        exact = get("/items", limit="57")["body"]
+        self.assertIsNone(exact["next_cursor"])
+
+    def test_every_item_returned_exactly_once(self):
+        for limit in ("1", "7", "20", "100"):
+            with self.subTest(limit=limit):
+                ids = [item["id"] for page in walk_pages(limit=limit) for item in page["items"]]
+                self.assertEqual(ids, list(range(1, 58)))
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ("abc", "999", "0", "", "01", 20):
+            with self.subTest(cursor=cursor):
+                res = get("/items", cursor=cursor)
+                self.assertEqual(res["status"], 400)
+                self.assertEqual(res["body"], {"error": "invalid cursor"})
+
+
 if __name__ == "__main__":
     unittest.main()
