 """Bounded, thread-safe ledger. See SPEC.md."""
 
+from threading import Lock
+
 MAX_BALANCE = 2**63 - 1
 
 
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError("balances must be a dict")
+
+        for name, balance in balances.items():
+            if (not isinstance(name, str) or not name or type(balance) is not int
+                    or not 0 <= balance <= MAX_BALANCE):
+                raise ValueError("invalid account name or balance")
+
+        self._balances = balances.copy()
+        self._lock = Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+            raise ValueError("amount must be an integer in range")
+
+        with self._lock:
+            try:
+                source_exists = source in self._balances
+            except TypeError:
+                raise KeyError(source) from None
+            if not source_exists:
+                raise KeyError(source)
+            try:
+                destination_exists = destination in self._balances
+            except TypeError:
+                raise KeyError(destination) from None
+            if not destination_exists:
+                raise KeyError(destination)
+
+            source_balance = self._balances[source]
+            if source == destination:
+                return source_balance >= amount
+            destination_balance = self._balances[destination]
+            if source_balance < amount or destination_balance + amount > MAX_BALANCE:
+                return False
+
+            self._balances[source] = source_balance - amount
+            self._balances[destination] = destination_balance + amount
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return self._balances.copy()
