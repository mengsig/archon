 elsewhere.
 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+_LIMIT_RE = re.compile(r"0*([0-9]{1,3})")
+_CURSOR_RE = re.compile(r"[A-Za-z0-9_-]+={0,2}")
+_ID_TEXT_RE = re.compile(r"[0-9]{1,18}")
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +30,55 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after_id = None
+    if query.get("cursor") is not None:
+        after_id = _decode_cursor(query["cursor"])
+        if after_id is None:
+            return _error(400, "invalid cursor")
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    match = _LIMIT_RE.fullmatch(raw) if isinstance(raw, str) else None
+    if match is None:
+        return None
+    limit = int(match.group(1))
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(item_id):
+    assert isinstance(item_id, int) and item_id >= 0
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not _CURSOR_RE.fullmatch(cursor):
+        return None
+    try:
+        raw = base64.urlsafe_b64decode(cursor.encode("ascii")).decode("ascii")
+    except ValueError:
+        return None
+    if not _ID_TEXT_RE.fullmatch(raw):
+        return None
+    item_id = int(raw)
+    # Accept only the exact form _encode_cursor produces.
+    if _encode_cursor(item_id) != cursor:
+        return None
+    return item_id
 
 
