+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation_and_copying(self):
+        for invalid in (None, [], {"": 0}, {1: 0}, {"a": True}, {"a": -1},
+                        {"a": MAX_BALANCE + 1}):
+            with self.subTest(invalid=invalid):
+                with self.assertRaises(ValueError):
+                    Ledger(invalid)
+
+        original = {"a": 1}
+        ledger = Ledger(original)
+        original["a"] = 9
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 12
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also-missing", amount)
+
+    def test_unknown_accounts_raise_key_error_without_changes(self):
+        ledger = Ledger({"a": 2})
+        for source, destination in (("missing", "a"), ("a", "missing"),
+                                   ([], "a"), ("a", [])):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        self.assertEqual(ledger.snapshot(), {"a": 2})
+
+    def test_destination_overflow_is_atomic(self):
+        ledger = Ledger({"a": 1, "b": MAX_BALANCE})
+        self.assertFalse(ledger.transfer("a", "b", 1))
+        self.assertEqual(ledger.snapshot(), {"a": 1, "b": MAX_BALANCE})
+
+    def test_self_transfer_checks_funds_without_mutation(self):
+        ledger = Ledger({"a": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertFalse(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE})
