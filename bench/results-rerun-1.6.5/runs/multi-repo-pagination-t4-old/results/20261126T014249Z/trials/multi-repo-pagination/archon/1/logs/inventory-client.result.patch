-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let query = {};
+  for (;;) {
+    const body = await request(transport, '/items', query);
+    if (!body || !Array.isArray(body.items)) {
+      throw new Error(`GET /items returned no items array: ${JSON.stringify(body)}`);
+    }
+    for (const item of body.items) items.push(item);
+    if (body.next_cursor == null) return items;
+    if (seenCursors.has(body.next_cursor)) {
+      throw new Error(`GET /items repeated cursor ${JSON.stringify(body.next_cursor)}`);
+    }
+    seenCursors.add(body.next_cursor);
+    query = { cursor: body.next_cursor };
+  }
 }
 
