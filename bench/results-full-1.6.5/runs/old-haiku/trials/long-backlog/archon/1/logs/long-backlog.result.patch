+HEADER = ["id", "title", "tags", "status", "due"]
+# Characters that force a field to be wrapped in double quotes (RFC 4180).
+SPECIAL_CHARS = (",", '"', "\r", "\n")
+
+
+def _escape_field(value):
+    text = str(value)
+    if not any(char in text for char in SPECIAL_CHARS):
+        return text
+    return '"' + text.replace('"', '""') + '"'
+
+
+def _format_row(fields):
+    assert len(fields) == len(HEADER), f"row has {len(fields)} fields, expected {len(HEADER)}"
