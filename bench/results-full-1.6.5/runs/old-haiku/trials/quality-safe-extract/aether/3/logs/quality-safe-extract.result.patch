diff --git a/safe_extract.py b/safe_extract.py
index 0007027..d5c1e5c 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,110 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Validate the whole batch, then write it. Returns names in input order."""
+    _validate_batch_type(entries)
+    root_path = _validate_root(root)
+    for entry in entries:
+        _validate_entry(entry)
+    names = [name for name, _ in entries]
+    _validate_names(names)
+    _validate_targets(root_path, names)
+
+    for name, data in entries:
+        _write_file(root_path / name, data)
+    assert len(names) == len(entries)
+    return names
+
+
+def _validate_batch_type(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, not {type(root).__name__}")
+    root_path = Path(root)
+    if root_path.is_symlink():
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not root_path.is_dir():
+        raise ValueError(f"root is not an existing directory: {root_path}")
+    return root_path
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("entry must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+
+
+def _split_name(name):
+    """Return the path components of a relative POSIX name, or raise ValueError."""
+    if any(char in name for char in ("\\", ":", "\0")):
+        raise ValueError(f"invalid character in entry name: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not encodable: {name!r}") from exc
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    return parts
+
+
+def _validate_names(names):
+    name_set = set(names)
+    if len(name_set) != len(names):
+        raise ValueError("duplicate entry names in batch")
+    for name in names:
+        parts = _split_name(name)
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in name_set:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in batch")
+
+
+def _validate_targets(root, names):
+    for name in names:
+        parts = _split_name(name)
+        path = root
+        for part in parts[:-1]:
+            path = path / part
+            st = _lstat_or_none(path)
+            if st is None:
+                break
+            _require_real_directory(path, st)
+        else:
+            if _lstat_or_none(root / name) is not None:
+                raise ValueError(f"target already exists: {name!r}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _require_real_directory(path, st):
+    if stat.S_ISLNK(st.st_mode):
+        raise ValueError(f"symlink below root: {path}")
+    if not stat.S_ISDIR(st.st_mode):
+        raise ValueError(f"existing ancestor is not a directory: {path}")
+
+
+def _write_file(path, data):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    assert path.parent.is_dir()
+    with path.open("xb") as handle:
+        handle.write(data)
+    assert path.stat().st_size == len(data)
