+class BatchShape(TempRootCase):
+    def test_non_list_batches_are_rejected_without_consuming(self):
+        generator = ((name, b"") for name in ["a"])
+        iterator = iter([("a", b"")])
+        for batch in [(), (("a", b""),), iterator, generator, None, "a"]:
+            with self.subTest(batch=type(batch).__name__):
+                self.assertRejects(batch)
+        self.assertEqual(list(iterator), [("a", b"")])
+        self.assertEqual(list(generator), [("a", b"")])
+
+    def test_empty_non_list_batch_is_rejected(self):
+        self.assertRejects(())
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            ["a", b""],
+            ("a",),
+            ("a", b"", "extra"),
+            "a",
+            None,
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                self.assertRejects([("ok", b""), entry])
+
+    def test_non_string_names_are_rejected(self):
+        for name in [b"a", 1, None, Path("a")]:
+            with self.subTest(name=name):
+                self.assertRejects([(name, b"")])
