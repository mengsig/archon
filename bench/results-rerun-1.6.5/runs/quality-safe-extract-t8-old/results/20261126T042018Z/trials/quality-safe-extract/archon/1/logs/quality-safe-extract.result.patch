+class ExtractFilesystemConflicts(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.base = Path(self.tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def assert_rejected_without_changes(self, entries):
+        before = tree(self.root)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(tree(self.root), before)
+        self.assertEqual(tree(self.outside), [])
+
+    def test_existing_file_target_is_rejected_and_kept(self):
+        (self.root / "keep").write_bytes(b"original")
+        self.assert_rejected_without_changes([("new", b"x"), ("keep", b"y")])
+        self.assertEqual((self.root / "keep").read_bytes(), b"original")
+
+    def test_existing_directory_target_is_rejected(self):
+        (self.root / "dir").mkdir()
+        self.assert_rejected_without_changes([("dir", b"x")])
+
+    def test_ancestor_that_is_a_file_is_rejected(self):
+        (self.root / "file").write_bytes(b"")
+        self.assert_rejected_without_changes([("file/child", b"x")])
+
+    def test_symlinked_ancestor_inside_root_is_rejected(self):
+        real = self.root / "real"
+        real.mkdir()
+        (self.root / "link").symlink_to(real, target_is_directory=True)
+        self.assert_rejected_without_changes([("link/child", b"x")])
+        self.assertEqual(tree(real), [])
+
+    def test_dangling_symlink_ancestor_is_rejected(self):
+        (self.root / "dangling").symlink_to(self.outside / "nowhere")
+        self.assert_rejected_without_changes([("dangling/child", b"x")])
+        self.assertEqual(tree(self.outside), [])
+
+    def test_symlink_target_is_rejected_without_overwriting(self):
+        real = self.root / "real.txt"
+        real.write_bytes(b"keep")
+        (self.root / "alias").symlink_to(real)
+        self.assert_rejected_without_changes([("alias", b"x")])
+        self.assertEqual(real.read_bytes(), b"keep")
+
+    def test_dangling_symlink_target_is_rejected(self):
+        (self.root / "alias").symlink_to(self.outside / "target")
+        self.assert_rejected_without_changes([("alias", b"x")])
+        self.assertEqual(tree(self.outside), [])
+
+    def test_symlink_to_directory_target_is_rejected(self):
+        (self.root / "alias").symlink_to(self.outside, target_is_directory=True)
+        self.assert_rejected_without_changes([("alias", b"x")])
+
+    def test_conflict_in_later_entry_leaves_earlier_entries_uncreated(self):
+        (self.root / "taken").write_bytes(b"")
+        self.assert_rejected_without_changes([("fresh/one", b"1"), ("taken", b"2")])
+
