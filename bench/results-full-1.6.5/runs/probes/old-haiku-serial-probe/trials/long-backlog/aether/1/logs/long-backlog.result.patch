diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..69a2d3f 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,58 @@
+import re
+
+from .models import DONE, OPEN
+
+TERM = re.compile(r'(?:[^\s"]|"[^"]*")+')
+FIELD_TERM = re.compile(r"([A-Za-z_]+):(.*)", re.DOTALL)
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in their original order."""
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_compile_term(raw) for raw in _raw_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in matchers)]
+
+
+def _raw_terms(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    return TERM.findall(query)
+
+
+def _compile_term(raw):
+    field = FIELD_TERM.fullmatch(raw)
+    if field is None:
+        return _title_matcher(_unquote(raw))
+    name, value = field.group(1).lower(), _unquote(field.group(2))
+    if not value:
+        raise QueryError(f"empty value in term: {raw}")
+    return _field_matcher(name, value)
+
+
+def _title_matcher(phrase):
+    needle = phrase.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _field_matcher(name, value):
+    if name == "tag":
+        wanted = value.lower()
+        return lambda task: wanted in (tag.lower() for tag in task.tags)
+    if name == "status":
+        return _status_matcher(value.lower())
+    raise QueryError(f"unknown field: {name}")
+
+
+def _status_matcher(status):
+    if status not in STATUSES:
+        raise QueryError(f"unknown status: {status}")
+    return lambda task: task.status == status
+
+
+def _unquote(text):
+    return text.replace('"', "")
