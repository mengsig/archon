+
+#[test]
+fn currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tgroceries\t-2.50\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-250,EUR");
+}
+
+#[test]
+fn malformed_currency_is_rejected_as_bad_currency() {
+    for code in ["eur", "EURO", "EU", "E1R", "US D", "\u{20ac}UR"] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert!(
+            matches!(err, ParseError::BadCurrency(_)),
+            "{code:?} gave {err:?}"
+        );
+    }
+}
+
+#[test]
+fn empty_currency_column_is_rejected() {
+    let err = parse_line("2026-03-01\tgroceries\t1\t").unwrap_err();
+    assert!(matches!(err, ParseError::BadCurrency(_)), "{err:?}");
+}
+
+#[test]
+fn other_errors_are_malformed() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tEUR\textra").unwrap_err();
+    assert!(matches!(err, ParseError::Malformed(_)), "{err:?}");
+    let err = parse_line("2026-03-01\tgroceries\tabc\tEUR").unwrap_err();
+    assert!(matches!(err, ParseError::Malformed(_)), "{err:?}");
+}
