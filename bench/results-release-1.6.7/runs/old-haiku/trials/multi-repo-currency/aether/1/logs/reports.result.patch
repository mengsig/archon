-"""Per-account totals from the ledger's CSV export.
+"""Per-account, per-currency totals from the ledger's CSV export.
 
 Usage: python3 reports.py < ledger.csv
 """
 
 import csv
+import re
 import sys
 
+DEFAULT_CURRENCY = "USD"
+CURRENCY_PATTERN = re.compile(r"[A-Z]{3}")
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+
+class MalformedInput(Exception):
+    """Input that cannot be totalled; main() reports it and exits with 2."""
+
+
+def is_currency(code):
+    return isinstance(code, str) and CURRENCY_PATTERN.fullmatch(code) is not None
+
+
+def entries(reader):
+    """Yield (account, currency, cents) from CSV dict rows.
+
+    CSV without a currency column (older ledger exports) counts as USD.
+    """
+    has_currency = "currency" in (reader.fieldnames or [])
+    for row in reader:
+        currency = row["currency"] if has_currency else DEFAULT_CURRENCY
+        if not is_currency(currency):
+            raise MalformedInput(f"line {reader.line_num}: bad currency {currency!r}")
+        yield row["account"], currency, int(row["amount_cents"])
+
+
+def totals(reader):
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
-    for row in rows:
-        account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+    for account, currency, cents in entries(reader):
+        key = (account, currency)
+        result[key] = result.get(key, 0) + cents
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
-    rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        result = totals(csv.DictReader(sys.stdin))
+    except MalformedInput as error:
+        print(error, file=sys.stderr)
+        return 2
+    sys.stdout.write(render(result))
+    return 0
 
 
 if __name__ == "__main__":
-    main()
+    sys.exit(main())
