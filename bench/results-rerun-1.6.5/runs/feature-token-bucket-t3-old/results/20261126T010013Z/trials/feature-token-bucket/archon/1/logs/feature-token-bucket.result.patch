 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+# Relative to capacity, so it stays above float rounding for large buckets.
+_REL_TOLERANCE = 1e-12
+
+
+def _check_bucket_params(capacity, refill_per_sec):
+    if not capacity > 0:
+        raise ValueError(f"capacity must be > 0, got {capacity!r}")
+    if not refill_per_sec > 0:
+        raise ValueError(f"refill_per_sec must be > 0, got {refill_per_sec!r}")
+
+
+def _check_request(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must be in (0, {capacity}], got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tolerance = _REL_TOLERANCE * capacity
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now <= self._last:
+            return
+        elapsed = now - self._last
+        self._tokens = min(
+            self._capacity, self._tokens + elapsed * self._refill_per_sec
+        )
+        self._last = now
+        assert 0.0 <= self._tokens <= self._capacity
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        if self._tokens + self._tolerance < n:
+            return False
+        self._tokens = max(0.0, self._tokens - n)
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        self._refill()
+        missing = n - self._tokens
+        if missing <= self._tolerance:
+            return 0.0
+        return missing / self._refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_bucket_params(capacity, refill_per_sec)
+        if not max_keys >= 1:
+            raise ValueError(f"max_keys must be >= 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_request(n, self._capacity)
+        return self._bucket(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
diff --git a/test_ratelimit_spec.py b/test_ratelimit_spec.py
new file mode 100644
index 0000000..f67faa9
--- /dev/null
+++ b/test_ratelimit_spec.py
@@ -0,0 +1,180 @@
+import random
+import unittest
+
+from ratelimit import KeyedLimiter, TokenBucket
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+
+class BucketParamTest(unittest.TestCase):
+    def test_invalid_capacity_or_rate_raises(self):
+        for capacity, rate in [
+            (0, 1.0),
+            (-1, 1.0),
+            (1, 0),
+            (1, -2.0),
+            (float("nan"), 1.0),
+            (1, float("nan")),
+        ]:
+            with (
+                self.subTest(capacity=capacity, rate=rate),
+                self.assertRaises(ValueError),
+            ):
+                TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_request_size_raises(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_default_clock_is_usable(self):
+        bucket = TokenBucket(1, 1.0)
+        self.assertTrue(bucket.try_acquire())
+
+
+class BucketBehaviourTest(unittest.TestCase):
+    def test_fresh_bucket_is_full(self):
+        bucket = TokenBucket(5, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.available(), 5)
+
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.25
+        self.assertFalse(bucket.try_acquire(1))
+        self.assertAlmostEqual(bucket.available(), 0.25)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire(1))
+
+    def test_refill_never_exceeds_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 10.0, clock=clock)
+        bucket.try_acquire(3)
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3)
+
+    def test_wait_time_zero_when_available(self):
+        bucket = TokenBucket(1, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(), 0.0)
+
+    def test_wait_time_is_seconds_until_acquire(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        clock.now = 1.5
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        first = bucket.wait_time(1)
+        self.assertEqual(bucket.wait_time(1), first)
+        clock.now = first
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_wait_time_promise_holds_for_large_capacities(self):
+        rng = random.Random(0)
+        for _ in range(300):
+            capacity = 10 ** rng.uniform(0, 9)
+            rate = rng.uniform(0.1, 10.0)
+            n = rng.uniform(0.01, 1.0) * capacity
+            with self.subTest(capacity=capacity, rate=rate, n=n):
+                clock = FakeClock()
+                bucket = TokenBucket(capacity, rate, clock=clock)
+                bucket.try_acquire(capacity)
+                clock.now = bucket.wait_time(n)
+                self.assertTrue(bucket.try_acquire(n))
+
+    def test_clock_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        clock.now = 2.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        self.assertFalse(bucket.try_acquire(6))
+        clock.now = 6.0
+        self.assertAlmostEqual(bucket.available(), 6.0)
+
+
+class KeyedLimiterTest(unittest.TestCase):
+    def test_invalid_params_raise(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, -1.0, clock=FakeClock())
+        for max_keys in [0, -3]:
+            with self.subTest(max_keys=max_keys), self.assertRaises(ValueError):
+                KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_request_size_raises_without_creating_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=0)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", n=2)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_wait_time_is_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_evicts_least_recently_used(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("c"))
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(len(limiter), 1)
+        self.assertTrue(limiter.try_acquire("a"))
+
+
+if __name__ == "__main__":
+    unittest.main()
