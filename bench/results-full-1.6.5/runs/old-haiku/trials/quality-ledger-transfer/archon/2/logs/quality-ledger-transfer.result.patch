+class LedgerFundsAndOverflow(unittest.TestCase):
+    def test_exact_balance_transfer_succeeds(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), True)
