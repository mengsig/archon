+import os
 import tempfile
 import unittest
 from pathlib import Path
@@ -18,3 +19,267 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class SandboxTestCase(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory(dir=".")
+        self.addCleanup(self._tmp.cleanup)
+        self.base = Path(self._tmp.name).resolve()
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def snapshot(self, path):
+        return sorted(str(p.relative_to(path)) for p in path.rglob("*"))
+
+
+class BatchTypeValidation(SandboxTestCase):
+    def test_non_list_batches_are_rejected_without_consuming(self):
+        generator = ((name, b"x") for name in ["a", "b"])
+        iterator = iter([("a", b"x")])
+        for batch in [(), (("a", b"x"),), generator, iterator, None, "a"]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_empty_non_list_batch_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract((), self.root)
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", "extra"),
+            (b"a", b"x"),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", None),
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b"1"), entry], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+
+class NameValidation(SandboxTestCase):
+    def assert_name_rejected(self, name):
+        with self.assertRaises(ValueError):
+            extract([("ok", b"1"), (name, b"2")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_empty_and_absolute_names_are_rejected(self):
+        for name in ["", "/abs", "/", "//"]:
+            with self.subTest(name=name):
+                self.assert_name_rejected(name)
+
+    def test_backslash_colon_and_nul_are_rejected(self):
+        for name in ["a\\b", "c:d", "C:\\x", "a\x00b", "\x00"]:
+            with self.subTest(name=name):
+                self.assert_name_rejected(name)
+
+    def test_empty_dot_and_dotdot_components_are_rejected(self):
+        for name in ["a/", "a//b", "./a", "a/./b", "a/../b", "..", ".", "../x", "a/.."]:
+            with self.subTest(name=name):
+                self.assert_name_rejected(name)
+
+    def test_non_string_names_are_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([(b"a", b"x")], self.root)
+        with self.assertRaises(ValueError):
+            extract([(None, b"x")], self.root)
+
+    def test_unencodable_name_is_rejected(self):
+        self.assert_name_rejected("bad\udcffname")
+
+    def test_literal_percent_names_are_kept_verbatim(self):
+        names = ["100%.txt", "%2e%2e/x", "%41"]
+        self.assertEqual(extract([(n, b"v") for n in names], self.root), names)
+        self.assertEqual(self.snapshot(self.root), ["%2e%2e", "%2e%2e/x", "%41", "100%.txt"])
+
+
+class CollisionValidation(SandboxTestCase):
+    def test_duplicate_names_are_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("b", b"2"), ("a", b"3")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_file_then_directory_collision_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("a/b", b"2")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_directory_then_file_collision_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a/b", b"2"), ("a", b"1")], self.root)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_sibling_names_sharing_a_prefix_are_allowed(self):
+        names = ["a", "ab", "a.txt"]
+        self.assertEqual(extract([(n, b"v") for n in names], self.root), names)
+
+
+class RootValidation(SandboxTestCase):
+    def test_missing_root_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+    def test_missing_root_with_entries_is_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], self.base / "missing")
+        self.assertFalse((self.base / "missing").exists())
+
+    def test_file_root_is_rejected(self):
+        plain = self.base / "plain"
+        plain.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], plain)
+
+    def test_root_below_a_regular_file_is_rejected(self):
+        plain = self.base / "plain"
+        plain.write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], plain / "child")
+
+    def test_symlink_root_is_rejected(self):
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        with self.assertRaises(ValueError):
+            extract([("a", b"1")], link)
+        self.assertEqual(self.snapshot(self.root), [])
+
+    def test_symlink_root_with_trailing_slash_or_dot_is_rejected(self):
+        for index, suffix in enumerate(["/", "/.", "//"]):
+            with self.subTest(suffix=suffix):
+                link = self.base / f"link{index}"
+                os.symlink(self.root, link)
+                with self.assertRaises(ValueError):
+                    extract([("a", b"1")], f"{link}{suffix}")
+                self.assertEqual(self.snapshot(self.root), [])
+
+    def test_dangling_symlink_root_is_rejected(self):
+        link = self.base / "dangle"
+        os.symlink(self.base / "missing", link)
+        with self.assertRaises(ValueError):
+            extract([], link)
+
+    def test_symlink_root_is_rejected_even_for_empty_batch(self):
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        with self.assertRaises(ValueError):
+            extract([], link)
+
+    def test_invalid_root_types_are_rejected(self):
+        for root in [None, 3, b"bytes-root", "", ["list"]]:
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([], root)
+
+    def test_string_root_is_accepted(self):
+        self.assertEqual(extract([("a", b"1")], str(self.root)), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"1")
+
+
+class ConflictValidation(SandboxTestCase):
+    def test_existing_file_is_not_overwritten(self):
+        (self.root / "a").write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([("b", b"1"), ("a", b"2")], self.root)
+        self.assertEqual((self.root / "a").read_bytes(), b"keep")
+        self.assertEqual(self.snapshot(self.root), ["a"])
+
+    def test_existing_directory_target_is_rejected(self):
+        (self.root / "d").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("d", b"1")], self.root)
+        self.assertEqual(self.snapshot(self.root), ["d"])
+
+    def test_existing_parent_directory_is_reused(self):
+        (self.root / "d").mkdir()
+        self.assertEqual(extract([("d/x", b"1")], self.root), ["d/x"])
+        self.assertEqual((self.root / "d/x").read_bytes(), b"1")
+
+    def test_regular_file_ancestor_is_rejected(self):
+        (self.root / "f").write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("f/child", b"1")], self.root)
+        self.assertEqual((self.root / "f").read_bytes(), b"x")
+
+    def test_conflict_later_in_batch_creates_nothing(self):
+        (self.root / "taken").write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([("new/dir/a", b"1"), ("taken/b", b"2")], self.root)
+        self.assertEqual(self.snapshot(self.root), ["taken"])
+
+
+class SymlinkValidation(SandboxTestCase):
+    def setUp(self):
+        super().setUp()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def test_symlinked_directory_component_is_rejected(self):
+        os.symlink(self.outside, self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"1")], self.root)
+        self.assertEqual(self.snapshot(self.outside), [])
+
+    def test_symlink_inside_root_is_not_followed(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"1")], self.root)
+        self.assertEqual(self.snapshot(self.root / "real"), [])
+
+    def test_symlink_target_is_not_overwritten(self):
+        victim = self.outside / "victim"
+        victim.write_bytes(b"keep")
+        os.symlink(victim, self.root / "file")
+        with self.assertRaises(ValueError):
+            extract([("file", b"1")], self.root)
+        self.assertEqual(victim.read_bytes(), b"keep")
+
+    def test_dangling_symlink_target_is_rejected(self):
+        os.symlink(self.outside / "missing", self.root / "dangle")
+        with self.assertRaises(ValueError):
+            extract([("dangle", b"1")], self.root)
+        self.assertFalse((self.outside / "missing").exists())
+
+    def test_dangling_symlink_component_is_rejected(self):
+        os.symlink(self.outside / "missing", self.root / "dangle")
+        with self.assertRaises(ValueError):
+            extract([("dangle/x", b"1")], self.root)
+        self.assertFalse((self.outside / "missing").exists())
+
+
+class WriteBehaviour(SandboxTestCase):
+    def test_missing_parents_are_created_and_bytes_are_exact(self):
+        payload = bytes(range(256)) + b"\x00\r\n"
+        extract([("a/b/c/data.bin", payload)], self.root)
+        self.assertEqual((self.root / "a/b/c/data.bin").read_bytes(), payload)
+
+    def test_empty_file_is_written(self):
+        extract([("zero", b"")], self.root)
+        self.assertEqual((self.root / "zero").stat().st_size, 0)
+
+    def test_return_order_matches_input_order(self):
+        names = ["z", "a/b", "m", "a/a"]
+        self.assertEqual(extract([(n, b"v") for n in names], self.root), names)
+
+    def test_unwritable_parent_raises_visible_error(self):
+        if os.geteuid() == 0:
+            self.skipTest("root ignores directory permissions")
+        locked = self.root / "locked"
+        locked.mkdir()
+        locked.chmod(0o500)
+        self.addCleanup(locked.chmod, 0o700)
+        with self.assertRaises(PermissionError):
+            extract([("locked/file", b"1")], self.root)
+
+
+if __name__ == "__main__":
