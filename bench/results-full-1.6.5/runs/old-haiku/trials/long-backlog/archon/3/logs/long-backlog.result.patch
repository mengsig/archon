@@ -0,0 +1,94 @@
+import unittest
+
+from tasktracker.search import QueryError, parse_query, search
+from tasktracker.store import TaskStore
+
+
+def make_store():
+    store = TaskStore()
+    store.add("Fix login page", tags=["Work", "urgent"])
+    store.add("write report", tags=["work"])
+    store.add("fix login bug", tags=["bugs"])
+    store.add("retire the Report generator", tags=["old"])
+    store.complete(4)
+    return store
+
+
+def titles(tasks):
+    return [t.title for t in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def test_bare_word_matches_title_case_insensitively(self):
+        store = make_store()
+        self.assertEqual(titles(search(store.all(), "report")),
+                         ["write report", "retire the Report generator"])
+        self.assertEqual(titles(search(store.all(), "LOGIN")),
+                         ["Fix login page", "fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        store = make_store()
+        self.assertEqual(titles(search(store.all(), '"fix login"')),
+                         ["Fix login page", "fix login bug"])
+        self.assertEqual(titles(search(store.all(), '"login fix"')), [])
+
+    def test_all_terms_must_match(self):
+        store = make_store()
+        self.assertEqual(titles(search(store.all(), "fix tag:bugs")), ["fix login bug"])
+        self.assertEqual(titles(search(store.all(), '"fix login" page')), ["Fix login page"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        store = make_store()
+        self.assertEqual(titles(search(store.all(), "tag:work")),
+                         ["Fix login page", "write report"])
+        self.assertEqual(titles(search(store.all(), "tag:WORK")),
+                         ["Fix login page", "write report"])
+        self.assertEqual(titles(search(store.all(), "tag:wor")), [])
+
+    def test_status_matches_open_and_done(self):
+        store = make_store()
+        self.assertEqual(titles(search(store.all(), "status:open")),
+                         ["Fix login page", "write report", "fix login bug"])
+        self.assertEqual(titles(search(store.all(), "status:done")),
+                         ["retire the Report generator"])
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), "status:pending")
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), "priority:high")
+
+    def test_empty_field_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(make_store().all(), '"fix login')
+
+    def test_quoted_colon_is_plain_text(self):
+        store = TaskStore()
+        store.add("status:done is a title")
+        self.assertEqual(titles(search(store.all(), '"status:done"')),
+                         ["status:done is a title"])
+
+    def test_empty_and_blank_query_match_everything(self):
+        store = make_store()
+        for query in ("", "   ", "\t"):
+            self.assertEqual(titles(search(store.all(), query)), titles(store.all()))
+
+    def test_results_keep_input_order(self):
+        store = make_store()
+        reversed_tasks = list(reversed(store.all()))
+        self.assertEqual(titles(search(reversed_tasks, "login")),
+                         ["fix login bug", "Fix login page"])
+
+    def test_parse_query_returns_terms(self):
+        self.assertEqual(parse_query('a "b c" tag:x status:done'),
+                         [(None, "a"), (None, "b c"), ("tag", "x"), ("status", "done")])
+
+
+if __name__ == "__main__":
+    unittest.main()
