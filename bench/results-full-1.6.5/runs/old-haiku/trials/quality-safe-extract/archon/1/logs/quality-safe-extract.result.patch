 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Create the regular files in entries under root and return their names."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    plans = _plan_batch(entries, root_path)
+    _write_entries(root_path, plans)
+    return [name for name, _ in entries]
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError("root must be a nonempty str or pathlib.Path")
+    root_path = Path(root)
+    if root_path.is_symlink():
+        raise ValueError(f"root {str(root_path)!r} must not be a symlink")
+    if not root_path.is_dir():
+        raise ValueError(f"root {str(root_path)!r} must be an existing directory")
+    return root_path
+
+
+def _plan_batch(entries, root):
+    """Validate every entry against the batch and the filesystem; create nothing."""
+    parsed = [_parse_entry(entry) for entry in entries]
+    part_lists = [parts for parts, _ in parsed]
+    _check_names_in_batch(part_lists)
+    for parts in part_lists:
+        _check_target(root, parts)
+    return parsed
+
+
+def _parse_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be a str, got {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, got {type(data).__name__}")
+    return _split_name(name), data
+
+
+def _split_name(name):
+    """Return the path components of a relative POSIX name, or raise ValueError."""
+    if name == "":
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"absolute name {name!r} is not allowed")
+    for char in FORBIDDEN_NAME_CHARS:
+        if char in name:
+            raise ValueError(f"name {name!r} contains forbidden character {char!r}")
+    parts = tuple(name.split("/"))
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise ValueError(f"name {name!r} has an empty, '.' or '..' component")
+    _check_encodable(name)
+    return parts
+
+
+def _check_encodable(name):
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as error:
+        raise ValueError(f"name {name!r} cannot be encoded as a filename") from error
+
+
+def _check_names_in_batch(part_lists):
+    seen = set()
+    for parts in part_lists:
+        if parts in seen:
+            raise ValueError(f"duplicate name {'/'.join(parts)!r}")
+        seen.add(parts)
+    for parts in part_lists:
+        for depth in range(1, len(parts)):
+            if parts[:depth] in seen:
+                raise ValueError(f"{'/'.join(parts)!r} collides with a file in the batch")
+
+
+def _lstat_or_none(path):
+    """Return lstat info, or None only when path is absent. Other OSErrors propagate."""
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _check_target(root, parts):
+    """Raise ValueError unless parts can be created fresh below root."""
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        _check_existing_directory(current, info)
+    target = current / parts[-1]
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"{str(target)!r} already exists")
+
+
+def _check_existing_directory(path, info):
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"{str(path)!r} is a symlink")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"{str(path)!r} exists and is not a directory")
+
+
+def _write_entries(root, plans):
+    for parts, data in plans:
+        target = root.joinpath(*parts)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with open(target, "xb") as handle:
+            handle.write(data)
