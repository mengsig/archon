+// Serves the given response bodies in order and records every request.
+function pagedTransport(bodies) {
+  const requests = [];
+  const transport = async (request) => {
+    assert.ok(requests.length < bodies.length, `unexpected request #${requests.length + 1}`);
+    requests.push(request);
+    return { status: 200, body: bodies[requests.length - 1] };
+  };
+  return { transport, requests };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('lists a single page without next_cursor', async () => {
+  const { transport, requests } = pagedTransport([{ items: ITEMS, next_cursor: null }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(requests.length, 1);
+});
+
+test('follows next_cursor across pages in order', async () => {
+  const { transport, requests } = pagedTransport([
+    { items: [ITEMS[0]], next_cursor: 'c2' },
+    { items: [ITEMS[1]], next_cursor: 'c3' },
+    { items: [{ id: 3, sku: 'SKU-0003', qty: 7 }], next_cursor: null },
+  ]);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(requests.map((request) => request.query), [{}, { cursor: 'c2' }, { cursor: 'c3' }]);
+});
+
+test('stops when next_cursor is missing', async () => {
+  const { transport, requests } = pagedTransport([
+    { items: [ITEMS[0]], next_cursor: 'c2' },
+    { items: [ITEMS[1]] },
+  ]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(requests.length, 2);
+});
+
+test('passes the cursor back unchanged', async () => {
+  const cursor = 'a+/=:  ünï 0';
+  const { transport, requests } = pagedTransport([
+    { items: [ITEMS[0]], next_cursor: cursor },
+    { items: [ITEMS[1]], next_cursor: null },
+  ]);
+  await listItems(transport);
+  assert.deepEqual(requests[0].query, {});
+  assert.equal(requests[1].query.cursor, cursor);
+  assert.equal(requests[1].path, '/items');
+});
