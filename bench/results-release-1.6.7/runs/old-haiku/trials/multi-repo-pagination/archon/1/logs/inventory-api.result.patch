 """
 
+import base64
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MAX_DIGITS = 18
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,51 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit = _parse_limit(query.get("limit", str(DEFAULT_LIMIT)))
+    if limit is None:
+        return _error(400, f"limit must be an integer from 1 to {MAX_LIMIT}")
+    after_id = 0
+    if "cursor" in query:
+        after_id = _decode_cursor(query["cursor"])
+        if after_id is None:
+            return _error(400, "invalid cursor")
+    ordered = sorted(ITEMS, key=lambda item: item["id"])
+    remaining = [item for item in ordered if item["id"] > after_id]
+    page = remaining[:limit]
+    assert len(page) <= limit, "page larger than limit"
+    assert all(item["id"] > after_id for item in page), "page item before cursor"
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if not _is_plain_digits(raw):
+        return None
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None
+    return limit
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii").rstrip("=")
+
+
+def _decode_cursor(raw):
+    """Return the id the page starts after, or None when the cursor is invalid."""
+    padded = raw + "=" * (-len(raw) % 4)
+    try:
+        text = base64.urlsafe_b64decode(padded.encode("ascii")).decode("ascii")
+    except ValueError:
+        return None
+    if not _is_plain_digits(text) or _encode_cursor(text) != raw:
+        return None
+    return int(text)
+
+
+def _is_plain_digits(text):
+    """True for ASCII digits only, bounded so int() cannot exceed Python's digit limit."""
+    return text.isascii() and text.isdigit() and len(text) <= MAX_DIGITS
 
 
