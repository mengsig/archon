 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _is_builtin_int(value):
+    return type(value) is int
+
+
+def _validate_name(name):
+    if not isinstance(name, str) or name == "":
+        raise ValueError(f"account name must be a nonempty string, got {name!r}")
+
+
+def _validate_balance(name, balance):
+    if not _is_builtin_int(balance) or not 0 <= balance <= MAX_BALANCE:
+        raise ValueError(
+            f"balance for {name!r} must be an integer in [0, {MAX_BALANCE}], got {balance!r}"
+        )
+
+
+def _validate_amount(amount):
+    if not _is_builtin_int(amount) or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(
+            f"amount must be an integer in [1, {MAX_BALANCE}], got {amount!r}"
+        )
+
+
+def _validate_balances(balances):
+    if not isinstance(balances, dict):
+        raise ValueError(f"balances must be a dict, got {type(balances).__name__}")
+    for name, balance in balances.items():
+        _validate_name(name)
+        _validate_balance(name, balance)
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        # Copy first, then validate the copy: a dict subclass may lie in items().
+        self._balances = dict(balances) if isinstance(balances, dict) else balances
+        _validate_balances(self._balances)
+        # Lock ordering: one lock guards every balance, so there is never a
+        # second lock to acquire and opposite-direction transfers cannot deadlock.
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _validate_amount(amount)
+        self._require_account(source)
+        self._require_account(destination)
+        with self._lock:
+            if source == destination:
+                return self._balances[source] >= amount
+            return self._move(source, destination, amount)
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    # Safe outside the lock because the set of account names never changes after __init__.
+    def _require_account(self, name):
+        if not isinstance(name, str) or name not in self._balances:
+            raise KeyError(name)
+
+    def _move(self, source, destination, amount):
+        # Caller holds self._lock and has validated both account names.
+        if self._balances[source] < amount:
+            return False
+        if self._balances[destination] > MAX_BALANCE - amount:
+            return False
+        self._balances[source] -= amount
+        self._balances[destination] += amount
+        return True
