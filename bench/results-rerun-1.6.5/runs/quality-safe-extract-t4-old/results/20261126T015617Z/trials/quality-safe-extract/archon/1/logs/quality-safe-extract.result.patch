@@ -1,5 +1,125 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+
+_OPEN_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_BINARY", 0)
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Validate the whole batch, then write it under root. Return names in input order."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    _validate_entries(entries)
+    for name, _ in entries:
+        _check_target(root_path, name)
+    _write_entries(root_path, entries)
+    return [name for name, _ in entries]
+
+
+def _lstat_or_none(path):
+    """Return lstat(path), or None when the path is absent. Other OS errors propagate."""
+    try:
+        return os.lstat(path)
+    except (FileNotFoundError, NotADirectoryError):
+        return None
+
+
+def _validate_root(root):
+    if isinstance(root, os.PathLike):
+        root = os.fspath(root)
+    if not isinstance(root, str) or not root:
+        raise ValueError("root must be a nonempty str or pathlib.Path")
+    path = os.path.abspath(root)
+    st = _lstat_or_none(path)
+    if st is None:
+        raise ValueError(f"root does not exist: {root!r}")
+    if stat.S_ISLNK(st.st_mode):
+        raise ValueError(f"root must not be a symlink: {root!r}")
+    if not stat.S_ISDIR(st.st_mode):
+        raise ValueError(f"root is not a directory: {root!r}")
+    return path
+
+
+def _validate_entries(entries):
+    for index, entry in enumerate(entries):
+        _validate_entry(index, entry)
+    _check_collisions([name for name, _ in entries])
+
+
+def _validate_entry(index, entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    _validate_name(index, name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry {index}: data must be bytes")
+
+
+def _validate_name(index, name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry {index}: name must be a str")
+    if not name or name.startswith("/"):
+        raise ValueError(f"entry {index}: name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry {index}: name contains a forbidden character: {name!r}")
+    if any(part in ("", ".", "..") for part in name.split("/")):
+        raise ValueError(f"entry {index}: name has an empty, '.' or '..' component: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry {index}: name is not valid UTF-8: {name!r}") from exc
+
+
+def _check_collisions(names):
+    """Reject duplicate names and names that are both a file and a directory in the batch."""
+    existing = set()
+    for name in names:
+        if name in existing:
+            raise ValueError(f"duplicate name: {name!r}")
+        existing.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in existing:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in the batch")
+
+
+def _check_target(root, name):
+    """Raise ValueError if writing name under root would hit an existing path or a link."""
+    parts = name.split("/")
+    current = root
+    for component in parts[:-1]:
+        current = os.path.join(current, component)
+        st = _lstat_or_none(current)
+        if st is None:
+            # A missing ancestor means the target is missing too.
+            return
+        if stat.S_ISLNK(st.st_mode):
+            raise ValueError(f"{name!r}: path component is a symlink: {current!r}")
+        if not stat.S_ISDIR(st.st_mode):
+            raise ValueError(f"{name!r}: path component is not a directory: {current!r}")
+    target = os.path.join(current, parts[-1])
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"{name!r}: target already exists: {target!r}")
+
+
+def _write_entries(root, entries):
+    for name, data in entries:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            directory = os.path.join(root, *parts[:depth])
+            if _lstat_or_none(directory) is None:
+                os.mkdir(directory)
+        _write_new_file(os.path.join(root, *parts), data)
+
+
+def _write_new_file(path, data):
+    assert isinstance(data, bytes), "data must be bytes"
+    assert os.path.isdir(os.path.dirname(path)), "parent directory must exist before writing"
+    fd = os.open(path, _OPEN_FLAGS, 0o666)
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
