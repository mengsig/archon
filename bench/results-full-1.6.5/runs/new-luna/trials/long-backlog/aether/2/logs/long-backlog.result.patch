     def get(self, task_id):
@@ -27,12 +35,26 @@ class TaskStore:
     def complete(self, task_id):
         task = self.get(task_id)
         task.status = DONE
+        self._history.append(("complete", task_id))
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        snapshot = deepcopy(task)
         del self._tasks[task_id]
+        self._history.append(("delete", snapshot))
         return task
 
+    def undo(self):
+        if not self._history:
+            raise NothingToUndo("no operation to undo")
+        operation, value = self._history.pop()
+        if operation == "add":
+            del self._tasks[value]
+        elif operation == "complete":
+            self._tasks[value].status = OPEN
+        else:
+            self._tasks[value.id] = value
