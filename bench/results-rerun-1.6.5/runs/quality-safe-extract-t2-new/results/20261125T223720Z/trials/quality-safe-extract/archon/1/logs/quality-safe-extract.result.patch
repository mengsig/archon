-            self.assertEqual(list(Path(directory).iterdir()), [])
+
+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.base = Path(self._tmp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def assertRejectedWithoutChanges(self, entries, root=None):
+        before = snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(snapshot(self.base), before)
+
+
+class ExtractBasics(TempRootCase):
+    def test_nested_files_and_exact_bytes(self):
+        entries = [("docs/readme.txt", b"hello"), ("empty", b""), ("bin", b"\x00\xff\n")]
+        self.assertEqual(extract(entries, self.root), ["docs/readme.txt", "empty", "bin"])
+        self.assertEqual((self.root / "docs/readme.txt").read_bytes(), b"hello")
+        self.assertEqual((self.root / "empty").read_bytes(), b"")
+        self.assertEqual((self.root / "bin").read_bytes(), b"\x00\xff\n")
+
+    def test_returns_names_in_input_order(self):
+        entries = [("z", b"1"), ("a/b", b"2"), ("m", b"3")]
+        self.assertEqual(extract(entries, str(self.root)), ["z", "a/b", "m"])
+
+    def test_empty_batch_returns_empty_list(self):
+        self.assertEqual(extract([], self.root), [])
+        self.assertEqual(snapshot(self.root), [])
+
+    def test_empty_batch_still_validates_root(self):
+        plain = self.base / "plain.txt"
+        plain.write_bytes(b"")
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        for bad_root in (self.base / "missing", plain, link):
+            with self.subTest(root=bad_root.name):
+                with self.assertRaises(ValueError):
+                    extract([], bad_root)
+
+    def test_write_into_existing_real_directory(self):
+        (self.root / "real").mkdir()
+        (self.root / "real" / "sibling").write_bytes(b"keep")
+        self.assertEqual(extract([("real/x", b"1")], self.root), ["real/x"])
+        self.assertEqual((self.root / "real" / "x").read_bytes(), b"1")
+        self.assertEqual((self.root / "real" / "sibling").read_bytes(), b"keep")
+
+    def test_accepts_str_and_path_roots(self):
+        self.assertEqual(extract([("a", b"x")], str(self.root)), ["a"])
+        self.assertEqual(extract([("b", b"y")], self.root), ["b"])
+
+    def test_creates_missing_parent_directories(self):
+        extract([("a/b/c/d.txt", b"deep")], self.root)
+        self.assertEqual((self.root / "a/b/c/d.txt").read_bytes(), b"deep")
+
+    def test_percent_signs_are_literal(self):
+        entries = [("100%.txt", b"p"), ("%2e%2e/x", b"q")]
+        extract(entries, self.root)
+        self.assertEqual((self.root / "100%.txt").read_bytes(), b"p")
+        self.assertEqual((self.root / "%2e%2e/x").read_bytes(), b"q")
+
+    def test_prefix_name_is_not_a_collision(self):
+        extract([("a", b"1"), ("ab", b"2"), ("a-b/c", b"3")], self.root)
+        self.assertEqual(snapshot(self.root), ["a", "a-b", "a-b/c", "ab"])
+
+
+class BatchTypeErrors(TempRootCase):
+    def test_non_list_batches_are_rejected_even_when_empty(self):
+        for batch in ((), ("a", b"x"), None, {}, ""):
+            with self.subTest(batch=type(batch).__name__):
+                self.assertRejectedWithoutChanges(batch)
+
+    def test_iterator_and_generator_are_not_consumed(self):
+        generator = ((name, b"x") for name in ["a", "b"])
+        iterator = iter([("a", b"x")])
+        for batch in (generator, iterator):
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+                self.assertEqual(snapshot(self.root), [])
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(next(iterator), ("a", b"x"))
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            [["a", b"x"]],
+            [("a",)],
+            [("a", b"x", "extra")],
+            [("a", b"x"), "not-a-tuple"],
+            [None],
+        ]
+        for entries in bad_entries:
+            with self.subTest(entries=entries):
+                self.assertRejectedWithoutChanges(entries)
+
+    def test_non_string_names_are_rejected(self):
+        for name in (b"a", None, 1, ("a",)):
+            with self.subTest(name=name):
+                self.assertRejectedWithoutChanges([(name, b"x")])
+
+    def test_entry_subclasses_cannot_change_between_reads(self):
+        class Shifting(tuple):
+            calls = 0
+
+            def __iter__(self):
+                Shifting.calls += 1
+                return iter(("good", b"x") if Shifting.calls == 1 else ("../evil", b"y"))
+
+        self.assertRejectedWithoutChanges([Shifting(("good", b"x"))])
+        self.assertFalse(os.path.lexists(self.base / "evil"))
+
+    def test_str_and_bytes_subclasses_are_rejected(self):
+        class Name(str):
+            pass
+
+        class Data(bytes):
+            pass
+
+        self.assertRejectedWithoutChanges([(Name("a"), b"x")])
+        self.assertRejectedWithoutChanges([("a", Data(b"x"))])
+
+    def test_non_bytes_data_is_rejected(self):
+        for data in ("text", bytearray(b"x"), None, 3, memoryview(b"x")):
+            with self.subTest(data=type(data).__name__):
+                self.assertRejectedWithoutChanges([("a", data)])
+
