+function paginated(pages) {
+  return async (request) => {
+    const cursor = request.query.cursor ?? null;
+    if (!(request.path === '/items' && pages.has(cursor))) {
+      return { status: 400, body: { error: 'cursor is invalid' } };
+    }
+    return { status: 200, body: pages.get(cursor) };
+  };
+}
+
+test('follows next_cursor across pages, in order', async () => {
+  const transport = paginated(new Map([
+    [null, { items: [ITEMS[0]], next_cursor: '1' }],
+    ['1', { items: [ITEMS[1]], next_cursor: null }],
+  ]));
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const transport = paginated(new Map([[null, { items: ITEMS }]]));
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
+test('rejects a cursor that does not advance', async () => {
+  const transport = paginated(new Map([
+    [null, { items: [ITEMS[0]], next_cursor: '1' }],
+    ['1', { items: [ITEMS[1]], next_cursor: '1' }],
+  ]));
+  await assert.rejects(listItems(transport), /did not advance/);
+});
+
