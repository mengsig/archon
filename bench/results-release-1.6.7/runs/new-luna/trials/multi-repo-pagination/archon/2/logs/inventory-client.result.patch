+test('follows opaque cursors and returns all pages in order', async () => {
+  const requests = [];
+  const cursor = 'opaque/+token==';
+  const transport = async (request) => {
+    requests.push(request);
+    if (requests.length === 1) {
+      return { status: 200, body: { items: [ITEMS[0]], next_cursor: cursor } };
+    }
+    return { status: 200, body: { items: [ITEMS[1]], next_cursor: null } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(requests, [
+    { method: 'GET', path: '/items', query: {} },
+    { method: 'GET', path: '/items', query: { cursor } },
+  ]);
+});
+
+test('stops when next_cursor is absent', async () => {
+  const requests = [];
+  const transport = async (request) => {
+    requests.push(request);
+    return { status: 200, body: { items: ITEMS } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(requests.length, 1);
+  assert.deepEqual(requests[0].query, {});
+});
+
