@@ -0,0 +1,73 @@
+"""RFC 4180 CSV export (TT-102)."""
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+def _task(task_id, title, tags=(), status="open", due=None):
+    return Task(task_id, title, list(tags), status, due)
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_header_only_when_no_tasks(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_plain_row_is_not_quoted(self):
+        tasks = [_task(1, "plain", ["a", "b"], "done", date(2026, 4, 1))]
+        self.assertEqual(to_csv(tasks), HEADER + "1,plain,a;b,done,2026-04-01\r\n")
+
+    def test_rows_keep_input_order(self):
+        tasks = [_task(2, "second"), _task(1, "first")]
+        self.assertEqual(to_csv(tasks), HEADER + "2,second,,open,\r\n1,first,,open,\r\n")
+
+    def test_empty_tags_and_due_are_empty_fields(self):
+        self.assertEqual(to_csv([_task(3, "bare")]), HEADER + "3,bare,,open,\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        tasks = [_task(1, "milk, eggs")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"milk, eggs",,open,\r\n')
+
+    def test_title_with_quote_is_quoted_and_doubled(self):
+        tasks = [_task(1, 'say "hi"')]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"say ""hi""",,open,\r\n')
+
+    def test_title_with_lf_is_quoted(self):
+        tasks = [_task(1, "line one\nline two")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"line one\nline two",,open,\r\n')
+
+    def test_title_with_cr_is_quoted(self):
+        tasks = [_task(1, "carriage\rreturn")]
+        self.assertEqual(to_csv(tasks), HEADER + '1,"carriage\rreturn",,open,\r\n')
+
+    def test_title_with_quote_comma_and_newline_round_trips(self):
+        title = 'a, "b"\r\nc'
+        text = to_csv([_task(7, title, ["x;y"], "done", date(2026, 1, 2))])
+        rows = list(csv.reader(io.StringIO(text, newline="")))
+        self.assertEqual(rows, [
+            ["id", "title", "tags", "status", "due"],
+            ["7", title, "x;y", "done", "2026-01-02"],
+        ])
+
+    def test_tags_with_semicolon_are_joined_not_quoted(self):
+        tasks = [_task(1, "t", ["a", "b", "c"])]
+        self.assertEqual(to_csv(tasks), HEADER + "1,t,a;b;c,open,\r\n")
+
+    def test_comma_in_tags_quotes_the_tags_field(self):
+        tasks = [_task(1, "t", ["a,b"])]
+        self.assertEqual(to_csv(tasks), HEADER + '1,t,"a,b",open,\r\n')
+
+    def test_every_line_ends_with_crlf(self):
+        tasks = [_task(1, "x\ny"), _task(2, "z")]
+        text = to_csv(tasks)
+        self.assertTrue(text.endswith("\r\n"))
+        self.assertEqual(text.count("\r\n"), 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
