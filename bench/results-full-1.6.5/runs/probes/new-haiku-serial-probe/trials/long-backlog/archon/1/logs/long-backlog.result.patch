@@ -0,0 +1,63 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+HEADER = "id,title,tags,status,due\r\n"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_list_gives_header_only(self):
+        self.assertEqual(to_csv([]), HEADER)
+
+    def test_every_line_ends_with_crlf(self):
+        tasks = [Task(1, "a", ["x"], due=date(2026, 1, 2)), Task(2, "b")]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + "1,a,x,open,2026-01-02\r\n" + "2,b,,open,\r\n",
+        )
+
+    def test_rows_keep_input_order(self):
+        tasks = [Task(3, "third"), Task(1, "first")]
+        self.assertEqual(to_csv(tasks), HEADER + "3,third,,open,\r\n1,first,,open,\r\n")
+
+    def test_tags_joined_with_semicolon(self):
+        self.assertEqual(
+            to_csv([Task(1, "t", ["work", "home"])]),
+            HEADER + "1,t,work;home,open,\r\n",
+        )
+
+    def test_comma_title_is_quoted(self):
+        self.assertEqual(
+            to_csv([Task(1, "buy milk, eggs")]),
+            HEADER + '1,"buy milk, eggs",,open,\r\n',
+        )
+
+    def test_quote_is_doubled_and_field_wrapped(self):
+        self.assertEqual(
+            to_csv([Task(1, 'say "hi"')]),
+            HEADER + '1,"say ""hi""",,open,\r\n',
+        )
+
+    def test_newlines_and_carriage_returns_are_quoted(self):
+        self.assertEqual(
+            to_csv([Task(1, "line one\nline two"), Task(2, "cr\rhere")]),
+            HEADER + '1,"line one\nline two",,open,\r\n2,"cr\rhere",,open,\r\n',
+        )
+
+    def test_quoting_applies_to_tags_too(self):
+        self.assertEqual(
+            to_csv([Task(1, "t", ['a"b'])]),
+            HEADER + '1,t,"a""b",open,\r\n',
+        )
+
+    def test_plain_fields_are_not_quoted(self):
+        self.assertEqual(
+            to_csv([Task(1, "plain title", ["a"], status="done", due=date(2026, 5, 6))]),
+            HEADER + "1,plain title,a,done,2026-05-06\r\n",
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
