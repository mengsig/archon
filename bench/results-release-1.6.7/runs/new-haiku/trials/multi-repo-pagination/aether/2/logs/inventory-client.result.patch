 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor = null;
+  for (;;) {
+    const page = await fetchItemsPage(transport, cursor);
+    items.push(...page.items);
+    if (page.next_cursor == null) return items;
+    if (seenCursors.has(page.next_cursor)) {
+      throw new Error(`GET /items repeated cursor ${page.next_cursor}`);
+    }
+    seenCursors.add(page.next_cursor);
+    cursor = page.next_cursor;
+  }
 }
 
