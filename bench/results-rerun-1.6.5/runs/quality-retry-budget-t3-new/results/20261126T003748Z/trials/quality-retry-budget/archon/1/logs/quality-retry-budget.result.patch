diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..8886e55 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,46 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate_args(attempt, elapsed_ms, max_attempts, budget_ms,
+                   base_ms, cap_ms, retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    assert delay >= 0
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _validate_args(attempt, elapsed_ms, max_attempts, budget_ms,
+                   base_ms, cap_ms, retry_after_ms):
+    _check_int("attempt", attempt, 1)
+    _check_int("max_attempts", max_attempts, 1)
+    _check_int("elapsed_ms", elapsed_ms, 0)
+    _check_int("budget_ms", budget_ms, 0)
+    _check_int("base_ms", base_ms, 0)
+    _check_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, 0)
+
+
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without huge powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    doublings = attempt - 1
+    # base_ms >= 1 here, so 2**doublings > cap_ms once doublings reaches
+    # cap_ms.bit_length(); the shift is then never needed.
+    if base_ms >= cap_ms or doublings >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << doublings)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..9161e28 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,125 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def assertRejects(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_and_float(self):
+        self.assertRejects(True, 0)
+        self.assertRejects(1, False)
+        self.assertRejects(1.0, 0)
+        self.assertRejects(1, 0.0)
+        self.assertRejects(1, 0, max_attempts=4.0)
+        self.assertRejects(1, 0, budget_ms=True)
+        self.assertRejects(1, 0, base_ms=1.5)
+        self.assertRejects(1, 0, cap_ms=False)
+        self.assertRejects(1, 0, retry_after_ms=10.0)
+        self.assertRejects(1, 0, retry_after_ms=True)
+
+    def test_rejects_non_numeric(self):
+        self.assertRejects("1", 0)
+        self.assertRejects(1, None)
+
+    def test_rejects_out_of_range(self):
+        self.assertRejects(0, 0)
+        self.assertRejects(1, -1)
+        self.assertRejects(1, 0, max_attempts=0)
+        self.assertRejects(1, 0, budget_ms=-1)
+        self.assertRejects(1, 0, base_ms=-1)
+        self.assertRejects(1, 0, cap_ms=-1)
+        self.assertRejects(1, 0, retry_after_ms=-1)
+
+    def test_zero_is_valid_where_spec_allows(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=0, base_ms=0), None)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_validation_runs_before_attempt_limit(self):
+        self.assertRejects(4, 0, max_attempts=4, base_ms=-1)
+        self.assertRejects(4, -1, max_attempts=4)
+        self.assertRejects(0, 0, max_attempts=1)
+
+    def test_validation_runs_before_budget_exhaustion(self):
+        self.assertRejects(1, 2000, budget_ms=1000, retry_after_ms=-5)
+        self.assertRejects(1, 2000, budget_ms=1000, cap_ms="x")
+
+    def test_huge_ints_are_accepted(self):
+        self.assertIsNone(retry_delay(1, 10**30))
+        self.assertIsNone(retry_delay(10**30, 0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=10**30,
+                                      retry_after_ms=10**30))
+        self.assertEqual(retry_delay(1, 0, budget_ms=10**30,
+                                     retry_after_ms=10**29), 10**29)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=3))
+
+    def test_attempt_limit_wins_over_budget_and_retry_after(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4,
+                                      retry_after_ms=5000))
+
+
+class Backoff(unittest.TestCase):
+    def test_doubles_then_caps(self):
+        delays = [retry_delay(a, 0, max_attempts=10, budget_ms=10**9)
+                  for a in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(5, 0, base_ms=0, max_attempts=9), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0, max_attempts=9), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1, budget_ms=10**30),
+            400)
+        self.assertEqual(
+            retry_delay(10**18, 0, base_ms=1, cap_ms=10**30,
+                        max_attempts=10**18 + 1, budget_ms=10**40),
+            10**30)
+
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=50, retry_after_ms=300),
+                         300)
+
+    def test_retry_after_below_backoff_is_ignored(self):
+        self.assertEqual(retry_delay(3, 0, retry_after_ms=10), 400)
+
+
+class Budget(unittest.TestCase):
+    def test_exact_budget_boundary_is_exhausted(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_delay_pushing_past_budget_is_none(self):
+        self.assertIsNone(retry_delay(2, 900, budget_ms=1000))
+
+    def test_wait_is_not_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(1, 950, budget_ms=1000,
+                                      retry_after_ms=100))
+
+    def test_zero_delay_still_needs_time_before_budget(self):
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+
+    def test_zero_budget_allows_nothing(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
