+class SymlinkTests(TreeCase):
+    def test_symlink_to_file_at_target_is_not_followed(self):
+        victim = self.outside / "victim"
+        victim.write_bytes(b"keep")
+        (self.root / "l").symlink_to(victim)
+        with self.assertRaises(ValueError):
+            extract([("l", b"x")], self.root)
+        self.assertEqual(victim.read_bytes(), b"keep")
+
+    def test_dangling_symlink_at_target_is_not_followed(self):
+        (self.root / "l").symlink_to(self.outside / "missing")
+        with self.assertRaises(ValueError):
+            extract([("l", b"x")], self.root)
+        self.assertFalse((self.outside / "missing").exists())
+
+    def test_symlink_ancestor_inside_root_is_rejected(self):
+        (self.root / "real").mkdir()
+        (self.root / "link").symlink_to(self.root / "real", target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"x")], self.root)
+        self.assertEqual(list((self.root / "real").iterdir()), [])
+
+    def test_symlink_ancestor_outside_root_is_rejected(self):
+        (self.root / "link").symlink_to(self.outside, target_is_directory=True)
+        with self.assertRaises(ValueError):
+            extract([("link/x", b"x")], self.root)
