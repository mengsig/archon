+    def test_fractional_refill_wait_and_backward_clock(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertAlmostEqual(bucket.wait_time(1), 0.25)
+        self.assertAlmostEqual(bucket.available(), 0.5)  # wait does not consume
+        clock.now = 0.1
+        self.assertAlmostEqual(bucket.available(), 0.5)  # backward time adds nothing
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_keyed_lru_uses_waits_and_evicted_keys_restart_full(self):
+        limiter = KeyedLimiter(2, 1.0, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a", 2))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(limiter.wait_time("a", 2), 2.0)
+        limiter.try_acquire("c")  # wait_time made a recent, so b is evicted
+        self.assertEqual(len(limiter), 2)
+        self.assertEqual(limiter.wait_time("a", 2), 2.0)
+        self.assertTrue(limiter.try_acquire("b", 2))  # evicted b starts full
+
     def test_keys_are_independent(self):
         limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
         self.assertTrue(limiter.try_acquire("a"))
