diff --git a/safe_extract.py b/safe_extract.py
index 0007027..3401121 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,119 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _check_batch_type(entries)
+    root_path = _check_root(root)
+    targets = _plan_batch(entries, root_path)
+    for (_, data), target in zip(entries, targets):
+        _write_file(target, data)
+    return [name for name, _ in entries]
+
+
+def _check_batch_type(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _check_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, not {type(root).__name__}")
+    if root == "":
+        raise ValueError("root must not be an empty string")
+    root_path = Path(root)
+    if os.path.islink(root_path):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not root_path.is_dir():
+        raise ValueError(f"root must be an existing directory: {root_path}")
+    return root_path
+
+
+def _plan_batch(entries, root):
+    """Validate every entry against the batch and the filesystem; return target paths."""
+    files = set()
+    dirs = set()
+    targets = []
+    for entry in entries:
+        name, data = _check_entry(entry)
+        parts = _check_name(name)
+        ancestors = ["/".join(parts[:i]) for i in range(1, len(parts))]
+        _check_no_batch_conflict(name, ancestors, files, dirs)
+        files.add(name)
+        dirs.update(ancestors)
+        _check_on_disk(root, parts)
+        targets.append(root.joinpath(*parts))
+    assert len(files) == len(entries)
+    return targets
+
+
+def _check_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, got {type(entry).__name__}")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be a str, not {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes, not {type(data).__name__}")
+    return name, data
+
+
+def _check_name(name):
+    if not name:
+        raise ValueError("entry name must not be empty")
+    forbidden = [char for char in _FORBIDDEN_NAME_CHARS if char in name]
+    if forbidden:
+        raise ValueError(f"entry name {name!r} contains forbidden characters {forbidden!r}")
+    if name.startswith("/"):
+        raise ValueError(f"entry name {name!r} must be relative")
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as error:
+        raise ValueError(f"entry name {name!r} cannot be encoded for the filesystem") from error
+    parts = name.split("/")
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name {name!r} has an empty, '.' or '..' component")
+    return parts
+
+
+def _check_no_batch_conflict(name, ancestors, files, dirs):
+    if name in files:
+        raise ValueError(f"duplicate entry name: {name!r}")
+    if name in dirs:
+        raise ValueError(f"entry name {name!r} is a directory of another entry")
+    for ancestor in ancestors:
+        if ancestor in files:
+            raise ValueError(f"entry name {name!r} is inside file entry {ancestor!r}")
+
+
+def _path_exists(path):
+    try:
+        os.lstat(path)
+    except FileNotFoundError:
+        return False
+    return True
+
+
+def _check_on_disk(root, parts):
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        if not _path_exists(current):
+            return
+        if os.path.islink(current) or not current.is_dir():
+            raise ValueError(f"path component is not a real directory: {current}")
+    target = current / parts[-1]
+    if _path_exists(target):
+        raise ValueError(f"target already exists: {target}")
+
+
+def _write_file(target, data):
+    target.parent.mkdir(parents=True, exist_ok=True)
+    assert target.parent.is_dir()
+    with open(target, "xb") as handle:
+        handle.write(data)
