+async function fetchItemsPage(transport, cursor) {
+  const query = cursor === null ? {} : { cursor };
+  const body = await request(transport, '/items', query);
+  if (!Array.isArray(body.items)) {
+    throw new Error('GET /items response has no items array');
+  }
+  return body;
+}
