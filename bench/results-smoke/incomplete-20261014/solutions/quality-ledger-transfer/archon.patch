+class Concurrency(unittest.TestCase):
+    ROUNDS = 1000
+    THREAD_JOIN_LIMIT = 60
+    SWITCH_INTERVAL = 1e-6
+
+    def setUp(self):
+        self.saved_interval = sys.getswitchinterval()
+        sys.setswitchinterval(self.SWITCH_INTERVAL)
+
+    def tearDown(self):
+        sys.setswitchinterval(self.saved_interval)
+
+    def test_opposite_transfers_do_not_deadlock_and_conserve_total(self):
+        ledger = Ledger({"a": self.ROUNDS, "b": self.ROUNDS})
+        results = []
+
+        def move(source, destination):
+            for _ in range(self.ROUNDS):
+                results.append(ledger.transfer(source, destination, 1))
+
+        def watch():
+            for _ in range(self.ROUNDS):
+                snap = ledger.snapshot()
+                totals.append(sum(snap.values()))
+
+        totals = []
+        threads = [
+            threading.Thread(target=move, args=("a", "b"), daemon=True),
+            threading.Thread(target=move, args=("b", "a"), daemon=True),
+            threading.Thread(target=watch, daemon=True),
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.THREAD_JOIN_LIMIT)
+        self.assertFalse(any(thread.is_alive() for thread in threads))
+        self.assertEqual(len(results), 2 * self.ROUNDS)
+        self.assertTrue(all(results))
+        self.assertEqual(ledger.snapshot(), {"a": self.ROUNDS, "b": self.ROUNDS})
+        self.assertEqual(set(totals), {2 * self.ROUNDS})
+
+
+if __name__ == "__main__":
+    unittest.main()
