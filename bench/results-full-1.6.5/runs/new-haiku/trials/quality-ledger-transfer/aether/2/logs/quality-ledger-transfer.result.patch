+class LedgerConservation(unittest.TestCase):
+    def test_total_preserved_over_mixed_transfers(self):
+        ledger = Ledger({"a": 50, "b": 30, "c": 20})
+        moves = [("a", "b", 10), ("b", "c", 35), ("c", "a", 5), ("a", "c", 99)]
+        for source, destination, amount in moves:
