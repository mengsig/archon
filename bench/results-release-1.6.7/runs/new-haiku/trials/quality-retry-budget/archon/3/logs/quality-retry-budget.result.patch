+class Validation(unittest.TestCase):
+    def test_rejects_bool_float_and_subclass(self):
+        bad_values = [True, False, 1.0, 2.5, IntSubclass(2), "1", None]
+        for bad in bad_values:
+            with self.subTest(attempt=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(bad, 0)
+            with self.subTest(elapsed_ms=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, bad)
+            with self.subTest(max_attempts=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, max_attempts=bad)
+
+    def test_rejects_bool_float_and_subclass_for_budget_and_delays(self):
+        for name in ("budget_ms", "base_ms", "cap_ms"):
+            for bad in (True, 1.0, IntSubclass(1)):
+                with self.subTest(name=name, value=bad):
+                    with self.assertRaises(ValueError):
+                        retry_delay(1, 0, **{name: bad})
+
+    def test_rejects_bool_float_and_subclass_for_retry_after(self):
+        for bad in (True, 1.0, IntSubclass(1)):
+            with self.subTest(value=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, retry_after_ms=bad)
+
+    def test_lower_bounds(self):
+        cases = [
+            {"attempt": 0, "elapsed_ms": 0},
+            {"attempt": 1, "elapsed_ms": -1},
+            {"attempt": 1, "elapsed_ms": 0, "max_attempts": 0},
+            {"attempt": 1, "elapsed_ms": 0, "budget_ms": -1},
+            {"attempt": 1, "elapsed_ms": 0, "base_ms": -1},
+            {"attempt": 1, "elapsed_ms": 0, "cap_ms": -1},
+            {"attempt": 1, "elapsed_ms": 0, "retry_after_ms": -1},
+        ]
+        for kwargs in cases:
+            with self.subTest(kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(**kwargs)
+
+    def test_zero_is_valid_for_non_attempt_arguments(self):
+        self.assertEqual(retry_delay(1, 0, budget_ms=1, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0, base_ms=0), 0)
+
+    def test_invalid_argument_raises_when_attempts_exhausted(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, max_attempts=4, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, max_attempts=4, retry_after_ms=1.0)
+
+    def test_invalid_argument_raises_when_budget_exhausted(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=1000, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1, budget_ms=0)
+
+
+class AttemptBoundary(unittest.TestCase):
+    def test_last_allowed_attempt_returns_none(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_above_max_is_none(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=2))
+        self.assertIsNone(retry_delay(2, 0, max_attempts=1))
+
+
+class BackoffShape(unittest.TestCase):
+    def test_zero_base_gives_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_gives_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_returns_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+        self.assertEqual(retry_delay(1, 0, base_ms=10**9, cap_ms=400), 400)
+
+    def test_backoff_saturates_at_cap(self):
+        self.assertEqual(retry_delay(10, 0, max_attempts=20, budget_ms=10**9),
+                         400)
+
+    def test_huge_attempt_is_fast(self):
+        huge = 10**100
+        self.assertEqual(
+            retry_delay(huge, 0, max_attempts=huge + 1, budget_ms=10**9),
+            400)
+        self.assertIsNone(retry_delay(huge, 0, max_attempts=huge))
+
+    def test_huge_base_and_cap_are_fast(self):
+        big = 10**200
+        self.assertEqual(
+            retry_delay(10**50, 0, max_attempts=10**51, base_ms=1,
+                        cap_ms=big, budget_ms=big + 1),
+            big)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_floor_above_cap_is_not_limited(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=5000, budget_ms=10000), 5000)
+
+    def test_retry_after_below_backoff_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=25), 200)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class BudgetBoundary(unittest.TestCase):
+    def test_elapsed_plus_delay_equal_to_budget_is_none(self):
+        self.assertIsNone(retry_delay(3, 600, budget_ms=1000))
+
+    def test_one_below_budget_returns_delay(self):
+        self.assertEqual(retry_delay(3, 599, budget_ms=1000), 400)
+
+    def test_wait_is_never_shortened_to_fit(self):
+        self.assertIsNone(
+            retry_delay(1, 0, budget_ms=100, retry_after_ms=100))
+
+    def test_zero_delay_within_budget_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_with_zero_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
