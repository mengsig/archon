     def get(self, task_id):
@@ -26,13 +34,30 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._history.append(("complete", task.id, task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        snapshot = deepcopy(task)
+        self._history.append(("delete", task_id, snapshot))
         del self._tasks[task_id]
         return task
 
+    def undo(self):
+        if not self._history:
+            raise NothingToUndo("nothing to undo")
+        operation = self._history.pop()
+        kind = operation[0]
+        if kind == "add":
+            del self._tasks[operation[1]]
+        elif kind == "complete":
+            _, task_id, previous_status = operation
+            self._tasks[task_id].status = previous_status
+        else:
+            _, task_id, task = operation
+            self._tasks[task_id] = task
+
     def all(self):
         return sorted(self._tasks.values(), key=lambda t: t.id)
