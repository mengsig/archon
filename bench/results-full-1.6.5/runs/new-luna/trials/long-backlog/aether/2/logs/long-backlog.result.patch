diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..ea0e430 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,53 @@
+class QueryError(ValueError):
+    pass
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+        elif char.isspace() and not quoted:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+
+    def matches(task, term):
+        if ":" not in term:
+            return term.casefold() in task.title.casefold()
+        field, value = term.split(":", 1)
+        field = field.casefold()
+        if field == "tag":
+            wanted = value.casefold()
+            return any(tag.casefold() == wanted for tag in task.tags)
+        if field == "status":
+            wanted = value.casefold()
+            if wanted not in ("open", "done"):
+                raise QueryError(f"unknown status: {value}")
+            return task.status.casefold() == wanted
+        raise QueryError(f"unknown query field: {field}")
+
+    # Validate syntax even when an earlier term would exclude every task.
+    for term in terms:
+        if ":" in term:
+            field, value = term.split(":", 1)
+            if field.casefold() not in ("tag", "status"):
+                raise QueryError(f"unknown query field: {field}")
+            if not value:
+                raise QueryError(f"empty query value for {field}")
+            if field.casefold() == "status" and value.casefold() not in ("open", "done"):
+                raise QueryError(f"unknown status: {value}")
+    return [task for task in tasks if all(matches(task, term) for term in terms)]
