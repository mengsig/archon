+class ExtractValidation(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(dir=".")
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name) / "root"
+        self.root.mkdir()
+
+    def snapshot(self):
+        result = {}
+        for path in sorted(self.root.rglob("*")):
+            relative = path.relative_to(self.root).as_posix()
+            if path.is_symlink():
+                result[relative] = ("symlink", str(path.readlink()))
+            elif path.is_dir():
+                result[relative] = ("directory",)
+            else:
+                result[relative] = ("file", path.read_bytes())
+        return result
+
+    def assert_invalid_without_changes(self, entries, root=None):
+        before = self.snapshot()
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(self.snapshot(), before)
+
+    def test_non_list_batches_are_rejected_without_consuming(self):
+        def entries():
+            self.fail("generator must not be consumed")
+            yield ("file", b"data")
+
+        for batch in (("file", b"data"), iter([("file", b"data")]), entries()):
+            with self.subTest(batch_type=type(batch).__name__):
+                self.assert_invalid_without_changes(batch)
+
+    def test_malformed_entries_and_data_are_rejected(self):
+        for batch in (
+            ["not a pair"],
+            [("one", b"two", b"three")],
+            [(None, b"data")],
+            [("file", bytearray(b"data"))],
+        ):
+            with self.subTest(batch=batch):
+                self.assert_invalid_without_changes(batch)
+
+    def test_invalid_path_syntax(self):
+        for name in (
+            "", "/absolute", "a//b", "a/./b", "a/../b", "a/", "./a",
+            "..", "a\\b", "C:/file", "dir:name", "nul\0name",
+        ):
+            with self.subTest(name=name):
+                self.assert_invalid_without_changes([(name, b"data")])
+
+    def test_percent_is_literal_and_valid(self):
+        self.assertEqual(extract([("100%25.txt", b"percent")], self.root), ["100%25.txt"])
+        self.assertEqual((self.root / "100%25.txt").read_bytes(), b"percent")
+
+    def test_duplicate_names_are_rejected(self):
+        self.assert_invalid_without_changes([("same", b"first"), ("same", b"second")])
+
+    def test_file_directory_collisions_in_both_orders(self):
+        for entries in (
+            [("a", b"file"), ("a/b", b"child")],
+            [("a/b", b"child"), ("a", b"file")],
+        ):
+            with self.subTest(entries=entries):
+                self.assert_invalid_without_changes(entries)
+
+    def test_existing_file_target_and_non_directory_parent_conflict(self):
+        (self.root / "existing").write_bytes(b"keep")
+        self.assert_invalid_without_changes([("existing", b"replace")])
+        self.assert_invalid_without_changes([("existing/child", b"data")])
+
+    def test_existing_directory_target_conflicts(self):
+        (self.root / "directory").mkdir()
+        self.assert_invalid_without_changes([("directory", b"data")])
+
+    def test_root_must_be_existing_real_directory_even_for_empty_batch(self):
+        missing = self.root / "missing"
+        regular_file = self.root / "file"
+        regular_file.write_bytes(b"keep")
+        link = self.root.parent / "root-link"
+        link.symlink_to(self.root, target_is_directory=True)
+        dangling = self.root.parent / "dangling-root"
+        dangling.symlink_to(self.root.parent / "absent-root", target_is_directory=True)
+        for root in (missing, regular_file, link, dangling, 42, PurePath(self.root)):
+            with self.subTest(root=root):
+                with self.assertRaises(ValueError):
+                    extract([], root)
+
+    def test_root_beneath_regular_file_is_invalid(self):
+        file_parent = self.root / "file-parent"
+        file_parent.write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([], file_parent / "root")
+        self.assertEqual(file_parent.read_bytes(), b"keep")
+
+    def test_unexpected_filesystem_io_error_propagates_unchanged(self):
+        error = OSError("unexpected lstat failure")
+        with patch.object(Path, "lstat", side_effect=error):
+            with self.assertRaises(OSError) as caught:
+                extract([], self.root)
+        self.assertIs(caught.exception, error)
+
+    def test_symlink_in_parent_component_is_rejected(self):
+        outside = Path(self.temp.name) / "outside"
+        outside.mkdir()
+        (self.root / "link").symlink_to(outside, target_is_directory=True)
+        self.assert_invalid_without_changes([("link/new", b"data")])
+        self.assertEqual(list(outside.iterdir()), [])
+
+    def test_symlink_target_and_dangling_symlink_are_rejected(self):
+        outside = Path(self.temp.name) / "outside-file"
+        outside.write_bytes(b"keep")
+        (self.root / "link").symlink_to(outside)
+        (self.root / "dangling").symlink_to(self.root / "absent")
+        self.assert_invalid_without_changes([("link", b"replace")])
+        self.assert_invalid_without_changes([("dangling", b"create")])
+        self.assertEqual(outside.read_bytes(), b"keep")
+
+    def test_late_validation_error_does_not_create_earlier_valid_path(self):
+        self.assert_invalid_without_changes([
+            ("new/nested/file", b"would otherwise be written"),
+            ("bad//name", b"invalid"),
+        ])
+
+
+class ExtractSuccess(unittest.TestCase):
+    def test_exact_bytes_and_input_order(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            entries = [
+                ("z-last", b"\x00\xff\n"),
+                ("nested/first", b"first\x00"),
+                ("empty", b""),
+            ]
+            self.assertEqual(extract(entries, str(root)), [name for name, _ in entries])
+            self.assertEqual((root / "z-last").read_bytes(), b"\x00\xff\n")
+            self.assertEqual((root / "nested/first").read_bytes(), b"first\x00")
+            self.assertEqual((root / "empty").read_bytes(), b"")
