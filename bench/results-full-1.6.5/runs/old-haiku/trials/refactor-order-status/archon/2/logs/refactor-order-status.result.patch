diff --git a/src/status.rs b/src/status.rs
new file mode 100644
index 0000000..ddc5c9a
--- /dev/null
+++ b/src/status.rs
@@ -0,0 +1,69 @@
+use std::fmt;
+use std::str::FromStr;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum OrderStatus {
+    Pending,
+    Paid,
+    Shipped,
+    Cancelled,
+}
+
+const ALL: [OrderStatus; 4] = [
+    OrderStatus::Pending,
+    OrderStatus::Paid,
+    OrderStatus::Shipped,
+    OrderStatus::Cancelled,
+];
+
+impl OrderStatus {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            OrderStatus::Pending => "pending",
+            OrderStatus::Paid => "paid",
+            OrderStatus::Shipped => "shipped",
+            OrderStatus::Cancelled => "cancelled",
+        }
+    }
+
+    pub fn can_transition_to(self, next: OrderStatus) -> bool {
+        matches!(
+            (self, next),
+            (OrderStatus::Pending, OrderStatus::Paid)
+                | (OrderStatus::Pending, OrderStatus::Cancelled)
+                | (OrderStatus::Paid, OrderStatus::Shipped)
+                | (OrderStatus::Paid, OrderStatus::Cancelled)
+        )
+    }
+}
+
+impl fmt::Display for OrderStatus {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(self.as_str())
+    }
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct ParseStatusError {
+    input: String,
+}
+
+impl fmt::Display for ParseStatusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "unknown status {:?}", self.input)
+    }
+}
+
+impl std::error::Error for ParseStatusError {}
+
+impl FromStr for OrderStatus {
+    type Err = ParseStatusError;
+
+    fn from_str(s: &str) -> Result<Self, Self::Err> {
+        ALL.into_iter()
+            .find(|status| status.as_str() == s)
+            .ok_or_else(|| ParseStatusError {
+                input: s.to_string(),
+            })
+    }
+}
diff --git a/tests/characterize_reports.rs b/tests/characterize_reports.rs
new file mode 100644
index 0000000..0ef50b4
--- /dev/null
+++ b/tests/characterize_reports.rs
@@ -0,0 +1,128 @@
+use orders::{billing, report, shipping, Order};
+
+fn paid(id: u32, total_cents: u64) -> Order {
+    let mut order = Order::new(id, "pat", total_cents);
+    billing::pay(&mut order).unwrap();
+    order
+}
+
+fn one_of_each() -> Vec<Order> {
+    let pending = Order::new(1, "ada", 100);
+    let paid_order = paid(2, 250);
+    let mut shipped = paid(3, 75);
+    shipping::ship(&mut shipped).unwrap();
+    let mut cancelled = Order::new(4, "dee", 30);
+    cancelled.cancel().unwrap();
+    vec![pending, paid_order, shipped, cancelled]
+}
+
+#[test]
+fn status_counts_are_sorted_by_status_name_not_lifecycle_order() {
+    let counts = report::status_counts(&one_of_each());
+    let names: Vec<(String, usize)> = counts
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        names,
+        [
+            ("cancelled".to_string(), 1),
+            ("paid".to_string(), 1),
+            ("pending".to_string(), 1),
+            ("shipped".to_string(), 1),
+        ]
+    );
+}
+
+#[test]
+fn status_counts_tallies_repeats_and_is_empty_for_no_orders() {
+    let orders = vec![Order::new(1, "a", 1), paid(2, 2), Order::new(3, "c", 3)];
+    let counts: Vec<(String, usize)> = report::status_counts(&orders)
+        .into_iter()
+        .map(|(s, n)| (s.to_string(), n))
+        .collect();
+    assert_eq!(
+        counts,
+        [("paid".to_string(), 1), ("pending".to_string(), 2)]
+    );
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn outstanding_cents_counts_only_pending_orders() {
+    assert_eq!(billing::outstanding_cents(&one_of_each()), 100);
+    assert_eq!(billing::outstanding_cents(&[]), 0);
+}
+
+#[test]
+fn ready_to_ship_keeps_input_order_and_only_paid_orders() {
+    let orders = vec![
+        paid(5, 1),
+        Order::new(9, "x", 1),
+        paid(2, 1),
+        one_of_each().remove(2),
+    ];
+    assert_eq!(shipping::ready_to_ship(&orders), [5, 2]);
+}
+
+#[test]
+fn to_line_writes_every_status_name() {
+    let lines: Vec<String> = one_of_each().iter().map(report::to_line).collect();
+    assert_eq!(
+        lines,
+        [
+            "1,ada,100,pending",
+            "2,pat,250,paid",
+            "3,pat,75,shipped",
+            "4,dee,30,cancelled",
+        ]
+    );
+}
+
+#[test]
+fn from_line_round_trips_every_status() {
+    for order in one_of_each() {
+        let line = report::to_line(&order);
+        assert_eq!(report::from_line(&line).unwrap(), order);
+    }
+}
+
+#[test]
+fn from_line_trims_surrounding_whitespace() {
+    let order = report::from_line("  5,eve,10,paid \n").unwrap();
+    assert_eq!(report::to_line(&order), "5,eve,10,paid");
+}
+
+#[test]
+fn from_line_rejects_wrong_field_counts() {
+    let err = report::from_line("1,ada,100").unwrap_err();
+    assert_eq!(err, "expected 4 fields, got 3");
+    let err = report::from_line("1,a,da,100,paid").unwrap_err();
+    assert_eq!(err, "expected 4 fields, got 5");
+}
+
+#[test]
+fn from_line_rejects_bad_id_and_total_with_std_parse_errors() {
+    let err = report::from_line("x,ada,100,paid").unwrap_err();
+    assert_eq!(err, r#"bad id "x": invalid digit found in string"#);
+    let err = report::from_line("1,ada,-5,paid").unwrap_err();
+    assert_eq!(err, r#"bad total "-5": invalid digit found in string"#);
+}
+
+#[test]
+fn from_line_checks_id_before_status() {
+    let err = report::from_line("x,ada,100,lost").unwrap_err();
+    assert_eq!(err, r#"bad id "x": invalid digit found in string"#);
+}
+
+#[test]
+fn from_line_rejects_unknown_status_names_including_wrong_case_and_empty() {
+    for (line, bad) in [
+        ("1,ada,100,Paid", "Paid"),
+        ("1,ada,100,", ""),
+        ("4,dee,1,lost", "lost"),
+    ] {
+        let err = report::from_line(line).unwrap_err();
+        assert_eq!(err, format!("unknown status {bad:?}"));
+    }
+}
diff --git a/tests/characterize_transitions.rs b/tests/characterize_transitions.rs
new file mode 100644
index 0000000..55d627c
--- /dev/null
+++ b/tests/characterize_transitions.rs
@@ -0,0 +1,89 @@
+use orders::{billing, shipping, Order};
+
+fn status(order: &Order) -> String {
+    order.status.to_string()
+}
+
+fn order_in(status_name: &str) -> Order {
+    let mut order = Order::new(7, "cy", 100);
+    match status_name {
+        "pending" => {}
+        "paid" => billing::pay(&mut order).unwrap(),
+        "shipped" => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        "cancelled" => order.cancel().unwrap(),
+        other => panic!("no path to status {other}"),
+    }
+    order
+}
+
+#[test]
+fn new_orders_start_pending() {
+    assert_eq!(status(&Order::new(7, "cy", 100)), "pending");
+}
+
+#[test]
+fn pay_succeeds_only_from_pending() {
+    let mut order = order_in("pending");
+    billing::pay(&mut order).unwrap();
+    assert_eq!(status(&order), "paid");
+}
+
+#[test]
+fn pay_is_refused_from_every_other_status_and_changes_nothing() {
+    for from in ["paid", "shipped", "cancelled"] {
+        let mut order = order_in(from);
+        let before = order.clone();
+        let err = billing::pay(&mut order).unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be paid: it is {from}"));
+        assert_eq!(order, before);
+    }
+}
+
+#[test]
+fn ship_succeeds_only_from_paid() {
+    let mut order = order_in("paid");
+    shipping::ship(&mut order).unwrap();
+    assert_eq!(status(&order), "shipped");
+}
+
+#[test]
+fn ship_is_refused_from_every_other_status_and_changes_nothing() {
+    for from in ["pending", "shipped", "cancelled"] {
+        let mut order = order_in(from);
+        let before = order.clone();
+        let err = shipping::ship(&mut order).unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be shipped: it is {from}"));
+        assert_eq!(order, before);
+    }
+}
+
+#[test]
+fn cancel_succeeds_from_pending_and_paid() {
+    for from in ["pending", "paid"] {
+        let mut order = order_in(from);
+        order.cancel().unwrap();
+        assert_eq!(status(&order), "cancelled");
+    }
+}
+
+#[test]
+fn cancel_is_refused_from_shipped_and_cancelled_and_changes_nothing() {
+    for from in ["shipped", "cancelled"] {
+        let mut order = order_in(from);
+        let before = order.clone();
+        let err = order.cancel().unwrap_err();
+        assert_eq!(err, format!("order 7 cannot be cancelled: it is {from}"));
+        assert_eq!(order, before);
+    }
+}
+
+#[test]
+fn only_pending_and_paid_orders_are_open() {
+    assert!(order_in("pending").is_open());
+    assert!(order_in("paid").is_open());
+    assert!(!order_in("shipped").is_open());
+    assert!(!order_in("cancelled").is_open());
+}
diff --git a/tests/characterize_unvalidated_status.rs b/tests/characterize_unvalidated_status.rs
new file mode 100644
index 0000000..6c6280f
--- /dev/null
+++ b/tests/characterize_unvalidated_status.rs
@@ -0,0 +1,15 @@
+// Unvalidated status strings. `Order::status` is now an `OrderStatus`, so
+// the cases that set arbitrary text (e.g. "lost") were removed; see the commit.
+use orders::{report, OrderStatus};
+
+#[test]
+fn unknown_status_is_rejected_by_csv_with_its_name() {
+    let err = report::from_line("1,ada,100,lost").unwrap_err();
+    assert_eq!(err, r#"unknown status "lost""#);
+}
+
+#[test]
+fn unknown_status_text_fails_to_parse_naming_the_input() {
+    let err = "lost".parse::<OrderStatus>().unwrap_err();
+    assert_eq!(err.to_string(), r#"unknown status "lost""#);
+}
