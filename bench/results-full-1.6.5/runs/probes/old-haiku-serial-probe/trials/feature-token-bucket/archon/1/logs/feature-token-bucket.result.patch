+class ValidationTest(unittest.TestCase):
+    def test_bucket_rejects_non_positive_capacity_and_rate(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_keyed_limiter_rejects_invalid_parameters(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1.0, max_keys=0, clock=FakeClock())
+
+    def test_bucket_rejects_invalid_n(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_keyed_limiter_rejects_invalid_n_without_tracking_key(self):
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 0)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", 5)
+        self.assertEqual(len(limiter), 0)
+
+
+class RefillTest(unittest.TestCase):
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 4.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.1
+        self.assertAlmostEqual(bucket.available(), 0.4)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.25
+        self.assertTrue(bucket.try_acquire())
+
+    def test_wait_time_does_not_consume_tokens(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(2), 2.0)
+        self.assertAlmostEqual(bucket.wait_time(2), 2.0)
+        self.assertAlmostEqual(bucket.wait_time(1), 1.0)
+        clock.now = 1.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_wait_time_is_zero_when_acquire_would_succeed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+
+class ClockRegressionTest(unittest.TestCase):
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertAlmostEqual(bucket.available(), 1.0)
+        clock.now = 0.5
+        self.assertAlmostEqual(bucket.available(), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(2), 1.0)
+
+    def test_refill_resumes_from_latest_seen_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        bucket.available()
+        clock.now = 0.5
+        bucket.available()
+        clock.now = 1.5
+        self.assertAlmostEqual(bucket.available(), 1.5)
+
+
+class LruTest(unittest.TestCase):
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertNotIn("a", limiter._buckets)
+        self.assertIn("b", limiter._buckets)
+        self.assertIn("c", limiter._buckets)
+
+    def test_try_acquire_refreshes_recency(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        limiter.try_acquire("c")
+        self.assertIn("a", limiter._buckets)
+        self.assertNotIn("b", limiter._buckets)
+
+    def test_wait_time_refreshes_recency(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertIn("a", limiter._buckets)
+        self.assertNotIn("b", limiter._buckets)
+
+    def test_evicted_key_starts_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        self.assertTrue(limiter.try_acquire("a", 2))
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b", 2))
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=10, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.wait_time("x")
+        limiter.try_acquire("y")
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
