+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 0})
+
+    def test_destination_overflow_fails_unchanged(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE - 1})
+        self.assertIs(ledger.transfer("a", "b", 2), False)
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": MAX_BALANCE - 1})
