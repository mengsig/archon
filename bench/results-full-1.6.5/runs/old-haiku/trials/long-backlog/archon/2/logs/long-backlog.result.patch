@@ -1,2 +1,92 @@
+"""Search tasks with a small query language.
+
+A query is whitespace-separated terms, all of which must match (AND):
+  word or "quoted phrase"  title contains it, case-insensitively
+  tag:NAME                 task has tag NAME, case-insensitively
+  status:open|done         task status
+"""
+from dataclasses import dataclass
+from typing import Optional
+
+from tasktracker.models import DONE, OPEN
+
+TAG_FIELD = "tag"
+STATUS_FIELD = "status"
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    """Raised for a malformed or unsupported search query."""
+
+
+@dataclass(frozen=True)
+class Term:
+    field: Optional[str]  # None for a bare word or quoted phrase
+    value: str
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    predicates = [_predicate(term) for term in _split_terms(_checked(query))]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _checked(query):
+    if not isinstance(query, str):
+        raise TypeError(f"query must be a str, not {type(query).__name__}")
+    return query
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes.
+
+    A colon outside quotes, before any other colon, ends a field name.
+    """
+    terms = []
+    field = None
+    chars = []
+    in_quotes = False
+    in_term = False
+    for ch in query:
+        if ch == '"':
+            in_quotes = not in_quotes
+            in_term = True
+        elif ch.isspace() and not in_quotes:
+            if in_term:
+                terms.append(Term(field, "".join(chars)))
+            field, chars, in_term = None, [], False
+        elif ch == ":" and not in_quotes and field is None:
+            field, chars = "".join(chars), []
+            in_term = True
+        else:
+            chars.append(ch)
+            in_term = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if in_term:
+        terms.append(Term(field, "".join(chars)))
+    return terms
+
+
+def _predicate(term):
+    if term.field is None:
+        needle = term.value.lower()
+        return lambda task: needle in task.title.lower()
+    if term.field == TAG_FIELD:
+        return _tag_predicate(term.value)
+    if term.field == STATUS_FIELD:
+        return _status_predicate(term.value)
+    raise QueryError(f"unknown field {term.field!r} in query")
+
+
+def _tag_predicate(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_predicate(value):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status {value!r}; expected one of {', '.join(STATUSES)}")
+    return lambda task: task.status == status
