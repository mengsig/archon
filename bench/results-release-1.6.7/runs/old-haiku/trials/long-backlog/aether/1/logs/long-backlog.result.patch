--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,62 @@
+import re
+from typing import NamedTuple
+
+from .models import DONE, OPEN
+
+TERM = re.compile(r'(?:[^\s"]|"[^"]*")+')
+FIELD_TERM = re.compile(r"(\w+):(.*)", re.DOTALL)
+
+
+class QueryError(ValueError):
+    pass
+
+
+class Clause(NamedTuple):
+    kind: str  # "text", "tag" or "status"
+    value: str
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), f"query must be a str, got {type(query)}"
+    clauses = _parse_query(query)
+    return [task for task in tasks if all(_matches(task, clause) for clause in clauses)]
+
+
+def _parse_query(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    return [_parse_term(raw) for raw in TERM.findall(query)]
+
+
+def _parse_term(raw):
+    if not raw.startswith('"'):
+        field = FIELD_TERM.fullmatch(raw)
+        if field:
+            return _field_clause(field.group(1).casefold(), _unquote(field.group(2)))
+    return Clause("text", _unquote(raw).casefold())
+
+
+def _field_clause(name, value):
+    if name == "tag":
+        if not value:
+            raise QueryError("tag: needs a tag name")
+        return Clause("tag", value.casefold())
+    if name == "status":
+        status = value.casefold()
+        if status not in (OPEN, DONE):
+            raise QueryError(f"unknown status: {value}")
+        return Clause("status", status)
+    raise QueryError(f"unknown field: {name}")
+
+
+def _matches(task, clause):
+    if clause.kind == "text":
+        return clause.value in task.title.casefold()
+    if clause.kind == "tag":
+        return any(tag.casefold() == clause.value for tag in task.tags)
+    assert clause.kind == "status", f"unknown clause kind: {clause.kind}"
+    return task.status == clause.value
+
+
+def _unquote(text):
+    return text.replace('"', "")
