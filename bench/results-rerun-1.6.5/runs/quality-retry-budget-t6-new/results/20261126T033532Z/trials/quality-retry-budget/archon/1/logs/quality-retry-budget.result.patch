@@ -16,3 +16,129 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=2.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=False)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=1.5)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=10.0)
+
+    def test_rejects_zero_attempts(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_rejects_negative_fields(self):
+        with self.assertRaises(ValueError):
+            retry_delay(-1, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validation_precedes_early_none(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=4, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=4)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 2000, retry_after_ms=-5)
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, cap_ms=1.0)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+class RetryLimits(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_returns_none(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+        self.assertIsNone(retry_delay(10**6, 0, max_attempts=4))
+
+    def test_last_allowed_attempt_returns_delay(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+
+class RetryBackoff(unittest.TestCase):
+    def test_exponential_growth_then_cap(self):
+        delays = [retry_delay(n, 0, max_attempts=10, budget_ms=10**9)
+                  for n in range(1, 7)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400, 400])
+
+    def test_zero_base_gives_zero_delay(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_gives_zero_delay(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(5, 0, cap_ms=0, max_attempts=9), 0)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(retry_delay(10**6, 0, max_attempts=10**7,
+                                     budget_ms=10**9), 400)
+        self.assertEqual(retry_delay(10**18, 0, max_attempts=10**19,
+                                     budget_ms=10**31, base_ms=7,
+                                     cap_ms=10**30), 10**30)
+
+    def test_base_larger_than_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=900, cap_ms=400), 400)
+
+    def test_huge_base_and_cap(self):
+        big = 10**30
+        self.assertEqual(retry_delay(1, 0, base_ms=big, cap_ms=big + 1,
+                                     budget_ms=2 * big), big)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_floor_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=900,
+                                     budget_ms=5000), 900)
+
+    def test_retry_after_equal_to_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=200), 200)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+    def test_retry_after_floor_can_exhaust_budget(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+
+class RetryBudget(unittest.TestCase):
+    def test_elapsed_plus_delay_equal_to_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_less_than_budget_returns_delay(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_within_budget_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_with_elapsed_at_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 1, base_ms=0, budget_ms=1))
+
+    def test_delay_never_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(2, 950, budget_ms=1000))
+
