 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    batch = _snapshot_batch(entries)
+    root_path = _validate_root(root)
+    names = [name for name, _ in batch]
+    _check_batch_names(names)
+    for name in names:
+        _check_target(root_path, name.split("/"))
+    for name, data in batch:
+        _write_entry(root_path, name, data)
+    return names
+
+
+def _snapshot_batch(entries):
+    if type(entries) is not list:
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    return [_validate_entry(entry) for entry in entries]
+
+
+def _validate_root(root):
+    if not (type(root) is str or isinstance(root, Path)) or root == "":
+        raise ValueError("root must be a non-empty str or pathlib.Path")
+    root_path = Path(root)
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root}") from exc
+    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root must be a real directory, not a link or file: {root}")
+    return root_path
+
+
+def _validate_entry(entry):
+    if type(entry) is not tuple or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, not {type(entry).__name__}")
+    name, data = entry
+    if type(data) is not bytes:
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    _check_name(name)
+    return name, data
+
+
+def _check_name(name):
+    if type(name) is not str:
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if not name or name.startswith("/"):
+        raise ValueError(f"entry name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name contains a forbidden character: {name!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name has an invalid component: {name!r}")
+
+
+def _check_batch_names(names):
+    files = set()
+    for name in names:
+        if name in files:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        files.add(name)
+    directories = set()
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            directories.add("/".join(parts[:depth]))
+    clashes = files & directories
+    if clashes:
+        raise ValueError(f"entry is also a directory of another entry: {min(clashes)!r}")
+
+
+def _check_target(root, parts):
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"symbolic link below root: {current}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"path component is not a directory: {current}")
+    target = current / parts[-1]
+    if _lstat_or_none(target) is not None:
+        raise ValueError(f"target already exists: {target}")
+
+
+def _write_entry(root, name, data):
+    path = root.joinpath(*name.split("/"))
+    path.parent.mkdir(parents=True, exist_ok=True)
+    assert path.parent.is_dir(), f"parent is not a directory: {path.parent}"
+    assert not os.path.lexists(path), f"target appeared after validation: {path}"
+    with open(path, "xb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
