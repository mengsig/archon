+from dataclasses import replace
+
 from .models import DONE, Task
 
+ADD = "add"
+COMPLETE = "complete"
+DELETE = "delete"
+
 
 class UnknownTask(KeyError):
     pass
 
 
+class NothingToUndo(Exception):
+    pass
+
+
 class TaskStore:
     def __init__(self):
         self._tasks = {}
         self._next_id = 1
+        self._undo_log = []
 
     def add(self, title, tags=(), due=None):
         if not title.strip():
@@ -16,6 +27,7 @@ class TaskStore:
         task = Task(self._next_id, title.strip(), list(tags), due=due)
         self._tasks[task.id] = task
         self._next_id += 1
+        self._undo_log.append((ADD, task.id, None))
         return task
 
     def get(self, task_id):
@@ -26,13 +38,43 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._undo_log.append((COMPLETE, task_id, task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        snapshot = replace(task, tags=list(task.tags))
         del self._tasks[task_id]
+        self._undo_log.append((DELETE, task_id, snapshot))
         return task
 
+    def undo(self):
+        if not self._undo_log:
+            raise NothingToUndo("no add, complete or delete to undo")
+        kind, task_id, saved = self._undo_log.pop()
+        if kind == ADD:
+            return self._undo_add(task_id)
+        if kind == COMPLETE:
+            return self._undo_complete(task_id, saved)
+        assert kind == DELETE, f"unknown undo kind: {kind}"
+        return self._undo_delete(task_id, saved)
+
     def all(self):
         return sorted(self._tasks.values(), key=lambda t: t.id)
+
+    def _undo_add(self, task_id):
+        assert task_id in self._tasks, "an added task must still exist when its add is undone"
+        return self._tasks.pop(task_id)
+
+    def _undo_complete(self, task_id, previous_status):
+        assert task_id in self._tasks, "a completed task must still exist when its complete is undone"
+        task = self._tasks[task_id]
+        task.status = previous_status
+        return task
+
+    def _undo_delete(self, task_id, snapshot):
+        assert task_id not in self._tasks, "a deleted task must be absent when its delete is undone"
+        assert snapshot.id == task_id, "undo snapshot must belong to the deleted id"
+        self._tasks[task_id] = snapshot
+        return snapshot
