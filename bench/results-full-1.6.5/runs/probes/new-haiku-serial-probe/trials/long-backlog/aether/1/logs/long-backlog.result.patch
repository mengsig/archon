+SPECIAL_CHARS = (",", '"', "\r", "\n")
+HEADER = ["id", "title", "tags", "status", "due"]
+
+
 def to_csv(tasks):
-    lines = ["id,title,tags,status,due"]
-    for task in tasks:
-        due = task.due.isoformat() if task.due else ""
-        lines.append(f"{task.id},{task.title},{';'.join(task.tags)},{task.status},{due}")
-    return "\n".join(lines) + "\n"
+    rows = [HEADER] + [_row(task) for task in tasks]
+    return "".join(_csv_line(fields) + "\r\n" for fields in rows)
+
+
+def _row(task):
+    due = task.due.isoformat() if task.due else ""
+    return [str(task.id), task.title, ";".join(task.tags), task.status, due]
+
+
+def _csv_line(fields):
+    return ",".join(_csv_field(field) for field in fields)
+
+
+def _csv_field(value):
+    assert isinstance(value, str), f"CSV field must be str, got {type(value)}"
+    if not any(char in value for char in SPECIAL_CHARS):
+        return value
+    return '"' + value.replace('"', '""') + '"'
diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..e6ea520 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,60 @@
+import re
+
+from .models import DONE, OPEN
+
+TERM = re.compile(r'"([^"]*)"|([^\s"]+)')
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_parse_term(term) for term in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    terms = []
+    for match in TERM.finditer(query):
+        phrase, word = match.groups()
+        terms.append((phrase, True) if phrase is not None else (word, False))
+    return terms
+
+
+def _parse_term(term):
+    text, quoted = term
+    if quoted:
+        return _title_contains(text)
+    field, separator, value = text.partition(":")
+    if not separator:
+        return _title_contains(text)
+    field = field.lower()
+    if field == "tag":
+        if not value:
+            raise QueryError(f"missing value in search term: {text}")
+        return _has_tag(value)
+    if field == "status":
+        return _has_status(value)
+    raise QueryError(f"unknown search field: {text}")
+
+
+def _title_contains(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _has_tag(name):
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _has_status(value):
+    status = value.lower()
+    if status not in STATUSES:
+        raise QueryError(f"unknown status: {value}")
+    return lambda task: task.status == status
