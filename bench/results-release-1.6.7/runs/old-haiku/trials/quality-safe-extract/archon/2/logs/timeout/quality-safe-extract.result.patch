+import os
+import stat
 import tempfile
+import unicodedata
 import unittest
 from pathlib import Path
+from unittest import mock
 
 from safe_extract import extract
 
@@ -18,3 +22,339 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+def describe(path):
+    info = os.lstat(path)
+    if stat.S_ISLNK(info.st_mode):
+        return ("link", os.readlink(path))
+    if stat.S_ISREG(info.st_mode):
+        return ("file", Path(path).read_bytes())
+    return ("other", info.st_mode)
+
+
+def snapshot(base):
+    """Return sorted (relative path, description) under base, without following links."""
+    found = []
+    for dirpath, dirnames, filenames in os.walk(base):
+        for name in dirnames + filenames:
+            full = os.path.join(dirpath, name)
+            found.append((os.path.relpath(full, base), describe(full)))
+    return sorted(found)
+
+
+class ExtractCase(unittest.TestCase):
+    """Each test gets base/root (the extraction root) and base/outside (never touched)."""
+
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+        (self.outside / "keep.txt").write_bytes(b"outside")
+
+    def assertValidationFailsUnchanged(self, entries, root=None):
+        before = snapshot(self.base)
+        with self.assertRaises(ValueError):
+            extract(entries, self.root if root is None else root)
+        self.assertEqual(snapshot(self.base), before)
+
+
+class NonListBatches(ExtractCase):
+    def test_tuple_is_rejected_even_when_empty(self):
+        self.assertValidationFailsUnchanged(())
+
+    def test_tuple_of_entries_is_rejected(self):
+        self.assertValidationFailsUnchanged((("a", b"1"),))
+
+    def test_none_and_string_are_rejected(self):
+        self.assertValidationFailsUnchanged(None)
+        self.assertValidationFailsUnchanged("a")
+
+    def test_iterator_is_rejected_and_not_consumed(self):
+        iterator = iter([("a", b"1")])
+        self.assertValidationFailsUnchanged(iterator)
+        self.assertEqual(list(iterator), [("a", b"1")])
+
+    def test_generator_is_rejected_and_not_started(self):
+        started = []
+
+        def generator():
+            started.append(True)
+            yield ("a", b"1")
+
+        gen = generator()
+        self.assertValidationFailsUnchanged(gen)
+        self.assertEqual(started, [])
+        self.assertEqual(list(gen), [("a", b"1")])
+
+
