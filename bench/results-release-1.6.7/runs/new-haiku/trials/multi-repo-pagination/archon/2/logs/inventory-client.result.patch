+// Follows next_cursor until it is null or absent. The first request sends no cursor.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  for (;;) {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (!Array.isArray(body.items)) {
+      throw new Error('GET /items returned a body without an items array');
+    }
+    items.push(...body.items);
+    if (body.next_cursor == null) return items;
+    if (seenCursors.has(body.next_cursor)) {
+      throw new Error(`GET /items returned a next_cursor already seen: ${body.next_cursor}`);
+    }
+    seenCursors.add(body.next_cursor);
+    cursor = body.next_cursor;
+  }
 }
 
