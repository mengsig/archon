+class BatchConflicts(unittest.TestCase):
+    def setUp(self):
+        self._temp = tempfile.TemporaryDirectory()
+        self.root = Path(self._temp.name)
+
+    def tearDown(self):
+        self._temp.cleanup()
+
+    def assert_batch_rejected(self, entries):
+        with self.subTest(entries=[name for name, _ in entries]):
+            with self.assertRaises(ValueError):
+                extract(entries, self.root)
+            self.assertEqual(tree_snapshot(self.root), [])
+
+    def test_duplicate_names_are_rejected(self):
+        self.assert_batch_rejected([("a", b"1"), ("b", b"2"), ("a", b"3")])
+
+    def test_file_then_nested_entry_is_rejected(self):
+        self.assert_batch_rejected([("ok", b"1"), ("a", b"x"), ("a/b", b"y")])
+
+    def test_nested_entry_then_file_is_rejected(self):
+        self.assert_batch_rejected([("ok", b"1"), ("a/b", b"y"), ("a", b"x")])
+
+    def test_deep_collision_is_rejected_in_either_order(self):
+        self.assert_batch_rejected([("a/b", b"1"), ("a/b/c", b"2")])
+        self.assert_batch_rejected([("a/b/c", b"2"), ("a/b", b"1")])
+
+    def test_sibling_names_sharing_prefix_are_allowed(self):
+        entries = [("a", b"1"), ("ab", b"2"), ("a-b/c", b"3")]
+        self.assertEqual(extract(entries, self.root), ["a", "ab", "a-b/c"])
+
