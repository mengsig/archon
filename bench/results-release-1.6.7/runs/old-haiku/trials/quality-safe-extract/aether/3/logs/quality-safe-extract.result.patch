+import os
 import tempfile
 import unittest
 from pathlib import Path
@@ -5,6 +6,25 @@ from pathlib import Path
 from safe_extract import extract
 
 
+def snapshot(directory):
+    found = []
+    for dirpath, dirnames, filenames in os.walk(directory):
+        for name in dirnames + filenames:
+            found.append(os.path.relpath(os.path.join(dirpath, name), directory))
+    return sorted(found)
+
+
+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+
 class ExtractBasics(unittest.TestCase):
     def test_nested_files(self):
         with tempfile.TemporaryDirectory(dir=".") as directory:
@@ -18,3 +38,194 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class BatchShape(TempRootCase):
+    def test_non_list_batches_rejected_even_when_empty(self):
+        batches = [(), (("a", b""),), None, "ab", {}]
+        for batch in batches:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+                self.assertEqual(snapshot(self.root), [])
+
+    def test_iterators_and_generators_are_not_consumed(self):
+        iterator = iter([("a", b"x")])
+        generator = (entry for entry in [("b", b"y")])
+        for batch in (iterator, generator):
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertEqual(next(generator), ("b", b"y"))
+        self.assertEqual(snapshot(self.root), [])
+
+    def test_malformed_entries_rejected_and_nothing_written(self):
+        bad_entries = [
+            ["a", b""],
+            ("a", b"", 1),
+            ("a",),
+            "a",
+            (1, b""),
+            (b"a", b""),
+            ("a", "text"),
+            ("a", bytearray(b"x")),
+            ("a", None),
+        ]
+        for bad in bad_entries:
+            with self.subTest(entry=bad):
+                with self.assertRaises(ValueError):
+                    extract([("good", b"1"), bad], self.root)
+                self.assertEqual(snapshot(self.root), [])
+
+
+class NameValidation(TempRootCase):
+    def test_invalid_names_rejected(self):
+        names = [
+            "", "/a", "a/", "a//b", ".", "./a", "a/./b", "..", "a/../b",
+            "a\\b", "C:x", "a:b", "a\x00b", "\udcff",
+        ]
+        for name in names:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([("good", b"1"), (name, b"2")], self.root)
+                self.assertEqual(snapshot(self.root), [])
+
+    def test_names_are_not_normalized(self):
+        names = ["100%.txt", "%41", "a..b", "...", "dir/.hidden"]
+        result = extract([(name, b"x") for name in names], self.root)
+        self.assertEqual(result, names)
+        self.assertEqual(snapshot(self.root), sorted(["100%.txt", "%41", "a..b", "...", "dir", "dir/.hidden"]))
+        self.assertEqual((self.root / "%41").read_bytes(), b"x")
+
+
+class BatchCollisions(TempRootCase):
+    def test_duplicate_and_colliding_names_rejected_in_either_order(self):
+        batches = [
+            [("a", b""), ("a", b"")],
+            [("a", b""), ("a/b", b"")],
+            [("a/b", b""), ("a", b"")],
+            [("a/b", b""), ("a/b/c", b"")],
+            [("a/b/c", b""), ("a/b", b"")],
+        ]
+        for batch in batches:
+            with self.subTest(batch=[name for name, _ in batch]):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+                self.assertEqual(snapshot(self.root), [])
+
+    def test_sibling_names_sharing_a_prefix_are_allowed(self):
+        self.assertEqual(extract([("a", b"1"), ("ab", b"2"), ("a-b/c", b"3")], self.root), ["a", "ab", "a-b/c"])
