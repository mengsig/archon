diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..19f6a8d 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,47 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms,
+              base_ms, cap_ms, retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    assert delay >= 0, "delay must be non-negative"
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    assert attempt >= 1, "attempt must be at least 1"
+    if base_ms >= cap_ms:
+        return cap_ms
+    # base_ms < cap_ms < 2**cap_ms.bit_length(), so once the exponent reaches
+    # the bit length of cap_ms the result is already capped. Clamping the
+    # shift keeps the intermediate value small for huge attempt numbers.
+    shift = min(attempt - 1, cap_ms.bit_length())
+    backoff = min(cap_ms, base_ms << shift)
+    assert 0 <= backoff <= cap_ms, "backoff must lie within [0, cap_ms]"
+    return backoff
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms,
+              base_ms, cap_ms, retry_after_ms):
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+
+def _require_int(name, value, *, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..9dd8322 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,123 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_bool_and_float_rejected(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, False)
+        self.assertInvalid(1, 0.0)
+        self.assertInvalid(1, 0, base_ms=100.0)
+        self.assertInvalid(1, 0, retry_after_ms=True)
+        self.assertInvalid(1, 0, retry_after_ms=1.5)
+
+    def test_non_numbers_rejected(self):
+        self.assertInvalid("1", 0)
+        self.assertInvalid(1, None)
+        self.assertInvalid(1, 0, budget_ms="1000")
+
+    def test_lower_bounds(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, max_attempts=0)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_validation_precedes_attempt_limit(self):
+        self.assertInvalid(5, -1, max_attempts=1)
+        self.assertInvalid(5, 0, max_attempts=1, base_ms=-1)
+
+    def test_validation_precedes_exhausted_budget(self):
+        self.assertInvalid(1, 2000, budget_ms=0, retry_after_ms=-5)
+
+
+class RetryAttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_returns_none(self):
+        self.assertIsNone(retry_delay(10**30, 0, max_attempts=4))
+
+    def test_last_permitted_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+
+class RetryBackoff(unittest.TestCase):
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_cap_limits_growth(self):
+        self.assertEqual(retry_delay(10, 0, max_attempts=20,
+                                     budget_ms=10**9, cap_ms=400), 400)
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(
+            retry_delay(10**100, 0, max_attempts=10**101,
+                        budget_ms=10**200, base_ms=1, cap_ms=400),
+            400)
+
+    def test_huge_base_is_not_shifted(self):
+        self.assertEqual(
+            retry_delay(50, 0, max_attempts=100, budget_ms=10**200,
+                        base_ms=10**150, cap_ms=10**120),
+            10**120)
+
+    def test_exact_power_of_two_growth(self):
+        delays = [retry_delay(a, 0, max_attempts=50, budget_ms=10**12,
+                              base_ms=3, cap_ms=10**12) for a in range(1, 6)]
+        self.assertEqual(delays, [3, 6, 12, 24, 48])
+
+
+class RetryAfterFloor(unittest.TestCase):
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, budget_ms=5000, cap_ms=400, retry_after_ms=1000),
+            1000)
+
+    def test_zero_retry_after_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+    def test_large_retry_after_within_budget(self):
+        self.assertEqual(
+            retry_delay(1, 0, budget_ms=10**40, retry_after_ms=10**30),
+            10**30)
+
+
+class RetryBudget(unittest.TestCase):
+    def test_zero_budget_never_retries(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_delay_ending_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_allowed_when_elapsed_before_budget(self):
+        self.assertEqual(retry_delay(1, 999, budget_ms=1000, base_ms=0), 0)
+
+    def test_zero_delay_refused_when_elapsed_at_budget(self):
+        self.assertIsNone(retry_delay(1, 1000, budget_ms=1000, base_ms=0))
+
+    def test_retry_after_is_not_shortened_to_fit_budget(self):
+        self.assertIsNone(
+            retry_delay(1, 0, budget_ms=500, retry_after_ms=500))
+        self.assertEqual(
+            retry_delay(1, 0, budget_ms=501, retry_after_ms=500), 500)
+
+
+if __name__ == "__main__":
+    unittest.main()
