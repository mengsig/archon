@@ -24,6 +24,46 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_defaults_to_twenty_items(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertIsNotNone(body["next_cursor"])
+
+    def test_walking_cursors_returns_every_item_once_in_order(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_page_exactly_filling_the_data_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertIsNone(body["next_cursor"])
+
+    def test_invalid_limit_is_rejected(self):
+        for raw in ["0", "101", "-1", "abc", "", "2.5", " 5"]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_rejected(self):
+        for raw in ["", "!!!", "bm90LWEtbnVtYmVy", "NS0x"]:
+            with self.subTest(cursor=raw):
+                res = get("/items", cursor=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
