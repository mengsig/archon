@@ -22,7 +25,36 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    try:
+        if isinstance(raw_limit, bool) or not str(raw_limit).isdigit():
+            raise ValueError
+        limit = int(raw_limit)
+        if not 1 <= limit <= 100:
+            raise ValueError
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    raw_cursor = query.get("cursor")
+    after_id = 0
+    if raw_cursor is not None:
+        if not isinstance(raw_cursor, str) or not raw_cursor:
+            return _error(400, "invalid cursor")
+        try:
+            decoded = base64.urlsafe_b64decode(raw_cursor + "=" * (-len(raw_cursor) % 4)).decode("ascii")
+            after_id = int(decoded)
+            if str(after_id) != decoded or after_id not in {item["id"] for item in items}:
+                raise ValueError
+        except (ValueError, UnicodeDecodeError, binascii.Error):
+            return _error(400, "invalid cursor")
+
+    remaining = [item for item in items if item["id"] > after_id]
+    page = remaining[:limit]
+    next_cursor = None
+    if len(remaining) > limit:
+        token = str(page[-1]["id"]).encode("ascii")
+        next_cursor = base64.urlsafe_b64encode(token).decode("ascii").rstrip("=")
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
