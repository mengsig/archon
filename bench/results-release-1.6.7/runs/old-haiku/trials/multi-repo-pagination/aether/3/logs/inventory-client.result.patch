@@ -16,10 +16,57 @@ async function singlePage(request) {
   return { status: 404, body: { error: 'not found' } };
 }
 
+// Serves `pages[i]` for the cursor `p<i>`; the first page has no cursor.
+function pagedTransport(pages, seen = []) {
+  return async (request) => {
+    seen.push(request.query);
+    if (request.path !== '/items') return { status: 404, body: { error: 'not found' } };
+    const index = request.query.cursor === undefined ? 0 : Number(request.query.cursor.slice(1));
+    if (!pages[index]) return { status: 404, body: { error: 'no such page' } };
+    return { status: 200, body: pages[index] };
+  };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages, passing each cursor back unchanged', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'p1' },
+    { items: [ITEMS[1]], next_cursor: 'p2' },
+    { items: [{ id: 3, sku: 'SKU-0003', qty: 9 }], next_cursor: null },
+  ];
+  const seen = [];
+  const items = await listItems(pagedTransport(pages, seen));
+  assert.deepEqual(items, pages.flatMap((page) => page.items));
+  assert.deepEqual(seen, [{}, { cursor: 'p1' }, { cursor: 'p2' }]);
+});
+
+test('treats a missing next_cursor as the last page', async () => {
+  const transport = pagedTransport([{ items: ITEMS }]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
+test('rejects a page that repeats a cursor instead of looping', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'p0' },
+    { items: [ITEMS[1]], next_cursor: 'p0' },
+  ];
+  await assert.rejects(listItems(pagedTransport(pages)), /unusable next_cursor/);
+});
+
+test('rejects a page without an items array or with a non-string cursor', async () => {
+  await assert.rejects(listItems(pagedTransport([{ next_cursor: null }])), /no items array/);
+  const badCursor = [{ items: ITEMS, next_cursor: 7 }];
+  await assert.rejects(listItems(pagedTransport(badCursor)), /unusable next_cursor/);
+});
+
+test('fails when a later page fails', async () => {
+  const pages = [{ items: [ITEMS[0]], next_cursor: 'p1' }];
+  await assert.rejects(listItems(pagedTransport(pages)), /GET \/items failed with 404/);
+});
+
 test('gets one item and reports failures', async () => {
