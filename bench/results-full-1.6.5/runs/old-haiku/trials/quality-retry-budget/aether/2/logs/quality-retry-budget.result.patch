diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..da91184 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,45 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms):
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without huge powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # base_ms >= 1, so 2**exponent >= 2**cap_ms.bit_length() > cap_ms.
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << exponent)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms, cap_ms,
+              retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..1797355 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,115 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Backoff(unittest.TestCase):
+    def test_cap_limits_backoff(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, cap_ms=150), 150)
+
+    def test_zero_base_yields_zero_delay(self):
+        self.assertEqual(retry_delay(2, 0, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero_delay(self):
+        self.assertEqual(retry_delay(2, 0, cap_ms=0), 0)
+
+    def test_base_may_exceed_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        attempt = 10**18
+        self.assertEqual(
+            retry_delay(attempt, 0, max_attempts=attempt + 1, budget_ms=10**30),
+            400)
+
+    def test_huge_cap_is_exact(self):
+        cap = 10**40
+        delay = retry_delay(100, 0, max_attempts=101, base_ms=1,
+                            cap_ms=cap, budget_ms=10**50)
+        self.assertEqual(delay, 2**99)
+
+    def test_attempt_above_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=900, budget_ms=5000),
+            900)
+
+    def test_zero_retry_after_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_retry_after_zero_with_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=0), 0)
+
+
+class Budget(unittest.TestCase):
+    def test_exactly_at_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_just_inside_budget_returns_delay(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_retry_after_pushing_past_budget_is_none(self):
+        self.assertIsNone(
+            retry_delay(1, 0, budget_ms=1000, retry_after_ms=1000))
+
+    def test_delay_is_not_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(1, 950, budget_ms=1000, base_ms=100))
+
+    def test_zero_delay_within_budget(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_at_exhausted_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+
+class Validation(unittest.TestCase):
+    def test_bool_rejected(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=False)
+
+    def test_float_rejected(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1.0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=400.0)
+
+    def test_attempt_and_max_attempts_minimum_one(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_non_negative_fields(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validation_runs_before_attempt_limit(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=4, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=4)
+
+    def test_validation_runs_before_budget_exhaustion(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, 2000, budget_ms=1000, retry_after_ms=-5)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+if __name__ == "__main__":
+    unittest.main()
