+import os
 import tempfile
 import unittest
 from pathlib import Path
@@ -18,3 +19,284 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractTestCase(unittest.TestCase):
+    def setUp(self):
+        workdir = tempfile.TemporaryDirectory(dir=".")
+        self.addCleanup(workdir.cleanup)
+        self.base = Path(workdir.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+        self.outside = self.base / "outside"
+        self.outside.mkdir()
+
+    def tree(self):
+        found = []
+        for dirpath, dirnames, filenames in os.walk(self.base):
+            for name in dirnames + filenames:
+                found.append(os.path.relpath(os.path.join(dirpath, name), self.base))
+        return sorted(found)
+
+
+class NonListBatches(ExtractTestCase):
+    def test_non_list_batches_rejected(self):
+        before = self.tree()
+        batches = [
+            (),
+            (("a", b"x"),),
+            iter([]),
+            iter([("a", b"x")]),
+            (entry for entry in []),
+        ]
+        for batch in batches:
+            with self.subTest(batch=batch), self.assertRaises(ValueError):
+                extract(batch, self.root)
+        self.assertEqual(self.tree(), before)
+
+    def test_generator_is_not_consumed(self):
+        generator = ((name, data) for name, data in [("a", b"1"), ("b", b"2")])
+        with self.assertRaises(ValueError):
+            extract(generator, self.root)
+        self.assertEqual(list(generator), [("a", b"1"), ("b", b"2")])
+
+
+class RootValidation(ExtractTestCase):
+    def test_missing_root_rejected(self):
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], self.base / "missing")
+        with self.assertRaises(ValueError):
+            extract([], self.base / "missing")
+
+    def test_file_root_rejected(self):
+        file_root = self.base / "file.txt"
+        file_root.write_bytes(b"not a directory")
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], file_root)
+        self.assertEqual(file_root.read_bytes(), b"not a directory")
+
+    def test_root_below_a_file_rejected(self):
+        (self.base / "file.txt").write_bytes(b"")
+        with self.assertRaises(ValueError):
+            extract([], self.base / "file.txt" / "child")
+
+    def test_symlink_root_rejected(self):
+        link = self.base / "link"
+        os.symlink(self.root, link)
+        with self.assertRaises(ValueError):
+            extract([("a", b"x")], link)
+        with self.assertRaises(ValueError):
+            extract([], link)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_invalid_root_types_rejected(self):
+        for root in (None, b"root", 42, "", ["root"]):
+            with self.subTest(root=root), self.assertRaises(ValueError):
+                extract([], root)
+
+    def test_string_root_accepted(self):
+        self.assertEqual(extract([("a", b"x")], str(self.root)), ["a"])
+        self.assertEqual((self.root / "a").read_bytes(), b"x")
+
+    def test_empty_batch_succeeds_on_valid_root(self):
+        before = self.tree()
+        self.assertEqual(extract([], self.root), [])
+        self.assertEqual(self.tree(), before)
+
+
+class EntryValidation(ExtractTestCase):
+    def assertRejectsBatch(self, bad_entry):
+        before = self.tree()
+        good_entry = ("good.txt", b"ok")
+        with self.assertRaises(ValueError):
+            extract([good_entry, bad_entry], self.root)
+        self.assertEqual(self.tree(), before)
+
+    def test_malformed_entries_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", 1),
+            "a",
+            None,
+        ]
+        for bad_entry in bad_entries:
+            with self.subTest(entry=bad_entry):
+                self.assertRejectsBatch(bad_entry)
+
+    def test_non_string_names_rejected(self):
+        for bad_name in (b"a", None, 1, Path("a")):
+            with self.subTest(name=bad_name):
+                self.assertRejectsBatch((bad_name, b"x"))
+
+    def test_non_bytes_data_rejected(self):
+        for bad_data in ("text", bytearray(b"x"), memoryview(b"x"), None):
+            with self.subTest(data=bad_data):
+                self.assertRejectsBatch(("a", bad_data))
+
+    def test_invalid_names_rejected(self):
+        bad_names = [
+            "",
+            "/abs",
+            "a\\b",
+            "C:/x",
+            "c:",
+            "a:b",
+            "a/b:c",
+            "a\0b",
+            "a//b",
+            "a/",
+            "./a",
+            "a/./b",
+            "a/../b",
+            "..",
+            ".",
+            "a/.",
+            "\ud800",
+            "a\udcff",
+        ]
+        for bad_name in bad_names:
+            with self.subTest(name=bad_name):
+                self.assertRejectsBatch((bad_name, b"x"))
+
+    def test_overlong_components_rejected_before_any_write(self):
+        for bad_name in ("a" * 256, "dir/" + "b" * 256, "é" * 128):
+            with self.subTest(name=bad_name):
+                self.assertRejectsBatch((bad_name, b"x"))
+
+    def test_component_at_byte_limit_accepted(self):
+        name = "a" * 255
+        self.assertEqual(extract([(name, b"x")], self.root), [name])
+
+    def test_unusual_but_legal_names_written_literally(self):
+        names = ["100%", "%2e%2e/x", "a..b", "..x", "...", ".hidden", "a b", "ünï.txt"]
+        entries = [(name, name.encode()) for name in names]
+        self.assertEqual(extract(entries, self.root), names)
+        for name in names:
+            with self.subTest(name=name):
+                self.assertEqual((self.root / name).read_bytes(), name.encode())
+
+    def test_duplicate_names_rejected(self):
+        before = self.tree()
+        with self.assertRaises(ValueError):
+            extract([("a", b"1"), ("b", b"2"), ("a", b"3")], self.root)
+        self.assertEqual(self.tree(), before)
+
+    def test_file_directory_collisions_rejected(self):
+        collisions = [
+            [("a", b""), ("a/b", b"")],
+            [("a/b", b""), ("a", b"")],
+            [("a/b", b""), ("a/b/c", b"")],
+            [("a/b/c", b""), ("a/b", b"")],
+        ]
+        for entries in collisions:
+            with self.subTest(entries=entries):
+                before = self.tree()
+                with self.assertRaises(ValueError):
+                    extract(entries, self.root)
+                self.assertEqual(self.tree(), before)
+
+    def test_prefix_sharing_siblings_allowed(self):
+        entries = [("a", b"1"), ("ab", b"2"), ("a-b/c", b"3")]
+        self.assertEqual(extract(entries, self.root), ["a", "ab", "a-b/c"])
+
+    def test_names_returned_in_input_order(self):
+        entries = [("z", b""), ("a/y", b""), ("m", b"")]
+        self.assertEqual(extract(entries, self.root), ["z", "a/y", "m"])
+
+
+class WriteBehaviour(ExtractTestCase):
+    def test_exact_bytes_written(self):
+        data = bytes(range(256))
+        extract([("bin/data.bin", data)], self.root)
+        self.assertEqual((self.root / "bin/data.bin").read_bytes(), data)
+
+    def test_empty_file_created(self):
+        extract([("empty", b"")], self.root)
+        self.assertTrue((self.root / "empty").is_file())
+        self.assertEqual((self.root / "empty").stat().st_size, 0)
+
+    def test_missing_parents_created(self):
+        extract([("a/b/c/d.txt", b"deep")], self.root)
+        self.assertEqual((self.root / "a/b/c/d.txt").read_bytes(), b"deep")
+
+    def test_existing_real_directory_reused(self):
+        (self.root / "docs").mkdir()
+        extract([("docs/x.txt", b"x")], self.root)
+        self.assertEqual((self.root / "docs/x.txt").read_bytes(), b"x")
+
+
+class ExistingFilesystemConflicts(ExtractTestCase):
+    def test_existing_file_not_overwritten(self):
+        (self.root / "keep.txt").write_bytes(b"original")
+        with self.assertRaises(ValueError):
+            extract([("keep.txt", b"new")], self.root)
+        self.assertEqual((self.root / "keep.txt").read_bytes(), b"original")
+
+    def test_existing_directory_target_rejected(self):
+        (self.root / "dir").mkdir()
+        with self.assertRaises(ValueError):
+            extract([("dir", b"x")], self.root)
+        self.assertEqual(list((self.root / "dir").iterdir()), [])
+
+    def test_existing_file_ancestor_rejected(self):
+        (self.root / "file").write_bytes(b"content")
+        with self.assertRaises(ValueError):
+            extract([("file/child", b"x")], self.root)
+        self.assertEqual((self.root / "file").read_bytes(), b"content")
+
+    def test_conflict_in_batch_creates_nothing(self):
+        (self.root / "keep.txt").write_bytes(b"original")
+        before = self.tree()
+        with self.assertRaises(ValueError):
+            extract([("new/dir/ok.txt", b"x"), ("keep.txt", b"y")], self.root)
+        self.assertEqual(self.tree(), before)
+
+    def test_symlink_ancestor_not_followed(self):
+        os.symlink(self.outside, self.root / "link")
+        before = self.tree()
+        with self.assertRaises(ValueError):
+            extract([("ok.txt", b"x"), ("link/x.txt", b"y")], self.root)
+        self.assertEqual(self.tree(), before)
+        self.assertEqual(list(self.outside.iterdir()), [])
+
+    def test_symlink_inside_root_ancestor_not_followed(self):
+        (self.root / "real").mkdir()
+        os.symlink(self.root / "real", self.root / "link")
+        with self.assertRaises(ValueError):
+            extract([("link/x.txt", b"x")], self.root)
+        self.assertEqual(list((self.root / "real").iterdir()), [])
+
+    def test_dangling_symlink_ancestor_rejected(self):
+        os.symlink(self.outside / "nowhere", self.root / "dangling")
+        with self.assertRaises(ValueError):
+            extract([("dangling/x.txt", b"x")], self.root)
+        self.assertFalse((self.outside / "nowhere").exists())
+
+    def test_symlink_target_not_followed(self):
+        outside_file = self.outside / "file.txt"
+        outside_file.write_bytes(b"outside")
+        os.symlink(outside_file, self.root / "t.txt")
+        with self.assertRaises(ValueError):
+            extract([("t.txt", b"x")], self.root)
+        self.assertEqual(outside_file.read_bytes(), b"outside")
+
+    def test_dangling_symlink_target_rejected(self):
+        os.symlink(self.outside / "target.txt", self.root / "t.txt")
+        with self.assertRaises(ValueError):
+            extract([("t.txt", b"x")], self.root)
+        self.assertFalse((self.outside / "target.txt").exists())
+
+
+class IoErrors(ExtractTestCase):
+    @unittest.skipUnless(hasattr(os, "geteuid") and os.geteuid() != 0,
