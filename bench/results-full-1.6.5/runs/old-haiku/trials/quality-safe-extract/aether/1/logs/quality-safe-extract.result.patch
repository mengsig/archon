diff --git a/safe_extract.py b/safe_extract.py
index 0007027..de777cc 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,104 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    planned = _plan_writes(entries, root_path)
+    for target, data in planned:
+        _write_file(target, data)
+    names = [name for name, _ in entries]
+    assert len(names) == len(planned)
+    return names
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError("root must be a non-empty path string or pathlib.Path")
+    root_path = Path(root)
+    try:
+        root_stat = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root!r}") from exc
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise ValueError(f"root must be a real directory, not a link or file: {root!r}")
+    return root_path
+
+
+def _plan_writes(entries, root):
+    names = set()
+    parts_by_name = []
+    for entry in entries:
+        name, data = _unpack_entry(entry)
+        if name in names:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        names.add(name)
+        parts_by_name.append((name, _split_name(name), data))
+    _check_batch_conflicts(names)
+    planned = []
+    for name, parts, data in parts_by_name:
+        _check_target_free(root, parts, name)
+        planned.append((root.joinpath(*parts), data))
+    return planned
+
+
+def _unpack_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple: {entry!r}")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be a str: {name!r}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes for {name!r}")
+    return name, data
+
+
+def _split_name(name):
+    if "\\" in name or ":" in name or "\0" in name:
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"name must be a relative POSIX path: {name!r}")
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name is not encodable for the filesystem: {name!r}") from exc
+    return parts
+
+
+def _check_batch_conflicts(names):
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in names:
+                raise ValueError(f"{name!r} conflicts with file {ancestor!r} in batch")
+
+
+def _check_target_free(root, parts, name):
+    assert parts, "validated names have at least one component"
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        try:
+            entry_stat = os.lstat(current)
+        except FileNotFoundError:
+            return
+        if stat.S_ISLNK(entry_stat.st_mode):
+            raise ValueError(f"path contains a symlink for {name!r}")
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists: {name!r}")
+        if not stat.S_ISDIR(entry_stat.st_mode):
+            raise ValueError(f"ancestor is not a directory for {name!r}")
+
+
+def _write_file(target, data):
+    assert isinstance(data, bytes)
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with open(target, "xb") as handle:
+        handle.write(data)
