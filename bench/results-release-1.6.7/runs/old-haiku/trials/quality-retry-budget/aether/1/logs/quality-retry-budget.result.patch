diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..c4e7893 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,45 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without big powers."""
+    assert attempt >= 1, "attempt is validated by the caller"
+    assert base_ms >= 0 and cap_ms >= 0, "validated by the caller"
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    if base_ms >= cap_ms:
+        return cap_ms
+    doublings = attempt - 1
+    # base_ms >= 1, so base_ms * 2**doublings >= 2**doublings > cap_ms here.
+    if doublings >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << doublings)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..95beb50 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,141 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 1.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=False)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=10.0)
+
+    def test_rejects_int_subclass(self):
+        class MyInt(int):
+            pass
+        with self.assertRaises(ValueError):
+            retry_delay(MyInt(1), 0)
+
+    def test_rejects_out_of_range(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_invalid_args_raise_before_early_return(self):
+        with self.assertRaises(ValueError):
+            retry_delay(5, -1, max_attempts=1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, max_attempts=1, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=1000, retry_after_ms=-1)
+
+    def test_retry_after_none_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_large_ints_are_accepted(self):
+        huge = 10 ** 40
+        self.assertEqual(retry_delay(1, 0, base_ms=huge, cap_ms=huge + 1,
+                                     budget_ms=huge + 1), huge)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_attempt_limit_checked_before_budget(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4, budget_ms=10 ** 9))
+
+
+class Backoff(unittest.TestCase):
+    def test_doubling_saturates_at_cap(self):
+        delays = [retry_delay(a, 0, max_attempts=10 ** 6, budget_ms=10 ** 9)
+                  for a in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(50, 0, max_attempts=100, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_huge_attempt_does_not_allocate_power(self):
+        big = 10 ** 18
+        self.assertEqual(
+            retry_delay(big, 0, max_attempts=big + 1, budget_ms=10 ** 30),
+            400)
+
+    def test_huge_attempt_with_huge_cap(self):
+        cap = 10 ** 30
+        self.assertEqual(
+            retry_delay(10 ** 9, 0, max_attempts=10 ** 10, base_ms=1,
+                        cap_ms=cap, budget_ms=10 ** 40),
+            cap)
+
+    def test_doubling_exact_before_cap(self):
+        self.assertEqual(
+            retry_delay(5, 0, max_attempts=10, base_ms=1, cap_ms=100,
+                        budget_ms=10 ** 6), 16)
+        self.assertEqual(
+            retry_delay(8, 0, max_attempts=10, base_ms=1, cap_ms=100,
+                        budget_ms=10 ** 6), 100)
+
+
+class RetryAfterFloor(unittest.TestCase):
+    def test_retry_after_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=5000, cap_ms=400,
+                        budget_ms=10 ** 6), 5000)
+
+    def test_backoff_wins_when_larger(self):
+        self.assertEqual(
+            retry_delay(3, 0, retry_after_ms=50, budget_ms=10 ** 6), 400)
+
+    def test_zero_retry_after_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class Budget(unittest.TestCase):
+    def test_exact_budget_boundary_is_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_below_budget_boundary_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_at_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+    def test_zero_delay_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_retry_after_overflowing_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000,
+                                      budget_ms=1000))
+
+    def test_delay_is_not_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(2, 800, base_ms=200, budget_ms=1000))
+
+
+if __name__ == "__main__":
+    unittest.main()
