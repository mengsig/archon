 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _check_rate_params(capacity, refill_per_sec):
+    # Written as `not` so that NaN is rejected too.
+    if not capacity > 0:
+        raise ValueError(f"capacity must be > 0, got {capacity!r}")
+    if not refill_per_sec > 0:
+        raise ValueError(f"refill_per_sec must be > 0, got {refill_per_sec!r}")
+
+
+def _check_n(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must satisfy 0 < n <= capacity ({capacity!r}), got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate_params(capacity, refill_per_sec)
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = float(capacity)
+        self._last = clock()
+
+    def _refill(self):
+        # Only moves forward: a clock that went backwards adds nothing.
+        now = self._clock()
+        if now > self._last:
+            elapsed = now - self._last
+            self._tokens = min(self.capacity, self._tokens + elapsed * self.refill_per_sec)
+            self._last = now
+        assert 0 <= self._tokens <= self.capacity
+
+    def _wait_margin(self):
+        # Clock readings and token arithmetic are rounded; pad the wait so that
+        # advancing the clock by it always leaves enough tokens.
+        clock_ulp = math.ulp(max(1.0, abs(self._last)))
+        token_ulp = math.ulp(self.capacity) / self.refill_per_sec
+        return 4 * (clock_ulp + token_ulp)
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _check_n(n, self.capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        assert self._tokens >= 0
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _check_n(n, self.capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec + self._wait_margin()
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _check_rate_params(capacity, refill_per_sec)
+        if not max_keys >= 1:
+            raise ValueError(f"max_keys must be >= 1, got {max_keys!r}")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket_for(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self.max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self.capacity, self.refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self.max_keys
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _check_n(n, self.capacity)
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _check_n(n, self.capacity)
+        return self._bucket_for(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
