diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..b6643fc 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,52 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the delay before another attempt, or None if it cannot start."""
+    values = {
+        "attempt": attempt,
+        "elapsed_ms": elapsed_ms,
+        "max_attempts": max_attempts,
+        "budget_ms": budget_ms,
+        "base_ms": base_ms,
+        "cap_ms": cap_ms,
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = retry_after_ms
+
+    for name, value in values.items():
+        if type(value) is not int:
+            raise ValueError(f"{name} must be an integer")
+
+    if attempt < 1:
+        raise ValueError("attempt must be at least 1")
+    if max_attempts < 1:
+        raise ValueError("max_attempts must be at least 1")
+    for name in ("elapsed_ms", "budget_ms", "base_ms", "cap_ms",
+                 "retry_after_ms"):
+        value = values.get(name)
+        if value is not None and value < 0:
+            raise ValueError(f"{name} must be non-negative")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    elif base_ms >= cap_ms:
+        delay = cap_ms
+    else:
+        exponent = attempt - 1
+        # If exponent reaches cap's bit length, base * 2**exponent is
+        # certainly at least cap. Otherwise the shift is bounded by cap's
+        # size and cannot create an unnecessarily enormous intermediate.
+        if exponent >= cap_ms.bit_length():
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms << exponent)
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..2614901 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,60 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_budget_requires_start_strictly_before_deadline(self):
+        self.assertEqual(retry_delay(1, 899), 100)
+        self.assertIsNone(retry_delay(1, 900))
+        self.assertEqual(retry_delay(1, 999, base_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0))
+
+    def test_retry_after_floor_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=5, retry_after_ms=50), 50)
+        self.assertIsNone(
+            retry_delay(1, 950, cap_ms=5, retry_after_ms=50))
+
+    def test_zero_and_reversed_backoff_bounds(self):
+        self.assertEqual(retry_delay(10, 0, max_attempts=11, base_ms=0), 0)
+        self.assertEqual(retry_delay(10, 0, max_attempts=11, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=20, cap_ms=5), 5)
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=0, cap_ms=0, retry_after_ms=3), 3)
+
+    def test_large_attempt_saturates_and_attempt_may_exceed_limit(self):
+        huge_attempt = 10**100
+        self.assertEqual(retry_delay(huge_attempt, 0, max_attempts=huge_attempt + 1), 400)
+        self.assertIsNone(retry_delay(huge_attempt, 0, max_attempts=4))
+
+    def test_validation_precedes_exhaustion_checks(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, max_attempts=4, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, max_attempts=4, retry_after_ms=False)
+
+    def test_rejects_non_builtin_integers_and_negative_values(self):
+        invalid_values = (True, False, 1.0, "1")
+        for value in invalid_values:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(value, 0)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, value)
+
+        invalid_parameters = (
+            ("max_attempts", 0),
+            ("budget_ms", -1),
+            ("base_ms", -1),
+            ("cap_ms", -1),
+            ("retry_after_ms", -1),
+            ("retry_after_ms", 1.5),
+        )
+        for name, value in invalid_parameters:
+            with self.subTest(parameter=name, value=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, **{name: value})
+
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
