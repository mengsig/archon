 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _check_account_name(name):
+    if not isinstance(name, str) or name == "":
+        raise ValueError(f"account name must be a nonempty string: {name!r}")
+
+
+def _check_integer_in_range(value, low, label):
+    # type() rather than isinstance(): bool is a subclass of int and is rejected.
+    if type(value) is not int or not low <= value <= MAX_BALANCE:
+        raise ValueError(f"{label} must be an int in [{low}, {MAX_BALANCE}]: {value!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError(f"balances must be a dict, got {type(balances).__name__}")
+        copied = dict(balances)
+        for name, balance in copied.items():
+            _check_account_name(name)
+            _check_integer_in_range(balance, 0, "balance")
+        self._balances = copied
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_integer_in_range(amount, 1, "amount")
+        with self._lock:
+            self._require_account(source)
+            self._require_account(destination)
+            return self._transfer_locked(source, destination, amount)
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _require_account(self, name):
+        if not isinstance(name, str) or name not in self._balances:
+            raise KeyError(name)
+
+    def _transfer_locked(self, source, destination, amount):
+        source_balance = self._balances[source]
+        if source == destination:
+            return source_balance >= amount
+        destination_balance = self._balances[destination]
+        if source_balance < amount or destination_balance + amount > MAX_BALANCE:
+            return False
+        self._balances[source] = source_balance - amount
+        self._balances[destination] = destination_balance + amount
+        assert 0 <= self._balances[source] <= MAX_BALANCE
+        assert 0 <= self._balances[destination] <= MAX_BALANCE
+        return True
