@@ -0,0 +1,95 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN, Task
+from tasktracker.search import QueryError, search
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login bug", tags=["Work"], status=OPEN),
+            Task(2, "fix the login page", tags=["home"], status=DONE),
+            Task(3, "Buy milk", tags=["home", "errand"], status=OPEN),
+            Task(4, "Write report", tags=["work"], status=DONE),
+        ]
+
+    def test_bare_word_matches_title_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "LOGIN")), ["Fix login bug", "fix the login page"])
+
+    def test_bare_word_does_not_match_tags(self):
+        self.assertEqual(titles(search(self.tasks, "home")), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(titles(search(self.tasks, '"fix login"')), ["Fix login bug"])
+
+    def test_unquoted_words_must_all_match(self):
+        self.assertEqual(titles(search(self.tasks, "fix login")), ["Fix login bug", "fix the login page"])
+        self.assertEqual(titles(search(self.tasks, "fix milk")), [])
+
+    def test_quoted_phrase_combines_with_other_terms(self):
+        self.assertEqual(titles(search(self.tasks, '"login" bug')), ["Fix login bug"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(titles(search(self.tasks, "tag:work")), ["Fix login bug", "Write report"])
+        self.assertEqual(titles(search(self.tasks, "tag:WORK")), ["Fix login bug", "Write report"])
+
+    def test_tag_is_exact_not_substring(self):
+        self.assertEqual(titles(search(self.tasks, "tag:wor")), [])
+        self.assertEqual(titles(search(self.tasks, "tag:errand")), ["Buy milk"])
+
+    def test_tag_value_may_be_quoted(self):
+        tasks = [Task(1, "a", tags=["needs review"]), Task(2, "b", tags=["review"])]
+        self.assertEqual(titles(search(tasks, 'tag:"needs review"')), ["a"])
+
+    def test_status_open_and_done(self):
+        self.assertEqual(titles(search(self.tasks, "status:open")), ["Fix login bug", "Buy milk"])
+        self.assertEqual(titles(search(self.tasks, "status:done")), ["fix the login page", "Write report"])
+
+    def test_status_value_is_case_insensitive(self):
+        self.assertEqual(titles(search(self.tasks, "status:DONE")), ["fix the login page", "Write report"])
+
+    def test_status_combines_with_title_and_tag(self):
+        self.assertEqual(titles(search(self.tasks, "status:done tag:work")), ["Write report"])
+        self.assertEqual(titles(search(self.tasks, "status:open login")), ["Fix login bug"])
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "status:pending")
+
+    def test_unknown_field_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "due:today")
+
+    def test_field_term_with_empty_value_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, "tag:")
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            search(self.tasks, '"fix login')
+
+    def test_quoted_colon_is_plain_text_not_field(self):
+        tasks = [Task(1, "due:today soon"), Task(2, "later")]
+        self.assertEqual(titles(search(tasks, '"due:today"')), ["due:today soon"])
+
+    def test_empty_and_blank_query_match_everything(self):
+        self.assertEqual(titles(search(self.tasks, "")), titles(self.tasks))
+        self.assertEqual(titles(search(self.tasks, "   \t ")), titles(self.tasks))
+
+    def test_results_keep_input_order(self):
+        self.assertEqual(
+            titles(search(self.tasks, "l")),
+            ["Fix login bug", "fix the login page", "Buy milk"],
+        )
+
+    def test_non_string_query_raises_type_error(self):
+        with self.assertRaises(TypeError):
+            search(self.tasks, None)
+
+
+if __name__ == "__main__":
+    unittest.main()
