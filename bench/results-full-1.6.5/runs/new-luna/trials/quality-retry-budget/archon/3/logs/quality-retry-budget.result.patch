diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..a40141c 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,38 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an integer >= {minimum}")
+    if retry_after_ms is not None and (
+            type(retry_after_ms) is not int or retry_after_ms < 0):
+        raise ValueError("retry_after_ms must be None or an integer >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    # Determine whether the uncapped exponential would reach the cap before
+    # constructing it. This keeps work bounded even for enormous attempts.
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    else:
+        exponent = attempt - 1
+        cap_exponent = (cap_ms - 1).bit_length() - (base_ms - 1).bit_length()
+        if exponent > cap_exponent + 1:
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms * (1 << exponent))
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..627f08f 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,44 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_before_early_returns(self):
+        invalid_calls = (
+            ((4, 0), {"base_ms": True}),
+            ((4, 0), {"max_attempts": 0}),
+            ((4,), {"elapsed_ms": -1}),
+            ((4, 0), {"budget_ms": 1.0}),
+            ((4, 0), {"base_ms": -1}),
+            ((4, 0), {"cap_ms": False}),
+            ((4, 0), {"retry_after_ms": -1}),
+            ((4, 0), {"retry_after_ms": 2.0}),
+            ((0, 0), {}),
+        )
+        for args, kwargs in invalid_calls:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_attempt_count_and_exhaustion(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
+
+    def test_zero_parameters_and_base_above_cap(self):
+        self.assertEqual(retry_delay(100, 0, max_attempts=101, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=100, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=20), 20)
+
+    def test_budget_is_strict_and_never_shortens_delay(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=300,
+                                     retry_after_ms=300))
+
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=1000,
+                                     budget_ms=2000), 1000)
+
+    def test_huge_attempt_saturates_without_large_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**101), 400)
