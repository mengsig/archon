+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,EUR");
+}
+
+#[test]
+fn malformed_currency_is_a_currency_error() {
+    for code in ["eur", "EURO", "US1", "E", ""] {
+        let line = format!("2026-03-01\tgroceries\t1.00\t{code}");
+        assert!(
+            matches!(parse_line(&line), Err(ParseError::Currency(_))),
+            "code {code:?} should be rejected as a currency error"
+        );
+    }
+}
+
+#[test]
+fn other_bad_input_is_an_input_error() {
+    assert!(matches!(
+        parse_line("2026-03-01\tgroceries\t1.00\tEUR\textra"),
+        Err(ParseError::Input(_))
+    ));
+    assert!(matches!(
+        parse_line("March 1\tgroceries\t1.00\tEUR"),
+        Err(ParseError::Input(_))
+    ));
+}
