 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _require_positive_finite(name, value):
+    if not (math.isfinite(value) and value > 0):
+        raise ValueError(f"{name} must be a positive finite number, got {value!r}")
+
+
+def _require_request(n, capacity):
+    if not 0 < n <= capacity:
+        raise ValueError(f"n must satisfy 0 < n <= capacity ({capacity}), got {n!r}")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _require_positive_finite("capacity", capacity)
+        _require_positive_finite("refill_per_sec", refill_per_sec)
+        self._capacity = float(capacity)
+        self._refill_per_sec = float(refill_per_sec)
+        self._clock = clock
+        self._tokens = self._capacity
+        self._last = self._read_clock()
+
+    def _read_clock(self):
+        now = self._clock()
+        assert math.isfinite(now), f"clock returned a non-finite time: {now!r}"
+        return now
+
+    def _refill(self):
+        now = self._read_clock()
+        # A clock that went backwards adds nothing and keeps the latest seen time.
+        if now <= self._last:
+            return
+        self._tokens = min(
+            self._capacity, self._tokens + (now - self._last) * self._refill_per_sec
+        )
+        self._last = now
+        assert 0.0 <= self._tokens <= self._capacity, self._tokens
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _require_request(n, self._capacity)
+        self._refill()
+        if self._tokens < n:
+            return False
+        self._tokens -= n
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _require_request(n, self._capacity)
+        self._refill()
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self._refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _require_positive_finite("capacity", capacity)
+        _require_positive_finite("refill_per_sec", refill_per_sec)
+        if max_keys < 1:
+            raise ValueError(f"max_keys must be at least 1, got {max_keys!r}")
+        self._capacity = capacity
+        self._refill_per_sec = refill_per_sec
+        self._max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket(self, key):
+        bucket = self._buckets.get(key)
+        if bucket is not None:
+            self._buckets.move_to_end(key)
+            return bucket
+        if len(self._buckets) >= self._max_keys:
+            self._buckets.popitem(last=False)
+        bucket = TokenBucket(self._capacity, self._refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        assert len(self._buckets) <= self._max_keys
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        _require_request(n, self._capacity)
+        return self._bucket(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        _require_request(n, self._capacity)
+        return self._bucket(key).wait_time(n)
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
