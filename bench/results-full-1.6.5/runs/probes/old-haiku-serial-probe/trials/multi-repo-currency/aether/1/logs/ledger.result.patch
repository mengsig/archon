+
+#[test]
+fn currency_defaults_to_usd_and_reads_fourth_column() {
+    let legacy = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
+    assert_eq!(legacy.currency, "USD");
+    assert!(to_csv_row(&legacy).ends_with(",-4510,USD"));
+
+    let eur = parse_line("2026-03-01\tgroceries\t-45.10\tEUR").unwrap();
+    assert_eq!(eur.currency, "EUR");
+    assert_eq!(to_csv_row(&eur), "2026-03-01,groceries,-4510,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    for code in ["eur", "EURO", "US", "U5D", "", "EU "] {
+        let line = format!("2026-03-01\tgroceries\t1\t{code}");
+        assert!(
+            matches!(parse_line(&line), Err(LineError::BadCurrency(_))),
+            "accepted currency {code:?}"
+        );
+    }
+}
+
+#[test]
+fn binary_exit_status_distinguishes_currency_errors() {
+    assert_eq!(run_binary("2026-03-01\tgroceries\t1\tEUR\n"), (0, String::new()));
+    let (status, stderr) = run_binary("2026-03-01\tgroceries\t1\n2026-03-01\tx\t1\teur\n");
+    assert_eq!(status, 2);
+    assert!(stderr.starts_with("line 2: bad currency"), "{stderr}");
+    let (status, stderr) = run_binary("not a transaction\n");
+    assert_eq!(status, 1);
+    assert!(stderr.starts_with("line 1: "), "{stderr}");
+}
+
+fn run_binary(stdin: &str) -> (i32, String) {
+    use std::io::Write;
+    use std::process::{Command, Stdio};
+
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(stdin.as_bytes())
+        .expect("write stdin");
+    let output = child.wait_with_output().expect("wait for ledger");
+    (
+        output.status.code().expect("exit code"),
+        String::from_utf8(output.stderr).expect("utf8 stderr"),
+    )
+}
