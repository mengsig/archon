+import copy
+from dataclasses import dataclass
+from typing import Any
+
 from .models import DONE, Task
 
+ADD = "add"
+COMPLETE = "complete"
+DELETE = "delete"
+
 
 class UnknownTask(KeyError):
     pass
 
 
+class NothingToUndo(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class _Change:
+    kind: str
+    task_id: int
+    # previous status for COMPLETE, a copy of the task for DELETE, unused for ADD
+    saved: Any = None
+
+
 class TaskStore:
     def __init__(self):
         self._tasks = {}
         self._next_id = 1
+        self._history = []
 
     def add(self, title, tags=(), due=None):
         if not title.strip():
@@ -16,6 +37,7 @@ class TaskStore:
         task = Task(self._next_id, title.strip(), list(tags), due=due)
         self._tasks[task.id] = task
         self._next_id += 1
+        self._history.append(_Change(ADD, task.id))
         return task
 
     def get(self, task_id):
@@ -26,13 +48,30 @@ class TaskStore:
 
     def complete(self, task_id):
         task = self.get(task_id)
+        self._history.append(_Change(COMPLETE, task_id, task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
+        self._history.append(_Change(DELETE, task_id, copy.deepcopy(task)))
         del self._tasks[task_id]
         return task
 
+    def undo(self):
+        """Revert the most recent add, complete or delete that was not undone yet."""
+        if not self._history:
+            raise NothingToUndo("no add, complete or delete to undo")
+        change = self._history.pop()
+        if change.kind == ADD:
+            assert change.task_id in self._tasks, "added task missing at undo"
+            del self._tasks[change.task_id]
+        elif change.kind == COMPLETE:
+            assert change.task_id in self._tasks, "completed task missing at undo"
+            self._tasks[change.task_id].status = change.saved
+        else:
+            assert change.task_id not in self._tasks, "deleted task present at undo"
+            self._tasks[change.task_id] = change.saved
+
     def all(self):
         return sorted(self._tasks.values(), key=lambda t: t.id)
