@@ -0,0 +1,90 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("fix login page", tags=["home"])
+    store.add("buy milk", tags=["home", "errand"])
+    store.add("write: report", tags=["work,urgent"])
+    store.complete(2)
+    return store
+
+
+def _titles(query):
+    return [task.title for task in search(_store().all(), query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   ", "\t"]:
+            with self.subTest(query=query):
+                self.assertEqual(len(_titles(query)), 4)
+        self.assertEqual(_titles("")[0], "Fix login bug")
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(_titles("LOGIN"), ["Fix login bug", "fix login page"])
+
+    def test_all_terms_must_match(self):
+        self.assertEqual(_titles("fix bug"), ["Fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_titles('"login bug"'), ["Fix login bug"])
+        self.assertEqual(_titles('"fix login" page'), ["fix login page"])
+
+    def test_unterminated_quote_raises(self):
+        with self.assertRaises(QueryError):
+            _titles('"login bug')
+
+    def test_colon_inside_quotes_is_plain_text(self):
+        self.assertEqual(_titles('"write: report"'), ["write: report"])
+
+    def test_tag_matches_exact_tag_case_insensitively(self):
+        self.assertEqual(_titles("tag:work"), ["Fix login bug"])
+        self.assertEqual(_titles("tag:HOME"), ["fix login page", "buy milk"])
+
+    def test_tag_does_not_match_substring_of_tag(self):
+        self.assertEqual(_titles("tag:wor"), [])
+
+    def test_tag_value_may_be_quoted_and_contain_a_comma(self):
+        self.assertEqual(_titles('tag:"work,urgent"'), ["write: report"])
+
+    def test_status_filters(self):
+        self.assertEqual(_titles("status:open"), ["Fix login bug", "buy milk", "write: report"])
+        self.assertEqual(_titles("status:done"), ["fix login page"])
+        self.assertEqual(_titles("STATUS:Done"), ["fix login page"])
+
+    def test_terms_combine_with_and(self):
+        self.assertEqual(_titles("tag:home status:open"), ["buy milk"])
+        self.assertEqual(_titles("tag:home login"), ["fix login page"])
+
+    def test_unknown_field_raises(self):
+        for query in ["title:x", "10:30", ":x", "priority:high"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    _titles(query)
+
+    def test_field_without_value_raises(self):
+        for query in ["tag:", 'tag:""', "status:"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    _titles(query)
+
+    def test_unknown_status_raises(self):
+        with self.assertRaises(QueryError):
+            _titles("status:archived")
+
+    def test_results_keep_input_order(self):
+        store = _store()
+        tasks = list(reversed(store.all()))
+        self.assertEqual(
+            [t.title for t in search(tasks, "login")],
+            ["fix login page", "Fix login bug"],
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
