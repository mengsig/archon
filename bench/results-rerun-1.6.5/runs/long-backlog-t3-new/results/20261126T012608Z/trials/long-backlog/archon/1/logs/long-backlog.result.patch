+    def undo(self):
+        if not self._undo_stack:
+            raise NothingToUndo("no operation left to undo")
+        kind, payload = self._undo_stack.pop()
+        if kind == UNDO_ADD:
+            self._undo_add(payload)
+        elif kind == UNDO_STATUS:
+            self._undo_status(*payload)
+        else:
+            self._undo_delete(payload)
