@@ -22,7 +22,25 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    if not isinstance(raw_limit, str) or not raw_limit.isdigit():
+        return _error(400, "limit must be an integer from 1 to 100")
+    limit = int(raw_limit)
+    if not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    raw_cursor = query.get("cursor")
+    if raw_cursor is not None:
+        if not isinstance(raw_cursor, str) or not raw_cursor.isdigit():
+            return _error(400, "invalid cursor")
+        cursor_id = int(raw_cursor)
+        if not any(item["id"] == cursor_id for item in items):
+            return _error(400, "invalid cursor")
+        items = [item for item in items if item["id"] > cursor_id]
+
+    page = items[:limit]
+    next_cursor = str(page[-1]["id"]) if len(items) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
