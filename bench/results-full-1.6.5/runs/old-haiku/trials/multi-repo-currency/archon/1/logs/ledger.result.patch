diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..044c235
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,53 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawning ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("writing stdin");
+    child.wait_with_output().expect("waiting for ledger")
+}
+
+#[test]
+fn prints_header_and_default_usd_rows() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn prints_explicit_currency() {
+    let out = run_ledger("2026-03-01\tgroceries\t1\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert!(String::from_utf8_lossy(&out.stdout).ends_with("2026-03-01,groceries,100,EUR\n"));
+}
+
+#[test]
+fn malformed_currency_exits_2_with_line_number() {
+    for (code, bad_line) in [("lowercase", "eur"), ("length", "EURO"), ("digit", "EU1")] {
+        let input = format!("2026-03-01\tgroceries\t1\tUSD\n2026-03-02\trent\t2\t{bad_line}\n");
+        let out = run_ledger(&input);
+        let stderr = String::from_utf8_lossy(&out.stderr);
+        assert_eq!(out.status.code(), Some(2), "{code}: stderr={stderr}");
+        assert!(stderr.starts_with("line 2: "), "{code}: stderr={stderr}");
+    }
+}
+
+#[test]
+fn other_input_errors_still_exit_1() {
+    let out = run_ledger("2026-03-01\tgroceries\tabc\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&out.stderr).starts_with("line 1: "));
+}
