+++ b/tests/test_export.py
@@ -0,0 +1,46 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import DONE, Task
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only_with_crlf(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_rows_keep_input_order_and_use_crlf(self):
+        tasks = [
+            Task(2, "second", ["a", "b"], DONE, date(2026, 4, 1)),
+            Task(1, "first"),
+        ]
+        self.assertEqual(
+            to_csv(tasks),
+            HEADER + "\r\n2,second,a;b,done,2026-04-01\r\n1,first,,open,\r\n",
+        )
+
+    def test_plain_fields_are_not_quoted(self):
+        self.assertEqual(to_csv([Task(1, "buy milk", ["home"])]), HEADER + "\r\n1,buy milk,home,open,\r\n")
+
+    def test_title_with_comma_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "a, b")]), HEADER + '\r\n1,"a, b",,open,\r\n')
+
+    def test_title_with_quotes_is_quoted_and_doubled(self):
+        self.assertEqual(to_csv([Task(1, 'say "hi"')]), HEADER + '\r\n1,"say ""hi""",,open,\r\n')
+
+    def test_title_with_newlines_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "line1\nline2")]), HEADER + '\r\n1,"line1\nline2",,open,\r\n')
+        self.assertEqual(to_csv([Task(1, "cr\rhere")]), HEADER + '\r\n1,"cr\rhere",,open,\r\n')
+
+    def test_tag_with_comma_is_quoted(self):
+        self.assertEqual(to_csv([Task(1, "t", ["x,y", "z"])]), HEADER + '\r\n1,t,"x,y;z",open,\r\n')
+
+    def test_rejects_tags_given_as_a_string(self):
+        with self.assertRaises(AssertionError):
+            to_csv([Task(1, "t", "abc")])
+
+
+if __name__ == "__main__":
+    unittest.main()
