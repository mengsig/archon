@@ -32,6 +32,50 @@ class BasicTest(unittest.TestCase):
         self.assertTrue(limiter.try_acquire("b"))
         self.assertFalse(limiter.try_acquire("a"))
 
+    def test_fractional_refill_and_atomic_failure(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 2.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire(1))
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertAlmostEqual(bucket.wait_time(1), 0.25)
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_backward_clock_does_not_move_observation_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 1.0
+        self.assertEqual(bucket.available(), 1.0)
+        clock.now = 0.5
+        self.assertEqual(bucket.available(), 1.0)
+        clock.now = 1.5
+        self.assertEqual(bucket.available(), 1.5)
+
+    def test_validation(self):
+        for capacity, rate in ((0, 1), (1, 0), (-1, 1), (1, -1)):
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate)
+        bucket = TokenBucket(2, 1)
+        for n in (0, -1, 3):
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.subTest(n=n), self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 1, max_keys=0)
+
+    def test_keyed_lru_uses_wait_time_and_restarts_evicted_keys_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertEqual(limiter.wait_time("a"), 0.0)
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # Makes a most recently used.
+        limiter.try_acquire("c")  # Evicts b.
+        self.assertEqual(len(limiter), 2)
+        self.assertEqual(limiter.wait_time("b"), 0.0)  # b starts full again.
+
 
 if __name__ == "__main__":
     unittest.main()
