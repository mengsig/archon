+const PAGES = {
+  '': { items: [ITEMS[0]], next_cursor: 'c1' },
+  c1: { items: [ITEMS[1]], next_cursor: 'c2' },
+  c2: { items: [{ id: 3, sku: 'SKU-0003', qty: 0 }], next_cursor: null },
+};
+
+function paged(pages) {
+  const sent = [];
+  const transport = async (request) => {
+    sent.push(request);
+    const page = pages[request.query.cursor ?? ''];
+    if (page === undefined) return { status: 400, body: { error: 'invalid cursor' } };
+    return { status: 200, body: page };
+  };
+  return { transport, sent };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages in order', async () => {
+  const { transport, sent } = paged(PAGES);
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(
+    sent.map((request) => request.query),
+    [{}, { cursor: 'c1' }, { cursor: 'c2' }],
+  );
+});
