+class LedgerConcurrency(unittest.TestCase):
+    ROUNDS = 2000
+
+    def test_opposite_transfers_do_not_deadlock_and_balance(self):
+        # each account funded for ROUNDS so every transfer succeeds in any interleaving
+        ledger = Ledger({"a": self.ROUNDS, "b": self.ROUNDS})
+
+        results = []
+
+        def bounce(source, destination):
+            # assertions inside threads would not fail the test; record instead
+            results.extend(
+                ledger.transfer(source, destination, 1) for _ in range(self.ROUNDS)
+            )
+
+        threads = [
+            threading.Thread(target=bounce, args=("a", "b")),
+            threading.Thread(target=bounce, args=("b", "a")),
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            # deadlock guard; a hung thread would otherwise hang the suite
+            thread.join(timeout=60)
+            self.assertFalse(thread.is_alive())
+        self.assertEqual(results, [True] * (2 * self.ROUNDS))
+        self.assertEqual(
+            ledger.snapshot(), {"a": self.ROUNDS, "b": self.ROUNDS}
+        )
+
+    def test_snapshots_never_observe_partial_transfer(self):
+        total = 1000
+        ledger = Ledger({"a": total, "b": 0})
+        done = threading.Event()
+        observed_totals = set()
+
+        def mover():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+            done.set()
+
+        def watcher():
+            # snapshot after reading done so at least one post-mover snapshot runs
+            while True:
+                finished = done.is_set()
+                observed_totals.add(sum(ledger.snapshot().values()))
+                if finished:
+                    break
+
+        threads = [threading.Thread(target=mover), threading.Thread(target=watcher)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=60)
+            self.assertFalse(thread.is_alive())
+        self.assertEqual(observed_totals, {total})
+        self.assertEqual(ledger.snapshot(), {"a": total, "b": 0})
+
+
+if __name__ == "__main__":
+    unittest.main()
