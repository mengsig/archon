 //! Transaction parsing and CSV rendering for the `ledger` exporter.
 
+use std::fmt;
+
+/// Currency used when a line has no fourth column.
+pub const DEFAULT_CURRENCY: &str = "USD";
+
 #[derive(Debug, Clone, PartialEq, Eq)]
 pub struct Entry {
     pub date: String,
     pub account: String,
     pub amount_cents: i64,
+    pub currency: String,
 }
 
-pub const CSV_HEADER: &str = "date,account,amount_cents";
+pub const CSV_HEADER: &str = "date,account,amount_cents,currency";
 
-/// Parse one TSV line: `date<TAB>account<TAB>amount`.
-pub fn parse_line(line: &str) -> Result<Entry, String> {
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum LineError {
+    /// The currency field is not three uppercase ASCII letters.
+    BadCurrency(String),
+    /// Any other malformed line.
+    Other(String),
+}
+
+impl fmt::Display for LineError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            LineError::BadCurrency(msg) | LineError::Other(msg) => f.write_str(msg),
+        }
+    }
+}
+
+/// Parse one TSV line: `date<TAB>account<TAB>amount[<TAB>currency]`.
+pub fn parse_line(line: &str) -> Result<Entry, LineError> {
     let fields: Vec<&str> = line.split('\t').collect();
-    if fields.len() != 3 {
-        return Err(format!("expected 3 tab-separated fields, got {}", fields.len()));
+    if fields.len() != 3 && fields.len() != 4 {
+        return Err(LineError::Other(format!(
+            "expected 3 or 4 tab-separated fields, got {}",
+            fields.len()
+        )));
     }
     let date = fields[0].trim();
     if !is_iso_date(date) {
-        return Err(format!("bad date {date:?}"));
+        return Err(LineError::Other(format!("bad date {date:?}")));
     }
     let account = fields[1].trim();
     if account.is_empty() || account.contains(',') {
-        return Err(format!("bad account {account:?}"));
+        return Err(LineError::Other(format!("bad account {account:?}")));
     }
+    let amount_cents = parse_cents(fields[2].trim()).map_err(LineError::Other)?;
+    let currency = match fields.get(3) {
+        Some(field) => parse_currency(field)?,
+        None => DEFAULT_CURRENCY.to_string(),
+    };
     Ok(Entry {
         date: date.to_string(),
         account: account.to_string(),
-        amount_cents: parse_cents(fields[2].trim())?,
+        amount_cents,
+        currency,
     })
 }
 
@@ -35,7 +66,18 @@ fn is_iso_date(s: &str) -> bool {
     b.len() == 10
         && b[4] == b'-'
         && b[7] == b'-'
-        && b.iter().enumerate().all(|(i, c)| i == 4 || i == 7 || c.is_ascii_digit())
+        && b.iter()
+            .enumerate()
+            .all(|(i, c)| i == 4 || i == 7 || c.is_ascii_digit())
+}
+
+/// ISO 4217 shape: exactly three uppercase ASCII letters.
+fn parse_currency(s: &str) -> Result<String, LineError> {
+    let valid = s.len() == 3 && s.bytes().all(|c| c.is_ascii_uppercase());
+    if !valid {
+        return Err(LineError::BadCurrency(format!("bad currency {s:?}")));
+    }
+    Ok(s.to_string())
 }
 
 /// `"12.34"` → 1234, `"-5"` → -500, `"0.5"` → 50.
@@ -52,12 +94,17 @@ pub fn parse_cents(s: &str) -> Result<i64, String> {
     if !valid {
         return Err(format!("bad amount {s:?}"));
     }
-    let whole: i64 = whole.parse().map_err(|_| format!("amount {s:?} is too large"))?;
+    let whole: i64 = whole
+        .parse()
+        .map_err(|_| format!("amount {s:?} is too large"))?;
     let frac: i64 = format!("{frac:0<2}").parse().expect("two ascii digits");
     let cents = whole * 100 + frac;
     Ok(if negative { -cents } else { cents })
 }
 
 pub fn to_csv_row(entry: &Entry) -> String {
-    format!("{},{},{}", entry.date, entry.account, entry.amount_cents)
+    format!(
+        "{},{},{},{}",
+        entry.date, entry.account, entry.amount_cents, entry.currency
+    )
 }
