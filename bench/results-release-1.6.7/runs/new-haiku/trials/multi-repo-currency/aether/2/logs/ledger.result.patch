+
+#[test]
+fn rejects_bad_currency_with_status_2() {
+    for code in ["eur", "EURO", "EU", "E1R", "", "ÉUR"] {
+        let line = format!("2026-03-01\trent\t900\t{code}");
+        let err = parse_line(&line).unwrap_err();
+        assert!(matches!(err, ParseError::BadCurrency(_)), "{code:?}: {err}");
+        assert_eq!(err.exit_status(), 2, "{code:?}");
+    }
+}
+
+#[test]
+fn rejects_extra_fields_with_status_1() {
+    let err = parse_line("2026-03-01\trent\t900\tEUR\textra").unwrap_err();
+    assert!(matches!(err, ParseError::Malformed(_)));
+    assert_eq!(err.exit_status(), 1);
+}
+
+fn run_ledger(stdin: &str) -> (i32, String, String) {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(stdin.as_bytes())
+        .unwrap();
+    let out = child.wait_with_output().unwrap();
+    (
+        out.status.code().unwrap(),
+        String::from_utf8(out.stdout).unwrap(),
+        String::from_utf8(out.stderr).unwrap(),
+    )
+}
+
+#[test]
+fn exports_csv_with_currency_column() {
+    let input = "2026-03-01\tgroceries\t-45.10\n2026-03-02\trent\t9.00\tEUR\n";
+    let (code, stdout, _) = run_ledger(input);
+    assert_eq!(code, 0);
+    assert_eq!(
+        stdout,
+        format!("{CSV_HEADER}\n2026-03-01,groceries,-4510,USD\n2026-03-02,rent,900,EUR\n")
+    );
+}
+
+#[test]
+fn bad_currency_exits_2_and_names_line() {
+    let (code, stdout, stderr) =
+        run_ledger("2026-03-01\trent\t900\tEUR\n2026-03-02\tfood\t1\teur\n");
+    assert_eq!(code, 2);
+    assert!(stderr.starts_with("line 2: bad currency"), "{stderr}");
+    assert!(stdout.starts_with(CSV_HEADER));
+}
+
+#[test]
+fn malformed_line_still_exits_1() {
+    let (code, _, stderr) = run_ledger("2026-03-01\trent\tnope\n");
+    assert_eq!(code, 1);
+    assert!(stderr.starts_with("line 1: bad amount"), "{stderr}");
+}
