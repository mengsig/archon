diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..2d82bd4 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,41 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    if base_ms >= cap_ms:
+        return cap_ms
+    shift = attempt - 1
+    # base_ms >= 1, so 2**shift > cap_ms once shift >= cap_ms.bit_length().
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..548c851 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,139 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_non_int_types(self):
+        self.assertInvalid(1.0, 0)
+        self.assertInvalid(1, 0.0)
+        self.assertInvalid("1", 0)
+        self.assertInvalid(None, 0)
+        self.assertInvalid(1, 0, budget_ms=1000.0)
+        self.assertInvalid(1, 0, base_ms=100.0)
+        self.assertInvalid(1, 0, cap_ms=400.0)
+        self.assertInvalid(1, 0, max_attempts=4.0)
+        self.assertInvalid(1, 0, retry_after_ms=250.0)
+
+    def test_rejects_bool(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, False)
+        self.assertInvalid(1, 0, base_ms=True)
+        self.assertInvalid(1, 0, retry_after_ms=False)
+
+    def test_rejects_int_subclass(self):
+        class Tagged(int):
+            pass
+
+        self.assertInvalid(Tagged(1), 0)
+
+    def test_rejects_below_minimum(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, max_attempts=0)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_attempt_limit(self):
+        self.assertInvalid(4, 0, max_attempts=4, base_ms=-1)
+        self.assertInvalid(5, -1, max_attempts=4)
+        self.assertInvalid(4, 0, max_attempts=4, retry_after_ms=-1)
+
+    def test_validates_before_budget_exhaustion(self):
+        self.assertInvalid(1, 5000, budget_ms=1000, cap_ms=-1)
+        self.assertInvalid(1, 5000, budget_ms=1000, retry_after_ms=1.5)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_max_attempts_one_never_retries(self):
+        self.assertIsNone(retry_delay(1, 0, max_attempts=1, retry_after_ms=0))
+
+
+class Backoff(unittest.TestCase):
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(5, 0, base_ms=0, max_attempts=9), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+
+    def test_zero_backoff_uses_retry_after_floor(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=50), 50)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_cap_applies_to_growth(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=300, max_attempts=9), 300)
+
+    def test_matches_reference_formula(self):
+        for base_ms, cap_ms in [(1, 1), (1, 7), (3, 10), (100, 400), (7, 2**40)]:
+            for attempt in range(1, 80):
+                expected = min(cap_ms, base_ms * 2 ** (attempt - 1))
+                actual = retry_delay(
+                    attempt, 0, max_attempts=10**6, budget_ms=10**30,
+                    base_ms=base_ms, cap_ms=cap_ms)
+                self.assertEqual(actual, expected, (base_ms, cap_ms, attempt))
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**19, budget_ms=10**30), 400)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=900, budget_ms=2000),
+            900)
+
+    def test_retry_after_equal_to_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=100), 100)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+
+class Budget(unittest.TestCase):
+    def test_exact_budget_boundary_is_exhausted(self):
+        self.assertEqual(retry_delay(1, 899), 100)
+        self.assertIsNone(retry_delay(1, 900))
+
+    def test_zero_budget_allows_no_retry(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+    def test_zero_delay_fits_before_budget(self):
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+
+    def test_elapsed_past_budget_is_none(self):
+        self.assertIsNone(retry_delay(1, 5000))
+
+    def test_retry_after_is_never_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(1, 100, retry_after_ms=950))
+        self.assertEqual(retry_delay(1, 100, retry_after_ms=899), 899)
+
+    def test_huge_integers_are_supported(self):
+        self.assertEqual(
+            retry_delay(1, 10**30, budget_ms=10**31), 100)
+        self.assertIsNone(
+            retry_delay(1, 10**30, budget_ms=10**30 + 100))
+
+
+if __name__ == "__main__":
+    unittest.main()
