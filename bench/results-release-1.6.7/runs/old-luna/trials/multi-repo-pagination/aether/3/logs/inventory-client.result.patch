+test('follows cursors until the final page and returns items in order', async () => {
+  const requests = [];
+  const pages = new Map([
+    [undefined, { items: [ITEMS[0]], next_cursor: 'opaque/+cursor' }],
+    ['opaque/+cursor', { items: [ITEMS[1]], next_cursor: null }],
+  ]);
+  const transport = async (request) => {
+    requests.push(request);
+    const cursor = request.query.cursor;
+    const body = pages.get(cursor);
+    return body ? { status: 200, body } : { status: 400, body: { error: 'bad cursor' } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(requests, [
+    { method: 'GET', path: '/items', query: {} },
+    { method: 'GET', path: '/items', query: { cursor: 'opaque/+cursor' } },
+  ]);
+});
+
