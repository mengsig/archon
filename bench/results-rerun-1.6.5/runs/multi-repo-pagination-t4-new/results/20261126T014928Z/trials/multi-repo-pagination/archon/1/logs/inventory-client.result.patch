+// Follows next_cursor until it is null or absent, returning all items in order.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (body === null || typeof body !== 'object' || !Array.isArray(body.items)) {
+      throw new Error(`GET /items returned a body without an items array: ${JSON.stringify(body)}`);
+    }
+    items.push(...body.items);
+    cursor = body.next_cursor ?? null;
+    if (cursor !== null && seenCursors.has(cursor)) {
+      throw new Error(`GET /items returned repeated next_cursor ${JSON.stringify(cursor)}`);
+    }
+    if (cursor !== null) seenCursors.add(cursor);
+  } while (cursor !== null);
+  return items;
 }
 
