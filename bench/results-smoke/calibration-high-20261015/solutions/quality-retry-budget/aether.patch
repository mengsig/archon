diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..4b4f058 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,43 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate_int("attempt", attempt, minimum=1)
+    _validate_int("elapsed_ms", elapsed_ms, minimum=0)
+    _validate_int("max_attempts", max_attempts, minimum=1)
+    _validate_int("budget_ms", budget_ms, minimum=0)
+    _validate_int("base_ms", base_ms, minimum=0)
+    _validate_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _validate_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    # Server floor is a minimum wait and is deliberately not capped.
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _validate_int(name, value, *, minimum):
+    # type() check rejects bool and int subclasses, as the spec requires.
+    if type(value) is not int:
+        raise ValueError(f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms >= 1, so base_ms << shift >= 2**shift. Once shift reaches
+    # cap_ms.bit_length(), 2**shift > cap_ms, so the result is cap_ms.
+    # Checking this first avoids building a huge power of two.
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..6928298 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,161 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_and_float(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, False)
+        self.assertInvalid(1.0, 0)
+        self.assertInvalid(1, 0.5)
+        self.assertInvalid(1, 0, max_attempts=4.0)
+        self.assertInvalid(1, 0, budget_ms=True)
+        self.assertInvalid(1, 0, base_ms=1.0)
+        self.assertInvalid(1, 0, cap_ms=False)
+        self.assertInvalid(1, 0, retry_after_ms=10.0)
+
+    def test_rejects_non_numeric(self):
+        self.assertInvalid("1", 0)
+        self.assertInvalid(1, None)
+        self.assertInvalid(1, 0, retry_after_ms=True)
+
+    def test_attempt_and_max_attempts_at_least_one(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(-1, 0)
+        self.assertInvalid(1, 0, max_attempts=0)
+
+    def test_others_at_least_zero(self):
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_attempt_return(self):
+        self.assertInvalid(4, 0, max_attempts=4, base_ms=-1)
+        self.assertInvalid(5, -1, max_attempts=1)
+        self.assertInvalid(4, 0, max_attempts=4, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_budget_return(self):
+        self.assertInvalid(1, 0, budget_ms=0, base_ms=-1)
+        self.assertInvalid(1, 1000, budget_ms=1000, cap_ms=-1)
+        self.assertInvalid(1, 1000, budget_ms=0, retry_after_ms=-5)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_returns_none(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_below_max_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_greater_than_max_returns_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(1, 0, max_attempts=2), 100)
+        self.assertIsNone(retry_delay(2, 0, max_attempts=2))
+
+
+class Backoff(unittest.TestCase):
+    def test_cap_limits_backoff(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, budget_ms=10**6), 400)
+        self.assertEqual(retry_delay(9, 0, max_attempts=10, budget_ms=10**6), 400)
+
+    def test_base_above_cap_yields_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(50, 0, base_ms=0, max_attempts=100), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(50, 0, cap_ms=0, max_attempts=100), 0)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(
+            retry_delay(10**9, 0, max_attempts=10**10, budget_ms=10**12), 400)
+
+    def test_huge_attempt_with_zero_base_is_zero(self):
+        self.assertEqual(
+            retry_delay(10**9, 0, base_ms=0, max_attempts=10**10), 0)
+
+    def test_huge_cap_and_attempt_stay_exact(self):
+        cap = 2**200
+        self.assertEqual(
+            retry_delay(100, 0, base_ms=1, cap_ms=cap,
+                        max_attempts=10**6, budget_ms=2**300),
+            2**99)
+        self.assertEqual(
+            retry_delay(202, 0, base_ms=1, cap_ms=cap,
+                        max_attempts=10**6, budget_ms=2**300),
+            cap)
+
+    def test_huge_base_is_capped(self):
+        base = 10**500
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=base, cap_ms=400, budget_ms=10**6), 400)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_is_floor_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=1000, budget_ms=10**4),
+            1000)
+
+    def test_backoff_wins_when_larger(self):
+        self.assertEqual(retry_delay(3, 0, retry_after_ms=50), 400)
+
+    def test_retry_after_zero_with_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=0), 0)
+
+    def test_retry_after_pushing_past_budget_returns_none(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000, budget_ms=1000))
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000, budget_ms=999))
+
+    def test_retry_after_within_budget_returned_unshortened(self):
+        self.assertEqual(
+            retry_delay(1, 500, retry_after_ms=499, budget_ms=1000), 499)
+
+
+class Budget(unittest.TestCase):
+    def test_end_exactly_at_budget_is_rejected(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_end_one_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_elapsed_at_or_past_budget_with_zero_delay_is_rejected(self):
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+        self.assertIsNone(retry_delay(1, 1001, base_ms=0, budget_ms=1000))
+
+    def test_zero_delay_allowed_before_budget(self):
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+
+    def test_zero_budget_always_rejects(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_budget_not_shortened_to_squeeze_retry(self):
+        self.assertIsNone(retry_delay(2, 150, budget_ms=300))
+        self.assertEqual(retry_delay(2, 99, budget_ms=300), 200)
+
+    def test_huge_values_are_exact(self):
+        big = 10**30
+        self.assertIsNone(
+            retry_delay(1, big, budget_ms=big + 100, base_ms=100))
+        self.assertEqual(
+            retry_delay(1, big, budget_ms=big + 101, base_ms=100), 100)
+
+
+if __name__ == "__main__":
+    unittest.main()
