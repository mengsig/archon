+class Concurrency(unittest.TestCase):
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+
+        def forward():
+            for _ in range(250):
+                ledger.transfer("a", "b", 1)
+
+        def backward():
+            for _ in range(250):
+                ledger.transfer("b", "a", 1)
+
+        run_threads(self, [forward, forward, backward, backward])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_only_available_funds_can_leave_under_contention(self):
+        ledger = Ledger({"a": 10, "b": 0})
+        successes = []
+
+        def drain():
+            for _ in range(20):
+                if ledger.transfer("a", "b", 1):
+                    successes.append(1)
+
+        run_threads(self, [drain] * 8)
+        self.assertEqual(len(successes), 10)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 10})
+
+    def test_only_available_room_can_fill_under_contention(self):
+        ledger = Ledger({"a": 10, "b": MAX_BALANCE - 3})
+        successes = []
+
+        def fill():
+            for _ in range(10):
+                if ledger.transfer("a", "b", 1):
+                    successes.append(1)
+
+        run_threads(self, [fill] * 4)
+        self.assertEqual(len(successes), 3)
+        self.assertEqual(ledger.snapshot(), {"a": 7, "b": MAX_BALANCE})
+
+    def test_snapshots_never_see_a_half_transfer(self):
+        ledger = Ledger({"a": 500, "b": 500})
+        stop = threading.Event()
+
+        def shuffle():
+            while not stop.is_set():
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        writers = [threading.Thread(target=shuffle) for _ in range(4)]
+        for writer in writers:
+            writer.start()
+        try:
+            for _ in range(2000):
+                self.assertEqual(sum(ledger.snapshot().values()), 1000)
+        finally:
+            stop.set()
+            for writer in writers:
+                writer.join(JOIN_TIMEOUT_SECONDS)
+        self.assertFalse(any(writer.is_alive() for writer in writers))
+
+
+if __name__ == "__main__":
