index 2c7648a..d6ed03d 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,58 @@
+import re
+
+from .models import DONE, OPEN
+
+TOKEN = re.compile(r'(?:[^\s"]|"[^"]*")+')
+
+
+class QueryError(ValueError):
+    """An invalid search query."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order."""
+    matchers = [_matcher(term) for term in _terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _terms(query):
+    """Split `query` into (text, is_phrase) pairs; quotes group whitespace."""
+    assert isinstance(query, str), "query must be a string"
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    terms = []
+    for token in TOKEN.findall(query):
+        text = token.replace('"', "")
+        if text:
+            terms.append((text, token.startswith('"')))
+    return terms
+
+
+def _matcher(term):
+    text, is_phrase = term
+    if is_phrase or ":" not in text:
+        return _title_matcher(text)
+    name, _, value = text.partition(":")
+    if name == "tag":
+        return _tag_matcher(value)
+    if name == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown search field: {name}")
+
+
+def _title_matcher(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_matcher(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    needle = name.lower()
+    return lambda task: any(tag.lower() == needle for tag in task.tags)
+
+
+def _status_matcher(value):
+    if value not in (OPEN, DONE):
+        raise QueryError(f"unknown status: {value}")
+    return lambda task: task.status == value
