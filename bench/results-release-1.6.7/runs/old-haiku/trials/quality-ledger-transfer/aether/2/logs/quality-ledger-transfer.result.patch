+    def test_destination_can_reach_max_exactly(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 1})
+        self.assertIs(ledger.transfer("a", "b", 1), True)
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": MAX_BALANCE})
