diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..f92fda3 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,43 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms >= 1 here, so 2**shift >= cap_ms once shift >= cap_ms.bit_length();
+    # return cap directly to avoid building a huge power of two.
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _check_int("attempt", attempt, 1)
+    _check_int("elapsed_ms", elapsed_ms, 0)
+    _check_int("max_attempts", max_attempts, 1)
+    _check_int("budget_ms", budget_ms, 0)
+    _check_int("base_ms", base_ms, 0)
+    _check_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    # Retry-After is a floor and is deliberately not limited by cap_ms.
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..869d649 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,118 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_non_int_types(self):
+        for bad in (True, 1.0, "1"):
+            with self.subTest(value=bad):
+                with self.assertRaises(ValueError):
+                    retry_delay(bad, 0)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, max_attempts=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, budget_ms=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, base_ms=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, cap_ms=bad)
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, retry_after_ms=bad)
+
+    def test_none_retry_after_means_no_floor(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_rejects_below_minimum(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_early_returns(self):
+        # attempt >= max_attempts and budget exhaustion must not hide bad input
+        with self.assertRaises(ValueError):
+            retry_delay(4, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, retry_after_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=1, base_ms=1.5)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_equal_and_above_max_attempts(self):
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+        self.assertIsNone(retry_delay(10, 0, max_attempts=3))
+
+    def test_attempt_below_max_attempts_retries(self):
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+
+    def test_budget_is_strict(self):
+        # elapsed + delay == budget means the attempt would not start before it
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_budget_never_retries(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+    def test_zero_delay_within_budget_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 999, base_ms=0, budget_ms=1000), 0)
+
+    def test_zero_delay_still_respects_budget(self):
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+
+    def test_cap_limits_backoff(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, cap_ms=300), 300)
+        self.assertEqual(retry_delay(9, 0, max_attempts=10, cap_ms=300), 300)
+
+    def test_base_may_exceed_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=100, cap_ms=400, retry_after_ms=900,
+                        budget_ms=2000),
+            900)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_retry_after_floor_can_exhaust_budget(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+        self.assertIsNone(retry_delay(1, 500, retry_after_ms=500))
+
+    def test_huge_attempt_saturates_without_large_allocation(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**19, budget_ms=10**30),
+            400)
+
+    def test_huge_base_and_cap_have_no_upper_limit(self):
+        huge = 10**30
+        self.assertEqual(
+            retry_delay(1, 0, base_ms=huge, cap_ms=huge, budget_ms=2 * huge),
+            huge)
+        self.assertEqual(
+            retry_delay(2, 0, base_ms=huge, cap_ms=10**31, budget_ms=3 * huge),
+            2 * huge)
+
+    def test_exact_power_of_two_backoff(self):
+        # cap is not a power of two, so the bit-length shortcut must still
+        # return the exact min() value at the boundary
+        self.assertEqual(
+            retry_delay(3, 0, max_attempts=10, base_ms=1, cap_ms=5), 4)
+        self.assertEqual(
+            retry_delay(4, 0, max_attempts=10, base_ms=1, cap_ms=5), 5)
