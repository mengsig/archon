 """Token-bucket rate limiting. See SPEC.md."""
 
 import time
+from collections import OrderedDict
+
+
+def _validate_positive(value, name):
+    if not value > 0:
+        raise ValueError(f"{name} must be greater than zero")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_positive(capacity, "capacity")
+        _validate_positive(refill_per_sec, "refill_per_sec")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = capacity
+        self._last_time = clock()
+
+    def _refill(self):
+        now = self._clock()
+        if now > self._last_time:
+            self._tokens = min(
+                self.capacity,
+                self._tokens + (now - self._last_time) * self.refill_per_sec,
+            )
+            self._last_time = now
+
+    def _validate_request(self, n):
+        if not n > 0 or n > self.capacity:
+            raise ValueError("n must be greater than zero and no greater than capacity")
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        if self._tokens >= n:
+            self._tokens -= n
+            return True
+        return False
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        self._refill()
+        return max(0.0, (n - self._tokens) / self.refill_per_sec)
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _validate_positive(capacity, "capacity")
+        _validate_positive(refill_per_sec, "refill_per_sec")
+        _validate_positive(max_keys, "max_keys")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
+        self._clock = clock
+        self._buckets = OrderedDict()
+
+    def _bucket_for(self, key):
+        try:
+            bucket = self._buckets.pop(key)
+        except KeyError:
+            if len(self._buckets) + 1 > self.max_keys:
+                self._buckets.popitem(last=False)
+            bucket = TokenBucket(self.capacity, self.refill_per_sec, clock=self._clock)
+        self._buckets[key] = bucket
+        return bucket
 
     def try_acquire(self, key, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        return self._bucket_for(key).try_acquire(n)
 
     def wait_time(self, key, n=1):
-        raise NotImplementedError
+        self._validate_request(n)
+        return self._bucket_for(key).wait_time(n)
+
+    def _validate_request(self, n):
+        if not n > 0 or n > self.capacity:
+            raise ValueError("n must be greater than zero and no greater than capacity")
 
     def __len__(self):
-        raise NotImplementedError
+        return len(self._buckets)
diff --git a/test_ratelimit.py b/test_ratelimit.py
index 3474fcc..912a819 100644
--- a/test_ratelimit.py
