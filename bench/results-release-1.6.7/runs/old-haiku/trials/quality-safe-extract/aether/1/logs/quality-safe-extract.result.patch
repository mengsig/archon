--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,126 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Create the files in ``entries`` under ``root``; return their names in input order.
+
+    The whole batch is validated before the first file or directory is created.
+    I/O errors raised while creating files propagate without rollback.
+    """
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _check_root(root)
+    _check_entries(entries)
+    names = [name for name, _ in entries]
+    _check_batch_names(names)
+    directories, files = _plan(root_path, entries)
+    _create(directories, files)
+    return names
+
+
+def _check_root(root):
+    if isinstance(root, os.PathLike):
+        root = os.fspath(root)
+    if not isinstance(root, str) or not root:
+        raise ValueError(f"root must be a non-empty path, got {root!r}")
+    try:
+        mode = os.lstat(root).st_mode
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root!r}") from exc
+    if stat.S_ISLNK(mode):
+        raise ValueError(f"root must not be a symlink: {root!r}")
+    if not stat.S_ISDIR(mode):
+        raise ValueError(f"root is not a directory: {root!r}")
+    return Path(root)
+
+
+def _check_entries(entries):
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError(f"entry must be a (name, data) tuple, got {entry!r}")
+        name, data = entry
+        _check_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+
+
+def _check_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be a string, not {type(name).__name__}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name is not valid Unicode: {name!r}") from exc
+    if not name or name.startswith("/"):
+        raise ValueError(f"name must be a nonempty relative path: {name!r}")
+    if any(char in name for char in "\\:\0"):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+
+
+def _check_batch_names(names):
+    unique = set()
+    for name in names:
+        if name in unique:
+            raise ValueError(f"duplicate name in batch: {name!r}")
+        unique.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in unique:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in batch")
+
+
+def _plan(root, entries):
+    """Return (directories to create, (path, data) files to write); raise on conflicts."""
+    directories = {}
+    files = []
+    for name, data in entries:
+        missing, target = _resolve(root, name.split("/"))
+        directories.update(dict.fromkeys(missing))
+        files.append((target, data))
+    return list(directories), files
+
+
+def _resolve(root, parts):
+    """Return (missing ancestor directories, target path) after checking for conflicts."""
+    assert parts and all(parts), "names are validated before planning"
+    *ancestors, leaf = parts
+    missing = []
+    current = root
+    for part in ancestors:
+        current = current / part
+        mode = _lstat_mode(current)
+        if mode is None:
+            missing.append(current)
+        elif stat.S_ISLNK(mode):
+            raise ValueError(f"symlink in path: {current}")
+        elif not stat.S_ISDIR(mode):
+            raise ValueError(f"ancestor is not a directory: {current}")
+    target = current / leaf
+    if _lstat_mode(target) is not None:
+        raise ValueError(f"target already exists: {target}")
+    return missing, target
+
+
+def _lstat_mode(path):
+    """Return the mode of ``path`` without following links, or None if absent."""
+    try:
+        return os.lstat(path).st_mode
+    except FileNotFoundError:
+        return None
+
+
+def _create(directories, files):
+    for directory in directories:
+        os.mkdir(directory)
+    for path, data in files:
+        with open(path, "xb") as handle:
+            handle.write(data)
diff --git a/test_safe_extract.py b/test_safe_extract.py
