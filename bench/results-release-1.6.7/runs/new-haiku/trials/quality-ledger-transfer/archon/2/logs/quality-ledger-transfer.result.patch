 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _is_valid_name(name):
+    return isinstance(name, str) and name != ""
+
+
+def _is_valid_balance(value):
+    return type(value) is int and 0 <= value <= MAX_BALANCE
+
+
+def _check_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"amount must be an integer in [1, MAX_BALANCE]: {amount!r}")
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        if not isinstance(balances, dict):
+            raise ValueError(f"balances must be a dict: {type(balances).__name__}")
+        self._balances = dict(balances)
+        for name, value in self._balances.items():
+            if not _is_valid_name(name):
+                raise ValueError(f"invalid account name: {name!r}")
+            if not _is_valid_balance(value):
+                raise ValueError(f"invalid balance for {name!r}: {value!r}")
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _check_amount(amount)
+        with self._lock:
+            self._check_accounts(source, destination)
+            if self._balances[source] < amount:
+                return False
+            if source == destination:
+                return True
+            if self._balances[destination] > MAX_BALANCE - amount:
+                return False
+            self._move(source, destination, amount)
+            return True
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _check_accounts(self, source, destination):
+        for name in (source, destination):
+            if not _is_valid_name(name) or name not in self._balances:
+                raise KeyError(name)
+
+    def _move(self, source, destination, amount):
+        total_before = self._balances[source] + self._balances[destination]
+        self._balances[source] -= amount
+        self._balances[destination] += amount
+        assert self._balances[source] >= 0
+        assert self._balances[destination] <= MAX_BALANCE
+        assert self._balances[source] + self._balances[destination] == total_before
