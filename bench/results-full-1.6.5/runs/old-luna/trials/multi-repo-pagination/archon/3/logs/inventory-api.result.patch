@@ -22,7 +26,33 @@ def handle(request):
 
 def list_items(query):
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", "20")
+    if not isinstance(raw_limit, (str, int)) or not re.fullmatch(r"[0-9]+", str(raw_limit)):
+        return _error(400, "limit must be an integer from 1 to 100")
+    limit = int(raw_limit)
+    if not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    after_id = None
+    if cursor is not None:
+        if not isinstance(cursor, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", cursor):
+            return _error(400, "invalid cursor")
+        try:
+            decoded = base64.b64decode(cursor + "=" * (-len(cursor) % 4), altchars=b"-_", validate=True)
+            after_id = int(decoded)
+        except (binascii.Error, ValueError):
+            return _error(400, "invalid cursor")
+        if str(after_id).encode() != decoded or after_id not in {item["id"] for item in items}:
+            return _error(400, "invalid cursor")
+
+    if after_id is not None:
+        items = [item for item in items if item["id"] > after_id]
+    page = items[:limit]
+    next_cursor = None
+    if len(items) > limit:
+        next_cursor = base64.urlsafe_b64encode(str(page[-1]["id"]).encode()).decode().rstrip("=")
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
