@@ -33,5 +33,110 @@ class BasicTest(unittest.TestCase):
         self.assertFalse(limiter.try_acquire("a"))
 
 
+class EdgeCaseTest(unittest.TestCase):
+    def test_invalid_bucket_parameters_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate, clock=FakeClock())
+            with self.assertRaises(ValueError):
+                KeyedLimiter(capacity, rate, clock=FakeClock())
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 5.0
+        self.assertTrue(bucket.try_acquire(2))
+        clock.now = 3.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 4.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 6.0
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 2.0, clock=clock)
+        bucket.try_acquire(3)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        self.assertAlmostEqual(bucket.wait_time(), 0.25)
+
+    def test_tokens_cap_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(1)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_n_out_of_range_raises(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(2), 2.0)
+        clock.now = 2.0
+        self.assertEqual(bucket.wait_time(2), 0.0)
+        self.assertTrue(bucket.try_acquire(2))
+
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_max_keys_validation(self):
+        for max_keys in (0, -1):
+            with self.assertRaises(ValueError):
+                KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+        self.assertEqual(len(KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())), 0)
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=5, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_lru_eviction_order(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")  # "b" is now least recently used
+        limiter.try_acquire("c")  # evicts "b"
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))  # "a" survived, still empty
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # "b" is now least recently used
+        limiter.try_acquire("c")  # evicts "b"
+        self.assertFalse(limiter.try_acquire("a"))  # "a" survived, still empty
+        self.assertEqual(limiter.wait_time("b"), 0.0)  # "b" was evicted, returns full
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))  # evicts "a"
+        self.assertTrue(limiter.try_acquire("a"))  # clock unchanged, yet starts full
+
+    def test_keyed_invalid_n_does_not_create_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 2)
+        self.assertEqual(len(limiter), 0)
+
+
 if __name__ == "__main__":
     unittest.main()
