+class ExtractMalformedEntries(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.root = Path(self.tmp.name)
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def assert_rejected_without_changes(self, entries):
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(tree(self.root), [])
+
+    def test_entry_must_be_two_tuple(self):
+        bad_entries = [["a", b"x"], ("a",), ("a", b"x", b"y"), "ab", None]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                self.assert_rejected_without_changes([entry])
+
+    def test_name_must_be_str(self):
+        for name in [b"a", None, 1, Path("a")]:
+            with self.subTest(name=name):
+                self.assert_rejected_without_changes([(name, b"x")])
+
+    def test_data_must_be_bytes(self):
+        for data in ["text", bytearray(b"x"), None, 5]:
+            with self.subTest(data=data):
+                self.assert_rejected_without_changes([("a", data)])
+
+    def test_invalid_names_are_rejected(self):
+        names = [
+            "",
+            "/abs",
+            "a\\b",
+            "c:d",
+            "C:/drive",
+            "a\0b",
+            "a//b",
+            "a/",
+            "./a",
+            "a/./b",
+            "a/../b",
+            "..",
+            ".",
+        ]
+        for name in names:
+            with self.subTest(name=name):
+                self.assert_rejected_without_changes([("ok", b"x"), (name, b"y")])
+
+    def test_overlong_component_is_rejected_before_writing(self):
+        long_name = "missing/" + "a" * 256
+        self.assert_rejected_without_changes([("ok", b"x"), (long_name, b"y")])
+
+    def test_unencodable_name_is_rejected_before_writing(self):
+        self.assert_rejected_without_changes([("ok", b"x"), ("bad\ud800", b"y")])
+
+    def test_invalid_entry_later_in_batch_creates_nothing(self):
+        entries = [("first/one", b"1"), ("second/two", b"2"), ("bad\\name", b"3")]
+        self.assert_rejected_without_changes(entries)
