@@ -18,3 +18,63 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractValidation(unittest.TestCase):
+    def test_non_list_batches_are_rejected_without_consumption(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            consumed = []
+            def batch():
+                consumed.append(True)
+                yield ("file", b"data")
+            for entries in ((), iter(()), batch()):
+                with self.assertRaises(ValueError):
+                    extract(entries, Path(directory))
+            self.assertEqual(consumed, [])
+            self.assertEqual(list(Path(directory).iterdir()), [])
+
+    def test_invalid_names_and_data_do_not_write_anything(self):
+        invalid = [("", b""), ("/abs", b""), ("a//b", b""), ("a/../b", b""),
+                   ("C:drive", b""), ("a\\b", b""), ("bad\0name", b""), ("ok", bytearray())]
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            for entry in invalid:
+                with self.subTest(entry=entry), self.assertRaises(ValueError):
+                    extract([("first", b"ok"), entry], Path(directory))
+                self.assertFalse((Path(directory) / "first").exists())
+
+    def test_duplicates_and_prefix_collisions(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            for entries in ([ ("x", b"1"), ("x", b"2") ],
+                            [("a", b"1"), ("a/b", b"2")],
+                            [("a/b", b"2"), ("a", b"1")]):
+                with self.assertRaises(ValueError):
+                    extract(entries, Path(directory))
+                self.assertEqual(list(Path(directory).iterdir()), [])
+
+    def test_existing_targets_and_symlinks_are_rejected(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory, tempfile.TemporaryDirectory(dir=".") as outside:
+            root = Path(directory)
+            (root / "existing").write_bytes(b"keep")
+            (Path(outside) / "sentinel").write_bytes(b"safe")
+            (root / "link").symlink_to(Path(outside), target_is_directory=True)
+            for name in ("existing", "link/sentinel", "link/new", "dangling"):
+                if name == "dangling":
+                    (root / name).symlink_to(Path(outside) / "missing")
+                with self.assertRaises(ValueError):
+                    extract([(name, b"overwrite")], root)
+            self.assertEqual((root / "existing").read_bytes(), b"keep")
+            self.assertEqual((Path(outside) / "sentinel").read_bytes(), b"safe")
+
+    def test_invalid_root_and_empty_batch(self):
+        with tempfile.TemporaryDirectory(dir=".") as directory:
+            root = Path(directory)
+            link = root.parent / (root.name + "-link")
+            link.symlink_to(root, target_is_directory=True)
+            try:
+                with self.assertRaises(ValueError):
+                    extract([], link)
+                with self.assertRaises(ValueError):
+                    extract([], root / "missing")
+                self.assertEqual(extract([], root), [])
+            finally:
+                link.unlink()
