+class Concurrency(unittest.TestCase):
+    THREADS = 8
+    ROUNDS = 200
+    TIMEOUT = 30
+
+    def _run_all(self, threads):
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.TIMEOUT)
+            self.assertFalse(thread.is_alive(), "worker did not finish")
+
+    def test_concurrent_transfers_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100, "c": 100})
+        names = ["a", "b", "c"]
+
+        def worker(seed):
+            for i in range(self.ROUNDS):
+                src = names[(seed + i) % 3]
+                dst = names[(seed + i + 1) % 3]
+                ledger.transfer(src, dst, 1 + (i % 5))
+
+        self._run_all(
+            threading.Thread(target=worker, args=(n,)) for n in range(self.THREADS)
+        )
+        snap = ledger.snapshot()
+        self.assertEqual(sum(snap.values()), 300)
+        self.assertTrue(all(0 <= value <= MAX_BALANCE for value in snap.values()))
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 50, "b": 50})
+
+        def a_to_b():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+
+        def b_to_a():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("b", "a", 1)
+
+        self._run_all([threading.Thread(target=a_to_b), threading.Thread(target=b_to_a)])
+        self.assertEqual(sum(ledger.snapshot().values()), 100)
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 0})
+        done = threading.Event()
+
+        def mover():
+            for _ in range(self.ROUNDS):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+            done.set()
+
+        thread = threading.Thread(target=mover)
+        thread.start()
+        while not done.is_set():
+            self.assertEqual(sum(ledger.snapshot().values()), 1000)
+        thread.join(self.TIMEOUT)
+        self.assertFalse(thread.is_alive(), "worker did not finish")
+
+
+if __name__ == "__main__":
+    unittest.main()
