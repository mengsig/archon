--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,71 @@
+from tasktracker.models import DONE, OPEN
+
+KNOWN_STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    """Raised when a search query is malformed."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Return the tasks matching every term of `query`, in input order."""
+    if not isinstance(query, str):
+        raise TypeError(f"query must be a str, not {type(query).__name__}")
+    matchers = [_build_matcher(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in matchers)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quotes stay in each term."""
+    terms = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+        elif char.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+                current = []
+            continue
+        current.append(char)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    assert all(terms), "split must never yield empty terms"
+    return terms
+
+
+def _parse_term(raw):
+    """Return (field, value); field is None for a bare word or phrase."""
+    assert raw, "terms come from _split_terms and are never empty"
+    if raw.startswith('"'):
+        return None, _unquote(raw)
+    field, separator, value = raw.partition(":")
+    if not separator or not field.isidentifier():
+        return None, _unquote(raw)
+    value = _unquote(value)
+    if not value:
+        raise QueryError(f"missing value for {field!r} in query")
+    return field.lower(), value
+
+
+def _build_matcher(raw):
+    field, value = _parse_term(raw)
+    if field is None:
+        needle = value.lower()
+        return lambda task: needle in task.title.lower()
+    if field == "tag":
+        needle = value.lower()
+        return lambda task: any(tag.lower() == needle for tag in task.tags)
+    if field == "status":
+        status = value.lower()
+        if status not in KNOWN_STATUSES:
+            raise QueryError(f"unknown status {value!r} in query")
+        return lambda task: task.status == status
+    raise QueryError(f"unknown field {field!r} in query")
+
+
+def _unquote(text):
+    return text.replace('"', "")
