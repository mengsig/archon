diff --git a/test_api.py b/test_api.py
index 55cd1fd..a3337c4 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,58 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20(self):
+        body = get("/items")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(1, 21)))
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_pages_follow_next_cursor_to_the_end(self):
+        ids = []
+        cursor = None
+        pages = 0
+        while pages < 10:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            ids += [item["id"] for item in body["items"]]
+            pages += 1
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertIsNone(cursor)
+        self.assertEqual(ids, list(range(1, 58)))
+        self.assertEqual(pages, 6)
+
+    def test_non_string_query_values_are_400(self):
+        for query in [{"limit": 5}, {"limit": ["5"]}, {"cursor": ["3"]}, {"cursor": 3}]:
+            with self.subTest(query=query):
+                res = handle({"method": "GET", "path": "/items", "query": query})
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_last_page_has_null_next_cursor(self):
+        body = get("/items", limit="20", cursor="40")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_limit_covering_everything_has_null_next_cursor(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_invalid_limit_is_400(self):
+        for limit in ["0", "101", "-1", "abc", "", "1.5", " 5"]:
+            with self.subTest(limit=limit):
+                res = get("/items", limit=limit)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ["", "abc", "-3", "4x"]:
+            with self.subTest(cursor=cursor):
+                res = get("/items", cursor=cursor)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("error", res["body"])
+
 
 if __name__ == "__main__":
     unittest.main()
