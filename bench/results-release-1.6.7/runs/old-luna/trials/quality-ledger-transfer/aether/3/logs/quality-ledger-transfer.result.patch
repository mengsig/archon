+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_rejects_invalid_input_and_boolean_balances(self):
+        for balances in (None, [], {"": 1}, {1: 1}, {"a": True},
+                         {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+    def test_constructor_and_snapshot_do_not_expose_internal_state(self):
+        initial = {"a": 5}
+        ledger = Ledger(initial)
+        initial["a"] = 0
+        initial["b"] = 9
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 99
+        snapshot["b"] = 9
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_amount_is_validated_before_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error_without_mutation(self):
+        ledger = Ledger({"a": 5})
+        for source, destination in (("missing", "a"), ("a", "missing"), ([], "a")):
+            with self.subTest(source=source, destination=destination):
+                with self.assertRaises(KeyError):
+                    ledger.transfer(source, destination, 1)
+        self.assertEqual(ledger.snapshot(), {"a": 5})
+
+    def test_overflow_and_insufficient_funds_are_atomic(self):
+        ledger = Ledger({"poor": 1, "full": MAX_BALANCE, "room": 0})
+        self.assertIs(ledger.transfer("poor", "full", 1), False)
+        self.assertIs(ledger.transfer("poor", "room", 2), False)
+        self.assertEqual(ledger.snapshot(), {"poor": 1, "full": MAX_BALANCE, "room": 0})
+
+    def test_same_account_transfer_checks_funds_but_does_not_change_balance(self):
+        ledger = Ledger({"full": MAX_BALANCE, "small": 2})
+        self.assertIs(ledger.transfer("full", "full", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("small", "small", 3), False)
+        self.assertEqual(ledger.snapshot(), {"full": MAX_BALANCE, "small": 2})
+
+    def test_opposite_transfers_preserve_balances_across_threads(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        start = Barrier(3)
+        failures = []
+
+        def move(source, destination):
+            start.wait()
+            for _ in range(1000):
+                if not ledger.transfer(source, destination, 1):
+                    failures.append((source, destination))
+                    return
+
+        workers = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for worker in workers:
+            worker.start()
+        start.wait()
+        for worker in workers:
+            worker.join()
+        self.assertEqual(failures, [])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
