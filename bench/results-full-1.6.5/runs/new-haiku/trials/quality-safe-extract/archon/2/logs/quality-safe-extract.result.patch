diff --git a/safe_extract.py b/safe_extract.py
index 0007027..9f54ea2 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,127 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list of (name, data) tuples")
+    root_path = _validate_root(root)
+    checked = [_validate_entry(entry) for entry in entries]
+    names = [name for name, _, _ in checked]
+    _check_collisions(names)
+    for _, parts, _ in checked:
+        _check_target_free(root_path, parts)
+    for _, parts, data in checked:
+        _write_entry(root_path, parts, data)
+    return names
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError("root must be a non-empty string or pathlib.Path")
+    root_path = Path(root)
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as error:
+        raise ValueError(f"root is not an existing directory: {root_path}") from error
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_path}")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root is not a directory: {root_path}")
+    return root_path
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    parts = _validate_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes")
+    return name, parts, data
+
+
+def _validate_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, not {type(name).__name__}")
+    if not name:
+        raise ValueError("name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"name must be relative: {name!r}")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    parts = name.split("/")
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(f"name has an empty, '.' or '..' component: {name!r}")
+    _check_fs_encodable(name)
+    return parts
+
+
+def _check_fs_encodable(name):
+    try:
+        os.fsencode(name)
+    except UnicodeEncodeError as error:
+        raise ValueError(f"name is not filesystem-encodable: {name!r}") from error
+
+
+def _check_collisions(names):
+    seen = set()
+    for name in names:
+        if name in seen:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        seen.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in seen:
+                raise ValueError(f"{ancestor!r} conflicts with {name!r}")
+
+
+def _check_target_free(root, parts):
+    assert parts and all(parts), "name components are validated before this check"
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if index == len(parts) - 1:
+            raise ValueError(f"target already exists: {current}")
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"symlink below root: {current}")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"ancestor is not a directory: {current}")
+
+
+def _write_entry(root, parts, data):
+    parent = _make_parent_dirs(root, parts[:-1])
+    _write_new_file(parent / parts[-1], data)
+
+
+def _make_parent_dirs(root, dir_parts):
+    current = root
+    for part in dir_parts:
+        current = current / part
+        if _lstat_or_none(current) is None:
+            os.mkdir(current)
+    return current
+
+
+def _write_new_file(path, data):
+    assert isinstance(data, bytes), "data is validated before writing"
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
diff --git a/test_safe_extract.py b/test_safe_extract.py
