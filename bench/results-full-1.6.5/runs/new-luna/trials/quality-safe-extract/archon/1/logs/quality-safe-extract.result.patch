 """Extract validated regular-file entries. See SPEC.md."""
 
+from pathlib import Path
+import stat
+
+
+def _is_real_directory(path):
+    """Return whether path exists and is a directory without following links."""
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        return False
+    return stat.S_ISDIR(mode)
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    """Create the files in a validated list of ``(POSIX name, bytes)`` pairs."""
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    try:
+        root_path = Path(root)
+        root_mode = root_path.lstat().st_mode
+    except (TypeError, ValueError) as exc:
+        raise ValueError("root must be an existing real directory") from exc
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError("root must be an existing real directory") from exc
+    if not stat.S_ISDIR(root_mode):
+        raise ValueError("root must be an existing real directory")
+
+    validated = []
+    names = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        if not isinstance(name, str) or not isinstance(data, bytes):
+            raise ValueError("entry names must be strings and data must be bytes")
+        if (not name or name.startswith("/") or "\\" in name or ":" in name
+                or "\0" in name):
+            raise ValueError("unsafe path name")
+        parts = name.split("/")
+        if any(part in ("", ".", "..") for part in parts):
+            raise ValueError("unsafe path component")
+        if name in names:
+            raise ValueError("duplicate path name")
+        names.add(name)
+        validated.append((name, data, parts))
+
+    # A file cannot also be an ancestor directory, regardless of entry order.
+    for name, _, parts in validated:
+        for index in range(1, len(parts)):
+            if "/".join(parts[:index]) in names:
+                raise ValueError("file/directory path collision")
+
+    # Inspect every existing path component without following symlinks. This
+    # completes all validation before mkdir/open can alter the filesystem.
+    for _, _, parts in validated:
+        current = root_path
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                mode = current.lstat().st_mode
+            except FileNotFoundError:
+                break
+            if stat.S_ISLNK(mode):
+                raise ValueError("path contains a symlink")
+            if index < len(parts) - 1:
+                if not stat.S_ISDIR(mode):
+                    raise ValueError("path ancestor is not a directory")
+            else:
+                raise ValueError("target already exists")
+
+    for name, data, parts in validated:
+        parent = root_path.joinpath(*parts[:-1])
+        parent.mkdir(parents=True, exist_ok=True)
+        target = root_path.joinpath(*parts)
+        with target.open("xb") as output:
+            output.write(data)
+    return [name for name, _, _ in validated]
