+function pagedTransport(pages, seen = []) {
+  return async (request) => {
+    seen.push(request);
+    const index = request.query.cursor === undefined ? 0 : Number(request.query.cursor);
+    return { status: 200, body: pages[index] };
+  };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages, in order', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: '1' },
+    { items: [ITEMS[1]], next_cursor: null },
+  ];
+  const seen = [];
+  assert.deepEqual(await listItems(pagedTransport(pages, seen)), ITEMS);
+  assert.deepEqual(seen.map((req) => req.query), [{}, { cursor: '1' }]);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const seen = [];
+  const transport = pagedTransport([{ items: ITEMS }], seen);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('rejects a next_cursor that does not advance', async () => {
+  const pages = [{ items: [ITEMS[0]], next_cursor: 'same' }];
+  const stuck = async () => ({ status: 200, body: pages[0] });
+  await assert.rejects(listItems(stuck), /same next_cursor/);
+});
+
