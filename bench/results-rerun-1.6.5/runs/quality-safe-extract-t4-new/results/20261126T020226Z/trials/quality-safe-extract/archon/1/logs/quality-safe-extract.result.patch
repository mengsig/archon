+            "..",
+            "./a",
+            "../a",
+            "/",
+        ]
+        for name in invalid:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b"1"), (name, b"x")], self.root)
+        self.assertRootEmpty()
+
+    def test_names_are_not_normalized_or_decoded(self):
+        names = ["100%.txt", "%2e%2e/x", "sp ace/é.txt", ".hidden", "a..b"]
+        self.assertEqual(extract([(n, b"x") for n in names], self.root), names)
+        for name in names:
+            self.assertEqual((self.root / name).read_bytes(), b"x")
+
+    def test_lone_surrogate_names_are_rejected(self):
