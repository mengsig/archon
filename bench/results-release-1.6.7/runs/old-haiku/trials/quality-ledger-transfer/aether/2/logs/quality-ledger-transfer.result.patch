+class Concurrency(unittest.TestCase):
+    THREAD_JOIN_SECONDS = 30
+
+    def run_threads(self, targets):
+        threads = [threading.Thread(target=target) for target in targets]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.THREAD_JOIN_SECONDS)
+            self.assertFalse(thread.is_alive(), "thread did not finish: possible deadlock")
+
+    def test_opposite_transfers_do_not_deadlock_and_balance(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        results = []
+
+        def move(source, destination):
+            for _ in range(1000):
+                results.append(ledger.transfer(source, destination, 1))
+
+        self.run_threads([lambda: move("a", "b"), lambda: move("b", "a")])
+        self.assertEqual(results, [True] * 2000)
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 500, "b": 500})
+        totals = []
+
+        def move():
+            for _ in range(1000):
+                ledger.transfer("a", "b", 1)
+                ledger.transfer("b", "a", 1)
+
+        def observe():
+            for _ in range(1000):
+                totals.append(sum(ledger.snapshot().values()))
+
+        self.run_threads([move, observe])
+        self.assertEqual(set(totals), {1000})
+
+
+if __name__ == "__main__":
+    unittest.main()
