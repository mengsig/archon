 """Token-bucket rate limiting. See SPEC.md."""
 
+import math
 import time
+from collections import OrderedDict
+
+
+def _positive_finite(value, name):
+    try:
+        valid = math.isfinite(value) and value > 0
+    except (TypeError, ValueError, OverflowError):
+        valid = False
+    if not valid:
+        raise ValueError("%s must be a positive finite number" % name)
+
+
+def _validate_request(n, capacity):
+    try:
+        valid = math.isfinite(n) and n > 0 and n <= capacity
+    except (TypeError, ValueError, OverflowError):
+        valid = False
+    if not valid:
+        raise ValueError("n must be positive and no greater than capacity")
 
 
 class TokenBucket:
     def __init__(self, capacity, refill_per_sec, clock=time.monotonic):
-        raise NotImplementedError
+        _positive_finite(capacity, "capacity")
+        _positive_finite(refill_per_sec, "refill_per_sec")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self._clock = clock
+        self._tokens = capacity
+        self._updated_at = clock()
+
+    def _refill(self, now=None):
+        if now is None:
+            now = self._clock()
+        if now < self._updated_at:
+            return False
+        elapsed = now - self._updated_at
+        self._tokens = min(self.capacity, self._tokens + elapsed * self.refill_per_sec)
+        self._updated_at = now
+        return True
 
     def try_acquire(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        if not self._refill() or self._tokens < n:
+            return False
+        self._tokens -= n
+        return True
 
     def available(self):
-        raise NotImplementedError
+        self._refill()
+        return self._tokens
 
     def wait_time(self, n=1):
-        raise NotImplementedError
+        _validate_request(n, self.capacity)
+        now = self._clock()
+        if not self._refill(now):
+            return self._updated_at - now + max(0.0, n - self._tokens) / self.refill_per_sec
+        if self._tokens >= n:
+            return 0.0
+        return (n - self._tokens) / self.refill_per_sec
 
 
 class KeyedLimiter:
     def __init__(self, capacity, refill_per_sec, max_keys=1024, clock=time.monotonic):
-        raise NotImplementedError
+        _positive_finite(capacity, "capacity")
+        _positive_finite(refill_per_sec, "refill_per_sec")
+        try:
+            valid_max_keys = isinstance(max_keys, int) and not isinstance(max_keys, bool) and max_keys >= 1
+        except TypeError:
+            valid_max_keys = False
+        if not valid_max_keys:
+            raise ValueError("max_keys must be an integer of at least 1")
+        self.capacity = capacity
+        self.refill_per_sec = refill_per_sec
+        self.max_keys = max_keys
