diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..0ad7aca 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,49 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _validate_args(attempt, elapsed_ms, max_attempts, budget_ms,
+                   base_ms, cap_ms, retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff_ms(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    assert delay >= 0, "delay must be non-negative"
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _validate_args(attempt, elapsed_ms, max_attempts, budget_ms,
+                   base_ms, cap_ms, retry_after_ms):
+    _check_int("attempt", attempt, minimum=1)
+    _check_int("max_attempts", max_attempts, minimum=1)
+    _check_int("elapsed_ms", elapsed_ms, minimum=0)
+    _check_int("budget_ms", budget_ms, minimum=0)
+    _check_int("base_ms", base_ms, minimum=0)
+    _check_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, minimum=0)
+
+
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(
+            f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff_ms(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without huge powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    if base_ms >= cap_ms:
+        return cap_ms
+    # base_ms >= 1 here, so 2**shift > cap_ms once shift reaches cap's bit length.
+    shift = attempt - 1
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..4f475aa 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,148 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_last_allowed_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_attempt_equal_to_max_is_exhausted(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_is_exhausted(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertIsNone(retry_delay(2, 0, max_attempts=2))
+
+
+class BudgetBoundary(unittest.TestCase):
+    def test_finishing_strictly_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_finishing_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_wait_is_not_shortened_to_fit_budget(self):
+        self.assertIsNone(retry_delay(2, 800, budget_ms=1000))
+
+    def test_retry_after_past_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=1000,
+                                      retry_after_ms=1000))
+
+    def test_zero_budget_never_retries(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+    def test_zero_delay_within_budget_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+
+
+class BackoffShape(unittest.TestCase):
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(5, 0, max_attempts=10, base_ms=0), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(5, 0, max_attempts=10, cap_ms=0), 0)
+
+    def test_cap_limits_growth(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, budget_ms=10**9,
+                                     cap_ms=300), 300)
+
+    def test_base_above_cap_returns_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=50, retry_after_ms=300),
+                         300)
+
+    def test_matches_naive_formula_on_small_inputs(self):
+        for attempt in range(1, 15):
+            for base in range(0, 6):
+                for cap in range(0, 40):
+                    expected = min(cap, base * 2 ** (attempt - 1))
+                    with self.subTest(attempt=attempt, base=base, cap=cap):
+                        actual = retry_delay(attempt, 0, max_attempts=100,
+                                             budget_ms=10**9, base_ms=base,
+                                             cap_ms=cap)
+                        self.assertEqual(actual, expected)
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1,
+                        budget_ms=10**30, base_ms=1, cap_ms=400),
+            400)
+
+    def test_huge_cap_with_moderate_attempt_is_exact(self):
+        cap = 10**100
+        self.assertEqual(
+            retry_delay(200, 0, max_attempts=300, budget_ms=10**200,
+                        base_ms=1, cap_ms=cap),
+            2 ** 199)
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_in_every_numeric_argument(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, True)
+        self.assertInvalid(1, 0, max_attempts=True)
+        self.assertInvalid(1, 0, budget_ms=True)
+        self.assertInvalid(1, 0, base_ms=True)
+        self.assertInvalid(1, 0, cap_ms=True)
+        self.assertInvalid(1, 0, retry_after_ms=True)
+
+    def test_rejects_float(self):
+        self.assertInvalid(1.0, 0)
+        self.assertInvalid(1, 0.0)
+        self.assertInvalid(1, 0, budget_ms=1000.0)
+        self.assertInvalid(1, 0, base_ms=100.0)
+        self.assertInvalid(1, 0, cap_ms=400.0)
+        self.assertInvalid(1, 0, retry_after_ms=1.5)
+
+    def test_rejects_non_numeric_types(self):
+        self.assertInvalid("1", 0)
+        self.assertInvalid(1, None)
+        self.assertInvalid(1, 0, retry_after_ms="10")
+
+    def test_rejects_attempt_below_one(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(-1, 0)
+
+    def test_rejects_max_attempts_below_one(self):
+        self.assertInvalid(1, 0, max_attempts=0)
+
+    def test_rejects_negative_elapsed_budget_base_cap_retry_after(self):
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_invalid_argument_raises_even_when_attempts_exhausted(self):
+        self.assertInvalid(10, -1, max_attempts=1)
+        self.assertInvalid(10, 0, max_attempts=1, base_ms=-5)
+        self.assertInvalid(10, 0, max_attempts=1, retry_after_ms=1.0)
+
+    def test_invalid_argument_raises_even_when_budget_exhausted(self):
+        self.assertInvalid(1, 5000, budget_ms=1000, cap_ms=-1)
+
+    def test_none_retry_after_is_accepted(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_int_subclasses_are_rejected(self):
+        class MyInt(int):
+            pass
+
+        self.assertInvalid(MyInt(1), 0)
+
+    def test_zero_is_valid_for_minimums(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, cap_ms=0,
+                                     budget_ms=1, retry_after_ms=0), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
