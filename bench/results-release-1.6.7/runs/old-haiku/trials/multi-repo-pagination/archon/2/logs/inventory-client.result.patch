+// Follows next_cursor until it is null or absent, returning items in page order.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  let cursor;
+  do {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    if (body === null || typeof body !== 'object' || !Array.isArray(body.items)) {
+      throw new Error(`GET /items returned no items array: ${JSON.stringify(body)}`);
+    }
+    if (body.next_cursor !== undefined && body.next_cursor !== null && typeof body.next_cursor !== 'string') {
+      throw new Error(`GET /items returned a non-string next_cursor: ${JSON.stringify(body.next_cursor)}`);
+    }
+    items.push(...body.items);
+    cursor = body.next_cursor;
+  } while (cursor !== undefined && cursor !== null);
+  return items;
 }
 
