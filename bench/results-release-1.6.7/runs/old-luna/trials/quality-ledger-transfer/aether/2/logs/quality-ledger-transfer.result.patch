+
+
+class LedgerBoundaries(unittest.TestCase):
+    def test_constructor_validation_and_copying(self):
+        for value in (None, [], {"": 0}, {1: 0}, {"a": True},
+                      {"a": -1}, {"a": MAX_BALANCE + 1}, {"a": 1.0}):
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    Ledger(value)
+
+        original = {"a": 4}
+        ledger = Ledger(original)
+        original["a"] = 0
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 100
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_amount_is_validated_before_accounts(self):
+        ledger = Ledger({"a": 1})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.5):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also-missing", amount)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+    def test_overflow_failure_is_atomic(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE - 2})
+        before = ledger.snapshot()
+        self.assertFalse(ledger.transfer("a", "b", 3))
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_same_account_and_maximum_amount(self):
+        ledger = Ledger({"full": MAX_BALANCE, "small": 2})
+        self.assertTrue(ledger.transfer("full", "full", MAX_BALANCE))
+        self.assertFalse(ledger.transfer("small", "small", 3))
+        self.assertEqual(ledger.snapshot(), {"full": MAX_BALANCE, "small": 2})
+
+    def test_parallel_opposite_transfers_preserve_total(self):
+        ledger = Ledger({"a": 100, "b": 100})
+
+        def move(source, destination):
+            for _ in range(500):
+                ledger.transfer(source, destination, 1)
+
+        threads = [Thread(target=move, args=("a", "b")),
+                   Thread(target=move, args=("b", "a"))]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        self.assertEqual(sum(ledger.snapshot().values()), 200)
