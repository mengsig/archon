+class LedgerTransferSemantics(unittest.TestCase):
+    def test_exact_balance_transfers(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", 5), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 5})
+
+    def test_insufficient_funds_leaves_balances_unchanged(self):
+        ledger = Ledger({"a": 4, "b": 1})
+        self.assertIs(ledger.transfer("a", "b", 5), False)
+        self.assertEqual(ledger.snapshot(), {"a": 4, "b": 1})
+
+    def test_destination_overflow_returns_false(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE})
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": MAX_BALANCE})
+
+    def test_destination_reaches_exact_max(self):
+        ledger = Ledger({"a": 3, "b": MAX_BALANCE - 2})
+        self.assertIs(ledger.transfer("a", "b", 2), True)
+        self.assertEqual(ledger.snapshot(), {"a": 1, "b": MAX_BALANCE})
+
+    def test_successful_transfer_preserves_total(self):
+        ledger = Ledger({"a": 100, "b": 50, "c": 0})
+        ledger.transfer("a", "c", 30)
+        ledger.transfer("b", "a", 50)
+        snap = ledger.snapshot()
+        self.assertEqual(sum(snap.values()), 150)
+        self.assertEqual(snap, {"a": 120, "b": 0, "c": 30})
+
+    def test_failed_transfer_after_success_leaves_state_unchanged(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        ledger.transfer("a", "b", 5)
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 5})
+
