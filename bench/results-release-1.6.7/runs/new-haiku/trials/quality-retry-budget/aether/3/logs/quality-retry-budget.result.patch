diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..84b7491 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,44 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the ms to wait before the next attempt, or None if none may start."""
+    _require_int("attempt", attempt, minimum=1)
+    _require_int("max_attempts", max_attempts, minimum=1)
+    _require_int("elapsed_ms", elapsed_ms, minimum=0)
+    _require_int("budget_ms", budget_ms, minimum=0)
+    _require_int("base_ms", base_ms, minimum=0)
+    _require_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff_ms(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    assert delay >= 0, "delay must be non-negative"
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff_ms(attempt, base_ms, cap_ms):
+    """Return min(cap_ms, base_ms * 2**(attempt - 1)) without huge powers."""
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    doublings = attempt - 1
+    if doublings >= cap_ms.bit_length():
+        # 2**doublings is then larger than cap_ms, so the cap always wins.
+        return cap_ms
+    backoff = min(cap_ms, base_ms << doublings)
+    assert 0 <= backoff <= cap_ms, "backoff must lie within [0, cap_ms]"
+    return backoff
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..17d1b86 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,139 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_rejects_bool_and_float(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, False)
+        self.assertInvalid(1, 0, max_attempts=4.0)
+        self.assertInvalid(1, 0, budget_ms=1000.0)
+        self.assertInvalid(1, 0, base_ms=True)
+        self.assertInvalid(1, 0, cap_ms=1.5)
+        self.assertInvalid(1, 0, retry_after_ms=False)
+
+    def test_rejects_non_numbers(self):
+        self.assertInvalid("1", 0)
+        self.assertInvalid(1, None)
+        self.assertInvalid(1, 0, retry_after_ms="5")
+
+    def test_rejects_out_of_range(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(1, 0, max_attempts=0)
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_attempts(self):
+        self.assertInvalid(4, -1)
+        self.assertInvalid(4, 0, base_ms=-1)
+        self.assertInvalid(1, 0, max_attempts=1, retry_after_ms=-5)
+
+    def test_validates_before_exhausted_budget(self):
+        self.assertInvalid(1, 0, budget_ms=0, base_ms=-1)
+        self.assertInvalid(1, 1000, budget_ms=0, cap_ms=2.0)
+
+    def test_accepts_zero_boundaries(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_exhausted_attempts_ignore_retry_after(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4, retry_after_ms=0))
+
+
+class Backoff(unittest.TestCase):
+    def test_doubles_then_caps(self):
+        delays = [retry_delay(a, 0, max_attempts=10, budget_ms=10**9)
+                  for a in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_base_may_exceed_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=300), 300)
+
+    def test_zero_base_yields_zero(self):
+        self.assertEqual(retry_delay(5, 0, base_ms=0, max_attempts=9), 0)
+
+    def test_zero_cap_yields_zero(self):
+        self.assertEqual(retry_delay(5, 0, cap_ms=0, max_attempts=9), 0)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1, budget_ms=10**30),
+            400)
+
+    def test_huge_attempt_with_huge_cap_does_not_blow_up(self):
+        cap = 10**40
+        self.assertEqual(
+            retry_delay(10**18, 0, max_attempts=10**18 + 1,
+                        base_ms=1, cap_ms=cap, budget_ms=10**50),
+            cap)
+
+    def test_exact_power_of_two_boundary(self):
+        self.assertEqual(
+            retry_delay(3, 0, base_ms=1, cap_ms=4, budget_ms=10), 4)
+        self.assertEqual(
+            retry_delay(3, 0, base_ms=1, cap_ms=5, budget_ms=10), 4)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_floor_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=5000, cap_ms=400,
+                        budget_ms=10**6),
+            5000)
+
+    def test_backoff_wins_when_larger(self):
+        self.assertEqual(retry_delay(3, 0, retry_after_ms=50), 400)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(2, 0, retry_after_ms=0), 200)
+
+
+class Budget(unittest.TestCase):
+    def test_exact_boundary_is_refused(self):
+        # elapsed + delay == budget means the attempt would not start strictly before it.
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_below_boundary_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_budget_refuses_everything(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0, base_ms=0))
+
+    def test_wait_is_never_shortened_to_fit(self):
+        self.assertIsNone(
+            retry_delay(1, 0, budget_ms=300, retry_after_ms=300))
+        self.assertIsNone(retry_delay(1, 50, budget_ms=300, retry_after_ms=250))
+
+    def test_zero_delay_allowed_when_elapsed_below_budget(self):
+        self.assertEqual(retry_delay(1, 999, budget_ms=1000, base_ms=0), 0)
+        self.assertIsNone(retry_delay(1, 1000, budget_ms=1000, base_ms=0))
+
+    def test_huge_values_are_exact(self):
+        big = 10**30
+        self.assertEqual(
+            retry_delay(1, big, budget_ms=big + 101, base_ms=100), 100)
+        self.assertIsNone(
+            retry_delay(1, big, budget_ms=big + 100, base_ms=100))
+
+
+if __name__ == "__main__":
+    unittest.main()
