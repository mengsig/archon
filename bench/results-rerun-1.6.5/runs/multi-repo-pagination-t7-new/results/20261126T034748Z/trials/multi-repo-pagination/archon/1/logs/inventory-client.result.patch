 async function listItems(transport) {
-  const body = await request(transport, '/items');
-  return body.items;
+  const items = [];
+  const seenCursors = new Set();
+  let query = {};
+  for (;;) {
+    const body = await request(transport, '/items', query);
+    if (!body || !Array.isArray(body.items)) {
+      throw new Error(`GET /items returned no items array: ${JSON.stringify(body)}`);
+    }
+    items.push(...body.items);
+    const cursor = body.next_cursor;
+    if (cursor === null || cursor === undefined) return items;
+    if (seenCursors.has(cursor)) {
+      throw new Error(`GET /items repeated cursor ${JSON.stringify(cursor)}; stopping`);
+    }
+    seenCursors.add(cursor);
+    query = { cursor };
+  }
 }
 
