diff --git a/test_api.py b/test_api.py
index 55cd1fd..137eb36 100644
--- a/test_api.py
+++ b/test_api.py
@@ -24,6 +24,55 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_first_page_uses_default_limit(self):
+        body = get("/items")["body"]
+        self.assertEqual(len(body["items"]), 20)
+        self.assertEqual(body["items"][0]["id"], 1)
+        self.assertEqual(body["next_cursor"], "20")
+
+    def test_following_cursors_visits_every_item_once(self):
+        ids = []
+        cursor = None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            body = get("/items", **query)["body"]
+            ids.extend(item["id"] for item in body["items"])
+            cursor = body["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_cursor(self):
+        body = get("/items", limit="20", cursor="40")["body"]
+        self.assertEqual([item["id"] for item in body["items"]], list(range(41, 58)))
+        self.assertIsNone(body["next_cursor"])
+
+    def test_exact_fit_has_null_cursor(self):
+        body = get("/items", limit="57")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_limit_100_is_accepted(self):
+        body = get("/items", limit="100")["body"]
+        self.assertEqual(len(body["items"]), 57)
+        self.assertIsNone(body["next_cursor"])
+
+    def test_cursor_past_end_gives_empty_last_page(self):
+        body = get("/items", cursor="999")["body"]
+        self.assertEqual(body, {"items": [], "next_cursor": None})
+
+    def test_invalid_limit_is_400(self):
+        for limit in ["0", "101", "-1", "abc", "", "1.5", "1_0", "٣", "2²"]:
+            res = get("/items", limit=limit)
+            self.assertEqual(res["status"], 400, limit)
+            self.assertIn("limit", res["body"]["error"])
+
+    def test_invalid_cursor_is_400(self):
+        for cursor in ["abc", "", "-3", "12x", "٣", "2²"]:
+            res = get("/items", cursor=cursor)
+            self.assertEqual(res["status"], 400, cursor)
+            self.assertIn("cursor", res["body"]["error"])
+
 
 if __name__ == "__main__":
     unittest.main()
