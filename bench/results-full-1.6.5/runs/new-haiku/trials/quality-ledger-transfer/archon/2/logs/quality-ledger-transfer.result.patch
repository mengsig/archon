 """Bounded, thread-safe ledger. See SPEC.md."""
 
+import threading
+
 MAX_BALANCE = 2**63 - 1
 
 
+def _validate_name(name):
+    if not isinstance(name, str) or name == "":
+        raise ValueError(f"account name must be a nonempty string: {name!r}")
+
+
+def _validate_amount(amount):
+    if type(amount) is not int or not 1 <= amount <= MAX_BALANCE:
+        raise ValueError(f"amount must be an integer in [1, MAX_BALANCE]: {amount!r}")
+
+
+def _validate_balance(balance):
+    if type(balance) is not int or not 0 <= balance <= MAX_BALANCE:
+        raise ValueError(f"balance must be an integer in [0, MAX_BALANCE]: {balance!r}")
+
+
+def _validate_balances(balances):
+    if not isinstance(balances, dict):
+        raise ValueError(f"balances must be a dict: {type(balances).__name__}")
+    for name, balance in balances.items():
+        _validate_name(name)
+        _validate_balance(balance)
+
+
 class Ledger:
     def __init__(self, balances):
-        raise NotImplementedError
+        _validate_balances(balances)
+        self._balances = dict(balances)
+        self._lock = threading.Lock()
 
     def transfer(self, source, destination, amount):
-        raise NotImplementedError
+        _validate_amount(amount)
+        with self._lock:
+            _require_accounts(self._balances, source, destination)
+            if source == destination:
+                return self._balances[source] >= amount
+            return self._move(source, destination, amount)
 
     def snapshot(self):
-        raise NotImplementedError
+        with self._lock:
+            return dict(self._balances)
+
+    def _move(self, source, destination, amount):
+        """Debit source and credit destination; caller holds the lock."""
+        if self._balances[source] < amount:
+            return False
+        if self._balances[destination] + amount > MAX_BALANCE:
+            return False
+        self._balances[source] -= amount
+        self._balances[destination] += amount
+        assert 0 <= self._balances[source] <= MAX_BALANCE
+        assert 0 <= self._balances[destination] <= MAX_BALANCE
+        return True
+
+
+def _require_accounts(balances, source, destination):
+    for name in (source, destination):
+        if name not in balances:
+            raise KeyError(name)
