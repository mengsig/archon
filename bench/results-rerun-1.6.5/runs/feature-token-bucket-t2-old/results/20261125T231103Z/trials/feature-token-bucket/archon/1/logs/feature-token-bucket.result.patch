+class BucketValidationTest(unittest.TestCase):
+    def test_nonpositive_params_rejected(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_non_numeric_and_nonfinite_params_rejected(self):
+        for capacity, rate in [(True, 1.0), ("3", 1.0), (3, None),
+                               (float("nan"), 1.0), (3, float("inf"))]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises((TypeError, ValueError)):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_bad_request_size_rejected_and_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        for n in (0, -1, 3):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2)
+
+    def test_nan_clock_fails_loudly(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = float("nan")
+        with self.assertRaises(ValueError):
+            bucket.try_acquire()
+
+
+class BucketBehaviourTest(unittest.TestCase):
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_refill_never_exceeds_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3)
+
+    def test_clock_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(4, 1.0, clock=clock)
+        bucket.try_acquire(4)
+        clock.now = 2.0
+        self.assertEqual(bucket.available(), 0)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_clock_regression_grants_no_credit_on_return(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        clock.now = 3.0
+        self.assertAlmostEqual(bucket.available(), 5.0)
+        clock.now = 6.0
+        self.assertAlmostEqual(bucket.available(), 6.0)
+
+    def test_wait_time_is_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_rejected_acquire_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 1.0, clock=clock)
+        bucket.try_acquire(3)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_wait_time_leaves_tokens_unchanged_when_available(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 1.0, clock=clock)
+        bucket.try_acquire(1)
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        self.assertAlmostEqual(bucket.available(), 3.0)
+
+    def test_wait_time_reports_seconds_until_success(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 1.5
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_available_reports_refill_without_consuming(self):
+        clock = FakeClock()
+        bucket = TokenBucket(5, 1.0, clock=clock)
+        bucket.try_acquire(5)
+        clock.now = 2.0
+        self.assertAlmostEqual(bucket.available(), 2.0)
+        self.assertAlmostEqual(bucket.available(), 2.0)
+
