     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    if after is not None:
+        items = [item for item in items if item["id"] > after]
+    page = items[:limit]
+    next_cursor = str(page[-1]["id"]) if len(items) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not _is_digits(raw) or not 1 <= int(raw) <= MAX_LIMIT:
+        raise ValueError(f"limit must be an integer from 1 to {MAX_LIMIT}")
+    return int(raw)
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None
+    if not _is_digits(raw):
+        raise ValueError("cursor is not valid")
+    return int(raw)
+
+
+def _is_digits(raw):
+    return isinstance(raw, str) and raw.isascii() and raw.isdigit()
 
 
