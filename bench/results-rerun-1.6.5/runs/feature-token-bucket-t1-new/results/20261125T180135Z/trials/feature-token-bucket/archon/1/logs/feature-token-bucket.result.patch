+class BucketValidationTest(unittest.TestCase):
+    def test_invalid_capacity_or_rate_raises(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5)]:
+            with self.subTest(capacity=capacity, rate=rate):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, rate, clock=FakeClock())
+
+    def test_invalid_n_raises_for_acquire_and_wait(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_non_finite_capacity_or_rate_raises(self):
+        for value in [float("nan"), float("inf"), float("-inf")]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    TokenBucket(value, 1.0, clock=FakeClock())
+                with self.assertRaises(ValueError):
+                    TokenBucket(2, value, clock=FakeClock())
+
+    def test_non_finite_n_raises_and_keeps_tokens(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [float("nan"), float("inf"), float("-inf")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_full_capacity_request_is_allowed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+        self.assertTrue(bucket.try_acquire(2))
+
+
+class BucketBehaviourTest(unittest.TestCase):
+    def test_fractional_refill_accrues(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 4.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.1
+        self.assertAlmostEqual(bucket.available(), 0.4)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.25
+        self.assertTrue(bucket.try_acquire())
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_wait_time_is_seconds_until_acquire_succeeds(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 1.5
+        self.assertEqual(bucket.wait_time(3), 0.0)
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_refill_resumes_from_latest_seen_time(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        bucket.available()
+        clock.now = 10.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
