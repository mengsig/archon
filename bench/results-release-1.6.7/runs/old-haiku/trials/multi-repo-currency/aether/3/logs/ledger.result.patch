+
+#[test]
+fn currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes_as_exit_2() {
+    for line in [
+        "2026-03-01\tgroceries\t1\teur",
+        "2026-03-01\tgroceries\t1\tEURO",
+        "2026-03-01\tgroceries\t1\tE1R",
+        "2026-03-01\tgroceries\t1\t",
+        "2026-03-01\tgroceries\t1\tÉUR",
+    ] {
+        let err = parse_line(line).unwrap_err();
+        assert!(matches!(err, ParseError::BadCurrency(_)), "{line:?}: {err}");
+        assert_eq!(err.exit_code(), 2, "{line:?}");
+    }
+}
+
+#[test]
+fn other_errors_keep_exit_1() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tUSD\textra").unwrap_err();
+    assert!(matches!(err, ParseError::Malformed(_)));
+    assert_eq!(err.exit_code(), 1);
+}
+
+#[test]
+fn header_names_currency_column() {
+    assert_eq!(CSV_HEADER, "date,account,amount_cents,currency");
