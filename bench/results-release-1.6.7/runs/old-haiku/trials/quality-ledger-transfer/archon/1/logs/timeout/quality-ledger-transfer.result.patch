+def _transfer_worker(ledger, source, destination, amount, outcomes, index):
+    def work():
+        outcomes[index] = sum(
+            1 for _ in range(ATTEMPTS_PER_THREAD)
+            if ledger.transfer(source, destination, amount)
+        )
+    return work
+
+
+def _run_threads(test, workers):
+    errors = []
+
+    def guarded(work):
+        def run():
+            try:
+                work()
+            except Exception as exc:
+                errors.append(exc)
+        return run
+
+    threads = [threading.Thread(target=guarded(w), daemon=True) for w in workers]
+    for thread in threads:
+        thread.start()
+    deadline = time.monotonic() + JOIN_TIMEOUT_S
+    for thread in threads:
+        thread.join(max(0.0, deadline - time.monotonic()))
+    hung = [thread for thread in threads if thread.is_alive()]
+    test.assertEqual(hung, [], "threads did not finish: possible deadlock")
+    test.assertEqual(errors, [])
+
+
+class _ProbeLock:
+    """Real lock that runs one probe right after its first release."""
+
+    def __init__(self, probe):
+        self._lock = threading.Lock()
+        self._probe = probe
+
+    def __enter__(self):
+        self._lock.acquire()
+
+    def __exit__(self, *exc_info):
+        self._lock.release()
+        probe, self._probe = self._probe, None
+        if probe is not None:
+            probe()
+
+
+def _run_in_thread(fn):
+    """Return [fn()], or [] if fn did not finish within the hang guard."""
+    outcome = []
+    thread = threading.Thread(target=lambda: outcome.append(fn()), daemon=True)
+    thread.start()
+    thread.join(JOIN_TIMEOUT_S)
+    return outcome
+
+
+class ConcurrencyTests(unittest.TestCase):
+    def setUp(self):
+        self._saved_switch_interval = sys.getswitchinterval()
+        sys.setswitchinterval(1e-6)
+
+    def tearDown(self):
+        sys.setswitchinterval(self._saved_switch_interval)
+
+    def test_transfer_and_snapshot_wait_for_the_lock(self):
+        ledger = Ledger({"a": 5, "b": 0})
+        results = {}
+        threads = {
+            "transfer": threading.Thread(
+                target=lambda: results.update(transfer=ledger.transfer("a", "b", 1)),
+                daemon=True,
+            ),
+            "snapshot": threading.Thread(
+                target=lambda: results.update(snapshot=ledger.snapshot()),
+                daemon=True,
+            ),
+        }
+        with ledger._lock:
+            for thread in threads.values():
+                thread.start()
+            for thread in threads.values():
+                thread.join(BLOCKED_PROBE_S)
+            still_blocked = sorted(n for n, t in threads.items() if t.is_alive())
+        self.assertEqual(still_blocked, ["snapshot", "transfer"])
+        for thread in threads.values():
+            thread.join(JOIN_TIMEOUT_S)
+        self.assertEqual([n for n, t in threads.items() if t.is_alive()], [])
+        self.assertIs(results["transfer"], True)
+        self.assertIn(results["snapshot"], [{"a": 5, "b": 0}, {"a": 4, "b": 1}])
+
+    def test_transfer_is_one_locked_section(self):
+        ledger = Ledger({"a": 10, "b": 0})
+        seen_after_first_release = []
+        ledger._lock = _ProbeLock(
+            lambda: seen_after_first_release.extend(_run_in_thread(ledger.snapshot))
+        )
+        self.assertIs(ledger.transfer("a", "b", 4), True)
+        self.assertEqual(seen_after_first_release, [{"a": 6, "b": 4}])
+
+    def test_competing_transfer_cannot_slip_between_check_and_write(self):
+        ledger = Ledger({"a": 5, "b": 0, "c": 0})
+        competing = []
+        ledger._lock = _ProbeLock(
+            lambda: competing.extend(_run_in_thread(lambda: ledger.transfer("a", "c", 5)))
+        )
+        self.assertIs(ledger.transfer("a", "b", 5), True)
+        self.assertEqual(competing, [False])
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 5, "c": 0})
+
+    def test_concurrent_transfers_succeed_exactly_as_funds_allow(self):
+        ledger = Ledger({"a": 100, "b": 0})
+        outcomes = [0] * THREAD_COUNT
+        workers = [
+            _transfer_worker(ledger, "a", "b", 1, outcomes, i)
+            for i in range(THREAD_COUNT)
+        ]
+        _run_threads(self, workers)
+        self.assertEqual(sum(outcomes), 100)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": 100})
+
+    def test_concurrent_overflow_checks_are_atomic(self):
+        ledger = Ledger({"src": 1000, "sink": MAX_BALANCE - 100})
+        outcomes = [0] * THREAD_COUNT
+        workers = [
+            _transfer_worker(ledger, "src", "sink", 1, outcomes, i)
+            for i in range(THREAD_COUNT)
+        ]
+        _run_threads(self, workers)
+        self.assertEqual(sum(outcomes), 100)
+        self.assertEqual(ledger.snapshot(), {"src": 900, "sink": MAX_BALANCE})
+
+    def test_opposite_transfers_do_not_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        barrier = threading.Barrier(2, timeout=JOIN_TIMEOUT_S)
+        outcomes = [0, 0]
+
+        def worker(index, source, destination):
+            def work():
+                barrier.wait()
+                outcomes[index] = sum(
+                    1 for _ in range(500) if ledger.transfer(source, destination, 1)
+                )
+            return work
+
+        _run_threads(self, [worker(0, "a", "b"), worker(1, "b", "a")])
+        self.assertEqual(outcomes, [500, 500])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        total = 200
+        ledger = Ledger({"a": 100, "b": 100})
+        sums = []
+
+        def writer(source, destination):
+            def work():
+                for _ in range(ATTEMPTS_PER_THREAD * 20):
+                    ledger.transfer(source, destination, 1)
+            return work
+
+        def reader():
+            for _ in range(ATTEMPTS_PER_THREAD * 20):
+                sums.append(sum(ledger.snapshot().values()))
+
+        _run_threads(self, [writer("a", "b"), writer("b", "a"), reader])
+        self.assertEqual(set(sums), {total})
+
