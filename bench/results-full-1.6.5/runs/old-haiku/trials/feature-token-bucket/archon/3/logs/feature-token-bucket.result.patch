+class TokenBucketValidationTest(unittest.TestCase):
+    def test_nonpositive_capacity_raises(self):
+        for capacity in (0, -1, float("nan")):
+            with self.subTest(capacity=capacity), self.assertRaises(ValueError):
+                TokenBucket(capacity, 1.0, clock=FakeClock())
+
+    def test_nonpositive_refill_raises(self):
+        for refill in (0, -0.5, float("nan")):
+            with self.subTest(refill=refill), self.assertRaises(ValueError):
+                TokenBucket(1, refill, clock=FakeClock())
+
+    def test_request_must_be_between_one_and_capacity(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in (0, -1, 3):
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+
+    def test_request_equal_to_capacity_is_allowed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(1))
+
+    def test_rejected_request_consumes_nothing(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            bucket.try_acquire(0)
+        self.assertEqual(bucket.available(), 2.0)
+
+
+class TokenBucketEdgeCaseTest(unittest.TestCase):
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.25)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+    def test_refill_never_exceeds_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        clock.now = 10.0
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+
+    def test_clock_must_pass_latest_seen_time_before_refill(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 5.0
+        bucket.try_acquire(2)
+        clock.now = 3.0
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 5.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_available_reports_tokens_without_consuming(self):
+        bucket = TokenBucket(3, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.available(), 3.0)
+        self.assertEqual(bucket.available(), 3.0)
+        self.assertTrue(bucket.try_acquire(3))
+
+
+class WaitTimeTest(unittest.TestCase):
+    def test_zero_when_acquire_would_succeed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_matches_time_until_acquire_succeeds(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        wait = bucket.wait_time(3)
+        self.assertAlmostEqual(wait, 1.5)
+        clock.now = wait - 1e-9
+        self.assertFalse(bucket.try_acquire(3))
+        clock.now = wait
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        self.assertAlmostEqual(bucket.wait_time(), 1.0)
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+
+class KeyedLimiterValidationTest(unittest.TestCase):
+    def test_invalid_rate_raises(self):
+        with self.assertRaises(ValueError):
+            KeyedLimiter(0, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            KeyedLimiter(1, 0, clock=FakeClock())
+
+    def test_max_keys_below_one_raises(self):
+        for max_keys in (0, -3):
+            with self.subTest(max_keys=max_keys), self.assertRaises(ValueError):
+                KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_request_raises_without_tracking_key(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 2)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", 0)
+        self.assertEqual(len(limiter), 0)
+
+
+class KeyedLimiterEdgeCaseTest(unittest.TestCase):
+    def test_wait_time_is_per_key(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        limiter.try_acquire("a")
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("c"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        limiter.try_acquire("a", 2)
+        limiter.try_acquire("b")
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_key_count_never_exceeds_max_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=3, clock=FakeClock())
+        for i in range(10):
+            limiter.try_acquire(i)
+            self.assertLessEqual(len(limiter), 3)
+        self.assertEqual(len(limiter), 3)
+
+    def test_keys_refill_on_shared_clock(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        limiter.try_acquire("a")
+        clock.now = 1.0
+        self.assertTrue(limiter.try_acquire("a"))
+
+
 if __name__ == "__main__":
