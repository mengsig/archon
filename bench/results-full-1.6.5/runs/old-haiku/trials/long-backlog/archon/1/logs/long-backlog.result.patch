diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..46ff3e8 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,72 @@
+from .models import DONE, OPEN
+
+FIELDS = ("tag", "status")
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    terms = _parse_terms(query)
+    return [task for task in tasks if all(_matches(task, t) for t in terms)]
+
+
+def _parse_terms(query):
+    terms = []
+    for text, colon in _tokenize(query):
+        if colon is None:
+            terms.append((None, text.casefold()))
+        else:
+            terms.append(_field_term(text[:colon], text[colon + 1:]))
+    return terms
+
+
+def _field_term(name, value):
+    field = name.casefold()
+    if field not in FIELDS:
+        raise QueryError(f"unknown field: {name!r}")
+    if not value:
+        raise QueryError(f"{field} needs a value")
+    if field == "status":
+        value = value.casefold()
+        if value not in STATUSES:
+            raise QueryError(f"unknown status: {value!r}")
+    return field, value.casefold()
+
+
+def _matches(task, term):
+    field, value = term
+    assert field in (None, *FIELDS), f"bad field in term: {field!r}"
+    if field is None:
+        return value in task.title.casefold()
+    if field == "tag":
+        return any(tag.casefold() == value for tag in task.tags)
+    return task.status == value
+
+
+def _tokenize(query):
+    """Return (text, colon) per term. Quotes group whitespace and are dropped;
+    colon is the index of the first colon outside quotes, or None."""
+    tokens = []
+    text, colon, in_quote, active = [], None, False, False
+    for ch in query:
+        if ch == '"':
+            in_quote = not in_quote
+            active = True
+        elif ch.isspace() and not in_quote:
+            if active:
+                tokens.append(("".join(text), colon))
+            text, colon, active = [], None, False
+        else:
+            if ch == ":" and not in_quote and colon is None:
+                colon = len(text)
+            text.append(ch)
+            active = True
+    if in_quote:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if active:
+        tokens.append(("".join(text), colon))
+    return tokens
