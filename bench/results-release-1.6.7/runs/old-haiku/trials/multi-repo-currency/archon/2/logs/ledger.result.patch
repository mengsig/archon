--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,43 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("starting ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("writing stdin");
+    child.wait_with_output().expect("waiting for ledger")
+}
+
+#[test]
+fn prints_currency_column_with_default_usd() {
+    let output = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(output.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&output.stdout),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn malformed_currency_exits_2_naming_the_line() {
+    let output = run_ledger("2026-03-01\tgroceries\t1.00\tEUR\n\n2026-03-02\tsalary\t1000\teur\n");
+    assert_eq!(output.status.code(), Some(2));
+    let stderr = String::from_utf8_lossy(&output.stderr);
+    assert!(stderr.starts_with("line 3: "), "stderr was {stderr:?}");
+}
+
+#[test]
+fn other_input_errors_exit_1() {
+    let output = run_ledger("March 1\tgroceries\t1.00\n");
+    assert_eq!(output.status.code(), Some(1));
+    assert!(String::from_utf8_lossy(&output.stderr).starts_with("line 1: "));
+}
