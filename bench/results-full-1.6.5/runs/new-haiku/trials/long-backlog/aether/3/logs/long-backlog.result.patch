@@ -0,0 +1,45 @@
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.models import Task
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), "id,title,tags,status,due\r\n")
+
+    def test_plain_fields_are_not_quoted_and_lines_end_with_crlf(self):
+        tasks = [Task(1, "plain", ["a", "b"], "open", date(2026, 4, 1)), Task(2, "bare")]
+        self.assertEqual(
+            to_csv(tasks),
+            "id,title,tags,status,due\r\n1,plain,a;b,open,2026-04-01\r\n2,bare,,open,\r\n",
+        )
+
+    def test_comma_in_title_is_quoted(self):
+        tasks = [Task(1, "milk, eggs")]
+        self.assertIn('1,"milk, eggs",,open,\r\n', to_csv(tasks))
+
+    def test_quotes_are_doubled_and_field_wrapped(self):
+        tasks = [Task(1, 'say "hi"')]
+        self.assertIn('1,"say ""hi""",,open,\r\n', to_csv(tasks))
+
+    def test_newlines_and_carriage_returns_are_quoted(self):
+        tasks = [Task(1, "line one\nline two"), Task(2, "cr\rhere")]
+        output = to_csv(tasks)
+        self.assertIn('1,"line one\nline two",,open,\r\n', output)
+        self.assertIn('2,"cr\rhere",,open,\r\n', output)
+
+    def test_tags_containing_comma_are_quoted(self):
+        tasks = [Task(1, "t", ["x,y", "z"])]
+        self.assertIn('1,t,"x,y;z",open,\r\n', to_csv(tasks))
+
+    def test_rows_keep_input_order(self):
+        tasks = [Task(3, "third"), Task(1, "first")]
+        rows = to_csv(tasks).split("\r\n")
+        self.assertEqual(rows[1].split(",")[0], "3")
+        self.assertEqual(rows[2].split(",")[0], "1")
+
+
+if __name__ == "__main__":
+    unittest.main()
