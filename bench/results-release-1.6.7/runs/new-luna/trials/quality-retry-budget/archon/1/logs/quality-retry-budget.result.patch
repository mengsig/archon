diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..11b2c9e 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,35 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = {
+        "attempt": (attempt, 1),
+        "elapsed_ms": (elapsed_ms, 0),
+        "max_attempts": (max_attempts, 1),
+        "budget_ms": (budget_ms, 0),
+        "base_ms": (base_ms, 0),
+        "cap_ms": (cap_ms, 0),
+    }
+    if retry_after_ms is not None:
+        values["retry_after_ms"] = (retry_after_ms, 0)
+
+    for name, (value, minimum) in values.items():
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an int >= {minimum}")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        exponent = attempt - 1
+        # If the shift would reach the cap, avoid constructing the power.
+        if exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..3e696f8 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,51 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_validates_every_argument_before_exhaustion(self):
+        invalid = [True, 1.0, "1", -1]
+        for value in invalid:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(4, 0, base_ms=value)
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, retry_after_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(attempt=True, elapsed_ms=0)
+        with self.assertRaises(ValueError):
+            retry_delay(attempt=0, elapsed_ms=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_attempt_and_budget_boundaries(self):
+        self.assertIsNone(retry_delay(5, 0))
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+
+    def test_retry_after_is_uncapped_and_budget_is_strict(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=5000,
+                                     budget_ms=5001), 5000)
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+    def test_huge_attempt_saturates(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**101), 400)
+
+    def test_all_numeric_arguments_require_builtin_ints(self):
+        options = {
+            "elapsed_ms": 0, "max_attempts": 4, "budget_ms": 1000,
+            "base_ms": 100, "cap_ms": 400, "retry_after_ms": None,
+        }
+        for name in ("elapsed_ms", "max_attempts", "budget_ms", "base_ms", "cap_ms"):
+            for value in (True, 1.0, -1):
+                args = dict(options)
+                args[name] = value
+                with self.subTest(name=name, value=value):
+                    with self.assertRaises(ValueError):
+                        retry_delay(1, **args)
+        for value in (True, 1.0, -1):
+            with self.subTest(retry_after_ms=value):
+                with self.assertRaises(ValueError):
+                    retry_delay(1, 0, retry_after_ms=value)
