diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..237bf45
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,71 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn three_column_input_defaults_to_usd() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn four_column_input_uses_given_currency() {
+    let out = run_ledger("2026-03-01\tgroceries\t-45.10\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8_lossy(&out.stdout),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,EUR\n"
+    );
+}
+
+#[test]
+fn malformed_currency_exits_2_and_names_line() {
+    for code in ["eur", "EU", "EURO", "US1", "EÜR", ""] {
+        let input = format!("2026-03-01\tfood\t1\tUSD\n\n2026-03-02\tfuel\t2\t{code}\n");
+        let out = run_ledger(&input);
+        let stderr = String::from_utf8_lossy(&out.stderr);
+        assert_eq!(out.status.code(), Some(2), "code {code:?}");
+        assert!(
+            stderr.contains("line 3:"),
+            "code {code:?}: stderr was {stderr:?}"
+        );
+    }
+}
+
+#[test]
+fn other_input_errors_exit_1_and_name_line() {
+    let cases = [
+        ("2026-03-01\tfood\t1\nMarch 1\tfuel\t2\n", "line 2:"),
+        ("2026-03-01\tfood\t1.234\tEUR\n", "line 1:"),
+        ("2026-03-01\tfood\t1\tEUR\textra\n", "line 1:"),
+        ("2026-03-01\tfood\n", "line 1:"),
+    ];
+    for (input, line_prefix) in cases {
+        let out = run_ledger(input);
+        let stderr = String::from_utf8_lossy(&out.stderr);
+        assert_eq!(out.status.code(), Some(1), "input {input:?}");
+        assert!(
+            stderr.contains(line_prefix),
+            "input {input:?}: stderr was {stderr:?}"
+        );
+    }
+}
