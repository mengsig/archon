diff --git a/tests/cli.rs b/tests/cli.rs
new file mode 100644
index 0000000..98fa36f
--- /dev/null
+++ b/tests/cli.rs
@@ -0,0 +1,68 @@
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+fn stdout(output: &Output) -> String {
+    String::from_utf8(output.stdout.clone()).expect("utf-8 stdout")
+}
+
+fn stderr(output: &Output) -> String {
+    String::from_utf8(output.stderr.clone()).expect("utf-8 stderr")
+}
+
+#[test]
+fn three_column_input_exports_usd() {
+    let output = run_ledger("2026-03-01\tgroceries\t-45.10\n");
+    assert_eq!(output.status.code(), Some(0));
+    assert_eq!(
+        stdout(&output),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,-4510,USD\n"
+    );
+}
+
+#[test]
+fn four_column_input_exports_currency() {
+    let output = run_ledger("# comment\n\n2026-03-01\tgroceries\t2\tGBP\n");
+    assert_eq!(output.status.code(), Some(0));
+    assert_eq!(
+        stdout(&output),
+        "date,account,amount_cents,currency\n2026-03-01,groceries,200,GBP\n"
+    );
+}
+
+#[test]
+fn malformed_currency_exits_2_naming_line() {
+    for bad in ["usd", "US", "", "\u{dc}SD"] {
+        let input = format!("2026-03-01\tgroceries\t1\tUSD\n2026-03-02\trent\t3\t{bad}\n");
+        let output = run_ledger(&input);
+        assert_eq!(output.status.code(), Some(2), "currency {bad:?}");
+        assert!(
+            stderr(&output).starts_with("line 2: "),
+            "stderr: {}",
+            stderr(&output)
+        );
+        assert!(stdout(&output).starts_with("date,account,amount_cents,currency\n"));
+    }
+}
+
+#[test]
+fn other_input_errors_still_exit_1() {
+    let output = run_ledger("2026-03-01\tgroceries\n");
+    assert_eq!(output.status.code(), Some(1));
+    assert!(stderr(&output).starts_with("line 1: expected 3 or 4 tab-separated fields"));
+}
