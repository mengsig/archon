diff --git a/safe_extract.py b/safe_extract.py
index 0007027..3e6c2da 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,114 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+    root_path = _validate_root(root)
+    names = [_validate_entry(entry) for entry in entries]
+    _check_collisions(names)
+    _check_filesystem(root_path, names)
+    _write_entries(root_path, entries)
+    return names
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError("root must be a non-empty str or pathlib.Path")
+    root_path = Path(root)
+    try:
+        st = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root!r}") from exc
+    if stat.S_ISLNK(st.st_mode):
+        raise ValueError(f"root must not be a symlink: {root!r}")
+    if not stat.S_ISDIR(st.st_mode):
+        raise ValueError(f"root is not a directory: {root!r}")
+    return root_path
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError("each entry must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry data must be bytes, not {type(data).__name__}")
+    _validate_name(name)
+    return name
+
+
+def _validate_name(name):
+    if name == "":
+        raise ValueError("entry name must not be empty")
+    for forbidden in ("\\", ":", "\x00"):
+        if forbidden in name:
+            raise ValueError(f"entry name contains forbidden {forbidden!r}: {name!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name has an invalid component: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not encodable: {name!r}") from exc
+
+
+def _check_collisions(names):
+    seen = set()
+    for name in names:
+        if name in seen:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        seen.add(name)
+    files = set(names)
+    dirs = set()
+    for name in names:
+        parts = name.split("/")
+        dirs.update("/".join(parts[:i]) for i in range(1, len(parts)))
+    clashes = sorted(files & dirs)
+    if clashes:
+        raise ValueError(f"entry is both a file and a directory: {clashes[0]!r}")
+
+
+def _check_filesystem(root, names):
+    verified_dirs = set()
+    for name in names:
+        parts = name.split("/")
+        assert ".." not in parts, "names must be validated before the filesystem check"
+        for i in range(1, len(parts)):
+            prefix = "/".join(parts[:i])
+            if prefix not in verified_dirs:
+                _check_existing_directory(root / prefix)
+                verified_dirs.add(prefix)
+        if _lstat_or_none(root / name) is not None:
+            raise ValueError(f"target already exists: {name!r}")
+
+
+def _check_existing_directory(path):
+    st = _lstat_or_none(path)
+    if st is None:
+        return
+    if stat.S_ISLNK(st.st_mode):
+        raise ValueError(f"path component is a symlink: {path}")
+    if not stat.S_ISDIR(st.st_mode):
+        raise ValueError(f"path component is not a directory: {path}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_entries(root, entries):
+    for name, data in entries:
+        target = root / name
+        target.parent.mkdir(parents=True, exist_ok=True)
+        assert not os.path.lexists(target), "target must be absent after validation"
+        with open(target, "xb") as handle:
+            handle.write(data)
diff --git a/test_safe_extract.py b/test_safe_extract.py
