+class LedgerValidation(unittest.TestCase):
+    def test_constructor_validation_and_input_copy(self):
+        for value in (None, []):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                Ledger(value)
+        for balances in ({"": 0}, {1: 0}, {"a": True}, {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(balances=balances), self.assertRaises(ValueError):
+                Ledger(balances)
+        original = {"a": 4}
+        ledger = Ledger(original)
+        original["a"] = 0
+        self.assertEqual(ledger.snapshot(), {"a": 4})
+
+    def test_empty_and_snapshot_copy(self):
+        ledger = Ledger({})
+        snap = ledger.snapshot()
+        snap["x"] = 1
+        self.assertEqual(ledger.snapshot(), {})
+
+    def test_amount_validated_before_accounts(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also-missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+    def test_overflow_and_self_transfer(self):
+        ledger = Ledger({"a": 5, "b": MAX_BALANCE})
+        self.assertFalse(ledger.transfer("a", "b", 1))
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE})
+        self.assertTrue(ledger.transfer("b", "b", MAX_BALANCE))
+        self.assertFalse(ledger.transfer("a", "a", 6))
+        self.assertEqual(ledger.snapshot(), {"a": 5, "b": MAX_BALANCE})
+
+
+class LedgerConcurrency(unittest.TestCase):
+    def test_opposing_transfers_and_snapshots_preserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        start = threading.Barrier(5)
+        errors = []
+
+        def worker(source, destination):
+            try:
+                start.wait(timeout=2)
+                for _ in range(500):
+                    ledger.transfer(source, destination, 1)
+                    snapshot = ledger.snapshot()
+                    if sum(snapshot.values()) != 2000:
+                        errors.append(snapshot)
+            except BaseException as exc:
+                errors.append(exc)
+
+        threads = [
+            threading.Thread(target=worker, args=("a", "b")),
+            threading.Thread(target=worker, args=("b", "a")),
+            threading.Thread(target=worker, args=("a", "b")),
+            threading.Thread(target=worker, args=("b", "a")),
+        ]
+        for thread in threads:
+            thread.start()
+        start.wait(timeout=2)
+        for thread in threads:
+            thread.join(timeout=3)
+        self.assertFalse(any(thread.is_alive() for thread in threads), "transfer deadlocked")
+        self.assertEqual(errors, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
