+class TempRootCase(unittest.TestCase):
+    def setUp(self):
+        temp = tempfile.TemporaryDirectory()
+        self.addCleanup(temp.cleanup)
+        self.base = Path(temp.name)
+        self.root = self.base / "root"
+        self.root.mkdir()
+
+    def assertRootEmpty(self):
+        self.assertEqual(list(self.root.iterdir()), [])
+
+
+class BatchShapeTests(TempRootCase):
+    def test_non_list_batches_are_rejected_unconsumed(self):
+        generator = ((name, b"x") for name in ["a"])
+        iterator = iter([("a", b"x")])
+        for batch in [(("a", b"x"),), (), generator, iterator, None, {}]:
+            with self.subTest(batch=type(batch).__name__):
+                with self.assertRaises(ValueError):
+                    extract(batch, self.root)
+        self.assertEqual(next(generator), ("a", b"x"))
+        self.assertEqual(next(iterator), ("a", b"x"))
+        self.assertRootEmpty()
+
+    def test_non_list_batch_rejected_even_with_invalid_root(self):
+        with self.assertRaises(ValueError):
+            extract(("a", b"x"), self.base / "missing")
+
+    def test_malformed_entries_are_rejected(self):
+        bad_entries = [
+            ["a", b"x"],
+            ("a",),
+            ("a", b"x", "extra"),
+            "a",
+            None,
+        ]
+        for entry in bad_entries:
+            with self.subTest(entry=entry):
+                with self.assertRaises(ValueError):
+                    extract([("ok", b"1"), entry], self.root)
+        self.assertRootEmpty()
+
+    def test_non_string_names_are_rejected(self):
+        for name in [b"a", None, 3, ("a",)]:
+            with self.subTest(name=name):
+                with self.assertRaises(ValueError):
+                    extract([(name, b"x")], self.root)
+        self.assertRootEmpty()
+
+    def test_non_bytes_data_is_rejected(self):
+        for data in ["text", bytearray(b"x"), memoryview(b"x"), None, 0]:
+            with self.subTest(data=data):
+                with self.assertRaises(ValueError):
+                    extract([("a", data)], self.root)
+        self.assertRootEmpty()
+
+
+class NameRuleTests(TempRootCase):
+    def test_invalid_names_are_rejected(self):
+        invalid = [
