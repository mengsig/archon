+
+#[test]
+fn parses_and_validates_currency() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.25\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert!(parse_line("2026-03-01\tgroceries\t1\teuR")
+        .unwrap_err()
+        .contains("bad currency code"));
+    assert!(parse_line("2026-03-01\tgroceries\t1\t USD")
+        .unwrap_err()
+        .contains("bad currency code"));
+}
+
+#[test]
+fn malformed_currency_exits_two_and_names_line() {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::null())
+        .stderr(Stdio::piped())
+        .spawn()
+        .unwrap();
+    child
+        .stdin
+        .take()
+        .unwrap()
+        .write_all(b"2026-03-01\tgroceries\t1\tusd\n")
+        .unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(2));
+    assert!(String::from_utf8_lossy(&output.stderr).contains("line 1: bad currency code"));
+}
