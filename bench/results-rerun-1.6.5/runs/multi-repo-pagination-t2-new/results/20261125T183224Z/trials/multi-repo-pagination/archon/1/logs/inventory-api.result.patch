 elsewhere.
 """
 
+import base64
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+MAX_DIGITS_LIMIT = 3
+MAX_CURSOR_ID_DIGITS = 18
+MAX_CURSOR_LENGTH = 64
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +29,59 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    limit, error = _parse_limit(query.get("limit"))
+    if error:
+        return _error(400, error)
+    after_id, error = _parse_cursor(query.get("cursor"))
+    if error:
+        return _error(400, error)
+    matching = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = matching[:limit]
+    has_more = len(matching) > limit
+    next_cursor = _encode_cursor(page[-1]["id"]) if has_more else None
+    assert len(page) <= limit
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT, None
+    message = f"limit must be an integer from 1 to {MAX_LIMIT}"
+    if not _is_short_digits(raw, MAX_DIGITS_LIMIT):
+        return None, message
+    limit = int(raw)
+    if not 1 <= limit <= MAX_LIMIT:
+        return None, message
+    return limit, None
+
+
+def _parse_cursor(raw):
+    if raw is None:
+        return None, None
+    message = "cursor is not valid"
+    if len(raw) > MAX_CURSOR_LENGTH:
+        return None, message
+    try:
+        decoded = base64.b64decode(
+            raw.encode("ascii"), altchars=b"-_", validate=True
+        ).decode("ascii")
+    except ValueError:
+        return None, message
+    if not _is_short_digits(decoded, MAX_CURSOR_ID_DIGITS):
+        return None, message
+    return int(decoded), None
+
+
+def _is_short_digits(text, max_digits):
+    return text.isascii() and text.isdigit() and len(text) <= max_digits
+
+
+def _encode_cursor(item_id):
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
 
 
