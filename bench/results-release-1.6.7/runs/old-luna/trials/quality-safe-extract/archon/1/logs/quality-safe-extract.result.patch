diff --git a/safe_extract.py b/safe_extract.py
index 0007027..3444a1b 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,72 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    try:
+        root_path = Path(root)
+    except (TypeError, ValueError) as error:
+        raise ValueError("root must be an existing real directory") from error
+    try:
+        root_info = root_path.lstat()
+    except (FileNotFoundError, NotADirectoryError) as error:
+        raise ValueError("root must be an existing real directory") from error
+    if stat.S_ISLNK(root_info.st_mode) or not stat.S_ISDIR(root_info.st_mode):
+        raise ValueError("root must be an existing real directory")
+
+    paths = []
+    names = set()
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) pair")
+        name, data = entry
+        if not isinstance(name, str) or not isinstance(data, bytes):
+            raise ValueError("entry names must be strings and data must be bytes")
+        if (not name or name.startswith("/") or "\\" in name or ":" in name
+                or "\0" in name):
+            raise ValueError("invalid path name")
+        parts = name.split("/")
+        if any(part in ("", ".", "..") for part in parts):
+            raise ValueError("invalid path name")
+        if name in names:
+            raise ValueError("duplicate path")
+        names.add(name)
+        paths.append((name, data, parts))
+
+    # Check all batch-internal conflicts before inspecting the filesystem.
+    for _, _, parts in paths:
+        for index in range(1, len(parts)):
+            if "/".join(parts[:index]) in names:
+                raise ValueError("file/directory path collision")
+
+    # lstat each component so dangling links are detected without following them.
+    for name, data, parts in paths:
+        current = root_path
+        for index, part in enumerate(parts):
+            current = current / part
+            try:
+                info = current.lstat()
+            except FileNotFoundError:
+                break
+            if stat.S_ISLNK(info.st_mode):
+                raise ValueError("path contains a symlink")
+            if index == len(parts) - 1:
+                raise ValueError("target already exists")
+            if not stat.S_ISDIR(info.st_mode):
+                raise ValueError("path ancestor is not a directory")
+
+    for _, data, parts in paths:
+        current = root_path
+        for part in parts[:-1]:
+            current = current / part
+            current.mkdir(exist_ok=True)
+        target = current / parts[-1]
+        with target.open("xb") as output:
+            output.write(data)
+
+    return [name for name, _, _ in paths]
diff --git a/test_safe_extract.py b/test_safe_extract.py
index bbd5cb7..d4668b2 100644
--- a/test_safe_extract.py
+++ b/test_safe_extract.py
@@ -18,3 +18,91 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractValidation(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(dir=".")
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name) / "root"
+        self.root.mkdir()
+
+    def assert_rejected_without_mutation(self, entries, outside=None):
+        before_root = sorted((str(p.relative_to(self.root)), p.read_bytes() if p.is_file() else None)
+                             for p in self.root.rglob("*"))
+        before_outside = outside.read_bytes() if outside is not None else None
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        after_root = sorted((str(p.relative_to(self.root)), p.read_bytes() if p.is_file() else None)
+                            for p in self.root.rglob("*"))
+        self.assertEqual(after_root, before_root)
+        if outside is not None:
+            self.assertEqual(outside.read_bytes(), before_outside)
+
+    def test_non_list_batches_are_rejected_without_consuming(self):
+        class Tracked:
+            consumed = False
+            def __iter__(self):
+                self.consumed = True
+                return iter([("new", b"x")])
+        for batch in (("x", b"x"), Tracked(), (item for item in [])):
+            with self.subTest(batch=type(batch).__name__):
+                self.assert_rejected_without_mutation(batch)
+                if isinstance(batch, Tracked):
+                    self.assertFalse(batch.consumed)
+
+    def test_invalid_entries_and_posix_names(self):
+        invalid = [
+            None, ("one",), ("one", b"x", "extra"), (1, b"x"), ("one", bytearray()),
+            ("", b"x"), ("/absolute", b"x"), ("a\\b", b"x"), ("C:drive", b"x"),
+            ("nul\0byte", b"x"), ("a//b", b"x"), ("./a", b"x"), ("a/../b", b"x"),
+        ]
+        for entry in invalid:
+            with self.subTest(entry=entry):
+                self.assert_rejected_without_mutation([("safe/new", b"would be written"), entry])
+
+    def test_duplicate_and_prefix_conflicts_in_both_orders(self):
+        for entries in (
+            [("same", b"1"), ("same", b"2")],
+            [("a", b"1"), ("a/b", b"2")],
+            [("a/b", b"2"), ("a", b"1")],
+        ):
+            with self.subTest(entries=entries):
+                self.assert_rejected_without_mutation(entries)
+
+    def test_existing_target_and_non_directory_ancestor(self):
+        (self.root / "existing").write_bytes(b"keep")
+        (self.root / "file-parent").write_bytes(b"stay")
+        self.assert_rejected_without_mutation([("new", b"x"), ("existing", b"replace")])
+        self.assert_rejected_without_mutation([("new", b"x"), ("file-parent/child", b"x")])
+
+    def test_root_must_be_existing_real_directory_even_for_empty_batch(self):
+        absent = self.root / "absent"
+        ordinary_file = self.root / "file"
+        ordinary_file.write_bytes(b"keep")
+        nested_under_file = ordinary_file / "child"
+        link = self.root / "root-link"
+        link.symlink_to(self.root, target_is_directory=True)
+        for invalid_root in (absent, ordinary_file, nested_under_file, link):
+            with self.subTest(root=invalid_root):
+                with self.assertRaises(ValueError):
+                    extract([], invalid_root)
+
+    def test_symlink_components_and_targets_are_rejected(self):
+        outside = Path(self.temp.name) / "outside"
+        outside.mkdir()
+        protected = outside / "protected"
+        protected.write_bytes(b"untouched")
+        (self.root / "link").symlink_to(outside, target_is_directory=True)
+        dangling = self.root / "dangling"
+        dangling.symlink_to(outside / "missing")
+        for name in ("link/new", "dangling", "link/protected"):
+            with self.subTest(name=name):
+                self.assert_rejected_without_mutation([("safe/new", b"no partial write"), (name, b"overwrite")], protected)
+
+    def test_existing_directories_are_allowed_as_ancestors(self):
+        (self.root / "existing-dir").mkdir()
+        self.assertEqual(extract([("existing-dir/new", b"ok"), ("literal%2Fname", b"%")], self.root),
+                         ["existing-dir/new", "literal%2Fname"])
+        self.assertEqual((self.root / "existing-dir/new").read_bytes(), b"ok")
+        self.assertEqual((self.root / "literal%2Fname").read_bytes(), b"%")
