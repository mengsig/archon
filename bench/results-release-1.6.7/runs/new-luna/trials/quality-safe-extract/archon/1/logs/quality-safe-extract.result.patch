 """Extract validated regular-file entries. See SPEC.md."""
 
+import stat
+from pathlib import Path
 
-def extract(entries, root):
-    raise NotImplementedError
+
+def _validated_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError("root must be a pathlib.Path or string")
+    try:
+        path = Path(root)
+    except (TypeError, ValueError):
+        raise ValueError("root must name an existing directory") from None
+
+    try:
+        mode = path.lstat().st_mode
+    except (FileNotFoundError, NotADirectoryError):
+        raise ValueError("root must be an existing real directory") from None
+    if stat.S_ISLNK(mode) or not stat.S_ISDIR(mode):
+        raise ValueError("root must be an existing real directory")
+    return path
+
+
+def _validated_name(name):
+    if not isinstance(name, str) or not name:
+        raise ValueError("entry names must be nonempty strings")
+    if name.startswith("/") or "\\" in name or ":" in name or "\0" in name:
+        raise ValueError(f"invalid path name: {name!r}")
+
+    components = name.split("/")
+    if any(component in ("", ".", "..") for component in components):
+        raise ValueError(f"invalid path name: {name!r}")
+    return components
+
+
+def _validate_existing_path(root, components):
+    current = root
+    for index, component in enumerate(components):
+        current = current / component
+        try:
+            mode = current.lstat().st_mode
+        except FileNotFoundError:
+            return
+
+        if stat.S_ISLNK(mode):
+            raise ValueError(f"path contains a symlink: {current}")
+        if index == len(components) - 1:
+            raise ValueError(f"target already exists: {current}")
+        if not stat.S_ISDIR(mode):
+            raise ValueError(f"parent is not a directory: {current}")
+
+
+def extract(entries, root) -> list[str]:
+    """Create the regular files in *entries* beneath *root*.
+
+    All input and filesystem conflicts are checked before this function makes
+    any filesystem changes. I/O failures during creation are allowed to
+    propagate; rollback after such failures is outside this API's contract.
+    """
+    if not isinstance(entries, list):
+        raise ValueError("entries must be a list")
+
+    validated_root = _validated_root(root)
+    names = []
+    data_by_name = {}
+    for entry in entries:
+        if not isinstance(entry, tuple) or len(entry) != 2:
+            raise ValueError("each entry must be a (name, data) tuple")
+        name, data = entry
+        _validated_name(name)
+        if not isinstance(data, bytes):
+            raise ValueError("entry data must be bytes")
+        if name in data_by_name:
+            raise ValueError(f"duplicate target: {name!r}")
+        names.append(name)
+        data_by_name[name] = data
+
+    name_set = set(names)
+    for name in names:
+        components = name.split("/")
+        if any("/".join(components[:index]) in name_set for index in range(1, len(components))):
+            raise ValueError(f"file/directory collision: {name!r}")
+
+    for name in names:
+        _validate_existing_path(validated_root, name.split("/"))
+
+    for name in names:
+        target = validated_root.joinpath(*name.split("/"))
+        target.parent.mkdir(parents=True, exist_ok=True)
+        with target.open("xb") as output:
+            output.write(data_by_name[name])
+
+    return names
