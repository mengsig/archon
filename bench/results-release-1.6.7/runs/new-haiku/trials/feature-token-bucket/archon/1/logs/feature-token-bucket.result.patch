+class BucketValidationTest(unittest.TestCase):
+    def test_rejects_non_positive_capacity_or_refill(self):
+        nan = float("nan")
+        for capacity, refill in [(0, 1.0), (-1, 1.0), (1, 0), (1, -0.5), (nan, 1.0), (1, nan)]:
+            with self.subTest(capacity=capacity, refill=refill):
+                with self.assertRaises(ValueError):
+                    TokenBucket(capacity, refill, clock=FakeClock())
+
+    def test_rejects_request_sizes_outside_one_to_capacity(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.subTest(n=n):
+                with self.assertRaises(ValueError):
+                    bucket.try_acquire(n)
+                with self.assertRaises(ValueError):
+                    bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        self.assertTrue(bucket.try_acquire(2))
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_non_finite_clock_is_an_error(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        clock.now = float("inf")
+        with self.assertRaises(ValueError):
+            bucket.available()
+        with self.assertRaises(ValueError):
+            TokenBucket(1, 1.0, clock=lambda: float("nan"))
+
+
+class BucketEdgeCaseTest(unittest.TestCase):
+    def test_refill_is_capped_at_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = 0.5
+        self.assertEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 1.0
+        self.assertTrue(bucket.try_acquire())
+
+    def test_available_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        self.assertEqual(bucket.available(), 2.0)
+        self.assertEqual(bucket.available(), 2.0)
+        self.assertTrue(bucket.try_acquire(2))
+
+    def test_wait_time_is_zero_when_acquire_would_succeed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(), 0.0)
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_time_is_seconds_until_acquire_succeeds(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertEqual(bucket.wait_time(3), 1.5)
+        self.assertEqual(bucket.wait_time(3), 1.5)
+        clock.now = 1.5
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_wait_time_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 1.0, clock=clock)
+        bucket.try_acquire()
+        self.assertEqual(bucket.wait_time(), 1.0)
+        self.assertEqual(bucket.available(), 0.0)
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 10.0
+        bucket.try_acquire(2)
+        clock.now = 3.0
+        self.assertEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 11.0
+        self.assertEqual(bucket.available(), 1.0)
+
