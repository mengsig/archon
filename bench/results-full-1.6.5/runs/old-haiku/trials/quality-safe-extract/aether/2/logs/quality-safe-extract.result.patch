 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARACTERS = ("\\", ":", "\x00")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _check_batch_type(entries)
+    root_path = _check_root(root)
+    names = _check_entries(entries)
+    for name in names:
+        _check_absent_on_disk(root_path, name)
+    return _write_entries(root_path, entries)
+
+
+def _check_batch_type(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, got {type(entries).__name__}")
+
+
+def _check_root(root):
+    if not isinstance(root, (str, Path)):
+        raise ValueError(f"root must be a str or Path, got {type(root).__name__}")
+    root_path = Path(root)
+    try:
+        info = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root {root!r} does not exist as a directory") from exc
+    if stat.S_ISLNK(info.st_mode):
+        raise ValueError(f"root {root!r} must not be a symlink")
+    if not stat.S_ISDIR(info.st_mode):
+        raise ValueError(f"root {root!r} must be a directory")
+    return root_path
+
+
+def _check_entries(entries):
+    names = [_check_entry(index, entry) for index, entry in enumerate(entries)]
+    _check_names_disjoint(names)
+    return names
+
+
+def _check_entry(index, entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry {index} name must be str, got {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry {index} data must be bytes, got {type(data).__name__}")
+    _check_name(name)
+    return name
+
+
+def _check_name(name):
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name {name!r} must be relative")
+    for character in FORBIDDEN_NAME_CHARACTERS:
+        if character in name:
+            raise ValueError(f"entry name {name!r} contains forbidden {character!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name {name!r} has an invalid component")
+
+
+def _check_names_disjoint(names):
+    name_set = set(names)
+    if len(name_set) != len(names):
+        raise ValueError("batch contains duplicate entry names")
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in name_set:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in batch")
+
+
+def _check_absent_on_disk(root, name):
+    parts = name.split("/")
+    current = root
+    for depth, part in enumerate(parts):
+        current = current / part
+        info = _lstat_or_none(current)
+        if info is None:
+            return
+        if depth == len(parts) - 1:
+            raise ValueError(f"entry {name!r} already exists")
+        if stat.S_ISLNK(info.st_mode):
+            raise ValueError(f"path component {str(current)!r} is a symlink")
+        if not stat.S_ISDIR(info.st_mode):
+            raise ValueError(f"path component {str(current)!r} is not a directory")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_entries(root, entries):
+    names = []
+    for name, data in entries:
+        target = root.joinpath(*name.split("/"))
+        os.makedirs(target.parent, exist_ok=True)
+        assert target.parent.is_dir(), "parent directory must exist before writing"
+        with open(target, "xb") as handle:
+            handle.write(data)
+        names.append(name)
+    return names
