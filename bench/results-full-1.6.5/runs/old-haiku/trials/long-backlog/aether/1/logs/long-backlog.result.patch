@@ -0,0 +1,73 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def sample_store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("write report", tags=["work", "urgent"])
+    store.add("buy milk", tags=["home"])
+    store.add("login page: redesign", tags=["Home"])
+    store.complete(2)
+    return store
+
+
+def titles(tasks):
+    return [task.title for task in tasks]
+
+
+class SearchTest(unittest.TestCase):
+    def test_bare_word_is_case_insensitive_substring(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "LOGIN")), ["Fix login bug", "login page: redesign"])
+
+    def test_terms_are_anded(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "login fix")), ["Fix login bug"])
+
+    def test_quoted_phrase_is_one_term(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), '"bug login"')), [])
+        self.assertEqual(titles(search(store.all(), '"fix login"')), ["Fix login bug"])
+
+    def test_quoted_colon_is_a_phrase_not_a_field(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), '"page: redesign"')), ["login page: redesign"])
+
+    def test_tag_is_exact_and_case_insensitive(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "tag:WORK")), ["Fix login bug", "write report"])
+        self.assertEqual(titles(search(store.all(), "tag:wor")), [])
+
+    def test_status_filter(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "status:done")), ["write report"])
+        self.assertEqual(len(search(store.all(), "status:OPEN")), 3)
+
+    def test_fields_combine_with_words(self):
+        store = sample_store()
+        self.assertEqual(titles(search(store.all(), "tag:home status:open")), ["buy milk", "login page: redesign"])
+
+    def test_blank_query_matches_everything_in_order(self):
+        store = sample_store()
+        for query in ["", "   ", '""']:
+            with self.subTest(query=query):
+                self.assertEqual(titles(search(store.all(), query)), titles(store.all()))
+
+    def test_results_keep_input_order(self):
+        store = sample_store()
+        reversed_tasks = list(reversed(store.all()))
+        self.assertEqual(titles(search(reversed_tasks, "login")), ["login page: redesign", "Fix login bug"])
+
+    def test_invalid_queries_raise(self):
+        store = sample_store()
+        for query in ['"unterminated', "priority:high", "status:maybe", "tag:", "http://x"]:
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search(store.all(), query)
+
+
+if __name__ == "__main__":
+    unittest.main()
