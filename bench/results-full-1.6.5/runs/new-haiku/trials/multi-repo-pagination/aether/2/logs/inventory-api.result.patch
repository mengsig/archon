+    def test_default_page_size_and_null_cursor_on_single_page(self):
+        res = get("/items", limit="100")
+        self.assertEqual(len(res["body"]["items"]), 57)
+        self.assertIsNone(res["body"]["next_cursor"])
+        self.assertEqual(len(get("/items")["body"]["items"]), 20)
+
+    def test_walking_cursors_returns_every_item_once_in_order(self):
+        seen, cursor = [], None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            seen.extend(item["id"] for item in res["body"]["items"])
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(seen, list(range(1, 58)))
+
