+function pagedTransport(pages) {
+  const seen = [];
+  const transport = async (request) => {
+    seen.push(request);
+    const page = pages[request.query.cursor ?? 'first'];
+    return page ? { status: 200, body: page } : { status: 404, body: { error: 'no page' } };
+  };
+  return { transport, seen };
+}
+
+test('follows next_cursor across pages in order', async () => {
+  const { transport, seen } = pagedTransport({
+    first: { items: [ITEMS[0]], next_cursor: 'c1' },
+    c1: { items: [ITEMS[1]], next_cursor: 'c2' },
+    c2: { items: [{ id: 3, sku: 'SKU-0003', qty: 7 }], next_cursor: null },
+  });
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(seen.map((request) => request.query), [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('single page with null next_cursor makes one request', async () => {
+  const { transport, seen } = pagedTransport({
+    first: { items: ITEMS, next_cursor: null },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+  assert.deepEqual(seen[0].query, {});
+});
+
+test('absent next_cursor ends paging', async () => {
+  const { transport, seen } = pagedTransport({
+    first: { items: ITEMS },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(seen.length, 1);
+});
+
+test('rejects a next_cursor that repeats an earlier page, even after other pages', async () => {
+  const { transport } = pagedTransport({
+    first: { items: [ITEMS[0]], next_cursor: 'c1' },
+    c1: { items: [ITEMS[1]], next_cursor: 'c2' },
+    c2: { items: [ITEMS[0]], next_cursor: 'c1' },
+  });
+  await assert.rejects(listItems(transport), /repeated next_cursor c1/);
+});
+
+test('rejects a non-string next_cursor', async () => {
+  const { transport } = pagedTransport({
+    first: { items: ITEMS, next_cursor: 7 },
+  });
+  await assert.rejects(listItems(transport), /non-string next_cursor/);
+});
+
+test('rejects a body without an items array', async () => {
+  await assert.rejects(listItems(async () => ({ status: 200, body: null })), /no items array/);
+});
+
