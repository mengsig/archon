-    if fields.len() != 3 {
-        return Err(format!("expected 3 tab-separated fields, got {}", fields.len()));
+    if !(3..=4).contains(&fields.len()) {
+        return Err(ParseError::Other(format!("expected 3 or 4 tab-separated fields, got {}", fields.len())));
     }
     let date = fields[0].trim();
     if !is_iso_date(date) {
-        return Err(format!("bad date {date:?}"));
