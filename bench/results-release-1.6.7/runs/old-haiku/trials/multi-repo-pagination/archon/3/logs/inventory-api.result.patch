 """
 
+import base64
+import re
+
 from data import ITEMS
 
+DEFAULT_LIMIT = 20
+MAX_LIMIT = 100
+
 
 def handle(request):
     if request.get("method") != "GET":
@@ -21,8 +27,48 @@ def handle(request):
 
 
 def list_items(query):
-    items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    if not isinstance(query, dict) or not all(isinstance(v, str) for v in query.values()):
+        return _error(400, "query parameters must be strings")
+    limit = _parse_limit(query.get("limit"))
+    if limit is None:
+        return _error(400, "limit must be an integer from 1 to 100")
+    after_id = None
+    if "cursor" in query:
+        after_id = _decode_cursor(query["cursor"])
+        if after_id is None:
+            return _error(400, "cursor is not valid")
+    remaining = [
+        item
+        for item in sorted(ITEMS, key=lambda item: item["id"])
+        if after_id is None or item["id"] > after_id
+    ]
+    page = remaining[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(remaining) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _parse_limit(raw):
+    if raw is None:
+        return DEFAULT_LIMIT
+    if not re.fullmatch(r"0*[0-9]{1,3}", raw):
+        return None
+    limit = int(raw)
+    return limit if 1 <= limit <= MAX_LIMIT else None
+
+
+def _encode_cursor(item_id):
+    assert item_id > 0
+    return base64.urlsafe_b64encode(str(item_id).encode("ascii")).decode("ascii")
+
+
+def _decode_cursor(raw):
+    try:
+        payload = base64.b64decode(raw, altchars=b"-_", validate=True)
+    except ValueError:
+        return None
+    if not re.fullmatch(rb"[1-9][0-9]{0,17}", payload):
+        return None
+    return int(payload)
 
 
