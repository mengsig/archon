diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..40c9275 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,67 @@
+class QueryError(ValueError):
+    """Raised when a search query contains invalid syntax."""
+
+
+def _terms(query):
+    terms = []
+    value = []
+    quoted = False
+    in_quotes = False
+
+    for character in query:
+        if character == '"':
+            in_quotes = not in_quotes
+            quoted = True
+        elif character.isspace() and not in_quotes:
+            if value or quoted:
+                terms.append(("".join(value), quoted))
+                value = []
+                quoted = False
+        else:
+            value.append(character)
+
+    if in_quotes:
+        raise QueryError("unterminated quote")
+    if value or quoted:
+        terms.append(("".join(value), quoted))
+    return terms
+
+
+def _parse(query):
+    parsed = []
+    for term, quoted in _terms(query):
+        if not quoted and ":" in term:
+            field, separator, value = term.partition(":")
+            field = field.casefold()
+            value = value.casefold()
+            if not separator or not value:
+                raise QueryError(f"invalid field term: {term}")
+            if field == "tag":
+                parsed.append(("tag", value))
+            elif field == "status":
+                if value not in ("open", "done"):
+                    raise QueryError(f"unknown status: {value}")
+                parsed.append(("status", value))
+            else:
+                raise QueryError(f"unknown field: {field}")
+        else:
+            parsed.append(("title", term.casefold()))
+    return parsed
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _parse(query)
+    if not terms:
+        return list(tasks)
+
+    def matches(task):
+        for kind, value in terms:
+            if kind == "title" and value not in task.title.casefold():
+                return False
+            if kind == "tag" and not any(value == tag.casefold() for tag in task.tags):
+                return False
+            if kind == "status" and task.status.casefold() != value:
+                return False
+        return True
+
+    return [task for task in tasks if matches(task)]
