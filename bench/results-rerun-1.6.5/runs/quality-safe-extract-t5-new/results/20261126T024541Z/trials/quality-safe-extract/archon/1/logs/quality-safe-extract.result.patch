diff --git a/safe_extract.py b/safe_extract.py
index 0007027..49761d0 100644
--- a/safe_extract.py
+++ b/safe_extract.py
@@ -1,5 +1,116 @@
 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _require_list(entries)
+    root_path = _validate_root(root)
+    batch = _validate_entries(entries)
+    for _, parts, _ in batch:
+        _check_target_free(root_path, parts)
+    for _, parts, data in batch:
+        _write_file(root_path, parts, data)
+    names = [name for name, _, _ in batch]
+    assert len(names) == len(entries)
+    return names
+
+
+def _require_list(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, got {type(entries).__name__}")
+
+
+def _validate_root(root):
+    if not isinstance(root, (str, Path)) or root == "":
+        raise ValueError(f"root must be a non-empty str or Path, got {root!r}")
+    root_path = Path(root)
+    try:
+        mode = os.lstat(root_path).st_mode
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root does not exist: {root!r}") from exc
+    if stat.S_ISLNK(mode):
+        raise ValueError(f"root must not be a symlink: {root!r}")
+    if not stat.S_ISDIR(mode):
+        raise ValueError(f"root is not a directory: {root!r}")
+    return root_path
+
+
+def _validate_entries(entries):
+    batch = [_parse_entry(index, entry) for index, entry in enumerate(entries)]
+    _check_batch_collisions(batch)
+    return batch
+
+
+def _parse_entry(index, entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry {index} must be a (name, data) tuple")
+    name, data = entry
+    if not isinstance(name, str):
+        raise ValueError(f"entry {index} name must be str, got {type(name).__name__}")
+    if not isinstance(data, bytes):
+        raise ValueError(f"entry {index} data must be bytes, got {type(data).__name__}")
+    return name, _split_name(name), data
+
+
+def _split_name(name):
+    if name == "":
+        raise ValueError("entry name must not be empty")
+    if name.startswith("/"):
+        raise ValueError(f"entry name must be relative: {name!r}")
+    for forbidden in ("\\", ":", "\x00"):
+        if forbidden in name:
+            raise ValueError(f"entry name {name!r} contains {forbidden!r}")
+    parts = tuple(name.split("/"))
+    for part in parts:
+        if part in ("", ".", ".."):
+            raise ValueError(f"entry name {name!r} has an invalid component {part!r}")
+    _check_encodable(name)
+    return parts
+
+
+def _check_encodable(name):
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name is not valid text: {name!r}") from exc
+
+
+def _check_batch_collisions(batch):
+    names = set()
+    for name, _, _ in batch:
+        if name in names:
+            raise ValueError(f"duplicate entry name: {name!r}")
+        names.add(name)
+    for name, parts, _ in batch:
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in names:
+                raise ValueError(f"entry {name!r} collides with file entry {ancestor!r}")
+
+
+def _check_target_free(root, parts):
+    assert parts
+    current = root
+    for depth, part in enumerate(parts):
+        current = current / part
+        try:
+            mode = os.lstat(current).st_mode
+        except FileNotFoundError:
+            return
+        if stat.S_ISLNK(mode):
+            raise ValueError(f"path contains a symlink: {str(current)!r}")
+        if depth == len(parts) - 1:
+            raise ValueError(f"target already exists: {str(current)!r}")
+        if not stat.S_ISDIR(mode):
+            raise ValueError(f"path component is not a directory: {str(current)!r}")
+
+
+def _write_file(root, parts, data):
+    assert parts
+    path = root.joinpath(*parts)
+    os.makedirs(path.parent, exist_ok=True)
+    with open(path, "xb") as handle:
+        handle.write(data)
