diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..fdad0e1 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,55 @@
+import re
+
+from .models import DONE, OPEN
+
+TERM = re.compile(r'(?:[^\s"]|"[^"]*")+')
+FIELD = re.compile(r'([^\s":]+):(.*)')
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_predicate(term) for term in _terms(query)]
+    return [task for task in tasks if all(keep(task) for keep in predicates)]
+
+
+def _terms(query):
+    if query.count('"') % 2:
+        raise QueryError(f"unterminated quote in query: {query}")
+    terms = TERM.findall(query)
+    assert all(terms), "query terms must be non-empty"
+    return terms
+
+
+def _unquote(text):
+    return text.replace('"', "")
+
+
+def _predicate(term):
+    field = FIELD.fullmatch(term)
+    if field is None:
+        phrase = _unquote(term).casefold()
+        return lambda task: phrase in task.title.casefold()
+    name = field.group(1).casefold()
+    value = _unquote(field.group(2))
+    if not value:
+        raise QueryError(f"no value after '{name}:' in query")
+    if name == "tag":
+        return _tag_predicate(value.casefold())
+    if name == "status":
+        return _status_predicate(value.casefold())
+    raise QueryError(f"unknown field in query term: {term}")
+
+
+def _tag_predicate(tag):
+    return lambda task: tag in [known.casefold() for known in task.tags]
+
+
+def _status_predicate(status):
+    if status not in STATUSES:
+        raise QueryError(f"unknown status in query: {status}")
+    return lambda task: task.status == status
