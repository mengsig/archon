diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..3e65262 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,41 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be a built-in int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    exponent = attempt - 1
+    # base_ms >= 1, so 2**exponent > cap_ms once exponent >= cap_ms.bit_length().
+    if exponent >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << exponent)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..28b0d22 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,125 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=True)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=1.0)
+
+    def test_rejects_out_of_range(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_validates_before_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(10, -1, max_attempts=1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=1.5)
+        with self.assertRaises(ValueError):
+            retry_delay(10, 0, max_attempts=4, retry_after_ms=-5)
+
+    def test_none_retry_after_is_allowed(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_accepts_huge_ints(self):
+        self.assertIsNone(retry_delay(10**30, 0))
+        self.assertEqual(retry_delay(1, 10**30, budget_ms=10**31), 100)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_last_allowed_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_max_attempts_counts_initial_attempt(self):
+        self.assertIsNone(retry_delay(4, 0, max_attempts=4))
+
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(100, 0, max_attempts=4))
+
+
+class Backoff(unittest.TestCase):
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, base_ms=0, retry_after_ms=7), 7)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_cap_applies_to_exponential_growth(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=10, cap_ms=300), 300)
+        self.assertEqual(retry_delay(4, 0, max_attempts=10, cap_ms=300), 300)
+
+    def test_huge_attempt_saturates_at_cap(self):
+        self.assertEqual(
+            retry_delay(10**9, 0, max_attempts=10**10, cap_ms=400), 400)
+        self.assertEqual(
+            retry_delay(10**9, 0, max_attempts=10**10, cap_ms=10**40,
+                        base_ms=1, budget_ms=10**41),
+            10**40)
+
+    def test_zero_cap_huge_attempt(self):
+        self.assertEqual(
+            retry_delay(10**9, 0, max_attempts=10**10, cap_ms=0), 0)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=900, budget_ms=5000),
+            900)
+
+    def test_retry_after_zero_keeps_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+
+class Budget(unittest.TestCase):
+    def test_strictly_before_budget(self):
+        self.assertEqual(retry_delay(1, 499, budget_ms=600), 100)
+        self.assertIsNone(retry_delay(1, 500, budget_ms=600))
+
+    def test_exact_budget_end_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_zero_delay_allowed_when_elapsed_before_budget(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_refused_at_budget(self):
+        self.assertIsNone(retry_delay(1, 1, base_ms=0, budget_ms=1))
+
+    def test_retry_after_pushing_past_budget_is_refused(self):
+        self.assertIsNone(
+            retry_delay(1, 0, retry_after_ms=1000, budget_ms=1000))
+
+    def test_wait_is_not_shortened_to_fit(self):
+        self.assertIsNone(retry_delay(2, 950, budget_ms=1000))
+
+    def test_zero_budget_refuses_even_zero_delay(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+        self.assertIsNone(retry_delay(1, 0, base_ms=0, budget_ms=0))
+
+
+if __name__ == "__main__":
+    unittest.main()
