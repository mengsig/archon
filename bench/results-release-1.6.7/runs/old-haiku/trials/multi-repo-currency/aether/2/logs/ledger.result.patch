-use ledger::{parse_cents, parse_line, to_csv_row};
+use std::io::Write;
+use std::process::{Command, Stdio};
+
+use ledger::{parse_cents, parse_line, to_csv_row, ParseError};
 
 #[test]
 fn parses_amounts() {
@@ -18,3 +21,88 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t1.00").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,100,USD");
+}
+
+#[test]
+fn reads_currency_column() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency_codes() {
+    for line in [
+        "2026-03-01\tgroceries\t1\teur",
+        "2026-03-01\tgroceries\t1\tEURO",
+        "2026-03-01\tgroceries\t1\tE1R",
+        "2026-03-01\tgroceries\t1\tEÜR",
+        "2026-03-01\tgroceries\t1\t",
+    ] {
+        let err = parse_line(line).unwrap_err();
+        assert!(
+            matches!(err, ParseError::BadCurrency(_)),
+            "{line:?} gave {err:?}"
+        );
+    }
+}
+
+#[test]
+fn wrong_field_count_is_malformed_not_currency() {
+    let err = parse_line("2026-03-01\tgroceries\t1\tEUR\textra").unwrap_err();
+    assert!(matches!(err, ParseError::Malformed(_)));
+}
+
+fn run_ledger(stdin: &str) -> (Option<i32>, String, String) {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(stdin.as_bytes())
+        .expect("write stdin");
+    let out = child.wait_with_output().expect("wait for ledger");
+    (
+        out.status.code(),
+        String::from_utf8(out.stdout).expect("utf8 stdout"),
+        String::from_utf8(out.stderr).expect("utf8 stderr"),
+    )
+}
+
+#[test]
+fn exports_csv_with_currency_column() {
+    let input = "2026-03-01\trent\t-1200\n2026-03-02\tfood\t5.00\tEUR\n";
+    let (code, stdout, _) = run_ledger(input);
+    assert_eq!(code, Some(0));
+    assert_eq!(
+        stdout,
+        "date,account,amount_cents,currency\n2026-03-01,rent,-120000,USD\n2026-03-02,food,500,EUR\n"
+    );
+}
+
+#[test]
+fn bad_currency_exits_2_naming_the_line() {
+    let input = "2026-03-01\trent\t1\tUSD\n# note\n\n2026-03-02\tfood\t1\teur\n";
+    let (code, stdout, stderr) = run_ledger(input);
+    assert_eq!(code, Some(2));
+    assert!(stderr.starts_with("line 4: "), "stderr: {stderr}");
+    assert!(stdout.starts_with("date,account,amount_cents,currency\n"));
+}
+
+#[test]
+fn other_input_errors_still_exit_1() {
+    let (code, _, stderr) = run_ledger("2026-03-01\trent\tlots\n");
+    assert_eq!(code, Some(1));
+    assert!(stderr.starts_with("line 1: "), "stderr: {stderr}");
+}
