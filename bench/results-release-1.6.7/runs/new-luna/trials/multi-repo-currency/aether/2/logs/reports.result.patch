 import sys
 
 
+class CurrencyError(ValueError):
+    pass
+
+
+def is_currency_code(value):
+    return isinstance(value, str) and len(value) == 3 and all("A" <= char <= "Z" for char in value)
+
+
 def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+    """{(account, currency): total_cents} from CSV dict rows."""
