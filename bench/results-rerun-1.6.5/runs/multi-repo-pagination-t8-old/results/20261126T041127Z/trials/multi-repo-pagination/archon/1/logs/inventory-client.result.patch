--- a/client.js
+++ b/client.js
@@ -11,11 +11,41 @@ async function request(transport, path, query = {}) {
   return res.body;
 }
 
+// Follows `next_cursor` until it is null or absent, returning every item in order.
 async function listItems(transport) {
-  const body = await request(transport, '/items');
+  const items = [];
+  const seenCursors = new Set();
+  let cursor;
+  for (;;) {
+    const query = cursor === undefined ? {} : { cursor };
+    const body = await request(transport, '/items', query);
+    items.push(...pageItems(body));
+    cursor = nextCursor(body);
+    if (cursor === null) return items;
+    if (seenCursors.has(cursor)) {
+      throw new Error(`GET /items returned repeated cursor ${JSON.stringify(cursor)}`);
+    }
+    seenCursors.add(cursor);
+  }
+}
+
+function pageItems(body) {
+  if (body === null || typeof body !== 'object' || !Array.isArray(body.items)) {
+    throw new Error(`GET /items returned a body without an items array: ${JSON.stringify(body)}`);
+  }
   return body.items;
 }
 
+// Returns the next cursor string, or null when this is the last page.
+function nextCursor(body) {
+  const cursor = body.next_cursor;
+  if (cursor === undefined || cursor === null) return null;
+  if (typeof cursor !== 'string') {
+    throw new Error(`GET /items returned a non-string next_cursor: ${JSON.stringify(cursor)}`);
+  }
+  return cursor;
+}
+
 async function getItem(transport, id) {
   return request(transport, `/items/${id}`);
 }
