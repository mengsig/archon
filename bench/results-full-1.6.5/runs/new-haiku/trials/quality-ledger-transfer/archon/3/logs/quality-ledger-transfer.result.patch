+class LedgerConcurrency(unittest.TestCase):
+    THREADS = 4
+    ROUNDS = 500
+    JOIN_SECONDS = 2
+
+    def _join_or_fail(self, thread):
+        thread.join(self.JOIN_SECONDS)
+        self.assertFalse(thread.is_alive(), f"{thread.name} did not finish: deadlock")
+
+    def test_opposite_transfers_do_not_deadlock_and_conserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        failures = []
+
+        def ping_pong(source, destination):
+            try:
+                for _ in range(self.ROUNDS):
+                    ledger.transfer(source, destination, 1)
+            except Exception as exc:
+                failures.append(exc)
+
+        threads = []
+        for index in range(self.THREADS):
+            pair = ("a", "b") if index % 2 == 0 else ("b", "a")
+            threads.append(threading.Thread(target=ping_pong, args=pair, daemon=True))
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            self._join_or_fail(thread)
+        self.assertEqual(failures, [])
+        self.assertEqual(sum(ledger.snapshot().values()), 2000)
+
+    def test_snapshots_never_see_a_half_transfer(self):
+        ledger = Ledger({"a": 500, "b": 500, "c": 500})
+        seen_totals = set()
+        writer_errors = []
+        done = threading.Event()
+
+        def shuffle():
+            try:
+                for _ in range(self.ROUNDS):
+                    ledger.transfer("a", "b", 3)
+                    ledger.transfer("b", "c", 7)
+                    ledger.transfer("c", "a", 2)
+            except Exception as exc:
+                writer_errors.append(exc)
+            finally:
+                done.set()
+
+        def read_totals():
+            while not done.is_set():
+                seen_totals.add(sum(ledger.snapshot().values()))
+
+        worker = threading.Thread(target=shuffle, daemon=True)
+        reader = threading.Thread(target=read_totals, daemon=True)
+        worker.start()
+        reader.start()
+        self._join_or_fail(worker)
+        self._join_or_fail(reader)
+        if writer_errors:
+            raise writer_errors[0]
+        seen_totals.add(sum(ledger.snapshot().values()))
+        self.assertEqual(seen_totals, {1500})
