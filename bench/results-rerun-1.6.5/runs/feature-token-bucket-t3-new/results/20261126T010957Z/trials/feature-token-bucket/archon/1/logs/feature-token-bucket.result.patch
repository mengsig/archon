+class KeyedLimiterEdgeTest(unittest.TestCase):
+    def test_invalid_parameters_raise(self):
+        cases = [(0, 1.0, 1), (1, 0, 1), (1, 1.0, 0), (1, 1.0, -1)]
+        for capacity, rate, max_keys in cases:
+            with self.subTest(capacity=capacity, rate=rate, max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, rate, max_keys=max_keys, clock=FakeClock())
+
+    def test_invalid_request_size_raises(self):
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", 0)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", 3)
+
+    def test_invalid_request_does_not_create_or_evict_keys(self):
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", 0)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a", 2))
+
+    def test_wait_time_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, clock=clock)
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_lru_key_is_evicted_at_limit(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_try_acquire_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertFalse(limiter.try_acquire("a"))
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_wait_time_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=clock)
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
