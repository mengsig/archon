+test('follows cursors and keeps items in page order', async () => {
+  const pages = [
+    { items: [ITEMS[0]], next_cursor: 'opaque / token' },
+    { items: [ITEMS[1]], next_cursor: null },
+  ];
+  const requests = [];
+  const transport = async (request) => {
+    requests.push(request);
+    return { status: 200, body: pages[requests.length - 1] };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(requests.map(({ query }) => query), [{}, { cursor: 'opaque / token' }]);
+});
+
+test('stops when next_cursor is absent', async () => {
+  let calls = 0;
+  const transport = async () => {
+    calls += 1;
+    return { status: 200, body: { items: ITEMS } };
+  };
+
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(calls, 1);
+});
+
