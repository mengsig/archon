+class ValidationTest(unittest.TestCase):
+    def test_bad_bucket_params_raise(self):
+        for capacity, rate in [(0, 1.0), (-1, 1.0), (1, 0), (1, -2.0), (float("nan"), 1.0)]:
+            with self.assertRaises(ValueError):
+                TokenBucket(capacity, rate, clock=FakeClock())
+            with self.assertRaises(ValueError):
+                KeyedLimiter(capacity, rate, clock=FakeClock())
+
+    def test_bad_request_size_raises_and_consumes_nothing(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for n in [0, -1, 3, float("nan")]:
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(n)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(n)
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_bad_max_keys_raises(self):
+        for max_keys in [0, -3]:
+            with self.assertRaises(ValueError):
+                KeyedLimiter(1, 1.0, max_keys=max_keys, clock=FakeClock())
+
+    def test_bad_request_on_keyed_limiter_creates_no_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("a", n=2)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("a", n=0)
+        self.assertEqual(len(limiter), 0)
+
+
+class SpecTest(unittest.TestCase):
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 100.0
+        self.assertEqual(bucket.available(), 2.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(1, 2.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertAlmostEqual(bucket.available(), 1.0)
+
+    def test_wait_time_is_seconds_until_success_and_consumes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 4.0, clock=clock)
+        bucket.try_acquire(2)
+        self.assertAlmostEqual(bucket.wait_time(), 0.25)
+        self.assertAlmostEqual(bucket.wait_time(2), 0.5)
+        self.assertAlmostEqual(bucket.available(), 0.0)
+        clock.now = 0.25
+        self.assertEqual(bucket.wait_time(), 0.0)
+        self.assertTrue(bucket.try_acquire())
+
+    def test_clock_going_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        clock.now = 5.0
+        bucket.try_acquire(2)
+        clock.now = 4.0
+        self.assertAlmostEqual(bucket.available(), 0.0)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 5.5
+        self.assertAlmostEqual(bucket.available(), 0.5)
+
+    def test_lru_eviction_by_try_acquire(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("a")  # "b" is now least recently used
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertTrue(limiter.try_acquire("b"))  # evicted, so it starts full
+
+    def test_lru_eviction_counts_wait_time_as_use(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=clock)
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")  # "b" becomes least recently used
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_evicted_key_returns_full(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, max_keys=1, clock=clock)
+        limiter.try_acquire("a", 2)
+        limiter.try_acquire("b")  # evicts "a"
+        self.assertTrue(limiter.try_acquire("a", 2))
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=3, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.wait_time("x")
+        limiter.try_acquire("y")
+        self.assertEqual(len(limiter), 2)
+
+
 if __name__ == "__main__":
     unittest.main()
