+/// An ISO 4217 code: exactly three uppercase ASCII letters.
+fn parse_currency(code: &str) -> Result<String, ParseError> {
+    let valid = code.len() == 3 && code.bytes().all(|c| c.is_ascii_uppercase());
+    if !valid {
+        return Err(ParseError::BadCurrency(format!("bad currency {code:?}")));
+    }
+    Ok(code.to_string())
+}
