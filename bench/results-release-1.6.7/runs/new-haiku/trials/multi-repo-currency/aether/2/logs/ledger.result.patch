+#[test]
+fn parses_currency_column() {
+    let entry = parse_line("2026-03-01\trent\t9.00\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,rent,900,EUR");
