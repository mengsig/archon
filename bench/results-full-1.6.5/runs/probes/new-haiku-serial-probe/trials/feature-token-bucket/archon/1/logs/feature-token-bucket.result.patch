+class TokenBucketValidationTest(unittest.TestCase):
+    def test_rejects_non_positive_capacity_and_rate(self):
+        for bad in (0, -1, float("nan")):
+            with self.assertRaises(ValueError):
+                TokenBucket(bad, 1.0, clock=FakeClock())
+            with self.assertRaises(ValueError):
+                TokenBucket(1, bad, clock=FakeClock())
+
+    def test_rejects_n_out_of_range(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        for bad in (0, -1, 3, float("nan")):
+            with self.assertRaises(ValueError):
+                bucket.try_acquire(bad)
+            with self.assertRaises(ValueError):
+                bucket.wait_time(bad)
+
+    def test_n_equal_to_capacity_is_allowed(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(2), 0.0)
+        self.assertTrue(bucket.try_acquire(2))
+
+
+class TokenBucketBehaviourTest(unittest.TestCase):
+    def test_failed_acquire_removes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        self.assertTrue(bucket.try_acquire())
+        self.assertFalse(bucket.try_acquire(2))
+        self.assertEqual(bucket.available(), 1.0)
+
+    def test_fractional_tokens_accrue(self):
+        clock = FakeClock()
+        bucket = TokenBucket(5, 2.0, clock=clock)
+        bucket.try_acquire(5)
+        clock.now = 0.25
+        self.assertAlmostEqual(bucket.available(), 0.5)
+        self.assertFalse(bucket.try_acquire())
+        clock.now = 0.5
+        self.assertTrue(bucket.try_acquire())
+
+    def test_tokens_never_exceed_capacity(self):
+        clock = FakeClock()
+        bucket = TokenBucket(3, 1.0, clock=clock)
+        bucket.try_acquire()
+        clock.now = 1000.0
+        self.assertEqual(bucket.available(), 3.0)
+
+    def test_wait_time_is_zero_when_available(self):
+        bucket = TokenBucket(2, 1.0, clock=FakeClock())
+        self.assertEqual(bucket.wait_time(), 0.0)
+        self.assertEqual(bucket.wait_time(2), 0.0)
+
+    def test_wait_time_is_exact_and_does_not_consume(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertAlmostEqual(bucket.wait_time(3), 1.5)
+        self.assertEqual(bucket.available(), 0.0)
+
+    def test_waiting_the_reported_time_makes_acquire_succeed(self):
+        clock = FakeClock()
+        bucket = TokenBucket(4, 2.0, clock=clock)
+        bucket.try_acquire(4)
+        clock.now += bucket.wait_time(3)
+        self.assertTrue(bucket.try_acquire(3))
+
+    def test_clock_moving_backwards_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        clock.now = 0.0
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        self.assertEqual(bucket.available(), 5.0)
+        clock.now = 2.0
+        self.assertEqual(bucket.available(), 5.0)
+        self.assertEqual(bucket.wait_time(6), 1.0)
+        clock.now = 3.0
+        self.assertEqual(bucket.available(), 5.0)
+
+    def test_no_refill_until_clock_passes_latest_seen_time(self):
+        clock = FakeClock()
+        bucket = TokenBucket(10, 1.0, clock=clock)
+        clock.now = 0.0
+        bucket.try_acquire(10)
+        clock.now = 5.0
+        bucket.available()
+        clock.now = 2.0
+        self.assertFalse(bucket.try_acquire(6))
+        clock.now = 6.0
+        self.assertTrue(bucket.try_acquire(1))
+
+    def test_nan_clock_reading_changes_nothing(self):
+        clock = FakeClock()
+        bucket = TokenBucket(2, 1.0, clock=clock)
+        bucket.try_acquire(2)
+        clock.now = float("nan")
+        self.assertEqual(bucket.available(), 0.0)
+        clock.now = 1.0
+        self.assertEqual(bucket.available(), 1.0)
+
+
+class KeyedLimiterValidationTest(unittest.TestCase):
+    def test_rejects_invalid_rate_arguments(self):
+        for capacity, rate in ((0, 1.0), (1, 0), (-1, 1.0), (1, -2.0)):
+            with self.assertRaises(ValueError):
+                KeyedLimiter(capacity, rate, clock=FakeClock())
+
+    def test_rejects_max_keys_below_one(self):
+        for bad in (0, -1):
+            with self.assertRaises(ValueError):
+                KeyedLimiter(1, 1.0, max_keys=bad, clock=FakeClock())
+
+    def test_rejects_n_out_of_range_without_tracking_key(self):
+        limiter = KeyedLimiter(2, 1.0, clock=FakeClock())
+        for bad in (0, 3):
+            with self.assertRaises(ValueError):
+                limiter.try_acquire("a", bad)
+            with self.assertRaises(ValueError):
+                limiter.wait_time("a", bad)
+        self.assertEqual(len(limiter), 0)
+
+
+class KeyedLimiterBehaviourTest(unittest.TestCase):
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_wait_time_is_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, clock=clock)
+        limiter.try_acquire("a", 2)
+        self.assertEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_least_recently_used_key_is_evicted(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(limiter.wait_time("a"), 1.0)
+        self.assertTrue(limiter.try_acquire("c"))
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("a"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+        self.assertEqual(len(limiter), 1)
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_failed_acquire_counts_as_use(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertFalse(limiter.try_acquire("a"))
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_max_keys_one_keeps_only_latest_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        for key in ("a", "b", "c"):
+            self.assertTrue(limiter.try_acquire(key))
+            self.assertEqual(len(limiter), 1)
+
+    def test_refill_applies_per_key_with_shared_clock(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, clock=clock)
+        limiter.try_acquire("a", 2)
+        clock.now = 1.0
+        self.assertTrue(limiter.try_acquire("a"))
+        self.assertFalse(limiter.try_acquire("a", 2))
+
+
 if __name__ == "__main__":
