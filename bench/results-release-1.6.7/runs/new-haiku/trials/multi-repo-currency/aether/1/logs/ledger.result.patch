diff --git a/tests/ledger.rs b/tests/ledger.rs
index 6293987..d9a4aee 100644
--- a/tests/ledger.rs
+++ b/tests/ledger.rs
@@ -1,4 +1,7 @@
-use ledger::{parse_cents, parse_line, to_csv_row};
+use std::io::Write;
+use std::process::{Command, Output, Stdio};
+
+use ledger::{parse_cents, parse_line, to_csv_row, ParseError};
 
 #[test]
 fn parses_amounts() {
@@ -18,3 +21,79 @@ fn parses_lines() {
     assert!(parse_line("2026-03-01\tgroceries").is_err());
     assert!(parse_line("March 1\tgroceries\t1").is_err());
 }
+
+#[test]
+fn missing_currency_defaults_to_usd() {
+    let entry = parse_line("2026-03-01\tgroceries\t-45.10").unwrap();
+    assert_eq!(entry.currency, "USD");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,groceries,-4510,USD");
+}
+
+#[test]
+fn explicit_currency_is_kept() {
+    let entry = parse_line("2026-03-01\tcafe\t2.50\tEUR").unwrap();
+    assert_eq!(entry.currency, "EUR");
+    assert_eq!(to_csv_row(&entry), "2026-03-01,cafe,250,EUR");
+}
+
+#[test]
+fn rejects_malformed_currency() {
+    for bad in ["eur", "EURO", "EU", "E1R", "", "US$"] {
+        let line = format!("2026-03-01\tcafe\t2.50\t{bad}");
+        assert!(
+            matches!(parse_line(&line), Err(ParseError::BadCurrency(_))),
+            "currency {bad:?} should be rejected"
+        );
+    }
+}
+
+#[test]
+fn rejects_too_many_fields() {
+    assert!(matches!(
+        parse_line("2026-03-01\tcafe\t2.50\tEUR\textra"),
+        Err(ParseError::Malformed(_))
+    ));
+}
+
+fn run_ledger(input: &str) -> Output {
+    let mut child = Command::new(env!("CARGO_BIN_EXE_ledger"))
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped())
+        .spawn()
+        .expect("spawn ledger");
+    child
+        .stdin
+        .take()
+        .expect("piped stdin")
+        .write_all(input.as_bytes())
+        .expect("write stdin");
+    child.wait_with_output().expect("wait for ledger")
+}
+
+#[test]
+fn exports_csv_with_currency_column() {
+    let out = run_ledger("# comment\n2026-03-01\tgroceries\t1.00\n2026-03-02\tcafe\t2.50\tEUR\n");
+    assert_eq!(out.status.code(), Some(0));
+    assert_eq!(
+        String::from_utf8(out.stdout).unwrap(),
+        "date,account,amount_cents,currency\n\
+         2026-03-01,groceries,100,USD\n\
+         2026-03-02,cafe,250,EUR\n"
+    );
+}
+
+#[test]
+fn bad_currency_exits_2_and_names_line() {
+    let out = run_ledger("2026-03-01\tgroceries\t1.00\tEUR\n2026-03-02\tcafe\t2.50\teur\n");
+    assert_eq!(out.status.code(), Some(2));
+    let stderr = String::from_utf8(out.stderr).unwrap();
+    assert!(stderr.starts_with("line 2: bad currency"), "stderr: {stderr}");
+}
+
+#[test]
+fn other_bad_input_still_exits_1() {
+    let out = run_ledger("2026-03-01\tgroceries\tnope\n");
+    assert_eq!(out.status.code(), Some(1));
+    assert!(String::from_utf8(out.stderr).unwrap().starts_with("line 1: bad amount"));
+}
