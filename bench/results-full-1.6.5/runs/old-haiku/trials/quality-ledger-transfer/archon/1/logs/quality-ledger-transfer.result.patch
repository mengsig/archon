+class LedgerConcurrency(unittest.TestCase):
+    THREADS = 4
+    ROUNDS = 500
+    JOIN_TIMEOUT_SECONDS = 30
+
+    def _run_all(self, threads):
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.JOIN_TIMEOUT_SECONDS)
+            self.assertFalse(thread.is_alive(), "worker thread hung")
+
+    def test_opposite_transfers_do_not_deadlock_and_conserve_total(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        errors = []
+
+        def worker(source, destination):
+            try:
+                for _ in range(self.ROUNDS):
+                    self.assertIs(ledger.transfer(source, destination, 1), True)
+            except Exception as exc:
+                errors.append(exc)
+
+        threads = []
+        for index in range(self.THREADS):
+            pair = ("a", "b") if index % 2 == 0 else ("b", "a")
+            threads.append(threading.Thread(target=worker, args=pair))
+        self._run_all(threads)
+        self.assertEqual(errors, [])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_snapshots_never_see_half_a_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 0})
+        observed_totals = set()
+        errors = []
+
+        def mover():
+            try:
+                for _ in range(self.ROUNDS):
+                    ledger.transfer("a", "b", 1)
+                    ledger.transfer("b", "a", 1)
+            except Exception as exc:
+                errors.append(exc)
+
+        def observer():
+            try:
+                for _ in range(self.ROUNDS):
+                    observed_totals.add(sum(ledger.snapshot().values()))
+            except Exception as exc:
+                errors.append(exc)
+
+        self._run_all([threading.Thread(target=mover), threading.Thread(target=observer)])
+        self.assertEqual(errors, [])
+        self.assertEqual(observed_totals, {1000})
+
+
+if __name__ == "__main__":
+    unittest.main()
