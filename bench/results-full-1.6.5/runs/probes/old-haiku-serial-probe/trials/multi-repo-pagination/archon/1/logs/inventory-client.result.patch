+// Serves `pages` keyed by the cursor sent (`first` when none is sent).
+function pagedTransport(pages) {
+  const sent = [];
+  const transport = async (request) => {
+    sent.push(request.query);
+    const page = pages[request.query.cursor ?? 'first'];
+    return page ? { status: 200, body: page } : { status: 400, body: { error: 'invalid cursor' } };
+  };
+  return { transport, sent };
+}
+
+test('lists items from a single page', async () => {
+  const { transport, sent } = pagedTransport({
+    first: { items: ITEMS, next_cursor: null },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(sent, [{}]);
+});
+
+test('follows next_cursor across pages, passing it back unchanged', async () => {
+  const { transport, sent } = pagedTransport({
+    first: { items: [ITEMS[0]], next_cursor: 'abc=' },
+    'abc=': { items: [ITEMS[1]], next_cursor: 'def' },
+    def: { items: [{ id: 3, sku: 'SKU-0003', qty: 7 }], next_cursor: null },
+  });
+  const items = await listItems(transport);
+  assert.deepEqual(items.map((item) => item.id), [1, 2, 3]);
+  assert.deepEqual(sent, [{}, { cursor: 'abc=' }, { cursor: 'def' }]);
+});
+
+test('stops when next_cursor is missing', async () => {
+  const { transport, sent } = pagedTransport({
+    first: { items: ITEMS },
+  });
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.equal(sent.length, 1);
+});
+
+test('rejects when a later page fails', async () => {
+  const { transport } = pagedTransport({
+    first: { items: ITEMS, next_cursor: 'unknown' },
+  });
+  await assert.rejects(listItems(transport), /400/);
+});
+
+test('rejects when the server repeats a next_cursor', async () => {
+  const { transport } = pagedTransport({
+    first: { items: ITEMS, next_cursor: 'loop' },
+    loop: { items: [], next_cursor: 'loop' },
+  });
+  await assert.rejects(listItems(transport), /already followed/);
+});
+
+test('rejects when a multi-page cycle repeats a next_cursor', async () => {
+  const { transport } = pagedTransport({
+    first: { items: [ITEMS[0]], next_cursor: 'a' },
+    a: { items: [ITEMS[1]], next_cursor: 'b' },
+    b: { items: [], next_cursor: 'a' },
+  });
+  await assert.rejects(listItems(transport), /already followed/);
 });
 
