diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..7dfe851 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,75 @@
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+
+
+class QueryError(ValueError):
+    """Raised for a malformed search query."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    matchers = [_parse_term(raw) for raw in _split_terms(query)]
+    return [task for task in tasks if all(match(task) for match in matchers)]
+
+
+def _split_terms(query):
+    """Split on whitespace outside double quotes; quote characters are kept."""
+    terms = []
+    current = []
+    in_quotes = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+        elif char.isspace() and not in_quotes:
+            if current:
+                terms.append("".join(current))
+                current = []
+            continue
+        current.append(char)
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query!r}")
+    if current:
+        terms.append("".join(current))
+    assert all(terms), "split must not produce empty terms"
+    return terms
+
+
+def _parse_term(raw):
+    if raw.startswith('"'):
+        return _title_matcher(_unquote(raw))
+    field, separator, value = raw.partition(":")
+    if not separator:
+        return _title_matcher(_unquote(raw))
+    return _field_matcher(field, _unquote(value))
+
+
+def _unquote(text):
+    return text.replace('"', "")
+
+
+def _field_matcher(field, value):
+    if field == "tag":
+        return _tag_matcher(value)
+    if field == "status":
+        return _status_matcher(value)
+    raise QueryError(f"unknown field {field!r}")
+
+
+def _title_matcher(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_matcher(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_matcher(value):
+    wanted = value.lower()
+    if wanted not in STATUSES:
+        raise QueryError(f"unknown status {value!r}")
+    return lambda task: task.status == wanted
