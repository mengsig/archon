+class LedgerBoundaries(unittest.TestCase):
+    def test_maximum_balance_and_exact_transfer(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 0})
+        self.assertIs(ledger.transfer("a", "b", MAX_BALANCE), True)
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+    def test_destination_overflow_returns_false_without_mutation(self):
+        ledger = Ledger({"a": 1, "b": MAX_BALANCE})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("a", "b", 1), False)
+        self.assertEqual(ledger.snapshot(), before)
+
+    def test_same_account_checks_funds_without_mutating(self):
+        ledger = Ledger({"a": MAX_BALANCE, "b": 3})
+        before = ledger.snapshot()
+        self.assertIs(ledger.transfer("a", "a", MAX_BALANCE), True)
+        self.assertIs(ledger.transfer("b", "b", 4), False)
+        self.assertEqual(ledger.snapshot(), before)
+        with self.assertRaises(ValueError):
+            ledger.transfer("a", "a", 0)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "missing", 1)
+
+    def test_snapshot_is_independent(self):
+        ledger = Ledger({"a": 2})
+        snapshot = ledger.snapshot()
+        snapshot["a"] = MAX_BALANCE
+        snapshot["b"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 2})
+
