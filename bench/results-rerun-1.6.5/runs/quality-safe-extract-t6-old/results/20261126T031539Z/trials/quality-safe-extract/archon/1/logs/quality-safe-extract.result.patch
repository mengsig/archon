 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+_FORBIDDEN_NAME_CHARS = ("\\", ":", "\0")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _require_list(entries)
+    root_path = _validate_root(root)
+    validated = [_validate_entry(entry) for entry in entries]
+    names = [name for name, _ in validated]
+    _check_batch_names(names)
+    for name in names:
+        _check_target_free(root_path, name)
+    for name, data in validated:
+        _write_file(root_path, name, data)
+    return names
+
+
+def _require_list(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _validate_root(root):
+    try:
+        root_text = os.fspath(root)
+    except TypeError as exc:
+        raise ValueError(f"root must be a str or path, not {type(root).__name__}") from exc
+    if not isinstance(root_text, str):
+        raise ValueError("root must be a str or path, not bytes")
+    if not root_text:
+        raise ValueError("root must not be empty")
+    if ".." in root_text.split("/") or ".." in root_text.split(os.sep):
+        raise ValueError(f"root must not contain '..' components: {root_text!r}")
+    root_path = Path(root_text)
+    try:
+        root_stat = os.lstat(root_path)
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root is not an existing directory: {root_text!r}") from exc
+    if stat.S_ISLNK(root_stat.st_mode):
+        raise ValueError(f"root must not be a symlink: {root_text!r}")
+    if not stat.S_ISDIR(root_stat.st_mode):
+        raise ValueError(f"root is not a directory: {root_text!r}")
+    return root_path
+
+
+def _validate_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, not {type(entry).__name__}")
+    name, data = entry
+    _check_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name, data
+
+
+def _check_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"name must be str, not {type(name).__name__}")
+    if not name:
+        raise ValueError("name must not be empty")
+    if any(char in name for char in _FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"name contains a forbidden character: {name!r}")
+    for part in name.split("/"):
+        if part in ("", ".", ".."):
+            raise ValueError(f"name has an invalid component: {name!r}")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"name is not valid Unicode: {name!r}") from exc
+
+
+def _check_batch_names(names):
+    seen = set()
+    for name in names:
+        if name in seen:
+            raise ValueError(f"duplicate name in batch: {name!r}")
+        seen.add(name)
+    for name in names:
+        parts = name.split("/")
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in seen:
+                raise ValueError(f"{ancestor!r} is both a file and a directory in batch: {name!r}")
+
+
+def _check_target_free(root, name):
+    parts = name.split("/")
+    current = root
+    for part in parts[:-1]:
+        current = current / part
+        current_stat = _lstat_or_none(current)
+        if current_stat is None:
+            return
+        if not stat.S_ISDIR(current_stat.st_mode):
+            raise ValueError(f"ancestor of {name!r} is not a real directory: {str(current)!r}")
+    if _lstat_or_none(current / parts[-1]) is not None:
+        raise ValueError(f"target already exists: {name!r}")
+
+
+def _lstat_or_none(path):
+    try:
+        return os.lstat(path)
+    except FileNotFoundError:
+        return None
+
+
+def _write_file(root, name, data):
+    path = root.joinpath(*name.split("/"))
+    assert not os.path.lexists(path), "target must be absent after validation"
+    os.makedirs(path.parent, exist_ok=True)
+    with open(path, "xb") as handle:
+        handle.write(data)
