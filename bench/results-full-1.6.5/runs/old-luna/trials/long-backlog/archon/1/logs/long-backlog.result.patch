+class QueryError(ValueError):
+    """Raised when a search query is not valid."""
+
+
+def _terms(query):
+    terms = []
+    term = []
+    quoted = False
+
+    for character in query:
+        if character == '"':
+            quoted = not quoted
+        elif character.isspace() and not quoted:
+            if term:
+                terms.append("".join(term))
+                term = []
+        else:
+            term.append(character)
+
+    if quoted:
+        raise QueryError("unterminated quote")
+    if term:
+        terms.append("".join(term))
+    return terms
+
+
+def _matches(task, terms):
+    for term in terms:
+        if ":" in term:
+            field, value = term.split(":", 1)
+            field = field.lower()
+            if field == "tag":
+                if not any(tag.lower() == value.lower() for tag in task.tags):
+                    return False
+            elif field == "status":
+                status = value.lower()
+                if task.status.lower() != status:
+                    return False
+        elif term.lower() not in task.title.lower():
+            return False
+    return True
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    for term in terms:
+        if ":" in term:
+            field, value = term.split(":", 1)
+            if field.lower() == "status" and value.lower() not in ("open", "done"):
+                raise QueryError("unknown status: " + value)
+            if field.lower() not in ("tag", "status"):
+                raise QueryError("unsupported query field: " + field.lower())
+    return [task for task in tasks if _matches(task, terms)]
