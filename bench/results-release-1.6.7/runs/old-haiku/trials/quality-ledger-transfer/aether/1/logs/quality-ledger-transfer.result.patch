+    def test_balance_bounds_are_inclusive(self):
+        ledger = Ledger({"a": 0, "b": MAX_BALANCE})
+        self.assertEqual(ledger.snapshot(), {"a": 0, "b": MAX_BALANCE})
+
+    def test_input_dict_is_copied(self):
+        balances = {"a": 1}
