diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..d0e9dd7 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,41 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    _check_int("attempt", attempt, minimum=1)
+    _check_int("elapsed_ms", elapsed_ms, minimum=0)
+    _check_int("max_attempts", max_attempts, minimum=1)
+    _check_int("budget_ms", budget_ms, minimum=0)
+    _check_int("base_ms", base_ms, minimum=0)
+    _check_int("cap_ms", cap_ms, minimum=0)
+    if retry_after_ms is not None:
+        _check_int("retry_after_ms", retry_after_ms, minimum=0)
+
+    if attempt >= max_attempts:
+        return None
+
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        # Server Retry-After is a floor and is deliberately not capped.
+        delay = max(delay, retry_after_ms)
+
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
+
+
+def _check_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms * 2**shift >= 2**shift > cap_ms once shift reaches cap's bit length,
+    # so the power of two is never built for huge attempts.
+    if shift >= cap_ms.bit_length() or base_ms >= cap_ms:
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..f11140a 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -1,4 +1,5 @@
 import unittest
+from unittest import mock
 
 from retry_budget import retry_delay
 
@@ -16,3 +17,160 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class Validation(unittest.TestCase):
+    def assertInvalid(self, *args, **kwargs):
+        with self.assertRaises(ValueError):
+            retry_delay(*args, **kwargs)
+
+    def test_bool_is_rejected(self):
+        self.assertInvalid(True, 0)
+        self.assertInvalid(1, True)
+        self.assertInvalid(1, 0, max_attempts=True)
+        self.assertInvalid(1, 0, budget_ms=True)
+        self.assertInvalid(1, 0, base_ms=False)
+        self.assertInvalid(1, 0, cap_ms=False)
+        self.assertInvalid(1, 0, retry_after_ms=True)
+
+    def test_float_is_rejected(self):
+        self.assertInvalid(1.0, 0)
+        self.assertInvalid(1, 0.0)
+        self.assertInvalid(1, 0, max_attempts=4.0)
+        self.assertInvalid(1, 0, budget_ms=1000.0)
+        self.assertInvalid(1, 0, base_ms=100.5)
+        self.assertInvalid(1, 0, cap_ms=400.0)
+        self.assertInvalid(1, 0, retry_after_ms=1.0)
+
+    def test_wrong_type_is_rejected(self):
+        self.assertInvalid("1", 0)
+        self.assertInvalid(1, "0")
+        self.assertInvalid(1, 0, max_attempts="4")
+        self.assertInvalid(1, 0, budget_ms=None)
+        self.assertInvalid(1, 0, base_ms="100")
+        self.assertInvalid(1, 0, cap_ms=[400])
+        self.assertInvalid(1, 0, retry_after_ms="5")
+
+    def test_zero_attempt_and_max_attempts_are_rejected(self):
+        self.assertInvalid(0, 0)
+        self.assertInvalid(1, 0, max_attempts=0)
+
+    def test_negative_values_are_rejected(self):
+        self.assertInvalid(-1, 0)
+        self.assertInvalid(1, -1)
+        self.assertInvalid(1, 0, max_attempts=-1)
+        self.assertInvalid(1, 0, budget_ms=-1)
+        self.assertInvalid(1, 0, base_ms=-1)
+        self.assertInvalid(1, 0, cap_ms=-1)
+        self.assertInvalid(1, 0, retry_after_ms=-1)
+
+    def test_none_retry_after_means_no_floor(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=None), 100)
+
+    def test_validation_runs_before_exhaustion_returns(self):
+        self.assertInvalid(5, 0, max_attempts=3, retry_after_ms=-1)
+        self.assertInvalid(5, -1, max_attempts=3)
+        self.assertInvalid(1, 1000, budget_ms=-5)
+
+
+class AttemptLimit(unittest.TestCase):
+    def test_attempt_equal_to_max_attempts_returns_none(self):
+        self.assertIsNone(retry_delay(3, 0, max_attempts=3))
+
+    def test_attempt_before_max_attempts_returns_delay(self):
+        self.assertEqual(retry_delay(2, 0, max_attempts=3), 200)
+
+    def test_attempt_greater_than_max_attempts_returns_none(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=3))
+
+
+class BackoffShape(unittest.TestCase):
+    def test_exponential_growth_saturates_at_cap(self):
+        delays = [retry_delay(n, 0, max_attempts=10, budget_ms=10**9)
+                  for n in range(1, 6)]
+        self.assertEqual(delays, [100, 200, 400, 400, 400])
+
+    def test_zero_base_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(7, 0, base_ms=0, max_attempts=10), 0)
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(7, 0, cap_ms=0, max_attempts=10), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_huge_attempt_saturates_quickly(self):
+        self.assertEqual(retry_delay(10**6, 0, max_attempts=10**7), 400)
+        self.assertEqual(retry_delay(10**18, 0, max_attempts=10**19), 400)
+
+    def test_huge_attempt_with_zero_base_or_cap(self):
+        self.assertEqual(retry_delay(10**18, 0, base_ms=0,
+                                     max_attempts=10**19), 0)
+        self.assertEqual(retry_delay(10**18, 0, cap_ms=0,
+                                     max_attempts=10**19), 0)
+
+    def test_huge_base_saturates_at_cap(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=10**30, cap_ms=400), 400)
+
+
+class RetryAfter(unittest.TestCase):
+    def test_retry_after_above_cap_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, retry_after_ms=900, budget_ms=2000), 900)
+
+    def test_retry_after_zero_does_not_override_backoff(self):
+        self.assertEqual(retry_delay(1, 0, retry_after_ms=0), 100)
+
+    def test_retry_after_floors_zero_backoff(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, retry_after_ms=50), 50)
+        self.assertEqual(retry_delay(1, 0, cap_ms=0, retry_after_ms=50), 50)
+
+
+class Budget(unittest.TestCase):
+    def test_delay_ending_exactly_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_delay_ending_one_before_budget_is_allowed(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_retry_after_that_overruns_budget_is_refused(self):
+        self.assertIsNone(
+            retry_delay(1, 0, retry_after_ms=1000, budget_ms=1000))
+
+    def test_retry_after_is_not_shortened_to_fit(self):
+        self.assertIsNone(
+            retry_delay(1, 500, retry_after_ms=600, budget_ms=1000))
+
+    def test_zero_budget_refuses_everything(self):
+        self.assertIsNone(retry_delay(1, 0, budget_ms=0))
+
+
+class ZeroDelay(unittest.TestCase):
+    def test_zero_delay_is_returned_when_budget_allows(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0, budget_ms=1), 0)
+
+    def test_zero_delay_at_budget_is_refused(self):
+        self.assertIsNone(retry_delay(1, 5, base_ms=0, budget_ms=5))
+
+
+class SideEffects(unittest.TestCase):
+    def test_never_sleeps_or_reads_clock(self):
+        with mock.patch("time.sleep") as sleep, \
+                mock.patch("time.monotonic") as monotonic, \
+                mock.patch("time.time") as wall_clock:
+            retry_delay(2, 100, retry_after_ms=50)
+        sleep.assert_not_called()
+        monotonic.assert_not_called()
+        wall_clock.assert_not_called()
+
+    def test_repeated_calls_return_same_result(self):
+        first = retry_delay(3, 200, retry_after_ms=300)
+        second = retry_delay(3, 200, retry_after_ms=300)
+        self.assertEqual(first, second)
+        self.assertEqual(first, 400)
+
+
+if __name__ == "__main__":
+    unittest.main()
