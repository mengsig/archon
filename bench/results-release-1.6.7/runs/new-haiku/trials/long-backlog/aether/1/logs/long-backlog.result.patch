+    def undo(self):
+        """Revert the most recent add, complete or delete that is not yet undone."""
+        if not self._history:
+            raise NothingToUndo("no add, complete or delete left to undo")
+        change = self._history.pop()
+        if change.kind == ADD:
+            assert change.task_id in self._tasks, "added task missing at undo"
+            del self._tasks[change.task_id]
+        elif change.kind == COMPLETE:
