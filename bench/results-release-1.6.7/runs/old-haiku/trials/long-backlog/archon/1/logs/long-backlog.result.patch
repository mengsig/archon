     def complete(self, task_id):
         task = self.get(task_id)
+        self._history.append(_Change(_COMPLETE, task, previous_status=task.status))
         task.status = DONE
         return task
 
     def delete(self, task_id):
         task = self.get(task_id)
         del self._tasks[task_id]
+        self._history.append(_Change(_DELETE, task))
         return task
 
+    def undo(self):
+        if not self._history:
+            raise NothingToUndo("no add, complete or delete left to undo")
+        change = self._history.pop()
+        self._revert(change)
+        return change.task
+
+    def _revert(self, change):
+        task_id = change.task.id
+        if change.kind == _ADD:
+            assert task_id in self._tasks, "an added task is still stored"
+            del self._tasks[task_id]
+        elif change.kind == _COMPLETE:
+            assert task_id in self._tasks, "a completed task is still stored"
+            change.task.status = change.previous_status
+        else:
+            assert change.kind == _DELETE, "history holds a known change kind"
+            assert task_id not in self._tasks, "a deleted task is not stored"
+            self._tasks[task_id] = change.task
+
     def all(self):
