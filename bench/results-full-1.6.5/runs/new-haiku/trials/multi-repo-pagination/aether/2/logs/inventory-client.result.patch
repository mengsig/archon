@@ -16,10 +16,43 @@ async function singlePage(request) {
   return { status: 404, body: { error: 'not found' } };
 }
 
+function paged(pages) {
+  const seenQueries = [];
+  const transport = async (request) => {
+    seenQueries.push(request.query);
+    const index = request.query.cursor === undefined ? 0 : Number(request.query.cursor.slice(1));
+    const page = pages[index];
+    if (page === undefined) return { status: 400, body: { error: 'cursor is invalid' } };
+    return { status: 200, body: { items: page, next_cursor: index + 1 < pages.length ? `c${index + 1}` : null } };
+  };
+  return { transport, seenQueries };
+}
+
 test('lists items', async () => {
   assert.deepEqual(await listItems(singlePage), ITEMS);
 });
 
+test('follows next_cursor across pages in order', async () => {
+  const { transport, seenQueries } = paged([[ITEMS[0]], [ITEMS[1]], []]);
+  assert.deepEqual(await listItems(transport), ITEMS);
+  assert.deepEqual(seenQueries, [{}, { cursor: 'c1' }, { cursor: 'c2' }]);
+});
+
+test('treats an absent next_cursor as the last page', async () => {
+  const transport = async () => ({ status: 200, body: { items: ITEMS } });
+  assert.deepEqual(await listItems(transport), ITEMS);
+});
+
+test('rejects a server that repeats a cursor', async () => {
+  const transport = async () => ({ status: 200, body: { items: [], next_cursor: 'same' } });
+  await assert.rejects(listItems(transport), /same cursor/);
+});
+
+test('reports a rejected cursor', async () => {
+  const transport = async () => ({ status: 400, body: { error: 'cursor is invalid' } });
+  await assert.rejects(listItems(transport), /400/);
+});
