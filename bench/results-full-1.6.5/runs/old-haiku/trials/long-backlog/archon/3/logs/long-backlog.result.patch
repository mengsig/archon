--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,73 @@
+from collections import namedtuple
+
+from .models import DONE, OPEN
+
+STATUSES = (OPEN, DONE)
+FIELDS = ("tag", "status")
+
+Term = namedtuple("Term", ["field", "value"])
+
+
+class QueryError(ValueError):
+    pass
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    assert isinstance(query, str), "query must be a string"
+    terms = parse_query(query)
+    return [task for task in tasks if all(_matches(task, term) for term in terms)]
+
+
+def parse_query(query):
+    assert isinstance(query, str), "query must be a string"
+    return [_make_term(field, value) for field, value in _split_terms(query)]
+
+
+def _split_terms(query):
+    """Return (field, value) pairs; quotes group whitespace and hide colons."""
+    pairs = []
+    field = None
+    chars = []
+    in_quote = False
+    started = False
+    for ch in query:
+        if ch == '"':
+            in_quote = not in_quote
+            started = True
+        elif in_quote:
+            chars.append(ch)
+        elif ch.isspace():
+            if started:
+                pairs.append((field, "".join(chars)))
+            field, chars, started = None, [], False
+        elif ch == ":" and field is None:
+            field, chars, started = "".join(chars), [], True
+        else:
+            chars.append(ch)
+            started = True
+    if in_quote:
+        raise QueryError(f"unterminated quote in query {query!r}")
+    if started:
+        pairs.append((field, "".join(chars)))
+    return pairs
+
+
+def _make_term(field, value):
+    if field is None:
+        return Term(None, value.casefold())
+    if field not in FIELDS:
+        raise QueryError(f"unknown field {field!r} in term {field}:{value}")
+    if not value:
+        raise QueryError(f"empty value for {field}:")
+    if field == "status" and value.casefold() not in STATUSES:
+        raise QueryError(f"unknown status {value!r}")
+    return Term(field, value.casefold())
+
+
+def _matches(task, term):
+    assert task.status in STATUSES, f"task {task.id} has invalid status"
+    if term.field is None:
+        return term.value in task.title.casefold()
+    if term.field == "tag":
+        return any(tag.casefold() == term.value for tag in task.tags)
+    return task.status == term.value
