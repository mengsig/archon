@@ -0,0 +1,22 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+class SearchTest(unittest.TestCase):
+    def test_terms_and_validation(self):
+        store = TaskStore()
+        first = store.add("Fix login bug", ["Urgent", "web"])
+        second = store.add("fix profile", ["web"])
+        store.complete(second.id)
+        self.assertEqual(search(store.all(), '"fix login" tag:URGENT status:open'), [first])
+        self.assertEqual(search(store.all(), "FIX tag:web"), [first, second])
+        self.assertEqual(search(store.all(), "  "), [first, second])
+        for query in ('status:waiting', 'owner:me', '"unfinished'):
+            with self.subTest(query=query), self.assertRaises(QueryError):
+                search(store.all(), query)
+
+
+if __name__ == "__main__":
+    unittest.main()
