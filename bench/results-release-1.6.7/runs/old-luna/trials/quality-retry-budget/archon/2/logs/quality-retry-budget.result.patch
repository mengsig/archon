diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..abae505 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,32 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    values = ("attempt", attempt), ("elapsed_ms", elapsed_ms), ("max_attempts", max_attempts), \
+        ("budget_ms", budget_ms), ("base_ms", base_ms), ("cap_ms", cap_ms)
+    if retry_after_ms is not None:
+        values += (("retry_after_ms", retry_after_ms),)
+
+    for name, value in values:
+        if type(value) is not int:
+            raise ValueError("{} must be an integer".format(name))
+        minimum = 1 if name in ("attempt", "max_attempts") else 0
+        if value < minimum:
+            raise ValueError("{} must be at least {}".format(name, minimum))
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        backoff = 0
+    else:
+        # Once the exponent reaches cap_ms, no larger power is needed.
+        exponent = attempt - 1
+        if exponent >= cap_ms.bit_length():
+            backoff = cap_ms
+        else:
+            backoff = min(cap_ms, base_ms << exponent)
+
+    delay = max(backoff, retry_after_ms or 0)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..58ee8af 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,61 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_all_numeric_arguments_reject_bool_and_float(self):
+        cases = (
+            ((True, 0), {}), ((1, False), {}),
+            ((1, 0), {"max_attempts": 1.0}),
+            ((1, 0), {"budget_ms": True}),
+            ((1, 0), {"base_ms": 1.5}),
+            ((1, 0), {"cap_ms": False}),
+            ((1, 0), {"retry_after_ms": 2.0}),
+        )
+        for args, kwargs in cases:
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_negative_and_zero_minimum_constraints(self):
+        for args, kwargs in (
+                ((0, 0), {}), ((1, 0), {"max_attempts": 0}),
+                ((1, -1), {}), ((1, 0), {"budget_ms": -1}),
+                ((1, 0), {"base_ms": -1}), ((1, 0), {"cap_ms": -1}),
+                ((1, 0), {"retry_after_ms": -1})):
+            with self.subTest(args=args, kwargs=kwargs):
+                with self.assertRaises(ValueError):
+                    retry_delay(*args, **kwargs)
+
+    def test_validation_precedes_exhausted_returns(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1, max_attempts=1)
+        with self.assertRaises(ValueError):
+            retry_delay(5, 0, retry_after_ms=1.5)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_limits_count_initial_attempt_and_allow_larger_attempt(self):
+        self.assertIsNone(retry_delay(1, 0, max_attempts=1))
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_huge_attempt_saturates_without_building_huge_power(self):
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**100 + 1), 400)
+
+    def test_zero_base_and_zero_cap(self):
+        self.assertEqual(retry_delay(3, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(1, 0, base_ms=0, cap_ms=0), 0)
+
+    def test_retry_after_floor_can_exceed_cap(self):
+        self.assertEqual(retry_delay(1, 0, cap_ms=20, retry_after_ms=50), 50)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=50, cap_ms=20,
+                                      retry_after_ms=50))
+
+    def test_budget_boundary_is_strict(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 1000, budget_ms=1000,
+                                      base_ms=0))
