+pub enum ParseError {
+    InvalidCurrency(String),
+    Other(String),
+}
+
+impl std::fmt::Display for ParseError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::InvalidCurrency(message) | Self::Other(message) => f.write_str(message),
+        }
+    }
+}
 
