@@ -0,0 +1,108 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_add_does_not_reuse_id(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_complete_of_already_done_task_keeps_it_done(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+
+    def test_undo_delete_restores_exact_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("pay rent", tags=["home", "money"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        before = store.get(task.id)
+        snapshot = (before.id, before.title, list(before.tags), before.status, before.due)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(
+            (restored.id, restored.title, restored.tags, restored.status, restored.due),
+            snapshot,
+        )
+
+    def test_undo_delete_restores_tags_as_they_were_at_delete(self):
+        store = TaskStore()
+        task = store.add("sort mail", tags=["a"])
+        store.delete(task.id)
+        task.tags.append("mutated-after-delete")
+        store.undo()
+        self.assertEqual(store.get(task.id).tags, ["a"])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("alpha")
+        store.complete(a.id)
+        b = store.add("beta")
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_delete_after_complete_then_undo_complete(self):
+        store = TaskStore()
+        task = store.add("gamma")
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_nothing_to_undo_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_nothing_left_after_all_undone_raises(self):
+        store = TaskStore()
+        store.add("once")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
