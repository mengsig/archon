diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..d77a401 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,50 @@
+class QueryError(ValueError):
+    """Raised when a search query is malformed or uses an unknown filter."""
+
+
+def _terms(query):
+    terms = []
+    current = []
+    quoted = False
+    for char in query:
+        if char == '"':
+            quoted = not quoted
+        elif char.isspace() and not quoted:
+            if current:
+                terms.append("".join(current))
+                current = []
+        else:
+            current.append(char)
+    if quoted:
+        raise QueryError("unterminated quote")
+    if current:
+        terms.append("".join(current))
+    return terms
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    terms = _terms(query)
+    for term in terms:
+        if ":" in term:
+            field, value = term.split(":", 1)
+            if field == "tag":
+                continue
+            if field == "status" and value.lower() in ("open", "done"):
+                continue
+            raise QueryError(f"invalid search term: {term}")
+
+    def matches(task):
+        for term in terms:
+            if ":" not in term:
+                if term.casefold() not in task.title.casefold():
+                    return False
+                continue
+            field, value = term.split(":", 1)
+            if field == "tag":
+                if not any(value.casefold() == tag.casefold() for tag in task.tags):
+                    return False
+            elif task.status.casefold() != value.casefold():
+                return False
+        return True
+
+    return [task for task in tasks if matches(task)]
