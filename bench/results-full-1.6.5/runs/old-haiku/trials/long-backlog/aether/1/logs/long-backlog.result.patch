+++ b/tests/test_store_undo.py
@@ -0,0 +1,79 @@
+import unittest
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task_and_keeps_ids_unique(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        second = store.add("second")
+        self.assertEqual(second.id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("buy milk", tags=["home"])
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status), (1, "buy milk", ["home"], DONE))
+
+    def test_undo_walks_back_in_lifo_order_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_nothing_to_undo_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        store.add("only")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_are_not_reused_after_undo(self):
+        store = TaskStore()
+        store.add("a")
+        store.undo()
+        store.add("b")
+        store.undo()
+        task = store.add("c")
+        self.assertEqual(task.id, 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
