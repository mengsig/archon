@@ -24,6 +24,74 @@ class ApiTest(unittest.TestCase):
     def test_only_get(self):
         self.assertEqual(handle({"method": "POST", "path": "/items"})["status"], 405)
 
+    def test_default_limit_is_20_with_next_cursor(self):
+        res = get("/items")
+        self.assertEqual(res["status"], 200)
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(1, 21)))
+        self.assertEqual(res["body"]["next_cursor"], "20")
+
+    def test_paging_follows_cursor_through_every_item(self):
+        ids, cursor = [], None
+        while True:
+            query = {"limit": "10"} if cursor is None else {"limit": "10", "cursor": cursor}
+            res = get("/items", **query)
+            self.assertEqual(res["status"], 200)
+            ids += [item["id"] for item in res["body"]["items"]]
+            cursor = res["body"]["next_cursor"]
+            if cursor is None:
+                break
+        self.assertEqual(ids, list(range(1, 58)))
+
+    def test_last_page_has_null_next_cursor(self):
+        res = get("/items", limit="20", cursor="50")
+        ids = [item["id"] for item in res["body"]["items"]]
+        self.assertEqual(ids, list(range(51, 58)))
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_exact_final_page_has_null_next_cursor(self):
+        res = get("/items", limit="19", cursor="38")
+        self.assertEqual(len(res["body"]["items"]), 19)
+        self.assertIsNone(res["body"]["next_cursor"])
+
+    def test_cursor_past_last_item_is_empty_page(self):
+        res = get("/items", cursor="57")
+        self.assertEqual(res["body"], {"items": [], "next_cursor": None})
+
+    def test_limit_bounds_accepted(self):
+        self.assertEqual(len(get("/items", limit="1")["body"]["items"]), 1)
+        self.assertEqual(len(get("/items", limit="100")["body"]["items"]), 57)
+
+    def test_invalid_limit_is_400_with_error(self):
+        for raw in ["0", "101", "-1", "abc", "", "1.5", "+5", "9" * 19]:
+            with self.subTest(limit=raw):
+                res = get("/items", limit=raw)
+                self.assertEqual(res["status"], 400)
+                self.assertIn("limit", res["body"]["error"])
+
+    def test_non_object_query_is_400_not_exception(self):
+        for query in [["limit"], "limit=5", 7]:
