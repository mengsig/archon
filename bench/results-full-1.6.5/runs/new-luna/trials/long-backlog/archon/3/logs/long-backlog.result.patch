diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..3442f30 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,50 @@
+class QueryError(ValueError):
+    """Raised when a search query contains invalid syntax."""
+
+
+def _terms(query):
+    terms = []
+    term = []
+    quoted = False
+    active = False
+
+    for character in query:
+        if character == '"':
+            quoted = not quoted
+            active = True
+        elif character.isspace() and not quoted:
+            if active:
+                terms.append("".join(term))
+                term = []
+                active = False
+        else:
+            term.append(character)
+            active = True
+
+    if quoted:
+        raise QueryError("unterminated quote")
+    if active:
+        terms.append("".join(term))
+    return terms
+
+
+def _predicate(term):
+    if ":" not in term:
+        needle = term.casefold()
+        return lambda task: needle in task.title.casefold()
+
+    field, value = term.split(":", 1)
+    if field == "tag":
+        tag = value.casefold()
+        return lambda task: any(tag == task_tag.casefold() for task_tag in task.tags)
+    if field == "status":
+        status = value.casefold()
+        if status not in ("open", "done"):
+            raise QueryError("unknown status: " + value)
+        return lambda task: task.status.casefold() == status
+    raise QueryError("unknown field: " + field)
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    predicates = [_predicate(term) for term in _terms(query)]
+    return [task for task in tasks if all(predicate(task) for predicate in predicates)]
