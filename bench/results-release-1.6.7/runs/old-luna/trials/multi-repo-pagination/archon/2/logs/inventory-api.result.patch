 def list_items(query):
+    raw_limit = query.get("limit", "20")
+    if isinstance(raw_limit, bool):
+        return _error(400, "limit must be an integer from 1 through 100")
+    try:
+        limit = int(raw_limit)
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 through 100")
+    if str(limit) != str(raw_limit) or not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer from 1 through 100")
+
     items = sorted(ITEMS, key=lambda item: item["id"])
-    return {"status": 200, "body": {"items": items}}
+    cursor = query.get("cursor")
+    if cursor is not None:
+        last_id = _decode_cursor(cursor)
+        if last_id is None or not any(item["id"] == last_id for item in items):
+            return _error(400, "invalid cursor")
+        items = [item for item in items if item["id"] > last_id]
+
+    page = items[:limit]
+    next_cursor = _encode_cursor(page[-1]["id"]) if len(items) > limit else None
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
+
+
+def _encode_cursor(item_id):
+    encoded = base64.urlsafe_b64encode(str(item_id).encode("ascii"))
+    return encoded.decode("ascii").rstrip("=")
+
+
+def _decode_cursor(cursor):
+    if not isinstance(cursor, str) or not cursor:
+        return None
+    try:
+        padded = cursor + "=" * (-len(cursor) % 4)
+        decoded = base64.b64decode(padded, altchars=b"-_", validate=True).decode("ascii")
+        if not decoded.isdigit() or decoded.startswith("0"):
+            return None
+        return int(decoded)
+    except (binascii.Error, UnicodeDecodeError, ValueError):
+        return None
 
 
