@@ -0,0 +1,56 @@
+import csv
+import io
+import unittest
+from datetime import date
+
+from tasktracker.export import to_csv
+from tasktracker.store import TaskStore
+
+HEADER = "id,title,tags,status,due"
+
+
+class ToCsvTest(unittest.TestCase):
+    def test_empty_export_is_header_only(self):
+        self.assertEqual(to_csv([]), HEADER + "\r\n")
+
+    def test_every_line_ends_with_crlf(self):
+        store = TaskStore()
+        store.add("one")
+        self.assertEqual(to_csv(store.all()), HEADER + "\r\n1,one,,open,\r\n")
+
+    def test_tags_and_due_date(self):
+        store = TaskStore()
+        store.add("plain title", tags=["a", "b"], due=date(2026, 4, 1))
+        self.assertEqual(to_csv(store.all()).splitlines()[1], "1,plain title,a;b,open,2026-04-01")
+
+    def test_comma_quote_and_newlines_are_quoted(self):
+        store = TaskStore()
+        store.add('buy milk, eggs', tags=["home"])
+        store.add('say "hi"')
+        store.add("line one\nline two")
+        store.add("carriage\rreturn")
+        text = to_csv(store.all())
+        self.assertIn('1,"buy milk, eggs",home,open,\r\n', text)
+        self.assertIn('2,"say ""hi""",,open,\r\n', text)
+        self.assertIn('3,"line one\nline two",,open,\r\n', text)
+        self.assertIn('4,"carriage\rreturn",,open,\r\n', text)
+
+    def test_unneeded_fields_are_not_quoted(self):
+        store = TaskStore()
+        store.add("plain", tags=["x"], due=date(2026, 1, 2))
+        self.assertIn("1,plain,x,open,2026-01-02\r\n", to_csv(store.all()))
+
+    def test_rows_keep_input_order_and_round_trip(self):
+        store = TaskStore()
+        store.add("second-id-first", tags=["t"])
+        store.add('third, "quoted"', due=date(2026, 5, 6))
+        tasks = list(reversed(store.all()))
+        rows = list(csv.reader(io.StringIO(to_csv(tasks), newline="")))
+        self.assertEqual(rows[0], ["id", "title", "tags", "status", "due"])
+        self.assertEqual([row[0] for row in rows[1:]], ["2", "1"])
+        self.assertEqual(rows[1][1], 'third, "quoted"')
+        self.assertEqual(rows[2], ["1", "second-id-first", "t", "open", ""])
+
+
+if __name__ == "__main__":
+    unittest.main()
