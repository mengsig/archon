 });
 
+test('follows next_cursor across pages, in order, passing cursors unchanged', async () => {
+  const requests = [];
+  const transport = pagedTransport({
+    first: { items: [{ id: 1 }, { id: 2 }], next_cursor: 'abc==' },
+    'abc==': { items: [{ id: 3 }], next_cursor: 'zz/9 ' },
+    'zz/9 ': { items: [{ id: 4 }], next_cursor: null },
+  }, requests);
+  assert.deepEqual(await listItems(transport), [{ id: 1 }, { id: 2 }, { id: 3 }, { id: 4 }]);
+  assert.deepEqual(requests.map((r) => r.query), [{}, { cursor: 'abc==' }, { cursor: 'zz/9 ' }]);
+});
+
+test('single page with null next_cursor makes one request', async () => {
+  const requests = [];
+  const transport = pagedTransport({ first: { items: ITEMS, next_cursor: null } }, requests);
+  assert.deepEqual(await listItems(transport), ITEMS);
