@@ -0,0 +1,88 @@
+import unittest
+from dataclasses import asdict
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("one")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        store.add("one")
+        store.undo()
+        self.assertEqual(store.add("two").id, 2)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("one")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, "open")
+
+    def test_undo_delete_restores_task_exactly(self):
+        store = TaskStore()
+        task = store.add("one", tags=["a", "b"], due=date(2026, 5, 1))
+        store.complete(task.id)
+        before = asdict(task)
+        store.delete(task.id)
+        store.undo()
+        self.assertEqual(asdict(store.get(task.id)), before)
+
+    def test_deleted_task_is_restored_as_it_was_when_deleted(self):
+        store = TaskStore()
+        task = store.add("one", tags=["a"])
+        deleted = store.delete(task.id)
+        deleted.tags.append("changed-after-delete")
+        store.undo()
+        self.assertEqual(store.get(task.id).tags, ["a"])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_operations_are_not_recorded(self):
+        store = TaskStore()
+        store.add("one")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_add_with_empty_title_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
