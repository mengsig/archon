@@ -0,0 +1,83 @@
+import unittest
+from datetime import date
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+
+    def test_undo_delete_restores_exact_task(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["work", "q3"], due=date(2026, 4, 1))
+        store.complete(a.id)
+        before = store.get(a.id)
+        snapshot = (before.id, before.title, list(before.tags), before.status, before.due)
+        store.delete(a.id)
+        store.undo()
+        restored = store.get(a.id)
+        self.assertEqual(
+            (restored.id, restored.title, restored.tags, restored.status, restored.due),
+            snapshot,
+        )
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("first")
+        b = store.add("second")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id, b.id])
+        self.assertEqual(store.get(a.id).status, "done")
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_nothing_to_undo_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+        store.add("only")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_ids_not_reused_after_undo_add(self):
+        store = TaskStore()
+        store.add("gone")
+        store.undo()
+        b = store.add("next")
+        self.assertEqual(b.id, 2)
+
+    def test_failed_operations_not_recorded(self):
+        store = TaskStore()
+        store.add("keep")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
