@@ -0,0 +1,88 @@
+import unittest
+
+from tasktracker.search import QueryError, search
+from tasktracker.store import TaskStore
+
+
+def _store():
+    store = TaskStore()
+    store.add("Fix login bug", tags=["Work"])
+    store.add("fix the login page", tags=["home"])
+    store.add("write report", tags=["work", "urgent"])
+    store.add("buy milk")
+    store.complete(store.all()[1].id)
+    return store
+
+
+def _titles(query):
+    return [task.title for task in search(_store().all(), query)]
+
+
+class SearchTest(unittest.TestCase):
+    def test_blank_query_matches_everything_in_order(self):
+        for query in ["", "   ", "\t"]:
+            with self.subTest(query=query):
+                self.assertEqual(len(_titles(query)), 4)
+        self.assertEqual(_titles("")[0], "Fix login bug")
+
+    def test_bare_word_is_case_insensitive_substring(self):
+        self.assertEqual(_titles("LOGIN"), ["Fix login bug", "fix the login page"])
+
+    def test_terms_are_and_combined(self):
+        self.assertEqual(_titles("fix login"), ["Fix login bug", "fix the login page"])
+        self.assertEqual(_titles("fix report"), [])
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(_titles('"login page"'), ["fix the login page"])
+        self.assertEqual(_titles('"login bug" milk'), [])
+
+    def test_unterminated_quote_is_an_error(self):
+        with self.assertRaises(QueryError):
+            search([], '"fix login')
+
+    def test_tag_is_exact_and_case_insensitive(self):
+        self.assertEqual(_titles("tag:WORK"), ["Fix login bug", "write report"])
+        self.assertEqual(_titles("tag:wor"), [])
+
+    def test_status_filter(self):
+        self.assertEqual(_titles("status:done"), ["fix the login page"])
+        self.assertEqual(len(_titles("status:open")), 3)
+        self.assertEqual(_titles("STATUS:Done"), ["fix the login page"])
+
+    def test_field_terms_combine_with_words(self):
+        self.assertEqual(_titles("login tag:work"), ["Fix login bug"])
+        self.assertEqual(_titles("status:open tag:urgent"), ["write report"])
+
+    def test_quoted_field_like_text_is_a_phrase(self):
+        store = TaskStore()
+        store.add("tag:x is literal")
+        self.assertEqual([t.title for t in search(store.all(), '"tag:x"')], ["tag:x is literal"])
+
+    def test_quotes_inside_field_value_are_removed(self):
+        store = TaskStore()
+        store.add("a", tags=["two words"])
+        self.assertEqual(len(search(store.all(), 'tag:"two words"')), 1)
+
+    def test_unknown_field_is_an_error(self):
+        with self.assertRaisesRegex(QueryError, "unknown field: due"):
+            search([], "due:today")
+
+    def test_unknown_status_is_an_error(self):
+        with self.assertRaisesRegex(QueryError, "unknown status: closed"):
+            search([], "status:closed")
+
+    def test_empty_field_value_is_an_error(self):
+        with self.assertRaises(QueryError):
+            search([], "tag:")
+
+    def test_colon_inside_plain_word_is_a_bare_term(self):
+        store = TaskStore()
+        store.add("meet at 10:30")
+        self.assertEqual(len(search(store.all(), "10:30")), 1)
+
+    def test_query_error_is_a_value_error(self):
+        self.assertTrue(issubclass(QueryError, ValueError))
+
+
+if __name__ == "__main__":
+    unittest.main()
