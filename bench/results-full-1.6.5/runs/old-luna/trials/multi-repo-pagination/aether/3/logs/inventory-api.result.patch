-    return {"status": 200, "body": {"items": items}}
+    raw_limit = query.get("limit", 20)
+    try:
+        limit = int(raw_limit)
+    except (TypeError, ValueError):
+        return _error(400, "limit must be an integer from 1 to 100")
+    if isinstance(raw_limit, bool) or str(raw_limit).strip() != str(limit) or not 1 <= limit <= 100:
+        return _error(400, "limit must be an integer from 1 to 100")
+
+    cursor = query.get("cursor")
+    after_id = 0
+    if cursor is not None:
+        if not isinstance(cursor, str) or not cursor:
+            return _error(400, "invalid cursor")
+        try:
+            decoded = base64.urlsafe_b64decode(cursor + "=" * (-len(cursor) % 4)).decode("ascii")
+            after_id = int(decoded)
+            if str(after_id) != decoded or after_id < 1 or not any(item["id"] == after_id for item in items):
+                raise ValueError
+        except (ValueError, UnicodeDecodeError, binascii.Error):
+            return _error(400, "invalid cursor")
+
+    remaining = [item for item in items if item["id"] > after_id]
+    page = remaining[:limit]
+    next_cursor = None
+    if len(remaining) > limit:
+        encoded = str(page[-1]["id"]).encode("ascii")
+        next_cursor = base64.urlsafe_b64encode(encoded).decode("ascii").rstrip("=")
+    return {"status": 200, "body": {"items": page, "next_cursor": next_cursor}}
 
 
