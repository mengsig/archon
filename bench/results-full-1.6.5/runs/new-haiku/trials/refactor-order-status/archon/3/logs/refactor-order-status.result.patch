new file mode 100644
index 0000000..9059061
--- /dev/null
+++ b/tests/characterization.rs
@@ -0,0 +1,144 @@
+use orders::{billing, report, shipping, Order, OrderStatus};
+
+fn order_in(id: u32, target: OrderStatus, total_cents: u64) -> Order {
+    let mut order = Order::new(id, "cy", total_cents);
+    match target {
+        OrderStatus::Pending => {}
+        OrderStatus::Paid => billing::pay(&mut order).unwrap(),
+        OrderStatus::Shipped => {
+            billing::pay(&mut order).unwrap();
+            shipping::ship(&mut order).unwrap();
+        }
+        OrderStatus::Cancelled => order.cancel().unwrap(),
+    }
+    assert_eq!(order.status, target);
+    order
+}
+
+#[test]
+fn cancel_refuses_shipped_and_cancelled_orders_with_their_status() {
+    let mut shipped = order_in(7, OrderStatus::Shipped, 10);
+    assert_eq!(
+        shipped.cancel().unwrap_err(),
+        "order 7 cannot be cancelled: it is shipped"
+    );
+    assert_eq!(shipped.status, OrderStatus::Shipped);
+
+    let mut cancelled = order_in(8, OrderStatus::Cancelled, 10);
+    assert_eq!(
+        cancelled.cancel().unwrap_err(),
+        "order 8 cannot be cancelled: it is cancelled"
+    );
+}
+
+#[test]
+fn cancel_allows_pending_and_paid_orders() {
+    let mut pending = order_in(1, OrderStatus::Pending, 10);
+    pending.cancel().unwrap();
+    assert_eq!(pending.status, OrderStatus::Cancelled);
+
+    let mut paid = order_in(2, OrderStatus::Paid, 10);
+    paid.cancel().unwrap();
+    assert_eq!(paid.status, OrderStatus::Cancelled);
+}
+
+#[test]
+fn pay_and_ship_refuse_the_wrong_status() {
+    let mut paid = order_in(3, OrderStatus::Paid, 10);
+    assert_eq!(
+        billing::pay(&mut paid).unwrap_err(),
+        "order 3 cannot be paid: it is paid"
+    );
+
+    let mut cancelled = order_in(4, OrderStatus::Cancelled, 10);
+    assert_eq!(
+        shipping::ship(&mut cancelled).unwrap_err(),
+        "order 4 cannot be shipped: it is cancelled"
+    );
+    assert_eq!(cancelled.status, OrderStatus::Cancelled);
+}
+
+#[test]
+fn is_open_is_true_only_for_pending_and_paid() {
+    assert!(order_in(1, OrderStatus::Pending, 1).is_open());
+    assert!(order_in(2, OrderStatus::Paid, 1).is_open());
+    assert!(!order_in(3, OrderStatus::Shipped, 1).is_open());
+    assert!(!order_in(4, OrderStatus::Cancelled, 1).is_open());
+}
+
+#[test]
+fn outstanding_and_ready_ignore_every_other_status() {
+    let orders = vec![
+        order_in(1, OrderStatus::Pending, 100),
+        order_in(2, OrderStatus::Paid, 200),
+        order_in(3, OrderStatus::Shipped, 400),
+        order_in(4, OrderStatus::Cancelled, 800),
+        order_in(5, OrderStatus::Pending, 16),
+    ];
+    assert_eq!(billing::outstanding_cents(&orders), 116);
+    assert_eq!(shipping::ready_to_ship(&orders), [2]);
+}
+
+#[test]
+fn status_counts_list_every_present_status_sorted_by_name() {
+    let orders = vec![
+        order_in(1, OrderStatus::Shipped, 1),
+        order_in(2, OrderStatus::Pending, 1),
+        order_in(3, OrderStatus::Shipped, 1),
+        order_in(4, OrderStatus::Cancelled, 1),
+        order_in(5, OrderStatus::Paid, 1),
+    ];
+    assert_eq!(
+        report::status_counts(&orders),
+        [
+            (OrderStatus::Cancelled, 1),
+            (OrderStatus::Paid, 1),
+            (OrderStatus::Pending, 1),
+            (OrderStatus::Shipped, 2),
+        ]
+    );
+    assert!(report::status_counts(&[]).is_empty());
+}
+
+#[test]
+fn from_line_trims_surrounding_whitespace() {
+    let order = report::from_line("  9,dee,42,shipped\n").unwrap();
+    assert_eq!(order.id, 9);
+    assert_eq!(order.customer, "dee");
+    assert_eq!(order.total_cents, 42);
+    assert_eq!(order.status, OrderStatus::Shipped);
+}
+
+#[test]
+fn from_line_reports_each_malformed_field() {
+    assert_eq!(
+        report::from_line("1,ada,100").unwrap_err(),
+        "expected 4 fields, got 3"
+    );
+    assert_eq!(
+        report::from_line("x,ada,100,paid").unwrap_err(),
+        "bad id \"x\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,-5,paid").unwrap_err(),
+        "bad total \"-5\": invalid digit found in string"
+    );
+    assert_eq!(
+        report::from_line("1,ada,5,Paid").unwrap_err(),
+        "unknown status \"Paid\""
+    );
+    assert_eq!(
+        report::from_line("1,ada,5, paid").unwrap_err(),
+        "unknown status \" paid\""
+    );
+}
+
+#[test]
+fn from_line_accepts_every_status_and_round_trips() {
+    for status in OrderStatus::ALL {
+        let line = format!("5,eve,60,{status}");
+        let order = report::from_line(&line).unwrap();
+        assert_eq!(order.status, status);
+        assert_eq!(report::to_line(&order), line);
+    }
+}
