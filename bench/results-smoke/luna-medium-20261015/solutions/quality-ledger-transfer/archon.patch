+class LedgerValidation(unittest.TestCase):
+    def test_constructor_validation_and_copy(self):
+        original = {"a": 1}
+        ledger = Ledger(original)
+        original["a"] = 9
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
+        for balances in (None, [], {"": 0}, {1: 0}, {"a": True},
+                         {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(balances=balances):
+                with self.assertRaises(ValueError):
+                    Ledger(balances)
+
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_constructor_accepts_string_subclasses_as_names(self):
+        class AccountName(str):
+            pass
+
+        ledger = Ledger({AccountName("checking"): 3})
+        self.assertEqual(ledger.snapshot(), {"checking": 3})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({"a": 1})
+        for amount in (True, 0, -1, MAX_BALANCE + 1, 1.0):
+            with self.subTest(amount=amount):
+                with self.assertRaises(ValueError):
+                    ledger.transfer("missing", "also missing", amount)
+
+    def test_unknown_accounts_raise_key_error(self):
+        ledger = Ledger({"a": 1})
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "a", 1)
+        with self.assertRaises(KeyError):
+            ledger.transfer("a", "missing", 1)
+
+    def test_snapshots_do_not_alias_internal_state(self):
+        ledger = Ledger({"a": 1})
+        snapshot = ledger.snapshot()
+        snapshot["a"] = 50
+        self.assertEqual(ledger.snapshot(), {"a": 1})
+
