+class LedgerConcurrency(unittest.TestCase):
+    ROUNDS = 1000
+    JOIN_TIMEOUT = 10
+
+    def test_opposing_transfers_preserve_total_and_do_not_deadlock(self):
+        # Two threads debit each account 1000x per round pair; starting at
+        # 2*ROUNDS covers the worst case, so every transfer succeeds and the
+        # end state is fixed regardless of interleaving.
+        ledger = Ledger({"a": 2 * self.ROUNDS, "b": 2 * self.ROUNDS})
+        errors = []
+
+        def run(source, destination):
+            try:
+                for _ in range(self.ROUNDS):
+                    if not ledger.transfer(source, destination, 1):
+                        errors.append((source, destination))
+                        return
+            except Exception as exc:  # surfaced to the main thread below
+                errors.append(exc)
+
+        def observe():
+            try:
+                for _ in range(self.ROUNDS):
+                    snap = ledger.snapshot()
+                    if sum(snap.values()) != 4 * self.ROUNDS:
+                        errors.append(("total", snap))
+                        return
+            except Exception as exc:
+                errors.append(exc)
+
+        # daemon: a stuck thread must not block interpreter exit after the timeout
+        threads = [
+            threading.Thread(target=run, args=("a", "b"), daemon=True),
+            threading.Thread(target=run, args=("b", "a"), daemon=True),
+            threading.Thread(target=run, args=("a", "b"), daemon=True),
+            threading.Thread(target=run, args=("b", "a"), daemon=True),
+            threading.Thread(target=observe, daemon=True),
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(self.JOIN_TIMEOUT)
+        stuck = [thread for thread in threads if thread.is_alive()]
+        self.assertEqual(stuck, [], "threads did not finish: possible deadlock")
+        self.assertEqual(errors, [])
+        self.assertEqual(ledger.snapshot(), {"a": 2 * self.ROUNDS, "b": 2 * self.ROUNDS})
+
+
+if __name__ == "__main__":
+    unittest.main()
