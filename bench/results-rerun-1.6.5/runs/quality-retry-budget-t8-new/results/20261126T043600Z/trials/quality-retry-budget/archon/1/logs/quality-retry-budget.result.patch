diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..21b8f2a 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -1,6 +1,46 @@
 """Pure bounded retry scheduling. See SPEC.md."""
 
 
+def _require_int(name, value, minimum):
+    if type(value) is not int:
+        raise ValueError(f"{name} must be an int, got {type(value).__name__}")
+    if value < minimum:
+        raise ValueError(f"{name} must be >= {minimum}, got {value}")
+
+
+def _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms,
+              cap_ms, retry_after_ms):
+    _require_int("attempt", attempt, 1)
+    _require_int("elapsed_ms", elapsed_ms, 0)
+    _require_int("max_attempts", max_attempts, 1)
+    _require_int("budget_ms", budget_ms, 0)
+    _require_int("base_ms", base_ms, 0)
+    _require_int("cap_ms", cap_ms, 0)
+    if retry_after_ms is not None:
+        _require_int("retry_after_ms", retry_after_ms, 0)
+
+
+def _backoff(attempt, base_ms, cap_ms):
+    if base_ms == 0 or cap_ms == 0:
+        return 0
+    shift = attempt - 1
+    # base_ms >= 1 and 2**shift > cap_ms once shift >= cap_ms.bit_length(),
+    # so the capped result is known without building the power of two.
+    if shift >= cap_ms.bit_length():
+        return cap_ms
+    return min(cap_ms, base_ms << shift)
+
+
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the wait in ms before the next attempt, or None to stop."""
+    _validate(attempt, elapsed_ms, max_attempts, budget_ms, base_ms,
+              cap_ms, retry_after_ms)
+    if attempt >= max_attempts:
+        return None
+    delay = _backoff(attempt, base_ms, cap_ms)
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..a57417e 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,100 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryValidation(unittest.TestCase):
+    def test_rejects_bool_and_float(self):
+        with self.assertRaises(ValueError):
+            retry_delay(True, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=100.0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=False)
+
+    def test_rejects_non_int_types(self):
+        with self.assertRaises(ValueError):
+            retry_delay("1", 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, None)
+
+    def test_attempt_and_max_attempts_minimum_is_one(self):
+        with self.assertRaises(ValueError):
+            retry_delay(0, 0)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, max_attempts=0)
+
+    def test_non_negative_fields(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, -1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, budget_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, base_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, cap_ms=-1)
+        with self.assertRaises(ValueError):
+            retry_delay(1, 0, retry_after_ms=-1)
+
+    def test_invalid_input_raises_before_attempt_limit(self):
+        with self.assertRaises(ValueError):
+            retry_delay(4, 0, max_attempts=1, base_ms=-1)
+
+    def test_invalid_input_raises_before_budget_exhaustion(self):
+        with self.assertRaises(ValueError):
+            retry_delay(1, 5000, budget_ms=10, retry_after_ms=1.5)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_attempt_beyond_max_is_none(self):
+        self.assertIsNone(retry_delay(10, 0, max_attempts=4))
+
+    def test_last_allowed_attempt_retries(self):
+        self.assertEqual(retry_delay(3, 0, max_attempts=4), 400)
+
+    def test_budget_exactly_exhausted_is_none(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+
+    def test_one_ms_inside_budget_returns_delay(self):
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+
+    def test_zero_delay_is_returned(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=0), 0)
+
+    def test_zero_delay_at_budget_edge_is_none(self):
+        self.assertIsNone(retry_delay(1, 1000, base_ms=0, budget_ms=1000))
+
+    def test_zero_cap_yields_zero_backoff(self):
+        self.assertEqual(retry_delay(3, 0, cap_ms=0), 0)
+
+    def test_base_above_cap_is_capped(self):
+        self.assertEqual(retry_delay(1, 0, base_ms=500, cap_ms=400), 400)
+
+    def test_retry_after_is_not_limited_by_cap(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=400, retry_after_ms=900, budget_ms=2000),
+            900)
+
+    def test_retry_after_floor_can_exhaust_budget(self):
+        self.assertIsNone(retry_delay(1, 0, retry_after_ms=1000))
+
+    def test_huge_attempt_saturates_to_cap(self):
+        attempt = 10 ** 100
+        self.assertEqual(
+            retry_delay(attempt, 0, max_attempts=attempt + 1, budget_ms=10 ** 200),
+            400)
+
+    def test_huge_attempt_with_zero_base_is_zero(self):
+        attempt = 10 ** 100
+        self.assertEqual(
+            retry_delay(attempt, 0, max_attempts=attempt + 1, base_ms=0,
+                        budget_ms=10 ** 200),
+            0)
+
+    def test_unbounded_large_integers_are_accepted(self):
+        big = 10 ** 30
+        self.assertEqual(
+            retry_delay(1, big, budget_ms=big + 10, base_ms=5, cap_ms=big),
+            5)
