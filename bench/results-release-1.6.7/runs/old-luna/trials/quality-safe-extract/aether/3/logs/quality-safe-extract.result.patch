@@ -18,3 +18,97 @@ class ExtractBasics(unittest.TestCase):
         with tempfile.TemporaryDirectory(dir=".") as directory:
             self.assertEqual(extract([], Path(directory)), [])
             self.assertEqual(list(Path(directory).iterdir()), [])
+
+
+class ExtractValidation(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(dir=".")
+        self.root = Path(self.temporary.name)
+
+    def tearDown(self):
+        self.temporary.cleanup()
+
+    def assert_invalid_without_changes(self, entries):
+        with self.assertRaises(ValueError):
+            extract(entries, self.root)
+        self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_requires_a_list_without_consuming_iterables(self):
+        for entries in ((), iter(()), (entry for entry in ())):
+            with self.subTest(entries=type(entries).__name__):
+                with self.assertRaises(ValueError):
+                    extract(entries, self.root)
+                self.assertEqual(list(self.root.iterdir()), [])
+
+    def test_rejects_malformed_entries_and_data_types(self):
+        for entries in (
+            [("good/file", b"ok"), "bad"],
+            [("file",)],
+            [("file", bytearray(b"no"))],
+            [(3, b"no")],
+        ):
+            with self.subTest(entries=entries):
+                self.assert_invalid_without_changes(entries)
+
+    def test_rejects_unsafe_path_spellings(self):
+        bad_names = (
+            "", "/absolute", "a//b", "a/", "./a", "a/./b", "../a",
+            "a/../b", "a\\b", "C:/file", "a:b", "bad\0name",
+        )
+        for name in bad_names:
+            with self.subTest(name=name):
+                self.assert_invalid_without_changes([(name, b"x")])
+        self.assertEqual(extract([("100%/ok", b"x")], self.root), ["100%/ok"])
+
+    def test_rejects_duplicate_and_prefix_collisions_in_both_orders(self):
+        for entries in (
+            [("a", b"x"), ("a", b"y")],
+            [("a", b"x"), ("a/b", b"y")],
+            [("a/b", b"y"), ("a", b"x")],
+        ):
+            with self.subTest(entries=entries):
+                self.assert_invalid_without_changes(entries)
+
+    def test_rejects_existing_targets_and_non_directory_ancestors(self):
+        (self.root / "present").write_bytes(b"keep")
+        with self.assertRaises(ValueError):
+            extract([("new/deep/file", b"new"), ("present", b"replace")], self.root)
+        self.assertFalse((self.root / "new").exists())
+        self.assertEqual((self.root / "present").read_bytes(), b"keep")
+        with self.assertRaises(ValueError):
+            extract([("present/child", b"x")], self.root)
+
+    def test_rejects_symlinks_in_paths_and_as_root(self):
+        outside = Path(self.temporary.name).parent / (Path(self.temporary.name).name + "-outside")
+        outside.mkdir()
+        try:
+            for link, target in ((self.root / "link", outside), (self.root / "dangling", outside / "missing")):
+                try:
+                    link.symlink_to(target, target_is_directory=True)
+                except (OSError, NotImplementedError):
+                    self.skipTest("symlinks are unavailable")
+                with self.assertRaises(ValueError):
+                    extract([(f"{link.name}/file", b"x")], self.root)
+                self.assertFalse((outside / "file").exists())
+
+            root_link = self.root.parent / (self.root.name + "-link")
+            root_link.symlink_to(self.root, target_is_directory=True)
+            with self.assertRaises(ValueError):
+                extract([], root_link)
+        finally:
+            # These paths are test-owned and may be symlinks or directories.
+            for candidate in (self.root.parent / (self.root.name + "-link"), outside):
+                if candidate.is_symlink():
+                    candidate.unlink()
+                elif candidate.exists():
+                    for child in candidate.iterdir():
+                        child.unlink()
+                    candidate.rmdir()
+
+    def test_root_must_be_an_existing_directory(self):
+        with self.assertRaises(ValueError):
+            extract([], self.root / "missing")
+        file_root = self.root / "file"
+        file_root.write_bytes(b"x")
+        with self.assertRaises(ValueError):
+            extract([], file_root)
