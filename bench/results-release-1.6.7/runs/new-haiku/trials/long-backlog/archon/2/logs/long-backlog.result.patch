diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..cb129bf 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,70 @@
+from .models import DONE, OPEN
+
+
+class QueryError(ValueError):
+    """An invalid search query."""
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order."""
+    if not isinstance(query, str):
+        raise TypeError(f"query must be a string, not {type(query).__name__}")
+    predicates = [_term_predicate(text, is_phrase) for text, is_phrase in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    """(text, is_phrase) pairs; whitespace splits terms except inside double quotes."""
+    terms = []
+    text = []
+    is_phrase = False
+    in_quotes = False
+    started = False
+    for char in query:
+        if char == '"':
+            is_phrase = is_phrase or not started
+            in_quotes = not in_quotes
+            started = True
+        elif char.isspace() and not in_quotes:
+            if started:
+                terms.append(("".join(text), is_phrase))
+            text, is_phrase, started = [], False, False
+        else:
+            text.append(char)
+            started = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if started:
+        terms.append(("".join(text), is_phrase))
+    return terms
+
+
+def _term_predicate(text, is_phrase):
+    if is_phrase:
+        return _title_predicate(text)
+    field, separator, value = text.partition(":")
+    if not separator:
+        return _title_predicate(text)
+    if field == "tag":
+        return _tag_predicate(value)
+    if field == "status":
+        return _status_predicate(value)
+    raise QueryError(f"unknown field: {field}")
+
+
+def _title_predicate(needle):
+    needle = needle.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _tag_predicate(name):
+    if not name:
+        raise QueryError("tag: needs a tag name")
+    wanted = name.lower()
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _status_predicate(status):
+    if status not in (OPEN, DONE):
+        raise QueryError(f"unknown status: {status}")
+    return lambda task: task.status == status
