 """Extract validated regular-file entries. See SPEC.md."""
 
+import os
+import stat
+from pathlib import Path
+
+FORBIDDEN_NAME_CHARS = ("\\", ":", "\x00")
+
 
 def extract(entries, root):
-    raise NotImplementedError
+    _require_list(entries)
+    root_path = _check_root(root)
+    planned = [_plan_entry(entry) for entry in entries]
+    _check_batch_names(planned)
+    for _, parts, _ in planned:
+        _check_target_free(root_path, parts)
+    for _, parts, data in planned:
+        _write_file(root_path, parts, data)
+    return [name for name, _, _ in planned]
+
+
+def _require_list(entries):
+    if not isinstance(entries, list):
+        raise ValueError(f"entries must be a list, not {type(entries).__name__}")
+
+
+def _check_root(root):
+    if isinstance(root, Path):
+        root_path = root
+    elif isinstance(root, str) and root:
+        root_path = Path(root)
+    else:
+        raise ValueError(f"root must be a non-empty str or Path, not {type(root).__name__}")
+    try:
+        mode = os.lstat(root_path).st_mode
+    except (FileNotFoundError, NotADirectoryError) as exc:
+        raise ValueError(f"root {str(root_path)!r} does not exist") from exc
+    if stat.S_ISLNK(mode):
+        raise ValueError(f"root {str(root_path)!r} is a symbolic link")
+    if not stat.S_ISDIR(mode):
+        raise ValueError(f"root {str(root_path)!r} is not a directory")
+    return root_path
+
+
+def _plan_entry(entry):
+    if not isinstance(entry, tuple) or len(entry) != 2:
+        raise ValueError(f"entry must be a (name, data) tuple, not {type(entry).__name__}")
+    name, data = entry
+    parts = _parse_name(name)
+    if not isinstance(data, bytes):
+        raise ValueError(f"data for {name!r} must be bytes, not {type(data).__name__}")
+    return name, parts, data
+
+
+def _parse_name(name):
+    if not isinstance(name, str):
+        raise ValueError(f"entry name must be str, not {type(name).__name__}")
+    if not name:
+        raise ValueError("entry name must not be empty")
+    if any(char in name for char in FORBIDDEN_NAME_CHARS):
+        raise ValueError(f"entry name {name!r} contains a backslash, colon, or NUL")
+    try:
+        name.encode("utf-8")
+    except UnicodeEncodeError as exc:
+        raise ValueError(f"entry name {name!r} is not encodable as UTF-8") from exc
+    parts = tuple(name.split("/"))
+    if any(part in ("", ".", "..") for part in parts):
+        raise ValueError(
+            f"entry name {name!r} must be a relative path without empty, '.' or '..' components"
+        )
+    return parts
+
+
+def _check_batch_names(planned):
+    names = set()
+    for name, _, _ in planned:
+        if name in names:
+            raise ValueError(f"duplicate entry name {name!r}")
+        names.add(name)
+    assert len(names) == len(planned)
+    for name, parts, _ in planned:
+        for depth in range(1, len(parts)):
+            ancestor = "/".join(parts[:depth])
+            if ancestor in names:
+                raise ValueError(f"entry {name!r} collides with file entry {ancestor!r}")
+
+
+def _check_target_free(root, parts):
+    assert parts
+    current = root
+    for index, part in enumerate(parts):
+        current = current / part
+        try:
+            mode = os.lstat(current).st_mode
+        except FileNotFoundError:
+            return
+        if stat.S_ISLNK(mode):
+            raise ValueError(f"{str(current)!r} is a symbolic link")
+        if index == len(parts) - 1:
+            raise ValueError(f"{str(current)!r} already exists")
+        if not stat.S_ISDIR(mode):
+            raise ValueError(f"{str(current)!r} is not a directory")
+
+
+def _write_file(root, parts, data):
+    assert isinstance(data, bytes)
+    assert all(part not in ("", ".", "..") for part in parts)
+    os.makedirs(root.joinpath(*parts[:-1]), exist_ok=True)
+    fd = os.open(root.joinpath(*parts), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o666)
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
