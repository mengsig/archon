diff --git a/retry_budget.py b/retry_budget.py
index 07b3b5e..5f0fb25 100644
--- a/retry_budget.py
+++ b/retry_budget.py
@@ -3,4 +3,44 @@
 
 def retry_delay(attempt, elapsed_ms, *, max_attempts=4, budget_ms=1000,
                 base_ms=100, cap_ms=400, retry_after_ms=None):
-    raise NotImplementedError
+    """Return the required wait before another attempt, or ``None``.
+
+    All arguments are validated even when the attempt or time budget is already
+    exhausted. ``attempt`` counts the initial request as attempt one.
+    """
+    values = (
+        ("attempt", attempt, 1),
+        ("elapsed_ms", elapsed_ms, 0),
+        ("max_attempts", max_attempts, 1),
+        ("budget_ms", budget_ms, 0),
+        ("base_ms", base_ms, 0),
+        ("cap_ms", cap_ms, 0),
+    )
+    for name, value, minimum in values:
+        if type(value) is not int or value < minimum:
+            raise ValueError(f"{name} must be an int >= {minimum}")
+    if retry_after_ms is not None and (
+        type(retry_after_ms) is not int or retry_after_ms < 0
+    ):
+        raise ValueError("retry_after_ms must be None or an int >= 0")
+
+    if attempt >= max_attempts:
+        return None
+
+    if base_ms == 0 or cap_ms == 0:
+        delay = 0
+    else:
+        exponent = attempt - 1
+        # Since base_ms >= 1, 2**cap_ms.bit_length() is already greater
+        # than cap_ms. This bounds the exponentiation for arbitrarily large
+        # attempt values.
+        if base_ms >= cap_ms or exponent >= cap_ms.bit_length():
+            delay = cap_ms
+        else:
+            delay = min(cap_ms, base_ms * (1 << exponent))
+
+    if retry_after_ms is not None:
+        delay = max(delay, retry_after_ms)
+    if elapsed_ms + delay >= budget_ms:
+        return None
+    return delay
diff --git a/test_retry_budget.py b/test_retry_budget.py
index f3df8dd..d55275f 100644
--- a/test_retry_budget.py
+++ b/test_retry_budget.py
@@ -16,3 +16,44 @@ class RetryBasics(unittest.TestCase):
     def test_retry_after(self):
         self.assertEqual(retry_delay(1, 0, retry_after_ms=250), 250)
         self.assertEqual(retry_delay(1, 0, retry_after_ms=25), 100)
+
+
+class RetryBoundaries(unittest.TestCase):
+    def test_invalid_values_are_rejected_even_if_exhausted(self):
+        for kwargs in (
+            {"attempt": True},
+            {"attempt": 0},
+            {"elapsed_ms": -1},
+            {"max_attempts": 0},
+            {"budget_ms": 1.0},
+            {"base_ms": False},
+            {"cap_ms": -1},
+            {"retry_after_ms": -1},
+            {"retry_after_ms": True},
+        ):
+            with self.subTest(kwargs=kwargs), self.assertRaises(ValueError):
+                args = {"attempt": 4, "elapsed_ms": 0}
+                args.update(kwargs)
+                retry_delay(**args)
+
+    def test_budget_boundary_is_strict(self):
+        self.assertIsNone(retry_delay(1, 900, budget_ms=1000))
+        self.assertEqual(retry_delay(1, 899, budget_ms=1000), 100)
+        self.assertIsNone(retry_delay(1, 0, budget_ms=100))
+        self.assertEqual(retry_delay(1, 0, budget_ms=101), 100)
+
+    def test_retry_after_is_not_capped(self):
+        self.assertEqual(
+            retry_delay(1, 0, cap_ms=10, retry_after_ms=50), 50
+        )
+        self.assertIsNone(
+            retry_delay(1, 950, budget_ms=1000, retry_after_ms=50)
+        )
+
+    def test_zero_values_and_huge_attempt(self):
+        self.assertEqual(retry_delay(2, 0, base_ms=0), 0)
+        self.assertEqual(retry_delay(2, 0, cap_ms=0), 0)
+        self.assertEqual(retry_delay(10**100, 0, max_attempts=10**101), 400)
+
+    def test_attempt_greater_than_limit_is_valid(self):
+        self.assertIsNone(retry_delay(5, 0, max_attempts=4))
