+class KeyedValidationTest(unittest.TestCase):
+    def test_invalid_params_raise_at_construction(self):
+        cases = [(0, 1.0, 1), (1, 0, 1), (1, 1.0, 0), (1, 1.0, -1)]
+        for capacity, rate, max_keys in cases:
+            with self.subTest(capacity=capacity, rate=rate, max_keys=max_keys):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(capacity, rate, max_keys=max_keys, clock=FakeClock())
+
+    def test_non_finite_params_raise_at_construction(self):
+        for value in [float("nan"), float("inf")]:
+            with self.subTest(value=value):
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(value, 1.0, clock=FakeClock())
+                with self.assertRaises(ValueError):
+                    KeyedLimiter(1, value, clock=FakeClock())
+
+    def test_non_finite_n_does_not_create_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=float("nan"))
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", n=float("inf"))
+        self.assertEqual(len(limiter), 1)
+
+    def test_invalid_n_does_not_create_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        self.assertTrue(limiter.try_acquire("a"))
+        with self.assertRaises(ValueError):
+            limiter.try_acquire("b", n=2)
+        with self.assertRaises(ValueError):
+            limiter.wait_time("b", n=0)
+        self.assertEqual(len(limiter), 1)
+        self.assertFalse(limiter.try_acquire("a"))
+
+
+class KeyedBehaviourTest(unittest.TestCase):
+    def test_wait_time_is_per_key(self):
+        clock = FakeClock()
+        limiter = KeyedLimiter(2, 1.0, clock=clock)
+        limiter.try_acquire("a", 2)
+        self.assertAlmostEqual(limiter.wait_time("a"), 1.0)
+        self.assertEqual(limiter.wait_time("b"), 0.0)
+
+    def test_len_counts_tracked_keys(self):
+        limiter = KeyedLimiter(1, 1.0, clock=FakeClock())
+        self.assertEqual(len(limiter), 0)
+        limiter.try_acquire("a")
+        limiter.wait_time("b")
+        self.assertEqual(len(limiter), 2)
+
+    def test_evicts_least_recently_used_key(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.try_acquire("c")
+        self.assertEqual(len(limiter), 2)
+        self.assertFalse(limiter.try_acquire("b"))
+        self.assertFalse(limiter.try_acquire("c"))
+        self.assertTrue(limiter.try_acquire("a"))
+
+    def test_use_refreshes_recency(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=2, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        limiter.wait_time("a")
+        limiter.try_acquire("c")
+        self.assertFalse(limiter.try_acquire("a"))
+        self.assertTrue(limiter.try_acquire("b"))
+
+    def test_evicted_key_returns_full(self):
+        limiter = KeyedLimiter(1, 1.0, max_keys=1, clock=FakeClock())
+        limiter.try_acquire("a")
+        limiter.try_acquire("b")
+        self.assertTrue(limiter.try_acquire("a"))
+
+
