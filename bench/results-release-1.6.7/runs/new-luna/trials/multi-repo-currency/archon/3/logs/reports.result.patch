@@ -7,25 +7,44 @@ import csv
 import sys
 
 
-def totals(rows):
-    """{account: total_cents} from CSV dict rows."""
+class InvalidCurrencyError(Exception):
+    pass
+
+
+def valid_currency(currency):
+    return len(currency) == 3 and all("A" <= char <= "Z" for char in currency)
+
+
+def totals(rows, has_currency):
+    """{(account, currency): total_cents} from CSV dict rows."""
     result = {}
-    for row in rows:
+    for line_number, row in enumerate(rows, start=2):
         account = row["account"]
-        result[account] = result.get(account, 0) + int(row["amount_cents"])
+        currency = row["currency"] if has_currency else "USD"
+        if not valid_currency(currency):
+            raise InvalidCurrencyError(
+                f"invalid currency on line {line_number}: {currency!r}"
+            )
+        key = (account, currency)
+        result[key] = result.get(key, 0) + int(row["amount_cents"])
     return result
 
 
 def render(result):
-    lines = ["account,total_cents"]
-    for account in sorted(result):
-        lines.append(f"{account},{result[account]}")
+    lines = ["account,currency,total_cents"]
+    for account, currency in sorted(result):
+        lines.append(f"{account},{currency},{result[(account, currency)]}")
     return "\n".join(lines) + "\n"
 
 
 def main():
     rows = csv.DictReader(sys.stdin)
-    sys.stdout.write(render(totals(rows)))
+    try:
+        has_currency = "currency" in (rows.fieldnames or [])
+        sys.stdout.write(render(totals(rows, has_currency)))
+    except InvalidCurrencyError as error:
+        print(error, file=sys.stderr)
+        raise SystemExit(2)
 
 
 if __name__ == "__main__":
