@@ -0,0 +1,106 @@
+"""Tests for TaskStore.undo (TT-104)."""
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_ids_are_not_reused_after_undo_add(self):
+        store = TaskStore()
+        first = store.add("first")
+        store.undo()
+        second = store.add("second")
+        self.assertGreater(second.id, first.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("buy milk")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_delete_restores_task_under_same_id(self):
+        store = TaskStore()
+        task = store.add("pay rent", tags=["home", "money"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.id, task.id)
+        self.assertEqual(restored.title, "pay rent")
+        self.assertEqual(restored.tags, ["home", "money"])
+        self.assertEqual(restored.due, date(2026, 4, 1))
+        self.assertEqual(restored.status, DONE)
+
+    def test_undo_delete_restores_state_at_time_of_delete(self):
+        store = TaskStore()
+        task = store.add("draft")
+        store.delete(task.id)
+        task.tags.append("changed-after-delete")
+        store.undo()
+        self.assertEqual(store.get(task.id).tags, [])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(store.get(b.id).status, OPEN)
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+
+    def test_nothing_to_undo_on_new_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_nothing_to_undo_after_exhausting_history(self):
+        store = TaskStore()
+        store.add("only")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("kept")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.delete(42)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
