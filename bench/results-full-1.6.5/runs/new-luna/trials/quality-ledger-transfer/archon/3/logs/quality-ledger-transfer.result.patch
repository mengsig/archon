+
+class LedgerContract(unittest.TestCase):
+    def test_constructor_validation(self):
+        for balances in (None, [], (), "x", {"": 1}, {1: 1}, {"a": True}, {"a": 1.0}, {"a": -1}, {"a": MAX_BALANCE + 1}):
+            with self.subTest(balances=balances), self.assertRaises(ValueError):
+                Ledger(balances)
+        self.assertEqual(Ledger({}).snapshot(), {})
+
+    def test_constructor_and_snapshot_are_copies(self):
+        initial = {"a": 2, "b": 3}
+        ledger = Ledger(initial)
+        initial["a"] = 99
+        initial["c"] = 7
+        snap = ledger.snapshot()
+        snap["a"] = 0
+        snap["c"] = 1
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": 3})
+
+    def test_amount_validation_precedes_account_lookup(self):
+        ledger = Ledger({})
+        for amount in (0, -1, MAX_BALANCE + 1, True, 1.0, "1"):
+            with self.subTest(amount=amount), self.assertRaises(ValueError):
+                ledger.transfer("missing", "also-missing", amount)
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "also-missing", 1)
+
+    def test_overflow_is_atomic_and_can_fill_to_ceiling(self):
+        ledger = Ledger({"a": 2, "b": MAX_BALANCE - 1})
+        self.assertFalse(ledger.transfer("a", "b", 2))
+        self.assertEqual(ledger.snapshot(), {"a": 2, "b": MAX_BALANCE - 1})
+        self.assertTrue(ledger.transfer("a", "b", 1))
+        self.assertEqual(ledger.snapshot(), {"a": 1, "b": MAX_BALANCE})
+
+    def test_same_account(self):
+        ledger = Ledger({"a": MAX_BALANCE, "small": 7})
+        self.assertTrue(ledger.transfer("a", "a", MAX_BALANCE))
+        self.assertEqual(ledger.snapshot(), {"a": MAX_BALANCE, "small": 7})
+        self.assertFalse(ledger.transfer("small", "small", 8))
+        with self.assertRaises(KeyError):
+            ledger.transfer("missing", "missing", 1)
+
+    def test_opposite_transfers_complete_without_deadlock(self):
+        ledger = Ledger({"a": 1000, "b": 1000})
+        gate = threading.Barrier(3)
+        errors = []
+
+        def move(source, destination):
+            try:
+                gate.wait(timeout=2)
+                for _ in range(500):
+                    self.assertTrue(ledger.transfer(source, destination, 1))
+            except BaseException as error:
+                errors.append(error)
+
+        threads = [threading.Thread(target=move, args=pair) for pair in (("a", "b"), ("b", "a"))]
+        for thread in threads:
+            thread.start()
+        gate.wait(timeout=2)
+        for thread in threads:
+            thread.join(timeout=3)
+        self.assertTrue(all(not thread.is_alive() for thread in threads), "opposite transfers deadlocked")
+        self.assertEqual(errors, [])
+        self.assertEqual(ledger.snapshot(), {"a": 1000, "b": 1000})
+
+    def test_concurrent_snapshots_never_observe_partial_transfer(self):
+        ledger = Ledger({"a": 1000, "b": 0})
+        start = threading.Barrier(2)
+        done = threading.Event()
+        observer_recorded = threading.Event()
+        observed = []
+
+        def writer():
+            start.wait(timeout=2)
+            ledger.transfer("a", "b", 1)
+            if not observer_recorded.wait(timeout=2):
+                raise AssertionError("observer did not record a snapshot")
+            for _ in range(499):
+                ledger.transfer("a", "b", 1)
+            done.set()
+
+        thread = threading.Thread(target=writer)
+        thread.start()
+        start.wait(timeout=2)
+        while not done.is_set():
+            snapshot = ledger.snapshot()
+            observed.append(sum(snapshot.values()))
+            observer_recorded.set()
+        thread.join(timeout=3)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(set(observed), {1000})
+        self.assertEqual(ledger.snapshot(), {"a": 500, "b": 500})
