@@ -0,0 +1,124 @@
+import unittest
+from datetime import date
+
+from tasktracker.models import DONE, OPEN
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_nothing_to_undo_on_fresh_store(self):
+        with self.assertRaises(NothingToUndo):
+            TaskStore().undo()
+
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(task.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, OPEN)
+
+    def test_undo_complete_of_already_done_task_keeps_it_done(self):
+        store = TaskStore()
+        task = store.add("write report")
+        store.complete(task.id)
+        store.complete(task.id)
+        store.undo()
+        self.assertEqual(store.get(task.id).status, DONE)
+
+    def test_undo_delete_restores_task_exactly(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work", "q3"], due=date(2026, 4, 1))
+        store.complete(task.id)
+        store.delete(task.id)
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.id, task.id)
+        self.assertEqual(restored.title, "write report")
+        self.assertEqual(restored.tags, ["work", "q3"])
+        self.assertEqual(restored.status, DONE)
+        self.assertEqual(restored.due, date(2026, 4, 1))
+        self.assertEqual([t.id for t in store.all()], [task.id])
+
+    def test_undo_delete_is_unaffected_by_later_changes_to_deleted_object(self):
+        store = TaskStore()
+        task = store.add("write report", tags=["work"])
+        deleted = store.delete(task.id)
+        deleted.title = "changed"
+        deleted.tags.append("extra")
+        store.undo()
+        restored = store.get(task.id)
+        self.assertEqual(restored.title, "write report")
+        self.assertEqual(restored.tags, ["work"])
+
+    def test_undo_walks_back_lifo_across_kinds(self):
+        store = TaskStore()
+        a = store.add("alpha")
+        b = store.add("beta")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.undo()
+        self.assertEqual(store.get(b.id).status, OPEN)
+        self.assertEqual(store.get(a.id).status, DONE)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, OPEN)
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_undo_mixed_delete_then_add_restores_in_order(self):
+        store = TaskStore()
+        a = store.add("alpha")
+        store.delete(a.id)
+        store.add("beta")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        store.undo()
+        self.assertEqual([t.id for t in store.all()], [a.id])
+        self.assertEqual(store.get(a.id).title, "alpha")
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        first = store.add("alpha")
+        store.undo()
+        second = store.add("beta")
+        self.assertNotEqual(first.id, second.id)
+        self.assertEqual(second.id, first.id + 1)
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("alpha")
+        with self.assertRaises(UnknownTask):
+            store.complete(999)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(UnknownTask):
+            store.delete(999)
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
