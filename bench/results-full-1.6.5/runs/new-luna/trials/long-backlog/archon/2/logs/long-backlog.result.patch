diff --git a/tests/test_search.py b/tests/test_search.py
new file mode 100644
index 0000000..0080ca3
--- /dev/null
+++ b/tests/test_search.py
@@ -0,0 +1,52 @@
+import unittest
+
+from tasktracker.models import Task
+from tasktracker.search import QueryError, search
+
+
+class SearchQueryTest(unittest.TestCase):
+    def setUp(self):
+        self.tasks = [
+            Task(1, "Fix login flow", ["Work", "urgent"]),
+            Task(2, "Login documentation", ["workshop"], "done"),
+            Task(3, "fix password reset", ["URGENT"], "done"),
+        ]
+
+    def test_whitespace_terms_are_case_insensitive_and_anded(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "FIX LOGIN")], [1]
+        )
+
+    def test_quoted_phrase_is_one_term(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, '"login flow"')], [1]
+        )
+        self.assertEqual(search(self.tasks, '"flow login"'), [])
+
+    def test_tag_is_exact_and_case_insensitive(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "tag:urgent")], [1, 3]
+        )
+        self.assertEqual(search(self.tasks, "tag:work"), [self.tasks[0]])
+
+    def test_status_filter_and_combination(self):
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "status:DONE")], [2, 3]
+        )
+        self.assertEqual(
+            [task.id for task in search(self.tasks, "fix status:open")], [1]
+        )
+
+    def test_blank_query_matches_all_in_input_order(self):
+        tasks = [self.tasks[2], self.tasks[0], self.tasks[1]]
+        self.assertEqual(search(tasks, " \t\n"), tasks)
+
+    def test_invalid_query_syntax_raises_even_without_tasks(self):
+        for query in ("owner:me", "status:pending", '"unfinished'):
+            with self.subTest(query=query):
+                with self.assertRaises(QueryError):
+                    search([], query)
+
+
+if __name__ == "__main__":
+    unittest.main()
