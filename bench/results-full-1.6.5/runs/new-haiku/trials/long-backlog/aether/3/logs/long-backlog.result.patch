diff --git a/tasktracker/search.py b/tasktracker/search.py
index 2c7648a..009b3b9 100644
--- a/tasktracker/search.py
+++ b/tasktracker/search.py
@@ -1,2 +1,79 @@
+from typing import NamedTuple
+
+from .models import DONE, OPEN
+
+
+class QueryError(ValueError):
+    pass
+
+
+class Term(NamedTuple):
+    text: str
+    quoted: bool
+
+
 def search(tasks, query):
-    return [task for task in tasks if query in task.title]
+    """Tasks matching every term of `query`, in input order."""
+    assert isinstance(query, str), "query must be a string"
+    predicates = [_predicate(term) for term in _split_terms(query)]
+    return [task for task in tasks if all(matches(task) for matches in predicates)]
+
+
+def _split_terms(query):
+    terms = []
+    chars = []
+    quoted = False
+    in_quotes = False
+    started = False
+    for char in query:
+        if char == '"':
+            in_quotes = not in_quotes
+            quoted = started = True
+        elif char.isspace() and not in_quotes:
+            if started:
+                terms.append(Term("".join(chars), quoted))
+            chars, quoted, started = [], False, False
+        else:
+            chars.append(char)
+            started = True
+    if in_quotes:
+        raise QueryError(f"unterminated quote in query: {query}")
+    if started:
+        terms.append(Term("".join(chars), quoted))
+    return terms
+
+
+def _predicate(term):
+    if term.quoted:
+        return _title_contains(term.text)
+    field, separator, value = term.text.partition(":")
+    if not separator:
+        return _title_contains(term.text)
+    return _field_predicate(field, value)
+
+
+def _field_predicate(field, value):
+    if field.lower() == "tag":
+        return _has_tag(value)
+    if field.lower() == "status":
+        return _has_status(value)
+    raise QueryError(f"unknown search field: {field}")
+
+
+def _title_contains(text):
+    needle = text.lower()
+    return lambda task: needle in task.title.lower()
+
+
+def _has_tag(name):
+    wanted = name.lower()
+    if not wanted:
+        raise QueryError("tag: needs a tag name")
+    return lambda task: any(tag.lower() == wanted for tag in task.tags)
+
+
+def _has_status(value):
+    wanted = value.lower()
+    if wanted not in (OPEN, DONE):
+        raise QueryError(f"unknown status: {value}")
+    return lambda task: task.status == wanted
