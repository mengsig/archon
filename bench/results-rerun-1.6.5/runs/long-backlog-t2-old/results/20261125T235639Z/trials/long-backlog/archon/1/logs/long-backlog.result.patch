@@ -0,0 +1,114 @@
+"""Tests for TaskStore.undo."""
+import unittest
+
+from tasktracker.store import NothingToUndo, TaskStore, UnknownTask
+
+
+class UndoTest(unittest.TestCase):
+    def test_undo_add_removes_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(UnknownTask):
+            store.get(a.id)
+
+    def test_undo_complete_reopens_task(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "open")
+
+    def test_undo_complete_restores_previous_done_status(self):
+        store = TaskStore()
+        a = store.add("write report")
+        store.complete(a.id)
+        store.complete(a.id)
+        store.undo()
+        self.assertEqual(store.get(a.id).status, "done")
+
+    def test_undo_delete_restores_exact_task_under_same_id(self):
+        store = TaskStore()
+        a = store.add("write report", tags=["work"], due=None)
+        store.complete(a.id)
+        before = store.get(a.id)
+        store.delete(a.id)
+        store.undo()
+        restored = store.get(a.id)
+        self.assertIs(restored, before)
+        self.assertEqual((restored.id, restored.title, restored.tags, restored.status), (a.id, "write report", ["work"], "done"))
+
+    def test_ids_are_not_reused_after_undoing_add(self):
+        store = TaskStore()
+        store.add("first")
+        store.undo()
+        b = store.add("second")
+        self.assertEqual(b.id, 2)
+        self.assertEqual([t.id for t in store.all()], [2])
+
+    def test_nothing_to_undo_raises(self):
+        store = TaskStore()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_nothing_to_undo_after_all_undone(self):
+        store = TaskStore()
+        store.add("a")
+        store.undo()
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_walks_back_lifo_across_mixed_kinds(self):
+        store = TaskStore()
+        a = store.add("a")
+        b = store.add("b")
+        store.complete(a.id)
+        store.delete(b.id)
+        store.add("c")
+        store.undo()  # undoes add c
+        self.assertEqual([(t.id, t.status) for t in store.all()], [(1, "done")])
+        store.undo()  # undoes delete b
+        self.assertEqual([(t.id, t.status) for t in store.all()], [(1, "done"), (2, "open")])
+        store.undo()  # undoes complete a
+        self.assertEqual([(t.id, t.status) for t in store.all()], [(1, "open"), (2, "open")])
+        store.undo()  # undoes add b
+        self.assertEqual([(t.id, t.status) for t in store.all()], [(1, "open")])
+        store.undo()  # undoes add a
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_complete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.complete(99)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_delete_is_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(UnknownTask):
+            store.delete(99)
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+    def test_failed_add_is_not_recorded(self):
+        store = TaskStore()
+        store.add("a")
+        with self.assertRaises(ValueError):
+            store.add("   ")
+        store.undo()
+        self.assertEqual(store.all(), [])
+        with self.assertRaises(NothingToUndo):
+            store.undo()
+
+
+if __name__ == "__main__":
+    unittest.main()
